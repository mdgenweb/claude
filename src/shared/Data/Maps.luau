--!strict
-- Lab rooms. Geometry is built server-side by src/server/Maps/<builder>.luau; lighting presets are
-- applied client-side so every player sees the mood of the lab they are looking at.

export type LightingPreset = {
	clockTime: number,
	brightness: number,
	ambient: Color3,
	outdoorAmbient: Color3,
	exposure: number,
	fogColor: Color3,
	atmosphereDensity: number,
	atmosphereHaze: number,
	atmosphereColor: Color3,
	atmosphereDecay: Color3,
	tint: Color3,
	saturation: number,
	contrast: number,
	bloomIntensity: number,
	bloomSize: number,
	bloomThreshold: number,
	sunRays: number,
	skyTop: Color3, -- backdrop gradient used by the client sky dome
	skyBottom: Color3,
}

export type MapInfo = {
	id: string,
	name: string,
	icon: string,
	description: string,
	unlockLevel: number,
	width: number, -- interior width (X)
	height: number, -- interior height (Y)
	gravityScale: number,
	builder: string,
	lighting: LightingPreset,
	order: number,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

