local Maps = {
	List = list,
	ById = {} :: { [string]: MapInfo },
}

for _, map in list do
	Maps.ById[map.id] = map
end

function Maps.get(id: string?): MapInfo
	return (id and Maps.ById[id]) or Maps.ById.lab
end

return Maps
