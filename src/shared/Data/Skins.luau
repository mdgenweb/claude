--!strict
-- Golem skins. Traits change how a golem reacts to effects (straw burns longer, iron conducts...).

export type Traits = {
	flammable: boolean?, -- burns twice as long
	fireproof: boolean?, -- immune to burning
	conductive: boolean?, -- shocks chain to/from it
	frostproof: boolean?, -- immune to freezing
	brittle: boolean?, -- shatters on huge impacts even when not frozen
	melts: boolean?, -- fire shrinks it
}

export type Skin = {
	id: string,
	name: string,
	rarity: string,
	body: Color3,
	limb: Color3,
	joint: Color3,
	material: Enum.Material,
	accent: Color3, -- chest rune / eye glow
	eye: Color3,
	pupil: Color3,
	density: number,
	friction: number,
	elasticity: number,
	traits: Traits,
	-- How it is obtained: "default", "shop", "level", "spin", "code", "vip", "trial"
	source: string,
	price: number?,
	level: number?,
	accessory: string?, -- built by GolemFactory: "strawhat", "carrot", "bolts", "crystal", "gear", "horns", "halo", "icing"
	rainbow: boolean?,
	order: number,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

