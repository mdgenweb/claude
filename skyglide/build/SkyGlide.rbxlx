		Accent = "#FF5A1F",
		Trunk = "#2B1B14",
		Leaves = "#3A3A44",
		Sky = { Top = "#B33A1A", Horizon = "#FFB36B" },
		Fog = "#FF9A5A",
		Ambient = "#A0705A",
		ClockTime = 17.6,
		Props = "Volcano",
	},
	Bay = {
		FloorA = "#F2DDB0",
		FloorB = "#E3C994",
		Path = "#A0522D",
		Cliff = "#D9B98A",
		CliffAlt = "#C2A070",
		CliffTop = "#88D46A",
