          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
-- Plays sounds from Config/Audio. 2D for UI, 3D (positioned) for battle events so spectators
-- hear fights from where they happen. Sound instances are pooled per spec.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local AudioConfig = require(ReplicatedStorage:WaitForChild("Shared").Config.Audio)

local AudioController = {}

local rng = Random.new()
local pools: { [string]: { Sound } } = {}
local lastPlayed: { [string]: number } = {}
local group: SoundGroup
local emitterFolder: Folder

local function ensure()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "SkyGlideSFX"
	g.Volume = 0.9
	g.Parent = SoundService
	group = g
	local f = Instance.new("Folder")
	f.Name = "SoundEmitters"
	f.Parent = Workspace
	emitterFolder = f
end

local function acquire(name: string, parent: Instance): Sound?
	local spec = AudioConfig.Sounds[name]
	if spec == nil then
		return nil
	end
	local pool = pools[name]
	if pool == nil then
		pool = {}
		pools[name] = pool
	end
	-- 3D sounds die with their temporary emitter part; drop those from the pool
	for i = #pool, 1, -1 do
		if pool[i].Parent == nil then
			table.remove(pool, i)
		end
	end
	for _, s in pool do
		if not s.IsPlaying and s.Parent == parent then
			return s
		end
	end
	if #pool >= 8 then
		local oldest = table.remove(pool, 1) :: Sound
		oldest:Destroy()
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = spec.Id
	sound.Volume = spec.Volume
	sound.SoundGroup = group
	sound.RollOffMaxDistance = 160
	sound.RollOffMinDistance = 18
	sound.Parent = parent
	table.insert(pool, sound)
	return sound
end

-- Plays a named sound. `position` makes it 3D. `throttle` (seconds) skips spammy repeats.
local enabled = true

-- Global SFX toggle (Settings).
function AudioController.SetEnabled(on: boolean)
	enabled = on
	ensure()
	group.Volume = if on then 0.9 else 0
end

-- Plays with an explicit playback speed (rising ring chimes).
function AudioController.PlayPitched(name: string, speed: number, volumeScale: number?)
	ensure()
	local spec = AudioConfig.Sounds[name]
	if spec == nil or not enabled then
		return
	end
	local sound = acquire(name, SoundService)
	if sound then
		sound.PlaybackSpeed = speed
		sound.Volume = spec.Volume * (volumeScale or 1)
		sound.TimePosition = 0
		sound:Play()
	end
end

local loops: { [string]: Sound } = {}

-- Starts/stops a looped sound (flight wind). `volumeScale` can be updated while playing.
function AudioController.Loop(name: string, on: boolean, volumeScale: number?, speed: number?)
	ensure()
	local spec = AudioConfig.Sounds[name]
	if spec == nil then
		return
	end
	local sound = loops[name]
	if on then
		if not sound then
			local s = Instance.new("Sound")
			s.Name = name .. "Loop"
			s.SoundId = spec.Id
			s.Looped = true
			s.SoundGroup = group
			s.Parent = SoundService
			loops[name] = s
			sound = s
		end
		local s = sound :: Sound
		s.Volume = spec.Volume * (volumeScale or 1)
		s.PlaybackSpeed = speed or 1
		if not s.IsPlaying then
			s:Play()
		end
	elseif sound then
		sound:Stop()
	end
end

function AudioController.Play(name: string, position: Vector3?, throttle: number?, volumeScale: number?)
	ensure()
	if not enabled then
		return
	end
	local now = os.clock()
	if throttle and lastPlayed[name] and now - lastPlayed[name] < throttle then
		return
	end
	lastPlayed[name] = now
	local spec = AudioConfig.Sounds[name]
	if spec == nil then
		return
	end
	local parent: Instance = SoundService
	if position then
		local emitter = Instance.new("Part")
		emitter.Anchored = true
		emitter.CanCollide = false
		emitter.CanQuery = false
		emitter.CanTouch = false
		emitter.Transparency = 1
		emitter.Size = Vector3.one
		emitter.Position = position
		emitter.Parent = emitterFolder
		parent = emitter
		task.delay(3, function()
			emitter:Destroy()
		end)
	end
	local sound = acquire(name, parent)
	if sound == nil then
		return
	end
	sound.PlaybackSpeed = rng:NextNumber(spec.Pitch[1], spec.Pitch[2])
	sound.Volume = spec.Volume * (volumeScale or 1)
	sound.TimePosition = 0
	sound:Play()
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Bus</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side event bus so controllers and screens stay decoupled. Only cosmetic/UI events flow
-- through here; anything that changes game state goes to the server as an intent.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

local Bus = {
	-- Throwing (local player)
	ChargeChanged = Signal.new(), -- (charging: boolean, startedAt: number server time, reason: string?)
	InThrowZoneChanged = Signal.new(), -- (inZone: boolean)

	-- Flights
	FlightStarted = Signal.new(), -- (plan: FlightSim.Plan, isLocal: boolean)
	FlightProgress = Signal.new(), -- (distanceMeters: number, plan) local flight, every frame
	ZoneEntered = Signal.new(), -- (zone: Zones.Zone) local flight crossed a zone start
	GustWindow = Signal.new(), -- (open: boolean, ringIndex: number) next ring is tappable
	RingPassed = Signal.new(), -- (ringIndex: number, tappedPerfect: boolean, worldPosition: Vector3)
	RingResult = Signal.new(), -- ({ Id, Index, Perfect, Amount }) authoritative payout
	FlightLanded = Signal.new(), -- (payload) owner payload from the server (Distance, Zone, Wins, Skill, Special, UnlockedWorld, ...)
	FlightEnded = Signal.new(), -- (plan, isLocal) visuals finished (after splash)

	-- Training
	PadChanged = Signal.new(), -- (pad: Training.Pad?) pad under the local character
	TrainResult = Signal.new(), -- (amount: number)

	-- Pets
	HatchResult = Signal.new(), -- ({ Egg, Pets = { { Uid, Id } }, Source? })

	-- World
	WorldChanged = Signal.new(), -- (worldId: number)
}

return Bus
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
-- Throw/flight camera (docs/DESIGN.md §6). Phases:
--   Hub    default Custom camera (nothing runs)
--   Charge over-the-shoulder view down the channel while THROW is held, slight FOV zoom-in
--   Follow Scriptable chase camera behind/above the local glider. Position and look point are
--          critically damped springs RELATIVE to the glider (so 250 studs/s never drags them
--          behind); the first moments pull back from the shoulder ("Launch"), FOV widens with
--          speed, perfect rings shake it a little, special throws get a slow wide zoom
--   Land   hold on the splash
--   Return ease back to the character, then restore the Custom camera and its subject
-- Data.Settings.FollowCam == false keeps the Custom camera throughout. Every exit (respawn,
-- cancelled flight, world change, setting toggled, watchdogs) ends in restore(), so the camera
-- can never get stuck in Scriptable mode.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Flight = require(Shared.Config.Flight)
local Map = require(Shared.Config.Map)

local Bus = require(script.Parent.Bus)
local StateController = require(script.Parent.StateController)
local FlightRenderer = require(script.Parent.FlightRenderer)

local CameraController = {}

type Phase = "Hub" | "Charge" | "Follow" | "Land" | "Return"

local LocalPlayer = Players.LocalPlayer

local CHARGE_OFFSET = Vector3.new(3.4, 3.2, 10.5) -- right shoulder, behind (channel runs toward -Z)
local CHARGE_FOV_DROP = 7
local FOLLOW_FOV_GAIN = 15 -- 70 -> 85 at full speed
local SPECIAL_TIME = 1.6
local LAND_HOLD_MAX = 2.2 -- seconds in Land before returning even without FlightEnded
local LAUNCH_TIME = 0.6

local phase: Phase = "Hub"
local hubFov = 70
local savedSubject: Instance? = nil

-- spring state (relative to the current anchor: character root or glider)
local offset = Vector3.zero
local offsetVel = Vector3.zero
local look = Vector3.zero
local lookVel = Vector3.zero
local fov = 70
local fovVel = 0

-- last applied absolute camera
local camPos = Vector3.zero
local lookPoint = Vector3.new(0, 0, -1)

local chargeAt = 0
local launchAwaitUntil = 0
local followStart = 0
local specialUntil = 0
local landAt = 0
local landPoint = Vector3.zero
local returnFrom = CFrame.identity
local returnFov = 70
local returnStart = 0
local returnTime = 0.6
local shake = 0
local rng = Random.new()

local function followCamEnabled(): boolean
	local data = StateController.Data
	local settings = data and data.Settings
	return not (type(settings) == "table" and settings.FollowCam == false)
end

local function characterRoot(): BasePart?
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function currentWorld(): number
	local data = StateController.Data
	return if data and type(data.World) == "number" then data.World else 1
end

-- Exact critically damped spring step (stable for any dt).
local function springV(x: Vector3, v: Vector3, target: Vector3, omega: number, dt: number): (Vector3, Vector3)
	local delta = x - target
	local decay = math.exp(-omega * dt)
	local tmp = (v + delta * omega) * dt
	return target + (delta + tmp) * decay, (v - tmp * omega) * decay
end

local function springN(x: number, v: number, target: number, omega: number, dt: number): (number, number)
	local delta = x - target
	local decay = math.exp(-omega * dt)
	local tmp = (v + delta * omega) * dt
	return target + (delta + tmp) * decay, (v - tmp * omega) * decay
end

-- Re-expresses the current camera relative to a new anchor so switching anchors never jumps.
local function anchorTo(anchor: Vector3)
	offset = camPos - anchor
	look = lookPoint - anchor
	offsetVel = Vector3.zero
	lookVel = Vector3.zero
end

local function apply(camera: Camera, pos: Vector3, target: Vector3)
	camPos = pos
	lookPoint = target
	if (target - pos).Magnitude < 1e-3 then
		return
	end
	camera.CFrame = CFrame.lookAt(pos, target)
	camera.Focus = CFrame.new(target)
	camera.FieldOfView = fov
end

-- Hands the camera back to the default Custom controller.
local function restore()
	local camera = Workspace.CurrentCamera
	local wasActive = phase ~= "Hub"
	phase = "Hub"
	shake = 0
	if camera and wasActive then
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then
			camera.CameraSubject = humanoid
		elseif savedSubject and savedSubject.Parent then
			camera.CameraSubject = savedSubject :: any
		end
		camera.FieldOfView = hubFov
	end
	savedSubject = nil
end

-- Takes the camera over (saving the Hub state the first time).
local function takeCamera(camera: Camera)
	if phase == "Hub" then
		savedSubject = camera.CameraSubject
		hubFov = math.clamp(camera.FieldOfView, 40, 100)
		fov = camera.FieldOfView
		fovVel = 0
		camPos = camera.CFrame.Position
		lookPoint = camPos + camera.CFrame.LookVector * 15
	end
	camera.CameraType = Enum.CameraType.Scriptable
end

local function beginReturn()
	if phase == "Hub" or phase == "Return" then
		return
	end
	local root = characterRoot()
	if not root then
		restore()
		return
	end
	returnFrom = CFrame.lookAt(camPos, lookPoint)
	returnFov = fov
	returnStart = os.clock()
	local distance = (camPos - root.Position).Magnitude
	returnTime = math.clamp(0.45 + distance / 2500, 0.45, 1.1)
	phase = "Return"
end

local function returnTarget(root: BasePart): CFrame
	local forward = root.CFrame.LookVector
	local flat = Vector3.new(forward.X, 0, forward.Z)
	flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
	local focus = root.Position + Vector3.new(0, 1.5, 0)
	return CFrame.lookAt(focus - flat * 12 + Vector3.new(0, 3.5, 0), focus)
end

--------------------------------------------------------------------------------------------------
-- Phase entry
--------------------------------------------------------------------------------------------------

local function enterCharge()
	if phase == "Follow" or phase == "Land" or not followCamEnabled() then
		return
	end
	local camera = Workspace.CurrentCamera
	local root = characterRoot()
	if not camera or not root then
		return
	end
	if phase == "Return" then
		local cf = camera.CFrame
		camPos = cf.Position
		lookPoint = camPos + cf.LookVector * 15
	end
	takeCamera(camera)
	anchorTo(root.Position)
	phase = "Charge"
	chargeAt = os.clock()
	launchAwaitUntil = 0
end

local function enterFollow(special: boolean)
	if not followCamEnabled() then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if phase == "Return" then
		local cf = camera.CFrame
		camPos = cf.Position
		lookPoint = camPos + cf.LookVector * 15
	end
	takeCamera(camera)
	anchorTo(FlightRenderer.LocalState().Position)
	phase = "Follow"
	followStart = os.clock()
	specialUntil = if special then followStart + SPECIAL_TIME else 0
end

local function enterLand(position: Vector3)
	phase = "Land"
	landAt = os.clock()
	landPoint = position
end

--------------------------------------------------------------------------------------------------
-- Per-frame update (runs after the default camera)
--------------------------------------------------------------------------------------------------

local function updateCharge(camera: Camera, dt: number)
	local root = characterRoot()
	local clock = os.clock()
	if not root or clock - chargeAt > Flight.MeterMaxHold + 3 or (launchAwaitUntil > 0 and clock > launchAwaitUntil) then
		beginReturn()
		return
	end
	local anchor = root.Position
	local target = Map.ChannelPoint(currentWorld(), 0, 16, 110) - anchor
	offset, offsetVel = springV(offset, offsetVel, CHARGE_OFFSET, 7, dt)
	look, lookVel = springV(look, lookVel, target, 7, dt)
	fov, fovVel = springN(fov, fovVel, hubFov - CHARGE_FOV_DROP, 5, dt)
	apply(camera, anchor + offset, anchor + look)
end

local function updateFollow(camera: Camera, dt: number)
	local state = FlightRenderer.LocalState()
	if not state.Active then
		beginReturn()
		return
	end
	if state.Landed then
		enterLand(state.LandPosition)
		return
	end
	local anchor = state.Position
	local v = state.Velocity
	local dir = if v.Magnitude > 1 then v.Unit else Vector3.new(0, 0, -1)
	-- chase mostly along the channel so sway and climbs don't swing the camera around
	local chase = Vector3.new(dir.X * 0.35, dir.Y * 0.4, dir.Z)
	chase = if chase.Magnitude > 0.01 then chase.Unit else Vector3.new(0, 0, -1)
	local clock = os.clock()
	local offsetTarget: Vector3
	local lookTarget: Vector3
	local fovTarget: number
	local omega: number
	if clock < specialUntil then
		local k = 1 - (specialUntil - clock) / SPECIAL_TIME
		offsetTarget = -chase * 26 + Vector3.new(10, 8, 0)
		lookTarget = chase * 4
		fovTarget = hubFov - 10 - 12 * k -- slow cinematic zoom-in
		omega = 3
	else
		local speedK = math.clamp((state.Speed - 40) / 220, 0, 1)
		offsetTarget = -chase * (14 + 3 * speedK) + Vector3.new(0, 5, 0)
		lookTarget = chase * 18 + Vector3.new(0, 1, 0)
		fovTarget = hubFov + FOLLOW_FOV_GAIN * speedK
		omega = if clock - followStart < LAUNCH_TIME then 4.5 else 7
	end
	offset, offsetVel = springV(offset, offsetVel, offsetTarget, omega, dt)
	look, lookVel = springV(look, lookVel, lookTarget, omega + 3, dt)
	fov, fovVel = springN(fov, fovVel, fovTarget, 4, dt)
	local jitter = Vector3.zero
	if shake > 0.01 then
		jitter = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)) * shake
		shake *= math.exp(-dt * 9)
	end
	apply(camera, anchor + offset + jitter * 0.4, anchor + look + jitter)
end

local function updateLand(camera: Camera, dt: number)
	if os.clock() - landAt > LAND_HOLD_MAX or not FlightRenderer.LocalState().Active then
		beginReturn()
		return
	end
	-- hold position (drifting up a touch) and settle the view on the splash
	local pos = camPos + Vector3.new(0, 2 * dt, 0)
	local target = lookPoint:Lerp(landPoint, 1 - math.exp(-6 * dt))
	fov, fovVel = springN(fov, fovVel, hubFov + 4, 4, dt)
	apply(camera, pos, target)
end

local function updateReturn(camera: Camera)
	local root = characterRoot()
	if not root then
		restore()
		return
	end
	local a = math.clamp((os.clock() - returnStart) / returnTime, 0, 1)
	local e = if a < 0.5 then 4 * a * a * a else 1 - (-2 * a + 2) ^ 3 / 2
	local cf = returnFrom:Lerp(returnTarget(root), e)
	camera.CFrame = cf
	camera.Focus = CFrame.new(root.Position)
	camera.FieldOfView = returnFov + (hubFov - returnFov) * e
	camPos = cf.Position
	lookPoint = cf.Position + cf.LookVector * 15
	if a >= 1 then
		restore()
	end
end

local function update(dt: number)
	if phase == "Hub" then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		-- someone else took the camera back: stand down without fighting it
		phase = "Hub"
		savedSubject = nil
		return
	end
	if phase == "Charge" then
		updateCharge(camera, dt)
	elseif phase == "Follow" then
		updateFollow(camera, dt)
	elseif phase == "Land" then
		updateLand(camera, dt)
	elseif phase == "Return" then
		updateReturn(camera)
	end
end

--------------------------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------------------------

-- Current phase name ("Hub", "Charge", "Follow", "Land", "Return").
function CameraController.Phase(): string
	return phase
end

-- Adds a short camera shake (Follow phase only).
function CameraController.Shake(amount: number)
	if phase == "Follow" then
		shake = math.max(shake, amount)
	end
end

-- Immediately hands the camera back to the Custom controller.
function CameraController.Reset()
	restore()
end

function CameraController.Start()
	Bus.ChargeChanged:Connect(function(charging: boolean, _startedAt: number, reason: string?)
		if charging then
			enterCharge()
		elseif phase == "Charge" then
			if reason == "Launched" then
				launchAwaitUntil = os.clock() + 2 -- wait for FlightStarted
			else
				beginReturn()
			end
		end
	end)
	Bus.FlightStarted:Connect(function(plan, isLocal: boolean)
		if isLocal then
			enterFollow(type(plan) == "table" and plan.Special ~= nil)
		end
	end)
	Bus.RingPassed:Connect(function(_index: number, perfect: boolean)
		if perfect then
			CameraController.Shake(0.55)
		end
	end)
	Bus.FlightEnded:Connect(function(_plan, isLocal: boolean)
		if isLocal and (phase == "Follow" or phase == "Land") then
			beginReturn()
		end
	end)
	Bus.WorldChanged:Connect(function()
		restore()
	end)
	StateController.DataChanged:Connect(function(data, previous)
		if phase == "Hub" or type(data) ~= "table" then
			return
		end
		if not followCamEnabled() then
			restore()
		elseif type(previous) == "table" and data.World ~= previous.World then
			restore()
		end
	end)
	LocalPlayer.CharacterAdded:Connect(function()
		if phase == "Charge" or phase == "Return" then
			restore()
		end
	end)
	RunService:BindToRenderStep("SkyGlideCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">FlightRenderer</string>
              <string name="Source"><![CDATA[--!strict
-- Draws glider flights from the server's flight plans (cosmetic only; the server pays every ring
-- and landing from the same plan). Every flight in the local player's world gets a pooled glider
-- model and a trail, positioned each frame from t = GetServerTimeNow() - plan.Start. The local
-- player's own flight also gets thermal rings, gust windows, ring bursts with "+N" popups, zone
-- crossings, wind audio, speed lines and a big splash.
--
-- Bus events fired here: FlightStarted(plan, isLocal), FlightProgress(meters, plan),
-- ZoneEntered(zone), GustWindow(open, idx), RingPassed(idx, perfect, pos), RingResult(payload),
-- FlightLanded(owner payload), FlightEnded(plan, isLocal).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Flight = require(Shared.Config.Flight)
local Map = require(Shared.Config.Map)
local FlightSim = require(Shared.Sim.FlightSim)
local Remotes = require(Shared.Net.Remotes)
local Format = require(Shared.Util.Format)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Trails = require(Shared.Definitions.Trails)
local Themes = require(Shared.Visual.Themes)
local GliderFactory = require(Shared.Visual.GliderFactory)
local FactoryKit = require(Shared.Visual.FactoryKit)

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local Effects = require(Client.VFX.Effects)
local FlightFX = require(Client.VFX.FlightFX)
local ThermalRings = require(Client.VFX.ThermalRings)
local Bus = require(script.Parent.Bus)
local StateController = require(script.Parent.StateController)
local AudioController = require(script.Parent.AudioController)
local ThrowController = require(script.Parent.ThrowController)

local FlightRenderer = {}

local LocalPlayer = Players.LocalPlayer

local GLIDER_LENGTH = 4
local MAX_REMOTE = 10
local POOL_PER_GLIDER = 4
local HAND_BLEND = 0.3 -- seconds to blend from the hand onto the flight path
local LOOKAHEAD = 0.05 -- seconds ahead sampled for orientation / velocity
local LOCAL_END_DELAY = 0.8 -- splash hold before FlightEnded (local)
local REMOTE_END_DELAY = 0.6
local BURST_TIME = 0.35
local RING_SPIN = 0.6 -- rad/s
local SINK_SPEED = 2.2 -- studs/s the landed glider sinks
local WHITE = Color3.new(1, 1, 1)
local GOLD = Theme.Colors.Skill
local MISS_RED = Theme.Colors.Danger

export type LocalState = {
	Active: boolean,
	Plan: FlightSim.Plan?,
	Position: Vector3, -- glider position (world)
	Velocity: Vector3, -- studs/s along the path
	Speed: number,
	Landed: boolean,
	LandPosition: Vector3,
}

type Rig = {
	Id: string,
	Model: Model,
	Root: BasePart,
	Offset: CFrame, -- Root.CFrame = pivot * Offset (the model is rigged: only Root is anchored)
	Trail: Trail,
	A0: Attachment,
	A1: Attachment,
	Sparks: ParticleEmitter,
	Lift: ParticleEmitter,
	Aura: ParticleEmitter,
}

type RingView = {
	Ring: ThermalRings.Ring,
	Center: Vector3,
	State: string, -- "Idle" | "Open" | "Perfect" | "Miss" | "Burst"
	BurstAt: number,
	BurstScale: number,
	Released: boolean,
}

type View = {
	Plan: FlightSim.Plan,
	IsLocal: boolean,
	Scale: number, -- world DistanceScale
	Rig: Rig,
	Hand: Vector3?,
	Held: Model?, -- remote thrower's held glider (hidden during the flight)
	TrailArmed: boolean,
	LastCF: CFrame,
	Landed: boolean,
	LandPos: Vector3,
	LandedAt: number, -- os.clock()
	EndAt: number, -- os.clock(); 0 while flying
	WaterColor: Color3,
	-- local flight only
	Rings: { RingView },
	RingColor: Color3,
	NextPass: number,
	OpenRing: number, -- 0 = no gust window open
	Combo: number,
	Zones: { Zones.Zone },
	ZoneIndex: number,
	Shown: { [number]: string }, -- ring -> "plus" | "max" (what the pass popup showed)
	ShownPerfect: { [number]: boolean },
}

local views: { [number]: View } = {}
local localView: View? = nil
local ending: { View } = {}
local rigPool: { [string]: { Rig } } = {}
local trailCache: { [string]: ColorSequence } = {}
local flightsFolder: Folder? = nil

local localState: LocalState = {
	Active = false,
	Plan = nil,
	Position = Vector3.zero,
	Velocity = Vector3.zero,
	Speed = 0,
	Landed = false,
	LandPosition = Vector3.zero,
}

--------------------------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------------------------

local function getFolder(): Folder
	local f = flightsFolder
	if f and f.Parent then
		return f
	end
	local created = Instance.new("Folder")
	created.Name = "Flights"
	created.Parent = Effects.Folder()
	flightsFolder = created
	return created
end

local function currentWorld(): number?
	local data = StateController.Data
	if data and type(data.World) == "number" then
		return data.World
	end
	return nil
end

local function themeFor(worldId: number): Themes.Theme
	local world = Worlds.Get(worldId) or Worlds.List[1]
	return Themes[world.Theme] or Themes.Isles
end

-- Same path as FlightSim.Sample (lateral sway, altitude, distance along the channel) without
-- allocating a sample table. Returns the world position and the lateral offset.
local function pathPoint(plan: FlightSim.Plan, t: number): (Vector3, number)
	local u = FlightSim.Progress(t, plan.Duration)
	local x = plan.Sway * math.sin(u * math.pi * plan.SwayFreq * 2) * (1 - u)
	return Map.ChannelPoint(plan.World, x, FlightSim.Altitude(plan, u), plan.Length * u), x
end

local function ringCenter(plan: FlightSim.Plan, u: number): Vector3
	local x = plan.Sway * math.sin(u * math.pi * plan.SwayFreq * 2) * (1 - u)
	return Map.ChannelPoint(plan.World, x, FlightSim.Altitude(plan, u), u * plan.Length)
end

-- Where the thrower's glider leaves the hand (held glider, then hand), plus the held glider model.
local function handOf(userId: number): (Vector3?, Model?)
	local player = Players:GetPlayerByUserId(userId)
	local character = player and player.Character
	if not character then
		return nil, nil
	end
	local held = character:FindFirstChild("HeldGlider")
	if held and held:IsA("Model") then
		return held:GetPivot().Position, held
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand and hand:IsA("BasePart") then
		return hand.Position, nil
	end
	return nil, nil
end

-- Local-only hide of a remote thrower's held glider while their thrown copy flies.
local function setHeldHidden(model: Model, hidden: boolean)
	local value = if hidden then 1 else 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = value
		end
	end
end

local function trailSequence(id: string?): ColorSequence?
	if not id then
		return nil
	end
	local cached = trailCache[id]
	if cached then
		return cached
	end
	local def = Trails.Get(id)
	if not def or #def.Colors == 0 then
		return nil
	end
	local seq: ColorSequence
	if #def.Colors == 1 then
		seq = ColorSequence.new(Color3.fromHex(def.Colors[1]))
	else
		local points = table.create(#def.Colors)
		for i, hex in def.Colors do
			points[i] = ColorSequenceKeypoint.new((i - 1) / (#def.Colors - 1), Color3.fromHex(hex))
		end
		seq = ColorSequence.new(points)
	end
	trailCache[id] = seq
	return seq
end

local function predictedRingSkill(perfect: boolean): (number, boolean)
	local data = StateController.Data
	local derived = StateController.Derived()
	local level = if data then tonumber(data.Level) else nil
	local cap = tonumber(derived.LevelCap)
	if level and cap and level >= cap then
		return 0, true
	end
	local perRing = tonumber(derived.SkillPerRing) or 1
	local multiplier = tonumber(derived.SkillMultiplier) or 1
	return perRing * multiplier * (if perfect then Flight.PerfectMultiplier else 1), false
end

--------------------------------------------------------------------------------------------------
-- Glider rigs (pooled per glider id)
--------------------------------------------------------------------------------------------------

local function emitter(name: string, parent: Instance): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Enabled = false
	e.Rate = 0
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Parent = parent
	return e
end

local function buildRig(id: string): Rig
	local model = GliderFactory.ForId(id, GLIDER_LENGTH, true)
	local root = model.PrimaryPart
	if not root then
		local fallback = Effects.Part()
		fallback.Name = "Root"
		fallback.Transparency = 1
		fallback.Size = Vector3.one * 0.2
		fallback.Parent = model
		model.PrimaryPart = fallback
		root = fallback
	end
	local r = root :: BasePart
	local _, offset = FactoryKit.Rig(model)
	local a0 = Instance.new("Attachment")
	a0.Name = "SGTrailL"
	a0.Parent = r
	local a1 = Instance.new("Attachment")
	a1.Name = "SGTrailR"
	a1.Parent = r
	local trail = Instance.new("Trail")
	trail.Name = "SGTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.FaceCamera = true
	trail.MinLength = 0.1
	trail.LightInfluence = 0
	trail.Enabled = false
	trail.Parent = r
	local fx = Instance.new("Attachment")
	fx.Name = "SGFx"
	fx.Parent = r
	local sparks = emitter("SGSparks", fx)
	sparks.Speed = NumberRange.new(16, 30)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Lifetime = NumberRange.new(0.35, 0.6)
	sparks.Drag = 3
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	sparks.Transparency = NumberSequence.new(0, 1)
	local lift = emitter("SGLift", fx)
	lift.EmissionDirection = Enum.NormalId.Top
	lift.Orientation = Enum.ParticleOrientation.VelocityParallel
	lift.Speed = NumberRange.new(14, 26)
	lift.SpreadAngle = Vector2.new(25, 25)
	lift.Lifetime = NumberRange.new(0.4, 0.65)
	lift.Acceleration = Vector3.new(0, 24, 0)
	lift.Size = NumberSequence.new(0.35)
	lift.Squash = NumberSequence.new(2.4)
	lift.Transparency = NumberSequence.new(0.2, 1)
	local aura = emitter("SGAura", fx)
	aura.Rate = 40
	aura.Speed = NumberRange.new(2, 6)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Lifetime = NumberRange.new(0.4, 0.8)
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	aura.Transparency = NumberSequence.new(0.1, 1)
	return { Id = id, Model = model, Root = r, Offset = offset, Trail = trail, A0 = a0, A1 = a1, Sparks = sparks, Lift = lift, Aura = aura }
end

local function acquireRig(id: string): Rig
	local list = rigPool[id]
	local rig = if list then table.remove(list) else nil
	if not rig then
		rig = buildRig(id)
	end
	return rig :: Rig
end

local function releaseRig(rig: Rig)
	rig.Trail.Enabled = false
	rig.Trail:Clear()
	rig.Aura.Enabled = false
	rig.Model.Parent = nil
	local list = rigPool[rig.Id]
	if not list then
		list = {}
		rigPool[rig.Id] = list
	end
	if #list < POOL_PER_GLIDER then
		table.insert(list, rig)
	else
		rig.Model:Destroy()
	end
end

-- Trail look for this flight: special (thick, coloured) > equipped trail > white wisps.
local function styleRig(rig: Rig, plan: FlightSim.Plan, isLocal: boolean)
	local trail = rig.Trail
	trail.Enabled = false
	trail:Clear()
	rig.Aura.Enabled = false
	local special = FlightSim.SpecialInfo(plan.Special)
	local seq = trailSequence(plan.Trail)
	if special then
		local color = Color3.fromHex(special.Color)
		trail.Color = ColorSequence.new(color, WHITE)
		trail.Transparency = NumberSequence.new(0.05, 1)
		trail.WidthScale = NumberSequence.new(1, 0.35)
		trail.Lifetime = 0.9
		trail.LightEmission = 1
		rig.A0.Position = Vector3.new(-2.4, 0, 1.2)
		rig.A1.Position = Vector3.new(2.4, 0, 1.2)
		rig.Aura.Color = ColorSequence.new(color)
		rig.Aura.Rate = if FlightFX.Low() then 10 else 40
		rig.Aura.Enabled = true
	elseif seq then
		trail.Color = seq
		trail.Transparency = NumberSequence.new(0.15, 1)
		trail.WidthScale = NumberSequence.new(1, 0.25)
		trail.Lifetime = if isLocal then 0.6 else 0.45
		trail.LightEmission = 0.7
		rig.A0.Position = Vector3.new(-1.2, 0, 1.2)
		rig.A1.Position = Vector3.new(1.2, 0, 1.2)
	else
		trail.Color = ColorSequence.new(WHITE)
		trail.Transparency = NumberSequence.new(0.55, 1)
		trail.WidthScale = NumberSequence.new(1, 0.1)
		trail.Lifetime = 0.35
		trail.LightEmission = 0.3
		rig.A0.Position = Vector3.new(-0.9, 0, 1.2)
		rig.A1.Position = Vector3.new(0.9, 0, 1.2)
	end
end

--------------------------------------------------------------------------------------------------
-- Rings (local flight)
--------------------------------------------------------------------------------------------------

local function ringLook(view: View, rv: RingView, state: string)
	rv.State = state
	if state == "Open" then
		ThermalRings.SetLook(rv.Ring, view.RingColor:Lerp(WHITE, 0.6), 0, 0.72)
	elseif state == "Perfect" then
		ThermalRings.SetLook(rv.Ring, GOLD, 0, 0.6)
	elseif state == "Miss" then
		ThermalRings.SetLook(rv.Ring, MISS_RED, 0.25, 0.9)
	else
		ThermalRings.SetLook(rv.Ring, view.RingColor, 0.05, 0.88)
	end
end

local function spawnRings(view: View)
	local plan = view.Plan
	local clock = os.clock()
	for k, u in plan.Rings do
		local center = ringCenter(plan, u)
		local ring = ThermalRings.Acquire(center, view.RingColor, clock * RING_SPIN + k)
		view.Rings[k] = { Ring = ring, Center = center, State = "Idle", BurstAt = 0, BurstScale = 1, Released = false }
	end
end

local function releaseRings(view: View)
	for _, rv in view.Rings do
		if not rv.Released then
			rv.Released = true
			ThermalRings.Release(rv.Ring)
		end
	end
end

local function stepRings(view: View, clock: number)
	local spin = clock * RING_SPIN
	local nearLimit = view.NextPass + 3
	for k, rv in view.Rings do
		if rv.Released then
			continue
		end
		if rv.State == "Burst" then
			local a = (clock - rv.BurstAt) / BURST_TIME
			if a >= 1 then
				rv.Released = true
				ThermalRings.Release(rv.Ring)
			else
				for _, p in rv.Ring.Parts do
					p.Transparency = a
				end
				rv.Ring.Disc.Transparency = 0.85 + 0.15 * a
				ThermalRings.Step(rv.Ring, spin + k, 1 + a * rv.BurstScale)
			end
		elseif k <= nearLimit then
			local pulse = if k == view.OpenRing then 1 + 0.07 * math.sin(clock * 18) else 1
			ThermalRings.Step(rv.Ring, spin + k, pulse)
		end
	end
end

local function passRing(view: View, k: number, perfect: boolean, clock: number)
	local rig = view.Rig
	local rv = view.Rings[k]
	local pos = if rv then rv.Center else rig.Root.Position
	Bus.RingPassed:Fire(k, perfect, pos)
	AudioController.PlayPitched("Ring", 1 + 0.06 * view.Combo)
	view.Combo += 1
	if perfect then
		AudioController.Play("Perfect")
		rig.Sparks.Color = Theme.Rainbow
		rig.Sparks:Emit(FlightFX.Count(40))
		FlightFX.Popup(rig.Root, "PERFECT!", GOLD, 1.5, 4.4, 0.9)
	else
		rig.Sparks.Color = ColorSequence.new(view.RingColor, WHITE)
		rig.Sparks:Emit(FlightFX.Count(14))
	end
	rig.Lift:Emit(FlightFX.Count(if perfect then 16 else 8))
	local amount, atCap = predictedRingSkill(perfect)
	if atCap then
		FlightFX.Popup(rig.Root, "MAX LEVEL", Theme.Colors.Rebirth, 1, 2.4, 0.8)
		view.Shown[k] = "max"
	else
		FlightFX.Popup(rig.Root, "+" .. Format.Short(amount), Theme.Colors.Skill, if perfect then 1.3 else 1, 2.2, 0.8)
		view.Shown[k] = "plus"
	end
	view.ShownPerfect[k] = perfect
	if rv and not rv.Released then
		rv.State = "Burst"
		rv.BurstAt = clock
		rv.BurstScale = if perfect then 1.8 else 0.9
		ThermalRings.SetLook(rv.Ring, if perfect then GOLD else view.RingColor:Lerp(WHITE, 0.4), 0, 0.85)
	end
end

local function setGustWindow(view: View, index: number)
	if index == view.OpenRing then
		return
	end
	local old = view.OpenRing
	if old > 0 then
		local rv = view.Rings[old]
		if rv and rv.State == "Open" then
			ringLook(view, rv, "Idle")
		end
		Bus.GustWindow:Fire(false, old)
	end
	view.OpenRing = index
	if index > 0 then
		local rv = view.Rings[index]
		if rv and rv.State == "Idle" then
			ringLook(view, rv, "Open")
		end
		Bus.GustWindow:Fire(true, index)
	end
end

--------------------------------------------------------------------------------------------------
-- Flight lifecycle
--------------------------------------------------------------------------------------------------

local function finish(view: View)
	local plan = view.Plan
	if views[plan.Id] ~= view then
		return
	end
	views[plan.Id] = nil
	releaseRings(view)
	releaseRig(view.Rig)
	local held = view.Held
	if held and held.Parent then
		setHeldHidden(held, false)
	end
	if view.IsLocal then
		setGustWindow(view, 0)
		if localView == view then
			localView = nil
			localState.Active = false
			localState.Plan = nil
			localState.Landed = false
		end
		AudioController.Loop("Wind", false)
		FlightFX.SetSpeedLines(0)
		ThrowController.SetActive(nil)
	end
	Bus.FlightEnded:Fire(plan, view.IsLocal)
end

local function land(view: View, clock: number)
	view.Landed = true
	view.LandedAt = clock
	local plan = view.Plan
	local p = pathPoint(plan, plan.Duration)
	view.LandPos = p
	view.Rig.Trail.Enabled = false
	view.Rig.Aura.Enabled = false
	FlightFX.Splash(p, view.WaterColor, view.IsLocal)
	if view.IsLocal then
		AudioController.Play("Splash")
		AudioController.Loop("Wind", false)
		FlightFX.SetSpeedLines(0)
		setGustWindow(view, 0)
		localState.Landed = true
		localState.LandPosition = p
		localState.Position = p
		localState.Velocity = Vector3.zero
		localState.Speed = 0
		Bus.FlightProgress:Fire(plan.Distance, plan)
		view.EndAt = clock + LOCAL_END_DELAY
	else
		AudioController.Play("Splash", p, 0.25, 0.6)
		view.EndAt = clock + REMOTE_END_DELAY
	end
end

-- Positions the glider along the path (blending out of the hand at the start). Returns the path
-- velocity in studs/s.
local function placeGlider(view: View, t: number): Vector3
	local plan = view.Plan
	local p, x = pathPoint(plan, t)
	local p2, x2 = pathPoint(plan, t + LOOKAHEAD)
	local velocity = (p2 - p) / LOOKAHEAD
	local hand = view.Hand
	if hand and t < HAND_BLEND then
		local k = 1 - math.max(t, 0) / HAND_BLEND
		p = p:Lerp(hand, k * k)
	end
	local dir = p2 - p
	local cf: CFrame
	if dir.Magnitude > 1e-3 then
		local bank = math.clamp(-(x2 - x) / LOOKAHEAD * 0.06, -0.55, 0.55)
		cf = CFrame.lookAt(p, p + dir) * CFrame.Angles(0, 0, bank)
	else
		cf = view.LastCF.Rotation + p
	end
	view.Rig.Root.CFrame = cf * view.Rig.Offset
	view.LastCF = cf
	if not view.TrailArmed then
		view.TrailArmed = true
		view.Rig.Trail:Clear()
		view.Rig.Trail.Enabled = true
	end
	if view.IsLocal then
		localState.Position = p
		localState.Velocity = velocity
		localState.Speed = velocity.Magnitude
	end
	return velocity
end

local function updateLocal(view: View, t: number, clock: number)
	local plan = view.Plan
	local sample = FlightSim.Sample(plan, t, view.Scale)
	Bus.FlightProgress:Fire(sample.Distance, plan)

	local zones = view.Zones
	while view.ZoneIndex < #zones and sample.Distance >= zones[view.ZoneIndex + 1].Distance do
		view.ZoneIndex += 1
		Bus.ZoneEntered:Fire(zones[view.ZoneIndex])
		AudioController.Play("ZoneEnter", nil, 0.25)
	end

	-- gust window of the next ring: [t_k - GustEarly, t_k + GustLate]
	local idx = FlightSim.NextRing(plan, t)
	local open = 0
	if idx and t >= plan.RingTimes[idx] - Flight.GustEarly then
		open = idx
	end
	setGustWindow(view, open)

	-- ring passes: wait out the late part of the window unless the tap already landed PERFECT
	local times = plan.RingTimes
	while view.NextPass <= #times do
		local k = view.NextPass
		local rt = times[k]
		if t < rt then
			break
		end
		local perfect = ThrowController.IsPerfect(k)
		if not perfect and t < rt + Flight.GustLate then
			break
		end
		passRing(view, k, perfect, clock)
		view.NextPass += 1
	end

	local speedK = math.clamp(localState.Speed / 280, 0, 1)
	AudioController.Loop("Wind", true, 0.3 + 0.7 * speedK, 0.85 + 0.35 * speedK)
	FlightFX.SetSpeedLines((localState.Speed - 120) / 180)
end

local function updateView(view: View, now: number, clock: number)
	local plan = view.Plan
	local t = math.max(0, now - plan.Start)
	if not view.Landed then
		placeGlider(view, math.min(t, plan.Duration))
		if view.IsLocal then
			updateLocal(view, math.min(t, plan.Duration), clock)
		end
		if t >= plan.Duration then
			land(view, clock)
		end
	else
		-- bob down into the water, nose dipping
		local k = clock - view.LandedAt
		local cf = CFrame.new(view.LandPos - Vector3.new(0, k * SINK_SPEED, 0)) * view.LastCF.Rotation * CFrame.Angles(-math.min(k, 0.6) * 0.6, 0, 0)
		view.Rig.Root.CFrame = cf * view.Rig.Offset
	end
	if view.IsLocal then
		stepRings(view, clock)
	end
	if view.EndAt > 0 and clock >= view.EndAt then
		table.insert(ending, view)
	end
end

local function step(dt: number)
	FlightFX.Step(dt)
	if next(views) == nil then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local clock = os.clock()
	for _, view in views do
		updateView(view, now, clock)
	end
	if #ending > 0 then
		for _, view in ending do
			finish(view)
		end
		table.clear(ending)
	end
end

local function remoteCount(): number
	local n = 0
	for _, view in views do
		if not view.IsLocal then
			n += 1
		end
	end
	return n
end

local function onFlightStarted(raw: any)
	local plan = FlightSim.Deserialize(raw)
	if not plan or views[plan.Id] then
		return
	end
	local loose = plan :: any
	if type(loose.Sway) ~= "number" then
		loose.Sway = 0
	end
	if type(loose.SwayFreq) ~= "number" then
		loose.SwayFreq = 1
	end
	local isLocal = plan.UserId == LocalPlayer.UserId
	if isLocal then
		local old = localView
		if old then
			finish(old) -- a new throw (auto throw) replaces a flight still splashing
		end
	else
		local world = currentWorld()
		if world == nil or plan.World ~= world or remoteCount() >= MAX_REMOTE then
			return
		end
	end

	local world = Worlds.Get(plan.World) or Worlds.List[1]
	local theme = themeFor(plan.World)
	local rig = acquireRig(plan.Glider)
	styleRig(rig, plan, isLocal)
	local hand, held = handOf(plan.UserId)
	if hand and (hand - Map.ChannelPoint(plan.World, 0, 6, 0)).Magnitude > 150 then
		hand = nil -- thrower isn't near the channel start (respawned, teleported)
	end
	if isLocal then
		held = nil -- ThrowController hides the local one
	elseif held then
		setHeldHidden(held, true)
	end
	local start = hand or pathPoint(plan, 0)
	rig.Root.CFrame = CFrame.new(start) * rig.Offset
	rig.Model.Parent = getFolder()

	local view: View = {
		Plan = plan,
		IsLocal = isLocal,
		Scale = world.DistanceScale,
		Rig = rig,
		Hand = hand,
		Held = held,
		TrailArmed = false,
		LastCF = CFrame.new(start),
		Landed = false,
		LandPos = start,
		LandedAt = 0,
		EndAt = 0,
		WaterColor = Color3.fromHex(theme.Water),
		Rings = {},
		RingColor = Color3.fromHex(theme.Accent):Lerp(WHITE, 0.3),
		NextPass = 1,
		OpenRing = 0,
		Combo = 0,
		Zones = Zones.ForWorld(plan.World),
		ZoneIndex = 1,
		Shown = {},
		ShownPerfect = {},
	}
	views[plan.Id] = view

	local ahead = pathPoint(plan, 0.15)
	local direction = if (ahead - start).Magnitude > 0.01 then (ahead - start).Unit else Vector3.new(0, 0, -1)
	FlightFX.Launch(start, direction, plan.PerfectLaunch, isLocal)
	local special = FlightSim.SpecialInfo(plan.Special)
	if special then
		FlightFX.SpecialBurst(start, direction, Color3.fromHex(special.Color))
	end

	if isLocal then
		localView = view
		localState.Active = true
		localState.Plan = plan
		localState.Position = start
		localState.Velocity = Vector3.zero
		localState.Speed = 0
		localState.Landed = false
		localState.LandPosition = start
		spawnRings(view)
		ThrowController.SetActive(plan)
		AudioController.Loop("Wind", true, 0.3, 0.85)
	end
	Bus.FlightStarted:Fire(plan, isLocal)
end

local function onFlightRing(payload: any)
	if type(payload) ~= "table" then
		return
	end
	Bus.RingResult:Fire(payload)
	local view = localView
	local index = payload.Index
	if not view or view.Plan.Id ~= payload.Id or type(index) ~= "number" then
		return
	end
	local adornee = view.Rig.Root
	if payload.Amount == 0 and view.Shown[index] == "plus" then
		view.Shown[index] = "max"
		FlightFX.Popup(adornee, "MAX LEVEL", Theme.Colors.Rebirth, 1, 3, 0.9)
	end
	if payload.Perfect == true and view.ShownPerfect[index] == false then
		-- the server's ping allowance accepted a tap this client judged late
		view.ShownPerfect[index] = true
		FlightFX.Popup(adornee, "PERFECT!", GOLD, 1.2, 4.4, 0.8)
		AudioController.Play("Perfect")
	end
end

local function onFlightLanded(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if payload.Cancelled == true then
		local view = if type(payload.Id) == "number" then views[payload.Id] else nil
		if view then
			finish(view)
		end
		return
	end
	if payload.Owner == true then
		Bus.FlightLanded:Fire(payload)
	end
end

-- Remote flights from another world stop rendering when the local player changes world.
local function onWorldChanged(worldId: number)
	for _, view in views do
		if not view.IsLocal and view.Plan.World ~= worldId then
			table.insert(ending, view)
		end
	end
	for _, view in ending do
		finish(view)
	end
	table.clear(ending)
end

local function onTapped(index: number, verdict: string)
	local view = localView
	if not view or view.Landed then
		return
	end
	local rv = view.Rings[index]
	if verdict == "Perfect" then
		if rv and not rv.Released and rv.State ~= "Burst" then
			ringLook(view, rv, "Perfect")
		end
	elseif verdict == "Miss" then
		if rv and not rv.Released and rv.State ~= "Burst" then
			ringLook(view, rv, "Miss")
		end
		AudioController.Play("Miss", nil, 0.1)
		FlightFX.Popup(view.Rig.Root, "TOO EARLY", Theme.Colors.TextMuted, 0.8, 3.2, 0.6)
	end
end

--------------------------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------------------------

-- Live state of the local flight (one shared table; read it, don't keep or modify it).
function FlightRenderer.LocalState(): LocalState
	return localState
end

function FlightRenderer.IsLocalFlying(): boolean
	return localState.Active and not localState.Landed
end

function FlightRenderer.Start()
	Remotes.Event("FlightStarted").OnClientEvent:Connect(onFlightStarted)
	Remotes.Event("FlightRing").OnClientEvent:Connect(onFlightRing)
	Remotes.Event("FlightLanded").OnClientEvent:Connect(onFlightLanded)
	ThrowController.Tapped:Connect(onTapped)
	Bus.WorldChanged:Connect(function(worldId)
		if type(worldId) == "number" then
			onWorldChanged(worldId)
		end
	end)
	StateController.DataChanged:Connect(function(data, previous)
		if type(data) == "table" and type(previous) == "table" and data.World ~= previous.World and type(data.World) == "number" then
			onWorldChanged(data.World)
		end
	end)
	RunService:BindToRenderStep("SkyGlideFlights", Enum.RenderPriority.Camera.Value - 2, step)
end

return FlightRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Net</string>
              <string name="Source"><![CDATA[--!strict
-- Thin wrappers for client -> server intents. Invoke() shows the server's error/message as a
-- toast so every button gets consistent feedback.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Net.Remotes)

local Net = {}

local busy: { [string]: boolean } = {}

-- Invokes a RemoteFunction. Returns the result table ({ ok = boolean, error?, message? ... }).
-- `quiet` suppresses toasts. Concurrent invokes of the same remote are dropped (double clicks).
function Net.Invoke(name: string, quiet: boolean?, ...: any): { [string]: any }
	if busy[name] then
		return { ok = false, error = "busy" }
	end
	busy[name] = true
	local ok, result = pcall(function(...)
		return Remotes.Function(name):InvokeServer(...)
	end, ...)
	busy[name] = nil
	if not ok or type(result) ~= "table" then
		result = { ok = false, error = "Connection problem. Try again." }
	end
	if not quiet then
		local UIController = require(script.Parent.UIController)
		if result.ok == false and result.error and result.error ~= "busy" then
			UIController.Toast(result.error, "Error")
		elseif result.ok and result.message then
			UIController.Toast(result.message, "Success")
		end
	end
	return result
end

function Net.Fire(name: string, ...: any)
	Remotes.Event(name):FireServer(...)
end

return Net
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">PetFollowController</string>
              <string name="Source"><![CDATA[--!strict
-- Renders equipped pets following every player in the local player's world. The server mirrors
-- each player's equipped pet ids into the Player attribute "Pets" (comma-separated); models are
-- built locally with PetFactory (anchored, client-only) and moved with PivotTo. Pets near the
-- camera update every frame, far ones at ~10 Hz, players beyond 200 studs are skipped, and the
-- total is capped so busy servers stay smooth.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetFactory = require(Shared.Visual.PetFactory)
local FactoryKit = require(Shared.Visual.FactoryKit)
local Pets = require(Shared.Definitions.Pets)

local Bus = require(script.Parent.Bus)

local PetFollowController = {}

local MAX_PETS = 40
local MAX_DISTANCE = 200
local NEAR_DISTANCE = 70
local PET_SIZE = 2.2

type Follower = { Model: Model, Root: BasePart?, Offset: CFrame, Id: string, Position: Vector3, Facing: Vector3 }
type Entry = { Player: Player, Ids: { string }, Followers: { Follower } }

local entries: { [Player]: Entry } = {}
local folder: Folder
local localPlayer = Players.LocalPlayer
local farAccumulator = 0
local localWorld = 0

local function parseIds(value: any): { string }
	local ids = {}
	if type(value) == "string" then
		for id in string.gmatch(value, "[^,]+") do
			if Pets.Get(id) then
				table.insert(ids, id)
			end
		end
	end
	return ids
end

local function clearFollowers(entry: Entry)
	for _, f in entry.Followers do
		f.Model:Destroy()
	end
	entry.Followers = {}
end

local function totalFollowers(): number
	local n = 0
	for _, entry in entries do
		n += #entry.Followers
	end
	return n
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

local function sameWorld(player: Player): boolean
	local world = player:GetAttribute("World")
	return world == nil or localWorld == 0 or world == localWorld
end

local function rebuild(entry: Entry)
	clearFollowers(entry)
	if not sameWorld(entry.Player) then
		return
	end
	local root = rootOf(entry.Player)
	local start = if root then root.Position else Vector3.zero
	for _, id in entry.Ids do
		if totalFollowers() >= MAX_PETS then
			break
		end
		local model = PetFactory.ForId(id, PET_SIZE)
		model.Name = "Pet_" .. id
		local petRoot, offset = FactoryKit.Rig(model)
		model.Parent = folder
		table.insert(entry.Followers, { Model = model, Root = petRoot, Offset = offset, Id = id, Position = start, Facing = Vector3.new(0, 0, -1) })
	end
end

local function track(player: Player)
	if entries[player] then
		return
	end
	local entry: Entry = { Player = player, Ids = parseIds(player:GetAttribute("Pets")), Followers = {} }
	entries[player] = entry
	player:GetAttributeChangedSignal("Pets"):Connect(function()
		entry.Ids = parseIds(player:GetAttribute("Pets"))
		rebuild(entry)
	end)
	player:GetAttributeChangedSignal("World"):Connect(function()
		rebuild(entry)
	end)
	player.CharacterAdded:Connect(function()
		task.defer(rebuild, entry)
	end)
	rebuild(entry)
end

local function untrack(player: Player)
	local entry = entries[player]
	if entry then
		clearFollowers(entry)
		entries[player] = nil
	end
end

-- Slot offset (in the owner's local space) for pet `i` of `n`: an arc behind the character.
local function slotOffset(i: number, n: number): Vector3
	local spread = math.min(1, (n - 1) / 2) * 0.9
	local t = if n <= 1 then 0 else (i - 1) / (n - 1) * 2 - 1
	local angle = t * spread
	local radius = 5 + (if n > 3 then 1 else 0)
	return Vector3.new(math.sin(angle) * radius, 0, math.cos(angle) * radius)
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	farAccumulator += dt
	local updateFar = farAccumulator >= 0.1
	if updateFar then
		farAccumulator = 0
	end
	local t = os.clock()
	for _, entry in entries do
		local root = rootOf(entry.Player)
		if root == nil or #entry.Followers == 0 then
			continue
		end
		local distance = (root.Position - camPos).Magnitude
		local visible = distance <= MAX_DISTANCE
		local wanted: Instance? = if visible then folder else nil
		for _, f in entry.Followers do
			if f.Model.Parent ~= wanted then
				f.Model.Parent = wanted
			end
		end
		if not visible or (distance > NEAR_DISTANCE and not updateFar) then
			continue
		end
		local elapsed = if distance > NEAR_DISTANCE then 0.1 else dt
		local alpha = 1 - math.exp(-elapsed * 8)
		local velocity = root.AssemblyLinearVelocity
		local moving = Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 2
		local n = #entry.Followers
		for i, f in entry.Followers do
			local target = root.CFrame:PointToWorldSpace(slotOffset(i, n))
			target = Vector3.new(target.X, root.Position.Y - 1.6, target.Z)
			f.Position = f.Position:Lerp(target, alpha)
			if (f.Position - target).Magnitude > 40 then
				f.Position = target -- teleported owner: snap
			end
			local face = if moving then Vector3.new(velocity.X, 0, velocity.Z).Unit else root.CFrame.LookVector * Vector3.new(1, 0, 1)
			if face.Magnitude > 0.01 then
				f.Facing = f.Facing:Lerp(face.Unit, alpha)
			end
			local bob = if moving then math.abs(math.sin(t * 9 + i)) * 0.9 else math.sin(t * 2.5 + i) * 0.25 + 0.25
			local pos = f.Position + Vector3.new(0, PET_SIZE * 0.5 + bob, 0)
			local look = if f.Facing.Magnitude > 0.01 then f.Facing else Vector3.new(0, 0, -1)
			local cf = CFrame.lookAt(pos, pos + look)
			local petRoot = f.Root
			if petRoot then
				petRoot.CFrame = cf * f.Offset
			else
				f.Model:PivotTo(cf)
			end
		end
	end
end

function PetFollowController.Start()
	folder = Instance.new("Folder")
	folder.Name = "PetFollowers"
	folder.Parent = Workspace
	localWorld = (localPlayer:GetAttribute("World") :: number?) or 0
	for _, player in Players:GetPlayers() do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	local function onWorld(worldId: number)
		localWorld = worldId
		for _, entry in entries do
			rebuild(entry)
		end
	end
	Bus.WorldChanged:Connect(onWorld)
	localPlayer:GetAttributeChangedSignal("World"):Connect(function()
		local w = localPlayer:GetAttribute("World")
		if type(w) == "number" then
			onWorld(w)
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return PetFollowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">StateController</string>
              <string name="Source"><![CDATA[--!strict
-- Client mirror of server-owned state. Read-only: every change comes from the server.
--   StateController.Data         -> profile view (Schema.PublicView + Derived/Session/...)
--   StateController.Relics       -> { [relicId] = { Sold, Stock } }
--   StateController.Leaderboards -> { [stat] = { { Name, Value } } }
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Signal = require(Shared.Util.Signal)

local StateController = {}

StateController.Data = nil :: { [string]: any }?
StateController.Relics = {} :: { [string]: { Sold: number, Stock: number } }
StateController.Leaderboards = {} :: { [string]: { { Name: string, Value: number } } }
StateController.Event = { Active = false, Name = "", EndsAt = 0 } :: { Active: boolean, Name: string, EndsAt: number }
StateController.ReceivedAt = 0 -- os.clock() when Data arrived (for local timers)

StateController.DataChanged = Signal.new() -- (data, previous)
StateController.ServerInfoChanged = Signal.new() -- (kind)
StateController.Notified = Signal.new() -- ({ Text, Kind })

function StateController.Get(): { [string]: any }?
	return StateController.Data
end

function StateController.Derived(): { [string]: any }
	local data = StateController.Data
	return if data and data.Derived then data.Derived else {}
end

function StateController.HasPass(key: string): boolean
	local passes = StateController.Derived().Passes
	return passes ~= nil and passes[key] == true
end

-- Seconds since the last data packet (for countdowns between syncs).
function StateController.Since(): number
	return os.clock() - StateController.ReceivedAt
end

function StateController.Start()
	Remotes.Event("PlayerData").OnClientEvent:Connect(function(data)
		local previous = StateController.Data
		StateController.Data = data
		StateController.ReceivedAt = os.clock()
		StateController.DataChanged:Fire(data, previous)
	end)
	Remotes.Event("ServerInfo").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.Kind == "Relics" and type(payload.Relics) == "table" then
			StateController.Relics = payload.Relics
		elseif payload.Kind == "Leaderboards" and type(payload.Boards) == "table" then
			StateController.Leaderboards = payload.Boards
		elseif payload.Kind == "Event" then
			StateController.Event = {
				Active = payload.Active == true,
				Name = if type(payload.Name) == "string" then payload.Name else "",
				EndsAt = if type(payload.EndsAt) == "number" then payload.EndsAt else 0,
			}
		end
		StateController.ServerInfoChanged:Fire(payload.Kind)
	end)
	Remotes.Event("Notify").OnClientEvent:Connect(function(payload)
		StateController.Notified:Fire(payload)
	end)
end

return StateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">ThrowController</string>
              <string name="Source"><![CDATA[--!strict
-- Local throwing input and feedback. Intents only: the server times the launch meter, builds the
-- plan and judges every gust tap; this module just tells it "started holding", "released" and
-- "tapped for ring N".
--   * Throw Zone detection (same math as MapService.InThrowZone) -> Bus.InThrowZoneChanged.
--   * THROW hold/release: Press()/Release() (HUD button), E and gamepad R2 while in the zone.
--   * ChargeState remote -> Bus.ChargeChanged(charging, startedAt, reason).
--   * Gust taps during the local flight (click, touch, Space, gamepad A, or the HUD's Tap()):
--     at most ONE RequestGust per ring, so spam can never fish for PERFECTs.
--   * Cosmetic throw animation: right-arm wind-up on press, swing on launch, held glider hidden
--     while the thrown one flies. FlightRenderer calls SetActive(plan | nil).
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Flight = require(Shared.Config.Flight)
local Map = require(Shared.Config.Map)
local FlightSim = require(Shared.Sim.FlightSim)
local Remotes = require(Shared.Net.Remotes)
local Signal = require(Shared.Util.Signal)

local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local StateController = require(script.Parent.StateController)
local UIController = require(script.Parent.UIController)

local ThrowController = {}

-- (ringIndex: number, verdict: "Perfect" | "Miss" | "Late") local judgement of a sent gust tap.
ThrowController.Tapped = Signal.new()

local LocalPlayer = Players.LocalPlayer

local THROW_ACTION = "SkyGlideThrow"
local GUST_ACTION = "SkyGlideGust"
local ZONE_CHECK_INTERVAL = 0.1
local TOAST_COOLDOWN = 2
local LATE_GRACE = 0.2 -- a tap this soon after a ring's window still goes to that ring (ping help)
local WIND_UP_ANGLE = -1.0 -- radians: arm swung back
local RELEASE_ANGLE = 1.7 -- radians: arm swung forward

local inZone = false
local pressing = false
local charging = false
local pressAt = 0 -- server-clock time of the local press (the meter is drawn from it)
local activePlan: FlightSim.Plan? = nil
local sent: { [number]: boolean } = {}
local perfect: { [number]: boolean } = {}
local lastToast = 0

--------------------------------------------------------------------------------------------------
-- Arm animation and held glider
--------------------------------------------------------------------------------------------------

local baseC0: { [Motor6D]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local armTween: Tween? = nil
local armGeneration = 0
local woundUp = false
local heldConn: RBXScriptConnection? = nil

-- Right shoulder motor, its rest C0 and whether the rig is R15 (rotate about X) or R6 (about Z).
local function shoulder(): (Motor6D?, CFrame, boolean)
	local character = LocalPlayer.Character
	if not character then
		return nil, CFrame.identity, true
	end
	local r15 = true
	local upper = character:FindFirstChild("RightUpperArm")
	local motor = if upper then upper:FindFirstChild("RightShoulder") else nil
	if not (motor and motor:IsA("Motor6D")) then
		local torso = character:FindFirstChild("Torso")
		motor = if torso then torso:FindFirstChild("Right Shoulder") else nil
		r15 = false
	end
	if motor and motor:IsA("Motor6D") then
		local base = baseC0[motor]
		if not base then
			base = motor.C0
			baseC0[motor] = base
		end
		return motor, base, r15
	end
	return nil, CFrame.identity, true
end

local function poseArm(angle: number, duration: number, style: Enum.EasingStyle)
	local motor, base, r15 = shoulder()
	if not motor then
		return
	end
	if armTween then
		armTween:Cancel()
	end
	local rotation = if r15 then CFrame.Angles(angle, 0, 0) else CFrame.Angles(0, 0, angle)
	local tween = TweenService:Create(motor, TweenInfo.new(duration, style, Enum.EasingDirection.Out), { C0 = base * rotation })
	armTween = tween
	tween:Play()
end

local function windUp()
	armGeneration += 1
	woundUp = true
	poseArm(WIND_UP_ANGLE, 0.22, Enum.EasingStyle.Quad)
end

local function restoreArm()
	armGeneration += 1
	if woundUp or armTween then
		woundUp = false
		poseArm(0, 0.2, Enum.EasingStyle.Quad)
	end
end

-- Back (if not already wound up) -> forward -> rest.
local function swing()
	armGeneration += 1
	local generation = armGeneration
	local wasWound = woundUp
	woundUp = false
	task.spawn(function()
		if not wasWound then
			poseArm(WIND_UP_ANGLE, 0.08, Enum.EasingStyle.Quad)
			task.wait(0.08)
			if generation ~= armGeneration then
				return
			end
		end
		poseArm(RELEASE_ANGLE, 0.1, Enum.EasingStyle.Quad)
		task.wait(0.16)
		if generation ~= armGeneration then
			return
		end
		poseArm(0, 0.3, Enum.EasingStyle.Quad)
	end)
end

local function setModelHidden(model: Instance, hidden: boolean)
	local value = if hidden then 1 else 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = value
		end
	end
end

local function hideHeldGlider(hidden: boolean)
	if heldConn then
		heldConn:Disconnect()
		heldConn = nil
	end
	local character = LocalPlayer.Character
	if not character then
		return
	end
	local held = character:FindFirstChild("HeldGlider")
	if held then
		setModelHidden(held, hidden)
	end
	if hidden then
		-- the server may rebuild the held glider mid-flight (equip change): keep it hidden
		heldConn = character.ChildAdded:Connect(function(child)
			if child.Name == "HeldGlider" then
				task.defer(setModelHidden, child, true)
			end
		end)
	end
end

--------------------------------------------------------------------------------------------------
-- Throw input
--------------------------------------------------------------------------------------------------

-- Starts holding THROW (HUD button down / E / R2). Ignored while a menu is open or flying.
function ThrowController.Press()
	if pressing or activePlan ~= nil or UIController.AnyMenuOpen() or StateController.Data == nil then
		return
	end
	pressing = true
	pressAt = Workspace:GetServerTimeNow()
	windUp()
	Net.Fire("RequestThrowCharge")
end

-- Releases THROW. The server turns the hold time into the launch meter.
function ThrowController.Release()
	if not pressing then
		return
	end
	pressing = false
	Net.Fire("RequestThrow")
end

local function onThrowAction(_: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult?
	if state == Enum.UserInputState.Begin then
		if UIController.AnyMenuOpen() or activePlan ~= nil then
			return Enum.ContextActionResult.Pass
		end
		ThrowController.Press()
		return Enum.ContextActionResult.Sink
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		if pressing then
			ThrowController.Release()
			return Enum.ContextActionResult.Sink
		end
	end
	return Enum.ContextActionResult.Pass
end

local function zoneCheck(): boolean
	local data = StateController.Data
	local character = LocalPlayer.Character
	if not data or not character then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not (root and root:IsA("BasePart")) or not humanoid or humanoid.Health <= 0 then
		return false
	end
	local world = if type(data.World) == "number" then data.World else 1
	local l = root.Position - Map.Origin(world)
	local z = Map.ThrowZone
	local tol = Map.StandTolerance
	return l.X >= z.MinX - tol and l.X <= z.MaxX + tol and l.Z >= z.MinZ - tol and l.Z <= z.MaxZ + tol and l.Y > -4 and l.Y < 16
end

local function setInZone(value: boolean)
	if value == inZone then
		return
	end
	inZone = value
	if value then
		ContextActionService:BindAction(THROW_ACTION, onThrowAction, false, Enum.KeyCode.E, Enum.KeyCode.ButtonR2)
	else
		ContextActionService:UnbindAction(THROW_ACTION)
		if pressing then
			ThrowController.Release() -- the server answers NotInZone, which shows the hint
		end
	end
	Bus.InThrowZoneChanged:Fire(value)
end

local function onChargeState(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local isCharging = payload.Charging == true
	local startedAt = if type(payload.StartedAt) == "number" then payload.StartedAt else 0
	local reason: string? = if type(payload.Reason) == "string" then payload.Reason else nil
	charging = isCharging
	if isCharging and pressing and pressAt > 0 and pressAt < startedAt then
		-- the server times the hold from its own receipt of both press and release, so the hold
		-- it measures matches the local one: draw the needle from the local press, not one-way late
		startedAt = pressAt
	end
	if not isCharging then
		if reason == "NotInZone" then
			pressing = false
			local now = os.clock()
			if now - lastToast >= TOAST_COOLDOWN then
				lastToast = now
				UIController.Toast("Walk into the THROW ZONE!", "Info")
			end
		elseif reason == "Flying" or reason == "Dead" or reason == "Loading" or reason == "Launched" then
			pressing = false
		end
		-- "Cooldown" keeps the hold: releasing still sends a quick throw once the cooldown is over
		if reason ~= "Launched" and not pressing then
			restoreArm()
		end
	end
	Bus.ChargeChanged:Fire(isCharging, startedAt, reason)
end

--------------------------------------------------------------------------------------------------
-- Gust taps
--------------------------------------------------------------------------------------------------

-- One gust tap (also called by the HUD's full-screen tap area). Sends at most one RequestGust per
-- ring: a tap in the PERFECT window or the "too early" window spends that ring (the server judges
-- it), a tap far too early is ignored without spending anything, and a tap just after a ring's
-- window is credited to that ring so the server's ping allowance can still accept it.
function ThrowController.Tap()
	local plan = activePlan
	if not plan then
		return
	end
	local t = Workspace:GetServerTimeNow() - plan.Start
	local times = plan.RingTimes
	local idx = FlightSim.NextRing(plan, t)
	local previous = if idx then idx - 1 else #times
	if previous >= 1 and not sent[previous] and t <= times[previous] + Flight.GustLate + LATE_GRACE then
		sent[previous] = true
		Net.Fire("RequestGust", plan.Id, previous)
		ThrowController.Tapped:Fire(previous, "Late")
		return
	end
	if idx == nil or sent[idx] then
		return
	end
	-- judge as the server will: at the predicted arrival time, with the same ping allowance
	local ping = 0
	pcall(function()
		ping = LocalPlayer:GetNetworkPing()
	end)
	local verdict = FlightSim.JudgeGust(plan, idx, t + ping * 0.5, ping)
	if verdict == nil then
		return -- far too early: the server would ignore it as well
	end
	sent[idx] = true
	if verdict == "Perfect" then
		perfect[idx] = true
	end
	Net.Fire("RequestGust", plan.Id, idx)
	ThrowController.Tapped:Fire(idx, verdict)
end

local function onGustAction(_: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult?
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if GuiService.SelectedObject ~= nil or UIController.AnyMenuOpen() then
		return Enum.ContextActionResult.Pass -- gamepad A is pressing a selected button
	end
	ThrowController.Tap()
	return Enum.ContextActionResult.Sink -- no jumping mid-flight
end

--------------------------------------------------------------------------------------------------
-- Public state
--------------------------------------------------------------------------------------------------

-- The local player's flight plan while it is in the air (nil otherwise).
function ThrowController.ActivePlan(): FlightSim.Plan?
	return activePlan
end

-- Called by FlightRenderer when the local flight starts (plan) and when its visuals end (nil).
function ThrowController.SetActive(plan: FlightSim.Plan?)
	if plan == activePlan then
		return
	end
	activePlan = plan
	table.clear(sent)
	table.clear(perfect)
	if plan then
		pressing = false
		charging = false
		ContextActionService:BindActionAtPriority(
			GUST_ACTION,
			onGustAction,
			false,
			Enum.ContextActionPriority.High.Value,
			Enum.KeyCode.Space,
			Enum.KeyCode.ButtonA
		)
		hideHeldGlider(true)
		swing()
	else
		ContextActionService:UnbindAction(GUST_ACTION)
		hideHeldGlider(false)
	end
end

-- True when the local gust tap for ring `index` was judged PERFECT on this client.
function ThrowController.IsPerfect(index: number): boolean
	return perfect[index] == true
end

-- True once a tap was sent for ring `index`.
function ThrowController.WasTapped(index: number): boolean
	return sent[index] == true
end

function ThrowController.InZone(): boolean
	return inZone
end

function ThrowController.IsCharging(): boolean
	return charging
end

function ThrowController.IsPressing(): boolean
	return pressing
end

function ThrowController.Start()
	Remotes.Event("ChargeState").OnClientEvent:Connect(onChargeState)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < ZONE_CHECK_INTERVAL then
			return
		end
		acc = 0
		setInZone(zoneCheck())
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or activePlan == nil then
			return
		end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			ThrowController.Tap()
		end
	end)

	LocalPlayer.CharacterAdded:Connect(function()
		pressing = false
		charging = false
		woundUp = false
		armTween = nil
		armGeneration += 1
		if activePlan then
			hideHeldGlider(true) -- rebinds ChildAdded on the new character
		end
	end)
end

return ThrowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">TrainingController</string>
              <string name="Source"><![CDATA[--!strict
-- Training pads on the client. Every 0.2 s it finds the pad under the local character with the
-- same math as the server (MapService.PadAt) and fires Bus.PadChanged. While on a pad it shows the
-- pad panel (HUD layer, above the level bar): UNLOCKED/LOCKED, "<mult>x SKILL", the gate, an AUTO
-- toggle and a big TRAIN button (or "Unlock R$X" for a pass pad, or REBIRTH at max level).
-- Clicking/tapping the world (not GUI) or gamepad A on an unlocked pad sends RequestTrain,
-- throttled to Economy.TrainManualRate. The server picks the pad and pays; TrainResult only drives
-- the "+N ⚡" popups, a little character dip and the Train sound.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Map = require(Shared.Config.Map)
local Monetization = require(Shared.Config.Monetization)
local Training = require(Shared.Definitions.Training)
local Remotes = require(Shared.Net.Remotes)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local StateController = require(script.Parent.StateController)
local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local HudFlightState = require(Client.UI.Components.HudFlightState)
local HUD = require(Client.UI.Screens.HUD)
local Effects = require(Client.VFX.Effects)

local TrainingController = {}

TrainingController.Pad = nil :: Training.Pad?

local localPlayer = Players.LocalPlayer
local ACTION = "SkyGlideTrain"
local SCAN_EVERY = 0.2
local MIN_GAP = 1 / Economy.TrainManualRate
local POP = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local hex = Color3.fromHex

local padsByWorld: { [number]: { Training.Pad } } = {}
local lastSent = -math.huge
local rng = Random.new()

-- character dip (root joint C0 offset; purely local and cosmetic)
local rootJoint: Motor6D? = nil
local rootC0 = CFrame.identity

local function padsFor(world: number): { Training.Pad }
	local list = padsByWorld[world]
	if list == nil then
		list = Training.ForWorld(world)
		padsByWorld[world] = list
	end
	return list
end

local function rootPart(): BasePart?
	local character = localPlayer.Character
	local part = if character then character:FindFirstChild("HumanoidRootPart") else nil
	return if part and part:IsA("BasePart") then part else nil
end

-- Same test as MapService.PadAt on the server.
local function padAt(position: Vector3, world: number): Training.Pad?
	local l = position - Map.Origin(world)
	local halfX = Map.PadSize.X / 2 + Map.StandTolerance
	local halfZ = Map.PadSize.Z / 2 + Map.StandTolerance
	for _, pad in padsFor(world) do
		local c = Map.PadPosition(pad.Slot)
		if math.abs(l.X - c.X) <= halfX and math.abs(l.Z - c.Z) <= halfZ and l.Y > c.Y - 2 and l.Y < c.Y + 12 then
			return pad
		end
	end
	return nil
end

local function isMaxLevel(data: { [string]: any }): boolean
	local derived = if type(data.Derived) == "table" then data.Derived else {}
	local cap = tonumber(derived.LevelCap)
	return cap ~= nil and (tonumber(data.Level) or 1) >= cap
end

-- (unlocked, reason text for the gate line)
local function padState(pad: Training.Pad, data: { [string]: any }?): (boolean, string)
	if pad.PassKey then
		local pass = Monetization.Pass(pad.PassKey)
		if StateController.HasPass(pad.PassKey) then
			return true, "ALL WORLDS PAD"
		end
		return false, "ALL WORLDS - " .. (if pass then pass.Name else "Pass") .. " pass"
	end
	local rebirths = if data then tonumber(data.Rebirths) or 0 else 0
	if rebirths < pad.Rebirths then
		return false, string.format("Needs %d %s Rebirths", pad.Rebirths, Theme.Icons.Rebirth)
	end
	return true, if pad.Rebirths > 0 then string.format("%d %s Rebirths", pad.Rebirths, Theme.Icons.Rebirth) else "Free for everyone"
end

-- Sends one manual rep if allowed (throttled). Returns true when an intent was sent.
function TrainingController.Train(): boolean
	local pad = TrainingController.Pad
	local data = StateController.Data
	if not pad or not data or HudFlightState.Active then
		return false
	end
	local unlocked = padState(pad, data)
	if not unlocked or isMaxLevel(data) then
		return false
	end
	local now = os.clock()
	if now - lastSent < MIN_GAP then
		return false
	end
	lastSent = now
	Net.Fire("RequestTrain")
	return true
end

local function findRootJoint(character: Model)
	rootJoint = nil
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if not hrp then
		return
	end
	-- R15 "Root" lives in LowerTorso, R6 "RootJoint" in the HumanoidRootPart
	for _ = 1, 20 do
		for _, d in character:GetDescendants() do
			if d:IsA("Motor6D") and d.Part0 == hrp then
				rootJoint = d
				rootC0 = d.C0
				return
			end
		end
		task.wait(0.25)
		if character.Parent == nil then
			return
		end
	end
end

local dipToken = 0
local function dip()
	local joint = rootJoint
	if not joint or joint.Parent == nil then
		return
	end
	dipToken += 1
	local token = dipToken
	local down = TweenService:Create(joint, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		C0 = CFrame.new(0, -0.32, 0) * rootC0,
	})
	down:Play()
	task.delay(0.07, function()
		if token == dipToken and (joint.Parent :: Instance?) ~= nil then
			TweenService:Create(joint, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { C0 = rootC0 }):Play()
		end
	end)
end

function TrainingController.Start()
	local layer = UIController.Layer("HUD")

	-- Pad panel -----------------------------------------------------------------------------------
	local panel: Frame = Create("Frame", {
		Name = "PadPanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -HUD.ContextBottom),
		Size = UDim2.fromOffset(620, 128),
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 3,
		Parent = layer,
	})
	Create.Corner(20, panel)
	local panelStroke = Create.Stroke(panel, Theme.Colors.Stroke, 4, 0, true)
	local panelScale = Instance.new("UIScale")
	panelScale.Parent = panel
	local status = Create.Text({
		Name = "Status",
		Text = "UNLOCKED",
		Size = UDim2.fromOffset(270, 30),
		Position = UDim2.fromOffset(18, 10),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Color = Theme.Colors.Unlocked,
		Stroke = 2.5,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = panel,
	})
	local mult = Create.Text({
		Name = "Mult",
		Text = "1x SKILL",
		Size = UDim2.fromOffset(270, 52),
		Position = UDim2.fromOffset(18, 40),
		Font = Theme.Fonts.Display,
		TextSize = 52,
		Scaled = true,
		Color = Theme.Colors.Skill,
		Stroke = 3.5,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = panel,
	})
	local gate = Create.Text({
		Name = "Gate",
		Text = "",
		Size = UDim2.fromOffset(270, 26),
		Position = UDim2.fromOffset(18, 94),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		Stroke = 2,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = panel,
	})

	local pendingAuto: boolean? = nil
	local function autoOn(): boolean
		if pendingAuto ~= nil then
			return pendingAuto
		end
		local data = StateController.Data
		return data ~= nil and type(data.Settings) == "table" and data.Settings.AutoTrain == true
	end

	local refreshPanel: () -> ()
	local autoButton = Button.new({
		Parent = panel,
		Name = "Auto",
		Size = UDim2.fromOffset(118, 80),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 298, 0.5, 0),
		Style = "Red",
		Text = Theme.Icons.Auto .. " AUTO",
		TextSize = 28,
		Corner = 14,
		ZIndex = 4,
		OnClick = function()
			local on = not autoOn()
			pendingAuto = on
			Net.Fire("RequestToggle", "AutoTrain", on)
			refreshPanel()
		end,
	})
	autoButton.Label.Size = UDim2.new(1, -12, 0.5, 0)
	autoButton.Label.Position = UDim2.fromScale(0.5, 0.34)
	local autoSub = Create.Text({
		Name = "State",
		Text = "OFF",
		Size = UDim2.new(1, -12, 0.36, 0),
		Position = UDim2.fromScale(0.5, 0.74),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		Stroke = 2,
		ZIndex = autoButton.Instance.ZIndex + 2,
		Parent = autoButton.Content,
	})

	local trainHolder: Frame = Create("Frame", {
		Name = "TrainHolder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(180, 92),
		ZIndex = 4,
		Parent = panel,
	})
	local trainPunch = Instance.new("UIScale")
	trainPunch.Parent = trainHolder
	local mode = "Train" -- "Train" | "Unlock" | "Rebirth" | "Locked"
	local trainButton = Button.new({
		Parent = trainHolder,
		Name = "Train",
		Size = UDim2.fromScale(1, 1),
		Style = "Green",
		Text = "TRAIN",
		TextSize = 44,
		Corner = 18,
		ZIndex = 4,
		Silent = true,
		OnClick = function()
			local pad = TrainingController.Pad
			if mode == "Train" then
				TrainingController.Train()
			elseif mode == "Unlock" and pad and pad.PassKey then
				AudioController.Play("Click")
				task.spawn(Net.Invoke, "RequestPurchase", false, "Pass", pad.PassKey)
			elseif mode == "Rebirth" then
				AudioController.Play("Click")
				UIController.Open("Rebirth")
			else
				AudioController.Play("Error", nil, 0.2)
			end
		end,
	})

	refreshPanel = function()
		local pad = TrainingController.Pad
		local data = StateController.Data
		if not pad then
			panel.Visible = false
			return
		end
		local unlocked, reason = padState(pad, data)
		local maxed = data ~= nil and isMaxLevel(data)
		local accent = hex(pad.Color)
		panelStroke.Color = accent:Lerp(Theme.Colors.Stroke, 0.35)
		mult.Text = Format.Short(pad.Multiplier) .. "x SKILL"
		if maxed and unlocked then
			status.Text = "MAX LEVEL - REBIRTH!"
			status.TextColor3 = Theme.Colors.Rebirth
			gate.Text = "Training is paused at the level cap"
			mode = "Rebirth"
			trainButton:SetStyle("Pink")
			trainButton:SetText(Theme.Icons.Rebirth .. " REBIRTH")
		elseif unlocked then
			status.Text = "UNLOCKED"
			status.TextColor3 = Theme.Colors.Unlocked
			gate.Text = reason
			mode = "Train"
			trainButton:SetStyle("Green")
			trainButton:SetText("TRAIN")
		else
			status.Text = Theme.Icons.Lock .. " LOCKED"
			status.TextColor3 = Theme.Colors.Locked
			gate.Text = reason
			if pad.PassKey then
				local pass = Monetization.Pass(pad.PassKey)
				local available = pass ~= nil and (pass.Id ~= 0 or RunService:IsStudio())
				mode = if available then "Unlock" else "Locked"
				trainButton:SetStyle(if available then "Gold" else "Disabled")
				trainButton:SetText(if available and pass then "Unlock " .. Theme.Icons.Robux .. tostring(pass.Robux) else "SOON")
			else
				mode = "Locked"
				trainButton:SetStyle("Disabled")
				trainButton:SetText(string.format("%s %d %s", Theme.Icons.Lock, pad.Rebirths, Theme.Icons.Rebirth))
			end
		end
		local on = autoOn()
		autoButton:SetStyle(if on then "Green" else "Red")
		autoSub.Text = if on then "ON" else "OFF"
		panel.Visible = not HudFlightState.Active
	end

	-- gamepad A trains while standing on an open pad (sinks the jump only then)
	local bound = false
	local function onAction(_: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
		if GuiService.SelectedObject ~= nil then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			TrainingController.Train()
		end
		return Enum.ContextActionResult.Sink
	end
	local function refreshBinding()
		local pad = TrainingController.Pad
		local data = StateController.Data
		local want = pad ~= nil and data ~= nil and (padState(pad, data)) and not isMaxLevel(data) and not HudFlightState.Active
		if want and not bound then
			bound = true
			ContextActionService:BindActionAtPriority(ACTION, onAction, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonA)
		elseif not want and bound then
			bound = false
			ContextActionService:UnbindAction(ACTION)
		end
	end

	local function setPad(pad: Training.Pad?)
		if pad == TrainingController.Pad then
			return
		end
		local had = TrainingController.Pad ~= nil
		TrainingController.Pad = pad
		Bus.PadChanged:Fire(pad)
		refreshPanel()
		refreshBinding()
		if pad and not had and panel.Visible then
			panelScale.Scale = 0.7
			TweenService:Create(panelScale, POP, { Scale = 1 }):Play()
		end
	end

	-- world clicks / taps (GUI clicks arrive as gameProcessed and are ignored)
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed or TrainingController.Pad == nil then
			return
		end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			TrainingController.Train()
		end
	end)

	-- server results -> feedback
	Remotes.Event("TrainResult").OnClientEvent:Connect(function(payload: any)
		local amount = if type(payload) == "table" then tonumber(payload.Amount) else tonumber(payload)
		if not amount or amount <= 0 then
			return
		end
		Bus.TrainResult:Fire(amount)
		AudioController.Play("Train", nil, 0.05)
		local hrp = rootPart()
		if hrp then
			local offset = Vector3.new(rng:NextNumber(-1.6, 1.6), 3.6 + rng:NextNumber(0, 0.8), rng:NextNumber(-0.8, 0.8))
			Effects.Popup(hrp.Position + offset, "+" .. Format.Short(amount) .. " " .. Theme.Icons.Skill, Theme.Colors.Skill, 1.1)
		end
		dip()
		if panel.Visible then
			trainPunch.Scale = 0.9
			TweenService:Create(trainPunch, POP, { Scale = 1 }):Play()
		end
	end)

	StateController.DataChanged:Connect(function()
		pendingAuto = nil
		refreshPanel()
		refreshBinding()
	end)
	HudFlightState.Changed:Connect(function()
		refreshPanel()
		refreshBinding()
	end)

	local function onCharacter(character: Model)
		setPad(nil)
		task.spawn(findRootJoint, character)
	end
	localPlayer.CharacterAdded:Connect(onCharacter)
	if localPlayer.Character then
		onCharacter(localPlayer.Character)
	end

	-- pad scan
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < SCAN_EVERY then
			return
		end
		acc = 0
		local hrp = rootPart()
		local data = StateController.Data
		if not hrp or not data then
			setPad(nil)
			return
		end
		local world = tonumber(data.World) or 1
		setPad(padAt(hrp.Position, world))
	end)
end

return TrainingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
-- First-session guide (client side of TutorialService). While Data.Tutorial.Done is false it shows
-- a hint bar under AUTO THROW (Definitions/Tutorial step text, "x/Count" progress, a Skip button
-- with a confirm tap) and guides the character to the step's target: a sparkly Beam from the
-- HumanoidRootPart to an invisible anchored part plus a bobbing neon arrow above the target.
-- Steps only advance on the server; this module just draws. Everything is torn down when the
-- tutorial ends, and the beam re-attaches on respawn.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Map = require(Shared.Config.Map)
local Tutorial = require(Shared.Definitions.Tutorial)

local Client = script.Parent.Parent
local StateController = require(script.Parent.StateController)
local UIController = require(script.Parent.UIController)
local Net = require(script.Parent.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local HudFlightState = require(Client.UI.Components.HudFlightState)
local Effects = require(Client.VFX.Effects)

local TutorialController = {}

local localPlayer = Players.LocalPlayer
local GOLD = Color3.fromHex("#FFD447")
local POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local BAR_TOP = 104 -- the STEP tag pokes 13 px above the bar; stay clear of AUTO THROW (ends at 88)
local ARROW_HEIGHT = 10
local NEAR = 12 -- studs: hide the beam once the player is this close (the arrow stays)

-- Arrow pieces relative to the arrow origin (apex points down at the target).
local SHAFT_OFFSET = CFrame.new(0, 2.6, 0)
local HEAD_LEFT = CFrame.new(0, -0.4, -0.9) * CFrame.Angles(0, 0, math.pi)
local HEAD_RIGHT = CFrame.new(0, -0.4, 0.9) * CFrame.Angles(0, math.pi, math.pi)

-- World position of a step's target anchor (matches MapService.Anchor on the server).
local function targetPosition(target: string?, world: number): Vector3?
	if target == nil then
		return nil
	end
	local origin = Map.Origin(world)
	if target == "Pad1" then
		return origin + Map.PadPosition(1)
	elseif target == "ThrowZone" then
		local zone = Map.ThrowZone
		return origin + Vector3.new((zone.MinX + zone.MaxX) / 2, 0, (zone.MinZ + zone.MaxZ) / 2)
	elseif target == "GliderShop" then
		return origin + Map.PedestalPosition(2)
	elseif target == "Egg1" then
		return origin + Map.EggPosition(1)
	end
	return nil
end

type Guide = {
	Folder: Folder,
	Anchor: Part,
	EndAttachment: Attachment,
	Beam: Beam,
	Shaft: Part,
	Left: WedgePart,
	Right: WedgePart,
}

local function neon(className: string, size: Vector3, parent: Instance): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = GOLD
	p.Size = size
	p.Parent = parent
	return p
end

local function buildGuide(): Guide
	local folder = Instance.new("Folder")
	folder.Name = "TutorialGuide"
	folder.Parent = Effects.Folder()
	local anchor = neon("Part", Vector3.one, folder) :: Part
	anchor.Name = "Target"
	anchor.Transparency = 1
	local endAttachment = Instance.new("Attachment")
	endAttachment.Name = "GuideEnd"
	endAttachment.Position = Vector3.new(0, 1.5, 0)
	endAttachment.Parent = anchor
	local beam = Instance.new("Beam")
	beam.Name = "GuideBeam"
	beam.Attachment1 = endAttachment
	beam.Color = ColorSequence.new(GOLD, Color3.fromHex("#FFF6C2"))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.15, 0.15),
		NumberSequenceKeypoint.new(1, 0.15),
	})
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Width0 = 1.4
	beam.Width1 = 1.4
	beam.Segments = 24
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureLength = 3
	beam.TextureSpeed = 1.6
	beam.Parent = anchor
	local shaft = neon("Part", Vector3.new(1.2, 3, 1.2), folder) :: Part
	shaft.Name = "ArrowShaft"
	local left = neon("WedgePart", Vector3.new(1.2, 2.4, 1.8), folder) :: WedgePart
	left.Name = "ArrowHeadL"
	local right = neon("WedgePart", Vector3.new(1.2, 2.4, 1.8), folder) :: WedgePart
	right.Name = "ArrowHeadR"
	return {
		Folder = folder,
		Anchor = anchor,
		EndAttachment = endAttachment,
		Beam = beam,
		Shaft = shaft,
		Left = left,
		Right = right,
	}
end

function TutorialController.Start()
	local layer = UIController.Layer("HUD")

	-- Hint bar ------------------------------------------------------------------------------------
	local bar: Frame = Create("Frame", {
		Name = "TutorialBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, BAR_TOP),
		Size = UDim2.fromOffset(780, 62),
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.12,
		Visible = false,
		ZIndex = 3,
		Parent = layer,
	})
	Create.Corner(18, bar)
	Create.Stroke(bar, GOLD, 3, 0, true)
	local barScale = Instance.new("UIScale")
	barScale.Parent = bar
	local stepText = Create.Text({
		Name = "Step",
		Text = "",
		Size = UDim2.fromOffset(120, 26),
		Position = UDim2.fromOffset(18, -13),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Color = GOLD,
		Stroke = 2.5,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 5,
		Parent = bar,
	})
	local hint = Create.Text({
		Name = "Hint",
		Text = "",
		Size = UDim2.new(1, -284, 0, 44),
		Position = UDim2.new(0, 18, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Stroke = 2.5,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = bar,
	})
	local chip: Frame = Create("Frame", {
		Name = "Progress",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -158, 0.5, 0), -- clear of the Skip button
		Size = UDim2.fromOffset(92, 40),
		BackgroundColor3 = Theme.Colors.Success,
		Visible = false,
		ZIndex = 4,
		Parent = bar,
	})
	Create.Round(chip)
	Create.Stroke(chip, Theme.Colors.Stroke, 2.5, 0, true)
	local chipScale = Instance.new("UIScale")
	chipScale.Parent = chip
	local progress = Create.Text({
		Name = "Text",
		Text = "",
		Size = UDim2.fromScale(0.84, 0.8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		Stroke = 2,
		ZIndex = 5,
		Parent = chip,
	})

	local confirmUntil = 0
	local skip: Button.Button
	skip = Button.new({
		Parent = bar,
		Name = "Skip",
		Size = UDim2.fromOffset(140, 66),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Style = "Grey",
		Text = "Skip",
		TextSize = 28,
		Corner = 14,
		ZIndex = 4,
		OnClick = function()
			local now = os.clock()
			if now < confirmUntil then
				confirmUntil = 0
				Net.Fire("RequestTutorial", "Skip")
				skip:SetText("...")
				return
			end
			confirmUntil = now + 3
			skip:SetText("Sure?")
			skip:SetStyle("Red")
			task.delay(3, function()
				if os.clock() >= confirmUntil and confirmUntil ~= 0 then
					confirmUntil = 0
					skip:SetText("Skip")
					skip:SetStyle("Grey")
				end
			end)
		end,
	})

	-- Guide ---------------------------------------------------------------------------------------
	local guide: Guide? = nil
	local startAttachment: Attachment? = nil
	local target: Vector3? = nil
	local renderConn: RBXScriptConnection? = nil
	local shownStep = 0
	local shownProgress = -1

	local function attachCharacter(character: Model?)
		if startAttachment then
			startAttachment:Destroy()
			startAttachment = nil
		end
		local g = guide
		if not g or not character then
			return
		end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp or not hrp:IsA("BasePart") then
			return
		end
		local a = Instance.new("Attachment")
		a.Name = "TutorialGuideStart"
		a.Position = Vector3.new(0, -1.8, 0)
		a.Parent = hrp
		startAttachment = a
		g.Beam.Attachment0 = a
	end

	local function stepGuide()
		local g = guide
		local pos = target
		if not g or not pos then
			return
		end
		local t = os.clock()
		local base = CFrame.new(pos + Vector3.new(0, ARROW_HEIGHT + math.sin(t * 3) * 1.2, 0)) * CFrame.Angles(0, t * 1.8, 0)
		g.Shaft.CFrame = base * SHAFT_OFFSET
		g.Left.CFrame = base * HEAD_LEFT
		g.Right.CFrame = base * HEAD_RIGHT
		local a = startAttachment
		local near = true
		if a and a.Parent then
			local delta = a.WorldPosition - pos
			near = Vector3.new(delta.X, 0, delta.Z).Magnitude < NEAR
		end
		g.Beam.Enabled = not near and not HudFlightState.Active
	end

	local function clearGuide()
		if renderConn then
			renderConn:Disconnect()
			renderConn = nil
		end
		if startAttachment then
			startAttachment:Destroy()
			startAttachment = nil
		end
		if guide then
			guide.Folder:Destroy()
			guide = nil
		end
		target = nil
	end

	local function showGuide(pos: Vector3)
		if guide == nil then
			guide = buildGuide()
			attachCharacter(localPlayer.Character)
		end
		target = pos
		local g = guide :: Guide
		g.Anchor.CFrame = CFrame.new(pos)
		g.Folder.Parent = Effects.Folder()
		if renderConn == nil then
			renderConn = RunService.RenderStepped:Connect(stepGuide)
		end
		stepGuide()
	end

	local function refresh()
		local data = StateController.Data
		local tut = if data and type(data.Tutorial) == "table" then data.Tutorial else nil
		if not data or not tut or tut.Done ~= false then
			bar.Visible = false
			clearGuide()
			shownStep = 0
			return
		end
		local index = tonumber(tut.Step) or 1
		local step = Tutorial.Steps[index]
		if not step then
			bar.Visible = false
			clearGuide()
			return
		end
		hint.Text = step.Text
		stepText.Text = string.format("STEP %d/%d", index, #Tutorial.Steps)
		local done = tonumber(tut.Progress) or 0
		if step.Count and step.Count > 1 then
			chip.Visible = true
			progress.Text = string.format("%d/%d", math.min(done, step.Count), step.Count)
			if index == shownStep and done ~= shownProgress then
				chipScale.Scale = 1.25
				TweenService:Create(chipScale, POP, { Scale = 1 }):Play()
			end
		else
			chip.Visible = false
		end
		if index ~= shownStep then
			bar.Visible = true
			barScale.Scale = 0.6
			TweenService:Create(barScale, POP, { Scale = 1 }):Play()
		end
		shownStep = index
		shownProgress = done
		if confirmUntil == 0 then
			skip:SetText("Skip")
			skip:SetStyle("Grey")
		end

		local pos = targetPosition(step.Target, tonumber(data.World) or 1)
		if pos then
			showGuide(pos)
		else
			clearGuide()
		end
	end

	StateController.DataChanged:Connect(refresh)
	localPlayer.CharacterAdded:Connect(function(character: Model)
		character:WaitForChild("HumanoidRootPart", 10)
		attachCharacter(character)
	end)
	localPlayer.CharacterRemoving:Connect(function()
		if startAttachment then
			startAttachment:Destroy()
			startAttachment = nil
		end
	end)
	refresh()
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
-- Owns the ScreenGuis, responsive scaling, the screen router and toasts.
--
-- Layout model: every layer has one root Frame under a UIScale. Screens position with Scale +
-- AnchorPoint (so they stick to corners/centres on any aspect ratio) and size in design pixels
-- (1800 x 920 reference), which the UIScale converts for the actual viewport. Touch devices get
-- a size boost for comfortable tap targets. Safe areas come from ScreenInsets.CoreUISafeInsets.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Icon = require(Client.UI.Components.Icon)
local AudioController = require(script.Parent.AudioController)

export type Screen = {
	Open: (any, ...any) -> (),
	Close: (any) -> (),
	IsOpen: (any) -> boolean,
}

local UIController = {}

UIController.Scale = 1
UIController.ScaleChanged = Signal.new()
UIController.ScreenOpened = Signal.new() -- (name)
UIController.ScreenClosed = Signal.new() -- (name)

local layers: { [string]: Frame } = {}
local layerScales: { UIScale } = {}
local screens: { [string]: Screen } = {}
local EXCLUSIVE: { [string]: boolean } = {
	Shop = true,
	Rebirth = true,
	Pets = true,
	Index = true,
	Trails = true,
	Inventory = true,
	Gifts = true,
	Egg = true,
	World = true,
	Settings = true,
	Admin = true,
}
local toastHolder: Frame

local LAYERS = {
	{ Name = "HUD", Order = 1 },
	{ Name = "World", Order = 5 },
	{ Name = "Menus", Order = 10 },
	{ Name = "Overlay", Order = 20 },
	{ Name = "Toasts", Order = 30 },
}

local function computeScale(): number
	local camera = Workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1800, 920)
	local s = math.min(size.X / Theme.DesignSize.X, size.Y / Theme.DesignSize.Y)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		s *= 1.22 -- bigger tap targets on phones/tablets
	end
	if GuiService:IsTenFootInterface() then
		s *= 0.92 -- TV safe margin
	end
	return math.clamp(s, 0.42, 1.6)
end

local function applyScale()
	local s = computeScale()
	UIController.Scale = s
	for _, scale in layerScales do
		scale.Scale = s
	end
	for _, root in layers do
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	UIController.ScaleChanged:Fire(s)
end

function UIController.Layer(name: string): Frame
	return layers[name]
end

function UIController.Register(name: string, screen: Screen)
	screens[name] = screen
end

function UIController.Get(name: string): Screen?
	return screens[name]
end

function UIController.Open(name: string, ...: any)
	local screen = screens[name]
	if screen == nil then
		warn("[UI] unknown screen " .. name)
		return
	end
	if EXCLUSIVE[name] then
		for other, s in screens do
			if other ~= name and EXCLUSIVE[other] and s:IsOpen() then
				s:Close()
				UIController.ScreenClosed:Fire(other)
			end
		end
	end
	screen:Open(...)
	UIController.ScreenOpened:Fire(name)
end

function UIController.Close(name: string)
	local screen = screens[name]
	if screen and screen:IsOpen() then
		screen:Close()
		UIController.ScreenClosed:Fire(name)
	end
end

function UIController.Toggle(name: string, ...: any)
	local screen = screens[name]
	if screen and screen:IsOpen() then
		UIController.Close(name)
	else
		UIController.Open(name, ...)
	end
end

function UIController.AnyMenuOpen(): boolean
	for name, s in screens do
		if EXCLUSIVE[name] and s:IsOpen() then
			return true
		end
	end
	return false
end

function UIController.CloseMenus()
	for name, s in screens do
		if EXCLUSIVE[name] and s:IsOpen() then
			UIController.Close(name)
		end
	end
end

-- Toasts: colour-coded raised pills (Theme.Toasts) with an icon chip, popping in under the top bar.
local TOAST_W, TOAST_H = 600, 60

function UIController.Toast(text: string, kind: string?)
	if not toastHolder then
		return
	end
	local k = kind or "Info"
	if k == "Error" then
		AudioController.Play("Error", nil, 0.3)
	elseif k == "Level" or k == "Success" or k == "Rare" then
		AudioController.Play("Reward", nil, 0.5)
	end
	local spec = Theme.Toasts[k] or Theme.Toasts.Info
	local style = Theme.Buttons[spec.Style] or Theme.Buttons.Blue
	local pill: Frame = Create("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(TOAST_W, TOAST_H),
		Parent = toastHolder,
	})
	local base: Frame = Create("Frame", {
		Name = "Base",
		BackgroundColor3 = Theme.Darken(style.Bottom, 0.55),
		Position = UDim2.fromOffset(0, 5),
		Size = UDim2.new(1, 0, 1, -5),
		Parent = pill,
	})
	Create.Corner(16, base)
	Create.Stroke(base, style.Border, Theme.Outline, 0, true)
	local face: Frame = Create("Frame", {
		Name = "Face",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 1, -5),
		ZIndex = 2,
		Parent = pill,
	})
	Create.Corner(16, face)
	Create.Gradient(face, style.Top, style.Bottom, 90)
	Create.Stroke(face, style.Border, Theme.Outline, 0, true)
	local chip: Frame = Create("Frame", {
		Name = "IconChip",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		Size = UDim2.fromOffset(TOAST_H - 15, TOAST_H - 15),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.15,
		Parent = face,
	})
	Create.Round(chip)
	Create.Stroke(chip, style.Border, 2.5, 0, true)
	Icon.new({
		Icon = spec.Icon,
		Name = "Icon",
		Size = UDim2.fromScale(0.78, 0.78),
		TextSize = 30,
		Parent = chip,
	})
	Create.Text({
		Name = "Text",
		Text = text,
		Size = UDim2.new(1, -(TOAST_H + 10), 1, -12),
		Position = UDim2.new(0, TOAST_H - 2, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Color = style.Text,
		Stroke = 2.6,
		Parent = face,
	})
	local scale = Instance.new("UIScale")
	scale.Scale = 0.6
	scale.Parent = pill
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(2.6, function()
		local t = TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 })
		t:Play()
		t.Completed:Wait()
		pill:Destroy()
	end)
end

function UIController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	for _, layer in LAYERS do
		local gui = Instance.new("ScreenGui")
		gui.Name = "SkyGlide_" .. layer.Name
		gui.DisplayOrder = layer.Order
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = false
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = playerGui
		local root: Frame = Create("Frame", {
			Name = "Root",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = gui,
		})
		local scale = Instance.new("UIScale")
		scale.Parent = root
		table.insert(layerScales, scale)
		layers[layer.Name] = root
	end
	toastHolder = Create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 176), -- below AUTO THROW and the tutorial bar
		Size = UDim2.fromOffset(TOAST_W, 400),
		Parent = layers.Toasts,
	})
	Create.List(toastHolder, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
	applyScale()
	local function watchCamera()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
		end
		applyScale()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	watchCamera()
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--!strict
-- Client side of the world: per-world lighting (Visual/Themes, no asset ids), live labels and
-- prompt texts on pads / pedestals / relic / eggs / portals from the local player's data, the
-- ProximityPrompt actions (each one only sends an intent or opens a menu), and the spinning
-- glider/egg displays. Everything here is cosmetic or an intent; the server re-checks all of it.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Themes = require(Shared.Visual.Themes)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Training = require(Shared.Definitions.Training)
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Eggs = require(Shared.Definitions.Eggs)
local Monetization = require(Shared.Config.Monetization)
local Format = require(Shared.Util.Format)

local StateController = require(script.Parent.StateController)
local UIController = require(script.Parent.UIController)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)

local WorldController = {}

local hex = Color3.fromHex
local GREEN = hex("#5BE05B")
local RED = hex("#FF4F5E")
local GOLD = hex("#FFD447")
local WHITE = Color3.new(1, 1, 1)
local BLUE = hex("#7FD8FF")

local currentWorld = 0
type Effects = { Atmosphere: Atmosphere, Color: ColorCorrectionEffect, Bloom: BloomEffect }
local effects: Effects? = nil
local worldsFolder: Instance? = nil
local spinners: { Model } = {}
local spinBase: { [Model]: CFrame } = {}
local spinRoot: { [Model]: { Root: BasePart, Offset: CFrame } } = {} -- rigged displays: move the root only

-- Lighting ----------------------------------------------------------------------------------------

local function ensureEffects(): Effects
	local existing = effects
	if existing then
		return existing
	end
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "SkyGlideAtmosphere"
	atmosphere.Parent = Lighting
	local colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "SkyGlideColor"
	colorCorrection.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "SkyGlideBloom"
	bloom.Intensity = 0.55
	bloom.Size = 22
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local created: Effects = { Atmosphere = atmosphere, Color = colorCorrection, Bloom = bloom }
	effects = created
	return created
end

local function applyLighting(worldId: number)
	local world = Worlds.Get(worldId)
	local theme = if world then Themes[world.Theme] else nil
	if not theme then
		return
	end
	local fx = ensureEffects()
	local atmosphere = fx.Atmosphere
	local colorCorrection = fx.Color
	Lighting.ClockTime = theme.ClockTime
	Lighting.Ambient = hex(theme.Ambient)
	Lighting.OutdoorAmbient = hex(theme.Ambient):Lerp(WHITE, 0.35)
	Lighting.FogColor = hex(theme.Fog)
	Lighting.FogStart = 900
	Lighting.FogEnd = 9000
	atmosphere.Color = hex(theme.Sky.Horizon)
	atmosphere.Decay = hex(theme.Sky.Top)
	atmosphere.Density = if theme.Props == "Volcano" then 0.36 else 0.26
	atmosphere.Offset = 0.1
	atmosphere.Haze = if theme.Props == "Volcano" then 2.2 else 1.1
	atmosphere.Glare = 0.25
	colorCorrection.Saturation = 0.14
	colorCorrection.Contrast = 0.06
	colorCorrection.Brightness = 0.02
	colorCorrection.TintColor = if theme.Props == "Volcano"
		then hex("#FFE6D2")
		elseif theme.Props == "Ice" then hex("#E8F6FF")
		else WHITE
end

local function setWorld(worldId: number)
	if worldId == currentWorld then
		return
	end
	currentWorld = worldId
	applyLighting(worldId)
	Bus.WorldChanged:Fire(worldId)
end

-- Labels --------------------------------------------------------------------------------------------

local function labelText(holder: Instance?, name: string): TextLabel?
	if holder == nil then
		return nil
	end
	local gui = holder:FindFirstChild("Label")
	local text = if gui then gui:FindFirstChild(name, true) else nil
	return if text and text:IsA("TextLabel") then text else nil
end

local function setLabel(holder: Instance?, name: string, text: string, color: Color3?)
	local label = labelText(holder, name)
	if label then
		label.Text = text
		if color then
			label.TextColor3 = color
		end
	end
end

local function setPrompt(holder: Instance?, name: string, action: string)
	local prompt = if holder then holder:FindFirstChild(name) else nil
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.ActionText = action
	end
end

local function worldModel(worldId: number): Instance?
	local folder = worldsFolder
	return if folder then folder:FindFirstChild("World_" .. worldId) else nil
end

local function child(root: Instance?, ...: string): Instance?
	local node = root
	for _, name in { ... } do
		if node == nil then
			return nil
		end
		node = node:FindFirstChild(name)
	end
	return node
end

-- Robux items whose id is still 0 are free test grants in Studio and "SOON" on live servers.
local IS_STUDIO = RunService:IsStudio()
local function robuxPrice(id: number?, robux: number?): (string, Color3)
	if id == nil or (id == 0 and not IS_STUDIO) then
		return "SOON", WHITE
	end
	return "R$" .. tostring(robux or 0), GREEN
end

local function refreshLabels()
	local data = StateController.Data
	if data == nil or worldsFolder == nil then
		return
	end
	local rebirths = if type(data.Rebirths) == "number" then data.Rebirths else 0
	local wins = if type(data.Wins) == "number" then data.Wins else 0
	local gliders = if type(data.Gliders) == "table" then data.Gliders else {}
	local relics = if type(data.Relics) == "table" then data.Relics else {}
	local worlds = if type(data.Worlds) == "table" then data.Worlds else {}
	local zones = if type(data.Zones) == "table" then data.Zones else {}
	local equippedRelic = if type(data.Relic) == "string" then data.Relic else ""

	for _, world in Worlds.List do
		local model = worldModel(world.Id)
		if model == nil then
			continue
		end
		-- training pads
		for _, pad in Training.ForWorld(world.Id) do
			local part = child(model, "Pads", "Pad_" .. pad.Id)
			local unlocked = if pad.PassKey then StateController.HasPass(pad.PassKey) else rebirths >= pad.Rebirths
			setLabel(part, "Status", if unlocked then "UNLOCKED" else "LOCKED", if unlocked then GREEN else RED)
			if pad.PassKey then
				if unlocked then
					setLabel(part, "Gate", "OWNED", GREEN)
				else
					local pass = Monetization.Pass(pad.PassKey)
					setLabel(part, "Gate", robuxPrice(if pass then pass.Id else nil, if pass then pass.Robux else nil))
				end
			end
		end
		-- glider pedestals
		for _, glider in Gliders.ForWorld(world.Id) do
			local base = child(model, "Pedestals", "Pedestal_" .. glider.Id, "Base")
			if base == nil then
				continue
			end
			if data.Glider == glider.Id and equippedRelic == "" then
				setLabel(base, "Status", "EQUIPPED", GREEN)
				setPrompt(base, "BuyPrompt", "Equipped")
			elseif gliders[glider.Id] then
				setLabel(base, "Status", "OWNED", BLUE)
				setPrompt(base, "BuyPrompt", "Equip")
			elseif wins >= glider.Price then
				setLabel(base, "Status", "UNLOCKED", GREEN)
				setPrompt(base, "BuyPrompt", "Buy")
			else
				setLabel(base, "Status", "LOCKED", RED)
				setPrompt(base, "BuyPrompt", "Buy")
			end
			setLabel(base, "Price", if gliders[glider.Id] then "OWNED" elseif glider.Price <= 0 then "FREE" else Format.Short(glider.Price) .. " Wins", GOLD)
		end
		-- relic
		for _, relic in Relics.List do
			local base = child(model, "Pedestals", "Relic_" .. relic.Id, "Base")
			if base == nil then
				continue
			end
			local info = StateController.Relics[relic.Id]
			local left = if info then math.max(0, info.Stock - info.Sold) else relic.Stock
			setLabel(base, "Stock", string.format("STOCK: %s/%s", Format.Commas(left), Format.Commas(relic.Stock)), if left > 0 then WHITE else RED)
			local product = Monetization.Product(relic.ProductKey)
			if relics[relic.Id] then
				setLabel(base, "Price", if equippedRelic == relic.Id then "EQUIPPED" else "OWNED", GREEN)
				setPrompt(base, "BuyPrompt", if equippedRelic == relic.Id then "Equipped" else "Equip")
			else
				local price, color = robuxPrice(if product then product.Id else nil, if product then product.Robux else nil)
				if left <= 0 then
					setLabel(base, "Price", "SOLD OUT", RED)
				else
					setLabel(base, "Price", if price == "SOON" then price else "ONLY " .. price, color)
				end
				setPrompt(base, "BuyPrompt", "Buy")
			end
		end
		-- eggs
		for _, egg in Eggs.ForWorld(world.Id) do
			local base = child(model, "Eggs", "Egg_" .. egg.Id, "Base")
			if base and egg.ProductKey then
				local product = Monetization.Product(egg.ProductKey)
				setLabel(base, "Price", robuxPrice(if product then product.Id else nil, if product then product.Robux else nil))
			elseif base then
				setLabel(base, "Price", Format.Short(egg.Price) .. " Wins", if wins >= egg.Price then GOLD else RED)
			end
		end
		-- portals
		for _, target in Worlds.List do
			local frame = child(model, "Portals", "Portal_" .. target.Id, "Frame")
			if frame == nil or target.Id < world.Id then
				continue
			end
			if worlds[tostring(target.Id)] then
				setLabel(frame, "Requirement", "UNLOCKED - step in!", GREEN)
			else
				local parts = {}
				if target.UnlockZone and not zones[target.UnlockZone] then
					local zone = Zones.Get(target.UnlockZone)
					table.insert(parts, "🏁 Reach " .. (if zone then zone.Name else "the river end"))
				end
				if rebirths < target.UnlockRebirths then
					table.insert(parts, string.format("🌀 %d/%d Rebirths", rebirths, target.UnlockRebirths))
				end
				setLabel(frame, "Requirement", if #parts == 0 then "READY TO UNLOCK!" else table.concat(parts, "  +  "), if #parts == 0 then GOLD else WHITE)
			end
		end
	end
end

-- Prompts -------------------------------------------------------------------------------------------

local function onPrompt(prompt: ProximityPrompt)
	local holder = prompt.Parent
	local model = if holder then holder.Parent else nil
	if model == nil then
		return
	end
	local data = StateController.Data
	if prompt.Name == "BuyPrompt" then
		local gliderId = string.match(model.Name, "^Pedestal_(.+)$")
		local relicId = string.match(model.Name, "^Relic_(.+)$")
		if gliderId and Gliders.Get(gliderId) then
			local owned = data and type(data.Gliders) == "table" and data.Gliders[gliderId]
			if owned then
				task.spawn(Net.Invoke, "RequestEquipThrowable", false, gliderId)
			else
				task.spawn(Net.Invoke, "RequestBuyThrowable", false, gliderId)
			end
		elseif relicId then
			local relic = Relics.Get(relicId)
			if relic == nil then
				return
			end
			local owned = data and type(data.Relics) == "table" and data.Relics[relicId]
			if owned then
				task.spawn(Net.Invoke, "RequestEquipThrowable", false, "relic:" .. relicId)
			else
				task.spawn(Net.Invoke, "RequestPurchase", false, "Product", relic.ProductKey)
			end
		end
	elseif prompt.Name == "HatchPrompt" then
		local eggId = string.match(model.Name, "^Egg_(.+)$")
		if eggId and Eggs.Get(eggId) then
			UIController.Open("Egg", eggId)
		end
	elseif prompt.Name == "PortalPrompt" then
		local id = tonumber(string.match(model.Name, "^Portal_(%d+)$"))
		if id and Worlds.Get(id) then
			UIController.Open("World", id)
		end
	end
end

-- Spinning displays ---------------------------------------------------------------------------------

local function track(model: Instance)
	if model:IsA("Model") and model:GetAttribute("Spin") == true and not spinBase[model] then
		spinBase[model] = model:GetPivot()
		local root = model.PrimaryPart
		if root and root.Anchored then
			-- the server rigged it (only the root anchored, the rest welded): one CFrame per frame
			local welded = model:FindFirstChildWhichIsA("WeldConstraint", true) ~= nil
			if welded then
				spinRoot[model] = { Root = root, Offset = root.PivotOffset:Inverse() }
			end
		end
		table.insert(spinners, model)
	end
end

local function scan(root: Instance)
	for _, d in root:GetDescendants() do
		track(d)
	end
	root.DescendantAdded:Connect(function(d)
		task.defer(track, d)
	end)
end

local function stepSpinners()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	local t = os.clock()
	for i = #spinners, 1, -1 do
		local model = spinners[i]
		if model.Parent == nil then
			table.remove(spinners, i)
			spinBase[model] = nil
			spinRoot[model] = nil
			continue
		end
		local base = spinBase[model]
		if (base.Position - camPos).Magnitude < 150 then
			local phase = i * 0.7
			local cf = base * CFrame.new(0, math.sin(t * 2 + phase) * 0.35, 0) * CFrame.Angles(0, t * 0.9 + phase, 0)
			local rig = spinRoot[model]
			if rig then
				rig.Root.CFrame = cf * rig.Offset
			else
				model:PivotTo(cf)
			end
		end
	end
end

-- Start ---------------------------------------------------------------------------------------------

function WorldController.Start()
	Remotes.Event("WorldChanged").OnClientEvent:Connect(function(worldId: any)
		if type(worldId) == "number" then
			setWorld(worldId)
		end
	end)
	local function fromData(data: { [string]: any }?)
		if data and type(data.World) == "number" then
			setWorld(data.World)
		end
		refreshLabels()
	end
	StateController.DataChanged:Connect(fromData)
	StateController.ServerInfoChanged:Connect(function(kind)
		if kind == "Relics" then
			refreshLabels()
		end
	end)
	fromData(StateController.Data)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if player == Players.LocalPlayer then
			onPrompt(prompt)
		end
	end)
	task.spawn(function()
		local folder = Workspace:WaitForChild("Worlds", 60)
		if folder == nil then
			warn("[WorldController] Workspace.Worlds never appeared")
			return
		end
		worldsFolder = folder
		scan(folder)
		folder.ChildAdded:Connect(function()
			task.defer(refreshLabels)
		end)
		refreshLabels()
	end)
	RunService.RenderStepped:Connect(stepSpinners)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="97">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client bootstrap: state mirror, UI layers + screens, then runtime controllers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Remotes")

local Controllers = script.Parent.Controllers
local Screens = script.Parent.UI.Screens

local StateController = require(Controllers.StateController)
local UIController = require(Controllers.UIController)

StateController.Start()
UIController.Init()

local SCREENS = {
	"Notifications",
	"HUD",
	"ShopScreen",
	"RebirthScreen",
	"PetsScreen",
	"IndexScreen",
	"EggScreen",
	"TrailsScreen",
	"InventoryScreen",
	"GiftsScreen",
	"WorldScreen",
	"SettingsScreen",
	"AdminScreen",
	"EventBanner",
}

for _, name in SCREENS do
	local module = Screens:FindFirstChild(name)
	if not module then
		warn("[Client] missing screen " .. name)
		continue
	end
	local screen = (require :: any)(module)
	local ok, err = pcall(screen.Init)
	if not ok then
		warn(string.format("[Client] %s.Init failed: %s", name, tostring(err)))
	end
end

local CONTROLLERS = {
	"CameraController",
	"WorldController",
	"TrainingController",
	"ThrowController",
	"FlightRenderer",
	"PetFollowController",
	"TutorialController",
}

for _, name in CONTROLLERS do
	local module = Controllers:FindFirstChild(name)
	if not module then
		warn("[Client] missing controller " .. name)
		continue
	end
	local controller = (require :: any)(module)
	local ok, err = pcall(controller.Start)
	if not ok then
		warn(string.format("[Client] %s.Start failed: %s", name, tostring(err)))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="98">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="Folder" referent="99">
            <Properties>
              <string name="Name">Components</string>
            </Properties>
            <Item class="ModuleScript" referent="100">
              <Properties>
                <string name="Name">Button</string>
                <string name="Source"><![CDATA[--!strict
-- Chunky simulator-style button: a gradient face with a thick dark outline, a gloss highlight, an
-- inner shadow and a stroked label, raised on a darker base (Theme.Depth) like a 3D key. Hover
-- grows it and thickens the outline, pressing sinks the face into the base, disabled turns it
-- grey; click/hover sounds. Calls to action can carry a glint sweep (Shine = true).
--
-- Instance is the transparent hit box (face + base); Content is the face's content frame (it
-- moves with the face), so extra labels go there.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Shine = require(script.Parent.Shine)
local AudioController = require(UI.Parent.Controllers.AudioController)

export type ButtonProps = {
	Parent: Instance?,
	Name: string?,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Style: string?,
	Text: string?,
	TextSize: number?,
	Font: Font?,
	LayoutOrder: number?,
	ZIndex: number?,
	Corner: number?,
	Depth: number?, -- base height under the face (default Theme.Depth)
	Shine: boolean?, -- glint sweep for calls to action
	OnClick: (() -> ())?,
	Silent: boolean?,
}

export type Button = {
	Instance: TextButton,
	Face: Frame,
	Gradient: UIGradient, -- the face gradient
	Label: TextLabel,
	Content: Frame,
	SetText: (Button, string) -> (),
	SetStyle: (Button, string) -> (),
	SetEnabled: (Button, boolean) -> (),
	Enabled: boolean,
	Style: string,
	Destroy: (Button) -> (),
}

local Button = {}

local QUICK = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SPRING = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local MUTED: { [string]: boolean } = { Grey = true, Dark = true, Disabled = true }
-- Inner shadow: the lower part of a face darkens toward its bottom edge (depth under the gloss).
local INNER_SHADOW = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(1, 0.7),
})

function Button.new(props: ButtonProps): Button
	local styleName = props.Style or "Grey"
	local style = Theme.Buttons[styleName] or Theme.Buttons.Grey
	local corner = props.Corner or 10
	local depth = props.Depth or Theme.Depth
	local z = props.ZIndex or 1

	local root: TextButton = Create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = z,
		Selectable = true,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = root

	-- darker base: shows as a lip under the face
	local base: Frame = Create("Frame", {
		Name = "Base",
		BackgroundColor3 = Theme.Darken(style.Bottom, 0.55),
		Position = UDim2.fromOffset(0, depth),
		Size = UDim2.new(1, 0, 1, -depth),
		ZIndex = z,
		Parent = root,
	})
	Create.Corner(corner, base)
	local baseStroke = Create.Stroke(base, style.Border, Theme.Outline, 0, true)

	local face: Frame = Create("Frame", {
		Name = "Face",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 1, -depth),
		ZIndex = z + 1,
		Parent = root,
	})
	Create.Corner(corner, face)
	local gradient = Create.Gradient(face, style.Top, style.Bottom, 90)
	local border = Create.Stroke(face, style.Border, Theme.Outline, 0, true)

	-- glossy top highlight
	local gloss = Create("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Size = UDim2.new(1, -8, 0.44, 0),
		Position = UDim2.fromOffset(4, 3),
		ZIndex = z + 1,
		Parent = face,
	})
	Create.Corner(math.max(corner - 2, 0), gloss)
	local inner: Frame = Create("Frame", {
		Name = "InnerShadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(1, 0.5),
		ZIndex = z + 1,
		Parent = face,
	})
	Create.Corner(corner, inner)
	local innerGradient = Instance.new("UIGradient")
	innerGradient.Rotation = 90
	innerGradient.Transparency = INNER_SHADOW
	innerGradient.Parent = inner
	local shine = if props.Shine then Shine.Add(face, UDim.new(0, corner), z + 2) else nil

	local content: Frame = Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z + 3,
		Parent = face,
	})
	local label = Create.Text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = props.Font or Theme.Fonts.Display,
		TextSize = props.TextSize or 28,
		Scaled = true,
		Color = style.Text,
		Stroke = 2.6,
		ZIndex = z + 2,
		Parent = content,
	})

	local self = {
		Instance = root,
		Face = face,
		Gradient = gradient,
		Label = label,
		Content = content,
		Enabled = true,
		Style = styleName,
	} :: any

	local function setStyle(name: string)
		local s = Theme.Buttons[name] or Theme.Buttons.Grey
		gradient.Color = ColorSequence.new(s.Top, s.Bottom)
		border.Color = s.Border
		baseStroke.Color = s.Border
		base.BackgroundColor3 = Theme.Darken(s.Bottom, 0.55)
		label.TextColor3 = s.Text
		if shine then
			shine.Visible = not MUTED[name] -- no glint on grey / disabled keys
		end
	end
	setStyle(styleName)

	function self.SetText(_: any, text: string)
		label.Text = text
	end
	function self.SetStyle(this: any, name: string)
		this.Style = name
		if this.Enabled then
			setStyle(name)
		end
	end
	function self.SetEnabled(this: any, enabled: boolean)
		this.Enabled = enabled
		root.Active = enabled
		root.AutoButtonColor = false
		setStyle(if enabled then this.Style else "Disabled")
	end
	function self.Destroy(_: any)
		root:Destroy()
	end

	local UP = UDim2.new()
	local DOWN = UDim2.fromOffset(0, depth - 1)
	root.MouseEnter:Connect(function()
		if self.Enabled then
			TweenService:Create(scale, QUICK, { Scale = 1.05 }):Play()
			TweenService:Create(border, QUICK, { Thickness = Theme.Outline + 1.5 }):Play()
			if not props.Silent then
				AudioController.Play("Hover", nil, 0.05)
			end
		end
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, QUICK, { Scale = 1 }):Play()
		TweenService:Create(face, QUICK, { Position = UP }):Play()
		TweenService:Create(border, QUICK, { Thickness = Theme.Outline }):Play()
	end)
	root.MouseButton1Down:Connect(function()
		if self.Enabled then
			TweenService:Create(face, QUICK, { Position = DOWN }):Play()
			TweenService:Create(scale, QUICK, { Scale = 0.97 }):Play()
		end
	end)
	root.MouseButton1Up:Connect(function()
		TweenService:Create(face, SPRING, { Position = UP }):Play()
		TweenService:Create(scale, SPRING, { Scale = 1 }):Play()
	end)
	root.Activated:Connect(function()
		if not self.Enabled then
			AudioController.Play("Error", nil, 0.2)
			return
		end
		if not props.Silent then
			AudioController.Play("Click")
		end
		if props.OnClick then
			props.OnClick()
		end
	end)

	root.Parent = props.Parent
	return self :: Button
end

-- Close button in the simulator style: red raised key with a heavy white X, breaking out of the
-- panel's top-right corner.
function Button.Close(parent: Instance, onClick: () -> (), position: UDim2?, size: number?): Button
	local s = size or 64
	local b = Button.new({
		Parent = parent,
		Name = "Close",
		Size = UDim2.fromOffset(s, s),
		Position = position or UDim2.new(1, -s * 0.35, 0, -s * 0.35),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Style = "Red",
		Text = "X",
		Font = Theme.Fonts.Display,
		Corner = 14,
		ZIndex = 20,
		OnClick = onClick,
	})
	b.Label.Size = UDim2.fromScale(0.6, 0.6)
	return b
end

return Button
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="101">
              <Properties>
                <string name="Name">HudFlightOverlay</string>
                <string name="Source"><![CDATA[--!strict
-- In-flight HUD for the local player's glider: the big distance counter under AUTO THROW (punches
-- on every zone), the zone banner that slides in with the zone's colour, the cinematic SPECIAL
-- THROW banner with a screen flash, "PERFECT LAUNCH!", the "TAP!" prompt while a ring's gust
-- window is open, the "PERFECT xN" combo, and a full-screen transparent tap area (lowest ZIndex)
-- that forwards taps to ThrowController.Tap() so mobile players can catch gusts anywhere.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FlightSim = require(Shared.Sim.FlightSim)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local HudFlightState = require(script.Parent.HudFlightState)
local AudioController = require(Client.Controllers.AudioController)
local Bus = require(Client.Controllers.Bus)

export type FlightOverlay = {
	SetCounterTop: (FlightOverlay, number) -> (),
}

local HudFlightOverlay = {}

local POP = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local QUICK = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SLIDE = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local WHITE = Color3.new(1, 1, 1)

local function throwController(): any
	local module = Client.Controllers:FindFirstChild("ThrowController")
	if module and module:IsA("ModuleScript") then
		return (require :: any)(module)
	end
	return nil
end

local function popScale(parent: GuiObject): UIScale
	local s = Instance.new("UIScale")
	s.Parent = parent
	return s
end

function HudFlightOverlay.new(root: Frame): FlightOverlay
	local localPlayer = Players.LocalPlayer

	-- full-screen tap area (below every other HUD element)
	local tapArea: TextButton = Create("TextButton", {
		Name = "FlightTapArea",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		Active = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Visible = false,
		Parent = root,
	})
	tapArea.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			local controller = throwController()
			if controller and type(controller.Tap) == "function" then
				controller.Tap()
			end
		end
	end)

	-- distance counter
	local counter = Create.Text({
		Name = "FlightDistance",
		Text = "0 m",
		Size = UDim2.fromOffset(560, 92),
		Position = UDim2.new(0.5, 0, 0, 92),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 92,
		Scaled = true,
		Stroke = 4.5,
		ZIndex = 4,
		Parent = root,
	})
	counter.Visible = false
	local counterScale = popScale(counter)

	-- zone banner
	local zoneBanner: Frame = Create("Frame", {
		Name = "ZoneBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(-0.4, 0, 0, 190),
		Size = UDim2.fromOffset(560, 74),
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 4,
		Parent = root,
	})
	Create.Corner(16, zoneBanner)
	local zoneStroke = Create.Stroke(zoneBanner, WHITE, 4, 0, true)
	Create.Text({
		Name = "Caption",
		Text = "ENTERING",
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 2),
		Font = Theme.Fonts.Display,
		TextSize = 20,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		Stroke = 2,
		ZIndex = 5,
		Parent = zoneBanner,
	})
	local zoneName = Create.Text({
		Name = "ZoneName",
		Text = "",
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.new(0.5, 0, 0, 24),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 44,
		Scaled = true,
		Stroke = 3.5,
		ZIndex = 5,
		Parent = zoneBanner,
	})

	-- special throw banner + screen flash
	local flash: Frame = Create("Frame", {
		Name = "ScreenFlash",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 8,
		Parent = root,
	})
	local special: Frame = Create("Frame", {
		Name = "SpecialBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(980, 150),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 9,
		Parent = root,
	})
	Create.Corner(24, special)
	Create.Stroke(special, Theme.Colors.Stroke, 5, 0, true)
	local specialGradient = Instance.new("UIGradient")
	specialGradient.Rotation = 90
	specialGradient.Parent = special
	local specialScale = popScale(special)
	local specialTitle = Create.Text({
		Name = "Title",
		Text = "",
		Size = UDim2.new(1, -40, 0, 96),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 96,
		Scaled = true,
		Stroke = 5,
		ZIndex = 10,
		Parent = special,
	})
	local specialSub = Create.Text({
		Name = "Subtitle",
		Text = "",
		Size = UDim2.new(1, -40, 0, 34),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		Stroke = 3,
		ZIndex = 10,
		Parent = special,
	})

	-- PERFECT LAUNCH pop
	local launchText = Create.Text({
		Name = "PerfectLaunch",
		Text = "PERFECT LAUNCH!",
		Size = UDim2.fromOffset(640, 76),
		Position = UDim2.fromScale(0.5, 0.38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 76,
		Scaled = true,
		Color = Theme.Colors.MeterPerfect,
		Stroke = 4.5,
		ZIndex = 6,
		Parent = root,
	})
	launchText.Visible = false
	local launchScale = popScale(launchText)

	-- TAP! prompt
	local tapPrompt = Create.Text({
		Name = "TapPrompt",
		Text = "TAP!",
		Size = UDim2.fromOffset(320, 116),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 130,
		Scaled = true,
		Color = Color3.fromHex("#7FF0FF"),
		Stroke = 5,
		ZIndex = 6,
		Parent = root,
	})
	tapPrompt.Visible = false
	local tapScale = popScale(tapPrompt)

	-- PERFECT xN combo
	local combo = Create.Text({
		Name = "Combo",
		Text = "",
		Size = UDim2.fromOffset(400, 70),
		Position = UDim2.new(0.5, 190, 0.5, -30),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 70,
		Scaled = true,
		Color = Theme.Colors.MeterPerfect,
		Stroke = 4,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = root,
	})
	combo.Visible = false
	local comboScale = popScale(combo)
	local comboAmount = Create.Text({
		Name = "Amount",
		Text = "",
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, 2),
		Font = Theme.Fonts.Display,
		TextSize = 40,
		Scaled = true,
		Color = Theme.Colors.Skill,
		Stroke = 3,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = combo,
	})

	-- state
	local self = {} :: any
	local counterTop = 92
	local lastShown = -1
	local streak = 0
	local zoneToken = 0
	local comboToken = 0
	local launchToken = 0
	local specialToken = 0
	local flightId: number? = nil

	function self.SetCounterTop(_: any, top: number)
		counterTop = top
		counter.Position = UDim2.new(0.5, 0, 0, top)
		zoneBanner.Position = UDim2.new(zoneBanner.Position.X.Scale, 0, 0, top + 100)
	end

	local function hideFlightBits()
		counter.Visible = false
		tapPrompt.Visible = false
		zoneBanner.Visible = false
		tapArea.Visible = false
	end

	local function showSpecial(id: string)
		local info = FlightSim.SpecialInfo(id)
		if not info then
			return
		end
		specialToken += 1
		local token = specialToken
		local color = Color3.fromHex(info.Color)
		specialGradient.Color = ColorSequence.new(color:Lerp(WHITE, 0.35), color:Lerp(Color3.new(0, 0, 0), 0.35))
		specialTitle.Text = string.format("%s! x%d", info.Name, info.Multiplier)
		specialTitle.TextColor3 = WHITE
		specialSub.Text = "SPECIAL THROW - " .. info.Multiplier .. "x DISTANCE!"
		special.Visible = true
		special.BackgroundTransparency = 0
		specialScale.Scale = 2.2
		TweenService:Create(specialScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		flash.Visible = true
		flash.BackgroundColor3 = color:Lerp(WHITE, 0.6)
		flash.BackgroundTransparency = 0.05
		TweenService:Create(flash, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
		AudioController.Play("RareHatch")
		task.delay(0.75, function()
			if token == specialToken then
				flash.Visible = false
			end
		end)
		task.delay(2.6, function()
			if token ~= specialToken then
				return
			end
			local out = TweenService:Create(specialScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 })
			out:Play()
			out.Completed:Wait()
			if token == specialToken then
				special.Visible = false
			end
		end)
	end

	local function showLaunch()
		launchToken += 1
		local token = launchToken
		launchText.Visible = true
		launchText.TextTransparency = 0
		launchScale.Scale = 0.3
		TweenService:Create(launchScale, POP, { Scale = 1 }):Play()
		task.delay(1, function()
			if token ~= launchToken then
				return
			end
			local fade = TweenService:Create(launchText, TweenInfo.new(0.3), { TextTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			if token == launchToken then
				launchText.Visible = false
			end
		end)
	end

	HudFlightState.Changed:Connect(function(active: any, plan: any)
		if active and type(plan) == "table" then
			flightId = plan.Id
			streak = 0
			lastShown = -1
			counter.Text = "0 m"
			counter.TextColor3 = WHITE
			counter.Visible = true
			counterScale.Scale = 0.5
			TweenService:Create(counterScale, POP, { Scale = 1 }):Play()
			tapArea.Visible = true
			combo.Visible = false
			if plan.PerfectLaunch then
				showLaunch()
			end
			if type(plan.Special) == "string" then
				showSpecial(plan.Special)
			end
		else
			flightId = nil
			hideFlightBits()
		end
	end)

	Bus.FlightProgress:Connect(function(distance: any)
		if not counter.Visible or type(distance) ~= "number" then
			return
		end
		local whole = math.floor(distance)
		if whole ~= lastShown then
			lastShown = whole
			counter.Text = Format.Meters(distance)
		end
	end)

	Bus.ZoneEntered:Connect(function(zone: any)
		if type(zone) ~= "table" or not HudFlightState.Active then
			return
		end
		local color = if type(zone.Color) == "string" then Color3.fromHex(zone.Color) else WHITE
		-- counter punch
		counterScale.Scale = 1.4
		TweenService:Create(counterScale, POP, { Scale = 1 }):Play()
		counter.TextColor3 = color
		TweenService:Create(counter, TweenInfo.new(0.6), { TextColor3 = WHITE }):Play()
		-- banner slide
		zoneToken += 1
		local token = zoneToken
		zoneName.Text = tostring(zone.Name or "")
		zoneName.TextColor3 = color
		zoneStroke.Color = color
		zoneBanner.Visible = true
		zoneBanner.Position = UDim2.new(-0.4, 0, 0, counterTop + 100)
		TweenService:Create(zoneBanner, SLIDE, { Position = UDim2.new(0.5, 0, 0, counterTop + 100) }):Play()
		task.delay(1.5, function()
			if token ~= zoneToken then
				return
			end
			local out = TweenService:Create(zoneBanner, QUICK, { Position = UDim2.new(1.4, 0, 0, counterTop + 100) })
			out:Play()
			out.Completed:Wait()
			if token == zoneToken then
				zoneBanner.Visible = false
			end
		end)
	end)

	Bus.GustWindow:Connect(function(open: any)
		if open == true and HudFlightState.Active then
			tapPrompt.Visible = true
			tapScale.Scale = 0.4
			TweenService:Create(tapScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		else
			tapPrompt.Visible = false
		end
	end)

	Bus.RingResult:Connect(function(payload: any)
		if type(payload) ~= "table" or (flightId ~= nil and payload.Id ~= flightId) then
			return
		end
		tapPrompt.Visible = false
		if payload.Perfect then
			streak += 1
			combo.Text = "PERFECT x" .. tostring(streak)
			combo.TextColor3 = if streak >= 5 then Color3.fromHex("#FF8FF0") else Theme.Colors.MeterPerfect
			comboAmount.Text = if type(payload.Amount) == "number" and payload.Amount > 0
				then "+" .. Format.Short(payload.Amount) .. " " .. Theme.Icons.Skill
				else ""
			combo.Visible = true
			combo.TextTransparency = 0
			comboAmount.TextTransparency = 0
			comboScale.Scale = 0.5 + math.min(streak, 6) * 0.05
			TweenService:Create(comboScale, POP, { Scale = 1 + math.min(streak, 6) * 0.04 }):Play()
			comboToken += 1
			local token = comboToken
			task.delay(1.2, function()
				if token ~= comboToken then
					return
				end
				TweenService:Create(combo, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				local fade = TweenService:Create(comboAmount, TweenInfo.new(0.3), { TextTransparency = 1 })
				fade:Play()
				fade.Completed:Wait()
				if token == comboToken then
					combo.Visible = false
				end
			end)
		else
			streak = 0
		end
	end)

	Bus.FlightLanded:Connect(function(payload: any)
		if type(payload) ~= "table" or payload.UserId ~= localPlayer.UserId then
			return
		end
		-- the landing card takes over from the counter
		tapPrompt.Visible = false
		zoneBanner.Visible = false
		tapArea.Visible = false
		if payload.Cancelled then
			hideFlightBits()
		else
			task.delay(0.15, function()
				if flightId == nil or flightId == payload.Id then
					counter.Visible = false
				end
			end)
		end
	end)

	return self :: FlightOverlay
end

return HudFlightOverlay
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="102">
              <Properties>
                <string name="Name">HudFlightState</string>
                <string name="Source"><![CDATA[--!strict
-- Shared "is the local player's glider in the air?" flag for the HUD pieces (throw button,
-- tap area, left-menu fade, distance counter). Driven by Bus.FlightStarted/FlightEnded for the
-- local flight, with a failsafe timeout so a lost FlightEnded can never leave the HUD stuck.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

local Bus = require(script.Parent.Parent.Parent.Controllers.Bus)

local HudFlightState = {}

HudFlightState.Active = false
HudFlightState.Plan = nil :: { [string]: any }?
HudFlightState.Changed = Signal.new() -- (active: boolean, plan: table?)

local FAILSAFE = 8 -- seconds after the planned landing

local function set(active: boolean, plan: { [string]: any }?)
	if HudFlightState.Active == active and HudFlightState.Plan == plan then
		return
	end
	HudFlightState.Active = active
	HudFlightState.Plan = plan
	HudFlightState.Changed:Fire(active, plan)
end

Bus.FlightStarted:Connect(function(plan: any, isLocal: any)
	if isLocal ~= true or type(plan) ~= "table" then
		return
	end
	set(true, plan)
	local duration = if type(plan.Duration) == "number" then plan.Duration else 10
	task.delay(duration + FAILSAFE, function()
		if HudFlightState.Plan == plan then
			set(false, nil)
		end
	end)
end)

Bus.FlightEnded:Connect(function(plan: any, isLocal: any)
	if isLocal ~= true then
		return
	end
	local current = HudFlightState.Plan
	if current == nil or type(plan) ~= "table" or plan.Id == current.Id then
		set(false, nil)
	end
end)

return HudFlightState
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="103">
              <Properties>
                <string name="Name">HudLandingCard</string>
                <string name="Source"><![CDATA[--!strict
-- Landing result card for the local player's throws (Bus.FlightLanded owner payload): zone name in
-- the zone colour, distance, +Wins / +Skill, perfect catches, special-throw tag and a "NEW BEST!" /
-- "NEW ZONE!" ribbon. Pops for ~2.5 s; a new best or a special throw also lights a spinning sunburst
-- behind it (under the HUD buttons). A landing that opened a world (payload.UnlockedWorld) also
-- plays a big "NEW WORLD UNLOCKED" celebration with pooled confetti.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FlightSim = require(Shared.Sim.FlightSim)
local Format = require(Shared.Util.Format)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)

local UI = script.Parent.Parent
local Client = UI.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local AudioController = require(Client.Controllers.AudioController)
local Bus = require(Client.Controllers.Bus)
local UIController = require(Client.Controllers.UIController)
local Rays = require(script.Parent.Rays)

local HudLandingCard = {}

local POP = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local SHRINK = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In)
local WHITE = Color3.new(1, 1, 1)
local CARD_TIME = 2.6
local WORLD_TIME = 4.5
local CONFETTI = 28

function HudLandingCard.new(root: Frame)
	local localPlayer = Players.LocalPlayer

	-- sunburst behind the card (ZIndex 1: under the HUD groups, which sit at 2+)
	local rays = Rays.new(root, 900, 10, 1)
	rays.Instance.Name = "LandingCardRays"

	-- card ------------------------------------------------------------------------------------
	local card: Frame = Create("Frame", {
		Name = "LandingCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(500, 270),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.06,
		Visible = false,
		ZIndex = 10,
		Parent = root,
	})
	Create.Corner(20, card)
	local cardStroke = Create.Stroke(card, WHITE, 4, 0, true)
	local cardScale = Instance.new("UIScale")
	cardScale.Parent = card
	-- short screens (phones): a little smaller and lower, clear of the toasts and the bottom bar
	local cardSize = 1
	local function placeCard()
		local designHeight = root.AbsoluteSize.Y / math.max(UIController.Scale, 0.01)
		local compact = designHeight > 0 and designHeight < 760
		cardSize = if compact then 0.85 else 1
		card.Position = UDim2.fromScale(0.5, if compact then 0.56 else 0.42)
	end
	UIController.ScaleChanged:Connect(function()
		placeCard()
		if card.Visible and cardScale.Scale > 0 then
			cardScale.Scale = cardSize
		end
	end)

	local header: Frame = Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 66),
		BackgroundColor3 = WHITE,
		ZIndex = 11,
		Parent = card,
	})
	Create.Corner(20, header)
	local headerGradient = Instance.new("UIGradient")
	headerGradient.Rotation = 90
	headerGradient.Parent = header
	local zoneText = Create.Text({
		Name = "Zone",
		Text = "",
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 48,
		Scaled = true,
		Stroke = 3.5,
		ZIndex = 12,
		Parent = header,
	})
	local distanceText = Create.Text({
		Name = "Distance",
		Text = "",
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 70,
		Scaled = true,
		Stroke = 4,
		ZIndex = 12,
		Parent = card,
	})
	local winsText = Create.Text({
		Name = "Wins",
		Text = "",
		Size = UDim2.new(0.5, -20, 0, 44),
		Position = UDim2.fromOffset(20, 146),
		Font = Theme.Fonts.Display,
		TextSize = 42,
		Scaled = true,
		Color = Theme.Colors.Wins,
		Stroke = 3,
		ZIndex = 12,
		Parent = card,
	})
	local skillText = Create.Text({
		Name = "Skill",
		Text = "",
		Size = UDim2.new(0.5, -20, 0, 44),
		Position = UDim2.new(0.5, 0, 0, 146),
		Font = Theme.Fonts.Display,
		TextSize = 42,
		Scaled = true,
		Color = Color3.fromHex("#9FE6FF"),
		Stroke = 3,
		ZIndex = 12,
		Parent = card,
	})
	local perfectText = Create.Text({
		Name = "Perfects",
		Text = "",
		Size = UDim2.new(1, -40, 0, 34),
		Position = UDim2.new(0.5, 0, 0, 196),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		Color = Theme.Colors.MeterPerfect,
		Stroke = 2.5,
		ZIndex = 12,
		Parent = card,
	})
	local specialText = Create.Text({
		Name = "Special",
		Text = "",
		Size = UDim2.new(1, -40, 0, 28),
		Position = UDim2.new(0.5, 0, 0, 232),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 28,
		Scaled = true,
		Stroke = 2.5,
		ZIndex = 12,
		Parent = card,
	})
	local ribbon: Frame = Create("Frame", {
		Name = "Ribbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -40, 0, 0),
		Size = UDim2.fromOffset(210, 52),
		Rotation = 12,
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 14,
		Parent = card,
	})
	Create.Corner(12, ribbon)
	local ribbonGradient = Create.Gradient(ribbon, Color3.fromHex("#FF8FC8"), Color3.fromHex("#E8357F"), 90)
	Create.Stroke(ribbon, Theme.Colors.Stroke, 3, 0, true)
	local ribbonText = Create.Text({
		Name = "Text",
		Text = "NEW BEST!",
		Size = UDim2.new(1, -16, 1, -10),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 34,
		Scaled = true,
		Stroke = 3,
		ZIndex = 15,
		Parent = ribbon,
	})
	local ribbonScale = Instance.new("UIScale")
	ribbonScale.Parent = ribbon

	-- world unlock celebration ----------------------------------------------------------------
	local world: Frame = Create("Frame", {
		Name = "WorldUnlocked",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromOffset(1040, 170),
		BackgroundColor3 = WHITE,
		Visible = false,
		ZIndex = 20,
		Parent = root,
	})
	Create.Corner(26, world)
	Create.Stroke(world, Theme.Colors.Stroke, 5, 0, true)
	local worldGradient = Instance.new("UIGradient")
	worldGradient.Color = Theme.Rainbow
	worldGradient.Parent = world
	local worldScale = Instance.new("UIScale")
	worldScale.Parent = world
	local worldTitle = Create.Text({
		Name = "Title",
		Text = "",
		Size = UDim2.new(1, -40, 0, 100),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 80,
		Scaled = true,
		Stroke = 5,
		ZIndex = 21,
		Parent = world,
	})
	Create.Text({
		Name = "Subtitle",
		Text = Theme.Icons.World .. " Use the portal to travel there!",
		Size = UDim2.new(1, -40, 0, 44),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		Font = Theme.Fonts.Display,
		TextSize = 40,
		Scaled = true,
		Stroke = 3.5,
		ZIndex = 21,
		Parent = world,
	})
	local confettiLayer: Frame = Create("Frame", {
		Name = "Confetti",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 19,
		Visible = false,
		Parent = root,
	})
	local CONFETTI_COLORS = {
		Color3.fromHex("#FF4F4F"),
		Color3.fromHex("#FFC53D"),
		Color3.fromHex("#5BE05B"),
		Color3.fromHex("#3FA9FF"),
		Color3.fromHex("#B65CFF"),
		Color3.fromHex("#FF8FC8"),
	}
	local pieces: { Frame } = table.create(CONFETTI)
	for i = 1, CONFETTI do
		pieces[i] = Create("Frame", {
			Name = "Piece",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(16, 26),
			BackgroundColor3 = CONFETTI_COLORS[(i - 1) % #CONFETTI_COLORS + 1],
			ZIndex = 19,
			Parent = confettiLayer,
		})
	end
	local rng = Random.new()

	local cardToken = 0
	local worldToken = 0

	local function celebrateWorld(worldId: number)
		local def = Worlds.Get(worldId)
		if not def then
			return
		end
		worldToken += 1
		local token = worldToken
		worldTitle.Text = "NEW WORLD UNLOCKED: " .. string.upper(def.Name) .. "!"
		world.Visible = true
		worldScale.Scale = 0.2
		TweenService:Create(worldScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		confettiLayer.Visible = true
		for _, piece in pieces do
			local x = rng:NextNumber(0.05, 0.95)
			piece.Position = UDim2.fromScale(x, -0.05)
			piece.Rotation = rng:NextNumber(0, 360)
			piece.BackgroundTransparency = 0
			local fall = TweenInfo.new(rng:NextNumber(2.2, 3.6), Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, rng:NextNumber(0, 0.8))
			TweenService:Create(piece, fall, {
				Position = UDim2.fromScale(x + rng:NextNumber(-0.12, 0.12), 1.08),
				Rotation = piece.Rotation + rng:NextNumber(-540, 540),
			}):Play()
		end
		AudioController.Play("Rebirth")
		task.delay(WORLD_TIME, function()
			if token ~= worldToken then
				return
			end
			local out = TweenService:Create(worldScale, SHRINK, { Scale = 0 })
			out:Play()
			out.Completed:Wait()
			if token == worldToken then
				world.Visible = false
				confettiLayer.Visible = false
			end
		end)
	end

	local function show(payload: { [string]: any })
		placeCard()
		local zone = if type(payload.Zone) == "string" then Zones.Get(payload.Zone) else nil
		local color = if zone then Color3.fromHex(zone.Color) else WHITE
		zoneText.Text = if zone then zone.Name else "Splash!"
		zoneText.TextColor3 = WHITE
		headerGradient.Color = ColorSequence.new(color:Lerp(WHITE, 0.15), color:Lerp(Color3.new(0, 0, 0), 0.45))
		cardStroke.Color = color
		distanceText.Text = Format.Meters(tonumber(payload.Distance) or 0)
		winsText.Text = "+" .. Format.Short(tonumber(payload.Wins) or 0) .. " " .. Theme.Icons.Wins
		skillText.Text = "+" .. Format.Short(tonumber(payload.Skill) or 0) .. " " .. Theme.Icons.Skill
		local perfects = tonumber(payload.Perfects) or 0
		local rings = tonumber(payload.Rings) or 0
		perfectText.Text = string.format("%s %d/%d PERFECT CATCHES", Theme.Icons.Star, perfects, rings)
		local info = FlightSim.SpecialInfo(if type(payload.Special) == "string" then payload.Special else nil)
		if info then
			specialText.Text = string.format("%s THROW x%d", info.Name, info.Multiplier)
			specialText.TextColor3 = Color3.fromHex(info.Color)
			specialText.Visible = true
		else
			specialText.Visible = false
		end

		local newBest = payload.NewBest == true
		local newZone = payload.NewZone == true
		ribbon.Visible = newBest or newZone
		if newBest then
			ribbonText.Text = "NEW BEST!"
			ribbonGradient.Color = ColorSequence.new(Color3.fromHex("#FF8FC8"), Color3.fromHex("#E8357F"))
		elseif newZone then
			ribbonText.Text = "NEW ZONE!"
			ribbonGradient.Color = ColorSequence.new(Color3.fromHex("#7BEA4A"), Color3.fromHex("#2FA80F"))
		end
		if ribbon.Visible then
			ribbonScale.Scale = 0
			TweenService:Create(ribbonScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.25), { Scale = 1 }):Play()
		end

		if newBest or info then
			rays.Instance.Position = card.Position
			rays.Instance.Size = UDim2.fromOffset(900 * cardSize, 900 * cardSize)
			rays:Show(if info then Color3.fromHex(info.Color) else Theme.Colors.Skill, if info then 1 else 0.7)
		else
			rays:Hide()
		end

		cardToken += 1
		local token = cardToken
		card.Visible = true
		cardScale.Scale = 0.3 * cardSize
		TweenService:Create(cardScale, POP, { Scale = cardSize }):Play()
		if newBest then
			AudioController.Play("NewBest")
		else
			AudioController.Play("Reward", nil, nil, 0.6)
		end
		task.delay(CARD_TIME, function()
			if token ~= cardToken then
				return
			end
			local out = TweenService:Create(cardScale, SHRINK, { Scale = 0 })
			out:Play()
			out.Completed:Wait()
			if token == cardToken then
				card.Visible = false
				rays:Hide()
			end
		end)

		if type(payload.UnlockedWorld) == "number" then
			celebrateWorld(payload.UnlockedWorld)
		end
	end

	-- starting the next throw dismisses the card (on phones it covers the THROW button)
	Bus.ChargeChanged:Connect(function(on: any)
		if on == true and card.Visible then
			cardToken += 1
			local token = cardToken
			local out = TweenService:Create(cardScale, SHRINK, { Scale = 0 })
			out:Play()
			out.Completed:Once(function()
				if token == cardToken then
					card.Visible = false
					rays:Hide()
				end
			end)
		end
	end)
	Bus.FlightLanded:Connect(function(payload: any)
		if type(payload) ~= "table" or payload.Cancelled or payload.Owner ~= true then
			return
		end
		if payload.UserId ~= nil and payload.UserId ~= localPlayer.UserId then
			return
		end
		show(payload)
	end)
end

return HudLandingCard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="104">
              <Properties>
                <string name="Name">HudLevelBar</string>
                <string name="Source"><![CDATA[--!strict
-- Bottom-centre progress block: "⚡ N SKILL" / "xM Multiplier" row above a wide level bar
-- ("Level L" + "x/y" or "MAX LEVEL"). Level is derived from Skill on the server: Data.XP is the
-- Skill progress inside the level and Derived.XPToNext the level's width. At the cap the bar turns
-- gold and a pulsing "REBIRTH!" hint opens the Rebirth screen. FlashLevel() pops "LEVEL UP!".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Format = require(ReplicatedStorage:WaitForChild("Shared").Util.Format)

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Button = require(script.Parent.Button)
local UIController = require(UI.Parent.Controllers.UIController)

export type LevelBar = {
	Instance: Frame,
	Update: (LevelBar, { [string]: any }) -> (),
	Animate: (LevelBar, number) -> (),
	FlashLevel: (LevelBar, number) -> (),
	Maxed: boolean,
}

local HudLevelBar = {}

local WIDTH = 660
local BAR_W = 640
local BAR_H = 54
local ROW_H = 42

local FILL = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local GOLD_TOP = Color3.fromHex("#FFE27A")
local GOLD_BOTTOM = Color3.fromHex("#F2A900")

HudLevelBar.Height = ROW_H + 4 + BAR_H

function HudLevelBar.new(parent: Instance, layoutOrder: number?): LevelBar
	local root: Frame = Create("Frame", {
		Name = "LevelBlock",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(WIDTH, HudLevelBar.Height),
		LayoutOrder = layoutOrder or 0,
		Parent = parent,
	})

	-- Skill / multiplier row
	local skillText = Create.Text({
		Name = "Skill",
		Text = Theme.Icons.Skill .. " 0 SKILL",
		Size = UDim2.new(0.58, 0, 0, ROW_H),
		Position = UDim2.fromOffset(10, 0),
		Font = Theme.Fonts.Display,
		TextSize = 38,
		Scaled = true,
		Color = Theme.Colors.Skill,
		Stroke = 3,
		XAlign = Enum.TextXAlignment.Left,
		Parent = root,
	})
	local multText = Create.Text({
		Name = "Multiplier",
		Text = "x1 Multiplier",
		Size = UDim2.new(0.4, 0, 0, ROW_H - 6),
		Position = UDim2.new(1, -10, 0, 3),
		AnchorPoint = Vector2.new(1, 0),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		Color = Color3.fromHex("#9FE6FF"),
		Stroke = 3,
		XAlign = Enum.TextXAlignment.Right,
		Parent = root,
	})

	-- Level bar
	local bar: Frame = Create("Frame", {
		Name = "Bar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, ROW_H + 4),
		Size = UDim2.fromOffset(BAR_W, BAR_H),
		BackgroundColor3 = Theme.Colors.LevelTrack,
		BackgroundTransparency = 0.05,
		Parent = root,
	})
	Create.Corner(14, bar)
	local barStroke = Create.Stroke(bar, Theme.Colors.Stroke, 3.5, 0, true)
	local fill: Frame = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = bar,
	})
	Create.Corner(14, fill)
	local fillGradient = Create.Gradient(fill, Theme.Colors.LevelFillTop, Theme.Colors.LevelFillBottom, 90)
	local gloss: Frame = Create("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		Position = UDim2.fromOffset(6, 4),
		Size = UDim2.new(1, -12, 0.36, 0),
		ZIndex = 2,
		Parent = bar,
	})
	Create.Corner(10, gloss)
	local levelText = Create.Text({
		Name = "Level",
		Text = "Level 1",
		Size = UDim2.new(0.45, 0, 0.8, 0),
		Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 34,
		Scaled = true,
		Stroke = 3,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = bar,
	})
	local progressText = Create.Text({
		Name = "Progress",
		Text = "0/1",
		Size = UDim2.new(0.5, 0, 0.8, 0),
		Position = UDim2.new(1, -16, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 34,
		Scaled = true,
		Stroke = 3,
		XAlign = Enum.TextXAlignment.Right,
		ZIndex = 3,
		Parent = bar,
	})

	-- "REBIRTH!" hint at the cap (wrapper holds the pulse scale; the button owns its hover scale)
	local hintHolder: Frame = Create("Frame", {
		Name = "RebirthHint",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 12, 0.5, 0),
		Size = UDim2.fromOffset(150, 60),
		Visible = false,
		Parent = bar,
	})
	local hintScale = Instance.new("UIScale")
	hintScale.Parent = hintHolder
	Button.new({
		Parent = hintHolder,
		Name = "Rebirth",
		Size = UDim2.fromScale(1, 1),
		Style = "Pink",
		Text = Theme.Icons.Rebirth .. " REBIRTH!",
		TextSize = 26,
		Corner = 14,
		OnClick = function()
			UIController.Open("Rebirth")
		end,
	})

	-- "LEVEL UP!" pop centred on the bar (one reused label; never hidden by context panels)
	local levelUp = Create.Text({
		Name = "LevelUp",
		Text = "",
		Size = UDim2.fromOffset(200, 46),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 46,
		Scaled = true,
		Color = Color3.fromHex("#7FFFD4"),
		Stroke = 3.5,
		ZIndex = 5,
		Parent = bar,
	})
	levelUp.Visible = false
	local levelUpScale = Instance.new("UIScale")
	levelUpScale.Parent = levelUp

	local self = { Instance = root, Maxed = false } :: any
	local lastLevel = 0
	local flashToken = 0

	function self.Update(this: any, data: { [string]: any })
		local derived = if type(data.Derived) == "table" then data.Derived else {}
		local skill = tonumber(data.Skill) or 0
		local level = tonumber(data.Level) or 1
		local cap = tonumber(derived.LevelCap) or math.huge
		local span = math.max(tonumber(derived.XPToNext) or 1, 1e-9)
		local xp = tonumber(data.XP) or 0
		local maxed = level >= cap

		skillText.Text = Theme.Icons.Skill .. " " .. Format.Short(skill) .. " SKILL"
		multText.Text = "x" .. Format.Short(tonumber(derived.SkillMultiplier) or 1) .. " Multiplier"
		levelText.Text = "Level " .. tostring(level)
		progressText.Text = if maxed then "MAX LEVEL" else Format.Short(xp) .. "/" .. Format.Short(span)

		local ratio = if maxed then 1 else math.clamp(xp / span, 0, 1)
		if ratio > 0 then
			ratio = math.max(ratio, 0.04) -- keep the rounded fill readable when nearly empty
		end
		if level > lastLevel and lastLevel > 0 then
			fill.Size = UDim2.fromScale(0, 1)
		end
		lastLevel = level
		TweenService:Create(fill, FILL, { Size = UDim2.fromScale(ratio, 1) }):Play()

		if maxed ~= this.Maxed then
			this.Maxed = maxed
			fillGradient.Color = if maxed
				then ColorSequence.new(GOLD_TOP, GOLD_BOTTOM)
				else ColorSequence.new(Theme.Colors.LevelFillTop, Theme.Colors.LevelFillBottom)
			hintHolder.Visible = maxed
			if not maxed then
				barStroke.Color = Theme.Colors.Stroke
				hintScale.Scale = 1
			end
		end
	end

	-- Pulses the cap hint (called by the HUD ticker).
	function self.Animate(this: any, t: number)
		if this.Maxed then
			local w = (math.sin(t * 5) + 1) / 2
			hintScale.Scale = 1 + w * 0.1
			barStroke.Color = Theme.Colors.Stroke:Lerp(GOLD_TOP, w * 0.8)
		end
	end

	function self.FlashLevel(_: any, level: number)
		flashToken += 1
		local token = flashToken
		levelUp.Text = "LEVEL UP! " .. tostring(level)
		levelUp.Visible = true
		levelUp.TextTransparency = 0
		levelUp.Position = UDim2.fromScale(0.5, 0.5)
		levelUpScale.Scale = 0.4
		TweenService:Create(levelUpScale, POP, { Scale = 1.05 }):Play()
		TweenService:Create(levelUp, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0.5, -10),
		}):Play()
		barStroke.Color = Color3.fromHex("#7FFFD4")
		task.delay(1.1, function()
			if token ~= flashToken then
				return
			end
			local fade = TweenService:Create(levelUp, TweenInfo.new(0.3), { TextTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			if token == flashToken then
				levelUp.Visible = false
				if not self.Maxed then
					barStroke.Color = Theme.Colors.Stroke
				end
			end
		end)
	end

	return self :: LevelBar
end

return HudLevelBar
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="105">
              <Properties>
                <string name="Name">HudStatPill</string>
                <string name="Source"><![CDATA[--!strict
-- Bottom-left HUD counter pill: round emoji badge on the left, chunky stroked value text on a
-- dark translucent pill. Bump() pops it when the value goes up; SetValue can count up to a new
-- value after a delay (rewards flying into the counter land first, then the number rolls up).
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Icon = require(script.Parent.Icon)

export type PillProps = {
	Parent: Instance,
	Name: string,
	Icon: string,
	Color: Color3, -- value text colour
	Badge: Color3, -- icon circle colour
	Width: number?,
	Height: number?,
	LayoutOrder: number?,
}

export type Pill = {
	Instance: Frame,
	Badge: Frame,
	Value: TextLabel,
	SetText: (Pill, string) -> (),
	SetValue: (Pill, number, (number) -> string, number?) -> (),
	Bump: (Pill) -> (),
}

local HudStatPill = {}

local POP = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local COUNT_TIME = 0.7

function HudStatPill.new(props: PillProps): Pill
	local height = props.Height or 52
	local root: Frame = Create("Frame", {
		Name = props.Name,
		Size = UDim2.fromOffset(props.Width or 250, height),
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.25,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Create.Round(root)
	Create.Stroke(root, Theme.Colors.Stroke, 2.5, 0.1, true)
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local badge: Frame = Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -4, 0.5, 0),
		Size = UDim2.fromOffset(height + 6, height + 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = root,
	})
	Create.Round(badge)
	Create.Gradient(badge, props.Badge:Lerp(Color3.new(1, 1, 1), 0.35), props.Badge, 90)
	Create.Stroke(badge, Theme.Colors.Stroke, 3, 0, true)
	Icon.new({
		Icon = props.Icon,
		Name = "Icon",
		Size = UDim2.fromScale(0.74, 0.74),
		TextSize = 40,
		ZIndex = 3,
		Parent = badge,
	})
	local value = Create.Text({
		Name = "Value",
		Text = "0",
		Size = UDim2.new(1, -(height + 18), 0.86, 0),
		Position = UDim2.new(0, height + 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 34,
		Scaled = true,
		Color = props.Color,
		Stroke = 3,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = root,
	})

	local self = { Instance = root, Badge = badge, Value = value } :: any

	local function show(text: string)
		if value.Text ~= text then
			value.Text = text
		end
	end
	function self.SetText(_: any, text: string)
		show(text)
	end

	-- Numeric counters: with a delay and a higher value, the text holds, then rolls up (ease-out)
	-- over COUNT_TIME; anything else (first value, a drop, no delay) shows at once. A sync that
	-- repeats the value being counted to leaves the roll alone.
	local shown: number? = nil
	local from, target, startAt = 0, 0, 0
	local format: (number) -> string = tostring
	local rolling: RBXScriptConnection? = nil
	local function stopRoll()
		if rolling then
			rolling:Disconnect()
			rolling = nil
		end
	end
	function self.SetValue(_: any, n: number, fmt: (number) -> string, delay: number?)
		format = fmt
		if rolling and n == target then
			return
		end
		local current = shown
		if current == nil or delay == nil or n <= current then
			stopRoll()
			shown, target = n, n
			show(fmt(n))
			return
		end
		from, target, startAt = current, n, os.clock() + delay
		if rolling then
			return
		end
		rolling = RunService.Heartbeat:Connect(function()
			local a = (os.clock() - startAt) / COUNT_TIME
			if a < 0 then
				return
			end
			if a >= 1 then
				stopRoll()
				shown = target
				show(format(target))
				return
			end
			local v = from + (target - from) * (1 - (1 - a) ^ 3)
			shown = v
			show(format(math.floor(v)))
		end)
	end

	function self.Bump(_: any)
		scale.Scale = 1.12
		TweenService:Create(scale, POP, { Scale = 1 }):Play()
	end

	return self :: Pill
end

return HudStatPill
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="106">
              <Properties>
                <string name="Name">HudThrowPanel</string>
                <string name="Source"><![CDATA[--!strict
-- Contextual throw controls (bottom-centre, above the level bar): the big green THROW button that
-- appears in the Throw Zone and the launch meter drawn while charging. Press-down / release are
-- forwarded to ThrowController (required lazily so load order never matters); the meter is purely
-- cosmetic and mirrors the server's clock (FlightSim.MeterAt of server time since StartedAt).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FlightConfig = require(Shared.Config.Flight)
local FlightSim = require(Shared.Sim.FlightSim)

local UI = script.Parent.Parent
local Client = UI.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Button = require(script.Parent.Button)
local HudFlightState = require(script.Parent.HudFlightState)
local AudioController = require(Client.Controllers.AudioController)
local Bus = require(Client.Controllers.Bus)

export type ThrowPanel = {
	Instance: Frame,
}

local HudThrowPanel = {}

local METER_W = 460
local METER_H = 40
local BUTTON_W = 220
local BUTTON_H = 90
local POP = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function throwController(): any
	local module = Client.Controllers:FindFirstChild("ThrowController")
	if module and module:IsA("ModuleScript") then
		return (require :: any)(module)
	end
	return nil
end

local function call(method: string)
	local controller = throwController()
	if controller and type(controller[method]) == "function" then
		controller[method]()
	end
end

function HudThrowPanel.new(parent: Instance, bottomOffset: number): ThrowPanel
	local holder: Frame = Create("Frame", {
		Name = "ThrowPanel",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -bottomOffset),
		Size = UDim2.fromOffset(METER_W + 40, BUTTON_H + METER_H + 70),
		Visible = false,
		ZIndex = 3,
		Parent = parent,
	})

	-- THROW button
	local holdScale = Instance.new("UIScale")
	local buttonHolder: Frame = Create("Frame", {
		Name = "ButtonHolder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(BUTTON_W, BUTTON_H),
		Parent = holder,
	})
	holdScale.Parent = buttonHolder
	local button = Button.new({
		Parent = buttonHolder,
		Name = "Throw",
		Size = UDim2.fromScale(1, 1),
		Style = "Green",
		Text = "THROW",
		TextSize = 56,
		Corner = 18,
		Silent = true,
	})
	button.Label.Size = UDim2.new(1, -20, 0.6, 0)
	button.Label.Position = UDim2.fromScale(0.5, 0.4)
	-- input hint under the label (ThrowController binds E / R2 while in the zone)
	local keyHint = Create.Text({
		Name = "KeyHint",
		Text = "HOLD",
		Size = UDim2.new(1, -20, 0.31, 0),
		Position = UDim2.fromScale(0.5, 0.81),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 22,
		Scaled = true,
		Color = Color3.fromHex("#EFFFE6"),
		Stroke = 2,
		ZIndex = button.Instance.ZIndex + 2,
		Parent = button.Content,
	})
	local function refreshHint()
		local last = UserInputService:GetLastInputType()
		if last == Enum.UserInputType.Touch then
			keyHint.Text = "HOLD" -- one short word stays readable on small phones; the meter hint says when to let go
		elseif string.find(last.Name, "Gamepad", 1, true) then
			keyHint.Text = "HOLD [R2]"
		else
			keyHint.Text = "HOLD [E]"
		end
	end
	UserInputService.LastInputTypeChanged:Connect(refreshHint)
	refreshHint()

	-- Launch meter
	local meter: Frame = Create("Frame", {
		Name = "Meter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(BUTTON_H + 18)),
		Size = UDim2.fromOffset(METER_W, METER_H),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = holder,
	})
	Create.Corner(12, meter)
	local meterStroke = Create.Stroke(meter, Theme.Colors.Stroke, 3.5, 0, true)
	local track = Instance.new("UIGradient")
	track.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHex("#FF4F5E")),
		ColorSequenceKeypoint.new(0.45, Color3.fromHex("#FFB300")),
		ColorSequenceKeypoint.new(0.8, Theme.Colors.MeterGood),
		ColorSequenceKeypoint.new(1, Theme.Colors.MeterGood),
	})
	track.Parent = meter
	local perfectAt = FlightConfig.PerfectLaunchAt
	local band: Frame = Create("Frame", {
		Name = "PerfectBand",
		Position = UDim2.fromScale(perfectAt, 0),
		Size = UDim2.fromScale(1 - perfectAt, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = meter,
	})
	Create.Corner(10, band)
	Create.Gradient(band, Color3.fromHex("#FFF6C2"), Theme.Colors.MeterPerfect, 90)
	Create.Stroke(band, Color3.fromHex("#6B4300"), 2, 0, true)
	Create.Text({
		Name = "PerfectLabel",
		Text = "PERFECT",
		Size = UDim2.fromOffset(150, 30),
		Position = UDim2.new(perfectAt + (1 - perfectAt) / 2, 0, 0, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		Color = Theme.Colors.MeterPerfect,
		Stroke = 2.5,
		Parent = meter,
	})
	Create.Text({
		Name = "Hint",
		Text = "RELEASE IN THE GOLD!",
		Size = UDim2.fromOffset(300, 28),
		Position = UDim2.new(0, 4, 0, -4),
		AnchorPoint = Vector2.new(0, 1),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Stroke = 2.5,
		XAlign = Enum.TextXAlignment.Left,
		Parent = meter,
	})
	local needle: Frame = Create("Frame", {
		Name = "Needle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 12, 1, 22),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 4,
		Parent = meter,
	})
	Create.Corner(6, needle)
	local needleStroke = Create.Stroke(needle, Theme.Colors.Stroke, 3, 0, true)

	-- state
	local inZone = false
	local charging = false
	local startedAt = 0
	local lastSegment = -1
	local renderConn: RBXScriptConnection? = nil
	local hideToken = 0

	local function refreshVisible()
		holder.Visible = (inZone or charging) and not HudFlightState.Active
	end

	local function stepMeter()
		local value = FlightSim.MeterAt(Workspace:GetServerTimeNow() - startedAt)
		needle.Position = UDim2.fromScale(value, 0.5)
		local perfect = value >= perfectAt
		needle.BackgroundColor3 = if perfect then Theme.Colors.MeterPerfect else Color3.new(1, 1, 1)
		meterStroke.Color = if perfect then Theme.Colors.MeterPerfect else Theme.Colors.Stroke
		local segment = math.floor(value * 8)
		if segment ~= lastSegment then
			lastSegment = segment
			AudioController.PlayPitched("Charge", 0.7 + value * 0.9, if perfect then 1 else 0.6)
		end
	end

	local function setCharging(on: boolean, at: number?)
		if on then
			hideToken += 1
			charging = true
			startedAt = at or Workspace:GetServerTimeNow()
			lastSegment = -1
			meter.Visible = true
			button:SetText("RELEASE!")
			button:SetStyle("Gold")
			holdScale.Scale = 0.94
			if renderConn == nil then
				renderConn = RunService.RenderStepped:Connect(stepMeter)
			end
			stepMeter()
		else
			if not charging then
				return
			end
			charging = false
			if renderConn then
				renderConn:Disconnect()
				renderConn = nil
			end
			button:SetText("THROW")
			button:SetStyle("Green")
			TweenService:Create(holdScale, POP, { Scale = 1 }):Play()
			-- freeze the needle briefly so the player sees where they released
			hideToken += 1
			local token = hideToken
			needleStroke.Thickness = 4
			task.delay(0.45, function()
				if token == hideToken then
					meter.Visible = false
					needleStroke.Thickness = 3
				end
			end)
		end
		refreshVisible()
	end

	-- input: press-down / release (mouse + touch); gamepad selection falls back to a quick tap
	local pressing: InputObject? = nil
	local gamepadHold = false
	button.Instance.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		if pressing ~= nil or not holder.Visible then
			return
		end
		pressing = input
		AudioController.Play("Click")
		call("Press")
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if gamepadHold and input.KeyCode == Enum.KeyCode.ButtonA then
			gamepadHold = false
			call("Release")
			return
		end
		local held = pressing
		if held == nil then
			return
		end
		local mouseUp = input.UserInputType == Enum.UserInputType.MouseButton1 and held.UserInputType == Enum.UserInputType.MouseButton1
		if input == held or mouseUp then
			pressing = nil
			call("Release")
		end
	end)
	button.Instance.Activated:Connect(function(input: InputObject?)
		local kind = if input then input.UserInputType else UserInputService:GetLastInputType()
		local gamepad = kind == Enum.UserInputType.Gamepad1
			or kind == Enum.UserInputType.Gamepad2
			or kind == Enum.UserInputType.Gamepad3
			or kind == Enum.UserInputType.Gamepad4
		if not gamepad or gamepadHold or not holder.Visible then
			return
		end
		call("Press")
		if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) then
			gamepadHold = true -- released on ButtonA up
		else
			task.delay(0.08, function()
				call("Release")
			end)
		end
	end)

	Bus.InThrowZoneChanged:Connect(function(on: any)
		local was = inZone
		inZone = on == true
		refreshVisible()
		if inZone and not was and holder.Visible then
			buttonHolder.Size = UDim2.fromOffset(BUTTON_W * 0.6, BUTTON_H * 0.6)
			TweenService:Create(buttonHolder, POP, { Size = UDim2.fromOffset(BUTTON_W, BUTTON_H) }):Play()
		end
		if not inZone and pressing ~= nil then
			pressing = nil
		end
	end)
	Bus.ChargeChanged:Connect(function(on: any, at: any)
		setCharging(on == true, if type(at) == "number" then at else nil)
	end)
	HudFlightState.Changed:Connect(function(active: any)
		if active then
			setCharging(false)
			pressing = nil
			gamepadHold = false
		end
		refreshVisible()
	end)

	return { Instance = holder }
end

return HudThrowPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="107">
              <Properties>
                <string name="Name">HudTile</string>
                <string name="Source"><![CDATA[--!strict
-- Square HUD menu tile (left grid, right offers) in the simulator style: a bright gradient face
-- with a thick dark outline and gloss, raised on a darker base (pressing sinks it), big emoji
-- icon, chunky stroked label, optional caption over the icon ("83%"), a red count badge, a gold
-- "ready" glow, an attention wiggle (e.g. gifts waiting), an optional glint sweep and an optional
-- hover tooltip. The HUD ticker drives the glow and wiggle through Animate. Gamepad-selectable;
-- hover grows it, thickens the outline and wiggles the icon.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Shine = require(script.Parent.Shine)
local Tooltip = require(script.Parent.Tooltip)
local Icon = require(script.Parent.Icon)
local AudioController = require(UI.Parent.Controllers.AudioController)

export type TileProps = {
	Parent: Instance,
	Name: string,
	Icon: string,
	Label: string?,
	Size: number?, -- side in design px (default 92), base included
	Top: Color3,
	Bottom: Color3,
	LayoutOrder: number?,
	Round: boolean?,
	Shine: boolean?,
	Tooltip: { Title: string, Text: string, Beside: GuiObject? }?,
	OnClick: () -> (),
}

export type Tile = {
	Instance: TextButton,
	Face: Frame,
	Icon: GuiObject, -- 3D icon image (emoji until uploaded), see Components/Icon
	Label: TextLabel?,
	SetBadge: (Tile, number) -> (),
	SetCaption: (Tile, string?) -> (),
	SetGlow: (Tile, boolean) -> (),
	SetAttention: (Tile, boolean) -> (),
	Animate: (Tile, number) -> (),
	Glowing: boolean,
	Attention: boolean,
}

local HudTile = {}

local QUICK = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SPRING = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local GOLD = Color3.fromHex("#FFD447")
local GOLD_HOT = Color3.fromHex("#FFF6C2")
local WIGGLE_EVERY = 2.4 -- seconds between attention wiggles
local WIGGLE_TIME = 0.6
local HOVER_WIGGLE = TweenInfo.new(0.07, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true)
-- Inner shadow: the lower part of a face darkens toward its bottom edge (depth under the gloss).
local INNER_SHADOW = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(1, 0.7),
})

function HudTile.new(props: TileProps): Tile
	local side = props.Size or 92
	local depth = Theme.Depth
	local function rounding(target: GuiObject, radius: number)
		if props.Round then
			Create.Round(target)
		else
			Create.Corner(radius, target)
		end
	end

	local root: TextButton = Create("TextButton", {
		Name = props.Name,
		Size = UDim2.fromOffset(side, side),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		LayoutOrder = props.LayoutOrder or 0,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local base: Frame = Create("Frame", {
		Name = "Base",
		BackgroundColor3 = Theme.Darken(props.Bottom, 0.5),
		Position = UDim2.fromOffset(0, depth),
		Size = UDim2.new(1, 0, 1, -depth),
		Parent = root,
	})
	rounding(base, 16)
	Create.Stroke(base, Theme.Colors.Stroke, Theme.Outline, 0, true)

	local face: Frame = Create("Frame", {
		Name = "Face",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 1, -depth),
		ZIndex = 2,
		Parent = root,
	})
	rounding(face, 16)
	Create.Gradient(face, props.Top, props.Bottom, 90)
	local border = Create.Stroke(face, Theme.Colors.Stroke, Theme.Outline, 0, true)

	local gloss: Frame = Create("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		Size = UDim2.new(1, -10, 0.42, 0),
		Position = UDim2.fromOffset(5, 4),
		Parent = face,
	})
	rounding(gloss, 12)
	local inner: Frame = Create("Frame", {
		Name = "InnerShadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(1, 0.5),
		Parent = face,
	})
	rounding(inner, 16)
	local innerGradient = Instance.new("UIGradient")
	innerGradient.Rotation = 90
	innerGradient.Transparency = INNER_SHADOW
	innerGradient.Parent = inner
	if props.Shine then
		Shine.Add(face, if props.Round then UDim.new(0.5, 0) else UDim.new(0, 16), 2)
	end

	local hasLabel = props.Label ~= nil and props.Label ~= ""
	local icon = Icon.new({
		Icon = props.Icon,
		Name = "Icon",
		Size = if hasLabel then UDim2.fromScale(0.66, 0.6) else UDim2.fromScale(0.68, 0.68),
		Position = if hasLabel then UDim2.fromScale(0.5, 0.4) else UDim2.fromScale(0.5, 0.5),
		TextSize = 64,
		ZIndex = 3,
		Parent = face,
	})
	local label: TextLabel? = nil
	if hasLabel then
		label = Create.Text({
			Name = "Label",
			Text = props.Label or "",
			Size = UDim2.new(1, 4, 0.3, 0),
			Position = UDim2.new(0.5, 0, 1, -3),
			AnchorPoint = Vector2.new(0.5, 1),
			Font = Theme.Fonts.Display,
			TextSize = 24,
			Scaled = true,
			Stroke = 2.8,
			ZIndex = 4,
			Parent = face,
		})
	end
	local caption = Create.Text({
		Name = "Caption",
		Text = "",
		Size = UDim2.new(1, 0, 0.3, 0),
		Position = UDim2.new(0.5, 0, 0, -4),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		Stroke = 2.8,
		ZIndex = 5,
		Parent = face,
	})
	caption.Visible = false

	local badge: Frame = Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 5,
		Parent = root,
	})
	Create.Round(badge)
	Create.Gradient(badge, Color3.fromHex("#FF7A85"), Theme.Colors.Danger, 90)
	Create.Stroke(badge, Theme.Colors.Stroke, 2.5, 0, true)
	local badgeText = Create.Text({
		Name = "Count",
		Text = "",
		Size = UDim2.fromScale(0.8, 0.8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 22,
		Scaled = true,
		Stroke = 1.8,
		ZIndex = 6,
		Parent = badge,
	})

	local self = {
		Instance = root,
		Face = face,
		Icon = icon,
		Label = label,
		Glowing = false,
		Attention = false,
	} :: any

	function self.SetBadge(_: any, count: number)
		if count <= 0 then
			badge.Visible = false
			return
		end
		local text = if count > 9 then "9+" else tostring(count)
		if not badge.Visible or badgeText.Text ~= text then
			badge.Visible = true
			badgeText.Text = text
			badge.Size = UDim2.fromOffset(22, 22)
			TweenService:Create(badge, SPRING, { Size = UDim2.fromOffset(32, 32) }):Play()
		end
	end

	function self.SetCaption(_: any, text: string?)
		caption.Visible = text ~= nil
		if text and caption.Text ~= text then
			caption.Text = text
		end
	end

	local function rest()
		if not self.Glowing then
			border.Color = Theme.Colors.Stroke
			border.Thickness = Theme.Outline
			caption.TextColor3 = Theme.Colors.Text
		end
		if not self.Glowing and not self.Attention then
			icon.Rotation = 0
			badge.Rotation = 0
		end
	end

	function self.SetGlow(this: any, on: boolean)
		if this.Glowing == on then
			return
		end
		this.Glowing = on
		rest()
	end

	function self.SetAttention(this: any, on: boolean)
		if this.Attention == on then
			return
		end
		this.Attention = on
		rest()
	end

	-- Called ~20x per second by the HUD ticker; only does work while glowing or asking for attention.
	function self.Animate(this: any, t: number)
		if this.Glowing then
			local w = (math.sin(t * 6) + 1) / 2
			border.Color = GOLD:Lerp(GOLD_HOT, w)
			border.Thickness = Theme.Outline + w * 2
			icon.Rotation = math.sin(t * 4) * 9
			caption.TextColor3 = GOLD:Lerp(GOLD_HOT, w)
		elseif this.Attention then
			-- a short shake every few seconds, then still (reads as "something is waiting")
			local phase = t % WIGGLE_EVERY
			if phase < WIGGLE_TIME then
				local fade = 1 - phase / WIGGLE_TIME
				icon.Rotation = math.sin(phase * 38) * 14 * fade
				badge.Rotation = math.sin(phase * 38 + 1) * 12 * fade
			elseif icon.Rotation ~= 0 then
				icon.Rotation = 0
				badge.Rotation = 0
			end
		end
	end

	local UP = UDim2.new()
	local DOWN = UDim2.fromOffset(0, depth - 1)
	root.MouseEnter:Connect(function()
		TweenService:Create(scale, QUICK, { Scale = 1.07 }):Play()
		if not self.Glowing then
			TweenService:Create(border, QUICK, { Thickness = Theme.Outline + 1.5 }):Play()
			if not self.Attention then
				TweenService:Create(icon, HOVER_WIGGLE, { Rotation = 12 }):Play()
			end
		end
		AudioController.Play("Hover", nil, 0.05)
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, QUICK, { Scale = 1 }):Play()
		TweenService:Create(face, QUICK, { Position = UP }):Play()
		if not self.Glowing then
			TweenService:Create(border, QUICK, { Thickness = Theme.Outline }):Play()
		end
	end)
	if props.Tooltip then
		Tooltip.Attach(root, props.Tooltip.Title, props.Tooltip.Text, props.Tooltip.Beside)
	end
	root.MouseButton1Down:Connect(function()
		TweenService:Create(face, QUICK, { Position = DOWN }):Play()
		TweenService:Create(scale, QUICK, { Scale = 0.96 }):Play()
	end)
	root.MouseButton1Up:Connect(function()
		TweenService:Create(face, SPRING, { Position = UP }):Play()
		TweenService:Create(scale, SPRING, { Scale = 1 }):Play()
	end)
	root.Activated:Connect(function()
		AudioController.Play("Click")
		props.OnClick()
	end)

	root.Parent = props.Parent
	return self :: Tile
end

return HudTile
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="108">
              <Properties>
                <string name="Name">Icon</string>
                <string name="Source"><![CDATA[--!strict
-- Icons from the downloaded 3D icon set (Fluent Emoji 3D by Microsoft, MIT licence; the PNGs are
-- in assets/icons, credits in assets/CREDITS.md). Roblox can only show images uploaded to Roblox,
-- so each icon's content string comes from Config/AssetIds (written by scripts/upload_assets.py).
--
-- Components pass the emoji they always used (Theme.Icons.Wins) or a Theme.Icons key ("Wins").
-- When that icon has an uploaded image, Icon.new makes an ImageLabel with the emoji as a child
-- label that shows until the image has loaded (and stays if it never loads, e.g. still in
-- moderation); otherwise it makes the plain emoji label, exactly as before the upload.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetIds = require(ReplicatedStorage:WaitForChild("Shared").Config.AssetIds)

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)

local Icon = {}

export type IconProps = {
	Icon: string, -- emoji (Theme.Icons.X) or Theme.Icons key
	Parent: Instance?,
	Name: string?,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	ZIndex: number?,
	TextSize: number?, -- emoji fallback max size
	LayoutOrder: number?,
}

local byEmoji: { [string]: string } = {}
for key, emoji in Theme.Icons :: { [string]: string } do
	byEmoji[emoji] = key
	-- the same emoji without the variation selector (U+FE0F), e.g. "⚙" for "⚙️"
	byEmoji[(string.gsub(emoji, "\u{FE0F}", ""))] = key
end

-- Theme.Icons key for an emoji or key, or nil.
function Icon.KeyFor(emojiOrKey: string): string?
	if (Theme.Icons :: { [string]: string })[emojiOrKey] then
		return emojiOrKey
	end
	return byEmoji[emojiOrKey]
end

-- Uploaded image for an emoji or key, or nil.
function Icon.Image(emojiOrKey: string): string?
	local key = Icon.KeyFor(emojiOrKey)
	local content = if key then AssetIds.Icons[key] else nil
	return if content and content ~= "" then content else nil
end

-- The emoji text for an emoji or key.
function Icon.Emoji(emojiOrKey: string): string
	local key = Icon.KeyFor(emojiOrKey)
	return if key then (Theme.Icons :: { [string]: string })[key] else emojiOrKey
end

local function emojiLabel(text: string, size: UDim2, textSize: number?, zIndex: number?): TextLabel
	return Create.Text({
		Name = "Emoji",
		Text = text,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = textSize or 64,
		Scaled = true,
		ZIndex = zIndex,
	})
end

local function watch(image: ImageLabel, fallback: TextLabel)
	local function update()
		fallback.Visible = not image.IsLoaded or image.Image == ""
	end
	update()
	image:GetPropertyChangedSignal("IsLoaded"):Connect(update)
	image:GetPropertyChangedSignal("Image"):Connect(update)
end

function Icon.new(props: IconProps): GuiObject
	local image = Icon.Image(props.Icon)
	local emoji = Icon.Emoji(props.Icon)
	local object: GuiObject
	if image then
		local label: ImageLabel = Create("ImageLabel", {
			BackgroundTransparency = 1,
			Image = image,
			ScaleType = Enum.ScaleType.Fit,
			Size = props.Size,
		})
		local fallback = emojiLabel(emoji, UDim2.fromScale(1, 1), props.TextSize, props.ZIndex)
		fallback.Parent = label
		watch(label, fallback)
		object = label
	else
		object = emojiLabel(emoji, props.Size, props.TextSize, nil)
	end
	object.Name = props.Name or "Icon"
	object.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	object.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	if props.ZIndex then
		object.ZIndex = props.ZIndex
	end
	if props.LayoutOrder then
		object.LayoutOrder = props.LayoutOrder
	end
	object.Parent = props.Parent
	return object
end

-- Changes what an Icon.new object shows (an image icon keeps showing the emoji until loaded).
function Icon.Set(object: GuiObject, emojiOrKey: string)
	local emoji = Icon.Emoji(emojiOrKey)
	if object:IsA("ImageLabel") then
		local fallback = object:FindFirstChild("Emoji") :: TextLabel?
		if fallback then
			fallback.Text = emoji
		end
		object.Image = Icon.Image(emojiOrKey) or ""
	elseif object:IsA("TextLabel") then
		object.Text = emoji
	end
end

return Icon
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="109">
              <Properties>
                <string name="Name">ItemSlot</string>
                <string name="Source"><![CDATA[--!strict
-- Square inventory slot: rarity-coloured border (spinning gradient for Legendary and up, see
-- RarityFx) and glow, a lazily built 3D ViewportFrame preview (or a black silhouette for Index
-- entries not found yet), a name strip, a small stat line, and corner badges (equipped check,
-- lock, quantity).
-- Slots are reused across refreshes (screens key them by uid/id), so previews are built once.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Viewport = require(script.Parent.Viewport)
local RarityFx = require(script.Parent.RarityFx)
local AudioController = require(UI.Parent.Controllers.AudioController)

export type SlotProps = {
	Parent: Instance,
	Name: string?,
	LayoutOrder: number?,
	Rarity: string,
	Build: () -> Model, -- preview model factory (called once, lazily)
	Title: string?,
	Stat: string?,
	OnClick: (() -> ())?,
	Spin: number?,
	Silhouette: boolean?, -- draw the preview as a black shape (undiscovered)
}

export type Slot = {
	Instance: TextButton,
	SetTitle: (Slot, string) -> (),
	SetStat: (Slot, string) -> (),
	SetRarity: (Slot, string) -> (),
	SetCorner: (Slot, string?) -> (), -- top-left badge text (e.g. "✅")
	SetTag: (Slot, string?) -> (), -- top-right badge text (e.g. "🔒", "x3")
	SetSelected: (Slot, boolean) -> (),
	SetDimmed: (Slot, boolean) -> (),
	SetSilhouette: (Slot, boolean) -> (),
	Destroy: (Slot) -> (),
}

local ItemSlot = {}

local POP = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function ItemSlot.new(props: SlotProps): Slot
	local rarityColor = Theme.Rarity(props.Rarity)
	local root: TextButton = Create("TextButton", {
		Name = props.Name or "Slot",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		LayoutOrder = props.LayoutOrder or 0,
		Selectable = true,
	})
	Create.Corner(14, root)
	local gradient = Create.Gradient(root, Theme.RarityLight(props.Rarity):Lerp(Theme.Colors.Card, 0.55), Theme.Colors.CardDeep, 90)
	local stroke = Create.Stroke(root, rarityColor, 3, 0, true)
	RarityFx.Stroke(stroke, props.Rarity)
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local preview: Frame = Create("Frame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(1, -12, 1, -50),
		Parent = root,
	})
	local title = Create.Text({
		Name = "Title",
		Text = props.Title or "",
		Size = UDim2.new(1, -10, 0, 22),
		Position = UDim2.new(0, 5, 1, -44),
		Font = Theme.Fonts.Display,
		TextSize = 20,
		Scaled = true,
		Stroke = 1.8,
		Parent = root,
	})
	local stat = Create.Text({
		Name = "Stat",
		Text = props.Stat or "",
		Size = UDim2.new(1, -10, 0, 20),
		Position = UDim2.new(0, 5, 1, -22),
		Font = Theme.Fonts.Body,
		TextSize = 18,
		Scaled = true,
		Color = Theme.Colors.Skill,
		Stroke = 1.4,
		Parent = root,
	})
	local corner = Create.Text({
		Name = "Corner",
		Text = "",
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.fromOffset(4, 4),
		TextSize = 26,
		Scaled = true,
		Stroke = 1.5,
		ZIndex = 3,
		Parent = root,
	})
	local tag = Create.Text({
		Name = "Tag",
		Text = "",
		Size = UDim2.fromOffset(44, 28),
		Position = UDim2.new(1, -4, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		Font = Theme.Fonts.Display,
		TextSize = 22,
		Scaled = true,
		Stroke = 1.8,
		ZIndex = 3,
		Parent = root,
	})

	local built = false
	local silhouette = props.Silhouette == true
	local viewport: ViewportFrame? = nil
	local function paint()
		if viewport then
			viewport.ImageColor3 = if silhouette then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
			viewport.ImageTransparency = if silhouette then 0.15 else 0
		end
	end
	local function ensurePreview()
		if built then
			return
		end
		built = true
		local ok, model = pcall(props.Build)
		if ok and model then
			viewport = Viewport.Model(preview, model, { Spin = props.Spin or 0.6, Yaw = math.pi, Pitch = math.rad(-10), Zoom = 1.1 })
			paint()
		end
	end
	-- build the preview the first time the slot is actually on screen
	if root.AbsoluteSize.X > 0 then
		ensurePreview()
	else
		local conn: RBXScriptConnection? = nil
		conn = root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if root.AbsoluteSize.X > 0 then
				ensurePreview()
				if conn then
					conn:Disconnect()
				end
			end
		end)
	end

	local self = { Instance = root } :: any
	local rarityNow = props.Rarity

	function self.SetTitle(_: any, text: string)
		title.Text = text
	end
	function self.SetStat(_: any, text: string)
		stat.Text = text
	end
	function self.SetRarity(_: any, rarity: string)
		RarityFx.Stroke(stroke, rarity)
		rarityNow = rarity
		gradient.Color = ColorSequence.new(Theme.RarityLight(rarity):Lerp(Theme.Colors.Card, 0.55), Theme.Colors.CardDeep)
	end
	function self.SetCorner(_: any, text: string?)
		corner.Text = text or ""
	end
	function self.SetTag(_: any, text: string?)
		tag.Text = text or ""
	end
	function self.SetSelected(_: any, selected: boolean)
		stroke.Thickness = if selected then 6 else 3
		RarityFx.SetEnabled(stroke, not selected)
		if selected then
			stroke.Color = Color3.new(1, 1, 1)
		else
			RarityFx.Stroke(stroke, rarityNow)
		end
	end
	function self.SetSilhouette(_: any, on: boolean)
		silhouette = on
		paint()
	end
	function self.SetDimmed(_: any, dimmed: boolean)
		root.BackgroundTransparency = if dimmed then 0.5 else 0
		title.TextTransparency = if dimmed then 0.4 else 0
	end
	function self.Destroy(_: any)
		root:Destroy()
	end

	root.MouseEnter:Connect(function()
		TweenService:Create(scale, POP, { Scale = 1.05 }):Play()
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, POP, { Scale = 1 }):Play()
	end)
	root.Activated:Connect(function()
		AudioController.Play("Click")
		if props.OnClick then
			props.OnClick()
		end
	end)
	root.Parent = props.Parent
	return self :: Slot
end

return ItemSlot
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="110">
              <Properties>
                <string name="Name">MenuCard</string>
                <string name="Source"><![CDATA[--!strict
-- Shop-style offer card: blue gradient face with a coloured border, a glowing emoji plate in the
-- accent colour, a chunky stroked title, an accent subtitle ("+10K Skill"), a wrapped
-- description and a full-width action button pinned to the bottom (>= 60 px tall). A tilted
-- corner badge shows states such as OWNED / BEST VALUE. Fills whatever cell it is parented to.
local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Icon = require(script.Parent.Icon)
local Button = require(script.Parent.Button)

export type CardProps = {
	Parent: Instance,
	Name: string?,
	LayoutOrder: number?,
	Size: UDim2?, -- default fills the grid cell
	Accent: Color3,
	Rainbow: boolean?, -- rainbow border + plate (top-tier offers)
	Icon: string,
	Title: string,
	Subtitle: string?,
	Description: string?,
	ButtonText: string?, -- nil = no action button
	ButtonStyle: string?,
	OnClick: (() -> ())?,
	Compact: boolean?, -- short cells (~196 px): smaller plate, title + subtitle + a 56 px button
}

export type Card = {
	Instance: Frame,
	Button: Button.Button?,
	SetTitle: (Card, string) -> (),
	SetSubtitle: (Card, string) -> (),
	SetDescription: (Card, string) -> (),
	SetIcon: (Card, string) -> (),
	SetBadge: (Card, string?, Color3?) -> (),
	SetAction: (Card, text: string, style: string, enabled: boolean) -> (),
}

local MenuCard = {}

local function shade(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local function tint(c: Color3, f: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), f)
end

function MenuCard.new(props: CardProps): Card
	local accent = props.Accent
	local compact = props.Compact == true
	local plateSize = if compact then 64 else 92
	local titleTop = if compact then 74 else 114
	local titleH = if compact then 30 else 36
	local buttonH = if compact then 56 else 62
	local root: Frame = Create("Frame", {
		Name = props.Name or "Card",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = props.Size or UDim2.fromScale(1, 1),
		LayoutOrder = props.LayoutOrder or 0,
	})
	Create.Corner(16, root)
	Create.Gradient(root, Theme.Colors.Card, Theme.Colors.CardDeep, 90)
	local border = Create.Stroke(root, if props.Rainbow then Color3.new(1, 1, 1) else accent, 3, 0, true)
	if props.Rainbow then
		local g = Instance.new("UIGradient")
		g.Color = Theme.Rainbow
		g.Rotation = 45
		g.Parent = border
	end

	-- accent glow behind the icon
	local glow: Frame = Create("Frame", {
		Name = "Glow",
		BackgroundColor3 = accent,
		Size = UDim2.new(1, 0, 0, if compact then 96 else 130),
		Parent = root,
	})
	Create.Corner(16, glow)
	local glowGradient = Instance.new("UIGradient")
	glowGradient.Rotation = 90
	glowGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	glowGradient.Parent = glow

	local plate: Frame = Create("Frame", {
		Name = "Plate",
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, if compact then 8 else 14),
		Size = UDim2.fromOffset(plateSize, plateSize),
		Rotation = -4,
		Parent = root,
	})
	Create.Corner(22, plate)
	if props.Rainbow then
		local g = Instance.new("UIGradient")
		g.Color = Theme.Rainbow
		g.Rotation = 45
		g.Parent = plate
	else
		Create.Gradient(plate, tint(accent, 0.35), shade(accent, 0.6), 90)
	end
	Create.Stroke(plate, Theme.Colors.Stroke, 3, 0, true)
	local icon = Icon.new({
		Icon = props.Icon,
		Name = "Icon",
		Size = UDim2.fromScale(0.8, 0.8),
		TextSize = 64,
		Parent = plate,
	})
	icon.Rotation = 4

	local title = Create.Text({
		Name = "Title",
		Text = props.Title,
		Position = UDim2.fromOffset(10, titleTop),
		Size = UDim2.new(1, -20, 0, titleH),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		Stroke = 2.6,
		Parent = root,
	})
	local subtitle = Create.Text({
		Name = "Subtitle",
		Text = props.Subtitle or "",
		Position = UDim2.fromOffset(10, titleTop + titleH),
		Size = UDim2.new(1, -20, 0, if compact then 24 else 26),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Color = tint(accent, 0.25),
		Stroke = 2,
		Parent = root,
	})
	subtitle.Visible = (props.Subtitle or "") ~= ""
	local hasButton = props.ButtonText ~= nil
	local descTop = titleTop + titleH + (if subtitle.Visible then 30 else 6)
	local description = Create.Text({
		Name = "Description",
		Text = props.Description or "",
		Position = UDim2.fromOffset(14, descTop),
		Size = UDim2.new(1, -28, 1, -descTop - (if hasButton then buttonH + 22 else 14)),
		Font = Theme.Fonts.Body,
		TextSize = 19,
		Scaled = true,
		Wrapped = true,
		Color = Theme.Colors.TextDim,
		Stroke = 1,
		YAlign = Enum.TextYAlignment.Top,
		Parent = root,
	})

	local action: Button.Button? = nil
	if hasButton then
		action = Button.new({
			Parent = root,
			Name = "Action",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, if compact then -8 else -12),
			Size = UDim2.new(1, -24, 0, buttonH),
			Style = props.ButtonStyle or "Green",
			Shine = true,
			Text = props.ButtonText,
			TextSize = 30,
			Corner = 12,
			OnClick = props.OnClick,
		})
	end

	-- tilted corner badge (OWNED, BEST VALUE, TEST ...)
	local badge: Frame = Create("Frame", {
		Name = "Badge",
		BackgroundColor3 = Theme.Colors.Success,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 8, 0, -8),
		Size = UDim2.fromOffset(126, 36),
		Rotation = 8,
		Visible = false,
		ZIndex = 5,
		Parent = root,
	})
	Create.Corner(10, badge)
	Create.Stroke(badge, Theme.Colors.Stroke, 2.5, 0, true)
	local badgeText = Create.Text({
		Name = "Text",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -10, 1, -6),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Stroke = 2,
		ZIndex = 6,
		Parent = badge,
	})

	root.Parent = props.Parent

	local self = {
		Instance = root,
		Button = action,
	} :: any

	function self.SetTitle(_: any, text: string)
		title.Text = text
	end
	function self.SetSubtitle(_: any, text: string)
		subtitle.Text = text
	end
	function self.SetDescription(_: any, text: string)
		description.Text = text
	end
	function self.SetIcon(_: any, text: string)
		Icon.Set(icon, text)
	end
	function self.SetBadge(_: any, text: string?, color: Color3?)
		if text == nil or text == "" then
			badge.Visible = false
			return
		end
		badge.Visible = true
		badgeText.Text = text
		badge.BackgroundColor3 = color or Theme.Colors.Success
	end
	function self.SetAction(_: any, text: string, style: string, enabled: boolean)
		local b = action
		if b == nil then
			return
		end
		b:SetText(text)
		b:SetStyle(style)
		b:SetEnabled(enabled)
	end

	return self :: Card
end

return MenuCard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="111">
              <Properties>
                <string name="Name">MenuGrid</string>
                <string name="Source"><![CDATA[--!strict
-- Vertical scrolling grid for menu cards. Cell sizes are explicit design pixels (menus know their
-- own widths), the canvas grows automatically, and padding leaves room for tilted card badges
-- and strokes. Gamepad selection inside it scrolls the canvas automatically.
local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)

export type GridProps = {
	Parent: Instance,
	Name: string?,
	Size: UDim2,
	Position: UDim2?,
	Cell: Vector2,
	Gap: number?,
	Inset: number?, -- padding inside the canvas (default 12)
	Center: boolean?,
}

local MenuGrid = {}

MenuGrid.ScrollBar = 10

-- Cell width that fits `columns` cells in `width` design px (scroll bar + insets included).
function MenuGrid.CellWidth(width: number, columns: number, gap: number?, inset: number?): number
	local g = gap or 14
	local pad = inset or 12
	return math.floor((width - MenuGrid.ScrollBar - pad * 2 - g * (columns - 1)) / columns)
end

function MenuGrid.new(props: GridProps): ScrollingFrame
	local inset = props.Inset or 12
	local gap = props.Gap or 14
	local frame: ScrollingFrame = Create("ScrollingFrame", {
		Name = props.Name or "Grid",
		BackgroundTransparency = 1,
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = MenuGrid.ScrollBar,
		ScrollBarImageColor3 = Theme.Colors.PanelEdge,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Selectable = false,
		ClipsDescendants = true,
		Parent = props.Parent,
	})
	Create.Padding(frame, inset, inset)
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(props.Cell.X, props.Cell.Y)
	layout.CellPadding = UDim2.fromOffset(gap, gap)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = if props.Center then Enum.HorizontalAlignment.Center else Enum.HorizontalAlignment.Left
	layout.Parent = frame
	return frame
end

return MenuGrid
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="112">
              <Properties>
                <string name="Name">MenuShell</string>
                <string name="Source"><![CDATA[--!strict
-- Shared shell for the menu screens (Shop, Rebirth, Gifts, Settings, Admin). Builds a Panel in the
-- "Menus" layer and dresses it in the simulator menu style: deep-blue gradient body with faint
-- diagonal stripes, a solid accent header bar (stripes, gloss, dark divider), coloured inner edge
-- and a chunky emoji + display-font title with a heavy stroke and a white-to-gold gradient. On open
-- the cards in the menu's grids pop in one after another. It implements
-- the UIController Screen contract (Open/Close/IsOpen), keeps gamepad selection inside the panel,
-- closes on gamepad B and forwards L1/R1 (or Q/E) to OnShoulder for tab cycling.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Panel = require(script.Parent.Panel)
local Pattern = require(script.Parent.Pattern)
local Icon = require(script.Parent.Icon)
local UIController = require(UI.Parent.Controllers.UIController)

export type ShellProps = {
	Name: string, -- UIController screen name
	Title: string,
	Icon: string?,
	Size: Vector2, -- design pixels (keep <= 1300 x 760); the height shrinks on short screens
	MinHeight: number?, -- shortest design height the content still works at (default 520)
	OnResize: ((contentHeight: number) -> ())?, -- the content height changed (short screens)
	Accent: Color3?,
	OnOpen: ((...any) -> ())?, -- refresh content; receives UIController.Open's extra args
	OnClose: (() -> ())?,
	OnShoulder: ((number) -> ())?, -- -1 / +1 (L1/R1, Q/E)
	FirstSelection: (() -> GuiObject?)?, -- gamepad focus target when opened
}

export type Shell = {
	Panel: Panel.Panel,
	Body: Frame,
	Content: Frame,
	Name: string,
	Session: number, -- bumped on every open so per-open loops can tell they are stale
	Open: (Shell, ...any) -> (),
	Close: (Shell) -> (),
	IsOpen: (Shell) -> boolean,
	SetTitle: (Shell, string) -> (), -- the title text; the shell keeps its icon
}

local MenuShell = {}

local GAMEPAD_INPUTS: { [Enum.UserInputType]: boolean } = {
	[Enum.UserInputType.Gamepad1] = true,
	[Enum.UserInputType.Gamepad2] = true,
	[Enum.UserInputType.Gamepad3] = true,
	[Enum.UserInputType.Gamepad4] = true,
}

-- True when the player is currently driving the UI with a controller.
function MenuShell.UsingGamepad(): boolean
	return GAMEPAD_INPUTS[UserInputService:GetLastInputType()] == true
end

-- Darkens a colour (for gradient bottoms).
function MenuShell.Shade(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local POP_STAGGER = 0.03
local POP_MAX = 30

local function shownWithin(obj: Instance, root: Instance): boolean
	local node: Instance? = obj
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return node == root
end

-- Pops the cards of every visible grid under `root` in one after another (Back easing), the
-- genre's staggered entrance. Reuses a card's own UIScale when it has one.
function MenuShell.PopIn(root: Instance)
	local n = 0
	for _, layout in root:GetDescendants() do
		if not layout:IsA("UIGridLayout") then
			continue
		end
		local container = layout.Parent
		if container == nil or not shownWithin(container, root) then
			continue
		end
		local items: { GuiObject } = {}
		for _, child in container:GetChildren() do
			if child:IsA("GuiObject") and child.Visible then
				table.insert(items, child)
			end
		end
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for _, item in items do
			n += 1
			if n > POP_MAX then
				return
			end
			local scale = item:FindFirstChildOfClass("UIScale")
			if scale == nil then
				local created = Instance.new("UIScale")
				created.Parent = item
				scale = created
			end
			local s = scale :: UIScale
			s.Scale = 0.55
			TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, (n - 1) * POP_STAGGER), { Scale = 1 }):Play()
		end
	end
end

function MenuShell.new(props: ShellProps): Shell
	local accent = props.Accent or Theme.Colors.PanelEdge
	-- an uploaded icon image sits left of the title; an emoji icon stays inline in the text
	local iconImage = if props.Icon then Icon.Image(props.Icon) else nil
	local function titleText(text: string): string
		return (if props.Icon and not iconImage then props.Icon .. " " else "") .. text
	end
	local panel = Panel.new({
		Parent = UIController.Layer("Menus"),
		Name = props.Name,
		Title = titleText(string.upper(props.Title)),
		Size = props.Size,
		MinHeight = props.MinHeight,
		OnResize = props.OnResize,
		TitleSize = 56,
		Border = Theme.Colors.PanelBorder,
		OnClose = function()
			UIController.Close(props.Name)
		end,
	})
	local body = panel.Body
	local holder = body.Parent :: Frame

	-- deep-blue vertical gradient body with rounder corners
	body.BackgroundColor3 = Color3.new(1, 1, 1)
	body.BackgroundTransparency = 0
	Create.Gradient(body, Theme.Colors.PanelLight, Theme.Colors.PanelDeep, 90)
	local shadow: Instance = holder:FindFirstChild("Shadow") or body
	for _, frame in { body :: Instance, shadow } do
		local corner = frame:FindFirstChildOfClass("UICorner")
		if corner then
			corner.CornerRadius = UDim.new(0, 18)
		end
	end
	local outer = body:FindFirstChildOfClass("UIStroke")
	if outer then
		outer.Thickness = 4
	end
	-- solid accent header bar: rounded top (the body's corner), square bottom, gloss, dark divider
	local HEADER = 74 -- + 4 px divider = the panel's content top (title 56 + 22)
	-- faint stripes over the whole body (under everything else)
	Pattern.Stripes(body, 0.045, 18, 0)
	local header: Frame = Create("Frame", {
		Name = "Header",
		BackgroundColor3 = accent,
		Size = UDim2.new(1, 0, 0, HEADER),
		ZIndex = 1,
		Parent = body,
	})
	Create.Corner(18, header)
	Create("Frame", {
		Name = "Square",
		BackgroundColor3 = accent,
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 20),
		Parent = header,
	})
	local gloss: Frame = Create("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		Position = UDim2.fromOffset(8, 5),
		Size = UDim2.new(1, -16, 0, HEADER * 0.42),
		ZIndex = 2,
		Parent = header,
	})
	Create.Corner(12, gloss)
	Pattern.Stripes(header, 0.12, 18, 2)
	Create("Frame", {
		Name = "Shade",
		BackgroundColor3 = MenuShell.Shade(accent, 0.6),
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 8),
		ZIndex = 2,
		Parent = header,
	})
	Create("Frame", {
		Name = "Divider",
		BackgroundColor3 = Theme.Colors.Stroke,
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 4),
		ZIndex = 2,
		Parent = header,
	})
	-- bright inner edge
	local edge: Frame = Create("Frame", {
		Name = "Edge",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.new(1, -10, 1, -10),
		ZIndex = 2,
		Parent = body,
	})
	Create.Corner(14, edge)
	Create.Stroke(edge, accent, 2, 0.35, true)
	panel.Content.ZIndex = 2
	local title = panel.Title
	if title then
		title.Size = UDim2.new(0.6, 0, 0, 58)
		title.Position = UDim2.fromOffset(if iconImage then 94 else 26, 9)
		title.ZIndex = 2
		if props.Icon and iconImage then
			Icon.new({
				Icon = props.Icon,
				Name = "TitleIcon",
				Size = UDim2.fromOffset(64, 64),
				Position = UDim2.fromOffset(22, 5),
				AnchorPoint = Vector2.zero,
				ZIndex = 3,
				Parent = body,
			})
		end
		Create.Gradient(title, Color3.new(1, 1, 1), Color3.fromHex("#FFE48A"), 90)
		local stroke = title:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = 4.5
			stroke.Color = Theme.Colors.Stroke
		end
	end

	-- gamepad navigation stays inside the panel (close button included: it lives on the holder)
	holder.SelectionGroup = true
	holder.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
	holder.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
	holder.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
	holder.SelectionBehaviorRight = Enum.SelectionBehavior.Stop

	local self = {
		Panel = panel,
		Body = body,
		Content = panel.Content,
		Name = props.Name,
		Session = 0,
	} :: any

	local actionName = "SkyGlideMenu_" .. props.Name
	local function onAction(_: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
		if state ~= Enum.UserInputState.Begin or UserInputService:GetFocusedTextBox() ~= nil then
			return Enum.ContextActionResult.Pass
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.ButtonB then
			UIController.Close(props.Name)
			return Enum.ContextActionResult.Sink
		end
		if props.OnShoulder then
			if key == Enum.KeyCode.ButtonL1 or key == Enum.KeyCode.Q then
				props.OnShoulder(-1)
				return Enum.ContextActionResult.Sink
			elseif key == Enum.KeyCode.ButtonR1 or key == Enum.KeyCode.E then
				props.OnShoulder(1)
				return Enum.ContextActionResult.Sink
			end
		end
		return Enum.ContextActionResult.Pass
	end

	function self.IsOpen(_: any): boolean
		return panel.Visible
	end

	function self.SetTitle(_: any, text: string)
		panel:SetTitle(titleText(text))
	end

	function self.Open(this: any, ...: any)
		this.Session += 1
		if props.OnOpen then
			props.OnOpen(...)
		end
		panel:Open()
		MenuShell.PopIn(panel.Content)
		local keys = { Enum.KeyCode.ButtonB }
		if props.OnShoulder then
			table.insert(keys, Enum.KeyCode.ButtonL1)
			table.insert(keys, Enum.KeyCode.ButtonR1)
			table.insert(keys, Enum.KeyCode.Q)
			table.insert(keys, Enum.KeyCode.E)
		end
		ContextActionService:BindActionAtPriority(actionName, onAction, false, Enum.ContextActionPriority.High.Value, table.unpack(keys))
		if MenuShell.UsingGamepad() then
			local target = if props.FirstSelection then props.FirstSelection() else nil
			if target == nil then
				target = holder:FindFirstChild("Close") :: GuiObject?
			end
			GuiService.SelectedObject = target
		end
	end

	function self.Close(this: any)
		this.Session += 1
		ContextActionService:UnbindAction(actionName)
		local selected = GuiService.SelectedObject
		if selected and selected:IsDescendantOf(panel.Root) then
			GuiService.SelectedObject = nil
		end
		panel:Close()
		if props.OnClose then
			props.OnClose()
		end
	end

	return self :: Shell
end

return MenuShell
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="113">
              <Properties>
                <string name="Name">MenuTabs</string>
                <string name="Source"><![CDATA[--!strict
-- Horizontal tab bar for menus: one chunky Button per tab, the selected tab lights up in the
-- active style and grows slightly. Select() fires OnChanged; Cycle() steps left/right (used by
-- the shell's L1/R1 and Q/E bindings). Every tab is gamepad-selectable and >= 60 px tall.
local TweenService = game:GetService("TweenService")

local Components = script.Parent
local Create = require(Components.Parent.Create)
local Button = require(Components.Button)
local Icon = require(Components.Icon)

export type TabSpec = { Key: string, Text: string, Icon: string?, Style: string? }

export type TabsProps = {
	Parent: Instance,
	Tabs: { TabSpec },
	Size: UDim2,
	Position: UDim2?,
	TabWidth: number?,
	OnChanged: (key: string) -> (),
}

export type Tabs = {
	Instance: Frame,
	Selected: string,
	Buttons: { [string]: Button.Button },
	Select: (Tabs, key: string, silent: boolean?) -> (),
	Cycle: (Tabs, direction: number) -> (),
}

local MenuTabs = {}

local GROW = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

function MenuTabs.new(props: TabsProps): Tabs
	local bar: Frame = Create("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		Parent = props.Parent,
	})
	Create.List(bar, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

	local self = {
		Instance = bar,
		Selected = "",
		Buttons = {},
	} :: any
	local order: { string } = {}
	local scales: { [string]: UIScale } = {}

	for i, spec in props.Tabs do
		local key = spec.Key
		table.insert(order, key)
		local holder: Frame = Create("Frame", {
			Name = key,
			BackgroundTransparency = 1,
			Size = UDim2.new(0, props.TabWidth or 210, 1, 0),
			LayoutOrder = i,
			Parent = bar,
		})
		local scale = Instance.new("UIScale")
		scale.Scale = 0.94
		scale.Parent = holder
		scales[key] = scale
		-- an uploaded icon image sits left of the text; an emoji icon stays inline
		local image = if spec.Icon then Icon.Image(spec.Icon) else nil
		local b = Button.new({
			Parent = holder,
			Name = "Tab",
			Size = UDim2.fromScale(1, 1),
			Style = "Dark",
			Text = (if spec.Icon and not image then spec.Icon .. " " else "") .. spec.Text,
			TextSize = 30,
			Corner = 12,
			OnClick = function()
				self:Select(key)
			end,
		})
		if spec.Icon and image then
			Icon.new({
				Icon = spec.Icon,
				Size = UDim2.fromScale(0.78, 0.78),
				Position = UDim2.new(0, 10, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				ZIndex = b.Label.ZIndex,
				Parent = b.Content,
			})
			local aspect = Instance.new("UIAspectRatioConstraint")
			aspect.Parent = b.Content:FindFirstChild("Icon")
			b.Label.Size = UDim2.new(1, -66, 1, -6)
			b.Label.Position = UDim2.new(0.5, 26, 0.5, 0)
		end
		self.Buttons[key] = b
	end

	local styles: { [string]: string } = {}
	for _, spec in props.Tabs do
		styles[spec.Key] = spec.Style or "Blue"
	end

	function self.Select(this: any, key: string, silent: boolean?)
		if this.Buttons[key] == nil then
			return
		end
		local changed = this.Selected ~= key
		this.Selected = key
		for k, b in this.Buttons :: { [string]: Button.Button } do
			local on = k == key
			b:SetStyle(if on then styles[k] else "Dark")
			TweenService:Create(scales[k], GROW, { Scale = if on then 1 else 0.94 }):Play()
		end
		if changed and not silent then
			props.OnChanged(key)
		end
	end

	function self.Cycle(this: any, direction: number)
		local index = table.find(order, this.Selected) or 1
		local nextIndex = (index - 1 + direction) % #order + 1
		this:Select(order[nextIndex])
	end

	return self :: Tabs
end

return MenuTabs
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="114">
              <Properties>
                <string name="Name">MenuToggle</string>
                <string name="Source"><![CDATA[--!strict
-- ON/OFF pill switch for settings: green gradient track when on, grey when off, a white knob that
-- slides across, and a stroked ON/OFF label. Clicking flips it and calls OnChanged; Set() updates
-- it from data without firing. Gamepad-selectable, 60 px tall by default.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local AudioController = require(UI.Parent.Controllers.AudioController)

export type ToggleProps = {
	Parent: Instance,
	Name: string?,
	Value: boolean,
	Size: Vector2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	OnChanged: (boolean) -> (),
}

export type Toggle = {
	Instance: TextButton,
	Value: boolean,
	Set: (Toggle, boolean) -> (),
}

local MenuToggle = {}

local SLIDE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ON = Theme.Buttons.Green
local OFF = Theme.Buttons.Disabled

function MenuToggle.new(props: ToggleProps): Toggle
	local size = props.Size or Vector2.new(140, 62)
	local root: TextButton = Create("TextButton", {
		Name = props.Name or "Toggle",
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		LayoutOrder = props.LayoutOrder or 0,
	})
	Create.Round(root)
	local gradient = Create.Gradient(root, ON.Top, ON.Bottom, 90)
	local border = Create.Stroke(root, ON.Border, 3, 0, true)

	local knobSize = size.Y - 12
	local knob: Frame = Create("Frame", {
		Name = "Knob",
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(knobSize, knobSize),
		Position = UDim2.new(0, 6, 0.5, 0),
		ZIndex = 3,
		Parent = root,
	})
	Create.Round(knob)
	Create.Gradient(knob, Color3.new(1, 1, 1), Color3.fromHex("#D6DEEA"), 90)
	Create.Stroke(knob, Theme.Colors.Stroke, 2.5, 0, true)
	local label = Create.Text({
		Name = "Label",
		Text = "ON",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -knobSize - 24, 0.62, 0),
		Position = UDim2.new(0, 12, 0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 28,
		Scaled = true,
		Stroke = 2.2,
		ZIndex = 2,
		Parent = root,
	})

	local self = {
		Instance = root,
		Value = props.Value,
	} :: any

	local function render(animate: boolean)
		local on = self.Value
		local style = if on then ON else OFF
		gradient.Color = ColorSequence.new(style.Top, style.Bottom)
		border.Color = style.Border
		label.Text = if on then "ON" else "OFF"
		label.Position = if on then UDim2.new(0, 12, 0.5, 0) else UDim2.new(0, knobSize + 12, 0.5, 0)
		local target = if on then UDim2.new(1, -knobSize - 6, 0.5, 0) else UDim2.new(0, 6, 0.5, 0)
		if animate then
			TweenService:Create(knob, SLIDE, { Position = target }):Play()
		else
			knob.Position = target
		end
	end

	function self.Set(this: any, value: boolean)
		if this.Value == value then
			return
		end
		this.Value = value
		render(true)
	end

	root.Activated:Connect(function()
		self.Value = not self.Value
		render(true)
		AudioController.Play("Click")
		props.OnChanged(self.Value)
	end)

	render(false)
	root.Parent = props.Parent
	return self :: Toggle
end

return MenuToggle
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="115">
              <Properties>
                <string name="Name">Panel</string>
                <string name="Source"><![CDATA[--!strict
-- Modal panel in the reference style: dark navy body on a soft drop shadow, thin bright border,
-- big display-font title, red close key breaking out of the top-right corner, pop-in animation.
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Button = require(script.Parent.Button)
local AudioController = require(UI.Parent.Controllers.AudioController)
local UIController = require(UI.Parent.Controllers.UIController)

export type PanelProps = {
	Parent: Instance,
	Name: string,
	Title: string?,
	Size: Vector2, -- design pixels (the height may shrink on short screens, see fit())
	MinHeight: number?, -- shortest design height the content still works at (default 520)
	OnResize: ((contentHeight: number) -> ())?, -- the panel height changed (screens re-layout)
	OnClose: (() -> ())?,
	TitleSize: number?,
	Border: Color3?,
}

export type Panel = {
	Root: Frame, -- full-screen dimmer + holder
	Body: Frame,
	Content: Frame,
	Title: TextLabel?,
	Visible: boolean,
	Open: (Panel) -> (),
	Close: (Panel) -> (),
	SetTitle: (Panel, string) -> (),
}

local Panel = {}

local POP = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Panel.new(props: PanelProps): Panel
	local root: Frame = Create("Frame", {
		Name = props.Name,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Active = true,
		Parent = props.Parent,
	})
	local holder: Frame = Create("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(props.Size.X, props.Size.Y),
		Parent = root,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = holder
	-- Fits the panel to the screen. Wide, short screens (phones in landscape) would shrink a tall
	-- panel until everything in it is tiny, so there the panel gets shorter instead (content
	-- scrolls) and keeps the scale the width allows; touch screens may also grow a little.
	local minHeight = math.min(props.Size.Y, props.MinHeight or 520)
	local contentTop = 16
	local lastHeight = props.Size.Y
	local function fit(): number
		local screen = root.AbsoluteSize
		local s = math.max(UIController.Scale, 0.01)
		if screen.X <= 0 or screen.Y <= 0 then
			return 1
		end
		local grow = if UserInputService.TouchEnabled then 1.15 else 1
		local byWidth = math.min(grow, screen.X * 0.97 / (props.Size.X * s))
		local height = math.clamp(screen.Y * 0.95 / (s * byWidth), minHeight, props.Size.Y)
		holder.Size = UDim2.fromOffset(props.Size.X, height)
		if height ~= lastHeight then
			lastHeight = height
			if props.OnResize then
				props.OnResize(height - contentTop - 16)
			end
		end
		return math.min(byWidth, screen.Y * 0.95 / (height * s))
	end
	local shadow: Frame = Create("Frame", {
		Name = "Shadow",
		BackgroundColor3 = Theme.Shadow.Color,
		BackgroundTransparency = Theme.Shadow.Transparency,
		Position = UDim2.fromOffset(0, Theme.Shadow.Offset),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Parent = holder,
	})
	Create.Corner(4, shadow)
	local body: Frame = Create("Frame", {
		Name = "Body",
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.04,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = holder,
	})
	Create.Corner(4, body)
	Create.Stroke(body, props.Border or Theme.Colors.PanelBorder, 2, 0, true)

	local title: TextLabel? = nil
	if props.Title then
		title = Create.Text({
			Name = "Title",
			Text = props.Title,
			Size = UDim2.new(0.45, 0, 0, props.TitleSize or 58),
			Position = UDim2.fromOffset(24, 10),
			Font = Theme.Fonts.Display,
			TextSize = props.TitleSize or 58,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2,
			Parent = body,
		})
		contentTop = (props.TitleSize or 58) + 22
	end
	local content: Frame = Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, contentTop),
		Size = UDim2.new(1, -36, 1, -contentTop - 16),
		Parent = body,
	})

	local self = {
		Root = root,
		Body = body,
		Content = content,
		Title = title,
		Visible = false,
	} :: any

	function self.Open(this: any)
		if this.Visible then
			return
		end
		this.Visible = true
		root.Visible = true
		local target = fit()
		scale.Scale = 0.86 * target
		root.BackgroundTransparency = 1
		TweenService:Create(scale, POP, { Scale = target }):Play()
		TweenService:Create(root, FADE, { BackgroundTransparency = 0.55 }):Play()
		AudioController.Play("Open")
	end
	function self.Close(this: any)
		if not this.Visible then
			return
		end
		this.Visible = false
		AudioController.Play("Close")
		local t = TweenService:Create(scale, FADE, { Scale = 0.9 * fit() })
		TweenService:Create(root, FADE, { BackgroundTransparency = 1 }):Play()
		t:Play()
		t.Completed:Once(function()
			if not this.Visible then
				root.Visible = false
			end
		end)
	end
	function self.SetTitle(_: any, text: string)
		if title then
			title.Text = text
		end
	end

	UIController.ScaleChanged:Connect(function()
		if self.Visible then
			scale.Scale = fit()
		end
	end)

	if props.OnClose then
		local onClose = props.OnClose
		Button.Close(holder, function()
			onClose()
		end, UDim2.new(1, -4, 0, 4), if UserInputService.TouchEnabled then 84 else 62)
	end
	return self :: Panel
end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="116">
              <Properties>
                <string name="Name">Pattern</string>
                <string name="Source"><![CDATA[--!strict
-- Subtle diagonal stripes for panel backgrounds and header bars (the genre's patterned panels),
-- drawn without images: one white overlay whose UIGradient transparency alternates between clear
-- and faint, rotated. A UIGradient holds at most 20 keypoints, so one overlay draws up to 9 soft
-- stripes. Pure decoration: it sits under the panel's content and takes no input.
local Pattern = {}

-- `strength` is how opaque the stripes get (0.04 is a hint, 0.12 is clearly visible).
function Pattern.Stripes(parent: GuiObject, strength: number, corner: number, zIndex: number?, bands: number?): Frame
	local overlay = Instance.new("Frame")
	overlay.Name = "Pattern"
	overlay.BackgroundColor3 = Color3.new(1, 1, 1)
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = zIndex or 1
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, corner)
	c.Parent = overlay
	local n = math.clamp(bands or 9, 1, 9)
	local points = {}
	for i = 0, 2 * n do
		table.insert(points, NumberSequenceKeypoint.new(i / (2 * n), if i % 2 == 0 then 1 else 1 - strength))
	end
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 35
	gradient.Transparency = NumberSequence.new(points)
	gradient.Parent = overlay
	overlay.Parent = parent
	return overlay
end

return Pattern
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="117">
              <Properties>
                <string name="Name">RarityFx</string>
                <string name="Source"><![CDATA[--!strict
-- Rarity outlines in the genre's style: plain rarity-coloured strokes for the low tiers, and for
-- Legendary and up a gradient stroke that spins around the item (gold for Legendary, rainbow for
-- Mythic and Secret). The spin is a native looping tween, so it costs no script time per frame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Rarity = require(ReplicatedStorage:WaitForChild("Shared").Config.Rarity)

local UI = script.Parent.Parent
local Theme = require(UI.Theme)

local RarityFx = {}

local SPIN = TweenInfo.new(2.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1)
local LEGENDARY = Rarity.Order("Legendary")
local MYTHIC = Rarity.Order("Mythic")

-- True when the tier gets the animated outline.
function RarityFx.Animated(rarity: string): boolean
	return Rarity.Order(rarity) >= LEGENDARY
end

local function sequence(rarity: string): ColorSequence
	if Rarity.Order(rarity) >= MYTHIC then
		return Theme.Rainbow
	end
	local light, color, dark = Theme.RarityLight(rarity), Theme.Rarity(rarity), Theme.RarityDark(rarity)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, light),
		ColorSequenceKeypoint.new(0.3, color),
		ColorSequenceKeypoint.new(0.5, dark),
		ColorSequenceKeypoint.new(0.7, color),
		ColorSequenceKeypoint.new(1, light),
	})
end

-- Styles `stroke` for `rarity` (call again when the rarity changes).
function RarityFx.Stroke(stroke: UIStroke, rarity: string)
	local gradient = stroke:FindFirstChild("RarityGradient") :: UIGradient?
	if not RarityFx.Animated(rarity) then
		stroke.Color = Theme.Rarity(rarity)
		if gradient then
			gradient:Destroy()
		end
		return
	end
	stroke.Color = Color3.new(1, 1, 1) -- the gradient supplies the colour
	if gradient == nil then
		local g = Instance.new("UIGradient")
		g.Name = "RarityGradient"
		g.Parent = stroke
		TweenService:Create(g, SPIN, { Rotation = 360 }):Play()
		gradient = g
	end
	(gradient :: UIGradient).Color = sequence(rarity)
end

-- Turns the animated outline off and on (e.g. while the item shows a selection outline).
function RarityFx.SetEnabled(stroke: UIStroke, enabled: boolean)
	local gradient = stroke:FindFirstChild("RarityGradient") :: UIGradient?
	if gradient then
		gradient.Enabled = enabled
	end
end

return RarityFx
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="118">
              <Properties>
                <string name="Name">Rays</string>
                <string name="Source"><![CDATA[--!strict
-- Sunburst behind big rewards (hatch reveals, special landings): long beams through the centre,
-- bright in the middle and fading toward their tips, alternating wide and thin, slowly spinning.
-- Purely decorative; Show/Hide fade it.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Create = require(UI.Create)

export type Rays = {
	Instance: Frame,
	Show: (Rays, Color3, number?) -> (),
	Hide: (Rays) -> (),
}

local Rays = {}

local FADE = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SPIN = TweenInfo.new(16, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1)
local BEAM = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.18, 0.75),
	NumberSequenceKeypoint.new(0.5, 0.2),
	NumberSequenceKeypoint.new(0.82, 0.75),
	NumberSequenceKeypoint.new(1, 1),
})

-- `size` is the beam length (design px); `beams` full-length beams give 2x as many rays.
function Rays.new(parent: Instance, size: number, beams: number?, zIndex: number?, position: UDim2?): Rays
	local holder: Frame = Create("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	local n = beams or 8
	local list: { Frame } = {}
	for i = 1, n do
		local wide = i % 2 == 1
		local beam: Frame = Create("Frame", {
			Name = "Beam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, size * (if wide then 0.1 else 0.05)),
			Rotation = (i - 1) * 180 / n,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			ZIndex = zIndex or 1,
			Parent = holder,
		})
		Create.Round(beam)
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = BEAM
		gradient.Parent = beam
		table.insert(list, beam)
	end

	local self = { Instance = holder } :: any
	local spin: Tween? = nil

	-- `strength` 0..1 (default 1): how solid the beams get.
	function self.Show(_: any, color: Color3, strength: number?)
		local alpha = 1 - 0.75 * math.clamp(strength or 1, 0, 1)
		holder.Visible = true
		for _, beam in list do
			beam.BackgroundColor3 = color
			beam.BackgroundTransparency = 1
			TweenService:Create(beam, FADE, { BackgroundTransparency = alpha }):Play()
		end
		if spin == nil then
			holder.Rotation = 0
			local tween = TweenService:Create(holder, SPIN, { Rotation = 360 })
			tween:Play()
			spin = tween
		end
	end

	function self.Hide(_: any)
		if spin then
			spin:Cancel()
			spin = nil
		end
		holder.Visible = false
	end

	return self :: Rays
end

return Rays
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="119">
              <Properties>
                <string name="Name">RewardFly</string>
                <string name="Source"><![CDATA[--!strict
-- "Rewards fly into the counter", the genre's payout feedback: a burst of reward icons pops out
-- around a start point, then each one arcs into a target GuiObject (e.g. the Wins counter). The
-- first arrival calls onArrive (bump the counter); every arrival ticks a coin sound. Icons are
-- pooled Components/Icon objects (3D icon images, emoji until uploaded) in an "FxRewards" frame on
-- the Toasts layer, so the burst also plays above open menus.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Create = require(UI.Create)
local UIController = require(UI.Parent.Controllers.UIController)
local AudioController = require(UI.Parent.Controllers.AudioController)
local Icon = require(script.Parent.Icon)

local RewardFly = {}

local POOL = 12
local SIZE = 54
local POP_TIME = 0.28
local FLY_TIME = 0.5
local STAGGER = 0.05
-- When the first icon lands (counters start rolling up then).
RewardFly.ArriveTime = POP_TIME + FLY_TIME

local POP = TweenInfo.new(POP_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local FLY = TweenInfo.new(FLY_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local pool: { GuiObject } = {}
local free: { GuiObject } = {}
local rng = Random.new()

local holder: Frame? = nil
local function layer(): Frame?
	local current = holder
	if current and current.Parent then
		return current
	end
	local toasts: Frame? = UIController.Layer("Toasts") -- nil until UIController.Init
	if toasts == nil then
		return nil
	end
	local fx: Frame = Create("Frame", {
		Name = "FxRewards",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
		Parent = toasts,
	})
	holder = fx
	return fx
end

-- Centre of a GuiObject in the layer's design pixels.
local function centreOf(gui: GuiObject, root: Frame): Vector2
	local s = math.max(UIController.Scale, 0.01)
	return (gui.AbsolutePosition + gui.AbsoluteSize / 2 - root.AbsolutePosition) / s
end

local function take(root: Frame, icon: string): GuiObject?
	local reused = table.remove(free)
	if reused then
		Icon.Set(reused, icon)
		return reused
	end
	if #pool >= POOL then
		return nil
	end
	local label = Icon.new({
		Icon = icon,
		Name = "RewardIcon",
		Size = UDim2.fromOffset(SIZE, SIZE),
		TextSize = SIZE,
		Parent = root,
	})
	table.insert(pool, label)
	return label
end

-- Flies `count` icons (max 12) from `from` (a GuiObject, or the screen centre) into `to`.
function RewardFly.Burst(icon: string, from: GuiObject?, to: GuiObject, count: number, onArrive: (() -> ())?)
	local root = layer()
	if root == nil or root.AbsoluteSize.X <= 0 then
		if onArrive then
			onArrive()
		end
		return
	end
	local s = math.max(UIController.Scale, 0.01)
	local start = if from and from.Visible then centreOf(from, root) else root.AbsoluteSize / (2 * s)
	local goal = centreOf(to, root)
	local arrived = false
	for i = 1, math.clamp(count, 1, POOL) do
		local label = take(root, icon)
		if label == nil then
			break
		end
		local angle = rng:NextNumber(0, math.pi * 2)
		local spread = Vector2.new(math.cos(angle), math.sin(angle)) * rng:NextNumber(60, 150)
		local burst = start + spread
		label.Rotation = rng:NextNumber(-25, 25)
		label.Size = UDim2.fromOffset(SIZE * 0.4, SIZE * 0.4)
		label.Position = UDim2.fromOffset(start.X, start.Y)
		label.Visible = true
		TweenService:Create(label, POP, { Position = UDim2.fromOffset(burst.X, burst.Y), Size = UDim2.fromOffset(SIZE, SIZE) }):Play()
		task.delay(POP_TIME + (i - 1) * STAGGER, function()
			local fly = TweenService:Create(label, FLY, {
				Position = UDim2.fromOffset(goal.X, goal.Y),
				Size = UDim2.fromOffset(SIZE * 0.6, SIZE * 0.6),
				Rotation = 0,
			})
			fly:Play()
			fly.Completed:Once(function()
				label.Visible = false
				table.insert(free, label)
				AudioController.Play("Coin", nil, 0.04)
				if not arrived then
					arrived = true
					if onArrive then
						onArrive()
					end
				end
			end)
		end)
	end
end

return RewardFly
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="120">
              <Properties>
                <string name="Name">Shine</string>
                <string name="Source"><![CDATA[--!strict
-- Glint sweep for calls to action (buy / hatch / claim buttons, offer tiles): a white overlay whose
-- UIGradient is transparent except for one bright diagonal band, swept across by tweening the
-- gradient Offset every few seconds. One shared scheduler drives every shine, each starting at a
-- random phase so the screen never glints in lockstep. Overlays that leave the game are dropped.
local TweenService = game:GetService("TweenService")

local Shine = {}

type Entry = { Gradient: UIGradient, Overlay: Frame, Period: number, Next: number }

local SWEEP = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local BAND = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.36, 1),
	NumberSequenceKeypoint.new(0.46, 0.6),
	NumberSequenceKeypoint.new(0.5, 0.3),
	NumberSequenceKeypoint.new(0.54, 0.6),
	NumberSequenceKeypoint.new(0.64, 1),
	NumberSequenceKeypoint.new(1, 1),
})
local START = Vector2.new(-1, 0) -- band left of the face
local FINISH = Vector2.new(1, 0) -- band right of the face (also the resting state)

local entries: { Entry } = {}
local running = false
local rng = Random.new()

local function loop()
	while #entries > 0 do
		local now = os.clock()
		for i = #entries, 1, -1 do
			local e = entries[i]
			if e.Overlay.Parent == nil then
				table.remove(entries, i)
			elseif now >= e.Next then
				e.Next = now + e.Period
				if e.Overlay.Visible then
					e.Gradient.Offset = START
					TweenService:Create(e.Gradient, SWEEP, { Offset = FINISH }):Play()
				end
			end
		end
		task.wait(0.25)
	end
	running = false
end

-- Puts a shine overlay on `face`, above its background and gloss; give it a ZIndex below the
-- face's text. `corner` should match the face's rounding. Returns the overlay (hide it to pause).
function Shine.Add(face: GuiObject, corner: UDim, zIndex: number, period: number?): Frame
	local overlay = Instance.new("Frame")
	overlay.Name = "Shine"
	overlay.BackgroundColor3 = Color3.new(1, 1, 1)
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = zIndex
	local c = Instance.new("UICorner")
	c.CornerRadius = corner
	c.Parent = overlay
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 20
	gradient.Transparency = BAND
	gradient.Offset = FINISH
	gradient.Parent = overlay
	overlay.Parent = face
	local p = period or 3.4
	table.insert(entries, { Gradient = gradient, Overlay = overlay, Period = p, Next = os.clock() + rng:NextNumber(0.4, p) })
	if not running then
		running = true
		task.spawn(loop)
	end
	return overlay
end

return Shine
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="121">
              <Properties>
                <string name="Name">Tooltip</string>
                <string name="Source"><![CDATA[--!strict
-- Hover tooltips for HUD buttons (mouse and gamepad selection; touch has no hover): a small
-- raised dark card with a gold title and one line of help, placed beside the target (or beside a
-- container such as the whole menu column, so it never covers the neighbouring buttons) on the
-- side with more room. One shared card on the Toasts layer, so it shows above everything; opening a
-- menu hides it.
local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local UIController = require(UI.Parent.Controllers.UIController)

local Tooltip = {}

local WIDTH, HEIGHT = 300, 84
local GAP = 14

local card: Frame? = nil
local titleLabel: TextLabel
local bodyLabel: TextLabel
local owner: GuiObject? = nil

local function ensure(): Frame?
	local current = card
	if current and current.Parent then
		return current
	end
	local layer: Frame? = UIController.Layer("Toasts")
	if layer == nil then
		return nil
	end
	local frame: Frame = Create("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.04,
		Size = UDim2.fromOffset(WIDTH, HEIGHT),
		Visible = false,
		ZIndex = 50,
		Parent = layer,
	})
	Create.Corner(14, frame)
	Create.Stroke(frame, Theme.Colors.Stroke, Theme.Outline, 0, true)
	Create.Gradient(frame, Theme.Colors.PanelLight, Theme.Colors.PanelDeep, 90)
	titleLabel = Create.Text({
		Name = "Title",
		Text = "",
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.fromOffset(12, 8),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Color = Theme.Colors.Skill,
		Stroke = 2.2,
		ZIndex = 51,
		Parent = frame,
	})
	bodyLabel = Create.Text({
		Name = "Body",
		Text = "",
		Size = UDim2.new(1, -24, 0, 36),
		Position = UDim2.fromOffset(12, 40),
		Font = Theme.Fonts.Body,
		TextSize = 19,
		Scaled = true,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Left,
		YAlign = Enum.TextYAlignment.Top,
		Stroke = 1.4,
		ZIndex = 51,
		Parent = frame,
	})
	card = frame
	UIController.ScreenOpened:Connect(function()
		Tooltip.Hide()
	end)
	return frame
end

local function show(target: GuiObject, title: string, body: string, beside: GuiObject?)
	local frame = ensure()
	if frame == nil then
		return
	end
	local root = frame.Parent :: Frame
	local s = math.max(UIController.Scale, 0.01)
	local pos = (target.AbsolutePosition - root.AbsolutePosition) / s
	local size = target.AbsoluteSize / s
	local box = beside or target
	local boxPos = (box.AbsolutePosition - root.AbsolutePosition) / s
	local boxSize = box.AbsoluteSize / s
	local screen = root.AbsoluteSize / s
	local rightSide = boxPos.X + boxSize.X / 2 < screen.X / 2
	local x = if rightSide then boxPos.X + boxSize.X + GAP else boxPos.X - GAP - WIDTH
	local y = math.clamp(pos.Y + size.Y / 2 - HEIGHT / 2, 8, math.max(8, screen.Y - HEIGHT - 8))
	frame.Position = UDim2.fromOffset(x, y)
	titleLabel.Text = title
	bodyLabel.Text = body
	frame.Visible = true
	owner = target
end

function Tooltip.Hide()
	owner = nil
	if card then
		card.Visible = false
	end
end

-- Shows `title` / `body` beside `target` (or beside `beside`) while the mouse is over it or a
-- gamepad selects it.
function Tooltip.Attach(target: GuiObject, title: string, body: string, beside: GuiObject?)
	target.MouseEnter:Connect(function()
		if UserInputService.MouseEnabled then
			show(target, title, body, beside)
		end
	end)
	target.MouseLeave:Connect(function()
		if owner == target then
			Tooltip.Hide()
		end
	end)
	target.SelectionGained:Connect(function()
		show(target, title, body, beside)
	end)
	target.SelectionLost:Connect(function()
		if owner == target then
			Tooltip.Hide()
		end
	end)
	target.AncestryChanged:Connect(function()
		if owner == target and not target:IsDescendantOf(game) then
			Tooltip.Hide()
		end
	end)
end

return Tooltip
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="122">
              <Properties>
                <string name="Name">Viewport</string>
                <string name="Source"><![CDATA[--!strict
-- ViewportFrame previews of part-built models (gacha machine, crates, flyers). Optional slow
-- spin driven by one shared RenderStepped loop that only touches visible viewports.
local RunService = game:GetService("RunService")

local UI = script.Parent.Parent
local Create = require(UI.Create)

local Viewport = {}

type Entry = { vp: ViewportFrame, model: Model, base: CFrame, speed: number, angle: number }
local spinning: { Entry } = {}
local running = false

local function ensureLoop()
	if running then
		return
	end
	running = true
	RunService.RenderStepped:Connect(function(dt: number)
		for i = #spinning, 1, -1 do
			local e = spinning[i]
			if e.vp.Parent == nil then
				table.remove(spinning, i)
			elseif e.vp.Visible and e.vp:FindFirstAncestorWhichIsA("LayerCollector") then
				e.angle += dt * e.speed
				e.model:PivotTo(e.base * CFrame.Angles(0, e.angle, 0))
			end
		end
	end)
end

export type Options = {
	Spin: number?, -- radians/second
	Yaw: number?, -- initial yaw (radians)
	Pitch: number?, -- camera pitch (radians)
	Fov: number?,
	Zoom: number?, -- >1 = further away
	ZIndex: number?,
	Name: string?,
	Ambient: Color3?,
}

function Viewport.Model(parent: Instance, model: Model, opts: Options?): ViewportFrame
	local o: Options = opts or {}
	local vp: ViewportFrame = Create("ViewportFrame", {
		Name = o.Name or "Viewport",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = o.Ambient or Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.6, -1, -0.8),
		ZIndex = o.ZIndex or 1,
		Parent = parent,
	})
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local cframe, size = model:GetBoundingBox()
	local base = CFrame.new(-cframe.Position) * model:GetPivot()
	model:PivotTo(base * CFrame.Angles(0, o.Yaw or 0, 0))
	model.Parent = world
	local camera = Instance.new("Camera")
	camera.FieldOfView = o.Fov or 30
	local radius = size.Magnitude / 2
	local dist = radius / math.tan(math.rad(camera.FieldOfView / 2)) * (o.Zoom or 1.05)
	local pitch = o.Pitch or math.rad(-12)
	local dir = (CFrame.Angles(0, 0, 0) * CFrame.Angles(pitch, 0, 0)).LookVector
	camera.CFrame = CFrame.lookAt(-dir * dist, Vector3.zero)
	camera.Parent = vp
	vp.CurrentCamera = camera
	if o.Spin and o.Spin ~= 0 then
		table.insert(spinning, { vp = vp, model = model, base = base, speed = o.Spin, angle = o.Yaw or 0 })
		ensureLoop()
	end
	return vp
end

return Viewport
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Create</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny declarative instance builder used by every screen.
--   Create("Frame", { Size = ..., Parent = ... , [Create.Children] = {...} })
-- Function values are connected when the key names an event (e.g. Activated = fn).
local Theme = require(script.Parent.Theme)

local Create = {}
Create.Children = newproxy(false)

local function apply(inst: Instance, props: { [any]: any })
	local parent = nil
	for key, value in props do
		if key == Create.Children then
			for _, child in value do
				child.Parent = inst
			end
		elseif key == "Parent" then
			parent = value
		elseif type(value) == "function" then
			local ok, signal = pcall(function()
				return (inst :: any)[key]
			end)
			if ok and typeof(signal) == "RBXScriptSignal" then
				(signal :: RBXScriptSignal):Connect(value)
			else
				error("Create: " .. tostring(key) .. " is not an event of " .. inst.ClassName)
			end
		else
			(inst :: any)[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
end

local function new(className: string, props: { [any]: any }?): any
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: GuiObject).BorderSizePixel = 0
	end
	if props then
		apply(inst, props)
	end
	return inst
end

setmetatable(Create, {
	__call = function(_, className: string, props: { [any]: any }?): any
		return new(className, props)
	end,
})

Create.New = new
Create.Apply = apply

function Create.Corner(radius: number | UDim, parent: Instance?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = if typeof(radius) == "UDim" then radius :: UDim else UDim.new(0, radius :: number)
	c.Parent = parent
	return c
end

function Create.Round(parent: Instance?): UICorner
	return Create.Corner(UDim.new(0.5, 0), parent)
end

function Create.Stroke(parent: Instance?, color: Color3?, thickness: number?, transparency: number?, border: boolean?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.Stroke
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	if border then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	s.Parent = parent
	return s
end

function Create.Gradient(parent: Instance?, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Create.Padding(parent: Instance?, px: number, py: number?): UIPadding
	local p = Instance.new("UIPadding")
	local y = py or px
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, y)
	p.PaddingBottom = UDim.new(0, y)
	p.Parent = parent
	return p
end

function Create.List(parent: Instance?, direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding or 0)
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = vAlign or Enum.VerticalAlignment.Top
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = parent
	return l
end

function Create.Aspect(parent: Instance?, ratio: number): UIAspectRatioConstraint
	local a = Instance.new("UIAspectRatioConstraint")
	a.AspectRatio = ratio
	a.Parent = parent
	return a
end

export type TextProps = {
	Text: string,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Font: Font?,
	TextSize: number?,
	Scaled: boolean?,
	Color: Color3?,
	Stroke: number?,
	StrokeColor: Color3?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Parent: Instance?,
	Name: string?,
	ZIndex: number?,
	LayoutOrder: number?,
	RichText: boolean?,
	Wrapped: boolean?,
}

-- Text in the reference style: bold face, white, dark rounded stroke.
function Create.Text(p: TextProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = p.Name or "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = p.Size
	label.Position = p.Position or UDim2.new()
	label.AnchorPoint = p.AnchorPoint or Vector2.zero
	label.FontFace = p.Font or Theme.Fonts.Body
	label.Text = p.Text
	label.TextColor3 = p.Color or Theme.Colors.Text
	label.TextXAlignment = p.XAlign or Enum.TextXAlignment.Center
	label.TextYAlignment = p.YAlign or Enum.TextYAlignment.Center
	label.RichText = p.RichText == true
	label.TextWrapped = p.Wrapped == true
	if p.Scaled then
		label.TextScaled = true
		if p.TextSize then
			local c = Instance.new("UITextSizeConstraint")
			c.MaxTextSize = p.TextSize
			c.Parent = label
		end
	else
		label.TextSize = p.TextSize or 24
	end
	if p.ZIndex then
		label.ZIndex = p.ZIndex
	end
	if p.LayoutOrder then
		label.LayoutOrder = p.LayoutOrder
	end
	if (p.Stroke or 0) > 0 then
		Create.Stroke(label, p.StrokeColor, p.Stroke)
	end
	label.Parent = p.Parent
	return label
end

return Create
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="124">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="125">
              <Properties>
                <string name="Name">AdminScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Admin / diagnostics menu ("Admin"). Only reachable for allow-listed admins (Data.IsAdmin; the
-- HUD only shows its tile then). Every action is an AdminRequest that the server re-checks
-- against Config/Admin, so a normal player can never use it even by firing the remote directly.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)

local AdminScreen = {}

local PANEL = Vector2.new(1160, 680)

type Action = { Text: string, Style: string, Action: string, Arg: any? }

local SECTIONS: { { Title: string, Actions: { Action } } } = {
	{
		Title = "GRANTS",
		Actions = {
			{ Text = "+1M Skill", Style = "Gold", Action = "GrantSkill", Arg = 1e6 },
			{ Text = "+1B Skill", Style = "Gold", Action = "GrantSkill", Arg = 1e9 },
			{ Text = "+1M Wins", Style = "Green", Action = "GrantWins", Arg = 1e6 },
			{ Text = "+1B Wins", Style = "Green", Action = "GrantWins", Arg = 1e9 },
		},
	},
	{
		Title = "PROGRESS",
		Actions = {
			{ Text = "Max Level", Style = "Blue", Action = "MaxLevel" },
			{ Text = "Unlock Worlds", Style = "Purple", Action = "UnlockWorlds" },
			{ Text = "Reset Tutorial", Style = "Orange", Action = "ResetTutorial" },
		},
	},
	{
		Title = "LIVE EVENT",
		Actions = {
			{ Text = "Start (30 min)", Style = "Pink", Action = "StartEvent", Arg = 30 },
			{ Text = "Stop Event", Style = "Red", Action = "StopEvent" },
		},
	},
}

local shell: MenuShell.Shell
local statsLabel: TextLabel
local eventLabel: TextLabel
local refreshButton: Button.Button

local function refreshStats()
	local result = Net.Invoke("AdminRequest", true, "Stats")
	if result.ok and type(result.stats) == "table" then
		local s = result.stats
		statsLabel.Text = string.format(
			"Players: %s\nActive flights: %s\nServer memory: %s MB\nHeartbeat: %s fps\nData store: %s",
			tostring(s.Players),
			tostring(s.Flights),
			tostring(s.MemoryMB),
			tostring(s.Heartbeat),
			if s.MockData then "IN-MEMORY MOCK (no API access)" else "DataStore"
		)
	else
		statsLabel.Text = "Not allowed."
	end
	local event = StateController.Event
	if event.Active then
		eventLabel.Text = string.format("%s active · ends in %s", event.Name, Format.Clock(event.EndsAt - Workspace:GetServerTimeNow()))
	else
		eventLabel.Text = "No live event running."
	end
end

function AdminScreen.Init()
	shell = MenuShell.new({
		Name = "Admin",
		Title = "Admin / Diagnostics",
		Icon = "🛠️",
		Size = PANEL,
		MinHeight = PANEL.Y, -- stacked sections; a developer tool, so no compact layout
		Accent = Theme.Colors.Danger,
		OnOpen = function()
			local data = StateController.Data
			if not (data and data.IsAdmin) then
				task.defer(UIController.Close, "Admin")
				return
			end
			task.spawn(refreshStats)
		end,
		FirstSelection = function()
			return refreshButton.Instance
		end,
	})
	local content = shell.Content

	local statsCard: Frame = Create("Frame", {
		Name = "Stats",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Size = UDim2.new(0.4, -8, 1, 0),
		Parent = content,
	})
	Create.Corner(14, statsCard)
	Create.Stroke(statsCard, Theme.Colors.PanelEdge, 2, 0.4, true)
	Create.Text({
		Text = "SERVER",
		Size = UDim2.new(1, -24, 0, 36),
		Position = UDim2.fromOffset(12, 10),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		Parent = statsCard,
	})
	statsLabel = Create.Text({
		Text = "...",
		Size = UDim2.new(1, -24, 0, 220),
		Position = UDim2.fromOffset(12, 56),
		Font = Theme.Fonts.Body,
		TextSize = 24,
		XAlign = Enum.TextXAlignment.Left,
		YAlign = Enum.TextYAlignment.Top,
		Wrapped = true,
		Stroke = 1.2,
		Parent = statsCard,
	})
	eventLabel = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 60),
		Position = UDim2.fromOffset(12, 290),
		Font = Theme.Fonts.Body,
		TextSize = 22,
		Color = Theme.Colors.Rebirth,
		XAlign = Enum.TextXAlignment.Left,
		YAlign = Enum.TextYAlignment.Top,
		Wrapped = true,
		Stroke = 1.2,
		Parent = statsCard,
	})
	refreshButton = Button.new({
		Parent = statsCard,
		Name = "Refresh",
		Size = UDim2.new(1, -24, 0, 62),
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Blue",
		Text = "Refresh",
		TextSize = 26,
		OnClick = function()
			task.spawn(refreshStats)
		end,
	})

	local actions: Frame = Create("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		Size = UDim2.new(0.6, -8, 1, 0),
		Position = UDim2.new(0.4, 8, 0, 0),
		Parent = content,
	})
	Create.List(actions, Enum.FillDirection.Vertical, 12)
	for i, section in SECTIONS do
		local box: Frame = Create("Frame", {
			Name = section.Title,
			BackgroundColor3 = Theme.Colors.Card,
			Size = UDim2.new(1, 0, 0, 160),
			LayoutOrder = i,
			Parent = actions,
		})
		Create.Corner(14, box)
		Create.Stroke(box, Theme.Colors.PanelBorder, 2, 0, true)
		Create.Text({
			Text = section.Title,
			Size = UDim2.new(1, -24, 0, 32),
			Position = UDim2.fromOffset(12, 8),
			Font = Theme.Fonts.Display,
			TextSize = 28,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2,
			Parent = box,
		})
		local row: Frame = Create("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 56),
			Size = UDim2.new(1, -24, 0, 70),
			Parent = box,
		})
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.new(1 / #section.Actions, -10, 0, 66)
		layout.CellPadding = UDim2.fromOffset(10, 0)
		layout.Parent = row
		for j, action in section.Actions do
			Button.new({
				Parent = row,
				Name = action.Action .. j,
				Size = UDim2.fromOffset(100, 66),
				LayoutOrder = j,
				Style = action.Style,
				Text = action.Text,
				TextSize = 22,
				OnClick = function()
					task.spawn(function()
						local result = Net.Invoke("AdminRequest", false, action.Action, action.Arg)
						if result.ok then
							UIController.Toast("Admin: " .. action.Text, "Success")
						end
						refreshStats()
					end)
				end,
			})
		end
	end

	UIController.Register("Admin", shell)
end

return AdminScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="126">
              <Properties>
                <string name="Name">EggScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Egg menu ("Egg") + hatch reveal. UIController.Open("Egg", eggId) shows the egg, its price and
-- the live odds (Eggs.Odds with the player's Luck), with Hatch 1 / Hatch 3 (Triple Hatch pass) or a
-- Robux button for premium eggs. Hatching is decided on the server; the HatchResult event drives a
-- reveal in the Overlay layer: egg wobble -> crack flash -> pet with a rarity glow. Results that
-- arrive while a reveal is playing are queued. Gifts (payload.Egg == "") skip the egg stage.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared.Definitions.Eggs)
local Pets = require(Shared.Definitions.Pets)
local Monetization = require(Shared.Config.Monetization)
local Rarity = require(Shared.Config.Rarity)
local Remotes = require(Shared.Net.Remotes)
local Format = require(Shared.Util.Format)
local PetFactory = require(Shared.Visual.PetFactory)
local EggFactory = require(Shared.Visual.EggFactory)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)
local Bus = require(Client.Controllers.Bus)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)
local Viewport = require(Components.Viewport)
local Rays = require(Components.Rays)
local RarityFx = require(Components.RarityFx)

local EggScreen = {}

local IS_STUDIO = RunService:IsStudio()
local PANEL = Vector2.new(1120, 700)
local LEFT_W = 380

local shell: MenuShell.Shell
local currentEgg: Eggs.Egg? = nil
local eggPreview: Frame
local eggName: TextLabel
local eggPrice: TextLabel
local hatchOne: Button.Button
local hatchThree: Button.Button
local luckLabel: TextLabel
local oddsHolder: Frame
local oddsLists: { [string]: { Frame: ScrollingFrame, Chances: { [string]: TextLabel } } } = {}
local previewEggId: string? = nil

local function shortChance(p: number): string
	local pct = p * 100
	if pct >= 10 then
		return string.format("%.1f%%", pct)
	elseif pct >= 0.1 then
		return string.format("%.2f%%", pct)
	end
	return string.format("%.3f%%", pct)
end

local function luck(): number
	local derived = StateController.Derived()
	return if type(derived.Luck) == "number" then derived.Luck else 1
end

local function oddsFor(egg: Eggs.Egg)
	local cached = oddsLists[egg.Id]
	if cached then
		return cached
	end
	local list: ScrollingFrame = Create("ScrollingFrame", {
		Name = "Odds_" .. egg.Id,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Colors.PanelEdge,
		Visible = false,
		Selectable = false,
		Parent = oddsHolder,
	})
	Create.List(list, Enum.FillDirection.Vertical, 8)
	Create.Padding(list, 6, 6)
	local chances: { [string]: TextLabel } = {}
	for i, entry in egg.Pets do
		local pet = Pets.Get(entry.Pet)
		if not pet then
			continue
		end
		local row: Frame = Create("Frame", {
			Name = entry.Pet,
			BackgroundColor3 = Theme.Colors.Card,
			Size = UDim2.new(1, -16, 0, 96),
			LayoutOrder = i,
			Parent = list,
		})
		Create.Corner(12, row)
		RarityFx.Stroke(Create.Stroke(row, Theme.Rarity(pet.Rarity), 3, 0, true), pet.Rarity)
		local preview: Frame = Create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(90, 90),
			Position = UDim2.fromOffset(4, 3),
			Parent = row,
		})
		local petId = entry.Pet
		task.defer(function()
			Viewport.Model(preview, PetFactory.ForId(petId, 2), { Spin = 0.5, Yaw = math.pi, Pitch = math.rad(-8) })
		end)
		Create.Text({
			Text = pet.Name,
			Size = UDim2.new(1, -260, 0, 34),
			Position = UDim2.fromOffset(102, 10),
			Font = Theme.Fonts.Display,
			TextSize = 30,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2,
			Parent = row,
		})
		Create.Text({
			Text = string.format("%s  ·  x%s Skill", string.upper(pet.Rarity), Format.Short(1 + pet.SkillBoost)),
			Size = UDim2.new(1, -260, 0, 28),
			Position = UDim2.fromOffset(102, 52),
			Font = Theme.Fonts.Body,
			TextSize = 24,
			Scaled = true,
			Color = Theme.Rarity(pet.Rarity),
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 1.6,
			Parent = row,
		})
		chances[entry.Pet] = Create.Text({
			Text = "",
			Size = UDim2.fromOffset(140, 44),
			Position = UDim2.new(1, -16, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Font = Theme.Fonts.Numbers,
			TextSize = 36,
			Scaled = true,
			Color = Theme.Colors.Skill,
			XAlign = Enum.TextXAlignment.Right,
			Stroke = 2.4,
			Parent = row,
		})
	end
	local entry = { Frame = list, Chances = chances }
	oddsLists[egg.Id] = entry
	return entry
end

local function priceAction(egg: Eggs.Egg): (string, string, boolean)
	local product = if egg.ProductKey then Monetization.Product(egg.ProductKey) else nil
	if product then
		if product.Id == 0 and not IS_STUDIO then
			return "SOON", "Disabled", false
		end
		return string.format("BUY %s %d", Theme.Icons.Robux, product.Robux), "Green", true
	end
	return "HATCH 1", "Green", true
end

-- Left column stacked from the bottom so it fits any panel height: hatch buttons, luck, price,
-- name, and the egg preview takes what is left. Short panels put the buttons side by side.
local function layoutLeft(compact: boolean)
	local buttons = if compact then 82 else 164
	if compact then
		hatchOne.Instance.Size = UDim2.new(0.5, -18, 0, 70)
		hatchOne.Instance.Position = UDim2.new(0, 12, 1, -12)
		hatchThree.Instance.Size = UDim2.new(0.5, -18, 0, 70)
		hatchThree.Instance.Position = UDim2.new(0.5, 6, 1, -12)
	else
		hatchOne.Instance.Size = UDim2.new(1, -24, 0, 70)
		hatchOne.Instance.Position = UDim2.new(0, 12, 1, -94)
		hatchThree.Instance.Size = UDim2.new(1, -24, 0, 70)
		hatchThree.Instance.Position = UDim2.new(0, 12, 1, -12)
	end
	luckLabel.AnchorPoint = Vector2.new(0, 1)
	luckLabel.Position = UDim2.new(0, 12, 1, -(buttons + 6))
	eggPrice.AnchorPoint = Vector2.new(0, 1)
	eggPrice.Position = UDim2.new(0, 12, 1, -(buttons + 6 + 28 + 4))
	eggName.AnchorPoint = Vector2.new(0, 1)
	eggName.Position = UDim2.new(0, 12, 1, -(buttons + 6 + 28 + 4 + 36 + 4))
	eggPreview.Size = UDim2.new(1, -60, 1, -(buttons + 6 + 28 + 4 + 36 + 4 + 42 + 16))
end

local function refresh()
	local egg = currentEgg
	local data = StateController.Data
	if egg == nil or data == nil then
		return
	end
	local l = luck()
	local odds = oddsFor(egg)
	for _, other in oddsLists do
		other.Frame.Visible = other == odds
	end
	for _, entry in Eggs.Odds(egg, l) do
		local label = odds.Chances[entry.Pet]
		if label then
			label.Text = shortChance(entry.Chance)
		end
	end
	luckLabel.Text = if l > 1 then string.format("%s LUCK x%s ACTIVE", Theme.Icons.Luck, Format.Short(l)) else ""
	eggName.Text = egg.Name
	if egg.ProductKey then
		local product = Monetization.Product(egg.ProductKey)
		eggPrice.Text = if product then string.format("%s %d per egg", Theme.Icons.Robux, product.Robux) else ""
		local text, style, enabled = priceAction(egg)
		hatchOne:SetText(text)
		hatchOne:SetStyle(style)
		hatchOne:SetEnabled(enabled)
		hatchThree.Instance.Visible = false
	else
		local wins = if type(data.Wins) == "number" then data.Wins else 0
		eggPrice.Text = string.format("%s %s Wins", Theme.Icons.Wins, Format.Short(egg.Price))
		eggPrice.TextColor3 = if wins >= egg.Price then Theme.Colors.Text else Theme.Colors.Danger
		hatchOne:SetText("HATCH 1")
		hatchOne:SetStyle("Green")
		hatchOne:SetEnabled(true)
		hatchThree.Instance.Visible = true
		if StateController.HasPass("TripleHatch") then
			hatchThree:SetText("HATCH 3")
			hatchThree:SetStyle("Purple")
		else
			hatchThree:SetText(Theme.Icons.Lock .. " HATCH 3")
			hatchThree:SetStyle("Grey")
		end
		hatchThree:SetEnabled(true)
	end
	if previewEggId ~= egg.Id then
		eggPreview:ClearAllChildren()
		previewEggId = egg.Id
		Viewport.Model(eggPreview, EggFactory.ForId(egg.Id, 6), { Spin = 0.7, Yaw = math.pi, Pitch = math.rad(-6) })
	end
end

local function hatch(count: number)
	local egg = currentEgg
	if egg == nil then
		return
	end
	if egg.ProductKey then
		task.spawn(Net.Invoke, "RequestPurchase", false, "Product", egg.ProductKey)
		return
	end
	if count == 3 and not StateController.HasPass("TripleHatch") then
		task.spawn(Net.Invoke, "RequestPurchase", false, "Pass", "TripleHatch")
		return
	end
	task.spawn(Net.Invoke, "RequestHatchEgg", false, egg.Id, count)
end

-- Hatch reveal ------------------------------------------------------------------------------------

type HatchPayload = { Egg: string, Pets: { { Uid: string, Id: string, New: boolean? } }, Source: string? }

local overlay: TextButton
local stage: Frame
local subtitle: TextLabel
local hint: TextLabel
local stageScale: UIScale

-- The stage (up to 540 design px tall) sits between the title (ends ~140) and the hint (starts
-- ~110 from the bottom); short screens (phones) scale it down to fit that space.
local function fitStage()
	local designHeight = overlay.AbsoluteSize.Y / math.max(UIController.Scale, 0.01)
	if designHeight <= 0 then
		return
	end
	local space = designHeight - 250
	stageScale.Scale = math.clamp(space / 540, 0.4, 1)
	stage.Position = UDim2.new(0.5, 0, 0, 140 + space / 2)
end
local queue: { HatchPayload } = {}
local playing = false
local dismissable = false
local dismissSignal: BindableEvent

local function clearStage()
	for _, child in stage:GetChildren() do
		if child:IsA("GuiObject") then -- keeps the list layout and the fit scale
			child:Destroy()
		end
	end
end

local function revealCard(payload: HatchPayload, pet: Pets.Pet, petId: string, width: number, isNew: boolean)
	local card: Frame = Create("Frame", {
		Name = "Reveal",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 520),
		Parent = stage,
	})
	local glow: Frame = Create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(width * 0.95, width * 0.95),
		BackgroundColor3 = Theme.Rarity(pet.Rarity),
		BackgroundTransparency = 1,
		Parent = card,
	})
	Create.Round(glow)
	local rays = Rays.new(card, width * 1.2, 8, nil, UDim2.fromScale(0.5, 0.42))
	local view: Frame = Create("Frame", {
		Name = "View",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(width * 0.85, width * 0.85),
		BackgroundTransparency = 1,
		Parent = card,
	})
	local name = Create.Text({
		Text = pet.Name,
		Size = UDim2.new(1, 0, 0, 52),
		Position = UDim2.new(0, 0, 1, -118),
		Font = Theme.Fonts.Display,
		TextSize = 46,
		Scaled = true,
		Stroke = 3.5,
		Parent = card,
	})
	local info = Create.Text({
		Text = string.format("%s  ·  x%s Skill", string.upper(pet.Rarity), Format.Short(1 + pet.SkillBoost)),
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, -62),
		Font = Theme.Fonts.Display,
		TextSize = 34,
		Scaled = true,
		Color = Theme.Rarity(pet.Rarity),
		Stroke = 3,
		Parent = card,
	})
	name.TextTransparency = 1
	info.TextTransparency = 1
	-- first of its kind: a tilted "NEW!" badge (the pet joins the Index)
	local newBadge: Frame? = nil
	if isNew then
		local badge: Frame = Create("Frame", {
			Name = "NewBadge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, width * 0.3, 0, 40),
			Size = UDim2.fromOffset(150, 52),
			Rotation = 10,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Visible = false,
			ZIndex = 5,
			Parent = card,
		})
		Create.Corner(14, badge)
		Create.Gradient(badge, Color3.fromHex("#FFE27A"), Color3.fromHex("#F07800"), 90)
		Create.Stroke(badge, Theme.Colors.Stroke, 3.5, 0, true)
		Create.Text({
			Name = "Text",
			Text = "NEW!",
			Size = UDim2.new(1, -16, 1, -10),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Font = Theme.Fonts.Display,
			TextSize = 38,
			Scaled = true,
			Stroke = 3,
			ZIndex = 6,
			Parent = badge,
		})
		newBadge = badge
	end
	return {
		NewBadge = newBadge,
		Card = card,
		View = view,
		Glow = glow,
		Rays = rays,
		Name = name,
		Info = info,
		PetId = petId,
		Pet = pet,
		EggId = payload.Egg,
	}
end

local function play(payload: HatchPayload)
	playing = true
	dismissable = false
	clearStage()
	overlay.Visible = true
	fitStage()
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.25), { BackgroundTransparency = 0.35 }):Play()
	local egg = Eggs.Get(payload.Egg)
	subtitle.Text = if egg then egg.Name else (payload.Source or "Reward")
	hint.Text = ""

	local count = math.max(1, #payload.Pets)
	local width = if count >= 3 then 340 else 420
	local cards = {}
	local bestOrder = 0
	for _, result in payload.Pets do
		local pet = Pets.Get(result.Id)
		if pet then
			table.insert(cards, revealCard(payload, pet, result.Id, width, result.New == true))
			bestOrder = math.max(bestOrder, Rarity.Order(pet.Rarity))
		end
	end

	-- egg wobble (skipped for gifts / starter packs)
	if egg then
		for _, c in cards do
			Viewport.Model(c.View, EggFactory.ForId(egg.Id, 6), { Yaw = math.pi, Pitch = math.rad(-6) })
		end
		for i = 1, 3 do
			AudioController.Play("EggShake")
			for _, c in cards do
				local angle = if i % 2 == 0 then -14 - i * 3 else 14 + i * 3
				TweenService:Create(c.View, TweenInfo.new(0.14, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true), { Rotation = angle }):Play()
			end
			task.wait(0.34)
		end
		AudioController.Play("EggCrack")
	end

	-- crack flash -> pets
	local flash: Frame = Create("Frame", {
		Name = "Flash",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = overlay,
	})
	TweenService:Create(flash, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
	task.delay(0.5, function()
		flash:Destroy()
	end)
	for _, c in cards do
		c.View:ClearAllChildren()
		c.View.Rotation = 0
		Viewport.Model(c.View, PetFactory.ForId(c.PetId, 3), { Spin = 0.9, Yaw = math.pi, Pitch = math.rad(-8) })
		local scale = Instance.new("UIScale")
		scale.Scale = 0.3
		scale.Parent = c.View
		TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		TweenService:Create(c.Glow, TweenInfo.new(0.4), { BackgroundTransparency = 0.55 }):Play()
		c.Rays:Show(Theme.RarityLight(c.Pet.Rarity), if Rarity.Order(c.Pet.Rarity) >= 4 then 1 else 0.6)
		TweenService:Create(c.Name, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
		local badge = c.NewBadge
		if badge then
			badge.Visible = true
			local pop = Instance.new("UIScale")
			pop.Scale = 0
			pop.Parent = badge
			TweenService:Create(pop, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.3), { Scale = 1 }):Play()
		end
		TweenService:Create(c.Info, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
	end
	if bestOrder >= Rarity.Order("Legendary") then
		AudioController.Play("RareHatch")
	else
		AudioController.Play("Reward")
	end
	task.wait(0.6)
	hint.Text = if UserInputService.GamepadEnabled then "Press A to continue" else "Tap to continue"
	dismissable = true
	dismissSignal.Event:Wait()
	TweenService:Create(overlay, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
	task.wait(0.2)
	clearStage()
	overlay.Visible = false
	playing = false
	local nextPayload = table.remove(queue, 1)
	if nextPayload then
		play(nextPayload)
	end
end

local function enqueue(payload: HatchPayload)
	if playing then
		table.insert(queue, payload)
	else
		task.spawn(play, payload)
	end
end

local function buildOverlay()
	overlay = Create("TextButton", {
		Name = "HatchReveal",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = UIController.Layer("Overlay"),
	})
	dismissSignal = Instance.new("BindableEvent")
	overlay.Activated:Connect(function()
		if dismissable then
			dismissable = false
			dismissSignal:Fire()
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if overlay.Visible and dismissable and (input.KeyCode == Enum.KeyCode.ButtonA or input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Space) then
			dismissable = false
			dismissSignal:Fire()
		end
	end)
	subtitle = Create.Text({
		Text = "",
		Size = UDim2.fromOffset(900, 60),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.Fonts.Display,
		TextSize = 54,
		Scaled = true,
		Stroke = 4,
		Parent = overlay,
	})
	stage = Create("Frame", {
		Name = "Stage",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(1200, 540),
		Parent = overlay,
	})
	Create.List(stage, Enum.FillDirection.Horizontal, 24, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	stageScale = Instance.new("UIScale")
	stageScale.Parent = stage
	UIController.ScaleChanged:Connect(function()
		if overlay.Visible then
			fitStage()
		end
	end)
	hint = Create.Text({
		Text = "",
		Size = UDim2.fromOffset(600, 40),
		Position = UDim2.new(0.5, 0, 1, -60),
		AnchorPoint = Vector2.new(0.5, 1),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		Stroke = 2.5,
		Parent = overlay,
	})
end

function EggScreen.Init()
	shell = MenuShell.new({
		Name = "Egg",
		Title = "Egg",
		Icon = Theme.Icons.Egg,
		Size = PANEL,
		Accent = Theme.Colors.Skill,
		OnResize = function(contentHeight: number)
			layoutLeft(contentHeight < 560)
		end,
		OnOpen = function(eggId: any)
			if type(eggId) == "string" and Eggs.Get(eggId) then
				currentEgg = Eggs.Get(eggId)
			end
			if currentEgg then
				shell:SetTitle(string.upper(currentEgg.Name))
			end
			refresh()
		end,
		FirstSelection = function()
			return hatchOne.Instance
		end,
	})
	local content = shell.Content
	local left: Frame = Create("Frame", {
		Name = "Left",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Size = UDim2.new(0, LEFT_W, 1, 0),
		Parent = content,
	})
	Create.Corner(16, left)
	Create.Stroke(left, Theme.Colors.PanelEdge, 2, 0.4, true)
	eggPreview = Create("Frame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(30, 8),
		Size = UDim2.new(1, -60, 0, 250),
		Parent = left,
	})
	eggName = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 42),
		Position = UDim2.fromOffset(12, 262),
		Font = Theme.Fonts.Display,
		TextSize = 38,
		Scaled = true,
		Stroke = 3,
		Parent = left,
	})
	eggPrice = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 36),
		Position = UDim2.fromOffset(12, 308),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		Stroke = 2.5,
		Parent = left,
	})
	luckLabel = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 28),
		Position = UDim2.fromOffset(12, 350),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Color = Theme.Colors.Success,
		Stroke = 2,
		Parent = left,
	})
	hatchOne = Button.new({
		Parent = left,
		Name = "HatchOne",
		Size = UDim2.new(1, -24, 0, 70),
		Position = UDim2.new(0, 12, 1, -94),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Green",
		Shine = true,
		Text = "HATCH 1",
		TextSize = 30,
		OnClick = function()
			hatch(1)
		end,
	})
	hatchThree = Button.new({
		Parent = left,
		Name = "HatchThree",
		Size = UDim2.new(1, -24, 0, 70),
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Purple",
		Shine = true,
		Text = "HATCH 3",
		TextSize = 30,
		OnClick = function()
			hatch(3)
		end,
	})
	layoutLeft(false)
	local right: Frame = Create("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(LEFT_W + 16, 0),
		Size = UDim2.new(1, -(LEFT_W + 16), 1, 0),
		Parent = content,
	})
	Create.Text({
		Text = "CHANCES",
		Size = UDim2.new(1, 0, 0, 36),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		Parent = right,
	})
	oddsHolder = Create("Frame", {
		Name = "Odds",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
		Parent = right,
	})

	buildOverlay()
	UIController.Register("Egg", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
	Remotes.Event("HatchResult").OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" or type(payload.Pets) ~= "table" then
			return
		end
		Bus.HatchResult:Fire(payload)
		enqueue({
			Egg = if type(payload.Egg) == "string" then payload.Egg else "",
			Pets = payload.Pets,
			Source = if type(payload.Source) == "string" then payload.Source else nil,
		})
	end)
end

return EggScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="127">
              <Properties>
                <string name="Name">EventBanner</string>
                <string name="Source"><![CDATA[--!strict
-- Live event banner (Sky Festival): a pulsing ribbon at the top-right with the event name and a
-- countdown while a server-wide boost is active.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("Shared").Util.Format)

local EventBanner = {}

function EventBanner.Init()
	local ribbon: Frame = Create("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 24),
		Size = UDim2.fromOffset(330, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = UIController.Layer("HUD"),
	})
	Create.Corner(14, ribbon)
	local gradient = Instance.new("UIGradient")
	gradient.Color = Theme.Rainbow
	gradient.Parent = ribbon
	Create.Stroke(ribbon, Theme.Colors.Stroke, 3, 0, true)
	local title = Create.Text({
		Text = "",
		Size = UDim2.new(1, -16, 0.58, 0),
		Position = UDim2.fromOffset(8, 2),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Stroke = 2.5,
		Parent = ribbon,
	})
	local timer = Create.Text({
		Text = "",
		Size = UDim2.new(1, -16, 0.4, 0),
		Position = UDim2.new(0, 8, 0.58, 0),
		Font = Theme.Fonts.Body,
		TextSize = 20,
		Scaled = true,
		Stroke = 1.5,
		Parent = ribbon,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = ribbon

	local function refresh()
		local event = StateController.Event
		local remaining = event.EndsAt - Workspace:GetServerTimeNow()
		local show = event.Active and remaining > 0
		if show and not ribbon.Visible then
			scale.Scale = 0.4
			TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		ribbon.Visible = show
		if show then
			title.Text = "🎉 " .. event.Name .. " 🎉"
			timer.Text = "x2 SKILL · x2 WINS · " .. Format.Clock(remaining)
		end
	end
	StateController.ServerInfoChanged:Connect(function(kind)
		if kind == "Event" then
			refresh()
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.5 then
			acc = 0
			refresh()
			if ribbon.Visible then
				gradient.Offset = Vector2.new(math.sin(os.clock()) * 0.3, 0)
			end
		end
	end)
end

return EventBanner
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="128">
              <Properties>
                <string name="Name">GiftsScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Gifts menu ("Gifts"): the 7-day daily reward strip on top and the 12 playtime gifts below.
-- Timers are server-measured (Data.Session.Playtime) and ticked locally between syncs; CLAIM only
-- sends RequestClaimGift / RequestClaimDaily intents, the server re-checks the timer and pays.
-- Auto-opens once per session when the daily reward is ready.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Definitions.Rewards)
local Boosts = require(Shared.Definitions.Boosts)
local Pets = require(Shared.Definitions.Pets)
local Zones = require(Shared.Definitions.Zones)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)
local MenuCard = require(Components.MenuCard)
local MenuGrid = require(Components.MenuGrid)

local GiftsScreen = {}

local hex = Color3.fromHex

local PANEL = Vector2.new(1240, 740)
local WIDTH = PANEL.X - 36
local HEIGHT = PANEL.Y - 78 - 16
local DAILY_H = 196

local shell: MenuShell.Shell
local giftCards: { MenuCard.Card } = {}
local dayFrames: { { Frame: Frame, Stroke: UIStroke, State: TextLabel, Reward: TextLabel } } = {}
local dailyButton: Button.Button
local streakLabel: TextLabel
local autoOpened = false

-- Emoji + short text for a reward entry in the player's current world.
local function describe(reward: Rewards.Reward, data: { [string]: any }?): (string, string)
	if reward.Kind == "Wins" then
		local world = if data and type(data.World) == "number" then data.World else 1
		local zones = Zones.ForWorld(world)
		local scale = if zones[1] then zones[1].Wins else 1
		return Theme.Icons.Wins, "+" .. Format.Short((reward.Amount or 0) * scale) .. " Wins"
	elseif reward.Kind == "Skill" then
		return Theme.Icons.Skill, string.format("Skill x%d reps", reward.Reps or 0)
	elseif reward.Kind == "Potion" then
		local boost = Boosts.Get(reward.Id or "")
		local name = if boost then string.gsub(boost.Name, "^%d+x%s+", "") else "Potion" -- "2x Skill Potion" -> "Skill Potion"
		local count = reward.Count or 1
		return Theme.Icons.Potion, if count == 1 then name else string.format("%d %ss", count, name)
	elseif reward.Kind == "Pet" then
		local pet = Pets.Get(reward.Id or "")
		return Theme.Icons.Pets, if pet then pet.Name else "Pet"
	end
	return Theme.Icons.Gifts, "Gift"
end

local function claimedSet(data: { [string]: any }): { [number]: boolean }
	local set = {}
	local session = data.Session
	if type(session) == "table" and type(session.GiftsClaimed) == "table" then
		for _, i in session.GiftsClaimed do
			if type(i) == "number" then
				set[i] = true
			end
		end
	end
	return set
end

local function playtime(data: { [string]: any }): number
	local session = data.Session
	local base = if type(session) == "table" and type(session.Playtime) == "number" then session.Playtime else 0
	return base + StateController.Since()
end

-- Index (1..7) of the day the next daily claim pays, and whether it is claimable now.
local function dailyState(data: { [string]: any }): (number, boolean, number)
	local daily = if type(data.Daily) == "table" then data.Daily else { Day = 0, Streak = 0 }
	local derived = StateController.Derived()
	local now = (if type(derived.ServerTime) == "number" then derived.ServerTime else os.time()) + StateController.Since()
	local today = now // 86400
	local ready = data.DailyReady == true
	local streak: number = daily.Streak or 0
	if ready then
		local nextStreak = if daily.Day == today - 1 then streak + 1 else 1
		return (nextStreak - 1) % #Rewards.Daily + 1, true, nextStreak
	end
	return (math.max(1, streak) - 1) % #Rewards.Daily + 1, false, streak
end

local function refresh()
	local data = StateController.Data
	if data == nil then
		return
	end
	-- daily strip
	local index, ready, streak = dailyState(data)
	streakLabel.Text = string.format("DAILY REWARDS  ·  %d day streak", if ready then math.max(0, streak - 1) else streak)
	for i, day in dayFrames do
		local isNext = i == index
		local _, rewardText = describe(Rewards.Daily[i], data) -- Wins scale with the current world
		day.Reward.Text = rewardText
		if ready then
			day.State.Text = if i < index then "✅" elseif isNext then "TODAY" else ""
		else
			day.State.Text = if i <= index then "✅" else ""
		end
		day.Stroke.Color = if isNext and ready then Theme.Colors.Skill else Theme.Colors.PanelBorder
		day.Stroke.Thickness = if isNext and ready then 4 else 2
		day.Frame.BackgroundTransparency = if (not ready and i <= index) or (ready and i < index) then 0.35 else 0
	end
	dailyButton:SetText(if ready then "CLAIM" else "COME BACK TOMORROW")
	dailyButton:SetStyle(if ready then "Green" else "Grey")
	dailyButton:SetEnabled(ready)

	-- playtime gifts
	local claimed = claimedSet(data)
	local played = playtime(data)
	for i, gift in Rewards.Gifts do
		local card = giftCards[i]
		local _, text = describe(gift.Reward, data)
		card:SetTitle(text)
		local remaining = gift.Minutes * 60 - played
		if claimed[i] then
			card:SetSubtitle("Claimed")
			card:SetAction("CLAIMED", "Grey", false)
			card:SetBadge("✅", Theme.Colors.Success)
		elseif remaining <= 0 then
			card:SetSubtitle("Ready!")
			card:SetAction("CLAIM", "Green", true)
			card:SetBadge("READY", Theme.Colors.Danger)
		else
			card:SetSubtitle(Format.Clock(remaining))
			card:SetAction(string.format("%d MIN", gift.Minutes), "Disabled", false)
			card:SetBadge(nil)
		end
	end
end

local function buildDaily(parent: Frame)
	local strip: Frame = Create("Frame", {
		Name = "Daily",
		BackgroundColor3 = Theme.Colors.CardDeep,
		BackgroundTransparency = 0.2,
		Size = UDim2.new(1, 0, 0, DAILY_H),
		Parent = parent,
	})
	Create.Corner(16, strip)
	Create.Stroke(strip, Theme.Colors.PanelEdge, 2, 0.4, true)
	streakLabel = Create.Text({
		Text = "DAILY REWARDS",
		Size = UDim2.new(1, -260, 0, 34),
		Position = UDim2.fromOffset(18, 8),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		Parent = strip,
	})
	dailyButton = Button.new({
		Parent = strip,
		Name = "ClaimDaily",
		Size = UDim2.fromOffset(240, 62),
		Position = UDim2.new(1, -14, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		Style = "Green",
		Shine = true,
		Text = "CLAIM",
		TextSize = 26,
		OnClick = function()
			Net.Invoke("RequestClaimDaily", false)
		end,
	})
	local row: Frame = Create("Frame", {
		Name = "Days",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 78),
		Size = UDim2.new(1, -28, 0, DAILY_H - 90),
		Parent = strip,
	})
	Create.List(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	local count = #Rewards.Daily
	local w = math.floor((WIDTH - 28 - 10 * (count - 1)) / count)
	for i, reward in Rewards.Daily do
		local icon, text = describe(reward, nil)
		local day: Frame = Create("Frame", {
			Name = "Day" .. i,
			BackgroundColor3 = Theme.Colors.Card,
			Size = UDim2.new(0, w, 1, 0),
			LayoutOrder = i,
			Parent = row,
		})
		Create.Corner(12, day)
		local stroke = Create.Stroke(day, Theme.Colors.PanelBorder, 2, 0, true)
		Create.Text({
			Text = "DAY " .. i,
			Size = UDim2.new(1, -84, 0, 22), -- left of the TODAY / ✅ tag in the corner
			Position = UDim2.fromOffset(8, 4),
			XAlign = Enum.TextXAlignment.Left,
			Font = Theme.Fonts.Display,
			TextSize = 20,
			Scaled = true,
			Color = Theme.Colors.TextDim,
			Stroke = 1.5,
			Parent = day,
		})
		Create.Text({
			Text = icon,
			Size = UDim2.new(1, 0, 0, 34),
			Position = UDim2.fromOffset(0, 26),
			TextSize = 30,
			Scaled = true,
			Parent = day,
		})
		local rewardLabel = Create.Text({
			Name = "Reward",
			Text = text,
			Size = UDim2.new(1, -8, 0, 22),
			Position = UDim2.new(0, 4, 1, -26),
			Font = Theme.Fonts.Body,
			TextSize = 18,
			Scaled = true,
			Stroke = 1.5,
			Parent = day,
		})
		local state = Create.Text({
			Name = "State",
			Text = "",
			Size = UDim2.fromOffset(70, 22),
			Position = UDim2.new(1, -4, 0, 4),
			AnchorPoint = Vector2.new(1, 0),
			Font = Theme.Fonts.Display,
			TextSize = 18,
			Scaled = true,
			Color = Theme.Colors.Skill,
			Stroke = 1.5,
			Parent = day,
		})
		table.insert(dayFrames, { Frame = day, Stroke = stroke, State = state, Reward = rewardLabel })
	end
end

local function buildGifts(parent: Frame)
	local columns = 6
	local grid = MenuGrid.new({
		Parent = parent,
		Name = "GiftsGrid",
		Position = UDim2.fromOffset(0, DAILY_H + 12),
		Size = UDim2.new(1, 0, 1, -(DAILY_H + 12)),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, columns), 196),
	})
	for i, gift in Rewards.Gifts do
		local icon = describe(gift.Reward, nil)
		local card = MenuCard.new({
			Parent = grid,
			Name = "Gift" .. i,
			LayoutOrder = i,
			Accent = hex(if gift.Reward.Kind == "Pet" then "#FF8FC8" elseif gift.Reward.Kind == "Potion" then "#C98CFF" elseif gift.Reward.Kind == "Wins" then "#FFC53D" else "#5FB8FF"),
			Rainbow = i == #Rewards.Gifts,
			Compact = true,
			Icon = icon,
			Title = "",
			Subtitle = "",
			ButtonText = "",
			OnClick = function()
				Net.Invoke("RequestClaimGift", false, i)
			end,
		})
		giftCards[i] = card
	end
end

function GiftsScreen.Init()
	shell = MenuShell.new({
		Name = "Gifts",
		Title = "Gifts",
		Icon = Theme.Icons.Gifts,
		Size = PANEL,
		Accent = hex("#FF5FB0"),
		OnOpen = function()
			refresh()
		end,
		FirstSelection = function()
			return dailyButton.Instance
		end,
	})
	buildDaily(shell.Content)
	buildGifts(shell.Content)
	UIController.Register("Gifts", shell)

	StateController.DataChanged:Connect(function(data)
		if shell:IsOpen() then
			refresh()
		end
		if not autoOpened and data and data.DailyReady == true then
			autoOpened = true
			task.delay(3, function()
				if not UIController.AnyMenuOpen() then
					UIController.Open("Gifts")
				end
			end)
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.5 and shell:IsOpen() then
			acc = 0
			refresh()
		end
	end)
	local _ = HEIGHT
end

return GiftsScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="129">
              <Properties>
                <string name="Name">HUD</string>
                <string name="Source"><![CDATA[--!strict
-- Always-on HUD (UIController layer "HUD"), laid out like the genre (docs/DESIGN.md §6) with
-- original art:
--   left         2-column menu tiles (Shop, Rebirth %, Pets, Trails, Inventory, Gifts badge),
--                Settings gear and an Admin tile for admins; fades during the local flight
--   bottom-left  Rebirths, Wins and "Friends +X%" boost (green + opens the invite prompt)
--   bottom-mid   Skill / multiplier row, level bar, three Robux Skill packs
--   top-mid      AUTO THROW (buy prompt or ON/OFF toggle); flight counter + banners below it
--   right        potion timers above the Starter Pack / 2x Skill / 2x Wins offers
-- Contextual pieces live in Hud* components: throw button + launch meter, flight overlay (counter,
-- zone banner, special banner, TAP!, combo, tap area) and the landing card.
-- Every button only sends intents (Net.Invoke / Net.Fire); the server decides all outcomes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Boosts = require(Shared.Definitions.Boosts)
local Rewards = require(Shared.Definitions.Rewards)
local Worlds = require(Shared.Definitions.Worlds)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local HudTile = require(Components.HudTile)
local HudStatPill = require(Components.HudStatPill)
local HudLevelBar = require(Components.HudLevelBar)
local HudThrowPanel = require(Components.HudThrowPanel)
local HudFlightOverlay = require(Components.HudFlightOverlay)
local HudLandingCard = require(Components.HudLandingCard)
local HudFlightState = require(Components.HudFlightState)
local RewardFly = require(Components.RewardFly)

local HUD = {}

local hex = Color3.fromHex
local IS_STUDIO = RunService:IsStudio()
local MARGIN = 18
local COUNTERS_H = 3 * 52 + 2 * 12 + 8 -- bottom-left stat pills
local POP = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

-- bottom-centre stack (design px, measured from the bottom edge)
local PACK_H = 66
local STACK_GAP = 8
HUD.BottomStack = 12 + PACK_H + STACK_GAP + HudLevelBar.Height -- top of the level block
HUD.ContextBottom = HUD.BottomStack + 14 -- where contextual panels (throw / pad) sit
HUD.CounterTop = 92 -- flight counter top when no tutorial bar is shown
HUD.CounterTopTutorial = 174

local function purchaseAvailable(id: number): boolean
	return id ~= 0 or IS_STUDIO
end

local function purchase(kind: string, key: string)
	task.spawn(Net.Invoke, "RequestPurchase", false, kind, key)
end

-- Left menu ---------------------------------------------------------------------------------------
type MenuRefs = {
	Group: CanvasGroup,
	Rebirth: HudTile.Tile,
	Gifts: HudTile.Tile,
	Admin: HudTile.Tile,
	Layout: (compact: boolean, designHeight: number) -> (),
}

local function buildMenu(root: Frame): MenuRefs
	local TILE = 92
	local GAP = 10
	local PAD = 16
	local width = TILE * 2 + GAP + PAD * 2
	local height = TILE * 3 + GAP * 2 + GAP + 76 + PAD * 2
	local group: CanvasGroup = Create("CanvasGroup", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, MARGIN - PAD, 0.5, -70),
		Size = UDim2.fromOffset(width, height),
		ZIndex = 2,
		Parent = root,
	})
	local grid: Frame = Create("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(PAD, PAD),
		Size = UDim2.fromOffset(TILE * 2 + GAP, TILE * 3 + GAP * 2),
		Parent = group,
	})
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(TILE, TILE)
	layout.CellPadding = UDim2.fromOffset(GAP, GAP)
	layout.FillDirectionMaxCells = 2
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	local TIPS: { [string]: string } = {
		Shop = "Game passes, Skill packs, potions and codes.",
		Rebirth = "Reset Skill for a bigger permanent multiplier.",
		Pets = "Equip pets to multiply your Skill.",
		Trails = "Trails add Wins to every landing.",
		Inventory = "Your gliders, relics and potions.",
		Gifts = "Playtime gifts and the daily streak.",
	}
	local function tile(order: number, name: string, icon: string, label: string, top: string, bottom: string): HudTile.Tile
		return HudTile.new({
			Parent = grid,
			Name = name,
			Icon = icon,
			Label = label,
			Size = TILE,
			Top = hex(top),
			Bottom = hex(bottom),
			LayoutOrder = order,
			Tooltip = { Title = label, Text = TIPS[name] or "", Beside = group :: GuiObject },
			OnClick = function()
				UIController.Toggle(name)
			end,
		})
	end
	tile(1, "Shop", Theme.Icons.Shop, "Shop", "#FF8FC8", "#D7267A")
	local rebirth = tile(2, "Rebirth", Theme.Icons.Rebirth, "Rebirth", "#7FD8FF", "#2563EB")
	tile(3, "Pets", Theme.Icons.Pets, "Pets", "#FFB86B", "#E06A00")
	tile(4, "Trails", Theme.Icons.Trails, "Trails", "#C98CFF", "#7A2BD6")
	tile(5, "Inventory", Theme.Icons.Inventory, "Items", "#B4E36B", "#4E9A1E")
	local gifts = tile(6, "Gifts", Theme.Icons.Gifts, "Gifts", "#FF7B7B", "#C81E3A")

	local row: Frame = Create("Frame", {
		Name = "Extras",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(PAD, PAD + TILE * 3 + GAP * 3),
		Size = UDim2.fromOffset(TILE * 2 + GAP, 76),
		Parent = group,
	})
	Create.List(row, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	HudTile.new({
		Parent = row,
		Name = "Settings",
		Icon = Theme.Icons.Settings,
		Size = 72,
		Round = true,
		Top = hex("#E9EEF5"),
		Bottom = hex("#8C96A8"),
		LayoutOrder = 1,
		Tooltip = { Title = "Settings", Text = "Sound, camera, effects and your stats.", Beside = group :: GuiObject },
		OnClick = function()
			UIController.Toggle("Settings")
		end,
	})
	local admin = HudTile.new({
		Parent = row,
		Name = "Admin",
		Icon = "🛠️",
		Size = 72,
		Top = hex("#FF6B6B"),
		Bottom = hex("#7A0A0A"),
		LayoutOrder = 2,
		OnClick = function()
			UIController.Toggle("Admin")
		end,
	})
	admin.Instance.Visible = false

	-- Short screens (phones in landscape): the settings row moves beside the tiles, and the column
	-- is kept clear of the counters stacked in the bottom-left corner.
	local rowLayout = row:FindFirstChildOfClass("UIListLayout") :: UIListLayout
	local function layoutMenu(compact: boolean, designHeight: number)
		if compact then
			row.Position = UDim2.fromOffset(PAD + TILE * 2 + GAP * 2, PAD)
			row.Size = UDim2.fromOffset(76, TILE * 2 + GAP)
			rowLayout.FillDirection = Enum.FillDirection.Vertical
			rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			rowLayout.VerticalAlignment = Enum.VerticalAlignment.Top
			group.Size = UDim2.fromOffset(width + 86, TILE * 3 + GAP * 2 + PAD * 2)
		else
			row.Position = UDim2.fromOffset(PAD, PAD + TILE * 3 + GAP * 3)
			row.Size = UDim2.fromOffset(TILE * 2 + GAP, 76)
			rowLayout.FillDirection = Enum.FillDirection.Horizontal
			rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
			rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
			group.Size = UDim2.fromOffset(width, height)
		end
		local h = group.Size.Y.Offset
		local countersTop = designHeight - MARGIN - COUNTERS_H - 14
		local centre = math.max(h / 2 + 8, math.min(designHeight / 2 - 70, countersTop - h / 2))
		group.Position = UDim2.new(0, MARGIN - PAD, 0, centre)
	end
	return { Group = group, Rebirth = rebirth, Gifts = gifts, Admin = admin, Layout = layoutMenu }
end

-- Bottom-left counters ----------------------------------------------------------------------------
type CounterRefs = { Rebirths: HudStatPill.Pill, Wins: HudStatPill.Pill, Friends: HudStatPill.Pill }

local function buildCounters(root: Frame): CounterRefs
	local holder: Frame = Create("Frame", {
		Name = "Counters",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, MARGIN + 6, 1, -MARGIN),
		Size = UDim2.fromOffset(340, COUNTERS_H),
		ZIndex = 2,
		Parent = root,
	})
	Create.List(holder, Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	local rebirths = HudStatPill.new({
		Parent = holder,
		Name = "Rebirths",
		Icon = Theme.Icons.Rebirth,
		Color = hex("#FFB3DA"),
		Badge = Theme.Colors.Rebirth,
		Width = 200,
		LayoutOrder = 1,
	})
	local wins = HudStatPill.new({
		Parent = holder,
		Name = "Wins",
		Icon = Theme.Icons.Wins,
		Color = Theme.Colors.Wins,
		Badge = hex("#F2A900"),
		Width = 250,
		LayoutOrder = 2,
	})
	local friendRow: Frame = Create("Frame", {
		Name = "FriendRow",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(340, 60),
		LayoutOrder = 3,
		Parent = holder,
	})
	local friends = HudStatPill.new({
		Parent = friendRow,
		Name = "FriendBoost",
		Icon = Theme.Icons.Friends,
		Color = hex("#9CFF7A"),
		Badge = hex("#2FA80F"),
		Width = 266,
	})
	friends.Instance.AnchorPoint = Vector2.new(0, 0.5)
	friends.Instance.Position = UDim2.fromScale(0, 0.5)
	friends:SetText("Friends +0%")
	local invite = Button.new({
		Parent = friendRow,
		Name = "Invite",
		Size = UDim2.fromOffset(72, 72),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 274, 0.5, 0),
		Style = "Green",
		Text = "+",
		TextSize = 46,
		Corner = 30,
		OnClick = function()
			pcall(function()
				SocialService:PromptGameInvite(Players.LocalPlayer)
			end)
		end,
	})
	invite.Label.Size = UDim2.fromScale(0.75, 0.75)
	return { Rebirths = rebirths, Wins = wins, Friends = friends }
end

-- Bottom-centre: level block + Skill packs ---------------------------------------------------------
type PackRef = { Button: Button.Button, Key: string, Amount: number, Price: TextLabel, Rainbow: UIGradient? }

local PACKS = {
	{ Key = "Skill10K", Style = "Gold" },
	{ Key = "Skill100K", Style = "Red" },
	{ Key = "Skill1M", Style = "Gold", Rainbow = true },
}

local function buildBottom(root: Frame): (HudLevelBar.LevelBar, { PackRef })
	local holder: Frame = Create("Frame", {
		Name = "Bottom",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(660, HudLevelBar.Height + STACK_GAP + PACK_H),
		ZIndex = 2,
		Parent = root,
	})
	Create.List(holder, Enum.FillDirection.Vertical, STACK_GAP, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
	local levelBar = HudLevelBar.new(holder, 1)

	local row: Frame = Create("Frame", {
		Name = "Packs",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(660, PACK_H),
		LayoutOrder = 2,
		Parent = holder,
	})
	Create.List(row, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local packs: { PackRef } = {}
	for i, spec in PACKS do
		local product = Monetization.Product(spec.Key)
		if not product then
			continue
		end
		local key = spec.Key
		local button = Button.new({
			Parent = row,
			Name = key,
			Size = UDim2.fromOffset(206, PACK_H),
			Style = spec.Style,
			Text = "",
			TextSize = 34,
			Corner = 14,
			Shine = true,
			LayoutOrder = i,
			OnClick = function()
				purchase("Product", key)
			end,
		})
		button.Label.Size = UDim2.new(1, -16, 0.52, 0)
		button.Label.Position = UDim2.fromScale(0.5, 0.33)
		local price = Create.Text({
			Name = "Price",
			Text = "",
			Size = UDim2.new(1, -16, 0.38, 0),
			Position = UDim2.fromScale(0.5, 0.77),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Font = Theme.Fonts.Display,
			TextSize = 22,
			Scaled = true,
			Color = hex("#E9FFE0"),
			Stroke = 2,
			ZIndex = button.Instance.ZIndex + 2,
			Parent = button.Content,
		})
		local rainbow: UIGradient? = nil
		if spec.Rainbow then
			button.Gradient.Color = Theme.Rainbow
			button.Gradient.Rotation = 0
			rainbow = button.Gradient
		end
		if not purchaseAvailable(product.Id) then
			button:SetEnabled(false)
		end
		table.insert(packs, { Button = button, Key = key, Amount = product.Amount or 0, Price = price, Rainbow = rainbow })
	end
	return levelBar, packs
end

-- Top-centre AUTO THROW ---------------------------------------------------------------------------
type AutoRefs = { Button: Button.Button, Sub: TextLabel }

local function buildAuto(root: Frame, onClick: () -> ()): AutoRefs
	local button = Button.new({
		Parent = root,
		Name = "AutoThrow",
		Size = UDim2.fromOffset(276, 80),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Style = "Red",
		Text = Theme.Icons.Auto .. " AUTO THROW",
		TextSize = 36,
		Corner = 16,
		Shine = true,
		ZIndex = 3,
		OnClick = onClick,
	})
	button.Label.Size = UDim2.new(1, -18, 0.56, 0)
	button.Label.Position = UDim2.fromScale(0.5, 0.36)
	local sub = Create.Text({
		Name = "Sub",
		Text = "",
		Size = UDim2.new(1, -18, 0.32, 0),
		Position = UDim2.fromScale(0.5, 0.78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Color = hex("#FFF2B3"),
		Stroke = 2,
		ZIndex = button.Instance.ZIndex + 2,
		Parent = button.Content,
	})
	return { Button = button, Sub = sub }
end

-- Right: offers + potion timers --------------------------------------------------------------------
type OfferRef = { Tile: HudTile.Tile, Kind: string, Key: string, Owned: (data: { [string]: any }) -> boolean }
type ChipRef = { Frame: Frame, Time: TextLabel, Id: string }

local function priceChip(parent: GuiObject, text: string)
	local chip: Frame = Create("Frame", {
		Name = "Price",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(84, 30),
		BackgroundColor3 = hex("#2FA80F"),
		ZIndex = 6,
		Parent = parent,
	})
	Create.Round(chip)
	Create.Stroke(chip, Theme.Colors.Stroke, 2.5, 0, true)
	Create.Text({
		Name = "Text",
		Text = text,
		Size = UDim2.fromScale(0.86, 0.8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 22,
		Scaled = true,
		Stroke = 2,
		ZIndex = 7,
		Parent = chip,
	})
end

local function buildRight(root: Frame): ({ OfferRef }, { ChipRef })
	local TILE = 100
	local GAP = 26
	local offersHeight = TILE * 3 + GAP * 2 + 16
	local column: Frame = Create("Frame", {
		Name = "Offers",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -MARGIN, 0.5, 30),
		Size = UDim2.fromOffset(TILE + 8, offersHeight),
		ZIndex = 2,
		Parent = root,
	})
	Create.List(column, Enum.FillDirection.Vertical, GAP, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	local offers: { OfferRef } = {}
	local function offer(order: number, kind: string, key: string, icon: string, label: string, top: string, bottom: string, owned: (data: { [string]: any }) -> boolean)
		local id = 0
		local robux = 0
		local tip = ""
		if kind == "Pass" then
			local pass = Monetization.Pass(key)
			id, robux = if pass then pass.Id else 0, if pass then pass.Robux else 0
			tip = if pass then pass.Description else ""
		else
			local product = Monetization.Product(key)
			id, robux = if product then product.Id else 0, if product then product.Robux else 0
			tip = if product then product.Description else ""
		end
		local available = purchaseAvailable(id)
		local tile = HudTile.new({
			Parent = column,
			Name = key,
			Icon = icon,
			Label = label,
			Size = TILE,
			Top = hex(if available then top else "#8C93A3"),
			Bottom = hex(if available then bottom else "#5A6070"),
			LayoutOrder = order,
			Shine = available,
			Tooltip = { Title = label, Text = tip, Beside = column :: GuiObject },
			OnClick = function()
				if available then
					purchase(kind, key)
				else
					UIController.Toast("Coming soon!", "Info")
				end
			end,
		})
		priceChip(tile.Instance, if available then Theme.Icons.Robux .. tostring(robux) else "SOON")
		-- the price chip sits on the bottom edge: lift the icon and label above it
		tile.Icon.Position = UDim2.fromScale(0.5, 0.33)
		tile.Icon.Size = UDim2.fromScale(0.6, 0.5)
		local labelText = tile.Label
		if labelText then
			labelText.Position = UDim2.new(0.5, 0, 1, -15)
			labelText.Size = UDim2.new(1, 4, 0.26, 0)
		end
		table.insert(offers, { Tile = tile, Kind = kind, Key = key, Owned = owned })
	end
	offer(1, "Product", "StarterPack", Theme.Icons.Star, "Starter", "#FFE27A", "#F07800", function(data)
		return type(data.Flags) == "table" and data.Flags.StarterPack == true
	end)
	offer(2, "Pass", "DoubleSkill", Theme.Icons.Skill, "2x SKILL", "#7FD8FF", "#2563EB", function()
		return StateController.HasPass("DoubleSkill")
	end)
	offer(3, "Pass", "DoubleWins", Theme.Icons.Wins, "2x WINS", "#9CFF7A", "#2FA80F", function()
		return StateController.HasPass("DoubleWins")
	end)

	-- potion timers stack upward from just above the offers
	local chipsHolder: Frame = Create("Frame", {
		Name = "Potions",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -MARGIN, 0.5, 30 - offersHeight / 2 - 12),
		Size = UDim2.fromOffset(180, 3 * 44 + 2 * 8),
		ZIndex = 2,
		Parent = root,
	})
	Create.List(chipsHolder, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
	local STAT_ICON: { [string]: string } = { Skill = Theme.Icons.Skill, Wins = Theme.Icons.Wins, Luck = Theme.Icons.Luck }
	local chips: { ChipRef } = {}
	for i, boost in Boosts.List do
		local chip: Frame = Create("Frame", {
			Name = boost.Id,
			Size = UDim2.fromOffset(176, 44),
			BackgroundColor3 = Theme.Colors.PanelDeep,
			BackgroundTransparency = 0.2,
			LayoutOrder = i,
			Visible = false,
			Parent = chipsHolder,
		})
		Create.Round(chip)
		Create.Stroke(chip, hex(boost.Color), 3, 0, true)
		Create.Text({
			Name = "Label",
			Text = (STAT_ICON[boost.Stat] or Theme.Icons.Potion) .. " x" .. tostring(boost.Multiplier),
			Size = UDim2.new(0.48, 0, 0.8, 0),
			Position = UDim2.new(0, 10, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Font = Theme.Fonts.Display,
			TextSize = 26,
			Scaled = true,
			Color = hex(boost.Color),
			Stroke = 2.5,
			XAlign = Enum.TextXAlignment.Left,
			Parent = chip,
		})
		local time = Create.Text({
			Name = "Time",
			Text = "",
			Size = UDim2.new(0.48, 0, 0.74, 0),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Font = Theme.Fonts.Display,
			TextSize = 24,
			Scaled = true,
			Stroke = 2.5,
			XAlign = Enum.TextXAlignment.Right,
			Parent = chip,
		})
		table.insert(chips, { Frame = chip, Time = time, Id = boost.Id })
	end
	return offers, chips
end

-- Init --------------------------------------------------------------------------------------------
function HUD.Init()
	local root = UIController.Layer("HUD")

	local menu = buildMenu(root)
	local counters = buildCounters(root)
	local function relayout()
		local designHeight = root.AbsoluteSize.Y / math.max(UIController.Scale, 0.01)
		if designHeight > 0 then
			menu.Layout(designHeight < 760, designHeight)
		end
	end
	UIController.ScaleChanged:Connect(function()
		task.defer(relayout)
	end)
	relayout()
	local levelBar, packs = buildBottom(root)
	local offers, chips = buildRight(root)
	HudThrowPanel.new(root, HUD.ContextBottom)
	local overlay = HudFlightOverlay.new(root)
	HudLandingCard.new(root)
	-- Wins from a landing fly out of the landing card's "+N" line
	local function landingWins(): GuiObject?
		local card = root:FindFirstChild("LandingCard") :: Frame?
		local line = if card and card.Visible then card:FindFirstChild("Wins") :: TextLabel? else nil
		return line
	end

	-- AUTO THROW: buy prompt until owned, then an ON/OFF toggle (optimistic until the next sync)
	local pendingAuto: boolean? = nil
	local auto: AutoRefs
	local function autoOn(): boolean
		if pendingAuto ~= nil then
			return pendingAuto
		end
		local data = StateController.Data
		return data ~= nil and type(data.Settings) == "table" and data.Settings.AutoThrow == true
	end
	local function refreshAuto()
		local pass = Monetization.Pass("AutoThrow")
		if StateController.HasPass("AutoThrow") then
			local on = autoOn()
			auto.Button:SetStyle(if on then "Green" else "Red")
			auto.Button:SetText(Theme.Icons.Auto .. " AUTO THROW")
			auto.Sub.Text = if on then "ON" else "OFF"
		else
			auto.Button:SetStyle("Red")
			auto.Button:SetText(Theme.Icons.Auto .. " AUTO THROW")
			if pass and purchaseAvailable(pass.Id) then
				auto.Sub.Text = "ONLY " .. Theme.Icons.Robux .. tostring(pass.Robux)
			else
				auto.Sub.Text = "COMING SOON"
			end
		end
	end
	auto = buildAuto(root, function()
		if StateController.HasPass("AutoThrow") then
			local on = not autoOn()
			pendingAuto = on
			Net.Fire("RequestToggle", "AutoThrow", on)
			refreshAuto()
		else
			purchase("Pass", "AutoThrow")
		end
	end)

	-- level-up flash (throttled: early levels arrive several per second)
	local FLASH_EVERY = 1.3
	local lastFlash = -math.huge
	local pendingLevel: number? = nil
	local flashScheduled = false
	local glow: Frame = Create("Frame", {
		Name = "LevelGlow",
		BackgroundColor3 = hex("#7FFFD4"),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 1,
		Parent = root,
	})
	local glowGradient = Instance.new("UIGradient")
	glowGradient.Rotation = 90
	glowGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.55, 1),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	glowGradient.Parent = glow
	local function flashLevel()
		flashScheduled = false
		local level = pendingLevel
		if level == nil then
			return
		end
		pendingLevel = nil
		lastFlash = os.clock()
		levelBar:FlashLevel(level)
		AudioController.Play("LevelUp", nil, 0.8)
		glow.Visible = true
		glow.BackgroundTransparency = 0.35
		local t = TweenService:Create(glow, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
		t:Play()
		t.Completed:Once(function()
			if glow.BackgroundTransparency >= 0.99 then
				glow.Visible = false
			end
		end)
	end
	local function queueLevelFlash(level: number)
		pendingLevel = level
		if flashScheduled then
			return
		end
		local wait = lastFlash + FLASH_EVERY - os.clock()
		if wait <= 0 then
			flashLevel()
		else
			flashScheduled = true
			task.delay(wait, flashLevel)
		end
	end

	-- timers (gift badge, potion chips) -----------------------------------------------------------
	local function refreshTimers()
		local data = StateController.Data
		if not data then
			return
		end
		local since = StateController.Since()
		-- claimable gifts
		local count = 0
		local session = data.Session
		if type(session) == "table" then
			local playtime = (tonumber(session.Playtime) or 0) + since
			local claimed = if type(session.GiftsClaimed) == "table" then session.GiftsClaimed else {}
			for _, gift in Rewards.Gifts do
				if playtime >= gift.Minutes * 60 and table.find(claimed, gift.Index) == nil then
					count += 1
				end
			end
		end
		if data.DailyReady == true then
			count += 1
		end
		menu.Gifts:SetBadge(count)
		menu.Gifts:SetAttention(count > 0)
		-- potion timers
		local derived = if type(data.Derived) == "table" then data.Derived else {}
		local now = (tonumber(derived.ServerTime) or os.time()) + since
		local boosts = if type(data.Boosts) == "table" then data.Boosts else {}
		for _, chip in chips do
			local expiry = tonumber(boosts[chip.Id]) or 0
			local remaining = expiry - now
			if remaining > 0 then
				chip.Time.Text = if remaining >= 3600 then Format.Duration(remaining) else Format.Clock(remaining)
				chip.Frame.Visible = true
			else
				chip.Frame.Visible = false
			end
		end
	end

	-- data -> HUD ---------------------------------------------------------------------------------
	local function refresh(data: { [string]: any }, previous: { [string]: any }?)
		local derived = if type(data.Derived) == "table" then data.Derived else {}
		pendingAuto = nil

		-- left menu
		local progress = math.clamp(tonumber(derived.RebirthProgress) or 0, 0, 1)
		menu.Rebirth:SetCaption(Format.Percent(progress * 100))
		menu.Rebirth:SetGlow(progress >= 1)
		menu.Admin.Instance.Visible = data.IsAdmin == true

		-- counters (Wins earned fly into the counter, which then rolls up)
		local wins = tonumber(data.Wins) or 0
		local gained = if previous then wins - (tonumber(previous.Wins) or 0) else 0
		counters.Rebirths:SetValue(tonumber(data.Rebirths) or 0, Format.Commas)
		counters.Wins:SetValue(wins, Format.Short, if gained > 0 then RewardFly.ArriveTime else nil)
		counters.Friends:SetText(string.format("Friends +%d%%", math.floor((tonumber(derived.FriendBoost) or 0) * 100 + 0.5)))
		if previous then
			if gained > 0 then
				RewardFly.Burst(Theme.Icons.Wins, landingWins(), counters.Wins.Badge, math.clamp(3 + math.floor(math.log10(gained + 1) * 2), 4, 10), function()
					counters.Wins:Bump()
				end)
			end
			if (tonumber(data.Rebirths) or 0) > (tonumber(previous.Rebirths) or 0) then
				counters.Rebirths:Bump()
			elseif (tonumber(data.Level) or 1) > (tonumber(previous.Level) or 1) then
				queueLevelFlash(tonumber(data.Level) or 1)
			end
		end

		-- level block + packs
		levelBar:Update(data)
		local world = Worlds.Get(tonumber(data.World) or 1)
		local packScale = if world then world.SkillPackScale else 1
		for _, pack in packs do
			local product = Monetization.Product(pack.Key)
			local available = product ~= nil and purchaseAvailable(product.Id)
			pack.Button:SetText(Theme.Icons.Skill .. "+" .. Format.Short(pack.Amount * packScale))
			pack.Price.Text = if available and product then Theme.Icons.Robux .. tostring(product.Robux) else "SOON"
		end

		-- offers
		for _, offer in offers do
			offer.Tile.Instance.Visible = not offer.Owned(data)
		end

		refreshAuto()
		overlay:SetCounterTop(if type(data.Tutorial) == "table" and data.Tutorial.Done == false then HUD.CounterTopTutorial else HUD.CounterTop)
		refreshTimers()
	end

	StateController.DataChanged:Connect(function(data: any, previous: any)
		if type(data) == "table" then
			refresh(data, if type(previous) == "table" then previous else nil)
		end
	end)
	if StateController.Data then
		refresh(StateController.Data, nil)
	else
		refreshAuto()
	end

	-- flight: fade the left menu for a clean view
	HudFlightState.Changed:Connect(function(active: any)
		TweenService:Create(menu.Group, TweenInfo.new(0.3), { GroupTransparency = if active then 0.6 else 0 }):Play()
	end)

	-- one ticker for pulses (~20 Hz) and countdowns (1 Hz)
	local animAcc, timerAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		animAcc += dt
		timerAcc += dt
		if animAcc >= 0.05 then
			animAcc = 0
			local t = os.clock()
			menu.Rebirth:Animate(t)
			menu.Gifts:Animate(t)
			levelBar:Animate(t)
			for _, pack in packs do
				local rainbow = pack.Rainbow
				if rainbow then
					rainbow.Offset = Vector2.new(math.sin(t * 1.5) * 0.25, 0)
				end
			end
		end
		if timerAcc >= 1 then
			timerAcc = 0
			refreshTimers()
		end
	end)

	-- pop the HUD in once
	local intro = Instance.new("UIScale")
	intro.Scale = 0.85
	intro.Parent = menu.Group
	TweenService:Create(intro, POP, { Scale = 1 }):Play()
end

return HUD
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="130">
              <Properties>
                <string name="Name">IndexScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Index menu ("Index"): the pet collection book that simulators keep. One tab per world plus
-- Special (the Robux egg and the exclusive pets). Each egg is a section with its own completion
-- bar, and every pet is a card: pets found so far show their model, name and boost, the rest a
-- black silhouette with "???" (their rarity outline still shows). An overall bar counts every
-- pet in the game. Discoveries come from the server (PlayerData.Index, set when a pet is first
-- owned); the screen only reads them. Cards are built when a tab is first shown and stay static
-- (no spin), so a closed Index costs nothing per frame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Definitions.Pets)
local Eggs = require(Shared.Definitions.Eggs)
local Worlds = require(Shared.Definitions.Worlds)
local Format = require(Shared.Util.Format)
local PetFactory = require(Shared.Visual.PetFactory)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local MenuShell = require(Components.MenuShell)
local MenuTabs = require(Components.MenuTabs)
local MenuGrid = require(Components.MenuGrid)
local ItemSlot = require(Components.ItemSlot)

local IndexScreen = {}

local PANEL = Vector2.new(1240, 740)
local WIDTH = PANEL.X - 36
local TAB_H = 64
local SUMMARY_H = 48
local LIST_TOP = TAB_H + 12 + SUMMARY_H + 12
local HEADER_H = 44
local COLUMNS = 7
local GAP = 12
local INSET = 8
local CARD_W = math.floor((WIDTH - MenuGrid.ScrollBar - INSET * 2 - GAP * (COLUMNS - 1)) / COLUMNS)
local CARD_H = 184
local GOLD_TOP = Color3.fromHex("#FFE27A")
local GOLD_BOTTOM = Color3.fromHex("#F2A900")
local SPECIAL = "Special"

type Section = { Title: string, Icon: string, Pets: { string } }
type Card = { Slot: ItemSlot.Slot, PetId: string }
type SectionRefs = { Pets: { string }, Count: TextLabel, Fill: Frame, Cards: { Card } }

local shell: MenuShell.Shell
local tabs: MenuTabs.Tabs
local pages: { [string]: ScrollingFrame } = {}
local built: { [string]: { SectionRefs } } = {}
local summaryText: TextLabel
local summaryFill: Frame
local summaryPercent: TextLabel

-- Pet ids of an egg, in its listed order, without repeats.
local function eggPets(egg: Eggs.Egg): { string }
	local out, seen = {}, {}
	for _, entry in egg.Pets do
		if not seen[entry.Pet] then
			seen[entry.Pet] = true
			table.insert(out, entry.Pet)
		end
	end
	return out
end

local function sectionsFor(tab: string): { Section }
	local sections: { Section } = {}
	if tab == SPECIAL then
		for _, egg in Eggs.List do
			if egg.World == nil then
				table.insert(sections, { Title = egg.Name, Icon = Theme.Icons.Egg, Pets = eggPets(egg) })
			end
		end
		local exclusives = {}
		for _, pet in Pets.List do
			if pet.Exclusive then
				table.insert(exclusives, pet.Id)
			end
		end
		if #exclusives > 0 then
			table.insert(sections, { Title = "Exclusives", Icon = Theme.Icons.Star, Pets = exclusives })
		end
	else
		local world = tonumber(tab)
		for _, egg in Eggs.List do
			if egg.World == world then
				table.insert(sections, { Title = egg.Name, Icon = Theme.Icons.Egg, Pets = eggPets(egg) })
			end
		end
	end
	return sections
end

local function found(): { [string]: boolean }
	local data = StateController.Data
	return if data and type(data.Index) == "table" then data.Index else {}
end

-- A thin rounded progress bar; returns the fill.
local function bar(parent: Instance, size: UDim2, position: UDim2, anchor: Vector2): Frame
	local track: Frame = Create("Frame", {
		Name = "Bar",
		BackgroundColor3 = Theme.Colors.LevelTrack,
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		Parent = parent,
	})
	Create.Round(track)
	Create.Stroke(track, Theme.Colors.Stroke, 2.5, 0, true)
	local fill: Frame = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	Create.Round(fill)
	Create.Gradient(fill, GOLD_TOP, GOLD_BOTTOM, 90)
	return fill
end

local function setFill(fill: Frame, have: number, total: number)
	local f = if total > 0 then have / total else 0
	fill.Size = UDim2.fromScale(f, 1)
	fill.Visible = f > 0
end

local function buildCard(parent: Instance, petId: string, order: number): Card?
	local pet = Pets.Get(petId)
	if not pet then
		return nil
	end
	local slot = ItemSlot.new({
		Parent = parent,
		Name = petId,
		LayoutOrder = order,
		Rarity = pet.Rarity,
		Build = function()
			return PetFactory.ForId(petId, 3)
		end,
		Spin = 0,
		Silhouette = true,
		Title = "???",
		Stat = pet.Rarity,
	})
	return { Slot = slot, PetId = petId }
end

local function buildPage(tab: string)
	local page = pages[tab]
	local refs: { SectionRefs } = {}
	local y = 0
	for i, section in sectionsFor(tab) do
		local rows = math.max(1, math.ceil(#section.Pets / COLUMNS))
		local height = HEADER_H + 8 + rows * CARD_H + (rows - 1) * GAP
		local frame: Frame = Create("Frame", {
			Name = "Section" .. i,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, height),
			Parent = page,
		})
		local header: Frame = Create("Frame", {
			Name = "Header",
			BackgroundColor3 = Theme.Colors.CardDeep,
			Size = UDim2.new(1, 0, 0, HEADER_H),
			Parent = frame,
		})
		Create.Corner(12, header)
		Create.Text({
			Name = "Title",
			Text = section.Icon .. " " .. section.Title,
			Size = UDim2.new(0.45, 0, 1, -10),
			Position = UDim2.new(0, 12, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Font = Theme.Fonts.Display,
			TextSize = 28,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2.2,
			Parent = header,
		})
		local fill = bar(header, UDim2.new(0.3, 0, 0, 18), UDim2.new(1, -110, 0.5, 0), Vector2.new(1, 0.5))
		local count = Create.Text({
			Name = "Count",
			Text = "",
			Size = UDim2.fromOffset(90, 30),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Font = Theme.Fonts.Display,
			TextSize = 26,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Right,
			Stroke = 2,
			Parent = header,
		})
		local grid: Frame = Create("Frame", {
			Name = "Cards",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, HEADER_H + 8),
			Size = UDim2.new(1, 0, 0, height - HEADER_H - 8),
			Parent = frame,
		})
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.fromOffset(CARD_W, CARD_H)
		layout.CellPadding = UDim2.fromOffset(GAP, GAP)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = grid
		local cards: { Card } = {}
		for n, petId in section.Pets do
			local card = buildCard(grid, petId, n)
			if card then
				table.insert(cards, card)
			end
		end
		table.insert(refs, { Pets = section.Pets, Count = count, Fill = fill, Cards = cards })
		y += height + 16
	end
	page.CanvasSize = UDim2.fromOffset(0, y + INSET * 2)
	built[tab] = refs
end

local function refresh()
	local index = found()
	-- whole game
	local total, have = #Pets.List, 0
	for _, pet in Pets.List do
		if index[pet.Id] then
			have += 1
		end
	end
	summaryText.Text = string.format("📖 Discovered %d / %d pets", have, total)
	summaryPercent.Text = Format.Percent(if total > 0 then have / total * 100 else 0)
	setFill(summaryFill, have, total)
	-- tab labels: a check once a tab is complete
	for key, button in tabs.Buttons do
		local all, got = 0, 0
		for _, section in sectionsFor(key) do
			for _, petId in section.Pets do
				all += 1
				if index[petId] then
					got += 1
				end
			end
		end
		local world = tonumber(key)
		local def = if world then Worlds.Get(world) else nil
		local name = if def then def.Name else SPECIAL
		button:SetText((if all > 0 and got == all then Theme.Icons.Check .. " " else "") .. name)
	end
	-- the built tab pages
	for _, refs in built do
		for _, section in refs do
			local got = 0
			for _, card in section.Cards do
				local pet = Pets.Get(card.PetId) :: Pets.Pet
				local isFound = index[card.PetId] == true
				if isFound then
					got += 1
				end
				card.Slot:SetSilhouette(not isFound)
				card.Slot:SetTitle(if isFound then pet.Name else "???")
				card.Slot:SetStat(if isFound then "x" .. Format.Short(1 + pet.SkillBoost) .. " Skill" else pet.Rarity)
			end
			section.Count.Text = string.format("%d/%d", got, #section.Cards)
			section.Count.TextColor3 = if got == #section.Cards then Theme.Colors.Success else Theme.Colors.Text
			setFill(section.Fill, got, #section.Cards)
		end
	end
end

local function showPage(key: string)
	if built[key] == nil then
		buildPage(key)
	end
	for k, page in pages do
		page.Visible = k == key
	end
	refresh()
end

function IndexScreen.Init()
	shell = MenuShell.new({
		Name = "Index",
		Title = "Index",
		Icon = "📖",
		Size = PANEL,
		Accent = Color3.fromHex("#C98CFF"),
		OnOpen = function()
			-- open on the world the player is in
			local data = StateController.Data
			local world = if data then tostring(tonumber(data.World) or 1) else "1"
			if tabs.Buttons[world] then
				tabs:Select(world, true)
				showPage(world)
			else
				refresh()
			end
		end,
		OnShoulder = function(direction: number)
			tabs:Cycle(direction)
		end,
		FirstSelection = function()
			return tabs.Buttons[tabs.Selected].Instance
		end,
	})
	local content = shell.Content
	local specs: { MenuTabs.TabSpec } = {}
	for i = 1, Worlds.Count do
		local def = Worlds.Get(i)
		table.insert(specs, { Key = tostring(i), Text = if def then def.Name else ("World " .. i), Style = "Blue" })
	end
	table.insert(specs, { Key = SPECIAL, Text = SPECIAL, Style = "Purple" })
	tabs = MenuTabs.new({
		Parent = content,
		Tabs = specs,
		Size = UDim2.new(1, 0, 0, TAB_H),
		TabWidth = math.floor((WIDTH - 12 * (#specs - 1)) / #specs),
		OnChanged = showPage,
	})

	local summary: Frame = Create("Frame", {
		Name = "Summary",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Position = UDim2.fromOffset(0, TAB_H + 12),
		Size = UDim2.new(1, 0, 0, SUMMARY_H),
		Parent = content,
	})
	Create.Corner(14, summary)
	summaryText = Create.Text({
		Name = "Text",
		Text = "",
		Size = UDim2.new(0.42, 0, 1, -12),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 28,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2.2,
		Parent = summary,
	})
	summaryFill = bar(summary, UDim2.new(0.44, 0, 0, 22), UDim2.new(1, -120, 0.5, 0), Vector2.new(1, 0.5))
	summaryPercent = Create.Text({
		Name = "Percent",
		Text = "",
		Size = UDim2.fromOffset(96, 32),
		Position = UDim2.new(1, -12, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 28,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Right,
		Color = Theme.Colors.Skill,
		Stroke = 2.2,
		Parent = summary,
	})

	for _, spec in specs do
		local page: ScrollingFrame = Create("ScrollingFrame", {
			Name = "Page_" .. spec.Key,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, LIST_TOP),
			Size = UDim2.new(1, 0, 1, -LIST_TOP),
			CanvasSize = UDim2.new(),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = MenuGrid.ScrollBar,
			ScrollBarImageColor3 = Theme.Colors.PanelEdge,
			VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
			Selectable = false,
			ClipsDescendants = true,
			Visible = false,
			Parent = content,
		})
		Create.Padding(page, INSET, INSET)
		pages[spec.Key] = page
	end

	tabs:Select("1", true)
	showPage("1")

	UIController.Register("Index", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
end

return IndexScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="131">
              <Properties>
                <string name="Name">InventoryScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Inventory menu ("Inventory"): tab "Gliders" lists owned gliders (strongest first) and owned
-- relics with Equip; tab "Potions" lists potion counts with Use plus the active boost timers.
-- Equip/Use are RequestEquipThrowable / RequestUseBoost intents.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Boosts = require(Shared.Definitions.Boosts)
local Format = require(Shared.Util.Format)
local GliderFactory = require(Shared.Visual.GliderFactory)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)
local MenuTabs = require(Components.MenuTabs)
local MenuCard = require(Components.MenuCard)
local MenuGrid = require(Components.MenuGrid)
local ItemSlot = require(Components.ItemSlot)

local InventoryScreen = {}

local PANEL = Vector2.new(1240, 740)
local WIDTH = PANEL.X - 36
local TAB_H = 64

local shell: MenuShell.Shell
local tabs: MenuTabs.Tabs
local pages: { [string]: GuiObject } = {}
local gliderGrid: ScrollingFrame
local gliderSlots: { [string]: ItemSlot.Slot } = {}
local selectedGlider: string? = nil
local equipButton: Button.Button
local gliderInfo: TextLabel
local potionCards: { [string]: MenuCard.Card } = {}

local function serverNow(): number
	local derived = StateController.Derived()
	return (if type(derived.ServerTime) == "number" then derived.ServerTime else os.time()) + StateController.Since()
end

local function equippedId(data: { [string]: any }): string
	if type(data.Relic) == "string" and data.Relic ~= "" then
		return "relic:" .. data.Relic
	end
	return if type(data.Glider) == "string" then data.Glider else Gliders.Default
end

local function refreshGliders(data: { [string]: any })
	local owned = if type(data.Gliders) == "table" then data.Gliders else {}
	local relics = if type(data.Relics) == "table" then data.Relics else {}
	local equipped = equippedId(data)
	local entries: { { Id: string, Name: string, Rarity: string, Stat: string, Power: number } } = {}
	for _, relic in Relics.List do
		if relics[relic.Id] then
			table.insert(entries, { Id = "relic:" .. relic.Id, Name = relic.Name, Rarity = "Mythic", Stat = "+125% vs best", Power = math.huge })
		end
	end
	for _, glider in Gliders.List do
		if owned[glider.Id] then
			table.insert(entries, { Id = glider.Id, Name = glider.Name, Rarity = glider.Rarity, Stat = "+" .. Format.Short(glider.SkillPerRing) .. " Skill", Power = glider.SkillPerRing })
		end
	end
	table.sort(entries, function(a, b)
		return a.Power > b.Power
	end)
	local alive: { [string]: boolean } = {}
	for i, entry in entries do
		alive[entry.Id] = true
		local slot = gliderSlots[entry.Id]
		if not slot then
			local id = entry.Id
			slot = ItemSlot.new({
				Parent = gliderGrid,
				Name = id,
				Rarity = entry.Rarity,
				Build = function()
					local model = GliderFactory.ForId(id, 3, true)
					-- show the glider from slightly above so the wings read
					model:PivotTo(model:GetPivot() * CFrame.Angles(math.rad(25), 0, 0))
					return model
				end,
				Title = entry.Name,
				Stat = entry.Stat,
				OnClick = function()
					selectedGlider = id
					local current = StateController.Data
					if current then
						refreshGliders(current)
					end
				end,
			})
			gliderSlots[entry.Id] = slot
		end
		local s = slot :: ItemSlot.Slot
		s.Instance.LayoutOrder = i
		s:SetCorner(if entry.Id == equipped then Theme.Icons.Check else nil)
		s:SetSelected(entry.Id == selectedGlider)
	end
	for id, slot in gliderSlots do
		if not alive[id] then
			slot:Destroy()
			gliderSlots[id] = nil
		end
	end
	if selectedGlider == nil or not alive[selectedGlider] then
		selectedGlider = equipped
	end
	local sel = selectedGlider :: string
	local relicId = string.match(sel, "^relic:(.+)$")
	if relicId then
		local relic = Relics.Get(relicId)
		local best = Gliders.BestOwned(owned)
		gliderInfo.Text = string.format("%s %s  ·  always 125%% better than your best glider (%s: +%s Skill per ring)", Theme.Icons.Relic, if relic then relic.Name else "Relic", best.Name, Format.Short(best.SkillPerRing))
	else
		local glider = Gliders.Get(sel)
		gliderInfo.Text = if glider then string.format("%s %s  ·  +%s Skill for every thermal ring (%s)", Theme.Icons.Glider, glider.Name, Format.Short(glider.SkillPerRing), glider.Rarity) else ""
	end
	local isEquipped = sel == equipped
	equipButton:SetText(if isEquipped then "EQUIPPED" else "EQUIP")
	equipButton:SetStyle(if isEquipped then "Grey" else "Green")
	equipButton:SetEnabled(not isEquipped)
end

local function refreshPotions(data: { [string]: any })
	local potions = if type(data.Potions) == "table" then data.Potions else {}
	local active = if type(data.Boosts) == "table" then data.Boosts else {}
	local now = serverNow()
	for _, boost in Boosts.List do
		local card = potionCards[boost.Id]
		local count = potions[boost.Id] or 0
		local expiry = active[boost.Id]
		local remaining = if type(expiry) == "number" then expiry - now else 0
		card:SetSubtitle(string.format("You have %d", count))
		if remaining > 0 then
			card:SetBadge("ACTIVE " .. Format.Clock(remaining), Theme.Colors.Success)
		else
			card:SetBadge(nil)
		end
		card:SetAction(if count > 0 then "USE" else "NONE LEFT", if count > 0 then "Green" else "Disabled", count > 0)
	end
end

local function refresh()
	local data = StateController.Data
	if data == nil then
		return
	end
	if tabs.Selected == "Gliders" then
		refreshGliders(data)
	else
		refreshPotions(data)
	end
end

local function showPage(key: string)
	for k, page in pages do
		page.Visible = k == key
	end
	refresh()
end

function InventoryScreen.Init()
	shell = MenuShell.new({
		Name = "Inventory",
		Title = "Inventory",
		Icon = Theme.Icons.Inventory,
		Size = PANEL,
		Accent = Color3.fromHex("#5FB8FF"),
		OnOpen = function(tab: any)
			if tab == "Potions" or tab == "Gliders" then
				tabs:Select(tab, true)
				showPage(tab)
			else
				refresh()
			end
		end,
		OnShoulder = function(direction: number)
			tabs:Cycle(direction)
		end,
		FirstSelection = function()
			return tabs.Buttons[tabs.Selected].Instance
		end,
	})
	local content = shell.Content
	tabs = MenuTabs.new({
		Parent = content,
		Tabs = {
			{ Key = "Gliders", Text = "Gliders", Icon = Theme.Icons.Glider, Style = "Blue" },
			{ Key = "Potions", Text = "Potions", Icon = Theme.Icons.Potion, Style = "Green" },
		},
		Size = UDim2.new(1, 0, 0, TAB_H),
		TabWidth = 240,
		OnChanged = showPage,
	})

	-- Gliders page
	local glidersPage: Frame = Create("Frame", {
		Name = "Gliders",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, TAB_H + 12),
		Size = UDim2.new(1, 0, 1, -(TAB_H + 12)),
		Parent = content,
	})
	pages.Gliders = glidersPage
	gliderGrid = MenuGrid.new({
		Parent = glidersPage,
		Name = "Grid",
		Size = UDim2.new(1, 0, 1, -86),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, 6), 176),
	})
	local footer: Frame = Create("Frame", {
		Name = "Footer",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Position = UDim2.new(0, 0, 1, -76),
		Size = UDim2.new(1, 0, 0, 76),
		Parent = glidersPage,
	})
	Create.Corner(14, footer)
	gliderInfo = Create.Text({
		Text = "",
		Size = UDim2.new(1, -280, 1, -16),
		Position = UDim2.fromOffset(14, 8),
		Font = Theme.Fonts.Body,
		TextSize = 24,
		Scaled = true,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 1.5,
		Parent = footer,
	})
	equipButton = Button.new({
		Parent = footer,
		Name = "Equip",
		Size = UDim2.fromOffset(240, 62),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Style = "Green",
		Text = "EQUIP",
		TextSize = 28,
		OnClick = function()
			local id = selectedGlider
			if id then
				task.spawn(Net.Invoke, "RequestEquipThrowable", false, id)
			end
		end,
	})

	-- Potions page
	local potionsPage = MenuGrid.new({
		Parent = content,
		Name = "Potions",
		Position = UDim2.fromOffset(0, TAB_H + 12),
		Size = UDim2.new(1, 0, 1, -(TAB_H + 12)),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, 3), 330),
		Center = true,
	})
	potionsPage.Visible = false
	pages.Potions = potionsPage
	for i, boost in Boosts.List do
		local id = boost.Id
		potionCards[id] = MenuCard.new({
			Parent = potionsPage,
			Name = id,
			LayoutOrder = i,
			Accent = Color3.fromHex(boost.Color),
			Icon = if boost.Stat == "Luck" then Theme.Icons.Luck elseif boost.Stat == "Wins" then Theme.Icons.Wins else Theme.Icons.Skill,
			Title = boost.Name,
			Subtitle = "",
			Description = string.format("x%s %s for %d minutes. Using more adds time.", Format.Short(boost.Multiplier), boost.Stat, math.floor(boost.Duration / 60)),
			ButtonText = "",
			OnClick = function()
				task.spawn(Net.Invoke, "RequestUseBoost", false, id)
			end,
		})
	end

	-- start on the Gliders tab (MenuTabs starts with nothing selected)
	tabs:Select("Gliders", true)
	showPage("Gliders")

	UIController.Register("Inventory", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 1 then
			acc = 0
			if shell:IsOpen() and tabs.Selected == "Potions" then
				refresh()
			end
		end
	end)
end

return InventoryScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="132">
              <Properties>
                <string name="Name">Notifications</string>
                <string name="Source"><![CDATA[--!strict
-- Server toasts: every Notify remote ({ Text, Kind }) relayed by StateController.Notified becomes
-- a UIController toast. Kinds: Info, Success, Error, Level, Rare. Identical messages arriving in a
-- burst (e.g. several level-ups in one second) are collapsed so the stack never floods.
local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)

local Notifications = {}

local KINDS: { [string]: boolean } = { Info = true, Success = true, Error = true, Level = true, Rare = true }
local REPEAT_WINDOW = 1.2 -- seconds: the same text inside this window is shown once
local MAX_LENGTH = 200

local lastText = ""
local lastAt = -math.huge

function Notifications.Init()
	StateController.Notified:Connect(function(payload: any)
		if type(payload) ~= "table" or type(payload.Text) ~= "string" or payload.Text == "" then
			return
		end
		local text = string.sub(payload.Text, 1, MAX_LENGTH)
		local kind = if type(payload.Kind) == "string" and KINDS[payload.Kind] then payload.Kind else "Info"
		local now = os.clock()
		if text == lastText and now - lastAt < REPEAT_WINDOW then
			return
		end
		lastText = text
		lastAt = now
		UIController.Toast(text, kind)
	end)
end

return Notifications
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="133">
              <Properties>
                <string name="Name">PetsScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Pets menu ("Pets"): every owned pet in a rarity-bordered grid (equipped first, then strongest),
-- a detail pane with Equip/Unequip and Lock/Unlock, Equip Best, and a multi-select delete mode
-- (locked pets can't be picked), and an INDEX button that opens the collection book. Every action
-- is a RequestPetAction intent; the server owns the inventory and slot limits.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Definitions.Pets)
local Economy = require(Shared.Config.Economy)
local Rarity = require(Shared.Config.Rarity)
local Format = require(Shared.Util.Format)
local PetFactory = require(Shared.Visual.PetFactory)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)
local MenuGrid = require(Components.MenuGrid)
local ItemSlot = require(Components.ItemSlot)
local Viewport = require(Components.Viewport)

local PetsScreen = {}

local PANEL = Vector2.new(1240, 740)
local WIDTH = PANEL.X - 36
local HEIGHT = PANEL.Y - 78 - 16
local BAR_H = 70
local DETAIL_W = 360
local GRID_W = WIDTH - DETAIL_W - 16

local shell: MenuShell.Shell
local grid: ScrollingFrame
local slots: { [string]: ItemSlot.Slot } = {}
local selected: string? = nil
local deleteMode = false
local toDelete: { [string]: boolean } = {}

local summary: TextLabel
local equipBestButton: Button.Button
local deleteButton: Button.Button
local detail: Frame
local detailPreview: Frame
local detailName: TextLabel
local detailRarity: TextLabel
local detailStats: TextLabel
local equipButton: Button.Button
local lockButton: Button.Button
local emptyLabel: TextLabel
local previewId: string? = nil

local function petScore(def: Pets.Pet): number
	return def.SkillBoost * 1000 + def.WinsBoost
end

local function multiplierText(def: Pets.Pet): string
	return "x" .. Format.Short(1 + def.SkillBoost) .. " Skill"
end

local function ownedPets(data: { [string]: any }): { [string]: { Id: string, Locked: boolean } }
	return if type(data.Pets) == "table" then data.Pets else {}
end

local function equippedSet(data: { [string]: any }): { [string]: boolean }
	local set = {}
	if type(data.EquippedPets) == "table" then
		for _, uid in data.EquippedPets do
			set[uid] = true
		end
	end
	return set
end

local function refreshDetail(data: { [string]: any })
	local pets = ownedPets(data)
	local equipped = equippedSet(data)
	if deleteMode then
		local count = 0
		for _ in toDelete do
			count += 1
		end
		detailName.Text = "DELETE MODE"
		detailRarity.Text = string.format("%d selected", count)
		detailStats.Text = "Tap pets to select them.\nLocked pets can't be deleted."
		equipButton:SetText(string.format("DELETE %d", count))
		equipButton:SetStyle("Red")
		equipButton:SetEnabled(count > 0)
		lockButton:SetText("CANCEL")
		lockButton:SetStyle("Grey")
		lockButton:SetEnabled(true)
		return
	end
	local owned = if selected then pets[selected] else nil
	local def = if owned then Pets.Get(owned.Id) else nil
	if not owned or not def then
		detailName.Text = "Select a pet"
		detailRarity.Text = ""
		detailStats.Text = "Pets multiply your Skill.\nHatch eggs to get more!"
		equipButton:SetText("EQUIP")
		equipButton:SetEnabled(false)
		lockButton:SetText("LOCK")
		lockButton:SetEnabled(false)
		if previewId then
			detailPreview:ClearAllChildren()
			previewId = nil
		end
		return
	end
	detailName.Text = def.Name
	detailRarity.Text = string.upper(def.Rarity)
	detailRarity.TextColor3 = Theme.Rarity(def.Rarity)
	local lines = { Theme.Icons.Skill .. " " .. multiplierText(def) }
	if def.WinsBoost > 0 then
		table.insert(lines, Theme.Icons.Wins .. " +" .. Format.Short(def.WinsBoost * 100) .. "% Wins")
	end
	if def.Exclusive then
		table.insert(lines, Theme.Icons.Star .. " Exclusive")
	end
	detailStats.Text = table.concat(lines, "\n")
	local isEquipped = equipped[selected :: string] == true
	equipButton:SetText(if isEquipped then "UNEQUIP" else "EQUIP")
	equipButton:SetStyle(if isEquipped then "Orange" else "Green")
	equipButton:SetEnabled(true)
	lockButton:SetText(if owned.Locked then "UNLOCK" else "LOCK")
	lockButton:SetStyle(if owned.Locked then "Purple" else "Blue")
	lockButton:SetEnabled(true)
	if previewId ~= owned.Id then
		detailPreview:ClearAllChildren()
		previewId = owned.Id
		Viewport.Model(detailPreview, PetFactory.ForId(owned.Id, 3), { Spin = 0.8, Yaw = math.pi, Pitch = math.rad(-8) })
	end
end

-- Detail pane, stacked from the bottom so it fits any panel height: buttons, stats, rarity, name,
-- and the preview takes what is left. Short panels (phones) put the two buttons side by side.
local function layoutDetail(compact: boolean)
	local buttons = if compact then 74 else 146
	if compact then
		equipButton.Instance.Size = UDim2.new(0.5, -18, 0, 62)
		equipButton.Instance.Position = UDim2.new(0, 12, 1, -12)
		lockButton.Instance.Size = UDim2.new(0.5, -18, 0, 62)
		lockButton.Instance.Position = UDim2.new(0.5, 6, 1, -12)
	else
		equipButton.Instance.Size = UDim2.new(1, -24, 0, 62)
		equipButton.Instance.Position = UDim2.new(0, 12, 1, -84)
		lockButton.Instance.Size = UDim2.new(1, -24, 0, 62)
		lockButton.Instance.Position = UDim2.new(0, 12, 1, -12)
	end
	local statsH = if compact then 70 else 100
	detailStats.AnchorPoint = Vector2.new(0, 1)
	detailStats.Size = UDim2.new(1, -24, 0, statsH)
	detailStats.Position = UDim2.new(0, 12, 1, -(buttons + 6))
	detailRarity.AnchorPoint = Vector2.new(0, 1)
	detailRarity.Position = UDim2.new(0, 12, 1, -(buttons + 6 + statsH + 4))
	detailName.AnchorPoint = Vector2.new(0, 1)
	detailName.Position = UDim2.new(0, 12, 1, -(buttons + 6 + statsH + 4 + 28 + 2))
	detailPreview.Size = UDim2.new(1, -40, 1, -(buttons + 6 + statsH + 4 + 28 + 2 + 40 + 14))
end

local function refresh()
	local data = StateController.Data
	if data == nil then
		return
	end
	local pets = ownedPets(data)
	local equipped = equippedSet(data)
	local derived = StateController.Derived()

	-- sort: equipped first, then strongest, then rarity, then uid
	local uids = {}
	for uid, owned in pets do
		if Pets.Get(owned.Id) then
			table.insert(uids, uid)
		end
	end
	table.sort(uids, function(a, b)
		local ea, eb = equipped[a] == true, equipped[b] == true
		if ea ~= eb then
			return ea
		end
		local da, db = Pets.Get(pets[a].Id) :: Pets.Pet, Pets.Get(pets[b].Id) :: Pets.Pet
		local sa, sb = petScore(da), petScore(db)
		if sa ~= sb then
			return sa > sb
		end
		if da.Rarity ~= db.Rarity then
			return Rarity.Order(da.Rarity) > Rarity.Order(db.Rarity)
		end
		return a < b
	end)

	local alive: { [string]: boolean } = {}
	local totalBoost = 0
	for i, uid in uids do
		alive[uid] = true
		local owned = pets[uid]
		local def = Pets.Get(owned.Id) :: Pets.Pet
		if equipped[uid] then
			totalBoost += def.SkillBoost
		end
		local slot = slots[uid]
		if not slot then
			local petId = owned.Id
			local thisUid = uid
			slot = ItemSlot.new({
				Parent = grid,
				Name = "Pet_" .. uid,
				Rarity = def.Rarity,
				Build = function()
					return PetFactory.ForId(petId, 2.2)
				end,
				Title = def.Name,
				Stat = multiplierText(def),
				OnClick = function()
					if deleteMode then
						local current = StateController.Data
						local now = if current then ownedPets(current)[thisUid] else nil
						if now and not now.Locked then
							if toDelete[thisUid] then
								toDelete[thisUid] = nil :: any
							else
								toDelete[thisUid] = true
							end
						end
					else
						selected = thisUid
					end
					refresh()
				end,
			})
			slots[uid] = slot
		end
		local s = slot :: ItemSlot.Slot
		s.Instance.LayoutOrder = i
		s:SetCorner(if equipped[uid] then Theme.Icons.Check else nil)
		s:SetTag(if owned.Locked then Theme.Icons.Lock else nil)
		s:SetSelected(if deleteMode then toDelete[uid] == true else selected == uid)
		s:SetDimmed(deleteMode and owned.Locked)
	end
	for uid, slot in slots do
		if not alive[uid] then
			slot:Destroy()
			slots[uid] = nil
			toDelete[uid] = nil
			if selected == uid then
				selected = nil
			end
		end
	end

	local slotsMax = if type(derived.PetSlots) == "number" then derived.PetSlots else Economy.PetSlots
	local equippedCount = if type(data.EquippedPets) == "table" then #data.EquippedPets else 0
	summary.Text = string.format(
		"%s Equipped %d/%d   ·   🎒 Storage %d/%d\n%s Pet boost x%s",
		Theme.Icons.Check,
		equippedCount,
		slotsMax,
		#uids,
		Economy.PetInventory,
		Theme.Icons.Skill,
		Format.Short(1 + totalBoost)
	)
	emptyLabel.Visible = #uids == 0
	deleteButton:SetText(if deleteMode then "DONE" else "DELETE")
	equipBestButton:SetEnabled(#uids > 0 and not deleteMode)
	refreshDetail(data)
end

local function onPrimary()
	if deleteMode then
		local list = {}
		for uid in toDelete do
			table.insert(list, uid)
		end
		if #list == 0 then
			return
		end
		task.spawn(function()
			local result = Net.Invoke("RequestPetAction", false, "Delete", list)
			if result.ok then
				toDelete = {}
				deleteMode = false
				refresh()
			end
		end)
		return
	end
	local data = StateController.Data
	local uid = selected
	if not data or not uid then
		return
	end
	local action = if equippedSet(data)[uid] then "Unequip" else "Equip"
	task.spawn(Net.Invoke, "RequestPetAction", false, action, uid)
end

local function onSecondary()
	if deleteMode then
		deleteMode = false
		toDelete = {}
		refresh()
		return
	end
	local data = StateController.Data
	local uid = selected
	if not data or not uid then
		return
	end
	local owned = ownedPets(data)[uid]
	if owned then
		task.spawn(Net.Invoke, "RequestPetAction", false, if owned.Locked then "Unlock" else "Lock", uid)
	end
end

function PetsScreen.Init()
	shell = MenuShell.new({
		Name = "Pets",
		Title = "Pets",
		Icon = Theme.Icons.Pets,
		Size = PANEL,
		Accent = Color3.fromHex("#FFB86B"),
		OnOpen = function()
			deleteMode = false
			toDelete = {}
			refresh()
		end,
		OnResize = function(contentHeight: number)
			layoutDetail(contentHeight - (BAR_H + 12) < 470)
		end,
		FirstSelection = function()
			return equipBestButton.Instance
		end,
	})
	local content = shell.Content

	local bar: Frame = Create("Frame", {
		Name = "Bar",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Size = UDim2.new(1, 0, 0, BAR_H),
		Parent = content,
	})
	Create.Corner(14, bar)
	summary = Create.Text({
		Name = "Summary",
		Text = "",
		Size = UDim2.new(1, -590, 1, -12),
		Position = UDim2.fromOffset(14, 6),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2,
		Parent = bar,
	})
	Button.new({
		Parent = bar,
		Name = "OpenIndex",
		Size = UDim2.fromOffset(170, 60),
		Position = UDim2.new(1, -394, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Style = "Purple",
		Text = "📖 INDEX",
		TextSize = 24,
		OnClick = function()
			UIController.Open("Index")
		end,
	})
	equipBestButton = Button.new({
		Parent = bar,
		Name = "EquipBest",
		Size = UDim2.fromOffset(196, 60),
		Position = UDim2.new(1, -186, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Style = "Green",
		Text = "EQUIP BEST",
		TextSize = 24,
		OnClick = function()
			task.spawn(Net.Invoke, "RequestPetAction", false, "EquipBest")
		end,
	})
	deleteButton = Button.new({
		Parent = bar,
		Name = "Delete",
		Size = UDim2.fromOffset(170, 60),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Style = "Red",
		Text = "DELETE",
		TextSize = 24,
		OnClick = function()
			deleteMode = not deleteMode
			toDelete = {}
			refresh()
		end,
	})

	grid = MenuGrid.new({
		Parent = content,
		Name = "PetGrid",
		Position = UDim2.fromOffset(0, BAR_H + 12),
		Size = UDim2.new(0, GRID_W, 1, -(BAR_H + 12)),
		Cell = Vector2.new(MenuGrid.CellWidth(GRID_W, 5), 176),
	})
	emptyLabel = Create.Text({
		Name = "Empty",
		Text = "No pets yet! Hatch an egg in the hub " .. Theme.Icons.Egg,
		Size = UDim2.new(0, GRID_W, 0, 60),
		Position = UDim2.fromOffset(0, BAR_H + 120),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		Stroke = 2,
		Parent = content,
	})

	detail = Create("Frame", {
		Name = "Detail",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Position = UDim2.new(1, -DETAIL_W, 0, BAR_H + 12),
		Size = UDim2.new(0, DETAIL_W, 1, -(BAR_H + 12)),
		Parent = content,
	})
	Create.Corner(16, detail)
	Create.Stroke(detail, Theme.Colors.PanelEdge, 2, 0.4, true)
	detailPreview = Create("Frame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(1, -40, 0, 210),
		Parent = detail,
	})
	detailName = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 40),
		Position = UDim2.fromOffset(12, 224),
		Font = Theme.Fonts.Display,
		TextSize = 34,
		Scaled = true,
		Stroke = 2.5,
		Parent = detail,
	})
	detailRarity = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 28),
		Position = UDim2.fromOffset(12, 266),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Stroke = 2,
		Parent = detail,
	})
	detailStats = Create.Text({
		Text = "",
		Size = UDim2.new(1, -24, 0, 100),
		Position = UDim2.fromOffset(12, 300),
		Font = Theme.Fonts.Body,
		TextSize = 24,
		Scaled = true, -- shrinks to fit the shorter box on phones
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
		Stroke = 1.4,
		Parent = detail,
	})
	equipButton = Button.new({
		Parent = detail,
		Name = "Equip",
		Size = UDim2.new(1, -24, 0, 62),
		Position = UDim2.new(0, 12, 1, -84),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Green",
		Text = "EQUIP",
		TextSize = 26,
		OnClick = onPrimary,
	})
	lockButton = Button.new({
		Parent = detail,
		Name = "Lock",
		Size = UDim2.new(1, -24, 0, 62),
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Blue",
		Text = "LOCK",
		TextSize = 26,
		OnClick = onSecondary,
	})

	layoutDetail(false)

	UIController.Register("Pets", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
	local _ = HEIGHT
end

return PetsScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="134">
              <Properties>
                <string name="Name">RebirthScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Rebirth menu ("Rebirth"): big "x<now> -> x<next>" Skill multiplier hero, level progress toward
-- the cap (Level / LevelCap, bar = Derived.RebirthProgress) with the cap after rebirth, what resets
-- and what is kept, and what the next rebirth unlocks (training pads gated at Rebirths + 1 in any
-- world, plus the next world's rebirth gate). The REBIRTH button is only enabled when
-- Derived.CanRebirth and just sends RequestRebirth; on success it plays the Rebirth sound with a
-- screen flash, a banner and a burst around the character.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Training = require(Shared.Definitions.Training)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Effects = require(Client.VFX.Effects)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)

local RebirthScreen = {}

local hex = Color3.fromHex
local PANEL = Vector2.new(1120, 720)
local PINK = Theme.Colors.Rebirth
local GOLD = Theme.Colors.Skill
local MAX_UNLOCK_LINES = 5

type Refs = {
	Now: TextLabel,
	Next: TextLabel,
	Count: TextLabel,
	LevelText: TextLabel,
	Percent: TextLabel,
	Fill: Frame,
	BarText: TextLabel,
	NextCap: TextLabel,
	Unlocks: { TextLabel },
	Rebirth: Button.Button,
	Glow: Frame,
}

local shell: MenuShell.Shell
local refs: Refs
local glowTween: Tween
local columns: { GuiObject } = {} -- resets / keeps / unlocks cards (hidden on short panels)
local compactInfo: TextLabel? = nil
local flash: Frame
local banner: Frame
local bannerScale: UIScale
local bannerTitle: TextLabel
local bannerSub: TextLabel

local function multText(m: any): string
	return "x" .. Format.Short(if type(m) == "number" then m else 1)
end

-- Lines for the "NEXT REBIRTH UNLOCKS" card.
local function unlockLines(data: { [string]: any }): { string }
	local rebirths = if type(data.Rebirths) == "number" then data.Rebirths else 0
	local unlocked = if type(data.Worlds) == "table" then data.Worlds else {}
	local reached = if type(data.Zones) == "table" then data.Zones else {}
	local nextR = rebirths + 1
	local lines = {}
	for _, pad in Training.List do
		if pad.PassKey == nil and pad.Rebirths == nextR then
			local world = Worlds.Get(pad.World)
			local name = if world then world.Name else ("World " .. pad.World)
			local lock = if unlocked[tostring(pad.World)] then "" else " " .. Theme.Icons.Lock
			table.insert(lines, string.format("🏋️ %sx Skill pad, %s%s", Format.Short(pad.Multiplier), name, lock))
		end
	end
	-- next world whose rebirth gate is still ahead
	for _, world in Worlds.List do
		if world.UnlockRebirths > rebirths and not unlocked[tostring(world.Id)] then
			if world.UnlockRebirths == nextR then
				table.insert(lines, string.format("%s Opens the %s gate!", Theme.Icons.World, world.Name))
				local zone = if world.UnlockZone then Zones.Get(world.UnlockZone) else nil
				if zone and not reached[zone.Id] then
					table.insert(lines, string.format("   (also land in %s)", zone.Name))
				end
			else
				local left = world.UnlockRebirths - rebirths
				table.insert(lines, string.format("%s %s gate: %d rebirths (%d to go)", Theme.Icons.World, world.Name, world.UnlockRebirths, left))
			end
			break
		end
	end
	if #lines == 0 then
		table.insert(lines, Theme.Icons.Star .. " A bigger multiplier and level cap!")
	end
	return lines
end

local function refresh()
	local data = StateController.Data
	if data == nil or refs == nil then
		return
	end
	local derived = StateController.Derived()
	local breakdown = if type(derived.Breakdown) == "table" then derived.Breakdown else {}
	local rebirths = if type(data.Rebirths) == "number" then data.Rebirths else 0
	local level = if type(data.Level) == "number" then data.Level else 1
	local cap = if type(derived.LevelCap) == "number" then derived.LevelCap else Economy.LevelCap(rebirths)
	local progress = math.clamp(if type(derived.RebirthProgress) == "number" then derived.RebirthProgress else level / cap, 0, 1)
	local can = derived.CanRebirth == true

	refs.Now.Text = multText(breakdown.Rebirth or Economy.RebirthMultiplier(rebirths))
	refs.Next.Text = multText(derived.NextRebirthMultiplier or Economy.RebirthMultiplier(rebirths + 1))
	refs.Count.Text = string.format("%s Rebirths: %s", Theme.Icons.Rebirth, Format.Commas(rebirths))
	refs.LevelText.Text = string.format("Level %d / %d", level, cap)
	refs.Percent.Text = Format.Percent(progress * 100)
	refs.Fill.Size = UDim2.fromScale(math.max(progress, 0.02), 1)
	if level >= cap then
		refs.BarText.Text = "MAX LEVEL - READY TO REBIRTH!"
	else
		local left = cap - level
		refs.BarText.Text = string.format("%d level%s to go", left, if left == 1 then "" else "s")
	end
	refs.NextCap.Text = string.format("Level cap after rebirth: %d", Economy.LevelCap(rebirths + 1))

	local lines = unlockLines(data)
	for i, label in refs.Unlocks do
		local line = lines[i]
		label.Visible = line ~= nil
		if line then
			label.Text = line
		end
	end

	if can then
		refs.Rebirth:SetText(Theme.Icons.Rebirth .. " REBIRTH")
		refs.Rebirth:SetStyle("Pink")
		refs.Rebirth:SetEnabled(true)
	else
		refs.Rebirth:SetText("REACH LEVEL " .. tostring(cap))
		refs.Rebirth:SetEnabled(false)
	end
	refs.Glow.Visible = can
	if can and shell:IsOpen() then
		glowTween:Play()
	else
		glowTween:Cancel()
	end
end

-- Celebration ------------------------------------------------------------------------------------

local function buildCelebration()
	local overlay = UIController.Layer("Overlay")
	flash = Create("Frame", {
		Name = "RebirthFlash",
		BackgroundColor3 = hex("#FFE3F2"),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 50,
		Parent = overlay,
	})
	banner = Create("Frame", {
		Name = "RebirthBanner",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(900, 220),
		Visible = false,
		ZIndex = 51,
		Parent = overlay,
	})
	bannerScale = Instance.new("UIScale")
	bannerScale.Parent = banner
	bannerTitle = Create.Text({
		Name = "Title",
		Text = "REBIRTH!",
		Size = UDim2.new(1, 0, 0, 130),
		Font = Theme.Fonts.Display,
		TextSize = 120,
		Scaled = true,
		Color = hex("#FFD0E8"),
		Stroke = 6,
		ZIndex = 52,
		Parent = banner,
	})
	Create.Gradient(bannerTitle, Color3.new(1, 1, 1), PINK, 90)
	bannerSub = Create.Text({
		Name = "Sub",
		Text = "",
		Position = UDim2.fromOffset(0, 136),
		Size = UDim2.new(1, 0, 0, 70),
		Font = Theme.Fonts.Display,
		TextSize = 64,
		Scaled = true,
		Color = GOLD,
		Stroke = 4,
		ZIndex = 52,
		Parent = banner,
	})
end

local bannerToken = 0

local function celebrate(rebirths: number)
	AudioController.Play("Rebirth")
	-- screen flash
	flash.Visible = true
	flash.BackgroundTransparency = 0.1
	local fade = TweenService:Create(flash, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
	fade.Completed:Once(function()
		flash.Visible = false
	end)
	fade:Play()
	-- banner
	bannerToken += 1
	local token = bannerToken
	bannerSub.Text = string.format("%s SKILL FOREVER", multText(Economy.RebirthMultiplier(rebirths)))
	bannerTitle.TextTransparency = 0
	bannerSub.TextTransparency = 0
	local titleStroke = bannerTitle:FindFirstChildOfClass("UIStroke")
	local subStroke = bannerSub:FindFirstChildOfClass("UIStroke")
	if titleStroke then
		titleStroke.Transparency = 0
	end
	if subStroke then
		subStroke.Transparency = 0
	end
	banner.Visible = true
	bannerScale.Scale = 0.3
	TweenService:Create(bannerScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1.6, function()
		if token ~= bannerToken then
			return
		end
		local out = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(bannerScale, out, { Scale = 1.3 }):Play()
		TweenService:Create(bannerTitle, out, { TextTransparency = 1 }):Play()
		TweenService:Create(bannerSub, out, { TextTransparency = 1 }):Play()
		if titleStroke then
			TweenService:Create(titleStroke, out, { Transparency = 1 }):Play()
		end
		if subStroke then
			TweenService:Create(subStroke, out, { Transparency = 1 }):Play()
		end
		task.delay(0.45, function()
			if token == bannerToken then
				banner.Visible = false
			end
		end)
	end)
	-- burst around the character
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	if root then
		local pos = root.Position
		Effects.Flash(pos, 16, PINK, 0.45)
		Effects.Ring(pos - Vector3.new(0, 2.6, 0), Vector3.yAxis, 18, PINK, 0.7, 0.3)
		Effects.Ring(pos - Vector3.new(0, 2.4, 0), Vector3.yAxis, 12, GOLD, 0.55, 0.3)
		Effects.Sparks(pos, GOLD, 50, 34, 1.1)
		Effects.Sparks(pos, PINK, 40, 26, 0.9)
	end
end

local function doRebirth()
	local derived = StateController.Derived()
	if derived.CanRebirth ~= true then
		return
	end
	local result = Net.Invoke("RequestRebirth", false)
	if result.ok then
		local data = StateController.Data
		local rebirths = if type(result.rebirths) == "number"
			then result.rebirths
			elseif data and type(data.Rebirths) == "number" then data.Rebirths + 1
			else 1
		celebrate(rebirths)
	end
end

-- Layout -----------------------------------------------------------------------------------------

local function card(parent: Instance, name: string, position: UDim2, size: UDim2, accent: Color3, title: string): Frame
	local frame: Frame = Create("Frame", {
		Name = name,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = position,
		Size = size,
		Parent = parent,
	})
	Create.Corner(16, frame)
	Create.Gradient(frame, Theme.Colors.Card, Theme.Colors.CardDeep, 90)
	Create.Stroke(frame, accent, 3, 0, true)
	local header: Frame = Create("Frame", {
		Name = "Header",
		BackgroundColor3 = accent,
		Size = UDim2.new(1, 0, 0, 46),
		Parent = frame,
	})
	Create.Corner(16, header)
	Create.Gradient(header, accent, MenuShell.Shade(accent, 0.6), 90)
	-- square off the header's bottom corners
	Create("Frame", {
		Name = "Square",
		BackgroundColor3 = MenuShell.Shade(accent, 0.6),
		Position = UDim2.new(0, 0, 1, -14),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = header,
	})
	Create.Text({
		Name = "Title",
		Text = title,
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Stroke = 2.6,
		ZIndex = 2,
		Parent = header,
	})
	local list: Frame = Create("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(1, -28, 1, -62),
		Parent = frame,
	})
	Create.List(list, Enum.FillDirection.Vertical, 4)
	return list
end

local function line(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return Create.Text({
		Name = "Line" .. order,
		Text = text,
		Size = UDim2.new(1, 0, 0, 26),
		Font = Theme.Fonts.Body,
		TextSize = 22,
		Scaled = true,
		Color = color or Theme.Colors.Text,
		Stroke = 1.4,
		XAlign = Enum.TextXAlignment.Left,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function multBox(parent: Instance, name: string, x: UDim, caption: string, color: Color3): TextLabel
	local box: Frame = Create("Frame", {
		Name = name,
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(x.Scale, x.Offset, 0, 14),
		Size = UDim2.fromOffset(300, 128),
		Parent = parent,
	})
	Create.Corner(18, box)
	Create.Stroke(box, color, 3, 0, true)
	Create.Text({
		Name = "Caption",
		Text = caption,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 28),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		Stroke = 2,
		Parent = box,
	})
	return Create.Text({
		Name = "Value",
		Text = "x1",
		Position = UDim2.fromOffset(10, 34),
		Size = UDim2.new(1, -20, 0, 86),
		Font = Theme.Fonts.Display,
		TextSize = 84,
		Scaled = true,
		Color = color,
		Stroke = 4,
		Parent = box,
	})
end

function RebirthScreen.Init()
	shell = MenuShell.new({
		Name = "Rebirth",
		Title = "Rebirth",
		Icon = Theme.Icons.Rebirth,
		Size = PANEL,
		MinHeight = 560,
		Accent = PINK,
		OnResize = function(contentHeight: number)
			-- short panels (phones): one summary line instead of the three cards
			local compact = contentHeight < 600
			for _, column in columns do
				column.Visible = not compact
			end
			if compactInfo then
				compactInfo.Visible = compact
			end
		end,
		OnOpen = function()
			task.defer(refresh)
		end,
		OnClose = function()
			if glowTween then
				glowTween:Cancel()
			end
		end,
		FirstSelection = function()
			return if refs then refs.Rebirth.Instance else nil
		end,
	})
	local content = shell.Content

	-- hero: x<now> -> x<next>
	local hero: Frame = Create("Frame", {
		Name = "Hero",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, 192),
		Parent = content,
	})
	Create.Corner(18, hero)
	Create.Gradient(hero, hex("#7A2BD6"), hex("#3B1580"), 90)
	Create.Stroke(hero, PINK, 3, 0, true)
	local now = multBox(hero, "Now", UDim.new(0.5, -230), "NOW", Theme.Colors.Text)
	local nextLabel = multBox(hero, "Next", UDim.new(0.5, 230), "AFTER REBIRTH", GOLD)
	local arrow = Create.Text({
		Name = "Arrow",
		Text = "➜",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 78),
		Size = UDim2.fromOffset(120, 90),
		Font = Theme.Fonts.Display,
		TextSize = 90,
		Scaled = true,
		Color = GOLD,
		Stroke = 4,
		Parent = hero,
	})
	TweenService:Create(arrow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = UDim2.new(0.5, 12, 0, 78),
	}):Play()
	local count = Create.Text({
		Name = "Count",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -40, 0, 34),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		Stroke = 2.4,
		Parent = hero,
	})
	-- caption under the boxes
	Create.Text({
		Name = "Hint",
		Text = "Skill multiplier",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 1, -10),
		Size = UDim2.fromOffset(220, 28),
		Font = Theme.Fonts.Body,
		TextSize = 22,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		Stroke = 1.2,
		XAlign = Enum.TextXAlignment.Left,
		Parent = hero,
	})

	-- level progress
	local progress: Frame = Create("Frame", {
		Name = "Progress",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 204),
		Size = UDim2.new(1, 0, 0, 120),
		Parent = content,
	})
	local levelText = Create.Text({
		Name = "Level",
		Text = "",
		Size = UDim2.new(0.6, 0, 0, 40),
		Font = Theme.Fonts.Display,
		TextSize = 38,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 3,
		Parent = progress,
	})
	local percent = Create.Text({
		Name = "Percent",
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.3, 0, 0, 40),
		Font = Theme.Fonts.Display,
		TextSize = 38,
		Scaled = true,
		Color = PINK,
		XAlign = Enum.TextXAlignment.Right,
		Stroke = 3,
		Parent = progress,
	})
	local track: Frame = Create("Frame", {
		Name = "Track",
		BackgroundColor3 = Theme.Colors.LevelTrack,
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 44),
		ClipsDescendants = true,
		Parent = progress,
	})
	Create.Corner(12, track)
	Create.Stroke(track, Theme.Colors.Stroke, 3, 0, true)
	local fill: Frame = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(0.02, 1),
		Parent = track,
	})
	Create.Corner(12, fill)
	Create.Gradient(fill, hex("#FF9ED2"), hex("#D7267A"), 90)
	local barText = Create.Text({
		Name = "BarText",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -20, 0.72, 0),
		Font = Theme.Fonts.Display,
		TextSize = 28,
		Scaled = true,
		Stroke = 2.4,
		ZIndex = 3,
		Parent = track,
	})
	local nextCap = Create.Text({
		Name = "NextCap",
		Text = "",
		Position = UDim2.fromOffset(0, 94),
		Size = UDim2.new(1, 0, 0, 26),
		Font = Theme.Fonts.Body,
		TextSize = 22,
		Scaled = true,
		Color = Theme.Colors.TextDim,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 1.2,
		Parent = progress,
	})

	-- resets / keeps / unlocks
	local colW = math.floor((PANEL.X - 36 - 2 * 14) / 3)
	local colTop = 334
	local colH = 200
	local resets = card(content, "Resets", UDim2.fromOffset(0, colTop), UDim2.fromOffset(colW, colH), Theme.Colors.Danger, "RESETS")
	line(resets, Theme.Icons.Skill .. " Skill", 1)
	line(resets, Theme.Icons.Star .. " Level", 2)
	line(resets, "Everything else stays!", 3, Theme.Colors.TextMuted)
	local keeps = card(content, "Keeps", UDim2.fromOffset(colW + 14, colTop), UDim2.fromOffset(colW, colH), Theme.Colors.Success, "KEEPS")
	line(keeps, Theme.Icons.Wins .. " Wins", 1)
	line(keeps, Theme.Icons.Glider .. " Gliders", 2)
	line(keeps, Theme.Icons.Pets .. " Pets", 3)
	line(keeps, Theme.Icons.Trails .. " Trails", 4)
	line(keeps, Theme.Icons.World .. " Worlds", 5)
	local unlockList = card(content, "Unlocks", UDim2.fromOffset((colW + 14) * 2, colTop), UDim2.fromOffset(colW, colH), GOLD, "NEXT REBIRTH UNLOCKS")
	-- card() returns each card's line list; hide the whole card
	columns = { resets.Parent :: GuiObject, keeps.Parent :: GuiObject, unlockList.Parent :: GuiObject }
	local info = Create.Text({
		Name = "CompactInfo",
		Text = Theme.Icons.Skill .. " Resets Skill and Level  ·  " .. Theme.Icons.Wins .. " keeps Wins, gliders, pets, trails and worlds",
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, colTop),
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Scaled = true,
		Stroke = 2,
		Parent = content,
	})
	info.Visible = false
	compactInfo = info
	local unlocks: { TextLabel } = {}
	for i = 1, MAX_UNLOCK_LINES do
		local label = line(unlockList, "", i)
		label.Visible = false
		unlocks[i] = label
	end

	-- rebirth button with a pulsing glow when ready
	local glow: Frame = Create("Frame", {
		Name = "Glow",
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.6,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.fromOffset(480, 96),
		Visible = false,
		Parent = content,
	})
	Create.Corner(22, glow)
	glowTween = TweenService:Create(glow, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		BackgroundTransparency = 0.95,
	})
	local rebirthButton = Button.new({
		Parent = content,
		Name = "RebirthButton",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(440, 82),
		Style = "Pink",
		Shine = true,
		Text = Theme.Icons.Rebirth .. " REBIRTH",
		TextSize = 44,
		Corner = 16,
		OnClick = function()
			task.spawn(doRebirth)
		end,
	})

	refs = {
		Now = now,
		Next = nextLabel,
		Count = count,
		LevelText = levelText,
		Percent = percent,
		Fill = fill,
		BarText = barText,
		NextCap = nextCap,
		Unlocks = unlocks,
		Rebirth = rebirthButton,
		Glow = glow,
	}

	buildCelebration()
	UIController.Register("Rebirth", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
	refresh()
end

return RebirthScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="135">
              <Properties>
                <string name="Name">SettingsScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Settings menu ("Settings"): sound, camera and effects toggles plus a personal stats card.
-- Toggles send RequestSetting intents (cosmetic preferences); the sound toggle also applies
-- locally right away. Init() keeps AudioController in sync with the saved setting even if this
-- panel is never opened.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Definitions.Worlds)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local MenuShell = require(Components.MenuShell)
local MenuToggle = require(Components.MenuToggle)
local Icon = require(Components.Icon)

local SettingsScreen = {}

local PANEL = Vector2.new(1100, 640)

type Row = { Key: string, Title: string, Hint: string, Icon: string }

local ROWS: { Row } = {
	{ Key = "Sfx", Title = "Sound effects", Hint = "Chimes, splashes and wind", Icon = "🔊" },
	{ Key = "FollowCam", Title = "Follow camera", Hint = "Chases your glider", Icon = "🎥" },
	{ Key = "LowFx", Title = "Low effects", Hint = "For older devices", Icon = "✨" },
}

local shell: MenuShell.Shell
local toggles: { [string]: MenuToggle.Toggle } = {}
local statsLabel: TextLabel
local firstToggle: GuiObject? = nil

local function setting(data: { [string]: any }, key: string, default: boolean): boolean
	local settings = data.Settings
	if type(settings) == "table" and type(settings[key]) == "boolean" then
		return settings[key]
	end
	return default
end

local function statsText(data: { [string]: any }): string
	local stats = if type(data.Stats) == "table" then data.Stats else {}
	local lines = {
		string.format("%s Throws: %s", Theme.Icons.Glider, Format.Commas(stats.Throws or 0)),
		string.format("%s Perfect catches: %s", Theme.Icons.Star, Format.Commas(stats.Perfects or 0)),
		string.format("%s Rebirths: %s", Theme.Icons.Rebirth, Format.Commas(data.Rebirths or 0)),
		string.format("%s Eggs hatched: %s", Theme.Icons.Egg, Format.Commas(stats.Hatches or 0)),
		string.format("%s Total Wins: %s", Theme.Icons.Wins, Format.Short(stats.TotalWins or 0)),
		string.format("%s Total Skill: %s", Theme.Icons.Skill, Format.Short(stats.TotalSkill or 0)),
		"",
		"BEST GLIDE PER WORLD",
	}
	local best = if type(data.Best) == "table" then data.Best else {}
	for _, world in Worlds.List do
		local meters = best[tostring(world.Id)]
		table.insert(lines, string.format("%s %s: %s", Theme.Icons.World, world.Name, if type(meters) == "number" then Format.Meters(meters) else "-"))
	end
	return table.concat(lines, "\n")
end

local function refresh()
	local data = StateController.Data
	if data == nil then
		return
	end
	toggles.Sfx:Set(setting(data, "Sfx", true))
	toggles.FollowCam:Set(setting(data, "FollowCam", true))
	toggles.LowFx:Set(setting(data, "LowFx", false))
	statsLabel.Text = statsText(data)
end

function SettingsScreen.Init()
	shell = MenuShell.new({
		Name = "Settings",
		Title = "Settings",
		Icon = Theme.Icons.Settings,
		Size = PANEL,
		Accent = Theme.Colors.PanelEdge,
		OnOpen = function()
			refresh()
		end,
		FirstSelection = function()
			return firstToggle
		end,
	})
	local content = shell.Content
	local left: Frame = Create("Frame", {
		Name = "Toggles",
		BackgroundTransparency = 1,
		Size = UDim2.new(0.56, -10, 1, 0),
		Parent = content,
	})
	Create.List(left, Enum.FillDirection.Vertical, 14)
	for i, row in ROWS do
		local frame: Frame = Create("Frame", {
			Name = row.Key,
			BackgroundColor3 = Theme.Colors.Card,
			Size = UDim2.new(1, 0, 0, 104),
			LayoutOrder = i,
			Parent = left,
		})
		Create.Corner(14, frame)
		Create.Stroke(frame, Theme.Colors.PanelBorder, 2, 0, true)
		Icon.new({
			Icon = row.Icon,
			Size = UDim2.fromOffset(64, 64),
			Position = UDim2.new(0, 14, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			TextSize = 46,
			Parent = frame,
		})
		Create.Text({
			Text = row.Title,
			Size = UDim2.new(1, -260, 0, 36),
			Position = UDim2.fromOffset(92, 16),
			Font = Theme.Fonts.Display,
			TextSize = 30,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2,
			Parent = frame,
		})
		Create.Text({
			Text = row.Hint,
			Size = UDim2.new(1, -260, 0, 28),
			Position = UDim2.fromOffset(92, 56),
			Font = Theme.Fonts.Body,
			TextSize = 22,
			Scaled = true,
			Color = Theme.Colors.TextDim,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 1,
			Parent = frame,
		})
		local key = row.Key
		local toggle = MenuToggle.new({
			Parent = frame,
			Name = "Toggle",
			Value = key ~= "LowFx",
			Position = UDim2.new(1, -16, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			OnChanged = function(value: boolean)
				if key == "Sfx" then
					AudioController.SetEnabled(value)
				end
				Net.Fire("RequestSetting", key, value)
			end,
		})
		toggles[key] = toggle
		if i == 1 then
			firstToggle = toggle.Instance
		end
	end

	local right: Frame = Create("Frame", {
		Name = "Stats",
		BackgroundColor3 = Theme.Colors.CardDeep,
		Size = UDim2.new(0.44, -10, 1, 0),
		Position = UDim2.new(0.56, 10, 0, 0),
		Parent = content,
	})
	Create.Corner(14, right)
	Create.Stroke(right, Theme.Colors.PanelEdge, 2, 0.4, true)
	Create.Text({
		Text = "📊 YOUR STATS",
		Size = UDim2.new(1, -24, 0, 40),
		Position = UDim2.fromOffset(12, 10),
		Font = Theme.Fonts.Display,
		TextSize = 32,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		Parent = right,
	})
	statsLabel = Create.Text({
		Name = "Lines",
		Text = "",
		Size = UDim2.new(1, -28, 1, -64),
		Position = UDim2.fromOffset(14, 58),
		Font = Theme.Fonts.Body,
		TextSize = 24,
		XAlign = Enum.TextXAlignment.Left,
		YAlign = Enum.TextYAlignment.Top,
		Wrapped = true,
		Stroke = 1.2,
		Parent = right,
	})

	UIController.Register("Settings", shell)
	StateController.DataChanged:Connect(function(data)
		if data then
			AudioController.SetEnabled(setting(data, "Sfx", true))
		end
		if shell:IsOpen() then
			refresh()
		end
	end)
end

return SettingsScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="136">
              <Properties>
                <string name="Name">ShopScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Shop menu ("Shop"): tabs Passes / Skill / Potions / Codes with the codes box pinned to the
-- bottom of the panel like the genre. Offers come from Config/Monetization; every buy button only
-- sends a RequestPurchase intent (the server opens the Roblox prompt, or in Studio grants a free
-- TEST for ids left at 0). Unconfigured ids show "TEST (Studio)" in Studio and a disabled "SOON"
-- in live servers. UIController.Open("Shop", tab?) jumps to "Passes" | "Skill" | "Potions" | "Codes".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Boosts = require(Shared.Definitions.Boosts)
local Eggs = require(Shared.Definitions.Eggs)
local Pets = require(Shared.Definitions.Pets)
local Worlds = require(Shared.Definitions.Worlds)
local Rarity = require(Shared.Config.Rarity)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)
local MenuTabs = require(Components.MenuTabs)
local MenuCard = require(Components.MenuCard)
local MenuGrid = require(Components.MenuGrid)

local ShopScreen = {}

local hex = Color3.fromHex
local IS_STUDIO = RunService:IsStudio()

local PANEL = Vector2.new(1240, 740)
local WIDTH = PANEL.X - 36 -- Panel content width
local TAB_H = 64
local CODES_H = 76
local PAGE_TOP = TAB_H + 12

local TABS = {
	{ Key = "Passes", Text = "Passes", Icon = "💎", Style = "Pink" },
	{ Key = "Skill", Text = "Skill", Icon = Theme.Icons.Skill, Style = "Gold" },
	{ Key = "Potions", Text = "Potions", Icon = Theme.Icons.Potion, Style = "Green" },
	{ Key = "Codes", Text = "Codes", Icon = Theme.Icons.Codes, Style = "Purple" },
}

-- Monetization pass Icon keys -> emoji
local PASS_ICONS: { [string]: string } = {
	Auto = Theme.Icons.Auto,
	Skill = Theme.Icons.Skill,
	Wins = Theme.Icons.Wins,
	Pet = Theme.Icons.Pets,
	Egg = Theme.Icons.Egg,
	Pad = "🏋️",
}

local PASS_ACCENTS: { [string]: string } = {
	AutoThrow = "#FF5A5A",
	DoubleSkill = "#FFD447",
	DoubleWins = "#5BE05B",
	PetSlots = "#FFB86B",
	TripleHatch = "#C98CFF",
	Pad3x = "#5FB8FF",
	Pad15x = "#FF7F50",
	Pad50x = "#FFC53D",
}

local PASS_BADGES: { [string]: string } = {
	DoubleSkill = "POPULAR",
	Pad50x = "BEST",
}

type PackLook = { Accent: string, Rainbow: boolean, Badge: string? }

local SKILL_PACKS: { [string]: PackLook } = {
	Skill10K = { Accent = "#FFD447", Rainbow = false },
	Skill100K = { Accent = "#FF5A5A", Rainbow = false },
	Skill1M = { Accent = "#B65CFF", Rainbow = true, Badge = "BEST VALUE" },
}

type Entry = (data: { [string]: any }) -> ()

local shell: MenuShell.Shell
local tabs: MenuTabs.Tabs
local pages: { [string]: GuiObject } = {}
local codesBar: Frame
local compact = false
local currentPage = "Passes"
local updaters: { Entry } = {}
local codeBox: TextBox
local codeStroke: UIStroke

-- Button text/style/enabled for a Robux offer.
local function priceAction(id: number, robux: number, owned: boolean): (string, string, boolean)
	if owned then
		return "OWNED", "Grey", false
	end
	if id == 0 then
		if IS_STUDIO then
			return "TEST (Studio)", "Orange", true
		end
		return "SOON", "Disabled", false
	end
	return Theme.Icons.Robux .. " " .. tostring(robux), "Green", true
end

local function buy(kind: string, key: string)
	Net.Invoke("RequestPurchase", false, kind, key)
end

local function currentWorld(data: { [string]: any }): Worlds.World
	return Worlds.Get(if type(data.World) == "number" then data.World else 1) or Worlds.List[1]
end

local function refresh()
	local data = StateController.Data
	if data == nil then
		return
	end
	for _, update in updaters do
		update(data)
	end
end

-- Pages -------------------------------------------------------------------------------------------

local function buildPasses(parent: Frame)
	local columns = 4
	local grid = MenuGrid.new({
		Parent = parent,
		Name = "PassesGrid",
		Size = UDim2.fromScale(1, 1),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, columns), 318),
	})
	for i, pass in Monetization.Passes do
		local card = MenuCard.new({
			Parent = grid,
			Name = pass.Key,
			LayoutOrder = i,
			Accent = hex(PASS_ACCENTS[pass.Key] or "#5FB8FF"),
			Icon = PASS_ICONS[pass.Icon] or Theme.Icons.Star,
			Title = pass.Name,
			Subtitle = "GAME PASS",
			Description = pass.Description,
			ButtonText = "",
			OnClick = function()
				buy("Pass", pass.Key)
			end,
		})
		table.insert(updaters, function()
			local owned = StateController.HasPass(pass.Key)
			local text, style, enabled = priceAction(pass.Id, pass.Robux, owned)
			card:SetAction(text, style, enabled)
			if owned then
				card:SetBadge("OWNED", Theme.Colors.Success)
			elseif PASS_BADGES[pass.Key] then
				card:SetBadge(PASS_BADGES[pass.Key], Theme.Colors.Danger)
			else
				card:SetBadge(nil)
			end
		end)
	end
end

local function starterPackText(): string
	local pack = Monetization.StarterPack
	local lines = {}
	local pet = Pets.Get(pack.Pet)
	if pet then
		table.insert(lines, string.format("%s %s (x%s Skill)", Theme.Icons.Pets, pet.Name, Format.Short(1 + pet.SkillBoost)))
	end
	local parts = {}
	for _, boost in Boosts.List do
		local n = pack.Potions[boost.Id]
		if n and n > 0 then
			table.insert(parts, string.format("%d %s", n, boost.Stat))
		end
	end
	if #parts > 0 then
		table.insert(lines, Theme.Icons.Potion .. " " .. table.concat(parts, ", ") .. " potions")
	end
	table.insert(lines, Theme.Icons.Wins .. " " .. Format.Commas(pack.Wins) .. " Wins")
	return table.concat(lines, "\n")
end

local function overlordText(egg: Eggs.Egg?): string
	if egg == nil then
		return "Hatch one premium egg."
	end
	local best: Pets.Pet? = nil
	for _, entry in egg.Pets do
		local pet = Pets.Get(entry.Pet)
		if pet and (best == nil or Rarity.Order(pet.Rarity) > Rarity.Order(best.Rarity)) then
			best = pet
		end
	end
	local text = "Hatch one " .. egg.Name .. " in any world."
	if best then
		text ..= string.format("\nChance at %s (x%s Skill)!", best.Name, Format.Short(1 + best.SkillBoost))
	end
	return text
end

local function buildSkill(parent: Frame)
	local columns = 3
	local grid = MenuGrid.new({
		Parent = parent,
		Name = "SkillGrid",
		Size = UDim2.fromScale(1, 1),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, columns), 340),
	})
	local order = 0
	for _, product in Monetization.Products do
		if product.Kind ~= "Skill" then
			continue
		end
		order += 1
		local look: PackLook = SKILL_PACKS[product.Key] or { Accent = "#FFD447", Rainbow = false, Badge = nil }
		local card = MenuCard.new({
			Parent = grid,
			Name = product.Key,
			LayoutOrder = order,
			Accent = hex(look.Accent),
			Rainbow = look.Rainbow,
			Icon = Theme.Icons.Skill,
			Title = product.Name,
			Subtitle = "",
			Description = "Instant Skill, scaled up in every new world. Still pays at MAX LEVEL.",
			ButtonText = "",
			OnClick = function()
				buy("Product", product.Key)
			end,
		})
		table.insert(updaters, function(data)
			local world = currentWorld(data)
			card:SetTitle("+" .. Format.Short((product.Amount or 0) * world.SkillPackScale) .. " Skill")
			card:SetSubtitle("in " .. world.Name)
			local text, style, enabled = priceAction(product.Id, product.Robux, false)
			card:SetAction(text, style, enabled)
			card:SetBadge(look.Badge, Theme.Colors.Danger)
		end)
	end

	local starter = Monetization.Product("StarterPack")
	if starter then
		local product = starter
		local card = MenuCard.new({
			Parent = grid,
			Name = "StarterPack",
			LayoutOrder = 10,
			Accent = hex("#FFB300"),
			Icon = Theme.Icons.Star,
			Title = product.Name,
			Subtitle = "ONE TIME ONLY",
			Description = starterPackText(),
			ButtonText = "",
			OnClick = function()
				buy("Product", product.Key)
			end,
		})
		table.insert(updaters, function(data)
			local owned = type(data.Flags) == "table" and data.Flags.StarterPack == true
			local text, style, enabled = priceAction(product.Id, product.Robux, owned)
			card:SetAction(text, style, enabled)
			card:SetBadge(if owned then "OWNED" else "HOT", if owned then Theme.Colors.Success else Theme.Colors.Danger)
		end)
	end

	local overlord = Monetization.Product("OverlordEgg")
	if overlord then
		local product = overlord
		local egg = Eggs.Get(product.Ref or "")
		local card = MenuCard.new({
			Parent = grid,
			Name = "OverlordEgg",
			LayoutOrder = 11,
			Accent = hex(if egg then egg.Accent else "#39FF14"),
			Icon = Theme.Icons.Egg,
			Title = product.Name,
			Subtitle = "PREMIUM EGG",
			Description = overlordText(egg),
			ButtonText = "",
			OnClick = function()
				buy("Product", product.Key)
			end,
		})
		table.insert(updaters, function()
			local text, style, enabled = priceAction(product.Id, product.Robux, false)
			card:SetAction(text, style, enabled)
		end)
	end
end

local function buildPotions(parent: Frame)
	local columns = 3
	local grid = MenuGrid.new({
		Parent = parent,
		Name = "PotionsGrid",
		Size = UDim2.fromScale(1, 1),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, columns), 340),
		Center = true,
	})
	local order = 0
	for _, product in Monetization.Products do
		if product.Kind ~= "Potion" then
			continue
		end
		order += 1
		local boost = Boosts.Get(product.Ref or "")
		local minutes = if boost then math.floor(boost.Duration / 60) else 10
		local card = MenuCard.new({
			Parent = grid,
			Name = product.Key,
			LayoutOrder = order,
			Accent = hex(if boost then boost.Color else "#5BE05B"),
			Icon = Theme.Icons.Potion,
			Title = product.Name,
			Subtitle = "",
			Description = string.format(
				"%d potions. Each one doubles your %s for %d minutes. Timers stack!",
				product.Amount or 1,
				if boost then boost.Stat else "Skill",
				minutes
			),
			ButtonText = "",
			OnClick = function()
				buy("Product", product.Key)
			end,
		})
		table.insert(updaters, function(data)
			local potions = if type(data.Potions) == "table" then data.Potions else {}
			local owned = tonumber(potions[product.Ref or ""]) or 0
			card:SetSubtitle("You own: " .. Format.Commas(owned))
			local text, style, enabled = priceAction(product.Id, product.Robux, false)
			card:SetAction(text, style, enabled)
		end)
	end
end

local function buildCodes(parent: Frame)
	local box: Frame = Create("Frame", {
		Name = "CodesInfo",
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.2,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -40, 1, -30),
		Parent = parent,
	})
	Create.Corner(18, box)
	Create.Stroke(box, hex("#C98CFF"), 3, 0.2, true)
	Create.Text({
		Name = "Ticket",
		Text = Theme.Icons.Codes,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 22),
		Size = UDim2.fromOffset(150, 130),
		Font = Theme.Fonts.Display,
		TextSize = 110,
		Scaled = true,
		Parent = box,
	})
	Create.Text({
		Name = "Headline",
		Text = "REDEEM CODES",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 160),
		Size = UDim2.new(1, -60, 0, 60),
		Font = Theme.Fonts.Display,
		TextSize = 58,
		Scaled = true,
		Color = hex("#E6C9FF"),
		Stroke = 4,
		Parent = box,
	})
	Create.Text({
		Name = "Body",
		Text = "Type a code in the box below and press REDEEM for free Wins, Skill and potions.\nCodes are not case-sensitive and each one works once per player.",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 232),
		Size = UDim2.new(1, -100, 0, 110),
		Font = Theme.Fonts.Body,
		TextSize = 26,
		Scaled = true,
		Wrapped = true,
		Color = Theme.Colors.TextDim,
		Stroke = 1.5,
		Parent = box,
	})
	Create.Text({
		Name = "Arrow",
		Text = "⬇️",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(60, 52),
		Font = Theme.Fonts.Display,
		TextSize = 44,
		Scaled = true,
		Parent = box,
	})
end

-- Codes bar (bottom of every tab) ------------------------------------------------------------------

local function trim(s: string): string
	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
end

local function redeem()
	local text = trim(codeBox.Text)
	if text == "" then
		UIController.Toast("Type a code first!", "Error")
		return
	end
	local result = Net.Invoke("RequestRedeemCode", false, text)
	if result.ok then
		codeBox.Text = ""
	end
end

local function buildCodesBar(parent: Frame)
	local bar: Frame = Create("Frame", {
		Name = "CodesBar",
		BackgroundColor3 = Theme.Colors.PanelDeep,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, CODES_H),
		Parent = parent,
	})
	codesBar = bar
	Create.Corner(16, bar)
	codeStroke = Create.Stroke(bar, hex("#C98CFF"), 3, 0, true)
	Create.Text({
		Name = "Label",
		Text = Theme.Icons.Codes .. " CODES",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 18, 0.5, 0),
		Size = UDim2.fromOffset(190, 48),
		Font = Theme.Fonts.Display,
		TextSize = 40,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 3,
		Parent = bar,
	})
	local input: TextBox = Create("TextBox", {
		Name = "CodeInput",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 220, 0.5, 0),
		Size = UDim2.new(1, -220 - 250, 0, 60),
		BackgroundColor3 = hex("#F2F5FA"),
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = "Enter code here...",
		PlaceholderColor3 = hex("#8C93A3"),
		TextColor3 = hex("#1B1F3B"),
		FontFace = Theme.Fonts.Display,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Selectable = true,
		Parent = bar,
	})
	Create.Corner(12, input)
	Create.Stroke(input, Theme.Colors.Stroke, 3, 0, true)
	Create.Padding(input, 16, 0)
	input:GetPropertyChangedSignal("Text"):Connect(function()
		if #input.Text > 32 then
			input.Text = string.sub(input.Text, 1, 32)
		end
	end)
	input.FocusLost:Connect(function(enterPressed: boolean)
		if enterPressed then
			redeem()
		end
	end)
	codeBox = input
	Button.new({
		Parent = bar,
		Name = "Redeem",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(222, 62),
		Style = "Green",
		Text = "REDEEM",
		TextSize = 34,
		Corner = 12,
		OnClick = redeem,
	})
end

local PULSE = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true)

-- Short panels (phones): the codes bar only shows on the Codes tab, other pages use its space.
local function layoutPages()
	local withBar = not compact or currentPage == "Codes"
	codesBar.Visible = withBar
	for _, page in pages do
		page.Size = UDim2.new(1, 0, 1, -(PAGE_TOP + (if withBar then CODES_H + 12 else 0)))
	end
end

local function showPage(key: string)
	currentPage = key
	for k, page in pages do
		page.Visible = k == key
	end
	layoutPages()
	if key == "Codes" then
		codeStroke.Thickness = 3
		TweenService:Create(codeStroke, PULSE, { Thickness = 7 }):Play()
		if UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled and not MenuShell.UsingGamepad() then
			codeBox:CaptureFocus()
		end
	end
end

function ShopScreen.Init()
	shell = MenuShell.new({
		Name = "Shop",
		Title = "Shop",
		Icon = Theme.Icons.Shop,
		Size = PANEL,
		Accent = hex("#FF8FC8"),
		OnOpen = function(tab: any)
			if type(tab) == "string" and pages[tab] then
				tabs:Select(tab, true)
				showPage(tab)
			end
			refresh()
		end,
		OnClose = function()
			if codeBox:IsFocused() then
				codeBox:ReleaseFocus()
			end
		end,
		OnShoulder = function(direction: number)
			tabs:Cycle(direction)
		end,
		OnResize = function(contentHeight: number)
			compact = contentHeight < 520
			layoutPages()
		end,
		FirstSelection = function()
			return tabs.Buttons[tabs.Selected].Instance
		end,
	})
	local content = shell.Content

	tabs = MenuTabs.new({
		Parent = content,
		Tabs = TABS,
		Size = UDim2.new(1, 0, 0, TAB_H),
		TabWidth = 220,
		OnChanged = showPage,
	})

	local builders: { [string]: (Frame) -> () } = {
		Passes = buildPasses,
		Skill = buildSkill,
		Potions = buildPotions,
		Codes = buildCodes,
	}
	for _, spec in TABS do
		local page: Frame = Create("Frame", {
			Name = spec.Key .. "Page",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, PAGE_TOP),
			Size = UDim2.new(1, 0, 1, -(PAGE_TOP + CODES_H + 12)), -- the panel is shorter on phones
			Visible = false,
			Parent = content,
		})
		pages[spec.Key] = page
		builders[spec.Key](page)
	end
	buildCodesBar(content)

	tabs:Select("Passes", true)
	showPage("Passes")

	UIController.Register("Shop", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
	refresh()
end

return ShopScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="137">
              <Properties>
                <string name="Name">TrailsScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Trails menu ("Trails"): every trail with its gradient swatch, Wins bonus and price.
-- Buy / Equip / Unequip are RequestTrailAction intents; the server spends the Wins.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Trails = require(Shared.Definitions.Trails)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local MenuShell = require(Components.MenuShell)
local MenuCard = require(Components.MenuCard)
local MenuGrid = require(Components.MenuGrid)

local TrailsScreen = {}

local PANEL = Vector2.new(1240, 740)
local WIDTH = PANEL.X - 36

local shell: MenuShell.Shell
local cards: { [string]: MenuCard.Card } = {}
local firstButton: GuiObject? = nil

local function gradientOf(trail: Trails.Trail): ColorSequence
	local keys = {}
	for i, h in trail.Colors do
		local t = if #trail.Colors == 1 then 0 else (i - 1) / (#trail.Colors - 1)
		table.insert(keys, ColorSequenceKeypoint.new(t, Color3.fromHex(h)))
	end
	if #keys == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, keys[1].Value))
	end
	return ColorSequence.new(keys)
end

local function refresh()
	local data = StateController.Data
	if data == nil then
		return
	end
	local owned = if type(data.Trails) == "table" then data.Trails else {}
	local wins = if type(data.Wins) == "number" then data.Wins else 0
	for _, trail in Trails.List do
		local card = cards[trail.Id]
		if data.Trail == trail.Id then
			card:SetAction("UNEQUIP", "Orange", true)
			card:SetBadge("EQUIPPED", Theme.Colors.Success)
		elseif owned[trail.Id] then
			card:SetAction("EQUIP", "Blue", true)
			card:SetBadge("OWNED", Theme.Colors.PanelEdge)
		else
			local affordable = wins >= trail.Price
			card:SetAction(string.format("%s %s", Theme.Icons.Wins, Format.Short(trail.Price)), if affordable then "Green" else "Grey", true)
			card:SetBadge(nil)
		end
	end
end

local function act(trail: Trails.Trail)
	local data = StateController.Data
	if data == nil then
		return
	end
	local owned = if type(data.Trails) == "table" then data.Trails else {}
	local action = if data.Trail == trail.Id then "Unequip" elseif owned[trail.Id] then "Equip" else "Buy"
	task.spawn(Net.Invoke, "RequestTrailAction", false, action, trail.Id)
end

function TrailsScreen.Init()
	shell = MenuShell.new({
		Name = "Trails",
		Title = "Trails",
		Icon = Theme.Icons.Trails,
		Size = PANEL,
		Accent = Color3.fromHex("#B65CFF"),
		OnOpen = function()
			refresh()
		end,
		FirstSelection = function()
			return firstButton
		end,
	})
	local grid = MenuGrid.new({
		Parent = shell.Content,
		Name = "TrailGrid",
		Size = UDim2.fromScale(1, 1),
		Cell = Vector2.new(MenuGrid.CellWidth(WIDTH, 4), 300),
	})
	for i, trail in Trails.List do
		local card = MenuCard.new({
			Parent = grid,
			Name = trail.Id,
			LayoutOrder = i,
			Accent = Theme.Rarity(trail.Rarity),
			Rainbow = trail.Rarity == "Mythic",
			Icon = Theme.Icons.Trails,
			Title = trail.Name,
			Subtitle = string.format("+%s%% Wins", Format.Short(trail.WinsBoost * 100)),
			Description = string.upper(trail.Rarity),
			ButtonText = "",
			OnClick = function()
				act(trail)
			end,
		})
		-- gradient swatch across the top of the card
		local swatch: Frame = Create("Frame", {
			Name = "Swatch",
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.new(1, -24, 0, 12),
			Position = UDim2.fromOffset(12, 8),
			ZIndex = 4,
			Parent = card.Instance,
		})
		Create.Corner(6, swatch)
		local g = Instance.new("UIGradient")
		g.Color = gradientOf(trail)
		g.Parent = swatch
		cards[trail.Id] = card
		if i == 1 and card.Button then
			firstButton = card.Button.Instance
		end
	end
	UIController.Register("Trails", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
end

return TrailsScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="138">
              <Properties>
                <string name="Name">WorldScreen</string>
                <string name="Source"><![CDATA[--!strict
-- World portal menu ("World"): opened from a portal with UIController.Open("World", worldId).
-- Shows the world, its two unlock requirements (reach the end of the previous river + rebirths)
-- with check marks, and a Travel button that sends a RequestEnterWorld intent. The server
-- re-checks everything; this screen only explains what is missing.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Themes = require(Shared.Visual.Themes)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent.Parent
local StateController = require(Client.Controllers.StateController)
local UIController = require(Client.Controllers.UIController)
local Net = require(Client.Controllers.Net)
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Components = Client.UI.Components
local Button = require(Components.Button)
local MenuShell = require(Components.MenuShell)

local WorldScreen = {}

local PANEL = Vector2.new(900, 600)

local shell: MenuShell.Shell
local worldId = 1
local swatch: Frame
local swatchGradient: UIGradient
local nameLabel: TextLabel
local descLabel: TextLabel
local stateLabel: TextLabel
local reqLabels: { TextLabel } = {}
local travelButton: Button.Button

type Requirement = { Text: string, Met: boolean }

local function requirements(world: Worlds.World, data: { [string]: any }): { Requirement }
	local out: { Requirement } = {}
	local zones = if type(data.Zones) == "table" then data.Zones else {}
	local rebirths = if type(data.Rebirths) == "number" then data.Rebirths else 0
	if world.UnlockZone then
		local zone = Zones.Get(world.UnlockZone)
		local prev = Worlds.Get(world.Id - 1)
		table.insert(out, {
			Text = string.format("Throw to %s in %s (%s)", if zone then zone.Name else "the end of the river", if prev then prev.Name else "the last world", if zone then Format.Meters(zone.Distance) else "?"),
			Met = zones[world.UnlockZone] == true,
		})
	end
	if world.UnlockRebirths > 0 then
		table.insert(out, { Text = string.format("Reach %d rebirths (you have %d)", world.UnlockRebirths, rebirths), Met = rebirths >= world.UnlockRebirths })
	end
	if world.UnlockWins > 0 then
		local wins = if type(data.Wins) == "number" then data.Wins else 0
		table.insert(out, { Text = string.format("Pay %s Wins", Format.Short(world.UnlockWins)), Met = wins >= world.UnlockWins })
	end
	return out
end

local function refresh()
	local data = StateController.Data
	local world = Worlds.Get(worldId)
	if data == nil or world == nil then
		return
	end
	local theme = Themes[world.Theme]
	if theme then
		swatchGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHex(theme.Sky.Top)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHex(theme.Water)),
			ColorSequenceKeypoint.new(1, Color3.fromHex(theme.FloorA)),
		})
	end
	nameLabel.Text = string.upper(world.Name)
	descLabel.Text = world.Description
	local unlocked = type(data.Worlds) == "table" and data.Worlds[tostring(world.Id)] == true
	local here = data.World == world.Id
	local reqs = if unlocked then {} else requirements(world, data)
	local allMet = true
	for i, label in reqLabels do
		local req = reqs[i]
		if req then
			label.Visible = true
			label.Text = (if req.Met then Theme.Icons.Check else Theme.Icons.Lock) .. "  " .. req.Text
			label.TextColor3 = if req.Met then Theme.Colors.Success else Theme.Colors.Text
			allMet = allMet and req.Met
		else
			label.Visible = false
		end
	end
	if unlocked then
		stateLabel.Text = if here then "YOU ARE HERE" else "UNLOCKED"
		stateLabel.TextColor3 = Theme.Colors.Success
	else
		stateLabel.Text = if allMet then "READY TO UNLOCK!" else "LOCKED"
		stateLabel.TextColor3 = if allMet then Theme.Colors.Skill else Theme.Colors.Danger
	end
	if here then
		travelButton:SetText("YOU ARE HERE")
		travelButton:SetStyle("Grey")
		travelButton:SetEnabled(false)
	elseif unlocked or allMet then
		travelButton:SetText(if unlocked then "TRAVEL" else "UNLOCK & TRAVEL")
		travelButton:SetStyle("Green")
		travelButton:SetEnabled(true)
	else
		travelButton:SetText("LOCKED")
		travelButton:SetStyle("Disabled")
		travelButton:SetEnabled(false)
	end
end

function WorldScreen.Init()
	shell = MenuShell.new({
		Name = "World",
		Title = "Portal",
		Icon = Theme.Icons.World,
		Size = PANEL,
		Accent = Color3.fromHex("#7CFFB2"),
		OnOpen = function(id: any)
			if type(id) == "number" and Worlds.Get(id) then
				worldId = id
			end
			refresh()
		end,
		FirstSelection = function()
			return travelButton.Instance
		end,
	})
	local content = shell.Content
	swatch = Create("Frame", {
		Name = "Swatch",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, 150),
		Parent = content,
	})
	Create.Corner(16, swatch)
	swatchGradient = Instance.new("UIGradient")
	swatchGradient.Rotation = 90
	swatchGradient.Parent = swatch
	nameLabel = Create.Text({
		Text = "",
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.fromOffset(20, 18),
		Font = Theme.Fonts.Display,
		TextSize = 64,
		Scaled = true,
		Stroke = 4,
		Parent = swatch,
	})
	descLabel = Create.Text({
		Text = "",
		Size = UDim2.new(1, -40, 0, 34),
		Position = UDim2.fromOffset(20, 96),
		Font = Theme.Fonts.Body,
		TextSize = 28,
		Scaled = true,
		Stroke = 2,
		Parent = swatch,
	})
	stateLabel = Create.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.fromOffset(0, 166),
		Font = Theme.Fonts.Display,
		TextSize = 40,
		Scaled = true,
		Stroke = 3,
		Parent = content,
	})
	for i = 1, 3 do
		reqLabels[i] = Create.Text({
			Name = "Req" .. i,
			Text = "",
			Size = UDim2.new(1, -40, 0, 40),
			Position = UDim2.fromOffset(20, 220 + (i - 1) * 48),
			Font = Theme.Fonts.Body,
			TextSize = 28,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 1.8,
			Parent = content,
		})
	end
	travelButton = Button.new({
		Parent = content,
		Name = "Travel",
		Size = UDim2.fromOffset(420, 76),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		Style = "Green",
		Text = "TRAVEL",
		TextSize = 34,
		OnClick = function()
			local target = worldId
			task.spawn(function()
				local result = Net.Invoke("RequestEnterWorld", false, target)
				if result.ok then
					UIController.Close("World")
				end
			end)
		end,
	})
	UIController.Register("World", shell)
	StateController.DataChanged:Connect(function()
		if shell:IsOpen() then
			refresh()
		end
	end)
end

return WorldScreen
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Design tokens for the HUD and menus: bright, chunky "+1 simulator" style (ORIGINAL palette).
-- Big rounded display font with heavy dark strokes, saturated gradient buttons, deep-blue panels.
-- Like the genre's big simulators, every control is a raised 3D key: a gradient face with a thick
-- dark outline sitting on a darker base (Theme.Depth), pressing sinks it, and calls to action glint.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rarity = require(ReplicatedStorage:WaitForChild("Shared").Config.Rarity)

local Theme = {}

local hex = Color3.fromHex

Theme.Colors = {
	Panel = hex("#1E3F9E"),
	PanelDeep = hex("#132B73"),
	PanelLight = hex("#2C56C9"),
	PanelBorder = hex("#0B1A4A"),
	PanelEdge = hex("#7FB2FF"),
	Card = hex("#2A50B8"),
	CardDeep = hex("#183A91"),
	CardBorder = hex("#0B1A4A"),
	Text = hex("#FFFFFF"),
	TextDim = hex("#CFE0FF"),
	TextMuted = hex("#8FA6D9"),
	Stroke = hex("#0B0F24"),
	Skill = hex("#FFD447"),
	Wins = hex("#FFC53D"),
	Rebirth = hex("#FF5FB0"),
	Gem = hex("#4FC3FF"),
	Success = hex("#5BE05B"),
	Danger = hex("#FF4F5E"),
	Warning = hex("#FFB300"),
	LevelTrack = hex("#0E1F57"),
	LevelFillTop = hex("#5FB8FF"),
	LevelFillBottom = hex("#2563EB"),
	Locked = hex("#FF4F5E"),
	Unlocked = hex("#5BE05B"),
	Meter = hex("#1B1F3B"),
	MeterGood = hex("#5BE05B"),
	MeterPerfect = hex("#FFD447"),
	Overlay = hex("#000000"),
}

Theme.Fonts = {
	Display = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Regular),
	Body = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold),
	BodyHeavy = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy),
	Numbers = Font.new("rbxasset://fonts/families/LuckiestGuy.json", Enum.FontWeight.Regular),
}

export type ButtonStyle = { Top: Color3, Bottom: Color3, Border: Color3, Text: Color3 }

Theme.Buttons = {
	Green = { Top = hex("#7BEA4A"), Bottom = hex("#2FA80F"), Border = hex("#124A05"), Text = hex("#FFFFFF") },
	Blue = { Top = hex("#5FB8FF"), Bottom = hex("#2563EB"), Border = hex("#0B2266"), Text = hex("#FFFFFF") },
	Red = { Top = hex("#FF6B6B"), Bottom = hex("#D7263D"), Border = hex("#5E0A14"), Text = hex("#FFFFFF") },
	Gold = { Top = hex("#FFE27A"), Bottom = hex("#F2A900"), Border = hex("#6B4300"), Text = hex("#FFFFFF") },
	Orange = { Top = hex("#FFB86B"), Bottom = hex("#F07800"), Border = hex("#6B3000"), Text = hex("#FFFFFF") },
	Purple = { Top = hex("#C98CFF"), Bottom = hex("#7A2BD6"), Border = hex("#33106B"), Text = hex("#FFFFFF") },
	Pink = { Top = hex("#FF8FC8"), Bottom = hex("#E8357F"), Border = hex("#6B1035"), Text = hex("#FFFFFF") },
	Grey = { Top = hex("#F2F5FA"), Bottom = hex("#AEB8C8"), Border = hex("#3A4256"), Text = hex("#FFFFFF") },
	Dark = { Top = hex("#2C56C9"), Bottom = hex("#183A91"), Border = hex("#0B1A4A"), Text = hex("#FFFFFF") },
	Disabled = { Top = hex("#8C93A3"), Bottom = hex("#5A6070"), Border = hex("#2A2E38"), Text = hex("#DDE1E8") },
} :: { [string]: ButtonStyle }

-- Raised 3D controls: height of the darker base under button and tile faces (design px), the dark
-- outline around them, and the soft drop shadow under panels.
Theme.Depth = 6
Theme.Outline = 3
Theme.Shadow = { Color = hex("#040A24"), Transparency = 0.5, Offset = 10 }

-- A colour multiplied toward black (f = 0.55 keeps 55 %), for bases and shadows.
function Theme.Darken(c: Color3, f: number): Color3
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- Toast kinds: colour-coded pills (green good, red error, blue info, gold level, purple rare).
Theme.Toasts = {
	Info = { Style = "Blue", Icon = "💬" },
	Success = { Style = "Green", Icon = "✅" },
	Error = { Style = "Red", Icon = "⛔" },
	Level = { Style = "Gold", Icon = "⭐" },
	Rare = { Style = "Purple", Icon = "💎" },
} :: { [string]: { Style: string, Icon: string } }

-- Rainbow gradient (the "+1M" pack button, mythic items)
Theme.Rainbow = ColorSequence.new({
	ColorSequenceKeypoint.new(0, hex("#FF4F4F")),
	ColorSequenceKeypoint.new(0.25, hex("#FFC53D")),
	ColorSequenceKeypoint.new(0.5, hex("#5BE05B")),
	ColorSequenceKeypoint.new(0.75, hex("#3FA9FF")),
	ColorSequenceKeypoint.new(1, hex("#B65CFF")),
})

-- Emoji icons. Components show them through Components/Icon, which swaps in the matching 3D icon
-- image (assets/icons, Config/AssetIds) once it is uploaded; the emoji stays as the fallback.
Theme.Icons = {
	Skill = "⚡",
	Wins = "🏆",
	Rebirth = "🌀",
	Shop = "🛒",
	Pets = "🐾",
	Trails = "💫",
	Inventory = "🎒",
	Gifts = "🎁",
	Settings = "⚙️",
	Codes = "🎟️",
	Daily = "📅",
	Egg = "🥚",
	Lock = "🔒",
	Check = "✅",
	Potion = "🧪",
	Luck = "🍀",
	Star = "⭐",
	Friends = "👥",
	Auto = "🔁",
	World = "🌍",
	Glider = "🪁",
	Relic = "🔥",
	Admin = "🛠️",
	Index = "📖",
	Pass = "💎",
	Pad = "🏋️",
	Info = "💬",
	Error = "⛔",
	Sparkles = "✨",
	Sound = "🔊",
	Camera = "🎥",
	Stats = "📊",
	Crown = "👑",
	Robux = "R$",
}

function Theme.Rarity(id: string): Color3
	return hex(Rarity.Get(id).Color)
end

function Theme.RarityDark(id: string): Color3
	return hex(Rarity.Get(id).Dark)
end

function Theme.RarityLight(id: string): Color3
	return hex(Rarity.Get(id).Light)
end

-- Base design resolution. Screens are authored in these pixels; UIController scales them.
Theme.DesignSize = Vector2.new(1800, 920)

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="140">
          <Properties>
            <string name="Name">VFX</string>
          </Properties>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Reusable, pooled visual effects (client-only). Everything is cosmetic: the server never waits
-- on these. Particle textures use Roblox built-in content, so no uploaded assets are needed.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Effects = {}

local folder: Folder
local emitterPool: { BasePart } = {}
local rng = Random.new()

local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local function ensureFolder(): Folder
	if not folder or folder.Parent == nil then
		local f = Instance.new("Folder")
		f.Name = "ClientVFX"
		f.Parent = Workspace
		folder = f
	end
	return folder
end

local function basicPart(shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end
Effects.Part = basicPart

local function emitter(): BasePart
	local p = table.remove(emitterPool)
	if p then
		return p
	end
	local part = basicPart()
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	local pe = Instance.new("ParticleEmitter")
	pe.Enabled = false
	pe.Texture = SPARK_TEXTURE
	pe.LightEmission = 0.8
	pe.LightInfluence = 0
	pe.Drag = 4
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = part
	part.Parent = ensureFolder()
	return part
end

-- Burst of sparks.
function Effects.Sparks(pos: Vector3, color: Color3, count: number, speed: number?, size: number?, texture: string?)
	local part = emitter()
	part.Position = pos
	local pe = part:FindFirstChildOfClass("ParticleEmitter") :: ParticleEmitter
	pe.Texture = texture or SPARK_TEXTURE
	pe.Color = ColorSequence.new(color)
	local s = size or 0.6
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	pe.Speed = NumberRange.new((speed or 14) * 0.5, speed or 14)
	pe.Lifetime = NumberRange.new(0.25, 0.5)
	pe:Emit(count)
	task.delay(0.8, function()
		table.insert(emitterPool, part)
	end)
end

function Effects.Smoke(pos: Vector3, color: Color3, count: number)
	Effects.Sparks(pos, color, count, 4, 1.4, SMOKE_TEXTURE)
end

-- Neon ball that expands and fades (impact flash).
function Effects.Flash(pos: Vector3, diameter: number, color: Color3, duration: number?)
	local p = basicPart(Enum.PartType.Ball)
	p.Color = color
	p.Size = Vector3.one * diameter * 0.3
	p.Position = pos
	p.Transparency = 0.15
	p.Parent = ensureFolder()
	local d = duration or 0.25
	TweenService:Create(p, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * diameter, Transparency = 1 }):Play()
	Debris:AddItem(p, d + 0.05)
end

-- Expanding flat ring facing `normal`.
function Effects.Ring(pos: Vector3, normal: Vector3, radius: number, color: Color3, duration: number?, thickness: number?)
	local p = basicPart(Enum.PartType.Cylinder)
	p.Color = color
	p.Transparency = 0.2
	-- a vertical normal (rings on the ground) needs another up axis for lookAt
	local up = if math.abs(normal.Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local cf = CFrame.lookAt(pos, pos + normal, up) * CFrame.Angles(0, math.rad(90), 0)
	p.CFrame = cf
	p.Size = Vector3.new(thickness or 0.15, radius * 0.4, radius * 0.4)
	p.Parent = ensureFolder()
	local d = duration or 0.35
	TweenService:Create(p, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(thickness or 0.15, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(p, d + 0.05)
end

-- Small parts flung outward that fall and fade.
function Effects.Debris(pos: Vector3, colors: { Color3 }, count: number, size: number, speed: number, life: number, planeRight: Vector3?, planeUp: Vector3?, shape: Enum.PartType?)
	local right = planeRight or Vector3.xAxis
	local up = planeUp or Vector3.yAxis
	for i = 1, count do
		local p = basicPart(shape)
		p.Material = Enum.Material.SmoothPlastic
		p.Color = colors[(i - 1) % #colors + 1]
		p.Size = Vector3.one * size * rng:NextNumber(0.6, 1.2)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6))
		p.Parent = ensureFolder()
		local a = rng:NextNumber(0, 2 * math.pi)
		local v = speed * rng:NextNumber(0.5, 1)
		local dir = right * math.cos(a) + up * math.sin(a)
		local mid = pos + dir * v * life * 0.5 + up * v * 0.12
		local finish = pos + dir * v * life - up * 4
		TweenService:Create(p, TweenInfo.new(life * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = mid }):Play()
		task.delay(life * 0.5, function()
			TweenService:Create(p, TweenInfo.new(life * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = finish, Transparency = 1 }):Play()
		end)
		Debris:AddItem(p, life + 0.1)
	end
end

-- Jagged lightning between two points.
function Effects.Lightning(a: Vector3, b: Vector3, color: Color3, duration: number?)
	local segments = 7
	local dir = b - a
	local len = dir.Magnitude
	if len < 0.01 then
		return
	end
	local side = dir:Cross(Vector3.zAxis)
	if side.Magnitude < 0.01 then
		side = Vector3.xAxis
	end
	side = side.Unit
	local prev = a
	for i = 1, segments do
		local t = i / segments
		local point = a + dir * t
		if i < segments then
			point += side * rng:NextNumber(-1, 1) * len * 0.08
		end
		local seg = basicPart()
		seg.Color = color
		seg.Size = Vector3.new(0.22, 0.22, (point - prev).Magnitude)
		seg.CFrame = CFrame.lookAt((prev + point) / 2, point)
		seg.Parent = ensureFolder()
		TweenService:Create(seg, TweenInfo.new(duration or 0.25), { Transparency = 1 }):Play()
		Debris:AddItem(seg, (duration or 0.25) + 0.05)
		prev = point
	end
	Effects.Flash(b, 2.2, color, 0.2)
end

-- Beam connecting two parts for a while (leech tether etc.).
function Effects.Tether(a: BasePart, b: BasePart, color: Color3, duration: number)
	local a0 = Instance.new("Attachment")
	a0.Parent = a
	local a1 = Instance.new("Attachment")
	a1.Parent = b
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = 0.5
	beam.Width1 = 0.25
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Segments = 6
	beam.CurveSize0 = 1
	beam.Parent = a
	task.delay(duration, function()
		beam:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)
end

-- Floating text (damage numbers, dice rolls). Pooled BillboardGuis.
local popupPool: { BillboardGui } = {}
local popupAnchor: Part

function Effects.Popup(pos: Vector3, text: string, color: Color3, scale: number?)
	ensureFolder()
	if not popupAnchor then
		local anchor = basicPart()
		anchor.Transparency = 1
		anchor.Size = Vector3.one * 0.1
		anchor.Position = Vector3.zero
		anchor.Parent = folder
		popupAnchor = anchor
	end
	local gui = table.remove(popupPool)
	if gui == nil then
		local g = Instance.new("BillboardGui")
		g.Size = UDim2.new(3, 0, 1.4, 0)
		g.AlwaysOnTop = true
		g.LightInfluence = 0
		g.MaxDistance = 120
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.TextScaled = true
		label.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Heavy)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = label
		label.Parent = g
		gui = g
	end
	local g = gui :: BillboardGui
	local s = scale or 1
	g.Size = UDim2.new(3 * s, 0, 1.4 * s, 0)
	g.Adornee = popupAnchor
	g.StudsOffsetWorldSpace = pos
	local label = g:FindFirstChild("Text") :: TextLabel
	label.Text = text
	label.TextColor3 = color
	label.TextTransparency = 0
	local stroke = label:FindFirstChildOfClass("UIStroke") :: UIStroke
	stroke.Transparency = 0
	g.Parent = folder
	TweenService:Create(g, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = pos + Vector3.new(0, 1.6, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.35), { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.35), { Transparency = 1 }):Play()
	task.delay(0.75, function()
		g.Parent = nil
		table.insert(popupPool, g)
	end)
end

function Effects.Folder(): Folder
	return ensureFolder()
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">FlightFX</string>
              <string name="Source"><![CDATA[--!strict
-- Flight-specific cosmetic effects (client-only): launch puffs, special-throw bursts, landing
-- splashes with droplet arcs and a water plume, speed lines in front of the camera, and "+N" /
-- "PERFECT!" popups that ride along with a moving glider (world-anchored popups would be left
-- behind at flight speed). Everything is pooled. Step(dt) animates droplets and must be called
-- once per frame (FlightRenderer does). Data.Settings.LowFx scales particle counts down.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local StateController = require(Client.Controllers.StateController)
local AudioController = require(Client.Controllers.AudioController)
local Effects = require(script.Parent.Effects)

local FlightFX = {}

local WHITE = Color3.new(1, 1, 1)
local GOLD = Theme.Colors.Skill
local GRAVITY = Vector3.new(0, -70, 0)
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local UP_RING = Vector3.new(0, 1, 0.01) -- tiny tilt keeps CFrame.lookAt well defined

local rng = Random.new()
local folder: Folder? = nil

local function getFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local created = Instance.new("Folder")
	created.Name = "FlightFX"
	created.Parent = Effects.Folder()
	folder = created
	return created
end

-- True when the player picked reduced effects in Settings.
function FlightFX.Low(): boolean
	local data = StateController.Data
	local settings = data and data.Settings
	return type(settings) == "table" and settings.LowFx == true
end

-- Particle count after the LowFx reduction.
function FlightFX.Count(n: number): number
	if FlightFX.Low() then
		return math.max(1, math.floor(n * 0.35))
	end
	return n
end

--------------------------------------------------------------------------------------------------
-- Popups that follow an adornee (pooled BillboardGuis)
--------------------------------------------------------------------------------------------------

type Popup = { Gui: BillboardGui, Label: TextLabel, Stroke: UIStroke }

local popupPool: { Popup } = {}

local function newPopup(): Popup
	local gui = Instance.new("BillboardGui")
	gui.Name = "FlightPopup"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 600
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.FontFace = Theme.Fonts.Numbers
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Theme.Colors.Stroke
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return { Gui = gui, Label = label, Stroke = stroke }
end

-- Floating text above `adornee` that rises and fades. `height` is the start offset in studs.
function FlightFX.Popup(adornee: BasePart, text: string, color: Color3, scale: number?, height: number?, duration: number?)
	local p = table.remove(popupPool) or newPopup()
	local s = scale or 1
	local h = height or 2.4
	local d = duration or 0.8
	local size = UDim2.new(7 * s, 0, 2 * s, 0)
	p.Gui.Adornee = adornee
	p.Gui.Size = UDim2.new(3 * s, 0, 0.9 * s, 0)
	p.Gui.StudsOffset = Vector3.new(0, h, 0)
	p.Label.Text = text
	p.Label.TextColor3 = color
	p.Label.TextTransparency = 0
	p.Stroke.Transparency = 0
	p.Gui.Parent = getFolder()
	TweenService:Create(p.Gui, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = size }):Play()
	TweenService:Create(p.Gui, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = Vector3.new(0, h + 2.2 * s, 0),
	}):Play()
	local fade = TweenInfo.new(d * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, d * 0.6)
	TweenService:Create(p.Label, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(p.Stroke, fade, { Transparency = 1 }):Play()
	task.delay(d + 0.05, function()
		local gui: any = p.Gui -- the typings declare Adornee non-optional
		gui.Parent = nil
		gui.Adornee = nil
		table.insert(popupPool, p)
	end)
end

--------------------------------------------------------------------------------------------------
-- Droplets (pooled balls on simple ballistic arcs, moved with one BulkMoveTo per frame)
--------------------------------------------------------------------------------------------------

type Drop = { Part: BasePart, Pos: Vector3, Vel: Vector3, Age: number, Life: number }

local drops: { Drop } = {}
local dropPool: { BasePart } = {}
local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}

local function newDropPart(): BasePart
	local p = Effects.Part(Enum.PartType.Ball)
	p.Name = "Droplet"
	p.Material = Enum.Material.Glass
	return p
end

function FlightFX.Droplets(pos: Vector3, colors: { Color3 }, n: number, speed: number)
	local parent = getFolder()
	for i = 1, FlightFX.Count(n) do
		local part = table.remove(dropPool) or newDropPart()
		part.Color = colors[(i - 1) % #colors + 1]
		part.Transparency = 0.1
		part.Size = Vector3.one * rng:NextNumber(0.4, 0.95)
		part.CFrame = CFrame.new(pos)
		part.Parent = parent
		local a = rng:NextNumber(0, 2 * math.pi)
		local horizontal = rng:NextNumber(0.15, 0.5) * speed
		local vel = Vector3.new(math.cos(a) * horizontal, rng:NextNumber(0.6, 1) * speed, math.sin(a) * horizontal)
		table.insert(drops, { Part = part, Pos = pos, Vel = vel, Age = 0, Life = rng:NextNumber(0.7, 1.1) })
	end
end

-- Advances droplets. Call once per frame.
function FlightFX.Step(dt: number)
	local n = #drops
	if n == 0 then
		return
	end
	table.clear(moveParts)
	table.clear(moveCFrames)
	local i = 1
	while i <= n do
		local d = drops[i]
		d.Age += dt
		if d.Age >= d.Life then
			d.Part.Parent = nil
			table.insert(dropPool, d.Part)
			drops[i] = drops[n]
			drops[n] = nil
			n -= 1
		else
			d.Vel += GRAVITY * dt
			d.Pos += d.Vel * dt
			local k = d.Age / d.Life
			d.Part.Transparency = 0.1 + 0.9 * k * k
			table.insert(moveParts, d.Part)
			table.insert(moveCFrames, CFrame.new(d.Pos))
			i += 1
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

--------------------------------------------------------------------------------------------------
-- Splash / launch / special bursts
--------------------------------------------------------------------------------------------------

local plumePool: { BasePart } = {}
local PLUME_ROTATION = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis (X) -> up

local function plume(pos: Vector3, color: Color3, height: number, width: number)
	local p = table.remove(plumePool)
	if not p then
		local created = Effects.Part(Enum.PartType.Cylinder)
		created.Name = "SplashPlume"
		created.Material = Enum.Material.Glass
		p = created
	end
	local part = p :: BasePart
	part.Color = color
	part.Transparency = 0.25
	part.Size = Vector3.new(1, width * 0.4, width * 0.4)
	part.CFrame = CFrame.new(pos) * PLUME_ROTATION
	part.Parent = getFolder()
	local info = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(part, info, {
		Size = Vector3.new(height, width, width),
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * PLUME_ROTATION,
		Transparency = 1,
	}):Play()
	task.delay(0.75, function()
		part.Parent = nil
		table.insert(plumePool, part)
	end)
end

-- Landing splash on the water surface at `pos`. `big` for the local player's own landing.
function FlightFX.Splash(pos: Vector3, water: Color3, big: boolean)
	local light = water:Lerp(WHITE, 0.55)
	local up = Vector3.new(0, 1, 0)
	Effects.Sparks(pos + up, light, FlightFX.Count(if big then 28 else 10), if big then 26 else 16, if big then 1.1 else 0.7)
	Effects.Smoke(pos + up * 1.5, WHITE, FlightFX.Count(if big then 12 else 4))
	Effects.Ring(pos + up * 0.15, UP_RING, if big then 16 else 8, light, if big then 0.7 else 0.5, 0.35)
	if big then
		Effects.Ring(pos + up * 0.2, UP_RING, 9, WHITE, 0.45, 0.25)
		Effects.Flash(pos + up, 6, WHITE, 0.25)
	end
	FlightFX.Droplets(pos, { water, light, WHITE }, if big then 22 else 8, if big then 34 else 22)
	plume(pos, light, if big then 14 else 7, if big then 6 else 3.5)
end

-- Swoosh + puff where the glider leaves the hand. Local throws get the sound in 2D.
function FlightFX.Launch(pos: Vector3, direction: Vector3, perfect: boolean, isLocal: boolean)
	Effects.Smoke(pos, WHITE, FlightFX.Count(8))
	Effects.Ring(pos, direction, 4, WHITE, 0.3, 0.2)
	if isLocal then
		AudioController.Play("Launch")
	else
		AudioController.Play("Launch", pos, 0.2, 0.6)
	end
	if perfect then
		Effects.Sparks(pos, GOLD, FlightFX.Count(26), 22, 0.9)
		Effects.Flash(pos, 7, GOLD, 0.3)
		Effects.Ring(pos, direction, 7, GOLD, 0.4, 0.3)
		if isLocal then
			AudioController.Play("PerfectLaunch")
		end
	end
end

-- Dramatic burst for JET STREAM / SKY TITAN launches.
function FlightFX.SpecialBurst(pos: Vector3, direction: Vector3, color: Color3)
	Effects.Flash(pos, 20, color, 0.6)
	Effects.Ring(pos, direction, 26, color, 0.7, 0.6)
	Effects.Ring(pos, UP_RING, 18, WHITE, 0.55, 0.4)
	Effects.Sparks(pos, color, FlightFX.Count(60), 40, 1.4)
	Effects.Sparks(pos, WHITE, FlightFX.Count(24), 28, 0.8)
	Effects.Debris(pos, { color, WHITE, GOLD }, FlightFX.Count(14), 0.7, 36, 1.0)
end

--------------------------------------------------------------------------------------------------
-- Speed lines (one emitter part kept in front of the camera; positioned after the camera moves)
--------------------------------------------------------------------------------------------------

local speedPart: BasePart? = nil
local speedEmitter: ParticleEmitter? = nil
local speedIntensity = 0
local speedBound = false

local function ensureSpeedLines(): (BasePart, ParticleEmitter)
	local part = speedPart
	local emitter = speedEmitter
	if part and emitter and part.Parent then
		return part, emitter
	end
	local p = Effects.Part()
	p.Name = "SpeedLines"
	p.Transparency = 1
	p.Size = Vector3.new(46, 28, 2)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARK_TEXTURE
	e.Enabled = false
	e.Rate = 0
	e.LockedToPart = true
	e.EmissionDirection = Enum.NormalId.Back -- toward the camera
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.Speed = NumberRange.new(120, 170)
	e.Lifetime = NumberRange.new(0.18, 0.3)
	e.SpreadAngle = Vector2.new(2, 2)
	e.Size = NumberSequence.new(0.3)
	e.Squash = NumberSequence.new(2.6)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Color = ColorSequence.new(WHITE)
	e.Parent = p
	p.Parent = getFolder()
	speedPart = p
	speedEmitter = e
	return p, e
end

local function placeSpeedLines()
	local part = speedPart
	local camera = Workspace.CurrentCamera
	if speedIntensity <= 0 or not part or not camera then
		return
	end
	part.CFrame = camera.CFrame * CFrame.new(0, 0, -34)
end

-- Sets speed-line strength 0..1 (0 turns them off). LowFx disables them.
function FlightFX.SetSpeedLines(intensity: number)
	local k = if FlightFX.Low() then 0 else math.clamp(intensity, 0, 1)
	if k <= 0.01 then
		if speedIntensity > 0 and speedEmitter then
			(speedEmitter :: ParticleEmitter).Enabled = false
		end
		speedIntensity = 0
		return
	end
	local _, emitter = ensureSpeedLines()
	if not speedBound then
		speedBound = true
		RunService:BindToRenderStep("SkyGlideSpeedLines", Enum.RenderPriority.Camera.Value + 5, placeSpeedLines)
	end
	speedIntensity = k
	emitter.Rate = 110 * k
	emitter.Enabled = true
end

return FlightFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">ThermalRings</string>
              <string name="Source"><![CDATA[--!strict
-- Thermal rings for the local flight: big glowing hoops built from neon segments around a faint
-- disc (no meshes, no assets). Rings face the channel (their normal runs along world Z) and spin
-- gently. Pooled: a flight acquires one ring per plan ring and releases each one after its pass
-- burst. Step() moves every segment with a single BulkMoveTo into a per-ring reusable CFrame list.
local Workspace = game:GetService("Workspace")

local Effects = require(script.Parent.Effects)

local ThermalRings = {}

local SEGMENTS = 14
local RADIUS = 10
local THICK = 1.1
local STEP = 2 * math.pi / SEGMENTS
local SEG_LEN = 2 * math.pi * RADIUS / SEGMENTS * 1.12 -- slight overlap so the hoop looks closed
local POOL_LIMIT = 32
local DISC_ROTATION = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis (X) -> world Z

ThermalRings.Radius = RADIUS

export type Ring = {
	Model: Model,
	Parts: { BasePart }, -- segments, in angle order
	CFrames: { CFrame }, -- reused by Step()
	Disc: BasePart,
	Center: Vector3,
}

local pool: { Ring } = {}
local folder: Folder? = nil

local function getFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local created = Instance.new("Folder")
	created.Name = "ThermalRings"
	created.Parent = Effects.Folder()
	folder = created
	return created
end

local function build(): Ring
	local model = Instance.new("Model")
	model.Name = "ThermalRing"
	local parts: { BasePart } = table.create(SEGMENTS)
	local cframes: { CFrame } = table.create(SEGMENTS)
	for i = 1, SEGMENTS do
		local p = Effects.Part()
		p.Name = "Segment"
		p.Size = Vector3.new(THICK, SEG_LEN, THICK)
		p.Parent = model
		parts[i] = p
		cframes[i] = CFrame.identity
	end
	local disc = Effects.Part(Enum.PartType.Cylinder)
	disc.Name = "Disc"
	disc.Size = Vector3.new(0.2, RADIUS * 2 - THICK, RADIUS * 2 - THICK)
	disc.Parent = model
	return { Model = model, Parts = parts, CFrames = cframes, Disc = disc, Center = Vector3.zero }
end

-- Recolours the hoop. `segTransparency` for the neon segments, `discTransparency` for the fill.
function ThermalRings.SetLook(ring: Ring, color: Color3, segTransparency: number, discTransparency: number)
	for _, p in ring.Parts do
		p.Color = color
		p.Transparency = segTransparency
	end
	ring.Disc.Color = color
	ring.Disc.Transparency = discTransparency
end

-- Places the segments at `spin` radians with the radius multiplied by `radiusScale`.
function ThermalRings.Step(ring: Ring, spin: number, radiusScale: number)
	local base = CFrame.new(ring.Center)
	local r = RADIUS * radiusScale
	local cframes = ring.CFrames
	for i = 1, SEGMENTS do
		cframes[i] = base * CFrame.Angles(0, 0, spin + (i - 1) * STEP) * CFrame.new(r, 0, 0)
	end
	Workspace:BulkMoveTo(ring.Parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Takes a ring from the pool and shows it at `center` (world position) in `color`.
function ThermalRings.Acquire(center: Vector3, color: Color3, spin: number): Ring
	local ring = table.remove(pool) or build()
	ring.Center = center
	ring.Disc.CFrame = CFrame.new(center) * DISC_ROTATION
	ThermalRings.SetLook(ring, color, 0.05, 0.88)
	ThermalRings.Step(ring, spin, 1)
	ring.Model.Parent = getFolder()
	return ring
end

function ThermalRings.Release(ring: Ring)
	ring.Model.Parent = nil
	if #pool < POOL_LIMIT then
		table.insert(pool, ring)
	else
		ring.Model:Destroy()
	end
end

return ThermalRings
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="144">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>