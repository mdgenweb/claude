        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">AssetIds</string>
            <string name="Source"><![CDATA[--!strict
-- GENERATED by scripts/upload_assets.py from assets/manifest.json. Don't edit by hand: put ids in
-- the manifest ("assetId" from the script, or "content" for a hand upload) and run --write-only.
-- Roblox content strings of the uploaded icon images, keyed like Theme.Icons. An empty string
-- means the icon is not uploaded yet, and the UI shows its emoji instead.
export type AssetIds = { Icons: { [string]: string } }

local AssetIds: AssetIds = {
	Icons = {
		Admin = "",
		Auto = "",
		Camera = "",
		Check = "",
		Codes = "",
		Crown = "",
		Daily = "",
		Egg = "",
		Error = "",
		Friends = "",
		Gifts = "",
		Glider = "",
		Index = "",
		Info = "",
		Inventory = "",
		Lock = "",
		Luck = "",
		Pad = "",
		Pass = "",
		Pets = "",
		Potion = "",
		Rebirth = "",
		Relic = "",
		Settings = "",
		Shop = "",
		Skill = "",
		Sound = "",
		Sparkles = "",
		Star = "",
		Stats = "",
		Trails = "",
		Wins = "",
		World = "",
	},
}

return AssetIds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- Sound library. Defaults use sound files that ship with every Roblox client
-- (rbxasset://sounds/...), so no audio is borrowed from the reference game. Replace any entry with
-- your own uploaded "rbxassetid://<id>" to upgrade the mix.
export type SoundSpec = {
	Id: string,
	Volume: number,
	Pitch: { number }, -- {min, max} random playback speed
	Looped: boolean?,
}

local function s(id: string, volume: number, pmin: number, pmax: number, looped: boolean?): SoundSpec
	return { Id = id, Volume = volume, Pitch = { pmin, pmax }, Looped = looped }
end

local Audio = {}

Audio.Sounds = {
	-- UI
	Hover = s("rbxasset://sounds/clickfast.wav", 0.12, 1.3, 1.4),
	Click = s("rbxasset://sounds/clickfast.wav", 0.45, 0.95, 1.05),
	Error = s("rbxasset://sounds/clickfast.wav", 0.5, 0.55, 0.6),
	Purchase = s("rbxasset://sounds/electronicpingshort.wav", 0.5, 1.5, 1.5),
	Reward = s("rbxasset://sounds/victory.wav", 0.45, 1.1, 1.1),
	Coin = s("rbxasset://sounds/electronicpingshort.wav", 0.28, 1.9, 2.2), -- reward lands in a counter
	Open = s("rbxasset://sounds/swoosh.wav", 0.3, 1.2, 1.3),
	Close = s("rbxasset://sounds/swoosh.wav", 0.22, 0.9, 1.0),
	LevelUp = s("rbxasset://sounds/victory.wav", 0.55, 1.4, 1.4),
	Rebirth = s("rbxasset://sounds/victory.wav", 0.7, 0.85, 0.85),

	-- Training
	Train = s("rbxasset://sounds/electronicpingshort.wav", 0.18, 1.6, 1.8),

	-- Flight
	Charge = s("rbxasset://sounds/electronicpingshort.wav", 0.25, 0.7, 0.7),
	Launch = s("rbxasset://sounds/swoosh.wav", 0.75, 0.75, 0.85),
	PerfectLaunch = s("rbxasset://sounds/victory.wav", 0.4, 1.6, 1.6),
	Wind = s("rbxasset://sounds/action_falling.mp3", 0.35, 1.0, 1.0, true),
	Ring = s("rbxasset://sounds/electronicpingshort.wav", 0.5, 1.0, 1.0), -- pitch raised per combo
	Perfect = s("rbxasset://sounds/electronicpingshort.wav", 0.65, 1.5, 1.5),
	Miss = s("rbxasset://sounds/clickfast.wav", 0.4, 0.5, 0.55),
	ZoneEnter = s("rbxasset://sounds/swoosh.wav", 0.45, 1.5, 1.6),
	Splash = s("rbxasset://sounds/impact_water.mp3", 0.8, 0.9, 1.1),
	NewBest = s("rbxasset://sounds/victory.wav", 0.55, 1.25, 1.25),

	-- Meta
	EggShake = s("rbxasset://sounds/swoosh.wav", 0.35, 1.6, 1.8),
	EggCrack = s("rbxasset://sounds/glassbreak.wav", 0.4, 1.2, 1.3),
	RareHatch = s("rbxasset://sounds/victory.wav", 0.6, 1.2, 1.2),
	Portal = s("rbxasset://sounds/swoosh.wav", 0.6, 0.6, 0.65),
} :: { [string]: SoundSpec }

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Branding</string>
            <string name="Source"><![CDATA[--!strict
-- Original branding. Nothing here (name, colours, logo shapes) is taken from the reference game.
return {
	GameName = "+1 Sky Glide",
	ShortName = "Sky Glide",
	Tagline = "Throw gliders, ride the wind, fly farther!",
	Studio = "Sky Glide Team",
	-- Names for the two core stats. Kept generic on purpose so the loop reads like the genre.
	PowerStat = "Skill",
	Currency = "Wins",
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Progression & economy tuning. Values marked (OBSERVED) come from the reference screenshots,
-- (LIKELY) are inferred from them, everything else is ORIGINAL DESIGN (see docs/RESEARCH.md).
local Economy = {}

Economy.Starting = {
	Skill = 0,
	Wins = 0,
	Glider = "paper_dart",
}

-- Levels are derived from Skill (LIKELY: "Skill fills a level bar"). Level L starts at
--   SkillForLevel(L) = LevelBase * (LevelGrowth^(L-1) - 1) / (LevelGrowth - 1)
-- so each level is ~18% wider than the last. Fitted to the reference HUD: Level 50 with 25.29K
-- Skill showing "3.07K / 4.05K" (OBSERVED). At the level cap Skill from training and rings stops
-- (CONFIRMED: "the game stops raising your Skill"), so the player must rebirth.
-- Cap = 20 + 20 x rebirths (LIKELY: "Level 20 MAX LEVEL" at 0 rebirths, Level 50 = 83% at 2).
Economy.LevelCapBase = 20
Economy.LevelCapPerRebirth = 20
Economy.LevelBase = 1.2
Economy.LevelGrowth = 1.18

-- Rebirth multiplier = 1 + RebirthStep x rebirths (LIKELY: x1 at 0, x5 at 2 rebirths).
Economy.RebirthStep = 2
Economy.MaxRebirths = 1000

-- Training
Economy.TrainManualRate = 4 -- max manual reps per second accepted
-- Sources that stop paying at the level cap (purchases, gifts and codes always pay).
Economy.CappedSources = { Train = true, Ring = true }
Economy.TrainAutoInterval = 1 -- seconds between AUTO reps
Economy.TrainRepBase = 1

-- Pets
Economy.PetSlots = 3
Economy.PetSlotsPass = 2 -- extra slots with the "PetSlots" pass
Economy.PetInventory = 60 -- soft cap: blocks Wins hatches only (gifts / Robux eggs always deliver)
Economy.PetHardLimit = 5000 -- corrupted-record guard on load
Economy.HatchMulti = 3 -- "TripleHatch" pass

-- Friend boost: +10% Skill per friend in the server, up to +50% (OBSERVED HUD "Friend Boost +0%").
Economy.FriendBoostPer = 0.1
Economy.FriendBoostMax = 0.5

-- Premium (Roblox Premium members) small perk.
Economy.PremiumSkillBonus = 0.1

Economy.Limits = {
	MaxSkill = 1e300,
	MaxWins = 1e300,
	MaxPotions = 999,
}

function Economy.LevelCap(rebirths: number): number
	return Economy.LevelCapBase + Economy.LevelCapPerRebirth * math.max(0, rebirths)
end

-- Skill at which `level` starts.
function Economy.SkillForLevel(level: number): number
	local g = Economy.LevelGrowth
	return Economy.LevelBase * (g ^ (math.max(1, level) - 1) - 1) / (g - 1)
end

-- Width of `level` in Skill (shown as the level bar's "x / y").
function Economy.XPToNext(level: number): number
	return Economy.LevelBase * Economy.LevelGrowth ^ (math.max(1, level) - 1)
end

-- Level reached with `skill` Skill, clamped to `cap`.
function Economy.LevelForSkill(skill: number, cap: number): number
	if skill <= 0 or skill ~= skill then
		return 1
	end
	local g = Economy.LevelGrowth
	local level = math.floor(math.log(skill * (g - 1) / Economy.LevelBase + 1) / math.log(g)) + 1
	-- guard against float edge cases at exact boundaries
	if Economy.SkillForLevel(level + 1) <= skill then
		level += 1
	elseif Economy.SkillForLevel(level) > skill then
		level -= 1
	end
	return math.clamp(level, 1, cap)
end

function Economy.RebirthMultiplier(rebirths: number): number
	return 1 + Economy.RebirthStep * math.max(0, rebirths)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!strict
-- Live events ("Sky Festival"): server-wide boosts. ORIGINAL take on the reference's admin events
-- (LIKELY: those turn on server-wide Skill/Wins boosts and raise special-throw odds).
-- Scheduled windows are unix seconds (UTC). Admins can also start one from the Admin panel.
export type Window = { Name: string, StartsAt: number, EndsAt: number }

return {
	Name = "SKY FESTIVAL",
	SkillMultiplier = 2,
	WinsMultiplier = 2,
	SpecialLuck = 3, -- special throws x3 as likely
	Schedule = {} :: { Window },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Flight</string>
            <string name="Source"><![CDATA[--!strict
-- ORIGINAL DESIGN: the glider flight model (replaces stone skipping).
--
-- A throw becomes a deterministic "flight plan" computed on the server from the player's Skill,
-- the launch meter, and a seed. Logical distance (meters, unbounded) is kept separate from the
-- rendered path (studs, bounded) through a log mapping, so a 10-million-meter throw still fits in
-- the channel without float precision problems. See docs/DESIGN.md §Flight.
local Flight = {}

-- Distance from Skill: D = Base + Scale * Skill ^ Exponent (meters), then x launch multiplier.
Flight.DistanceBase = 6
Flight.DistanceScale = 4.5
Flight.DistanceExponent = 0.4
Flight.MaxDistance = 1e300

-- Launch meter (server-timed): value pings 0 -> 1 -> 0 every MeterPeriod seconds of holding.
Flight.MeterPeriod = 1.3
Flight.MeterMaxHold = 8 -- seconds; longer holds are released automatically
Flight.LaunchMin = 0.85 -- multiplier at meter 0
Flight.LaunchMax = 1.15 -- multiplier at meter just below the perfect band
Flight.PerfectLaunchAt = 0.9 -- meter >= this = PERFECT LAUNCH
Flight.PerfectLaunchMultiplier = 1.25
Flight.TapLaunchMeter = 0.55 -- a quick tap without holding
Flight.TapThreshold = 0.18 -- holds shorter than this (seconds) count as a quick tap
Flight.AutoLaunchMeter = 0.7 -- auto-throw quality

-- Rendered path: Z(d) = RenderScale * ln(1 + d / (RenderD0 * world.DistanceScale)) studs.
Flight.RenderScale = 900
Flight.RenderD0 = 40
Flight.RenderMaxZ = 8000 -- channel length; extreme throws are clamped visually, never logically

-- Timing: T = clamp(TimeBase + TimeLog * log2(1 + D / (TimeD0 * world.DistanceScale)), TimeMin, TimeMax)
Flight.TimeBase = 2.8
Flight.TimeLog = 1.0
Flight.TimeD0 = 15
Flight.TimeMin = 2.8
Flight.TimeMax = 12
Flight.EaseExponent = 1.5 -- rendered progress = 1 - (1 - t/T)^EaseExponent (fast launch, soft landing)

-- Thermal rings: K = clamp(floor(RingBase + RingLog * log2(1 + D / (RingD0 * world.DistanceScale))), RingMin, RingMax)
Flight.RingBase = 2
Flight.RingLog = 1.5
Flight.RingD0 = 12
Flight.RingMin = 2
Flight.RingMax = 14
-- Rings are scheduled in TIME so they stay humanly tappable: the first ring comes at
-- FirstRingTime x T, the last at LastRingTime x T, gaps shrink by RingSpacingDecay (the rhythm
-- speeds up) but never below RingMinGap seconds. RingMinGap >= GustEarly + GustLate +
-- GustMaxLatency makes spam-tapping useless: the first tap aimed at the next ring always lands in
-- its "too early" window even after network delay (FlightService also caps taps per ring).
Flight.FirstRingTime = 0.12
Flight.LastRingTime = 0.86
Flight.RingFirstMin = 0.6 -- seconds; never earlier than this
Flight.RingSpacingDecay = 0.9
Flight.RingMinGap = 0.75

-- Gust taps (PERFECT catches). Times are seconds relative to the ring time.
Flight.GustEarly = 0.3 -- tap may come this long before the ring
Flight.GustLate = 0.12 -- ...or this long after it
Flight.GustMaxLatency = 0.3 -- extra lateness allowed for the player's measured ping
Flight.GustTooEarly = 0.9 -- a tap this long before a ring "spends" that ring as a miss
Flight.PerfectMultiplier = 2
Flight.GustTapSlack = 3 -- taps allowed beyond one per ring before further taps count as misses

-- Visual altitude (studs): apex H = clamp(HeightBase + HeightLog * log2(1 + D/(…)), HeightMin, HeightMax)
Flight.HeightBase = 16
Flight.HeightLog = 4
Flight.HeightMin = 14
Flight.HeightMax = 60
Flight.ThermalLift = 0.22 -- bump size as a fraction of H
Flight.ThermalDecay = 0.92

-- Special throws (LIKELY in the reference: a rare "secret" x3 throw and a 1/1000 giant one).
-- Ours: rolled from the server seed at launch. Listed rarest first.
export type Special = { Id: string, Name: string, Chance: number, Multiplier: number, Color: string }
Flight.Specials = {
	{ Id = "SkyTitan", Name = "SKY TITAN", Chance = 0.001, Multiplier = 8, Color = "#FFD447" },
	{ Id = "JetStream", Name = "JET STREAM", Chance = 0.01, Multiplier = 3, Color = "#7FE7FF" },
} :: { Special }

Flight.LandCooldown = 0.7 -- seconds after landing before the next throw is accepted
Flight.AutoThrowDelay = 1.2 -- auto throw waits this long after landing

return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Map</string>
            <string name="Source"><![CDATA[--!strict
-- Map layout (world-local coordinates, studs). Every world uses the same layout at its own origin
-- so the server, client and tutorial share one set of anchors. +Z points back toward spawn,
-- the channel runs toward -Z from the Throw Zone.
local Map = {}

Map.WorldSpacing = 3200 -- world N origin = ((N - 1) * WorldSpacing, 0, 0)

Map.Hub = { MinX = -160, MaxX = 160, MinZ = -40, MaxZ = 230, WallHeight = 34 }
Map.Spawn = Vector3.new(0, 3, 190)

Map.ThrowZone = { MinX = -36, MaxX = 36, MinZ = -40, MaxZ = 4 }
Map.ThrowOrigin = Vector3.new(0, 5, -42) -- where gliders leave the hand (channel Z = 0 here)
Map.ChannelStartZ = -40
Map.ChannelHalfWidth = 44
Map.WaterY = -7
Map.BankWidth = 26
Map.CliffHeight = 26
Map.ChannelSegment = 400 -- studs per water/bank segment

-- Training pads: a column on the left side.
Map.PadSize = Vector3.new(24, 1, 24)
Map.PadOrigin = Vector3.new(-104, 0, 34) -- slot 1 centre
Map.PadStep = Vector3.new(0, 0, 27)

-- Glider pedestals: two columns on the right side.
Map.PedestalOrigin = Vector3.new(76, 0, 32)
Map.PedestalStepAlong = Vector3.new(0, 0, 28) -- next item in a column
Map.PedestalStepAcross = Vector3.new(34, 0, 0) -- next column
Map.PedestalsPerColumn = 6
Map.RelicSpot = Vector3.new(76, 0, 0)

-- Eggs: a row along the back wall (right half).
Map.EggOrigin = Vector3.new(40, 0, 214)
Map.EggStep = Vector3.new(26, 0, 0)

-- Portals and leaderboards on the back wall.
Map.PortalNext = Vector3.new(-34, 0, 224)
Map.PortalPrev = Vector3.new(-80, 0, 224)
Map.Leaderboards = {
	{ Stat = "Wins", Position = Vector3.new(-152, 14, 120), Facing = Vector3.new(1, 0, 0) },
	{ Stat = "BestDistance", Position = Vector3.new(-152, 14, 160), Facing = Vector3.new(1, 0, 0) },
	{ Stat = "Rebirths", Position = Vector3.new(-152, 14, 200), Facing = Vector3.new(1, 0, 0) },
}

-- Padding (studs) when checking "is the player standing on X" on the server.
Map.StandTolerance = 3

function Map.Origin(worldId: number): Vector3
	return Vector3.new((worldId - 1) * Map.WorldSpacing, 0, 0)
end

-- Channel-space (lateral x, altitude y above water, distance z along the channel) -> world position.
function Map.ChannelPoint(worldId: number, x: number, y: number, z: number): Vector3
	local o = Map.Origin(worldId)
	return o + Vector3.new(Map.ThrowOrigin.X + x, Map.WaterY + y, Map.ChannelStartZ - z)
end

function Map.PadPosition(slot: number): Vector3
	return Map.PadOrigin + Map.PadStep * (slot - 1)
end

function Map.PedestalPosition(index: number): Vector3
	local column = (index - 1) // Map.PedestalsPerColumn
	local row = (index - 1) % Map.PedestalsPerColumn
	return Map.PedestalOrigin + Map.PedestalStepAcross * column + Map.PedestalStepAlong * row
end

function Map.EggPosition(index: number): Vector3
	return Map.EggOrigin + Map.EggStep * (index - 1)
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes and developer products. Set the real ids before publishing.
-- Id = 0 means "not configured": inside Studio the purchase is a free TEST grant so every flow can
-- be exercised; in a live server the offer is shown as unavailable (never a fake button).
-- Prices are display hints; Roblox shows the real price in its purchase dialog.
export type Pass = { Key: string, Name: string, Description: string, Id: number, Robux: number, Icon: string }
export type Product = {
	Key: string,
	Name: string,
	Description: string,
	Id: number,
	Robux: number,
	Kind: string, -- "Skill" | "StarterPack" | "Relic" | "Egg" | "Potion"
	Amount: number?,
	Ref: string?, -- relic id / egg id / potion id
	OneTime: boolean?,
}

local Monetization = {}

Monetization.Passes = {
	{ Key = "AutoThrow", Name = "Auto Throw", Description = "Throws for you in the Throw Zone.", Id = 0, Robux = 10, Icon = "Auto" },
	{ Key = "DoubleSkill", Name = "2x Skill", Description = "Doubles all Skill you earn, forever.", Id = 0, Robux = 49, Icon = "Skill" },
	{ Key = "DoubleWins", Name = "2x Wins", Description = "Doubles all Wins you earn, forever.", Id = 0, Robux = 25, Icon = "Wins" },
	{ Key = "PetSlots", Name = "+2 Pet Slots", Description = "Equip 2 more pets.", Id = 0, Robux = 99, Icon = "Pet" },
	{ Key = "TripleHatch", Name = "Triple Hatch", Description = "Hatch 3 eggs at once.", Id = 0, Robux = 79, Icon = "Egg" },
	{ Key = "Pad3x", Name = "3x Skill Pads", Description = "Unlocks the 3x ALL WORLDS training pads.", Id = 0, Robux = 39, Icon = "Pad" },
	{ Key = "Pad15x", Name = "15x Skill Pads", Description = "Unlocks the 15x ALL WORLDS training pads.", Id = 0, Robux = 99, Icon = "Pad" },
	{ Key = "Pad50x", Name = "50x Skill Pads", Description = "Unlocks the 50x ALL WORLDS training pads.", Id = 0, Robux = 239, Icon = "Pad" },
} :: { Pass }

Monetization.Products = {
	{ Key = "Skill10K", Name = "+10K Skill", Description = "Instant Skill (scaled by world).", Id = 0, Robux = 5, Kind = "Skill", Amount = 10000 },
	{ Key = "Skill100K", Name = "+100K Skill", Description = "Instant Skill (scaled by world).", Id = 0, Robux = 20, Kind = "Skill", Amount = 100000 },
	{ Key = "Skill1M", Name = "+1M Skill", Description = "Instant Skill (scaled by world).", Id = 0, Robux = 40, Kind = "Skill", Amount = 1000000 },
	{ Key = "StarterPack", Name = "Starter Pack", Description = "Starlight Unicat pet, 2 potions of each kind and 500 Wins.", Id = 0, Robux = 49, Kind = "StarterPack", OneTime = true },
	{ Key = "AuroraRelic", Name = "Aurora Relic", Description = "Limited! Always 125% better than your best glider.", Id = 0, Robux = 199, Kind = "Relic", Ref = "aurora_relic", OneTime = true },
	{ Key = "OverlordEgg", Name = "Overlord Egg", Description = "Hatch one Overlord Egg.", Id = 0, Robux = 70, Kind = "Egg", Ref = "overlord_egg" },
	{ Key = "SkillPotions", Name = "3x 2x Skill Potions", Description = "Three 10-minute 2x Skill potions.", Id = 0, Robux = 25, Kind = "Potion", Ref = "skill_potion", Amount = 3 },
	{ Key = "WinsPotions", Name = "3x 2x Wins Potions", Description = "Three 10-minute 2x Wins potions.", Id = 0, Robux = 25, Kind = "Potion", Ref = "wins_potion", Amount = 3 },
} :: { Product }

Monetization.StarterPack = {
	Pet = "starlight_unicat",
	Potions = { skill_potion = 2, wins_potion = 2, luck_potion = 2 } :: { [string]: number },
	Wins = 500,
}

local passByKey: { [string]: Pass } = {}
for _, p in Monetization.Passes do
	passByKey[p.Key] = p
end
local productByKey: { [string]: Product } = {}
for _, p in Monetization.Products do
	productByKey[p.Key] = p
end

function Monetization.Pass(key: string): Pass?
	return passByKey[key]
end

function Monetization.Product(key: string): Product?
	return productByKey[key]
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Rarity</string>
            <string name="Source"><![CDATA[--!strict
-- Rarity tiers shared by gliders, pets and trails.
export type RarityInfo = { Id: string, Name: string, Order: number, Color: string, Dark: string, Light: string }

local list: { RarityInfo } = {
	{ Id = "Common", Name = "Common", Order = 1, Color = "#B9C2CF", Dark = "#5D6675", Light = "#E9EEF5" },
	{ Id = "Uncommon", Name = "Uncommon", Order = 2, Color = "#5BE05B", Dark = "#1E7A1E", Light = "#C8FFC8" },
	{ Id = "Rare", Name = "Rare", Order = 3, Color = "#3FA9FF", Dark = "#1257A8", Light = "#C2E4FF" },
	{ Id = "Epic", Name = "Epic", Order = 4, Color = "#B65CFF", Dark = "#5B1AA8", Light = "#E6C9FF" },
	{ Id = "Legendary", Name = "Legendary", Order = 5, Color = "#FFC53D", Dark = "#A86A00", Light = "#FFF0B8" },
	{ Id = "Mythic", Name = "Mythic", Order = 6, Color = "#FF4FA3", Dark = "#A3115B", Light = "#FFD0E8" },
	{ Id = "Secret", Name = "Secret", Order = 7, Color = "#FF3B3B", Dark = "#7A0A0A", Light = "#FFD2D2" },
}

local byId: { [string]: RarityInfo } = {}
for _, r in list do
	byId[r.Id] = r
end

local Rarity = {}
Rarity.List = list

function Rarity.Get(id: string): RarityInfo
	return byId[id] or byId.Common
end

function Rarity.Exists(id: string): boolean
	return byId[id] ~= nil
end

function Rarity.Order(id: string): number
	return Rarity.Get(id).Order
end

return Rarity
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Definitions</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Boosts</string>
            <string name="Source"><![CDATA[--!strict
-- Timed potions. Using one adds its duration to the matching active boost (stacks in time, not
-- in strength). Expiry is stored as a Unix timestamp, so boosts keep ticking while offline.
export type Boost = {
	Id: string,
	Name: string,
	Stat: string, -- "Skill" | "Wins" | "Luck"
	Multiplier: number,
	Duration: number, -- seconds per potion
	Color: string,
}

local list: { Boost } = {
	{ Id = "skill_potion", Name = "2x Skill Potion", Stat = "Skill", Multiplier = 2, Duration = 10 * 60, Color = "#FFD447" },
	{ Id = "wins_potion", Name = "2x Wins Potion", Stat = "Wins", Multiplier = 2, Duration = 10 * 60, Color = "#5BE05B" },
	{ Id = "luck_potion", Name = "2x Luck Potion", Stat = "Luck", Multiplier = 2, Duration = 10 * 60, Color = "#B65CFF" },
}

local byId: { [string]: Boost } = {}
for _, b in list do
	byId[b.Id] = b
end

local Boosts = {}
Boosts.List = list
Boosts.MaxStackSeconds = 24 * 3600

function Boosts.Get(id: string): Boost?
	return byId[id]
end

function Boosts.Exists(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

return Boosts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--!strict
-- Eggs. Hatching is rolled on the server with a weighted RNG (x Luck for rare tiers).
local Pets = require(script.Parent.Pets)

export type EggEntry = { Pet: string, Weight: number }

export type Egg = {
	Id: string,
	Name: string,
	World: number?, -- nil = available in every world
	Price: number, -- Wins per egg (0 when ProductKey is set)
	ProductKey: string?, -- Robux egg (Config/Monetization)
	Pets: { EggEntry },
	Color: string,
	Accent: string,
}

local list: { Egg } = {
	{
		Id = "beach_egg",
		Name = "Beach Egg",
		World = 1,
		Price = 50,
		Color = "#FFE2A8",
		Accent = "#4FC3FF",
		Pets = {
			{ Pet = "sandy_crab", Weight = 60 },
			{ Pet = "sea_pup", Weight = 28 },
			{ Pet = "coral_fox", Weight = 10 },
			{ Pet = "sun_turtle", Weight = 1.9 },
			{ Pet = "golden_gull", Weight = 0.1 },
		},
	},
	{
		Id = "palm_egg",
		Name = "Palm Egg",
		World = 1,
		Price = 500,
		Color = "#8BE07A",
		Accent = "#8B5A2B",
		Pets = {
			{ Pet = "coco_monkey", Weight = 55 },
			{ Pet = "palm_parrot", Weight = 30 },
			{ Pet = "tiki_cat", Weight = 12 },
			{ Pet = "reef_ray", Weight = 2.8 },
			{ Pet = "tropic_phoenix", Weight = 0.2 },
		},
	},
	{
		Id = "breeze_egg",
		Name = "Breeze Egg",
		World = 1,
		Price = 4000,
		Color = "#CDEBFF",
		Accent = "#FFFFFF",
		Pets = {
			{ Pet = "cloud_lamb", Weight = 50 },
			{ Pet = "wind_bunny", Weight = 32 },
			{ Pet = "sky_whale", Weight = 14 },
			{ Pet = "storm_owl", Weight = 3.7 },
			{ Pet = "aurora_dragon", Weight = 0.3 },
		},
	},
	{
		Id = "ember_egg",
		Name = "Ember Egg",
		World = 2,
		Price = 100000,
		Color = "#FF6A00",
		Accent = "#2B2B33",
		Pets = {
			{ Pet = "ember_pup", Weight = 55 },
			{ Pet = "lava_slime", Weight = 30 },
			{ Pet = "ash_bat", Weight = 12 },
			{ Pet = "magma_golem", Weight = 2.8 },
			{ Pet = "fire_drake", Weight = 0.2 },
		},
	},
	{
		Id = "magma_egg",
		Name = "Magma Egg",
		World = 2,
		Price = 2500000,
		Color = "#C2182B",
		Accent = "#FFC400",
		Pets = {
			{ Pet = "cinder_cat", Weight = 52 },
			{ Pet = "smoke_fox", Weight = 32 },
			{ Pet = "obsidian_owl", Weight = 13 },
			{ Pet = "volcano_ray", Weight = 2.95 },
			{ Pet = "sun_phoenix", Weight = 0.05 },
		},
	},
	{
		Id = "pirate_egg",
		Name = "Pirate Egg",
		World = 3,
		Price = 3000000,
		Color = "#F2D8A7",
		Accent = "#A0522D",
		Pets = {
			{ Pet = "deck_rat", Weight = 55 },
			{ Pet = "cannon_crab", Weight = 30 },
			{ Pet = "captain_parrot", Weight = 12 },
			{ Pet = "ghost_shark", Weight = 2.8 },
			{ Pet = "kraken_jr", Weight = 0.2 },
		},
	},
	{
		Id = "kraken_egg",
		Name = "Kraken Egg",
		World = 3,
		Price = 75000000,
		Color = "#7A3FBF",
		Accent = "#2FD3C9",
		Pets = {
			{ Pet = "skull_slime", Weight = 52 },
			{ Pet = "treasure_mimic", Weight = 32 },
			{ Pet = "mermaid_cat", Weight = 13 },
			{ Pet = "storm_kraken", Weight = 2.95 },
			{ Pet = "galleon_dragon", Weight = 0.05 },
		},
	},
	{
		Id = "snow_egg",
		Name = "Snow Egg",
		World = 4,
		Price = 75000000,
		Color = "#F2F7FF",
		Accent = "#9AE6FF",
		Pets = {
			{ Pet = "snow_bunny", Weight = 55 },
			{ Pet = "penguin", Weight = 30 },
			{ Pet = "ice_fox", Weight = 12 },
			{ Pet = "frost_yeti", Weight = 2.8 },
			{ Pet = "crystal_dragon", Weight = 0.2 },
		},
	},
	{
		Id = "aurora_egg",
		Name = "Aurora Egg",
		World = 4,
		Price = 1900000000,
		Color = "#7CFFB2",
		Accent = "#B97CFF",
		Pets = {
			{ Pet = "aurora_owl", Weight = 52 },
			{ Pet = "glacier_whale", Weight = 32 },
			{ Pet = "polar_bear", Weight = 13 },
			{ Pet = "blizzard_wolf", Weight = 2.95 },
			{ Pet = "northern_phoenix", Weight = 0.05 },
		},
	},
	{
		Id = "overlord_egg",
		Name = "Overlord Egg",
		World = nil,
		Price = 0,
		ProductKey = "OverlordEgg",
		Color = "#14141F",
		Accent = "#39FF14",
		Pets = {
			{ Pet = "glitch_bunny", Weight = 60 },
			{ Pet = "neon_wolf", Weight = 30 },
			{ Pet = "overlord_cat", Weight = 9 },
			{ Pet = "admin_dragon", Weight = 1 },
		},
	},
}

local byId: { [string]: Egg } = {}
for _, egg in list do
	assert(byId[egg.Id] == nil, "duplicate egg " .. egg.Id)
	byId[egg.Id] = egg
	for _, entry in egg.Pets do
		assert(Pets.Get(entry.Pet) ~= nil, "egg " .. egg.Id .. " references unknown pet " .. entry.Pet)
	end
end

local Eggs = {}
Eggs.List = list

function Eggs.Get(id: string): Egg?
	return byId[id]
end

function Eggs.Exists(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

function Eggs.ForWorld(world: number): { Egg }
	local out = {}
	for _, egg in list do
		if egg.World == world or egg.World == nil then
			table.insert(out, egg)
		end
	end
	return out
end

-- Odds (0..1) for each entry after Luck: every tier above the egg's most common tier has its
-- weight multiplied by `luck`.
function Eggs.Odds(egg: Egg, luck: number): { { Pet: string, Chance: number } }
	local Rarity = require(script.Parent.Parent.Config.Rarity)
	local minOrder = math.huge
	for _, entry in egg.Pets do
		local pet = Pets.Get(entry.Pet)
		if pet then
			minOrder = math.min(minOrder, Rarity.Order(pet.Rarity))
		end
	end
	local total = 0
	local weights = {}
	for i, entry in egg.Pets do
		local pet = Pets.Get(entry.Pet)
		local w = entry.Weight
		if pet and Rarity.Order(pet.Rarity) > minOrder then
			w *= math.max(1, luck)
		end
		weights[i] = w
		total += w
	end
	local out = {}
	for i, entry in egg.Pets do
		table.insert(out, { Pet = entry.Pet, Chance = if total > 0 then weights[i] / total else 0 })
	end
	return out
end

return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Gliders</string>
            <string name="Source"><![CDATA[--!strict
-- Throwables. ORIGINAL DESIGN: paper-style gliders instead of stones. World 1 follows the
-- reference's price/power curve shape (CONFIRMED stone table: +1/0 ... +3.5K/40K Wins) with our
-- own items and slightly different numbers. Each glider pays
-- "+N Skill" for every thermal ring it rides through (x the player's Skill multiplier), the same
-- role the reference's stones play per bounce. Bought with Wins on the pedestal row in each world.
export type GliderVisual = {
	Shape: string, -- template in Visual/GliderFactory
	Primary: string,
	Secondary: string,
	Glow: boolean?,
}

export type Glider = {
	Id: string,
	Name: string,
	World: number,
	Order: number,
	Price: number, -- Wins
	SkillPerRing: number,
	Rarity: string,
	Visual: GliderVisual,
}

local list: { Glider } = {}
local byId: { [string]: Glider } = {}

local function add(world: number, id: string, name: string, price: number, skill: number, rarity: string, shape: string, primary: string, secondary: string, glow: boolean?)
	local g: Glider = {
		Id = id,
		Name = name,
		World = world,
		Order = #list + 1,
		Price = price,
		SkillPerRing = skill,
		Rarity = rarity,
		Visual = { Shape = shape, Primary = primary, Secondary = secondary, Glow = glow },
	}
	assert(byId[id] == nil, "duplicate glider " .. id)
	table.insert(list, g)
	byId[id] = g
end

-- World 1: Sunny Isles
add(1, "paper_dart", "Paper Dart", 0, 1, "Common", "Dart", "#F4F4F4", "#C9D3E0")
add(1, "notebook_glider", "Notebook Glider", 2, 3, "Common", "Wide", "#FFF6C9", "#7FB2FF")
add(1, "palm_leaf", "Palm Leaf", 12, 6, "Uncommon", "Leaf", "#5BD15B", "#2E8B2E")
add(1, "gull_feather", "Gull Feather", 45, 14, "Uncommon", "Feather", "#FFFFFF", "#9AA6B5")
add(1, "balsa_wing", "Balsa Wing", 150, 30, "Rare", "Wide", "#E8C48A", "#B98A4A")
add(1, "beach_kite", "Beach Kite", 520, 80, "Rare", "Kite", "#FF6F61", "#FFD447")
add(1, "origami_crane", "Origami Crane", 1500, 200, "Epic", "Crane", "#FF8FC8", "#FFFFFF")
add(1, "coral_glider", "Coral Glider", 4600, 520, "Epic", "Dart", "#FF7F6B", "#FFC2A8")
add(1, "sunset_sail", "Sunset Sail", 14000, 1300, "Legendary", "Kite", "#FF9A3D", "#B24BFF", true)
add(1, "breeze_jet", "Breeze Jet", 40000, 3600, "Legendary", "Jet", "#7FE7FF", "#FFFFFF", true)

-- World 2: Ember Crater
add(2, "ash_dart", "Ash Dart", 60000, 25000, "Rare", "Dart", "#5A5A5A", "#FF7A1A")
add(2, "cinder_leaf", "Cinder Leaf", 150000, 40000, "Rare", "Leaf", "#FF6A00", "#3A1A0A", true)
add(2, "magma_kite", "Magma Kite", 400000, 65000, "Epic", "Kite", "#FF3D00", "#FFC400", true)
add(2, "obsidian_crane", "Obsidian Crane", 1000000, 100000, "Epic", "Crane", "#1B1B24", "#B44DFF", true)
add(2, "phoenix_feather", "Phoenix Feather", 2500000, 160000, "Legendary", "Feather", "#FF5A1F", "#FFE066", true)
add(2, "dragon_wing", "Dragon Wing", 6500000, 250000, "Mythic", "Bat", "#C2182B", "#FF9E3D", true)

-- World 3: Buccaneer Bay
add(3, "map_scroll", "Treasure Map", 1500000, 1500000, "Rare", "Wide", "#F2D8A7", "#A0522D")
add(3, "sail_cloth", "Sail Cloth", 3600000, 2400000, "Epic", "Kite", "#FFFFFF", "#1E1E1E")
add(3, "parrot_plume", "Parrot Plume", 9600000, 3800000, "Epic", "Feather", "#2ECC40", "#FF4136", true)
add(3, "doubloon_dart", "Doubloon Dart", 24000000, 6000000, "Legendary", "Dart", "#FFD700", "#B8860B", true)
add(3, "kraken_fin", "Kraken Fin", 60000000, 9500000, "Legendary", "Bat", "#7A3FBF", "#2FD3C9", true)
add(3, "ghost_galleon", "Ghost Galleon", 160000000, 15000000, "Mythic", "Crane", "#BFF7FF", "#3FA9FF", true)

-- World 4: Frost Peaks
add(4, "snowflake", "Snowflake", 36000000, 50000000, "Rare", "Star", "#E8FBFF", "#9AE6FF", true)
add(4, "icicle_dart", "Icicle Dart", 90000000, 80000000, "Epic", "Dart", "#BDEFFF", "#5FC8FF", true)
add(4, "penguin_wing", "Penguin Wing", 240000000, 130000000, "Epic", "Wide", "#1E2533", "#FFFFFF")
add(4, "yeti_kite", "Yeti Kite", 600000000, 200000000, "Legendary", "Kite", "#F2F7FF", "#7FA7FF", true)
add(4, "aurora_crane", "Aurora Crane", 1500000000, 320000000, "Legendary", "Crane", "#7CFFB2", "#B97CFF", true)
add(4, "comet_jet", "Comet Jet", 3900000000, 500000000, "Mythic", "Jet", "#FFFFFF", "#6AE3FF", true)

local Gliders = {}
Gliders.List = list
Gliders.Default = "paper_dart"

function Gliders.Get(id: string): Glider?
	return byId[id]
end

function Gliders.Exists(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

function Gliders.ForWorld(world: number): { Glider }
	local out = {}
	for _, g in list do
		if g.World == world then
			table.insert(out, g)
		end
	end
	return out
end

-- Highest SkillPerRing among owned gliders (used by relics).
function Gliders.BestOwned(owned: { [string]: boolean }): Glider
	local best = byId[Gliders.Default]
	for id in owned do
		local g = byId[id]
		if g and g.SkillPerRing > best.SkillPerRing then
			best = g
		end
	end
	return best
end

return Gliders
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--!strict
-- Pets (ORIGINAL roster). The reference shows pets as "xN Skill" (LIKELY); we store SkillBoost = N - 1
-- so a pet shown as x2 has SkillBoost 1. Equipped pets add up:
--   Skill multiplier from pets = 1 + sum(SkillBoost) ; Wins multiplier from pets = 1 + sum(WinsBoost)
-- Visuals are built from parts by Visual/PetFactory (no uploaded meshes).
export type PetVisual = {
	Template: string, -- "Critter" | "Bird" | "Blob" | "Fish" | "Dragon" | "Crab" | "Bot"
	Body: string,
	Accent: string,
	Ears: string?, -- "Pointy" | "Round" | "Long" | "None"
	Wings: boolean?,
	Horns: boolean?,
	Glow: boolean?,
}

export type Pet = {
	Id: string,
	Name: string,
	Rarity: string,
	SkillBoost: number, -- 1 = shown as "x2 Skill"
	WinsBoost: number,
	Exclusive: boolean?, -- not in eggs (starter pack, daily, gifts)
	Visual: PetVisual,
}

local list: { Pet } = {}
local byId: { [string]: Pet } = {}

local function add(id: string, name: string, rarity: string, skill: number, wins: number, visual: PetVisual, exclusive: boolean?)
	assert(byId[id] == nil, "duplicate pet " .. id)
	local p: Pet = { Id = id, Name = name, Rarity = rarity, SkillBoost = skill, WinsBoost = wins, Visual = visual, Exclusive = exclusive }
	table.insert(list, p)
	byId[id] = p
end

local function v(template: string, body: string, accent: string, ears: string?, wings: boolean?, horns: boolean?, glow: boolean?): PetVisual
	return { Template = template, Body = body, Accent = accent, Ears = ears, Wings = wings, Horns = horns, Glow = glow }
end

-- World 1 eggs
add("sandy_crab", "Sandy Crab", "Common", 1, 0, v("Crab", "#FF8A5B", "#FFD1B8"))
add("sea_pup", "Sea Pup", "Uncommon", 1.5, 0, v("Critter", "#9ED8FF", "#FFFFFF", "Round"))
add("coral_fox", "Coral Fox", "Rare", 3, 0.05, v("Critter", "#FF7F50", "#FFF1E0", "Pointy"))
add("sun_turtle", "Sun Turtle", "Epic", 5, 0.1, v("Blob", "#7BD36B", "#FFD84A"))
add("golden_gull", "Golden Gull", "Legendary", 10, 0.25, v("Bird", "#FFD447", "#FFFFFF", nil, true, nil, true))

add("coco_monkey", "Coco Monkey", "Common", 3, 0, v("Critter", "#8B5A2B", "#F2D3A2", "Round"))
add("palm_parrot", "Palm Parrot", "Uncommon", 4, 0, v("Bird", "#2ECC71", "#FF4136", nil, true))
add("tiki_cat", "Tiki Cat", "Rare", 6, 0.05, v("Critter", "#C68642", "#3B2414", "Pointy"))
add("reef_ray", "Reef Ray", "Epic", 9, 0.1, v("Fish", "#3FA9FF", "#B5F1FF"))
add("tropic_phoenix", "Tropic Phoenix", "Legendary", 15, 0.3, v("Bird", "#FF6A3D", "#FFE066", nil, true, nil, true))

add("cloud_lamb", "Cloud Lamb", "Common", 6, 0, v("Critter", "#FFFFFF", "#B9C7D9", "Long"))
add("wind_bunny", "Wind Bunny", "Uncommon", 8, 0.05, v("Critter", "#CDEBFF", "#FF9EC7", "Long"))
add("sky_whale", "Sky Whale", "Rare", 11, 0.1, v("Fish", "#6C8CFF", "#E0E8FF"))
add("storm_owl", "Storm Owl", "Epic", 15, 0.15, v("Bird", "#5B5F8A", "#FFE45E", "Pointy", true))
add("aurora_dragon", "Aurora Dragon", "Legendary", 25, 0.4, v("Dragon", "#7CFFB2", "#B97CFF", nil, true, true, true))

-- World 2 eggs
add("ember_pup", "Ember Pup", "Common", 20, 0.05, v("Critter", "#FF6A00", "#3A1A0A", "Pointy"))
add("lava_slime", "Lava Slime", "Uncommon", 25, 0.05, v("Blob", "#FF3D00", "#FFC400", nil, nil, nil, true))
add("ash_bat", "Ash Bat", "Rare", 30, 0.1, v("Bird", "#3A3A44", "#FF5A1F", "Pointy", true))
add("magma_golem", "Magma Golem", "Epic", 40, 0.15, v("Bot", "#4A2A1A", "#FF7A1A", nil, nil, nil, true))
add("fire_drake", "Fire Drake", "Legendary", 60, 0.4, v("Dragon", "#E8261F", "#FFB300", nil, true, true, true))

add("cinder_cat", "Cinder Cat", "Common", 50, 0.05, v("Critter", "#2B2B33", "#FF7A1A", "Pointy"))
add("smoke_fox", "Smoke Fox", "Uncommon", 60, 0.1, v("Critter", "#8C8C99", "#FFB36B", "Pointy"))
add("obsidian_owl", "Obsidian Owl", "Rare", 70, 0.1, v("Bird", "#15151C", "#B44DFF", "Pointy", true, nil, true))
add("volcano_ray", "Volcano Ray", "Epic", 90, 0.2, v("Fish", "#C2182B", "#FFC400", nil, nil, nil, true))
add("sun_phoenix", "Sun Phoenix", "Mythic", 140, 0.6, v("Bird", "#FFB300", "#FF3D00", nil, true, nil, true))

-- World 3 eggs
add("deck_rat", "Deck Rat", "Common", 150, 0.1, v("Critter", "#8C7A6B", "#F2C9C9", "Round"))
add("cannon_crab", "Cannon Crab", "Uncommon", 180, 0.1, v("Crab", "#B22222", "#2B2B2B"))
add("captain_parrot", "Captain Parrot", "Rare", 220, 0.15, v("Bird", "#E63946", "#2A9D8F", nil, true))
add("ghost_shark", "Ghost Shark", "Epic", 280, 0.2, v("Fish", "#BFF7FF", "#7FDBFF", nil, nil, nil, true))
add("kraken_jr", "Kraken Jr.", "Legendary", 400, 0.5, v("Blob", "#7A3FBF", "#2FD3C9", nil, nil, true, true))

add("skull_slime", "Skull Slime", "Common", 350, 0.1, v("Blob", "#E8E3D3", "#2B2B2B"))
add("treasure_mimic", "Treasure Mimic", "Uncommon", 420, 0.15, v("Bot", "#A0522D", "#FFD700"))
add("mermaid_cat", "Mermaid Cat", "Rare", 500, 0.2, v("Critter", "#2FD3C9", "#FF8FC8", "Pointy"))
add("storm_kraken", "Storm Kraken", "Epic", 650, 0.3, v("Fish", "#3D2B7A", "#7FE7FF", nil, nil, true, true))
add("galleon_dragon", "Galleon Dragon", "Mythic", 900, 0.8, v("Dragon", "#1E3A5F", "#FFD700", nil, true, true, true))

-- World 4 eggs
add("snow_bunny", "Snow Bunny", "Common", 1000, 0.15, v("Critter", "#FFFFFF", "#A8D8FF", "Long"))
add("penguin", "Penguin", "Uncommon", 1200, 0.2, v("Bird", "#1E2533", "#FFFFFF"))
add("ice_fox", "Ice Fox", "Rare", 1500, 0.25, v("Critter", "#BDEFFF", "#FFFFFF", "Pointy", nil, nil, true))
add("frost_yeti", "Frost Yeti", "Epic", 1900, 0.35, v("Critter", "#F2F7FF", "#7FA7FF", "Round"))
add("crystal_dragon", "Crystal Dragon", "Legendary", 2600, 0.7, v("Dragon", "#9AE6FF", "#FFFFFF", nil, true, true, true))

add("aurora_owl", "Aurora Owl", "Common", 2200, 0.2, v("Bird", "#7CFFB2", "#B97CFF", "Pointy", true))
add("glacier_whale", "Glacier Whale", "Uncommon", 2700, 0.25, v("Fish", "#BDEFFF", "#4F7CFF"))
add("polar_bear", "Polar Bear", "Rare", 3300, 0.3, v("Critter", "#FFFFFF", "#D8E6F2", "Round"))
add("blizzard_wolf", "Blizzard Wolf", "Epic", 4200, 0.45, v("Critter", "#C9D6E8", "#2F6BFF", "Pointy", nil, nil, true))
add("northern_phoenix", "Northern Phoenix", "Mythic", 6000, 1.2, v("Bird", "#6AE3FF", "#7CFFB2", nil, true, nil, true))

-- Robux egg (available in every world)
add("glitch_bunny", "Glitch Bunny", "Epic", 40, 0.2, v("Critter", "#00FF9C", "#FF00E6", "Long", nil, nil, true))
add("neon_wolf", "Neon Wolf", "Legendary", 80, 0.4, v("Critter", "#2BFFF1", "#1A1A2E", "Pointy", nil, nil, true))
add("overlord_cat", "Overlord Cat", "Mythic", 200, 0.8, v("Critter", "#14141F", "#39FF14", "Pointy", true, true, true))
add("admin_dragon", "Admin Dragon", "Secret", 600, 2.0, v("Dragon", "#39FF14", "#0B0B12", nil, true, true, true))

-- Exclusives
add("starlight_unicat", "Starlight Unicat", "Legendary", 20, 0.25, v("Critter", "#FFFFFF", "#FF9EF5", "Pointy", nil, true, true), true)
add("daily_drake", "Daily Drake", "Epic", 8, 0.15, v("Dragon", "#4FC3FF", "#FFE45E", nil, true, true), true)
add("gift_bear", "Gift Bear", "Rare", 4, 0.1, v("Critter", "#C68642", "#FF4F7B", "Round"), true)

local Pets = {}
Pets.List = list

function Pets.Get(id: string): Pet?
	return byId[id]
end

function Pets.Exists(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Relics</string>
            <string name="Source"><![CDATA[--!strict
-- Limited relics (Robux, global stock). The reference sells a limited relic that is "always 125%
-- better" than your best throwable; ours follows the same rule with original names/art.
export type Relic = {
	Id: string,
	Name: string,
	ProductKey: string, -- Config/Monetization product
	Stock: number, -- global, across all servers (MonetizationService keeps the counter)
	BonusOverBest: number, -- 1.25 = 125% better than the best owned glider
	Visual: { Shape: string, Primary: string, Secondary: string, Glow: boolean? },
}

local list: { Relic } = {
	{
		Id = "aurora_relic",
		Name = "Aurora Relic",
		ProductKey = "AuroraRelic",
		Stock = 1000,
		BonusOverBest = 1.25,
		Visual = { Shape = "Relic", Primary = "#FFCF3D", Secondary = "#FF4F7B", Glow = true },
	},
}

local byId: { [string]: Relic } = {}
for _, r in list do
	byId[r.Id] = r
end

local Relics = {}
Relics.List = list

function Relics.Get(id: string): Relic?
	return byId[id]
end

function Relics.Exists(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

return Relics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Playtime gifts (per session) and the 7-day daily reward track.
-- Reward kinds:
--   { Kind = "Wins", Amount }      x the current world's zone Wins scale
--   { Kind = "Skill", Reps }       = Reps training reps on your best unlocked pad (x multipliers)
--   { Kind = "Potion", Id, Count }
--   { Kind = "Pet", Id }
export type Reward = { Kind: string, Amount: number?, Reps: number?, Id: string?, Count: number? }

export type Gift = { Index: number, Minutes: number, Reward: Reward }

local gifts: { Gift } = {}
local GIFT_MINUTES = { 1, 3, 5, 8, 12, 16, 20, 25, 30, 40, 50, 60 }
local GIFT_REWARDS: { Reward } = {
	{ Kind = "Wins", Amount = 10 },
	{ Kind = "Skill", Reps = 60 },
	{ Kind = "Potion", Id = "skill_potion", Count = 1 },
	{ Kind = "Wins", Amount = 40 },
	{ Kind = "Skill", Reps = 200 },
	{ Kind = "Potion", Id = "luck_potion", Count = 1 },
	{ Kind = "Wins", Amount = 120 },
	{ Kind = "Potion", Id = "wins_potion", Count = 1 },
	{ Kind = "Skill", Reps = 600 },
	{ Kind = "Wins", Amount = 400 },
	{ Kind = "Potion", Id = "skill_potion", Count = 2 },
	{ Kind = "Pet", Id = "gift_bear" },
}
for i, minutes in GIFT_MINUTES do
	table.insert(gifts, { Index = i, Minutes = minutes, Reward = GIFT_REWARDS[i] })
end

local daily: { Reward } = {
	{ Kind = "Wins", Amount = 25 },
	{ Kind = "Potion", Id = "skill_potion", Count = 1 },
	{ Kind = "Wins", Amount = 80 },
	{ Kind = "Potion", Id = "luck_potion", Count = 1 },
	{ Kind = "Skill", Reps = 500 },
	{ Kind = "Potion", Id = "wins_potion", Count = 2 },
	{ Kind = "Pet", Id = "daily_drake" },
}

return {
	Gifts = gifts,
	Daily = daily,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Trails</string>
            <string name="Source"><![CDATA[--!strict
-- Trails: cosmetic ribbons behind your character and your glider, each with a Wins bonus.
export type Trail = {
	Id: string,
	Name: string,
	Price: number, -- Wins
	WinsBoost: number, -- 0.1 = +10% Wins
	Rarity: string,
	Colors: { string }, -- gradient stops
}

local list: { Trail } = {
	{ Id = "bubble", Name = "Bubble Trail", Price = 100, WinsBoost = 0.05, Rarity = "Common", Colors = { "#BFF7FF", "#FFFFFF" } },
	{ Id = "sunset", Name = "Sunset Trail", Price = 600, WinsBoost = 0.1, Rarity = "Uncommon", Colors = { "#FFB347", "#FF5E62" } },
	{ Id = "ocean", Name = "Ocean Trail", Price = 2500, WinsBoost = 0.2, Rarity = "Rare", Colors = { "#00C6FF", "#0072FF" } },
	{ Id = "ember", Name = "Ember Trail", Price = 25000, WinsBoost = 0.35, Rarity = "Rare", Colors = { "#FFC400", "#FF3D00" } },
	{ Id = "gold", Name = "Gold Trail", Price = 150000, WinsBoost = 0.6, Rarity = "Epic", Colors = { "#FFF3B0", "#FFC53D", "#B8860B" } },
	{ Id = "jolly", Name = "Jolly Trail", Price = 1000000, WinsBoost = 1.0, Rarity = "Epic", Colors = { "#1E1E1E", "#FFFFFF", "#E63946" } },
	{ Id = "frost", Name = "Frost Trail", Price = 8000000, WinsBoost = 1.6, Rarity = "Legendary", Colors = { "#FFFFFF", "#9AE6FF", "#4F7CFF" } },
	{ Id = "aurora", Name = "Aurora Trail", Price = 60000000, WinsBoost = 2.5, Rarity = "Legendary", Colors = { "#7CFFB2", "#6AE3FF", "#B97CFF" } },
	{ Id = "rainbow", Name = "Rainbow Trail", Price = 500000000, WinsBoost = 5, Rarity = "Mythic", Colors = { "#FF4F4F", "#FFC53D", "#5BE05B", "#3FA9FF", "#B65CFF" } },
}

local byId: { [string]: Trail } = {}
for _, t in list do
	byId[t.Id] = t
end

local Trails = {}
Trails.List = list

function Trails.Get(id: string): Trail?
	return byId[id]
end

function Trails.Exists(id: any): boolean
	return type(id) == "string" and byId[id] ~= nil
end

return Trails
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Training</string>
            <string name="Source"><![CDATA[--!strict
-- Training pads. Standing on a pad and tapping (or AUTO) gives Skill = Multiplier x Skill
-- multiplier per rep. Matches the reference row: 1x/4x/10x/20x gated by 0/2/4/6 rebirths, plus
-- "ALL WORLDS" pads unlocked by game passes (3x/15x/50x in world 1, scaled in later worlds).
export type Pad = {
	Id: string,
	World: number,
	Slot: number, -- position in the row (Config/Map)
	Multiplier: number,
	Rebirths: number, -- rebirths required (0 = open)
	PassKey: string?, -- game pass that unlocks it in every world
	Color: string,
	Accent: string,
}

local list: { Pad } = {}
local byId: { [string]: Pad } = {}

local ROWS = {
	-- { base multipliers }, { rebirth gates }, pass base
	[1] = { mults = { 1, 4, 10, 20 }, gates = { 0, 2, 4, 6 }, passBase = 1 },
	[2] = { mults = { 40, 80, 160, 300 }, gates = { 1, 3, 5, 7 }, passBase = 40 },
	[3] = { mults = { 600, 1200, 2500, 5000 }, gates = { 4, 6, 8, 10 }, passBase = 600 },
	[4] = { mults = { 10000, 25000, 60000, 150000 }, gates = { 8, 11, 14, 18 }, passBase = 10000 },
}

local PAD_COLORS = { "#A0703C", "#3FA9FF", "#B65CFF", "#FF5A5A" }
local PASS_PADS = {
	{ key = "Pad3x", mult = 3, color = "#E9EEF5", accent = "#3FA9FF" },
	{ key = "Pad15x", mult = 15, color = "#FF7F50", accent = "#FFFFFF" },
	{ key = "Pad50x", mult = 50, color = "#FFC53D", accent = "#FF4F7B" },
}

for world, row in ROWS do
	for i, mult in row.mults do
		local pad: Pad = {
			Id = string.format("w%d_pad%d", world, i),
			World = world,
			Slot = i,
			Multiplier = mult,
			Rebirths = row.gates[i],
			Color = PAD_COLORS[i],
			Accent = "#FFFFFF",
		}
		table.insert(list, pad)
		byId[pad.Id] = pad
	end
	for j, pass in PASS_PADS do
		local pad: Pad = {
			Id = string.format("w%d_pass%d", world, j),
			World = world,
			Slot = #row.mults + j,
			Multiplier = pass.mult * row.passBase,
			Rebirths = 0,
			PassKey = pass.key,
			Color = pass.color,
			Accent = pass.accent,
		}
		table.insert(list, pad)
		byId[pad.Id] = pad
	end
end

local Training = {}
Training.List = list
Training.SlotsPerWorld = 7

function Training.Get(id: string): Pad?
	return byId[id]
end

function Training.ForWorld(world: number): { Pad }
	local out = {}
	for _, pad in list do
		if pad.World == world then
			table.insert(out, pad)
		end
	end
	table.sort(out, function(a, b)
		return a.Slot < b.Slot
	end)
	return out
end

return Training
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!strict
-- First-session guide. The server advances steps from real gameplay events (never from the
-- client saying "done"); the client draws the hint and an arrow to the target.
export type Step = {
	Id: string,
	Text: string,
	Target: string?, -- map anchor name (MapService registers anchors per world)
	Event: string, -- server event that completes the step
	Count: number?,
}

local steps: { Step } = {
	{ Id = "train", Text = "Stand on the 1x SKILL pad and tap to train!", Target = "Pad1", Event = "Train", Count = 15 },
	{ Id = "zone", Text = "Walk into the THROW ZONE.", Target = "ThrowZone", Event = "EnterThrowZone" },
	{ Id = "throw", Text = "Hold THROW, release in the green for a PERFECT launch!", Target = "ThrowZone", Event = "Throw" },
	{ Id = "gust", Text = "Tap when your glider hits a ring for a PERFECT catch (x2 Skill)!", Target = nil, Event = "Ring", Count = 3 },
	{ Id = "glider", Text = "Spend Wins on a better glider at the shop!", Target = "GliderShop", Event = "BuyGlider" },
	{ Id = "egg", Text = "Hatch an egg for a pet that boosts your Skill.", Target = "Egg1", Event = "Hatch" },
}

return {
	Steps = steps,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Worlds</string>
            <string name="Source"><![CDATA[--!strict
-- Worlds (ORIGINAL names/themes; the reference has a beach start, a volcano world and a pirate
-- world, we keep that progression shape with our own places and add a fourth).
-- Each world is a separate area of the same place, offset along X (see Config/Map).
-- Unlocking follows the reference rule (CONFIRMED): a throw that reaches the end of the current
-- river opens the next world. ORIGINAL addition: a rebirth gate too, so a lucky special throw
-- (x3 / x8) can reach the river end early without skipping a whole world's progression.
-- DistanceScale grows x25 per world so each world spans a few rebirths.
export type World = {
	Id: number,
	Key: string,
	Name: string,
	Theme: string, -- palette key in Visual/Themes
	DistanceScale: number, -- scales zone spacing, ring counts, rendering (see Config/Flight)
	UnlockWins: number, -- extra Wins price at the portal (0 = free once the river end is reached)
	UnlockRebirths: number, -- extra rebirth gate (0 = none)
	UnlockZone: string?, -- zone id that must be reached first (end of the previous world's river)
	SkillPackScale: number, -- Robux skill packs are multiplied by this in this world
	Description: string,
}

local list: { World } = {
	{
		Id = 1,
		Key = "SunnyIsles",
		Name = "Sunny Isles",
		Theme = "Isles",
		DistanceScale = 1,
		UnlockWins = 0,
		UnlockRebirths = 0,
		SkillPackScale = 1,
		Description = "Warm breeze, gentle thermals.",
	},
	{
		Id = 2,
		Key = "EmberCrater",
		Name = "Ember Crater",
		Theme = "Ember",
		DistanceScale = 25,
		UnlockWins = 0,
		UnlockRebirths = 5,
		UnlockZone = "w1_z12",
		SkillPackScale = 1000,
		Description = "Lava vents throw gliders sky-high.",
	},
	{
		Id = 3,
		Key = "BuccaneerBay",
		Name = "Buccaneer Bay",
		Theme = "Bay",
		DistanceScale = 625,
		UnlockWins = 0,
		UnlockRebirths = 7,
		UnlockZone = "w2_z12",
		SkillPackScale = 1000000,
		Description = "Sea winds over sunken treasure.",
	},
	{
		Id = 4,
		Key = "FrostPeaks",
		Name = "Frost Peaks",
		Theme = "Frost",
		DistanceScale = 15625,
		UnlockWins = 0,
		UnlockRebirths = 9,
		UnlockZone = "w3_z12",
		SkillPackScale = 1000000000,
		Description = "Thin icy air, the longest glides of all.",
	},
}

local Worlds = {}
Worlds.List = list
Worlds.Count = #list

function Worlds.Get(id: number): World?
	return list[id]
end

function Worlds.Exists(id: any): boolean
	return type(id) == "number" and list[id] ~= nil
end

return Worlds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Zones</string>
            <string name="Source"><![CDATA[--!strict
-- Distance zones along each world's channel. Landing in a zone pays its Wins (x Wins multiplier).
-- Zone signs are built at Sim/FlightSim.RenderZ(Distance) so they line up with flights exactly.
local Worlds = require(script.Parent.Worlds)

export type Zone = {
	Id: string,
	World: number,
	Index: number,
	Name: string,
	Distance: number, -- meters where the zone starts
	Wins: number,
	Color: string,
}

-- Base layout (meters, wins) scaled per world by DistanceScale and WinsScale.
-- (LIKELY anchor: a fan sample of a 1,404 m World 1 throw paid ~200 Wins.)
local BASE = {
	{ 0, 1 },
	{ 25, 3 },
	{ 60, 6 },
	{ 120, 12 },
	{ 220, 25 },
	{ 400, 45 },
	{ 700, 90 },
	{ 1200, 180 },
	{ 2000, 320 },
	{ 3500, 550 },
	{ 6000, 950 },
	{ 10000, 1600 },
}

local WINS_SCALE = { 1, 25, 600, 15000 }

local NAMES: { [number]: { string } } = {
	[1] = {
		"Driftwood Dock",
		"Coral Shallows",
		"Sunset Lagoon",
		"Coconut Cove",
		"Turtle Reef",
		"Lighthouse Point",
		"Whale Bay",
		"Breezy Strait",
		"Rainbow Falls",
		"Cloud Harbor",
		"Sky Archipelago",
		"Edge of the Map",
	},
	[2] = {
		"Ash Landing",
		"Cinder Flats",
		"Obsidian Pools",
		"Smoke Ridge",
		"Magma River",
		"Dragon's Nest",
		"Fire Geysers",
		"Basalt Towers",
		"Molten Core",
		"Phoenix Rise",
		"Eruption Peak",
		"Sun Forge",
	},
	[3] = {
		"Plank Pier",
		"Barrel Beach",
		"Parrot Isle",
		"Kraken Reef",
		"Cannon Cove",
		"Shipwreck Shoals",
		"Skull Rock",
		"Treasure Sands",
		"Ghost Fleet",
		"Mermaid Lagoon",
		"Storm Sea",
		"Captain's Horizon",
	},
	[4] = {
		"Snowdrift Dock",
		"Pine Hollow",
		"Frozen Falls",
		"Penguin Point",
		"Glacier Gap",
		"Crystal Caves",
		"Yeti Ridge",
		"Aurora Fields",
		"Icicle Spires",
		"Blizzard Belt",
		"Polar Crown",
		"Northern Lights",
	},
}

local COLORS = {
	"#FFFFFF",
	"#7CF3FF",
	"#FFB36B",
	"#9CFF7A",
	"#5FE0C8",
	"#FFE45E",
	"#7AB8FF",
	"#C49BFF",
	"#FF8FD0",
	"#B6FFF2",
	"#FFD27A",
	"#FF6B6B",
}

local byWorld: { [number]: { Zone } } = {}
local byId: { [string]: Zone } = {}

for _, world in Worlds.List do
	local zones = {}
	for i, row in BASE do
		local zone: Zone = {
			Id = string.format("w%d_z%d", world.Id, i),
			World = world.Id,
			Index = i,
			Name = NAMES[world.Id][i],
			Distance = row[1] * world.DistanceScale,
			Wins = row[2] * WINS_SCALE[world.Id],
			Color = COLORS[i],
		}
		zones[i] = zone
		byId[zone.Id] = zone
	end
	byWorld[world.Id] = zones
end

local Zones = {}

function Zones.ForWorld(worldId: number): { Zone }
	return byWorld[worldId] or {}
end

function Zones.Get(id: string): Zone?
	return byId[id]
end

-- Last zone of a world: landing there unlocks the next world (CONFIRMED mechanic: reaching the
-- end of the river opens the next world).
function Zones.Last(worldId: number): Zone?
	local zones = byWorld[worldId]
	return if zones then zones[#zones] else nil
end

-- The zone a landing at `distance` meters falls in (furthest zone whose start <= distance).
function Zones.At(worldId: number, distance: number): Zone
	local zones = byWorld[worldId] or byWorld[1]
	local found = zones[1]
	for _, zone in zones do
		if distance >= zone.Distance then
			found = zone
		else
			break
		end
	end
	return found
end

return Zones
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Net</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Single source of truth for every network endpoint. The server creates them (Remotes.Init),
-- clients wait for them. Client -> server endpoints are INTENTS only ("I want to throw", "I want
-- to buy X"); the server decides every outcome. There is no remote that grants Skill or Wins,
-- sets a distance, unlocks a world or finishes a rebirth.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Spec: { [string]: "RemoteEvent" | "RemoteFunction" | "UnreliableRemoteEvent" } = {
	-- client -> server (intents)
	RequestThrowCharge = "RemoteEvent", -- () start holding the launch meter
	RequestThrow = "RemoteEvent", -- () release / quick tap
	RequestGust = "RemoteEvent", -- (flightId, ringIndex) tap for a PERFECT catch
	RequestTrain = "RemoteEvent", -- () one manual rep on the pad you stand on
	RequestToggle = "RemoteEvent", -- (key: "AutoTrain"|"AutoThrow", on)
	RequestBuyThrowable = "RemoteFunction", -- (gliderId)
	RequestEquipThrowable = "RemoteFunction", -- (gliderId | "relic:<id>")
	RequestHatchEgg = "RemoteFunction", -- (eggId, count)
	RequestPetAction = "RemoteFunction", -- (action, args)
	RequestTrailAction = "RemoteFunction", -- (action: "Buy"|"Equip"|"Unequip", trailId)
	RequestRebirth = "RemoteFunction", -- ()
	RequestEnterWorld = "RemoteFunction", -- (worldId)
	RequestClaimGift = "RemoteFunction", -- (giftIndex)
	RequestClaimDaily = "RemoteFunction", -- ()
	RequestRedeemCode = "RemoteFunction", -- (code)
	RequestUseBoost = "RemoteFunction", -- (potionId)
	RequestPurchase = "RemoteFunction", -- (kind: "Pass"|"Product", key)
	RequestSetting = "RemoteEvent", -- (key, value) cosmetic preferences
	RequestTutorial = "RemoteEvent", -- ("Skip")
	AdminRequest = "RemoteFunction", -- diagnostics; rejected for non-admins

	-- server -> client
	PlayerData = "RemoteEvent", -- owner's profile view
	Notify = "RemoteEvent", -- toast { Text, Kind }
	FlightStarted = "RemoteEvent", -- broadcast plan
	FlightRing = "RemoteEvent", -- owner: { Id, Index, Perfect, Amount }
	FlightLanded = "RemoteEvent", -- broadcast { Id, UserId, Distance, Zone } + owner rewards
	ChargeState = "RemoteEvent", -- owner: { Charging, StartedAt }
	TrainResult = "RemoteEvent", -- owner: amount per rep (for popups)
	HatchResult = "RemoteEvent", -- owner: { Egg, Pets }
	ServerInfo = "RemoteEvent", -- relic stock, leaderboards
	WorldChanged = "RemoteEvent", -- owner: worldId (camera/lighting swap)
}

local Remotes = {}
Remotes.Spec = Spec

local FOLDER_NAME = "Remotes"

function Remotes.Init()
	assert(RunService:IsServer(), "Remotes.Init is server-only")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for name, className in Spec do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
	end
end

function Remotes.Event(name: string): RemoteEvent
	assert(Spec[name] == "RemoteEvent", "not a RemoteEvent: " .. name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Unreliable(name: string): UnreliableRemoteEvent
	assert(Spec[name] == "UnreliableRemoteEvent", "not an UnreliableRemoteEvent: " .. name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: UnreliableRemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	assert(Spec[name] == "RemoteFunction", "not a RemoteFunction: " .. name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Sim</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">FlightSim</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic flight plans (pure Luau, shared by server, client and the headless tests).
--
-- The server builds a plan at launch and owns every reward derived from it (ring times, landing
-- time, distance, zone). Clients sample the very same plan to draw the glider, so what players see
-- and what the server pays always agree. Nothing here reads client input.
local Flight = require(script.Parent.Parent.Config.Flight)
local Rng = require(script.Parent.Parent.Util.Rng)

local FlightSim = {}

export type Plan = {
	Id: number,
	UserId: number,
	World: number,
	Seed: number,
	Distance: number, -- logical meters
	Duration: number, -- seconds
	Length: number, -- rendered studs along the channel
	Height: number, -- apex (studs)
	Rings: { number }, -- rendered fractions u_k in (0, 1)
	RingTimes: { number }, -- seconds from launch
	Sway: number, -- lateral sway amplitude (studs)
	SwayFreq: number,
	Glider: string,
	Trail: string?,
	Launch: number, -- launch meter value 0..1
	PerfectLaunch: boolean,
	Special: string?, -- Flight.Specials id (rare boosted throw) or nil
	Start: number, -- server time (workspace:GetServerTimeNow()) at launch
}

-- Distance in meters for a Skill value and a launch multiplier.
function FlightSim.DistanceFor(skill: number, launchMultiplier: number): number
	local s = math.max(0, skill)
	local d = (Flight.DistanceBase + Flight.DistanceScale * s ^ Flight.DistanceExponent) * launchMultiplier
	if d ~= d then
		return Flight.DistanceBase
	end
	return math.clamp(d, 1, Flight.MaxDistance)
end

-- Launch multiplier from the meter value (0..1).
function FlightSim.LaunchMultiplier(meter: number): (number, boolean)
	local m = math.clamp(meter, 0, 1)
	if m >= Flight.PerfectLaunchAt then
		return Flight.PerfectLaunchMultiplier, true
	end
	local a = m / Flight.PerfectLaunchAt
	return Flight.LaunchMin + (Flight.LaunchMax - Flight.LaunchMin) * a, false
end

-- Meter value after holding for `held` seconds (triangle wave 0 -> 1 -> 0).
function FlightSim.MeterAt(held: number): number
	local period = Flight.MeterPeriod
	local phase = (math.max(0, held) % period) / period
	return if phase < 0.5 then phase * 2 else (1 - phase) * 2
end

-- Logical meters -> rendered studs along the channel (monotonic, bounded slope).
function FlightSim.RenderZ(distance: number, worldScale: number): number
	local d0 = Flight.RenderD0 * worldScale
	return Flight.RenderScale * math.log(1 + math.max(0, distance) / d0)
end

-- Rendered studs -> logical meters (inverse of RenderZ).
function FlightSim.LogicalAt(z: number, worldScale: number): number
	local d0 = Flight.RenderD0 * worldScale
	local e = math.exp(math.max(0, z) / Flight.RenderScale) - 1
	return d0 * e
end

local function log2(x: number): number
	return math.log(x) / math.log(2)
end

function FlightSim.DurationFor(distance: number, worldScale: number): number
	local t = Flight.TimeBase + Flight.TimeLog * log2(1 + distance / (Flight.TimeD0 * worldScale))
	return math.clamp(t, Flight.TimeMin, Flight.TimeMax)
end

function FlightSim.RingCountFor(distance: number, worldScale: number): number
	local k = math.floor(Flight.RingBase + Flight.RingLog * log2(1 + distance / (Flight.RingD0 * worldScale)))
	return math.clamp(k, Flight.RingMin, Flight.RingMax)
end

function FlightSim.HeightFor(distance: number, worldScale: number): number
	local h = Flight.HeightBase + Flight.HeightLog * log2(1 + distance / (Flight.RingD0 * worldScale))
	return math.clamp(h, Flight.HeightMin, Flight.HeightMax)
end

-- Rendered progress (0..1) at time t.
function FlightSim.Progress(t: number, duration: number): number
	if duration <= 0 then
		return 1
	end
	local s = math.clamp(t / duration, 0, 1)
	return 1 - (1 - s) ^ Flight.EaseExponent
end

-- Time at which rendered progress reaches u.
function FlightSim.TimeAtProgress(u: number, duration: number): number
	local p = math.clamp(u, 0, 1)
	return duration * (1 - (1 - p) ^ (1 / Flight.EaseExponent))
end

-- Ring schedule: times (seconds) with an accelerating rhythm and a hard minimum gap, plus the
-- matching path fractions. The ring count is reduced if the flight is too short to fit it.
function FlightSim.RingSchedule(count: number, duration: number, seed: number): ({ number }, { number })
	local times, fractions = {}, {}
	if count <= 0 or duration <= 0 then
		return times, fractions
	end
	local first = math.max(Flight.RingFirstMin, duration * Flight.FirstRingTime)
	local last = math.max(first, duration * Flight.LastRingTime)
	local span = last - first
	local minGap = Flight.RingMinGap
	local maxCount = math.floor(span / (minGap * 1.06)) + 1
	local k = math.clamp(count, 1, math.max(1, maxCount))
	times[1] = first
	if k > 1 then
		local rng = Rng.new(seed)
		local jitter = table.create(k - 1)
		for i = 1, k - 1 do
			jitter[i] = rng:Range(0.95, 1.05)
		end
		-- relax the decay toward uniform spacing until the smallest gap fits
		local decay = Flight.RingSpacingDecay
		local gaps = table.create(k - 1)
		for _ = 1, 40 do
			local total = 0
			for i = 1, k - 1 do
				gaps[i] = decay ^ (i - 1) * jitter[i]
				total += gaps[i]
			end
			local smallest = math.huge
			for i = 1, k - 1 do
				gaps[i] = gaps[i] / total * span
				smallest = math.min(smallest, gaps[i])
			end
			if smallest >= minGap or decay >= 1 then
				break
			end
			decay = math.min(1, decay + 0.01)
		end
		local t = first
		for i = 1, k - 1 do
			t += gaps[i]
			times[i + 1] = t
		end
	end
	for i, t in times do
		fractions[i] = FlightSim.Progress(t, duration)
	end
	return times, fractions
end

export type BuildArgs = {
	Id: number,
	UserId: number,
	World: number,
	WorldScale: number,
	Skill: number,
	Launch: number,
	Seed: number,
	Glider: string,
	Trail: string?,
	Start: number,
	SpecialLuck: number?,
}

-- Rare special throw rolled from the seed (nil for a normal throw). `luck` scales the chances.
function FlightSim.RollSpecial(seed: number, luck: number?): Flight.Special?
	local roll = Rng.new(seed + 99991):Next()
	local scale = math.max(1, luck or 1)
	local acc = 0
	for _, special in Flight.Specials do
		acc += special.Chance * scale
		if roll < acc then
			return special
		end
	end
	return nil
end

-- Builds a complete plan. Pure: same args -> same plan.
function FlightSim.Build(a: BuildArgs): Plan
	local launchMul, perfect = FlightSim.LaunchMultiplier(a.Launch)
	local special = FlightSim.RollSpecial(a.Seed, a.SpecialLuck)
	local distance = FlightSim.DistanceFor(a.Skill, launchMul * (if special then special.Multiplier else 1))
	local duration = FlightSim.DurationFor(distance, a.WorldScale)
	local length = math.min(FlightSim.RenderZ(distance, a.WorldScale), Flight.RenderMaxZ)
	local count = FlightSim.RingCountFor(distance, a.WorldScale)
	local times, rings = FlightSim.RingSchedule(count, duration, a.Seed)
	local rng = Rng.new(a.Seed + 7919)
	return {
		Id = a.Id,
		UserId = a.UserId,
		World = a.World,
		Seed = a.Seed,
		Distance = distance,
		Duration = duration,
		Length = math.max(length, 30),
		Height = FlightSim.HeightFor(distance, a.WorldScale),
		Rings = rings,
		RingTimes = times,
		Sway = rng:Range(2, 7),
		SwayFreq = rng:Range(1.2, 2.4),
		Glider = a.Glider,
		Trail = a.Trail,
		Launch = math.clamp(a.Launch, 0, 1),
		PerfectLaunch = perfect,
		Special = if special then special.Id else nil,
		Start = a.Start,
	}
end

-- Altitude (studs above the water) at rendered progress u.
function FlightSim.Altitude(plan: Plan, u: number): number
	local H = plan.Height
	local rise = math.clamp(u / 0.1, 0, 1)
	local base = H * (1 - (1 - rise) ^ 2) * (1 - u) ^ 0.8
	local launchHeight = 6 * (1 - rise)
	local bump = 0
	local width = 0.035
	for i, ru in plan.Rings do
		local x = (u - ru - width * 0.6) / width
		if x > -3 and x < 3 then
			bump += H * Flight.ThermalLift * Flight.ThermalDecay ^ (i - 1) * math.exp(-x * x)
		end
	end
	return math.max(0, base + launchHeight + bump * (1 - u) ^ 0.3)
end

export type Sample = {
	Progress: number, -- rendered fraction 0..1
	Z: number, -- studs along the channel
	X: number, -- lateral offset (studs)
	Y: number, -- altitude (studs)
	Distance: number, -- logical meters flown so far
	Landed: boolean,
}

function FlightSim.SpecialInfo(id: string?): Flight.Special?
	if not id then
		return nil
	end
	for _, special in Flight.Specials do
		if special.Id == id then
			return special
		end
	end
	return nil
end

-- Glider state at `t` seconds after launch.
function FlightSim.Sample(plan: Plan, t: number, worldScale: number): Sample
	local u = FlightSim.Progress(t, plan.Duration)
	local z = plan.Length * u
	local logical: number
	if u >= 1 then
		logical = plan.Distance
	else
		-- map the rendered position back to meters, scaled so the counter ends exactly on Distance
		local full = FlightSim.RenderZ(plan.Distance, worldScale)
		logical = FlightSim.LogicalAt(full * u, worldScale)
		logical = math.min(logical, plan.Distance)
	end
	local sway = plan.Sway * math.sin(u * math.pi * plan.SwayFreq * 2) * (1 - u)
	return {
		Progress = u,
		Z = z,
		X = sway,
		Y = FlightSim.Altitude(plan, u),
		Distance = logical,
		Landed = t >= plan.Duration,
	}
end

-- Index of the ring the player should be aiming for at time t (first ring not yet passed), or nil.
function FlightSim.NextRing(plan: Plan, t: number): number?
	for i, rt in plan.RingTimes do
		if t <= rt + Flight.GustLate then
			return i
		end
	end
	return nil
end

-- Judges a gust tap for ring `index` at flight time `t`. `latency` is extra allowance in seconds.
-- Returns "Perfect", "Miss" (too early: spends the ring), or nil (ignored / too late).
function FlightSim.JudgeGust(plan: Plan, index: number, t: number, latency: number): string?
	local rt = plan.RingTimes[index]
	if rt == nil then
		return nil
	end
	local allowance = math.clamp(latency, 0, Flight.GustMaxLatency)
	if t >= rt - Flight.GustEarly and t <= rt + Flight.GustLate + allowance then
		return "Perfect"
	end
	if t < rt - Flight.GustEarly and t >= rt - Flight.GustTooEarly then
		return "Miss"
	end
	return nil
end

-- Moment after which ring `index` can no longer change (server pays it then).
function FlightSim.RingSettleTime(plan: Plan, index: number): number
	return (plan.RingTimes[index] or 0) + Flight.GustLate + Flight.GustMaxLatency
end

-- Plain table safe for RemoteEvents.
function FlightSim.Serialize(plan: Plan): { [string]: any }
	return table.clone(plan) :: any
end

-- Rebuilds a plan received over the network, validating shapes (clients only render it).
function FlightSim.Deserialize(raw: any): Plan?
	if type(raw) ~= "table" then
		return nil
	end
	local function n(v: any): boolean
		return type(v) == "number" and v == v
	end
	if not (n(raw.Id) and n(raw.UserId) and n(raw.World) and n(raw.Distance) and n(raw.Duration) and n(raw.Length) and n(raw.Height) and n(raw.Start)) then
		return nil
	end
	if type(raw.Rings) ~= "table" or type(raw.RingTimes) ~= "table" or type(raw.Glider) ~= "string" then
		return nil
	end
	return raw :: Plan
end

return FlightSim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- Pure progression math shared by server (authoritative), client (display) and tests:
-- multipliers, XP/levels, rebirth rules and reward sizes. No Roblox APIs, no side effects except
-- the documented profile mutation in SyncLevel.
local Shared = script.Parent.Parent
local Economy = require(Shared.Config.Economy)
local Pets = require(Shared.Definitions.Pets)
local Trails = require(Shared.Definitions.Trails)
local Boosts = require(Shared.Definitions.Boosts)
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)

local Progression = {}

-- Minimal profile shape these functions read (the server profile and the client view both fit).
export type ProfileLike = {
	Skill: number,
	Rebirths: number,
	Level: number,
	XP: number,
	Pets: { [string]: { Id: string, Locked: boolean? } },
	EquippedPets: { string },
	Boosts: { [string]: number }, -- boost id -> unix expiry
	Trail: string,
	Glider: string,
	Gliders: { [string]: boolean },
	Relic: string, -- equipped relic id or ""
	Relics: { [string]: boolean },
}

export type Context = {
	Passes: { [string]: boolean },
	Friends: number,
	Premium: boolean,
	Now: number,
	EventSkill: number?, -- live event multipliers (1 when no event)
	EventWins: number?,
}

function Progression.FriendBoost(friends: number): number
	return math.min(Economy.FriendBoostMax, Economy.FriendBoostPer * math.max(0, friends))
end

-- Boost from equipped pets. Only the first `slots` equipped pets count (a refunded slot pass
-- never deletes equips; the extra ones simply stop counting).
function Progression.PetBoosts(p: ProfileLike, slots: number?): (number, number)
	local skill, wins = 0, 0
	for i, uid in p.EquippedPets do
		if slots and i > slots then
			break
		end
		local owned = p.Pets[uid]
		local def = if owned then Pets.Get(owned.Id) else nil
		if def then
			skill += def.SkillBoost
			wins += def.WinsBoost
		end
	end
	return skill, wins
end

function Progression.BoostActive(p: ProfileLike, stat: string, now: number): number
	local mult = 1
	for id, expiry in p.Boosts do
		local def = Boosts.Get(id)
		if def and def.Stat == stat and expiry > now then
			mult *= def.Multiplier
		end
	end
	return mult
end

export type Breakdown = {
	Rebirth: number,
	Pets: number,
	Pass: number,
	Potion: number,
	Friends: number,
	Premium: number,
	Event: number,
	Total: number,
}

-- Multiplier applied to every Skill gain (training reps and thermal rings).
function Progression.SkillBreakdown(p: ProfileLike, ctx: Context): Breakdown
	local rebirth = Economy.RebirthMultiplier(p.Rebirths)
	local petSkill = Progression.PetBoosts(p, Progression.PetSlots(ctx))
	local pets = 1 + petSkill
	local pass = if ctx.Passes.DoubleSkill then 2 else 1
	local potion = Progression.BoostActive(p, "Skill", ctx.Now)
	local friends = 1 + Progression.FriendBoost(ctx.Friends)
	local premium = if ctx.Premium then 1 + Economy.PremiumSkillBonus else 1
	local event = ctx.EventSkill or 1
	return {
		Rebirth = rebirth,
		Pets = pets,
		Pass = pass,
		Potion = potion,
		Friends = friends,
		Premium = premium,
		Event = event,
		Total = rebirth * pets * pass * potion * friends * premium * event,
	}
end

function Progression.SkillMultiplier(p: ProfileLike, ctx: Context): number
	return Progression.SkillBreakdown(p, ctx).Total
end

function Progression.WinsMultiplier(p: ProfileLike, ctx: Context): number
	local _, petWins = Progression.PetBoosts(p, Progression.PetSlots(ctx))
	local trail = Trails.Get(p.Trail)
	local trailBoost = if trail then trail.WinsBoost else 0
	local pass = if ctx.Passes.DoubleWins then 2 else 1
	local potion = Progression.BoostActive(p, "Wins", ctx.Now)
	return (1 + petWins) * (1 + trailBoost) * pass * potion * (ctx.EventWins or 1)
end

function Progression.Luck(p: ProfileLike, ctx: Context): number
	return Progression.BoostActive(p, "Luck", ctx.Now)
end

-- "+N Skill" per thermal ring for the equipped glider (or relic: 125% better than the best glider).
function Progression.SkillPerRing(p: ProfileLike): number
	if p.Relic ~= "" and p.Relics[p.Relic] then
		local relic = Relics.Get(p.Relic)
		if relic then
			local best = Gliders.BestOwned(p.Gliders)
			return best.SkillPerRing * (1 + relic.BonusOverBest)
		end
	end
	local glider = Gliders.Get(p.Glider) or Gliders.Get(Gliders.Default)
	return if glider then glider.SkillPerRing else 1
end

function Progression.LevelCap(p: ProfileLike): number
	return Economy.LevelCap(p.Rebirths)
end

function Progression.IsMaxLevel(p: ProfileLike): boolean
	return p.Level >= Progression.LevelCap(p)
end

-- Rebirth button percentage (OBSERVED "Rebirth 83%" / "100%"): level progress toward the cap.
function Progression.RebirthProgress(p: ProfileLike): number
	return math.clamp(p.Level / Progression.LevelCap(p), 0, 1)
end

function Progression.CanRebirth(p: ProfileLike): boolean
	return Progression.IsMaxLevel(p) and p.Rebirths < Economy.MaxRebirths
end

-- Recomputes Level and XP (progress inside the level, in Skill) from Skill and the cap.
-- Mutates p.Level / p.XP and returns the number of levels gained.
function Progression.SyncLevel(p: ProfileLike): number
	local cap = Progression.LevelCap(p)
	local before = p.Level
	local level = Economy.LevelForSkill(p.Skill, cap)
	p.Level = level
	if level >= cap then
		p.XP = Economy.XPToNext(level)
	else
		p.XP = math.max(0, p.Skill - Economy.SkillForLevel(level))
	end
	return math.max(0, level - before)
end

-- Does this Skill source still pay right now? (Training and rings stop at the level cap.)
function Progression.SourcePays(p: ProfileLike, source: string): boolean
	if Economy.CappedSources[source] and Progression.IsMaxLevel(p) then
		return false
	end
	return true
end

-- Number of pet slots.
function Progression.PetSlots(ctx: Context): number
	return Economy.PetSlots + (if ctx.Passes.PetSlots then Economy.PetSlotsPass else 0)
end

return Progression
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number / time formatting shared by UI and server messages. Handles the very large values an
-- incremental game reaches (up to ~1e303) with short suffixes: 1.2K, 3.4M ... 5.6Dc.
local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg" }

function Format.Commas(n: number): string
	if n ~= n or math.abs(n) >= 1e15 then
		return Format.Short(n)
	end
	local s = tostring(math.floor(n))
	local negative = string.sub(s, 1, 1) == "-"
	if negative then
		s = string.sub(s, 2)
	end
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (negative and "-" or "") .. out
end

local function trim(str: string): string
	-- "12.50" -> "12.5", "3.00" -> "3"
	if string.find(str, "%.") then
		str = string.gsub(str, "0+$", "")
		str = string.gsub(str, "%.$", "")
	end
	return str
end

-- 999 -> "999", 1234 -> "1.23K", 25290 -> "25.29K", 1.5e6 -> "1.5M"
function Format.Short(n: number): string
	if n ~= n then
		return "0"
	end
	if n == math.huge then
		return "inf"
	end
	local abs = math.abs(n)
	if abs < 1000 then
		if abs == math.floor(abs) then
			return tostring(math.floor(n))
		end
		return trim(string.format("%.1f", n))
	end
	local tier = math.floor(math.log10(abs) / 3)
	if tier > #SUFFIXES then
		return string.format("%.2e", n)
	end
	local v = n / 10 ^ (tier * 3)
	local str
	if math.abs(v) >= 100 then
		str = string.format("%.0f", math.floor(v))
	elseif math.abs(v) >= 10 then
		str = trim(string.format("%.2f", math.floor(v * 100) / 100))
	else
		str = trim(string.format("%.2f", math.floor(v * 100) / 100))
	end
	return str .. SUFFIXES[tier]
end

-- Distance in meters for the flight counter: "144 m", "12.4K m"
function Format.Meters(m: number): string
	if m < 1000 then
		return string.format("%d m", math.floor(m))
	end
	return Format.Short(m) .. " m"
end

-- seconds -> "13d 1h", "1h 16m", "4m 05s", "12s"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local d = seconds // 86400
	local h = (seconds % 86400) // 3600
	local m = (seconds % 3600) // 60
	local sec = seconds % 60
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, sec)
	end
	return string.format("%ds", sec)
end

-- "05:12" style countdown
function Format.Clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

function Format.Multiplier(m: number): string
	return "x" .. Format.Short(math.floor(m * 100 + 0.5) / 100)
end

function Format.Percent(p: number): string
	return string.format("%d%%", math.floor(p + 0.5))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
-- Maid: collects connections, instances, threads and cleanup callbacks and releases them together.
export type Task = RBXScriptConnection | Instance | thread | () -> () | { Destroy: (any) -> () }

local Maid = {}
Maid.__index = Maid

export type Maid = typeof(setmetatable({} :: { _tasks: { [any]: Task? } }, Maid))

function Maid.new(): Maid
	return setmetatable({ _tasks = {} :: { [any]: Task? } }, Maid)
end

local function cleanup(task: any)
	local kind = typeof(task)
	if kind == "RBXScriptConnection" then
		task:Disconnect()
	elseif kind == "Instance" then
		task:Destroy()
	elseif kind == "thread" then
		if coroutine.status(task) ~= "dead" then
			pcall(task.cancel, task)
		end
	elseif kind == "function" then
		task()
	elseif kind == "table" and type(task.Destroy) == "function" then
		task:Destroy()
	end
end

function Maid.Give<T>(self: Maid, task: T): T
	table.insert(self._tasks, task :: any)
	return task
end

function Maid.Set(self: Maid, key: string, task: Task?)
	local old = self._tasks[key]
	if old ~= nil and old ~= task then
		self._tasks[key] = nil
		cleanup(old)
	end
	self._tasks[key] = task
end

function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}
	for _, task in tasks do
		cleanup(task)
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic PRNG (xorshift32 with a splitmix-style seed scramble).
-- Pure Luau: identical results on server, client and the headless test runner.
local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { _state: number }, Rng))

local function scramble(seed: number): number
	local x = bit32.bxor(math.floor(seed) % 4294967296, 0x9E3779B9)
	x = bit32.bxor(x, bit32.rshift(x, 16))
	x = (x * 0x45D9F3B) % 4294967296
	x = bit32.bxor(x, bit32.rshift(x, 16))
	if x == 0 then
		x = 0x6D2B79F5
	end
	return x
end

function Rng.new(seed: number): Rng
	return setmetatable({ _state = scramble(seed) }, Rng)
end

function Rng.NextUInt(self: Rng): number
	local x = self._state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self._state = x
	return x
end

-- Uniform float in [0, 1)
function Rng.Next(self: Rng): number
	return self:NextUInt() / 4294967296
end

function Rng.Range(self: Rng, min: number, max: number): number
	return min + (max - min) * self:Next()
end

-- Uniform integer in [min, max]
function Rng.Int(self: Rng, min: number, max: number): number
	return min + math.floor(self:Next() * (max - min + 1))
end

function Rng.Chance(self: Rng, p: number): boolean
	return self:Next() < p
end

function Rng.Pick<T>(self: Rng, list: { T }): T
	return list[self:Int(1, #list)]
end

-- Weighted pick over { {value, weight} } style list via accessor.
function Rng.Weighted<T>(self: Rng, items: { T }, weightOf: (T) -> number): T?
	local total = 0
	for _, item in items do
		total += math.max(0, weightOf(item))
	end
	if total <= 0 then
		return nil
	end
	local roll = self:Next() * total
	for _, item in items do
		roll -= math.max(0, weightOf(item))
		if roll < 0 then
			return item
		end
	end
	return items[#items]
end

function Rng.Shuffle<T>(self: Rng, list: { T }): { T }
	for i = #list, 2, -1 do
		local j = self:Int(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Lightweight synchronous signal (no Roblox instances; usable in headless tests).
export type Connection = { Connected: boolean, Disconnect: (Connection) -> () }

local Signal = {}
Signal.__index = Signal

type Listener = { fn: (...any) -> (), conn: Connection }

export type Signal = typeof(setmetatable({} :: { _listeners: { Listener } }, Signal))

function Signal.new(): Signal
	return setmetatable({ _listeners = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	local listeners = self._listeners
	local conn: Connection
	conn = {
		Connected = true,
		Disconnect = function(c: Connection)
			if not c.Connected then
				return
			end
			c.Connected = false
			for i, l in listeners do
				if l.conn == c then
					table.remove(listeners, i)
					break
				end
			end
		end,
	}
	table.insert(listeners, { fn = fn, conn = conn })
	return conn
end

function Signal.Once(self: Signal, fn: (...any) -> ()): Connection
	local conn: Connection
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal.Fire(self: Signal, ...: any)
	-- Snapshot so listeners may disconnect while firing.
	local snapshot = table.clone(self._listeners)
	for _, l in snapshot do
		if l.conn.Connected then
			l.fn(...)
		end
	end
end

function Signal.DisconnectAll(self: Signal)
	for _, l in self._listeners do
		l.conn.Connected = false
	end
	table.clear(self._listeners)
end

Signal.Destroy = Signal.DisconnectAll

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime validators for untrusted remote arguments. Every server remote handler uses these.
local Validate = {}

function Validate.String(v: any, maxLen: number?): boolean
	return type(v) == "string" and #v <= (maxLen or 64) and utf8.len(v) ~= nil
end

function Validate.Id(v: any): boolean
	-- identifiers are short lowercase/uppercase alnum strings
	return type(v) == "string" and #v >= 1 and #v <= 40 and string.match(v, "^[%w_%-]+$") ~= nil
end

function Validate.Number(v: any, min: number?, max: number?): boolean
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return false
	end
	if min and v < min then
		return false
	end
	if max and v > max then
		return false
	end
	return true
end

function Validate.Integer(v: any, min: number?, max: number?): boolean
	return Validate.Number(v, min, max) and math.floor(v) == v
end

function Validate.OneOf(v: any, options: { string }): boolean
	if type(v) ~= "string" then
		return false
	end
	return table.find(options, v) ~= nil
end

function Validate.Boolean(v: any): boolean
	return type(v) == "boolean"
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="39">
        <Properties>
          <string name="Name">Visual</string>
        </Properties>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">EggFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Part-built eggs (no meshes, no uploaded assets) for the egg row, hatch animations and shop cards.
--
-- Contract: anchored Model, PrimaryPart = "Root" (invisible) at the egg's centre, +Y up, overall
-- height = `height` studs and width about 0.76 x height. Ball parts are always round in Roblox, so
-- the egg silhouette is a stack of six balls fitted to an egg profile (wider below the middle);
-- decorations sit on the analytic profile. Each egg gets a deterministic pattern of egg.Accent
-- (spots, bands, or a band with dots); Robux eggs (egg.ProductKey) add a Neon rim, floating Neon
-- sparkles, a PointLight and sparkle particles.
local Eggs = require(script.Parent.Parent.Definitions.Eggs)
local Kit = require(script.Parent.FactoryKit)

local EggFactory = {}

-- (centre y, radius) per ball in units of the egg height; fitted offline to PROFILE below.
local STACK = {
	{ -0.128, 0.371 },
	{ -0.048, 0.378 },
	{ 0.051, 0.354 },
	{ 0.151, 0.309 },
	{ 0.249, 0.245 },
	{ 0.409, 0.091 },
}

EggFactory.WidthRatio = 0.76

-- Egg radius at height y (units, -0.5..0.5): an ellipse squeezed toward the top.
local function profile(y: number): number
	local t = math.clamp(y / 0.5, -1, 1)
	return 0.375 * math.sqrt(1 - t * t) * (1 - 0.16 * t)
end

-- Point on the egg surface and its outward normal, for height y and angle a (a = 0 faces -Z).
local function surface(y: number, a: number): (Vector3, Vector3)
	local r = profile(y)
	local slope = (profile(y + 0.005) - profile(y - 0.005)) / 0.01
	local radial = Vector3.new(math.sin(a), 0, -math.cos(a))
	local normal = (radial - Vector3.yAxis * slope).Unit
	return radial * r + Vector3.yAxis * y, normal
end

type Ctx = { b: Kit.Builder, H: number, Accent: Color3, Mat: Enum.Material }

local function spot(c: Ctx, y: number, a: number, diameter: number)
	local p, n = surface(y, a)
	local thick = 0.035
	Kit.Disc(c.b, (p - n * (thick / 2 - 0.006)) * c.H, n, diameter * c.H, thick * c.H, c.Accent, c.Mat)
end

local function band(c: Ctx, y: number, thick: number, color: Color3, material: Enum.Material?)
	local r = math.max(profile(y - thick / 2), profile(y + thick / 2)) + 0.004
	Kit.Disc(c.b, Vector3.new(0, y, 0) * c.H, Vector3.yAxis, r * 2 * c.H, thick * c.H, color, material)
end

-- Golden-angle spiral of spots between two heights.
local function spots(c: Ctx, count: number, y0: number, y1: number, offset: number, diameter: number)
	for i = 0, count - 1 do
		local y = y0 + (y1 - y0) * (i + 0.5) / count
		spot(c, y, offset + i * 2.39996, diameter * (profile(y) / 0.375) ^ 0.5)
	end
end

function EggFactory.Build(egg: Eggs.Egg, height: number): Model
	local H = math.max(0.2, height)
	local b = Kit.New("Egg_" .. egg.Id, H * 0.1)
	local robux = egg.ProductKey ~= nil
	local base = Kit.Color(egg.Color, Color3.fromRGB(255, 240, 210))
	local c: Ctx = {
		b = b,
		H = H,
		Accent = Kit.Color(egg.Accent, Color3.fromRGB(80, 170, 255)),
		Mat = if robux then Enum.Material.Neon else Enum.Material.SmoothPlastic,
	}
	for _, ball in STACK do
		Kit.Ball(b, ball[2] * 2 * H, Vector3.new(0, ball[1] * H, 0), base)
	end
	local hash = Kit.Hash(egg.Id)
	local offset = (hash % 628) / 100
	local pattern = hash % 3
	if robux then
		spots(c, 7, -0.34, 0.36, offset, 0.15)
		band(c, -0.05, 0.06, c.Accent, Enum.Material.Neon)
		for i = 0, 3 do
			local a = offset + i * math.pi / 2 + math.pi / 4
			local y = if i % 2 == 0 then 0.32 else -0.2
			local p, n = surface(y, a)
			Kit.Diamond(b, (p + n * 0.11) * H, n, 0.07 * H, 0.02 * H, Kit.Shade(c.Accent, 0.35), Enum.Material.Neon)
		end
		Kit.Light(b, c.Accent, 1.5, H * 2.5)
		Kit.Sparkles(b, Kit.Shade(c.Accent, 0.4), 4, H * 0.12)
	elseif pattern == 0 then
		spots(c, 8, -0.36, 0.36, offset, 0.17)
	elseif pattern == 1 then
		band(c, 0.1, 0.05, c.Accent)
		band(c, -0.05, 0.035, Kit.Shade(c.Accent, 0.25))
		band(c, -0.2, 0.05, c.Accent)
	else
		band(c, -0.05, 0.08, c.Accent)
		for i = 0, 3 do
			spot(c, 0.2, offset + i * math.pi / 2, 0.14)
			spot(c, -0.3, offset + (i + 0.5) * math.pi / 2, 0.13)
		end
	end
	b.Model:SetAttribute("EggId", egg.Id)
	return Kit.Finish(b, true)
end

local cache = Kit.NewCache(32)

-- Built once per (id, height) and cloned afterwards. Unknown ids get the first egg's look.
function EggFactory.ForId(eggId: string, height: number): Model
	local key = string.format("%s|%.2f", eggId, height)
	local model = Kit.Cached(cache, key, function()
		local egg = Eggs.Get(eggId) or Eggs.List[1]
		return EggFactory.Build(egg, height)
	end)
	model.Name = eggId
	return model
end

-- Builds every egg once, destroys them, returns true.
-- Studio command bar: require(game.ReplicatedStorage.Shared.Visual.EggFactory).Validate()
function EggFactory.Validate(): boolean
	for _, egg in Eggs.List do
		local model = EggFactory.Build(egg, 5)
		assert(model.PrimaryPart and model.PrimaryPart.Name == "Root", "egg without Root")
		assert(Kit.PartCount(model) >= #STACK, "egg " .. egg.Id .. " has too few parts")
		model:Destroy()
	end
	EggFactory.ForId("no_such_egg", 3):Destroy()
	return true
end

return EggFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">FactoryKit</string>
            <string name="Source"><![CDATA[--!strict
-- Shared part-building kit for the Visual factories (GliderFactory, PetFactory, EggFactory).
-- Every model is built around an invisible "Root" part at the model origin. Parts get display-only
-- physics flags (no collision, queries, touches or shadows; massless; smooth surfaces) and
-- Finish() either anchors every part or welds every part to Root. Triangles are built from one or
-- two WedgeParts, so shapes need no meshes and no uploaded assets. Pure Instance code: server + client.
-- Cached() keeps one template per key and hands out clones, so repeated builds stay cheap.
local FactoryKit = {}

export type Builder = {
	Model: Model,
	Root: Part,
	Parts: { BasePart },
}

export type Kind = "Block" | "Ball" | "Cylinder" | "Wedge"

FactoryKit.Sides = { -1, 1 }

local DEFAULT_MATERIAL = Enum.Material.SmoothPlastic
local MIN_SIZE = 0.01 -- smallest part dimension we create (Roblox clamps at 0.001)
local DEGENERATE = 0.004 -- a triangle half thinner than this is skipped

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- "#RRGGBB" -> Color3, falling back when the string is missing or malformed.
function FactoryKit.Color(hex: string?, fallback: Color3): Color3
	if type(hex) ~= "string" then
		return fallback
	end
	local ok, color = pcall(Color3.fromHex, hex)
	if ok then
		return color
	end
	return fallback
end

-- amount > 0 blends toward white, amount < 0 toward black.
function FactoryKit.Shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(WHITE, math.min(amount, 1))
	end
	return color:Lerp(BLACK, math.min(-amount, 1))
end

-- Stable small hash for deterministic per-definition variation (spot layouts etc.).
function FactoryKit.Hash(text: string): number
	local h = 5381
	for i = 1, #text do
		h = (h * 33 + string.byte(text, i)) % 2147483647
	end
	return h
end

local function applyFlags(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

function FactoryKit.New(name: string, rootSize: number): Builder
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one * math.max(0.05, rootSize)
	root.CFrame = CFrame.identity
	root.Transparency = 1
	applyFlags(root)
	root.Parent = model
	model.PrimaryPart = root
	return { Model = model, Root = root, Parts = { root } }
end

function FactoryKit.Part(b: Builder, kind: Kind, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local part: BasePart
	if kind == "Wedge" then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if kind == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif kind == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
		part = p
	end
	part.Name = kind
	part.Size = Vector3.new(math.max(size.X, MIN_SIZE), math.max(size.Y, MIN_SIZE), math.max(size.Z, MIN_SIZE))
	part.CFrame = cf
	part.Color = color
	part.Material = material or DEFAULT_MATERIAL
	applyFlags(part)
	part.Parent = b.Model
	table.insert(b.Parts, part)
	return part
end

function FactoryKit.Block(b: Builder, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	return FactoryKit.Part(b, "Block", size, cf, color, material)
end

function FactoryKit.Ball(b: Builder, diameter: number, position: Vector3, color: Color3, material: Enum.Material?): BasePart
	return FactoryKit.Part(b, "Ball", Vector3.one * diameter, CFrame.new(position), color, material)
end

-- CFrame at the midpoint of from -> to, looking at `to` (safe when the segment is vertical).
local function along(from: Vector3, to: Vector3, up: Vector3?): CFrame
	local mid = (from + to) / 2
	local dir = to - from
	if dir.Magnitude < 1e-6 then
		return CFrame.new(mid)
	end
	local u = up or Vector3.yAxis
	if math.abs(dir.Unit:Dot(u.Unit)) > 0.995 then
		u = if math.abs(dir.Unit.X) < 0.9 then Vector3.xAxis else Vector3.zAxis
	end
	return CFrame.lookAt(mid, to, u)
end
FactoryKit.Along = along

-- Cylinder from one point to another.
function FactoryKit.Rod(b: Builder, from: Vector3, to: Vector3, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local length = (to - from).Magnitude
	return FactoryKit.Part(b, "Cylinder", Vector3.new(length, diameter, diameter), along(from, to) * CFrame.Angles(0, math.pi / 2, 0), color, material)
end

-- Flat bar from one point to another; `up` orients the bar's thickness (height) axis.
function FactoryKit.Bar(b: Builder, from: Vector3, to: Vector3, width: number, height: number, color: Color3, material: Enum.Material?, up: Vector3?): BasePart
	local length = (to - from).Magnitude
	return FactoryKit.Part(b, "Block", Vector3.new(width, height, length), along(from, to, up), color, material)
end

-- Flat disc (cylinder) centred on `center` with its faces pointing along `axis`.
function FactoryKit.Disc(b: Builder, center: Vector3, axis: Vector3, diameter: number, thickness: number, color: Color3, material: Enum.Material?): BasePart
	return FactoryKit.Part(b, "Cylinder", Vector3.new(thickness, diameter, diameter), along(center - axis, center + axis) * CFrame.Angles(0, math.pi / 2, 0), color, material)
end

-- Solid triangle p1-p2-p3 with the given thickness (centred on the triangle's plane), built from
-- up to two WedgePart halves split at the foot of the altitude onto a base edge. A base edge whose
-- foot lands on one of its ends (a right angle) is preferred, so right triangles cost one wedge;
-- otherwise the longest edge is used (its foot always lies inside it).
local triVerts: { Vector3 } = table.create(3)
function FactoryKit.Tri(b: Builder, p1: Vector3, p2: Vector3, p3: Vector3, thickness: number, color: Color3, material: Enum.Material?)
	triVerts[1], triVerts[2], triVerts[3] = p1, p2, p3
	local bestI, bestT, bestLen = 0, 0, -1
	for i = 1, 3 do
		local a, c, d = triVerts[i], triVerts[i % 3 + 1], triVerts[(i + 1) % 3 + 1]
		local cd = d - c
		local len2 = cd:Dot(cd)
		if len2 > 1e-10 then
			local t = (a - c):Dot(cd) / len2
			if math.abs(t) < 1e-3 or math.abs(t - 1) < 1e-3 then
				bestI, bestT = i, math.clamp(math.floor(t + 0.5), 0, 1)
				break
			elseif len2 > bestLen then
				bestI, bestT, bestLen = i, t, len2
			end
		end
	end
	if bestI == 0 then
		return
	end
	local a, c, d = triVerts[bestI], triVerts[bestI % 3 + 1], triVerts[(bestI + 1) % 3 + 1]
	local cd = d - c
	local back = cd.Unit
	local foot = c + cd * bestT
	local rise = a - foot
	rise -= back * rise:Dot(back) -- exact right angle even when the foot was snapped to an end
	local height = rise.Magnitude
	if height < DEGENERATE then
		return
	end
	local up = rise / height
	local d1 = cd.Magnitude * bestT
	local d2 = cd.Magnitude - d1
	if d1 > DEGENERATE then
		-- c is the low front corner, foot the right angle, a the high back corner
		FactoryKit.Part(b, "Wedge", Vector3.new(thickness, height, d1), CFrame.fromMatrix((a + c) / 2, up:Cross(back), up, back), color, material)
	end
	if d2 > DEGENERATE then
		FactoryKit.Part(b, "Wedge", Vector3.new(thickness, height, d2), CFrame.fromMatrix((a + d) / 2, up:Cross(-back), up, -back), color, material)
	end
end

-- Pointed "cone" from two crossed triangles (horns, beaks, spikes); reads as round from most angles.
function FactoryKit.Spike(b: Builder, base: Vector3, tip: Vector3, radius: number, color: Color3, material: Enum.Material?)
	local dir = tip - base
	if dir.Magnitude < 1e-6 then
		return
	end
	local axis = dir.Unit
	local ref = if math.abs(axis.Y) < 0.95 then Vector3.yAxis else Vector3.xAxis
	local a1 = axis:Cross(ref).Unit
	local a2 = axis:Cross(a1).Unit
	local t = radius * 0.5
	FactoryKit.Tri(b, base - a1 * radius, base + a1 * radius, tip, t, color, material)
	FactoryKit.Tri(b, base - a2 * radius, base + a2 * radius, tip, t, color, material)
end

-- Convex polygon (points in order) as a triangle fan from the first point.
function FactoryKit.Poly(b: Builder, points: { Vector3 }, thickness: number, color: Color3, material: Enum.Material?)
	for i = 2, #points - 1 do
		FactoryKit.Tri(b, points[1], points[i], points[i + 1], thickness, color, material)
	end
end

-- Flat square turned 45 degrees ("diamond") lying in the plane whose normal is `normal`.
function FactoryKit.Diamond(b: Builder, center: Vector3, normal: Vector3, width: number, thickness: number, color: Color3, material: Enum.Material?): BasePart
	local cf = along(center - normal, center + normal) * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, math.pi / 4, 0)
	return FactoryKit.Part(b, "Block", Vector3.new(width, thickness, width), cf, color, material)
end

-- Glowing accents use Neon; everything else stays smooth plastic.
function FactoryKit.Mat(glow: boolean?): Enum.Material
	return if glow then Enum.Material.Neon else DEFAULT_MATERIAL
end

function FactoryKit.Light(b: Builder, color: Color3, brightness: number, range: number): PointLight
	local light = Instance.new("PointLight")
	light.Name = "Glow"
	light.Color = color
	light.Brightness = brightness
	light.Range = math.clamp(range, 2, 60)
	light.Shadows = false
	light.Parent = b.Root
	return light
end

-- Gentle sparkle particles around Root (built-in texture, no uploads). Viewports ignore them.
function FactoryKit.Sparkles(b: Builder, color: Color3, rate: number, size: number): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparkles"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.6, 1.1)
	emitter.Speed = NumberRange.new(0.2, 0.8)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(0.1, 1)
	emitter.Parent = b.Root
	return emitter
end

-- Number of visible parts (Root excluded); used by the Validate() helpers.
function FactoryKit.PartCount(model: Model): number
	local n = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			n += 1
		end
	end
	return n
end

-- Anchor everything, or leave everything unanchored and welded to Root.
function FactoryKit.Finish(b: Builder, anchored: boolean): Model
	for _, part in b.Parts do
		part.Anchored = anchored
		if not anchored and part ~= b.Root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = b.Root
			weld.Part1 = part
			weld.Parent = part
		end
	end
	return b.Model
end

-- Prepares a model that moves every frame (pet followers, spinning displays, flying gliders): only
-- the primary part stays anchored and every other part is welded to it, so a move is one CFrame
-- write on the root instead of one per part. Returns the root and the CFrame that turns a target
-- pivot into the root's CFrame (root.CFrame = pivot * offset).
function FactoryKit.Rig(model: Model): (BasePart?, CFrame)
	local root = model.PrimaryPart
	if root == nil then
		return nil, CFrame.identity
	end
	root.Anchored = true
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return root, root.PivotOffset:Inverse()
end

-- Template cache: build once per key, hand out clones (cheap) afterwards. Bounded so callers
-- that pass many distinct sizes can't grow it forever.
export type Cache = { Map: { [string]: Model }, Count: number, Limit: number }

function FactoryKit.NewCache(limit: number): Cache
	return { Map = {}, Count = 0, Limit = limit }
end

function FactoryKit.Cached(cache: Cache, key: string, build: () -> Model): Model
	local template = cache.Map[key]
	if not template then
		if cache.Count >= cache.Limit then
			for _, model in cache.Map do
				model:Destroy()
			end
			table.clear(cache.Map)
			cache.Count = 0
		end
		template = build()
		cache.Map[key] = template
		cache.Count += 1
	end
	return template:Clone()
end

return FactoryKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">GliderFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Part-built gliders (no meshes, no uploaded assets). Shared: the server builds pedestal displays and
-- the held glider, the client builds flight models and ViewportFrame previews.
--
-- Contract: Model.PrimaryPart = "Root" (invisible) at the glider's centre. The nose points along
-- Root's LookVector (local -Z), wings span local X, +Y is up, nose-to-tail is about `length` studs.
-- anchored = true -> every part anchored (move with PivotTo); false -> nothing anchored, every part
-- welded to Root (held in a hand). Glow = true adds Neon accents and a soft PointLight.
-- Shapes are authored in units of `length` with the nose at z = -0.5 and the tail at z = +0.5.
local Gliders = require(script.Parent.Parent.Definitions.Gliders)
local Relics = require(script.Parent.Parent.Definitions.Relics)
local Kit = require(script.Parent.FactoryKit)

local GliderFactory = {}

export type Visual = { Shape: string, Primary: string, Secondary: string, Glow: boolean? }

type Ctx = {
	b: Kit.Builder,
	L: number, -- length in studs
	T: number, -- paper thickness in studs
	P: Color3, -- primary
	S: Color3, -- secondary
	Glow: boolean,
	Accent: Enum.Material, -- Neon when glowing
}

local Sides = Kit.Sides
local WOOD = Color3.fromRGB(112, 80, 50)

-- Point in glider units -> studs.
local function at(c: Ctx, x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z) * c.L
end

local function tri(c: Ctx, p1: Vector3, p2: Vector3, p3: Vector3, color: Color3, material: Enum.Material?, thick: number?)
	Kit.Tri(c.b, p1, p2, p3, (thick or 1) * c.T, color, material)
end

local function bar(c: Ctx, from: Vector3, to: Vector3, width: number, color: Color3, material: Enum.Material?)
	Kit.Bar(c.b, from, to, width * c.L, c.T * 1.3, color, material)
end

-- Classic paper plane: two swept wings folded off a keel, turned-up winglets, centre crease.
local function dart(c: Ctx)
	local P, S = c.P, c.S
	for _, s in Sides do
		local tip = at(c, 0.4 * s, 0.07, 0.5)
		tri(c, at(c, 0, 0, -0.5), at(c, 0, 0, 0.5), tip, P) -- right angle at the tail root: one wedge
		tri(c, at(c, 0.3 * s, 0.07, 0.25), tip, at(c, 0.4 * s, 0.18, 0.5), S, c.Accent) -- winglet
		-- stripe across the wing, parallel to the trailing edge
		local y1, y2 = 0.07 * 0.05 / 0.4, 0.07 * 0.31 / 0.4
		bar(c, at(c, 0.05 * s, y1, 0.36) + Vector3.yAxis * c.T * 0.35, at(c, 0.31 * s, y2, 0.36) + Vector3.yAxis * c.T * 0.35, 0.05, S)
		if c.Glow then
			bar(c, at(c, 0.02 * s, 0, 0.495), at(c, 0.4 * s, 0.07, 0.495), 0.02, S, c.Accent)
		end
	end
	tri(c, at(c, 0, 0, -0.4), at(c, 0, 0, 0.5), at(c, 0, -0.13, 0.5), Kit.Shade(P, -0.12), nil, 1.2) -- keel
	bar(c, at(c, 0, 0, -0.46) + Vector3.yAxis * c.T * 0.4, at(c, 0, 0, 0.5) + Vector3.yAxis * c.T * 0.4, 0.018, S)
end

-- Broad paper glider: blunt nose, wide straight wings with folded leading edges and tip fins.
local function wide(c: Ctx)
	local P, S = c.P, c.S
	local slope = 0.16 -- dihedral rise per unit of span
	local dih = math.atan(slope)
	local root, tipX = 0.1, 0.66
	local function lift(x: number): number
		return (math.abs(x) - root) * slope
	end
	Kit.Block(c.b, Vector3.new(root * 2 * c.L, c.T * 1.2, 0.8 * c.L), CFrame.new(at(c, 0, 0, 0.1)), P)
	for _, s in Sides do
		-- nose cap (right triangle) and the swept leading-edge triangle of the wing
		tri(c, at(c, 0, 0, -0.5), at(c, 0, 0, -0.3), at(c, root * s, 0, -0.3), P, nil, 1.2)
		tri(c, at(c, root * s, 0, -0.3), at(c, root * s, 0, -0.04), at(c, tipX * s, lift(tipX), -0.04), P)
		-- wing panel behind it
		local cx = (root + tipX) / 2
		local cf = CFrame.new(at(c, cx * s, lift(cx), 0.2)) * CFrame.Angles(0, 0, dih * s)
		Kit.Block(c.b, Vector3.new((tipX - root) / math.cos(dih) * c.L, c.T, 0.48 * c.L), cf, P)
		-- folded leading edge and turned-up tip fin
		bar(c, at(c, root * s, 0, -0.3) + Vector3.yAxis * c.T * 0.4, at(c, tipX * s, lift(tipX), -0.04) + Vector3.yAxis * c.T * 0.4, 0.05, S, c.Accent)
		local fin = CFrame.new(at(c, tipX * s, lift(tipX) + 0.04, 0.2))
		Kit.Block(c.b, Vector3.new(c.T, 0.08 * c.L, 0.44 * c.L), fin, S, c.Accent)
	end
	Kit.Block(c.b, Vector3.new(root * 2 * c.L, c.T * 2.2, 0.1 * c.L), CFrame.new(at(c, 0, 0, -0.25)), S) -- nose fold
	tri(c, at(c, 0, 0, -0.25), at(c, 0, 0, 0.5), at(c, 0, -0.11, 0.5), Kit.Shade(P, -0.12), nil, 1.2) -- keel
end

-- Leaf: two halves folded up along a midrib, rounded front edge, stem at the tail.
local function leaf(c: Ctx)
	local P, S = c.P, c.S
	local function y(x: number): number
		return math.abs(x) * 0.22
	end
	local tip, mid, base = at(c, 0, 0, -0.5), at(c, 0, 0, -0.04), at(c, 0, 0, 0.3)
	for _, s in Sides do
		local color = if s > 0 then P else Kit.Shade(P, -0.08)
		local w = at(c, 0.26 * s, y(0.26), -0.04)
		tri(c, tip, w, mid, color)
		tri(c, mid, w, base, color)
		tri(c, tip, at(c, 0.19 * s, y(0.19), -0.3), w, color) -- rounds the front edge
		tri(c, w, at(c, 0.2 * s, y(0.2), 0.17), base, color) -- and the back edge
		-- side vein
		bar(c, at(c, 0, 0, -0.1) + Vector3.yAxis * c.T * 0.4, at(c, 0.19 * s, y(0.19), -0.24) + Vector3.yAxis * c.T * 0.4, 0.016, S, c.Accent)
	end
	bar(c, tip + Vector3.yAxis * c.T * 0.4, base + Vector3.yAxis * c.T * 0.4, 0.024, S, c.Accent) -- midrib
	Kit.Rod(c.b, base, at(c, 0, 0.04, 0.5), 0.035 * c.L, S) -- stem
end

-- Feather: asymmetric vanes on a quill, coloured tip, soft down at the base.
local function feather(c: Ctx)
	local P, S = c.P, c.S
	local function y(x: number): number
		return -math.abs(x) * 0.14 -- vanes droop a little (cambered)
	end
	local tip, base = at(c, 0, 0, -0.5), at(c, 0, 0, 0.28)
	local spec = { { s = 1, w = 0.13, wz = -0.12, a = 0.1, az = -0.36 }, { s = -1, w = 0.19, wz = -0.06, a = 0.13, az = -0.33 } }
	for _, v in spec do
		local s = v.s
		local w = at(c, v.w * s, y(v.w), v.wz)
		local m = at(c, 0, 0, v.wz)
		tri(c, tip, w, m, P)
		tri(c, m, w, base, P)
		tri(c, tip, at(c, v.a * s, y(v.a), v.az), w, S) -- coloured tip
		tri(c, at(c, 0, 0, 0.2), at(c, 0, 0, 0.36), at(c, 0.08 * s, -0.01, 0.36), Kit.Shade(P, 0.3)) -- down
	end
	Kit.Rod(c.b, tip + Vector3.yAxis * c.T * 0.5, base + Vector3.yAxis * c.T * 0.5, 0.026 * c.L, Kit.Shade(S, -0.15), c.Accent)
	Kit.Rod(c.b, base, at(c, 0, 0.01, 0.5), 0.04 * c.L, Kit.Shade(S, 0.45))
end

-- Diamond kite: four checkered panels, cross spars, string tail with bows.
local function kite(c: Ctx)
	local P, S = c.P, c.S
	local nose, cross, tail = at(c, 0, 0, -0.5), at(c, 0, 0, -0.22), at(c, 0, 0, 0.2)
	for _, s in Sides do
		local side = at(c, 0.3 * s, 0.04, -0.22)
		tri(c, nose, side, cross, if s > 0 then P else S, Enum.Material.Fabric)
		tri(c, cross, side, tail, if s > 0 then S else P, Enum.Material.Fabric)
	end
	local up = Vector3.yAxis * c.T * 1.2
	Kit.Rod(c.b, nose + up, tail + up, 0.024 * c.L, WOOD)
	Kit.Rod(c.b, at(c, -0.3, 0.04, -0.22) + up, at(c, 0.3, 0.04, -0.22) + up, 0.024 * c.L, WOOD)
	local stringEnd = at(c, 0, -0.04, 0.5)
	Kit.Rod(c.b, tail, stringEnd, 0.012 * c.L, Kit.Shade(S, 0.4))
	for i = 1, 3 do
		local t = (i - 0.4) / 3
		local p = tail:Lerp(stringEnd, t)
		Kit.Diamond(c.b, p, Vector3.yAxis, 0.075 * c.L, c.T * 1.2, if i % 2 == 1 then S else P, c.Accent)
	end
end

-- Origami crane: keel body, raised wings with folded flaps, long neck with a bent head, tail.
local function crane(c: Ctx)
	local P, S = c.P, c.S
	local slope = 0.29
	for _, s in Sides do
		local rf, rb, tp = at(c, 0.02 * s, 0.02, -0.14), at(c, 0.02 * s, 0.02, 0.16), at(c, 0.5 * s, 0.02 + 0.48 * slope, 0.06)
		tri(c, rf, rb, tp, P)
		local up = Vector3.yAxis * c.T * 0.9
		tri(c, at(c, 0.02 * s, 0.02, -0.11) + up, at(c, 0.02 * s, 0.02, 0.16) + up, at(c, 0.2 * s, 0.02 + 0.18 * slope, 0.16) + up, S, c.Accent)
	end
	local dark = Kit.Shade(P, -0.1)
	tri(c, at(c, 0, 0.02, -0.18), at(c, 0, 0.02, 0.2), at(c, 0, -0.12, 0.02), dark, nil, 1.4) -- body
	tri(c, at(c, 0, -0.06, -0.06), at(c, 0, 0.03, -0.22), at(c, 0, 0.23, -0.42), P, nil, 1.6) -- neck
	tri(c, at(c, 0, 0.24, -0.43), at(c, 0, 0.17, -0.4), at(c, 0, 0.11, -0.5), S, c.Accent, 1.6) -- head
	tri(c, at(c, 0, -0.06, 0.06), at(c, 0, 0.03, 0.22), at(c, 0, 0.21, 0.5), P, nil, 1.6) -- tail
end

-- Paper fighter jet: needle fuselage, delta wings, canards, canted twin fins, canopy.
local function jet(c: Ctx)
	local P, S = c.P, c.S
	for _, s in Sides do
		tri(c, at(c, 0, 0, -0.5), at(c, 0.065 * s, 0, 0.5), at(c, 0, 0, 0.5), P, nil, 1.3)
		tri(c, at(c, 0.06 * s, 0, -0.12), at(c, 0.06 * s, 0, 0.42), at(c, 0.4 * s, -0.03, 0.42), P)
		tri(c, at(c, 0.06 * s, 0, -0.34), at(c, 0.06 * s, 0, -0.22), at(c, 0.17 * s, 0, -0.22), S)
		tri(c, at(c, 0.07 * s, 0, 0.24), at(c, 0.07 * s, 0, 0.5), at(c, 0.11 * s, 0.17, 0.5), S)
		bar(c, at(c, 0.06 * s, 0, -0.12) + Vector3.yAxis * c.T * 0.4, at(c, 0.4 * s, -0.03, 0.42) + Vector3.yAxis * c.T * 0.4, 0.022, S, c.Accent)
	end
	tri(c, at(c, 0, 0, -0.35), at(c, 0, 0, 0.45), at(c, 0, -0.07, 0.45), Kit.Shade(P, -0.12), nil, 1.2) -- keel
	local canopy = Vector3.new(0.06, 0.05, 0.16) * c.L
	Kit.Part(c.b, "Wedge", canopy, CFrame.new(at(c, 0, 0, -0.24) + Vector3.yAxis * (canopy.Y / 2 + c.T * 0.5)), Kit.Shade(S, -0.1), c.Accent)
	if c.Glow then
		Kit.Block(c.b, Vector3.new(0.1, 0.035, 0.02) * c.L, CFrame.new(at(c, 0, 0, 0.5)), S, Enum.Material.Neon)
	end
end

-- Bat/dragon wings: membranes fanned from the wrist with a scalloped trailing edge, finger bones on
-- top, a slim body with a round head and a spade-tipped tail.
local function bat(c: Ctx)
	local P, S = c.P, c.S
	local bone = if c.Glow then S else Kit.Shade(P, -0.35)
	local up = Vector3.yAxis * c.T
	for _, s in Sides do
		local shoulder, wrist = at(c, 0.04 * s, 0.02, -0.2), at(c, 0.27 * s, 0.13, -0.2)
		local tip1, notch1 = at(c, 0.62 * s, 0.05, -0.04), at(c, 0.42 * s, 0.07, 0.07)
		local tip2, notch2 = at(c, 0.45 * s, 0.04, 0.3), at(c, 0.24 * s, 0.05, 0.19)
		local rear = at(c, 0.04 * s, 0.02, 0.3)
		local dark = Kit.Shade(P, -0.1)
		tri(c, wrist, rear, shoulder, P) -- right angle at the shoulder: one wedge
		tri(c, wrist, tip1, notch1, P)
		tri(c, wrist, notch1, tip2, dark)
		tri(c, wrist, tip2, notch2, P)
		tri(c, wrist, notch2, rear, dark)
		Kit.Rod(c.b, shoulder + up, wrist + up, 0.034 * c.L, bone, c.Accent)
		Kit.Rod(c.b, wrist + up, tip1 + up, 0.028 * c.L, bone, c.Accent)
		Kit.Rod(c.b, wrist + up, tip2 + up, 0.022 * c.L, bone, c.Accent)
	end
	local body = Kit.Shade(P, -0.25)
	Kit.Rod(c.b, at(c, 0, 0.03, -0.36), at(c, 0, 0.03, 0.42), 0.05 * c.L, body)
	Kit.Ball(c.b, 0.1 * c.L, at(c, 0, 0.035, -0.42), body)
	Kit.Diamond(c.b, at(c, 0, 0.03, 0.45), Vector3.yAxis, 0.08 * c.L, c.T * 1.4, S, c.Accent) -- spade tail
end

-- Snowflake star: six-point core, three crossing arms with branch ticks.
local function star(c: Ctx)
	local P, S = c.P, c.S
	local r = 0.2
	for k = 0, 1 do
		local pts = {}
		for i = 0, 2 do
			local a = math.pi * (1 - k) + i * math.pi * 2 / 3 -- one triangle points -Z, the other +Z
			table.insert(pts, at(c, math.sin(a) * r, 0, math.cos(a) * r))
		end
		tri(c, pts[1], pts[2], pts[3], S, c.Accent, 1.6)
	end
	for i = 0, 2 do
		local a = i * math.pi / 3
		local dir = Vector3.new(math.sin(a), 0, -math.cos(a))
		Kit.Bar(c.b, -dir * 0.5 * c.L, dir * 0.5 * c.L, 0.055 * c.L, c.T * 1.3, P)
		for _, s in Sides do
			local mid = dir * 0.33 * s * c.L
			local across = Vector3.new(-dir.Z, 0, dir.X)
			Kit.Bar(c.b, mid - across * 0.09 * c.L, mid + across * 0.09 * c.L, 0.04 * c.L, c.T * 1.1, P)
		end
	end
end

-- Ornate golden phoenix relic: layered swept wings, flame tail, jewel core in a gold setting.
local function relic(c: Ctx)
	local P, S = c.P, c.S
	local deep = Kit.Shade(P, -0.18)
	local layers = {
		{ y = 0, f = -0.2, b = 0.06, x = 0.56, color = P },
		{ y = -0.012, f = -0.1, b = 0.16, x = 0.45, color = deep },
		{ y = -0.024, f = 0.0, b = 0.26, x = 0.32, color = S },
	}
	for _, s in Sides do
		for i, l in layers do
			local lift = 0.3 * l.x
			tri(c, at(c, 0.05 * s, l.y, l.f), at(c, 0.05 * s, l.y, l.b), at(c, l.x * s, l.y + lift, l.b), l.color, if i == 3 then c.Accent else nil)
		end
		-- side tail plume
		tri(c, at(c, 0.02 * s, -0.01, 0.18), at(c, 0.2 * s, 0.03, 0.5), at(c, 0.09 * s, -0.01, 0.2), deep)
		-- centre tail flame (right triangle per side)
		tri(c, at(c, 0, -0.005, 0.16), at(c, 0, -0.005, 0.5), at(c, 0.07 * s, -0.005, 0.16), S, c.Accent)
		-- pointed crest at the nose
		tri(c, at(c, 0, 0.01, -0.5), at(c, 0, 0.01, -0.22), at(c, 0.07 * s, 0.01, -0.22), P, nil, 1.6)
	end
	local core = at(c, 0, 0.03, -0.07)
	Kit.Disc(c.b, core - Vector3.yAxis * 0.02 * c.L, Vector3.yAxis, 0.26 * c.L, 0.05 * c.L, deep)
	Kit.Ball(c.b, 0.17 * c.L, core, S, Enum.Material.Neon)
	Kit.Sparkles(c.b, Kit.Shade(P, 0.3), 5, 0.12 * c.L)
end

local SHAPES: { [string]: (Ctx) -> () } = {
	Dart = dart,
	Wide = wide,
	Leaf = leaf,
	Feather = feather,
	Kite = kite,
	Crane = crane,
	Jet = jet,
	Bat = bat,
	Star = star,
	Relic = relic,
}
GliderFactory.Shapes = { "Dart", "Wide", "Leaf", "Feather", "Kite", "Crane", "Jet", "Bat", "Star", "Relic" }

function GliderFactory.Build(visual: Visual, length: number, anchored: boolean): Model
	local L = math.max(0.2, length)
	local shape = if SHAPES[visual.Shape] then visual.Shape else "Dart"
	local glow = visual.Glow == true
	local b = Kit.New("Glider_" .. shape, L * 0.06)
	local c: Ctx = {
		b = b,
		L = L,
		T = math.max(0.03, L * 0.022),
		P = Kit.Color(visual.Primary, Color3.fromRGB(244, 244, 244)),
		S = Kit.Color(visual.Secondary, Color3.fromRGB(201, 211, 224)),
		Glow = glow,
		Accent = Kit.Mat(glow),
	}
	SHAPES[shape](c)
	if glow then
		Kit.Light(b, c.S, 1, L * 2.5)
	end
	b.Model:SetAttribute("Shape", shape)
	return Kit.Finish(b, anchored)
end

-- Visual for a glider id or "relic:<relicId>"; unknown ids fall back to the default glider.
function GliderFactory.VisualFor(id: string): Visual
	local relicId = string.match(id, "^relic:(.+)$")
	if relicId then
		local r = Relics.Get(relicId)
		if r then
			return r.Visual
		end
	end
	local g = Gliders.Get(id) or Gliders.Get(Gliders.Default)
	if g then
		return g.Visual
	end
	return { Shape = "Dart", Primary = "#F4F4F4", Secondary = "#C9D3E0" }
end

local cache = Kit.NewCache(64)

-- Built once per (id, length, anchored) and cloned afterwards, so flights and previews are cheap.
function GliderFactory.ForId(id: string, length: number, anchored: boolean): Model
	local key = string.format("%s|%.2f|%s", id, length, tostring(anchored))
	local model = Kit.Cached(cache, key, function()
		return GliderFactory.Build(GliderFactory.VisualFor(id), length, anchored)
	end)
	model.Name = id
	return model
end

-- Builds every glider, relic and shape once (anchored and welded), destroys them, returns true.
-- Studio command bar: require(game.ReplicatedStorage.Shared.Visual.GliderFactory).Validate()
function GliderFactory.Validate(): boolean
	local visuals: { Visual } = {}
	for _, g in Gliders.List do
		table.insert(visuals, g.Visual)
	end
	for _, r in Relics.List do
		table.insert(visuals, r.Visual)
	end
	for _, shape in GliderFactory.Shapes do
		table.insert(visuals, { Shape = shape, Primary = "#FFFFFF", Secondary = "#3FA9FF", Glow = true })
	end
	table.insert(visuals, { Shape = "NoSuchShape", Primary = "bad", Secondary = "#123456" })
	for _, visual in visuals do
		for _, anchored in { true, false } do
			local model = GliderFactory.Build(visual, 4, anchored)
			assert(model.PrimaryPart and model.PrimaryPart.Name == "Root", "glider without Root")
			local count = Kit.PartCount(model)
			assert(count >= 3, "glider " .. visual.Shape .. " has too few parts")
			model:Destroy()
		end
	end
	GliderFactory.ForId("relic:aurora_relic", 3, true):Destroy()
	GliderFactory.ForId("unknown_glider", 3, false):Destroy()
	return true
end

return GliderFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PetFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Part-built pets (no meshes, no uploaded assets). Shared: the client builds followers, hatch
-- reveals and ViewportFrame cards; the server may build displays.
--
-- Contract: anchored Model, PrimaryPart = "Root" (invisible) at the body centre, the pet faces
-- Root's LookVector (local -Z), +Y is up and the overall height is about `size` studs (long ears
-- and wings add a little). Templates are authored in units of `size`, feet at y = -0.5.
-- ViewportFrame cameras that sit on +Z must yaw the model by math.pi to show the face.
local Pets = require(script.Parent.Parent.Definitions.Pets)
local Kit = require(script.Parent.FactoryKit)

local PetFactory = {}

type Ctx = {
	b: Kit.Builder,
	U: number, -- studs per unit (= size)
	Body: Color3,
	Accent: Color3,
	Glow: boolean,
	Mat: Enum.Material, -- accent material (Neon when glowing)
	V: Pets.PetVisual,
}

local Sides = Kit.Sides
local WHITE = Color3.fromRGB(255, 255, 255)
local PUPIL = Color3.fromRGB(24, 24, 32)
local NOSE = Color3.fromRGB(46, 38, 44)
local BLUSH = Color3.fromRGB(255, 140, 170)
local BEAK = Color3.fromRGB(255, 176, 32)

local DEFAULT_VISUAL: Pets.PetVisual = { Template = "Critter", Body = "#C9D3E0", Accent = "#FFFFFF", Ears = "Round" }

local function at(c: Ctx, x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z) * c.U
end

local function ball(c: Ctx, d: number, x: number, y: number, z: number, color: Color3, material: Enum.Material?): BasePart
	return Kit.Ball(c.b, d * c.U, at(c, x, y, z), color, material)
end

local function tri(c: Ctx, p1: Vector3, p2: Vector3, p3: Vector3, thick: number, color: Color3, material: Enum.Material?)
	Kit.Tri(c.b, p1, p2, p3, thick * c.U, color, material)
end

-- Rough colour distance, used to keep beaks and noses readable on similar bodies.
local function near(a: Color3, b: Color3): boolean
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.45
end

-- One cute eye: white ball, big pupil pushed forward, small highlight. `white` is the eye centre in
-- studs, `dir` the unit direction it looks, `d` the white's diameter in units.
local function eye(c: Ctx, white: Vector3, dir: Vector3, d: number, side: number)
	local rw = d * c.U / 2
	Kit.Ball(c.b, rw * 2, white, WHITE)
	local rp = rw * 0.64
	local pupil = white + dir * (rw - rp * 0.5)
	Kit.Ball(c.b, rp * 2, pupil, PUPIL)
	local glint = (dir * 0.7 + Vector3.new(-0.3 * side, 0.55, 0)).Unit
	Kit.Ball(c.b, rp * 0.62, pupil + glint * rp * 0.82, WHITE)
end

-- A pair of eyes on a sphere (centre in units, radius in units).
local function eyesOnSphere(c: Ctx, cx: number, cy: number, cz: number, radius: number, d: number, spread: number, lift: number)
	local center = at(c, cx, cy, cz)
	for _, s in Sides do
		local dir = Vector3.new(spread * s, lift, -1).Unit
		eye(c, center + dir * (radius - d * 0.18) * c.U, dir, d, s)
	end
end

-- Blush spots under the eyes.
local function cheeks(c: Ctx, cx: number, cy: number, cz: number, radius: number, spread: number, lift: number)
	local center = at(c, cx, cy, cz)
	for _, s in Sides do
		local dir = Vector3.new(spread * s, lift, -1).Unit
		local p = Kit.Ball(c.b, 0.08 * c.U, center + dir * (radius - 0.025) * c.U, BLUSH)
		p.Transparency = 0.25
	end
end

-- Two small cone horns sweeping back from (x, y, z).
local function horns(c: Ctx, x: number, y: number, z: number, len: number, color: Color3)
	for _, s in Sides do
		Kit.Spike(c.b, at(c, x * s, y, z), at(c, (x + len * 0.35) * s, y + len, z + len * 0.45), 0.05 * c.U, color, c.Mat)
	end
end

local function ears(c: Ctx, kind: string?, hx: number, hy: number, hz: number, hr: number)
	local body, accent = c.Body, c.Accent
	local top = hy + hr
	if kind == "Pointy" then
		for _, s in Sides do
			tri(c, at(c, 0.06 * s, top - 0.07, hz + 0.02), at(c, 0.27 * s, top - 0.15, hz + 0.04), at(c, 0.22 * s, top + 0.14, hz + 0.06), 0.07, body)
			tri(c, at(c, 0.11 * s, top - 0.06, hz - 0.02), at(c, 0.23 * s, top - 0.1, hz - 0.01), at(c, 0.205 * s, top + 0.08, hz + 0.02), 0.04, accent, c.Mat)
		end
	elseif kind == "Round" then
		for _, s in Sides do
			ball(c, 0.2, 0.2 * s, top - 0.04, hz + 0.04, body)
			ball(c, 0.12, 0.205 * s, top - 0.04, hz - 0.02, accent, c.Mat)
		end
	elseif kind == "Long" then
		for _, s in Sides do
			local base, tip = at(c, 0.1 * s, top - 0.06, hz + 0.04), at(c, 0.16 * s, top + 0.22, hz + 0.08)
			Kit.Rod(c.b, base, tip, 0.13 * c.U, body)
			Kit.Ball(c.b, 0.13 * c.U, tip, body)
			Kit.Bar(c.b, base + at(c, 0, 0.04, -0.06), tip + at(c, 0, -0.02, -0.055), 0.06 * c.U, 0.02 * c.U, accent, c.Mat, Vector3.zAxis)
		end
	end
end

-- Round critter: big head, belly, muzzle, ears by type, little feet, tail.
local function critter(c: Ctx)
	local V, body, accent = c.V, c.Body, c.Accent
	ball(c, 0.52, 0, -0.2, 0.04, body)
	ball(c, 0.36, 0, -0.22, -0.1, accent)
	for _, s in Sides do
		ball(c, 0.16, 0.13 * s, -0.42, -0.1, Kit.Shade(body, -0.08))
	end
	ball(c, 0.6, 0, 0.12, -0.04, body) -- head
	ball(c, 0.22, 0, 0.03, -0.3, accent) -- muzzle
	ball(c, 0.07, 0, 0.09, -0.4, if near(accent, NOSE) then Kit.Shade(body, -0.6) else NOSE)
	eyesOnSphere(c, 0, 0.12, -0.04, 0.3, 0.17, 0.4, 0.22)
	cheeks(c, 0, 0.12, -0.04, 0.3, 0.62, -0.05)
	ears(c, V.Ears, 0, 0.12, -0.04, 0.3)
	if V.Ears == "Pointy" then
		Kit.Rod(c.b, at(c, 0, -0.27, 0.24), at(c, 0, -0.02, 0.44), 0.12 * c.U, body)
		ball(c, 0.16, 0, 0.0, 0.45, accent, c.Mat)
	else
		ball(c, 0.18, 0, -0.25, 0.3, accent, c.Mat)
	end
	if V.Horns then
		Kit.Spike(c.b, at(c, 0, 0.36, -0.16), at(c, 0, 0.6, -0.24), 0.055 * c.U, Kit.Shade(accent, 0.25), c.Mat)
	end
	if V.Wings then
		for _, s in Sides do
			tri(c, at(c, 0.1 * s, -0.08, 0.24), at(c, 0.52 * s, 0.18, 0.34), at(c, 0.22 * s, -0.3, 0.32), 0.04, accent, c.Mat)
		end
	end
end

-- Round bird: body + belly, head with a two-piece beak, spread or folded wings, tail fan.
local function bird(c: Ctx)
	local V, body, accent = c.V, c.Body, c.Accent
	local beak = if near(body, BEAK) then Kit.Shade(body, -0.5) else BEAK
	ball(c, 0.62, 0, -0.16, 0.03, body)
	ball(c, 0.44, 0, -0.2, -0.1, accent)
	ball(c, 0.5, 0, 0.19, -0.04, body) -- head
	local upper = Vector3.new(0.11, 0.065, 0.15) * c.U
	local lower = Vector3.new(0.09, 0.045, 0.12) * c.U
	Kit.Part(c.b, "Wedge", upper, CFrame.new(at(c, 0, 0.17, -0.33) + Vector3.yAxis * upper.Y / 2), beak)
	Kit.Part(c.b, "Wedge", lower, CFrame.new(at(c, 0, 0.17, -0.32) - Vector3.yAxis * lower.Y / 2) * CFrame.Angles(0, 0, math.pi), Kit.Shade(beak, -0.12))
	eyesOnSphere(c, 0, 0.19, -0.04, 0.25, 0.16, 0.48, 0.2)
	cheeks(c, 0, 0.19, -0.04, 0.25, 0.75, -0.12)
	for _, s in Sides do
		ball(c, 0.1, 0.11 * s, -0.46, -0.04, beak)
		if V.Wings then
			tri(c, at(c, 0.2 * s, -0.02, 0.0), at(c, 0.64 * s, 0.26, 0.16), at(c, 0.26 * s, -0.22, 0.2), 0.05, Kit.Shade(body, -0.06))
			tri(c, at(c, 0.24 * s, -0.04, 0.07), at(c, 0.52 * s, 0.1, 0.22), at(c, 0.28 * s, -0.22, 0.22), 0.06, accent, c.Mat)
		else
			tri(c, at(c, 0.27 * s, 0.0, -0.08), at(c, 0.3 * s, -0.12, 0.3), at(c, 0.28 * s, -0.3, 0.06), 0.06, Kit.Shade(body, -0.12))
		end
		if V.Ears == "Pointy" then
			tri(c, at(c, 0.07 * s, 0.38, -0.02), at(c, 0.2 * s, 0.33, 0.0), at(c, 0.2 * s, 0.54, 0.03), 0.05, Kit.Shade(body, -0.15))
		end
	end
	tri(c, at(c, -0.13, -0.06, 0.46), at(c, 0.13, -0.06, 0.46), at(c, 0, -0.16, 0.24), 0.05, accent, c.Mat) -- tail fan
	if c.Glow then
		tri(c, at(c, 0, 0.36, -0.12), at(c, 0, 0.4, 0.12), at(c, 0, 0.62, 0.06), 0.05, accent, c.Mat) -- flame crest
	end
end

-- Dome blob (slime / turtle): squashy dome on a puddle, shell spots, big eyes, optional horns.
local function blob(c: Ctx)
	local V, body, accent = c.V, c.Body, c.Accent
	ball(c, 0.88, 0, -0.06, 0, body)
	ball(c, 0.46, 0, 0.2, 0.05, body) -- soft peak
	Kit.Disc(c.b, at(c, 0, -0.465, 0.02), Vector3.yAxis, 0.98 * c.U, 0.07 * c.U, Kit.Shade(body, -0.06))
	eyesOnSphere(c, 0, -0.06, 0, 0.44, 0.22, 0.36, 0.24)
	cheeks(c, 0, -0.06, 0, 0.44, 0.6, -0.04)
	ball(c, 0.08, 0, -0.17, -0.425, NOSE) -- little "o" mouth
	for _, dir in { Vector3.new(0.6, 0.55, 0.35), Vector3.new(-0.6, 0.55, 0.35), Vector3.new(0.35, 0.5, 0.8), Vector3.new(-0.35, 0.5, 0.8), Vector3.new(0, 0.3, 1) } do
		local p = Vector3.new(0, -0.06, 0) + dir.Unit * 0.4
		ball(c, 0.2, p.X, p.Y, p.Z, accent, c.Mat)
	end
	local gloss = ball(c, 0.11, -0.2, 0.2, -0.26, WHITE)
	gloss.Transparency = 0.35
	if V.Horns then
		horns(c, 0.14, 0.34, 0.04, 0.18, accent)
	end
end

-- Floating sea critter (ray / whale / shark): tapered body, belly, fins, flukes.
local function fish(c: Ctx)
	local V, body, accent = c.V, c.Body, c.Accent
	ball(c, 0.64, 0, 0, -0.08, body)
	ball(c, 0.46, 0, 0.0, 0.2, body)
	ball(c, 0.26, 0, 0.02, 0.38, body)
	ball(c, 0.52, 0, -0.12, -0.12, accent)
	eyesOnSphere(c, 0, 0, -0.08, 0.32, 0.17, 0.62, 0.18)
	cheeks(c, 0, 0, -0.08, 0.32, 0.9, -0.1)
	ball(c, 0.06, 0, -0.08, -0.395, NOSE)
	for _, s in Sides do
		tri(c, at(c, 0.25 * s, -0.08, -0.12), at(c, 0.3 * s, -0.1, 0.14), at(c, 0.56 * s, -0.24, 0.12), 0.05, accent, c.Mat)
		tri(c, at(c, 0, 0.03, 0.4), at(c, 0.3 * s, 0.11, 0.62), at(c, 0, 0.03, 0.56), 0.05, Kit.Shade(body, -0.08))
	end
	tri(c, at(c, 0, 0.26, -0.1), at(c, 0, 0.2, 0.24), at(c, 0, 0.5, 0.2), 0.05, accent, c.Mat) -- dorsal fin
	if V.Horns then
		horns(c, 0.1, 0.25, -0.18, 0.2, accent)
	end
end

-- Dragon: critter body with a snout, cone horns, membrane wings, back spikes and a spade tail.
local function dragon(c: Ctx)
	local body, accent = c.Body, c.Accent
	ball(c, 0.52, 0, -0.22, 0.06, body)
	ball(c, 0.36, 0, -0.24, -0.07, accent)
	for _, s in Sides do
		ball(c, 0.16, 0.13 * s, -0.43, -0.08, Kit.Shade(body, -0.1))
	end
	ball(c, 0.5, 0, 0.12, -0.06, body) -- head
	ball(c, 0.27, 0, 0.04, -0.3, Kit.Shade(body, 0.12)) -- snout
	for _, s in Sides do
		ball(c, 0.04, 0.05 * s, 0.1, -0.43, NOSE) -- nostrils
	end
	eyesOnSphere(c, 0, 0.12, -0.06, 0.25, 0.16, 0.42, 0.3)
	horns(c, 0.12, 0.3, 0.0, 0.2, Kit.Shade(accent, 0.2))
	for _, s in Sides do
		local shoulder = at(c, 0.14 * s, -0.04, 0.18)
		tri(c, shoulder, at(c, 0.58 * s, 0.32, 0.3), at(c, 0.44 * s, 0.02, 0.4), 0.04, accent, c.Mat)
		tri(c, shoulder, at(c, 0.44 * s, 0.02, 0.4), at(c, 0.26 * s, -0.16, 0.36), 0.04, Kit.Shade(accent, -0.15), c.Mat)
	end
	for i, a in { 0.7, 1.1, 1.5 } do
		local y, z = -0.22 + math.cos(a) * 0.25, 0.06 + math.sin(a) * 0.25
		local h = 0.11 - i * 0.015
		tri(c, at(c, 0, y, z - 0.04), at(c, 0, y, z + h), at(c, 0, y + h, z + h), 0.04, accent, c.Mat)
	end
	local tailEnd = at(c, 0, -0.22, 0.52)
	Kit.Rod(c.b, at(c, 0, -0.34, 0.24), tailEnd, 0.11 * c.U, body)
	Kit.Diamond(c.b, tailEnd + at(c, 0, 0.02, 0.04), Vector3.xAxis, 0.15 * c.U, 0.04 * c.U, accent, c.Mat)
end

-- Crab: wide shell, eye stalks, two big claws, little legs.
local function crab(c: Ctx)
	local body, accent = c.Body, c.Accent
	ball(c, 0.56, 0, -0.14, 0.02, body)
	for _, s in Sides do
		ball(c, 0.42, 0.2 * s, -0.18, 0.05, body)
		-- eye stalk + eye looking forward
		local top = at(c, 0.13 * s, 0.3, -0.12)
		Kit.Rod(c.b, at(c, 0.09 * s, 0.0, -0.08), top, 0.05 * c.U, Kit.Shade(body, -0.1))
		eye(c, top + at(c, 0, 0.04, 0), Vector3.new(0.15 * s, 0.1, -1).Unit, 0.17, s)
		-- claw: arm, round claw, upper pincer
		local claw = at(c, 0.45 * s, -0.04, -0.3)
		Kit.Rod(c.b, at(c, 0.3 * s, -0.16, -0.06), claw, 0.08 * c.U, body)
		Kit.Ball(c.b, 0.25 * c.U, claw, Kit.Shade(body, 0.05))
		tri(c, claw + at(c, -0.05 * s, 0.06, -0.06), claw + at(c, 0.07 * s, 0.06, -0.06), claw + at(c, 0.02 * s, 0.1, -0.22), 0.06, accent, c.Mat)
		-- legs
		for _, z in { 0.06, 0.2 } do
			Kit.Rod(c.b, at(c, 0.28 * s, -0.26, z), at(c, 0.46 * s, -0.46, z + 0.06), 0.06 * c.U, Kit.Shade(body, -0.15))
		end
	end
	ball(c, 0.12, 0.12, 0.1, 0.06, accent, c.Mat)
	ball(c, 0.09, -0.1, 0.11, 0.12, accent, c.Mat)
	ball(c, 0.06, 0, -0.12, -0.26, NOSE) -- mouth
end

-- Blocky bot (golem / treasure mimic): box body with a trim band, lid head over a dark mouth with
-- teeth, big eyes, arms with fists, glowing core.
local function bot(c: Ctx)
	local body, accent = c.Body, c.Accent
	local dark = Kit.Shade(body, -0.25)
	Kit.Block(c.b, at(c, 0.6, 0.44, 0.5), CFrame.new(at(c, 0, -0.2, 0.02)), body)
	Kit.Block(c.b, at(c, 0.62, 0.06, 0.52), CFrame.new(at(c, 0, -0.1, 0.02)), accent, c.Mat)
	Kit.Block(c.b, at(c, 0.52, 0.1, 0.44), CFrame.new(at(c, 0, 0.05, 0.03)), Color3.fromRGB(40, 20, 24)) -- mouth
	local hinge = CFrame.new(at(c, 0, 0.07, 0.29)) * CFrame.Angles(math.rad(10), 0, 0)
	local head = hinge * CFrame.new(at(c, 0, 0.16, -0.27))
	Kit.Block(c.b, at(c, 0.64, 0.3, 0.54), head, body)
	Kit.Block(c.b, at(c, 0.66, 0.06, 0.56), head * CFrame.new(at(c, 0, -0.1, 0)), accent, c.Mat)
	for _, s in Sides do
		eye(c, head * at(c, 0.14 * s, 0.04, -0.27), head.LookVector, 0.17, s)
		Kit.Block(c.b, at(c, 0.14, 0.28, 0.16), CFrame.new(at(c, 0.37 * s, -0.2, 0.0)), dark)
		Kit.Block(c.b, at(c, 0.18, 0.14, 0.2), CFrame.new(at(c, 0.38 * s, -0.37, -0.02)), accent, c.Mat)
		Kit.Block(c.b, at(c, 0.18, 0.08, 0.24), CFrame.new(at(c, 0.16 * s, -0.46, 0.0)), dark)
	end
	for i = -1, 1 do
		local x = i * 0.14
		local p = head * at(c, x - 0.04, -0.15, -0.255)
		tri(c, p, head * at(c, x + 0.04, -0.15, -0.255), head * at(c, x - 0.04, -0.23, -0.255), 0.03, WHITE)
	end
	Kit.Ball(c.b, 0.12 * c.U, at(c, 0, -0.24, -0.23), accent, Enum.Material.Neon) -- core / lock
end

local TEMPLATES: { [string]: (Ctx) -> () } = {
	Critter = critter,
	Bird = bird,
	Blob = blob,
	Fish = fish,
	Dragon = dragon,
	Crab = crab,
	Bot = bot,
}
PetFactory.Templates = { "Critter", "Bird", "Blob", "Fish", "Dragon", "Crab", "Bot" }

function PetFactory.Build(visual: Pets.PetVisual, size: number): Model
	local template = if TEMPLATES[visual.Template] then visual.Template else "Critter"
	local glow = visual.Glow == true
	local b = Kit.New("Pet_" .. template, size * 0.1)
	local c: Ctx = {
		b = b,
		U = math.max(0.1, size),
		Body = Kit.Color(visual.Body, Color3.fromRGB(201, 211, 224)),
		Accent = Kit.Color(visual.Accent, WHITE),
		Glow = glow,
		Mat = Kit.Mat(glow),
		V = visual,
	}
	TEMPLATES[template](c)
	if glow then
		Kit.Light(b, c.Accent, 1.2, size * 3)
		Kit.Sparkles(b, Kit.Shade(c.Accent, 0.3), 2, size * 0.12)
	end
	b.Model:SetAttribute("Template", template)
	return Kit.Finish(b, true)
end

local cache = Kit.NewCache(96)

-- Built once per (id, size) and cloned afterwards. Unknown ids get a plain grey critter.
function PetFactory.ForId(petId: string, size: number): Model
	local key = string.format("%s|%.2f", petId, size)
	local model = Kit.Cached(cache, key, function()
		local pet = Pets.Get(petId)
		return PetFactory.Build(if pet then pet.Visual else DEFAULT_VISUAL, size)
	end)
	model.Name = petId
	return model
end

-- Builds every pet and every template/flag combination once, destroys them, returns true.
-- Studio command bar: require(game.ReplicatedStorage.Shared.Visual.PetFactory).Validate()
function PetFactory.Validate(): boolean
	local visuals: { Pets.PetVisual } = {}
	for _, pet in Pets.List do
		table.insert(visuals, pet.Visual)
	end
	for _, template in PetFactory.Templates do
		for _, ear in { "Pointy", "Round", "Long", "None" } do
			table.insert(visuals, { Template = template, Body = "#FFFFFF", Accent = "#3FA9FF", Ears = ear, Wings = true, Horns = true, Glow = true })
		end
	end
	table.insert(visuals, { Template = "NoSuchTemplate", Body = "oops", Accent = "#000000" })
	for _, visual in visuals do
		local model = PetFactory.Build(visual, 3)
		assert(model.PrimaryPart and model.PrimaryPart.Name == "Root", "pet without Root")
		assert(Kit.PartCount(model) >= 5, "pet " .. visual.Template .. " has too few parts")
		model:Destroy()
	end
	PetFactory.ForId("no_such_pet", 2):Destroy()
	return true
end

return PetFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Themes</string>
            <string name="Source"><![CDATA[--!strict
-- Per-world palettes for the procedural map and the client's sky/lighting. ORIGINAL colours in
-- the bright voxel/checker style the genre uses.
export type Theme = {
	FloorA: string,
	FloorB: string,
	Path: string,
	Cliff: string,
	CliffAlt: string,
	CliffTop: string,
	Water: string,
	WaterMaterial: string, -- "Glass" | "SmoothPlastic" | "Neon"
	ThrowZone: string,
	ThrowZoneText: string,
	Accent: string,
	Trunk: string,
	Leaves: string,
	Sky: { Top: string, Horizon: string },
	Fog: string,
	Ambient: string,
	ClockTime: number,
	Props: string, -- prop family for decoration ("Palm" | "Volcano" | "Pirate" | "Ice")
}

local Themes: { [string]: Theme } = {
	Isles = {
		FloorA = "#7BE35A",
		FloorB = "#62C946",
		Path = "#E9E3D5",
		Cliff = "#B07A4F",
		CliffAlt = "#8E5E3A",
		CliffTop = "#6FD84F",
		Water = "#35D6E8",
		WaterMaterial = "Glass",
		ThrowZone = "#FFD54A",
		ThrowZoneText = "#FFFFFF",
		Accent = "#3FA9FF",
		Trunk = "#9A6A3F",
		Leaves = "#4CCB3A",
		Sky = { Top = "#4AA8FF", Horizon = "#CDEEFF" },
		Fog = "#CDEEFF",
		Ambient = "#8C96A8",
		ClockTime = 13.5,
		Props = "Palm",
	},
	Ember = {
		FloorA = "#D9C6B0",
		FloorB = "#C2AD96",
		Path = "#FF8A2A",
