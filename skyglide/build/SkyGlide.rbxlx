        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict
-- Redeemable codes (server-only, never replicated). Codes are case-insensitive.
-- Expires = unix seconds, or 0 for never.
local Rewards = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Definitions.Rewards)

export type Code = { Rewards: { Rewards.Reward }, Expires: number }

local Codes: { [string]: Code } = {
	LAUNCH = { Rewards = { { Kind = "Wins", Amount = 50 }, { Kind = "Potion", Id = "skill_potion", Count = 1 } }, Expires = 0 },
	THERMAL = { Rewards = { { Kind = "Potion", Id = "luck_potion", Count = 2 } }, Expires = 0 },
	GLIDE = { Rewards = { { Kind = "Skill", Reps = 300 }, { Kind = "Potion", Id = "wins_potion", Count = 1 } }, Expires = 0 },
}

return Codes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--!strict
-- Session-locked DataStore profiles (ProfileService-style) with retries and a Studio mock.
--
-- Record layout in the DataStore: { Data = <profile>, Lock = { JobId, Time }?, Meta = 1 }
-- * Load claims the lock with UpdateAsync. A lock held by another live server is respected
--   until it is older than LOCK_TIMEOUT (crashed server), then it is stolen.
-- * Every save refreshes the lock and verifies we still own it; if another server took over,
--   the session is marked lost and the player is kicked to prevent duplication.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local ProfileStore = {}
ProfileStore.__index = ProfileStore

local LOCK_TIMEOUT = 150 -- seconds; autosave refreshes every 60
local LOAD_ATTEMPTS = 6
local RETRY_BASE = 1.5

type Record = { Data: any, Lock: { JobId: string, Time: number }?, Meta: number }

export type Session = {
	Key: string,
	Data: any,
	Lost: boolean,
	Released: boolean,
}

type Backend = {
	UpdateAsync: (self: Backend, key: string, transform: (any) -> any) -> any,
}

export type ProfileStore = typeof(setmetatable({} :: { _backend: Backend, _jobId: string, IsMock: boolean }, ProfileStore))

-- In-memory fallback used when Studio has no API access.
local MockBackend = {}
MockBackend.__index = MockBackend
function MockBackend.new()
	return setmetatable({ _store = {} :: { [string]: any } }, MockBackend)
end
function MockBackend:UpdateAsync(key: string, transform: (any) -> any): any
	local old = self._store[key]
	local copy = if old then HttpService:JSONDecode(HttpService:JSONEncode(old)) else nil
	local new = transform(copy)
	if new ~= nil then
		self._store[key] = HttpService:JSONDecode(HttpService:JSONEncode(new))
	end
	return new
end

local function jobId(): string
	if game.JobId ~= "" then
		return game.JobId
	end
	return "studio-" .. HttpService:GenerateGUID(false)
end

function ProfileStore.new(name: string): ProfileStore
	local backend: any = nil
	local isMock = false
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok and store then
		backend = store
		if RunService:IsStudio() then
			local probeOk = pcall(function()
				store:GetAsync("__probe")
			end)
			if not probeOk then
				backend = nil
			end
		end
	end
	if backend == nil then
		warn("[ProfileStore] DataStores unavailable (enable Studio API access to persist). Using in-memory mock.")
		backend = MockBackend.new()
		isMock = true
	end
	return setmetatable({ _backend = backend :: Backend, _jobId = jobId(), IsMock = isMock }, ProfileStore)
end

local function retry<T>(attempts: number, fn: () -> T): (boolean, T | string)
	local lastErr: any = nil
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(RETRY_BASE * 2 ^ (attempt - 1))
	end
	return false, tostring(lastErr)
end

-- Loads and locks a profile. Returns nil when the profile could not be claimed.
-- `isActive` lets the caller abort (e.g. the player left during loading).
function ProfileStore.Load(self: ProfileStore, key: string, isActive: () -> boolean): Session?
	for attempt = 1, LOAD_ATTEMPTS do
		if not isActive() then
			return nil
		end
		local lockedElsewhere = false
		local ok, result = pcall(function()
			return self._backend:UpdateAsync(key, function(old: any)
				lockedElsewhere = false -- UpdateAsync may call the transform more than once
				local record: Record = if type(old) == "table" then old else { Data = nil, Lock = nil, Meta = 1 }
				local lock = record.Lock
				local now = os.time()
				if lock and lock.JobId ~= self._jobId and now - lock.Time < LOCK_TIMEOUT then
					lockedElsewhere = true
					return nil -- cancel write
				end
				record.Lock = { JobId = self._jobId, Time = now }
				record.Meta = 1
				return record
			end)
		end)
		if ok and result ~= nil and not lockedElsewhere then
			local record = result :: Record
			return { Key = key, Data = record.Data, Lost = false, Released = false }
		end
		if not ok then
			warn(string.format("[ProfileStore] load %s failed (attempt %d): %s", key, attempt, tostring(result)))
		end
		task.wait(if lockedElsewhere then 5 else RETRY_BASE * 2 ^ (attempt - 1))
	end
	return nil
end

-- Writes data and refreshes (or releases) the lock. Returns false if the session was lost.
function ProfileStore.Save(self: ProfileStore, session: Session, release: boolean): boolean
	if session.Released or session.Lost then
		return false
	end
	local lost = false
	local ok, err = retry(3, function()
		return self._backend:UpdateAsync(session.Key, function(old: any)
			lost = false
			local record: Record = if type(old) == "table" then old else { Data = nil, Lock = nil, Meta = 1 }
			local lock = record.Lock
			if lock and lock.JobId ~= self._jobId then
				lost = true
				return nil
			end
			record.Data = session.Data
			record.Lock = if release then nil else { JobId = self._jobId, Time = os.time() }
			record.Meta = 1
			return record
		end)
	end)
	if lost then
		session.Lost = true
		return false
	end
	if not ok then
		warn(string.format("[ProfileStore] save %s failed: %s", session.Key, tostring(err)))
		return false
	end
	if release then
		session.Released = true
	end
	return true
end

return ProfileStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Schema</string>
            <string name="Source"><![CDATA[--!strict
-- Player profile schema: defaults, migrations and sanitisation of loaded data.
-- Bump CURRENT_VERSION and add a migration step whenever the shape changes.
-- Dictionary keys are always strings (DataStore JSON cannot hold sparse numeric keys).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Trails = require(Shared.Definitions.Trails)
local Pets = require(Shared.Definitions.Pets)
local Boosts = require(Shared.Definitions.Boosts)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Tutorial = require(Shared.Definitions.Tutorial)

export type OwnedPet = { Id: string, Locked: boolean }

export type Profile = {
	Version: number,
	Skill: number,
	Wins: number,
	Level: number,
	XP: number,
	Rebirths: number,
	World: number,
	Worlds: { [string]: boolean },
	Glider: string,
	Gliders: { [string]: boolean },
	Relic: string,
	Relics: { [string]: boolean },
	Trail: string,
	Trails: { [string]: boolean },
	Pets: { [string]: OwnedPet },
	EquippedPets: { string },
	NextPetId: number,
	Index: { [string]: boolean }, -- every pet id ever owned (the collection book)
	Potions: { [string]: number },
	Boosts: { [string]: number },
	Daily: { Day: number, Streak: number },
	Codes: { [string]: boolean },
	Tutorial: { Step: number, Progress: number, Done: boolean },
	Settings: { AutoTrain: boolean, AutoThrow: boolean, FollowCam: boolean, Sfx: boolean, LowFx: boolean },
	Stats: {
		Throws: number,
		Perfects: number,
		Rings: number,
		BestDistance: number,
		TotalSkill: number,
		TotalWins: number,
		Hatches: number,
		Playtime: number,
		RobuxSpent: number,
	},
	Best: { [string]: number },
	Zones: { [string]: boolean },
	Flags: { StarterPack: boolean },
	TestPasses: { [string]: boolean }, -- Studio-only free test grants (ignored in live servers)
	Receipts: { string },
	Created: number,
	LastLogin: number,
}

local Schema = {}

Schema.CURRENT_VERSION = 2

function Schema.Default(): Profile
	local now = os.time()
	return {
		Version = Schema.CURRENT_VERSION,
		Skill = Economy.Starting.Skill,
		Wins = Economy.Starting.Wins,
		Level = 1,
		XP = 0,
		Rebirths = 0,
		World = 1,
		Worlds = { ["1"] = true },
		Glider = Economy.Starting.Glider,
		Gliders = { [Economy.Starting.Glider] = true },
		Relic = "",
		Relics = {},
		Trail = "",
		Trails = {},
		Pets = {},
		EquippedPets = {},
		NextPetId = 1,
		Index = {},
		Potions = {},
		Boosts = {},
		Daily = { Day = 0, Streak = 0 },
		Codes = {},
		Tutorial = { Step = 1, Progress = 0, Done = false },
		Settings = { AutoTrain = false, AutoThrow = false, FollowCam = true, Sfx = true, LowFx = false },
		Stats = {
			Throws = 0,
			Perfects = 0,
			Rings = 0,
			BestDistance = 0,
			TotalSkill = 0,
			TotalWins = 0,
			Hatches = 0,
			Playtime = 0,
			RobuxSpent = 0,
		},
		Best = {},
		Zones = {},
		Flags = { StarterPack = false },
		TestPasses = {},
		Receipts = {},
		Created = now,
		LastLogin = now,
	}
end

-- Migrations: index = version being upgraded FROM.
local Migrations: { [number]: (any) -> any } = {
	-- 1 -> 2: the pet Index. Earlier deletions are unknown, so it starts from the pets owned now.
	[1] = function(data)
		local index = {}
		if type(data.Pets) == "table" then
			for _, pet in data.Pets do
				if type(pet) == "table" and type(pet.Id) == "string" then
					index[pet.Id] = true
				end
			end
		end
		data.Index = index
		return data
	end,
}

local function num(v: any, default: number, min: number, max: number): number
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return math.clamp(v, min, max)
end

local function int(v: any, default: number, min: number, max: number): number
	return math.floor(num(v, default, min, max))
end

local function boolSet(v: any, isValid: (string) -> boolean): { [string]: boolean }
	local out = {}
	if type(v) ~= "table" then
		return out
	end
	for id, flag in v do
		if type(id) == "string" and flag == true and isValid(id) then
			out[id] = true
		end
	end
	return out
end

-- Repairs a loaded record so the rest of the server can trust its shape.
function Schema.Sanitize(raw: any): Profile
	local data = if type(raw) == "table" then raw else {}
	local version = int(data.Version, 0, 0, 1000)
	while version < Schema.CURRENT_VERSION and Migrations[version] do
		data = Migrations[version](data)
		version += 1
	end

	local p = Schema.Default()
	if version == 0 and data.Skill == nil then
		return p -- brand new player
	end

	p.Skill = num(data.Skill, 0, 0, Economy.Limits.MaxSkill)
	p.Wins = num(data.Wins, 0, 0, Economy.Limits.MaxWins)
	p.Rebirths = int(data.Rebirths, 0, 0, Economy.MaxRebirths)
	-- Level and XP are derived from Skill (never trusted from storage)
	local cap = Economy.LevelCap(p.Rebirths)
	p.Level = Economy.LevelForSkill(p.Skill, cap)
	p.XP = if p.Level >= cap then Economy.XPToNext(p.Level) else math.max(0, p.Skill - Economy.SkillForLevel(p.Level))

	p.Worlds = boolSet(data.Worlds, function(id)
		return Worlds.Exists(tonumber(id))
	end)
	p.Worlds["1"] = true
	local world = int(data.World, 1, 1, Worlds.Count)
	p.World = if p.Worlds[tostring(world)] then world else 1

	p.Gliders = boolSet(data.Gliders, Gliders.Exists)
	p.Gliders[Gliders.Default] = true
	p.Glider = if type(data.Glider) == "string" and p.Gliders[data.Glider] then data.Glider else Gliders.Default

	p.Relics = boolSet(data.Relics, Relics.Exists)
	p.Relic = if type(data.Relic) == "string" and p.Relics[data.Relic] then data.Relic else ""

	p.Trails = boolSet(data.Trails, Trails.Exists)
	p.Trail = if type(data.Trail) == "string" and p.Trails[data.Trail] then data.Trail else ""

	if type(data.Pets) == "table" then
		-- Never drop pets on load. Gifts, codes and Robux eggs may legitimately take a player past
		-- the soft inventory cap (only Wins hatches are blocked by it). The hard bound only guards
		-- against corrupted records, and keeps the lowest uids (oldest pets) deterministically.
		local uids = {}
		for uid, pet in data.Pets do
			if type(uid) == "string" and #uid <= 16 and type(pet) == "table" and Pets.Exists(pet.Id) then
				table.insert(uids, uid)
			end
		end
		table.sort(uids, function(a, b)
			local na, nb = tonumber(a), tonumber(b)
			if na and nb then
				return na < nb
			elseif na or nb then
				return na ~= nil -- numeric uids first (a total order, so the sort can never fail)
			end
			return a < b
		end)
		for i, uid in uids do
			if i > Economy.PetHardLimit then
				break
			end
			local pet = data.Pets[uid]
			p.Pets[uid] = { Id = pet.Id, Locked = pet.Locked == true }
		end
	end
	if type(data.EquippedPets) == "table" then
		local seen = {}
		for _, uid in data.EquippedPets do
			if type(uid) == "string" and p.Pets[uid] and not seen[uid] and #p.EquippedPets < Economy.PetSlots + Economy.PetSlotsPass then
				seen[uid] = true
				table.insert(p.EquippedPets, uid)
			end
		end
	end
	p.NextPetId = int(data.NextPetId, 1, 1, 1e12)
	-- the Index only holds real pet ids, and always includes every pet owned now
	p.Index = boolSet(data.Index, Pets.Exists)
	for _, pet in p.Pets do
		p.Index[pet.Id] = true
	end

	if type(data.Potions) == "table" then
		for id, n in data.Potions do
			if Boosts.Exists(id) then
				local c = int(n, 0, 0, Economy.Limits.MaxPotions)
				if c > 0 then
					p.Potions[id] = c
				end
			end
		end
	end
	if type(data.Boosts) == "table" then
		local now = os.time()
		for id, expiry in data.Boosts do
			if Boosts.Exists(id) then
				local e = num(expiry, 0, 0, now + Boosts.MaxStackSeconds)
				if e > now then
					p.Boosts[id] = e
				end
			end
		end
	end

	local daily = if type(data.Daily) == "table" then data.Daily else {}
	p.Daily.Day = int(daily.Day, 0, 0, 1e9)
	p.Daily.Streak = int(daily.Streak, 0, 0, 1e6)

	p.Codes = boolSet(data.Codes, function(code)
		return #code <= 32
	end)

	local tut = if type(data.Tutorial) == "table" then data.Tutorial else {}
	p.Tutorial.Done = tut.Done == true
	p.Tutorial.Step = int(tut.Step, 1, 1, #Tutorial.Steps + 1)
	p.Tutorial.Progress = int(tut.Progress, 0, 0, 1e6)
	if p.Tutorial.Step > #Tutorial.Steps then
		p.Tutorial.Done = true
	end

	local settings = if type(data.Settings) == "table" then data.Settings else {}
	for key, default in p.Settings :: any do
		local v = settings[key]
		if type(v) == "boolean" then
			(p.Settings :: any)[key] = v
		else
			(p.Settings :: any)[key] = default
		end
	end

	local stats = if type(data.Stats) == "table" then data.Stats else {}
	for key, default in p.Stats :: any do
		(p.Stats :: any)[key] = num(stats[key], default, 0, 1e300)
	end

	if type(data.Best) == "table" then
		for id, v in data.Best do
			if type(id) == "string" and Worlds.Exists(tonumber(id)) then
				p.Best[id] = num(v, 0, 0, 1e300)
			end
		end
	end
	p.Zones = boolSet(data.Zones, function(id)
		return Zones.Get(id) ~= nil
	end)

	local flags = if type(data.Flags) == "table" then data.Flags else {}
	p.Flags.StarterPack = flags.StarterPack == true

	p.TestPasses = boolSet(data.TestPasses, function(key)
		return #key <= 32
	end)

	if type(data.Receipts) == "table" then
		for _, id in data.Receipts do
			if type(id) == "string" and #id <= 64 then
				table.insert(p.Receipts, id)
			end
		end
		while #p.Receipts > 100 do
			table.remove(p.Receipts, 1)
		end
	end

	p.Created = int(data.Created, os.time(), 0, 1e11)
	p.LastLogin = os.time()
	return p
end

local function clonePets(pets: { [string]: OwnedPet }): { [string]: OwnedPet }
	local out = {}
	for uid, pet in pets do
		out[uid] = { Id = pet.Id, Locked = pet.Locked }
	end
	return out
end

-- What the owning client is allowed to see (everything except receipts and test flags).
function Schema.PublicView(p: Profile): { [string]: any }
	return {
		Skill = p.Skill,
		Wins = p.Wins,
		Level = p.Level,
		XP = p.XP,
		Rebirths = p.Rebirths,
		World = p.World,
		Worlds = table.clone(p.Worlds),
		Glider = p.Glider,
		Gliders = table.clone(p.Gliders),
		Relic = p.Relic,
		Relics = table.clone(p.Relics),
		Trail = p.Trail,
		Trails = table.clone(p.Trails),
		Pets = clonePets(p.Pets),
		EquippedPets = table.clone(p.EquippedPets),
		Index = table.clone(p.Index),
		Potions = table.clone(p.Potions),
		Boosts = table.clone(p.Boosts),
		Daily = table.clone(p.Daily),
		Tutorial = table.clone(p.Tutorial),
		Settings = table.clone(p.Settings),
		Stats = table.clone(p.Stats),
		Best = table.clone(p.Best),
		Zones = table.clone(p.Zones),
		Flags = table.clone(p.Flags),
	}
end

return Schema
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="51">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server bootstrap: creates remotes, then initialises and starts every service in order.
-- Services expose optional Init(registry) (wire-up, no yielding except map building) and Start().
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)

Remotes.Init()

local Services = script.Parent.Services

local ORDER = {
	"DataService",
	"NotifyService",
	"MonetizationService",
	"EventService",
	"StatService",
	"TutorialService",
	"MapService",
	"CharacterService",
	"WorldService",
	"SettingsService",
	"TrainingService",
	"FlightService",
	"ShopService",
	"PetService",
	"RebirthService",
	"RewardService",
	"LeaderboardService",
	"AdminService",
}

local registry: { [string]: any } = {}
for _, name in ORDER do
	registry[name] = (require :: any)(Services:WaitForChild(name))
end

for _, name in ORDER do
	local service = registry[name]
	if type(service.Init) == "function" then
		local ok, err = pcall(service.Init, registry)
		if not ok then
			warn(string.format("[Main] %s.Init failed: %s", name, tostring(err)))
		end
	end
end

for _, name in ORDER do
	local service = registry[name]
	if type(service.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(service.Start)
			if not ok then
				warn(string.format("[Main] %s.Start failed: %s", name, tostring(err)))
			end
		end)
	end
end

print("[Sky Glide] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="52">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
-- Diagnostics for allow-listed admins (Config/Admin). Every request is re-checked here; normal
-- players get "not allowed" and the client never shows the panel to them.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Admin = require(Shared.Config.Admin)
local Economy = require(Shared.Config.Economy)
local Progression = require(Shared.Sim.Progression)
local Worlds = require(Shared.Definitions.Worlds)
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)

local AdminService = {}

local registry: { [string]: any } = {}

function AdminService.IsAdmin(player: Player): boolean
	if Admin.StudioAll and RunService:IsStudio() then
		return true
	end
	return table.find(Admin.UserIds, player.UserId) ~= nil
end

local function handle(player: Player, action: any, arg: any): { [string]: any }
	if not AdminService.IsAdmin(player) then
		return { ok = false, error = "Not allowed." }
	end
	if action == "Stats" then
		return {
			ok = true,
			stats = {
				Players = #Players:GetPlayers(),
				Flights = registry.FlightService and registry.FlightService.ActiveCount() or 0,
				MemoryMB = math.floor(Stats:GetTotalMemoryUsageMb()),
				Heartbeat = math.floor(1 / math.max(1e-3, Stats.HeartbeatTimeMs / 1000)),
				MockData = DataService.IsMock(),
			},
		}
	elseif action == "GrantSkill" and Validate.Number(arg, 0, 1e30) then
		registry.StatService.AddSkill(player, arg, "Admin")
	elseif action == "GrantWins" and Validate.Number(arg, 0, 1e30) then
		registry.StatService.AddWins(player, arg, "Admin")
	elseif action == "MaxLevel" then
		-- Level is derived from Skill, so jump Skill to the start of the cap level
		DataService.Update(player, function(p)
			p.Skill = math.max(p.Skill, Economy.SkillForLevel(Economy.LevelCap(p.Rebirths)))
			Progression.SyncLevel(p)
			return true
		end)
	elseif action == "UnlockWorlds" then
		DataService.Update(player, function(p)
			for _, w in Worlds.List do
				p.Worlds[tostring(w.Id)] = true
			end
			return true
		end)
	elseif action == "StartEvent" then
		local events = registry.EventService
		if events then
			events.Begin(if Validate.Number(arg, 1, 1440) then arg else 30)
		end
	elseif action == "StopEvent" then
		local events = registry.EventService
		if events then
			events.Stop()
		end
	elseif action == "ResetTutorial" then
		DataService.Update(player, function(p)
			p.Tutorial = { Step = 1, Progress = 0, Done = false }
			return true
		end)
	else
		return { ok = false, error = "Unknown action." }
	end
	return { ok = true }
end

function AdminService.Init(reg: { [string]: any })
	registry = reg
	DataService.AddDecorator(function(player, view)
		view.IsAdmin = AdminService.IsAdmin(player)
	end)
end

function AdminService.Start()
	Guard.OnInvoke(Remotes.Function("AdminRequest"), 2, 5, handle)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--!strict
-- Character dressing: the equipped glider held in the right hand (everyone sees what you throw)
-- and the equipped trail. Players don't collide with each other.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Trails = require(Shared.Definitions.Trails)
local GliderFactory = require(Shared.Visual.GliderFactory)

local DataService = require(script.Parent.DataService)

local CharacterService = {}

local GROUP = "SkyGlidePlayers"

local function setGroup(character: Model)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = GROUP
		end
	end
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = GROUP
		end
	end)
end

local function visualFor(profile: DataService.Profile): any
	if profile.Relic ~= "" then
		local relic = Relics.Get(profile.Relic)
		if relic then
			return relic.Visual
		end
	end
	local glider = Gliders.Get(profile.Glider) or Gliders.Get(Gliders.Default)
	return if glider then glider.Visual else nil
end

local function dress(player: Player)
	local character = player.Character
	local profile = DataService.Get(player)
	if not character or not profile then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local root = character:FindFirstChild("HumanoidRootPart")
	local old = character:FindFirstChild("HeldGlider")
	if old then
		old:Destroy()
	end
	local visual = visualFor(profile)
	if hand and hand:IsA("BasePart") and visual then
		local model = GliderFactory.Build(visual, 2.4, false)
		model.Name = "HeldGlider"
		local primary = model.PrimaryPart
		if primary then
			model:PivotTo(hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 - 0.2, -0.4) * CFrame.Angles(math.rad(-20), 0, 0))
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = primary
			weld.Parent = primary
		end
		model.Parent = character
	end
	-- trail
	if root and root:IsA("BasePart") then
		local oldTrail = root:FindFirstChild("SkyTrail")
		if oldTrail then
			oldTrail:Destroy()
		end
		for _, name in { "TrailA0", "TrailA1" } do
			local a = root:FindFirstChild(name)
			if a then
				a:Destroy()
			end
		end
		local def = Trails.Get(profile.Trail)
		if def then
			local a0 = Instance.new("Attachment")
			a0.Name = "TrailA0"
			a0.Position = Vector3.new(0, 0.9, 0.4)
			a0.Parent = root
			local a1 = Instance.new("Attachment")
			a1.Name = "TrailA1"
			a1.Position = Vector3.new(0, -1.4, 0.4)
			a1.Parent = root
			local trail = Instance.new("Trail")
			trail.Name = "SkyTrail"
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.6
			trail.LightEmission = 0.6
			trail.FaceCamera = true
			local keys = {}
			for i, hex in def.Colors do
				local t = if #def.Colors == 1 then 0 else (i - 1) / (#def.Colors - 1)
				table.insert(keys, ColorSequenceKeypoint.new(t, Color3.fromHex(hex)))
			end
			if #keys == 1 then
				table.insert(keys, ColorSequenceKeypoint.new(1, keys[1].Value))
			end
			trail.Color = ColorSequence.new(keys)
			trail.Transparency = NumberSequence.new(0.15, 1)
			trail.Parent = root
		end
	end
	player:SetAttribute("Glider", if profile.Relic ~= "" then "relic:" .. profile.Relic else profile.Glider)
	player:SetAttribute("Trail", profile.Trail)
end

function CharacterService.Refresh(player: Player)
	task.spawn(dress, player)
end

function CharacterService.Init()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(GROUP)
		PhysicsService:CollisionGroupSetCollidable(GROUP, GROUP, false)
	end)
end

function CharacterService.Start()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			setGroup(character)
			character:WaitForChild("HumanoidRootPart", 10)
			DataService.WaitFor(player, 30)
			task.wait(0.2)
			dress(player)
		end)
		if player.Character then
			setGroup(player.Character)
			task.spawn(dress, player)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns every player's profile: load (session locked), sanitise, mutate, replicate, autosave,
-- release on leave and on shutdown. Other services never touch DataStores directly.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Signal = require(Shared.Util.Signal)

local Server = script.Parent.Parent
local ProfileStore = require(Server.Data.ProfileStore)
local Schema = require(Server.Data.Schema)

export type Profile = Schema.Profile

local DataService = {}

DataService.Loaded = Signal.new() -- (player, profile)
DataService.Changed = Signal.new() -- (player, profile)
DataService.Releasing = Signal.new() -- (player, profile) fired before the final save

local STORE_NAME = "SkyGlide_PlayerData_v1"
local AUTOSAVE_SECONDS = 60

local store: ProfileStore.ProfileStore
local sessions: { [Player]: ProfileStore.Session } = {}
local dirtySync: { [Player]: boolean } = {}
local loadWaiters: { [Player]: { thread } } = {}
local loading: { [Player]: boolean } = {}
local releasing: { [Player]: boolean } = {} -- final saves in flight (BindToClose waits for them)

local playerDataRemote: RemoteEvent
local decorators: { (Player, { [string]: any }) -> () } = {}

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

function DataService.Get(player: Player): Profile?
	local session = sessions[player]
	if session == nil or session.Lost or session.Released then
		return nil
	end
	return session.Data :: Profile
end

-- Yields until the profile is loaded (or the player leaves / timeout).
function DataService.WaitFor(player: Player, timeout: number?): Profile?
	local existing = DataService.Get(player)
	if existing then
		return existing
	end
	local thread = coroutine.running()
	local waiters = loadWaiters[player] or {}
	loadWaiters[player] = waiters
	table.insert(waiters, thread)
	task.delay(timeout or 30, function()
		local i = table.find(waiters, thread)
		if i then
			table.remove(waiters, i)
			task.spawn(thread)
		end
	end)
	coroutine.yield()
	return DataService.Get(player)
end

-- The only way to mutate a profile. `mutator` runs synchronously and must not yield.
-- Returns whatever the mutator returns (nil if the profile is not loaded).
function DataService.Update<T>(player: Player, mutator: (Profile) -> T): T?
	local profile = DataService.Get(player)
	if profile == nil then
		return nil
	end
	local result = mutator(profile)
	DataService.MarkChanged(player)
	return result
end

function DataService.MarkChanged(player: Player)
	dirtySync[player] = true
	local profile = DataService.Get(player)
	if profile then
		DataService.Changed:Fire(player, profile)
	end
end

-- Other services add derived, read-only fields (multipliers, pass ownership...) to the view.
function DataService.AddDecorator(fn: (Player, { [string]: any }) -> ())
	table.insert(decorators, fn)
end

function DataService.SyncNow(player: Player)
	local profile = DataService.Get(player)
	if profile and player.Parent then
		dirtySync[player] = nil
		local view = Schema.PublicView(profile)
		for _, fn in decorators do
			local ok, err = pcall(function()
				fn(player, view)
			end)
			if not ok then
				warn("[DataService] decorator failed: " .. tostring(err))
			end
		end
		playerDataRemote:FireClient(player, view)
	end
end

-- Marks the client view stale without firing Changed (used for derived values like timers).
function DataService.MarkDirty(player: Player)
	dirtySync[player] = true
end

-- Forces an immediate save (used after purchases and trades).
function DataService.SaveNow(player: Player): boolean
	local session = sessions[player]
	if session == nil then
		return false
	end
	local ok = store:Save(session, false)
	if session.Lost then
		player:Kick("Your data was opened in another server. Please rejoin.")
	end
	return ok
end

function DataService.IsMock(): boolean
	return store.IsMock
end

local function onPlayerAdded(player: Player)
	if loading[player] or sessions[player] then
		return
	end
	loading[player] = true
	local session = store:Load(keyFor(player), function()
		return player.Parent == Players
	end)
	if player.Parent ~= Players then
		-- left while loading: release the lock we just took
		if session then
			releasing[player] = true
			loading[player] = nil
			store:Save(session, true)
			releasing[player] = nil
		else
			loading[player] = nil
		end
		return
	end
	loading[player] = nil
	if session == nil then
		player:Kick("Could not load your data. Please rejoin in a moment.")
		return
	end
	session.Data = Schema.Sanitize(session.Data)
	sessions[player] = session

	local waiters = loadWaiters[player]
	loadWaiters[player] = nil
	if waiters then
		local list = table.clone(waiters)
		table.clear(waiters) -- the WaitFor timeout must not resume these again
		for _, thread in list do
			task.spawn(thread)
		end
	end

	DataService.Loaded:Fire(player, session.Data)
	DataService.SyncNow(player)
end

local function release(player: Player)
	local session = sessions[player]
	if session == nil then
		return
	end
	releasing[player] = true
	DataService.Releasing:Fire(player, session.Data)
	sessions[player] = nil
	dirtySync[player] = nil
	store:Save(session, true)
	releasing[player] = nil
end

function DataService.Init()
	store = ProfileStore.new(STORE_NAME)
	playerDataRemote = Remotes.Event("PlayerData")
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	-- deferred so every other service's Start() has connected to Loaded first
	task.defer(function()
		for _, player in Players:GetPlayers() do
			task.spawn(onPlayerAdded, player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		-- let other services finish their PlayerRemoving work (flights in progress) first
		task.defer(release, player)
	end)

	-- batched client sync (at most ~6/s per player)
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player in dirtySync do
				DataService.SyncNow(player)
			end
		end
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player, session in sessions do
				task.spawn(function()
					store:Save(session, false)
					if session.Lost and player.Parent then
						player:Kick("Your data was opened in another server. Please rejoin.")
					end
				end)
			end
		end
	end)

	game:BindToClose(function()
		for player in sessions do
			task.spawn(release, player)
		end
		-- wait for every save: open sessions, releases already started by PlayerRemoving, and
		-- profiles still loading (they release their lock as soon as the load returns)
		local deadline = os.clock() + (if RunService:IsStudio() then 5 else 25)
		while (next(sessions) ~= nil or next(releasing) ~= nil or next(loading) ~= nil) and os.clock() < deadline do
			for player in sessions do
				task.spawn(release, player)
			end
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-wide live events: while one is active every player gets the Config/Events boosts and
-- special throws are more likely. Started by the schedule or by an admin; announced to clients via
-- ServerInfo { Kind = "Event", Active, Name, EndsAt }.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Config.Events)
local Remotes = require(Shared.Net.Remotes)

local EventService = {}

local registry: { [string]: any } = {}
local manualName = ""
local manualEndsAt = 0
local serverInfo: RemoteEvent
local lastActive = false

-- Active event (name, endsAt) or nil.
function EventService.Current(): (string?, number)
	local now = os.time()
	if manualEndsAt > now then
		return manualName, manualEndsAt
	end
	for _, window in Events.Schedule do
		if now >= window.StartsAt and now < window.EndsAt then
			return window.Name, window.EndsAt
		end
	end
	return nil, 0
end

function EventService.IsActive(): boolean
	local name = EventService.Current()
	return name ~= nil
end

function EventService.SkillMultiplier(): number
	return if EventService.IsActive() then Events.SkillMultiplier else 1
end

function EventService.WinsMultiplier(): number
	return if EventService.IsActive() then Events.WinsMultiplier else 1
end

function EventService.SpecialLuck(): number
	return if EventService.IsActive() then Events.SpecialLuck else 1
end

local function broadcast(target: Player?)
	local name, endsAt = EventService.Current()
	local payload = { Kind = "Event", Active = name ~= nil, Name = name or "", EndsAt = endsAt }
	if target then
		serverInfo:FireClient(target, payload)
	else
		serverInfo:FireAllClients(payload)
	end
end

-- Begins (or extends) a manual event for `minutes`.
function EventService.Begin(minutes: number, name: string?)
	manualName = name or Events.Name
	manualEndsAt = os.time() + math.clamp(minutes, 1, 24 * 60) * 60
	broadcast(nil)
	local notify = registry.NotifyService
	if notify then
		notify.All(manualName .. " started! x2 Skill, x2 Wins, special throws x3 more likely!", "Rare")
	end
	local data = registry.DataService
	if data then
		for _, player in Players:GetPlayers() do
			data.MarkDirty(player)
		end
	end
end

function EventService.Stop()
	manualEndsAt = 0
	broadcast(nil)
end

function EventService.Init(reg: { [string]: any })
	registry = reg
	serverInfo = Remotes.Event("ServerInfo")
end

function EventService.Start()
	Players.PlayerAdded:Connect(function(player)
		task.delay(3, broadcast, player)
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			local active = EventService.IsActive()
			if active ~= lastActive then
				lastActive = active
				broadcast(nil)
				local data = registry.DataService
				if data then
					for _, player in Players:GetPlayers() do
						data.MarkDirty(player)
					end
				end
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">FlightService</string>
            <string name="Source"><![CDATA[--!strict
-- ORIGINAL DESIGN core loop: charge -> launch -> ride thermal rings -> land in a zone.
--
-- Throw state machine per player:
--   Idle --RequestThrowCharge--> Charging --RequestThrow / max hold--> Flying --T--> Landed
--   Landed --LandCooldown--> Idle          (Auto Throw: Idle --AutoThrowDelay--> Flying)
--
-- Everything that pays out is decided here from a server-built FlightSim plan:
--   * the launch meter is timed with the server clock (charge start -> release),
--   * each ring pays "+N Skill" (glider) x Skill multiplier, x2 when a PERFECT gust tap arrived in
--     the ring's window (judged with server time + a capped ping allowance),
--   * landing pays the zone's Wins x Wins multiplier and XP.
-- Clients only send intents and draw the same plan; they never report distance, rings or wins.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Flight = require(Shared.Config.Flight)
local FlightSim = require(Shared.Sim.FlightSim)
local Progression = require(Shared.Sim.Progression)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)
local MapService = require(script.Parent.MapService)

local FlightService = {}

type Active = {
	Plan: FlightSim.Plan,
	WorldScale: number,
	SkillPerRing: number,
	Multiplier: number,
	Rings: { [number]: string }, -- index -> "Perfect" | "Miss"
	NextPay: number,
	TotalSkill: number,
	Perfects: number,
	Taps: number,
}

type State = {
	Charging: boolean,
	ChargeStart: number,
	Active: Active?,
	CooldownUntil: number,
	AutoNextAt: number,
}

local registry: { [string]: any } = {}
local states: { [Player]: State } = {}
local nextFlightId = 0
local seedRng = Random.new()

local remotes: {
	FlightStarted: RemoteEvent,
	FlightRing: RemoteEvent,
	FlightLanded: RemoteEvent,
	ChargeState: RemoteEvent,
} = {} :: any

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function stateOf(player: Player): State
	local s = states[player]
	if not s then
		s = { Charging = false, ChargeStart = 0, Active = nil, CooldownUntil = 0, AutoNextAt = 0 }
		states[player] = s
	end
	return s
end

function FlightService.IsFlying(player: Player): boolean
	local s = states[player]
	return s ~= nil and s.Active ~= nil
end

local function tutorial(player: Player, event: string, amount: number?)
	local t = registry.TutorialService
	if t then
		t.Event(player, event, amount)
	end
end

local function sendCharge(player: Player, charging: boolean, startedAt: number, reason: string?)
	remotes.ChargeState:FireClient(player, { Charging = charging, StartedAt = startedAt, Reason = reason })
end

-- Can this player start a throw right now? Returns (ok, reason)
local function canThrow(player: Player, s: State): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Loading"
	end
	if s.Active then
		return false, "Flying"
	end
	if now() < s.CooldownUntil then
		return false, "Cooldown"
	end
	if not MapService.InThrowZone(player, profile.World) then
		return false, "NotInZone"
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, "Dead"
	end
	return true, nil
end

local function launch(player: Player, s: State, meter: number)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local world = Worlds.Get(profile.World) or Worlds.List[1]
	nextFlightId += 1
	local gliderId = if profile.Relic ~= "" then "relic:" .. profile.Relic else profile.Glider
	local plan = FlightSim.Build({
		Id = nextFlightId,
		UserId = player.UserId,
		World = world.Id,
		WorldScale = world.DistanceScale,
		Skill = profile.Skill,
		Launch = meter,
		Seed = seedRng:NextInteger(1, 2 ^ 30),
		Glider = gliderId,
		Trail = if profile.Trail ~= "" then profile.Trail else nil,
		Start = now(),
		SpecialLuck = if registry.EventService then registry.EventService.SpecialLuck() else 1,
	})
	s.Charging = false
	s.Active = {
		Plan = plan,
		WorldScale = world.DistanceScale,
		SkillPerRing = Progression.SkillPerRing(profile),
		Multiplier = StatService.SkillMultiplier(player),
		Rings = {},
		NextPay = 1,
		TotalSkill = 0,
		Perfects = 0,
		Taps = 0,
	}
	sendCharge(player, false, 0, "Launched")
	remotes.FlightStarted:FireAllClients(FlightSim.Serialize(plan))
	if plan.Special then
		local special = FlightSim.SpecialInfo(plan.Special)
		local notify = registry.NotifyService
		if notify and special then
			notify.All(string.format("%s triggered a %s throw!", player.DisplayName, special.Name), "Rare")
		end
	end
	tutorial(player, "Throw")
end

local function onCharge(player: Player)
	local s = stateOf(player)
	local ok, reason = canThrow(player, s)
	if not ok then
		sendCharge(player, false, 0, reason)
		return
	end
	if s.Charging then
		return
	end
	s.Charging = true
	s.ChargeStart = now()
	sendCharge(player, true, s.ChargeStart, nil)
end

local function onRelease(player: Player)
	local s = stateOf(player)
	local ok, reason = canThrow(player, s)
	if not ok then
		s.Charging = false
		sendCharge(player, false, 0, reason)
		return
	end
	-- a very short hold is a quick tap: it gets the designed tap value, not a near-zero meter
	local held = if s.Charging then now() - s.ChargeStart else 0
	local meter = if s.Charging and held >= Flight.TapThreshold then FlightSim.MeterAt(held) else Flight.TapLaunchMeter
	launch(player, s, meter)
end

local function onGust(player: Player, flightId: any, ringIndex: any)
	if not (Validate.Integer(flightId, 1, 1e12) and Validate.Integer(ringIndex, 1, Flight.RingMax)) then
		return
	end
	local s = states[player]
	local active = s and s.Active
	if not active or active.Plan.Id ~= flightId then
		return
	end
	if active.Rings[ringIndex] ~= nil or ringIndex < active.NextPay then
		return -- already decided or already paid
	end
	active.Taps += 1
	if active.Taps > ringIndex + Flight.GustTapSlack then
		active.Rings[ringIndex] = "Miss" -- spam: more taps than rings
		return
	end
	local t = now() - active.Plan.Start
	local ping = 0
	pcall(function()
		ping = player:GetNetworkPing()
	end)
	local verdict = FlightSim.JudgeGust(active.Plan, ringIndex, t, ping)
	if verdict then
		active.Rings[ringIndex] = verdict
	end
end

local function land(player: Player, s: State, active: Active)
	s.Active = nil
	s.CooldownUntil = now() + Flight.LandCooldown
	s.AutoNextAt = now() + Flight.AutoThrowDelay
	local plan = active.Plan
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local zone = Zones.At(plan.World, plan.Distance)
	local winsMultiplier = StatService.WinsMultiplier(player)
	local wins = zone.Wins * winsMultiplier
	local worldKey = tostring(plan.World)
	local lastZone = Zones.Last(plan.World)
	local nextWorld = Worlds.Get(plan.World + 1)
	local unlockedWorld: Worlds.World? = nil
	local gatedWorld: Worlds.World? = nil
	local newBest = false
	local newZone = false
	DataService.Update(player, function(p)
		p.Stats.Throws += 1
		p.Stats.Rings += #plan.Rings
		p.Stats.Perfects += active.Perfects
		if plan.Distance > (p.Best[worldKey] or 0) then
			p.Best[worldKey] = plan.Distance
			newBest = true
		end
		if plan.Distance > p.Stats.BestDistance then
			p.Stats.BestDistance = plan.Distance
		end
		if not p.Zones[zone.Id] then
			p.Zones[zone.Id] = true
			newZone = true
		end
		-- reaching the end of the river opens the next world (once the rebirth gate is met too;
		-- otherwise the portal opens it later)
		if lastZone and zone.Id == lastZone.Id and nextWorld and not p.Worlds[tostring(nextWorld.Id)] then
			if p.Rebirths >= nextWorld.UnlockRebirths then
				p.Worlds[tostring(nextWorld.Id)] = true
				unlockedWorld = nextWorld
			else
				gatedWorld = nextWorld
			end
		end
		return true
	end)
	StatService.AddWins(player, wins, "Landing")

	local public = { Id = plan.Id, UserId = plan.UserId, World = plan.World, Distance = plan.Distance, Zone = zone.Id }
	local private = {
		Id = plan.Id,
		UserId = plan.UserId,
		World = plan.World,
		Distance = plan.Distance,
		Zone = zone.Id,
		Wins = wins,
		Skill = active.TotalSkill,
		Special = plan.Special,
		UnlockedWorld = if unlockedWorld then unlockedWorld.Id else nil,
		Perfects = active.Perfects,
		Rings = #plan.Rings,
		NewBest = newBest,
		NewZone = newZone,
		Owner = true,
	}
	for _, other in Players:GetPlayers() do
		remotes.FlightLanded:FireClient(other, if other == player then private else public)
	end
	local notify = registry.NotifyService
	if notify then
		if unlockedWorld then
			notify.All(string.format("%s reached the end of the river and unlocked %s!", player.DisplayName, unlockedWorld.Name), "Rare")
		elseif gatedWorld then
			notify.Toast(player, string.format("End of the river! Reach %d rebirths to open %s.", gatedWorld.UnlockRebirths, gatedWorld.Name), "Info")
		elseif newZone then
			notify.Toast(player, "New zone discovered: " .. zone.Name .. "!", "Success")
		end
	end
	local _ = Format
end

local function payRing(player: Player, active: Active, index: number)
	local perfect = active.Rings[index] == "Perfect"
	local amount = active.SkillPerRing * active.Multiplier * (if perfect then Flight.PerfectMultiplier else 1)
	if perfect then
		active.Perfects += 1
	end
	local added = StatService.AddSkill(player, amount, "Ring")
	active.TotalSkill += added
	remotes.FlightRing:FireClient(player, { Id = active.Plan.Id, Index = index, Perfect = perfect, Amount = added })
	tutorial(player, "Ring")
end

local function step()
	local t0 = now()
	-- every player gets a state (Auto Throw must work before their first manual throw)
	for _, player in Players:GetPlayers() do
		if states[player] == nil and DataService.Get(player) ~= nil then
			stateOf(player)
		end
	end
	for player, s in states do
		if player.Parent == nil then
			continue
		end
		local active = s.Active
		if active then
			local t = t0 - active.Plan.Start
			while active.NextPay <= #active.Plan.RingTimes and t >= FlightSim.RingSettleTime(active.Plan, active.NextPay) do
				payRing(player, active, active.NextPay)
				active.NextPay += 1
			end
			if t >= active.Plan.Duration and active.NextPay > #active.Plan.RingTimes then
				land(player, s, active)
			end
		elseif s.Charging then
			if t0 - s.ChargeStart >= Flight.MeterMaxHold then
				onRelease(player)
			end
		else
			local profile = DataService.Get(player)
			if profile and profile.Settings.AutoThrow and t0 >= s.AutoNextAt and t0 >= s.CooldownUntil then
				local passes = registry.MonetizationService
				if passes and passes.HasPass(player, "AutoThrow") then
					local ok = canThrow(player, s)
					if ok then
						launch(player, s, Flight.AutoLaunchMeter)
					else
						s.AutoNextAt = t0 + 0.5
					end
				end
			end
		end
	end
end

-- Cancels a flight without rewards (player teleported / reset).
function FlightService.Cancel(player: Player)
	local s = states[player]
	if s then
		s.Charging = false
		if s.Active then
			local id = s.Active.Plan.Id
			s.Active = nil
			remotes.FlightLanded:FireAllClients({ Id = id, UserId = player.UserId, Cancelled = true })
		end
	end
end

function FlightService.Init(reg: { [string]: any })
	registry = reg
	remotes.FlightStarted = Remotes.Event("FlightStarted")
	remotes.FlightRing = Remotes.Event("FlightRing")
	remotes.FlightLanded = Remotes.Event("FlightLanded")
	remotes.ChargeState = Remotes.Event("ChargeState")
end

function FlightService.Start()
	Guard.OnEvent(Remotes.Event("RequestThrowCharge"), 4, 6, onCharge)
	Guard.OnEvent(Remotes.Event("RequestThrow"), 4, 6, onRelease)
	Guard.OnEvent(Remotes.Event("RequestGust"), 8, 10, onGust)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	RunService.Heartbeat:Connect(step)
end

-- Exposed for diagnostics.
function FlightService.ActiveCount(): number
	local n = 0
	for _, s in states do
		if s.Active then
			n += 1
		end
	end
	return n
end

return FlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- leaderstats (player list) and global top-10 boards on the hub walls.
-- Huge numbers are stored in OrderedDataStores as floor(log10(x + 1) * 1e5) so any value fits
-- an integer key; boards decode them back for display.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Map = require(Shared.Config.Map)
local Remotes = require(Shared.Net.Remotes)
local Format = require(Shared.Util.Format)

local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)

local LeaderboardService = {}

local STATS = { "Wins", "BestDistance", "Rebirths" }
local TITLES = { Wins = "TOP WINS", BestDistance = "LONGEST GLIDE", Rebirths = "MOST REBIRTHS" }
local LOG_SCALE = 1e5

local stores: { [string]: any } = {}
local boards: { [string]: { { Name: string, Value: number } } } = {}
local serverInfo: RemoteEvent

local function encode(stat: string, value: number): number
	if stat == "Rebirths" then
		return math.floor(value)
	end
	return math.floor(math.log10(math.max(0, value) + 1) * LOG_SCALE)
end

local function decode(stat: string, value: number): number
	if stat == "Rebirths" then
		return value
	end
	return 10 ^ (value / LOG_SCALE) - 1
end

local function display(stat: string, value: number): string
	if stat == "BestDistance" then
		return Format.Meters(value)
	end
	return Format.Short(value)
end

local function statValue(profile: DataService.Profile, stat: string): number
	if stat == "Wins" then
		return profile.Stats.TotalWins
	elseif stat == "BestDistance" then
		return profile.Stats.BestDistance
	end
	return profile.Rebirths
end

local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local skill = Instance.new("StringValue")
	skill.Name = "Skill"
	skill.Value = "0"
	skill.Parent = folder
	local wins = Instance.new("StringValue")
	wins.Name = "Wins"
	wins.Value = "0"
	wins.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	folder.Parent = player
end

local function updateLeaderstats(player: Player, profile: DataService.Profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local skill = folder:FindFirstChild("Skill") :: StringValue?
	local wins = folder:FindFirstChild("Wins") :: StringValue?
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue?
	if skill then
		skill.Value = Format.Short(profile.Skill)
	end
	if wins then
		wins.Value = Format.Short(profile.Wins)
	end
	if rebirths then
		rebirths.Value = profile.Rebirths
	end
end

local function renderBoards()
	local folder = MapService.Folder
	if not folder then
		return
	end
	for _, stat in STATS do
		local rows: { { Name: string, Value: number } } = boards[stat] or {}
		for _, part in folder:GetDescendants() do
			if part.Name == "Board_" .. stat then
				local gui = part:FindFirstChild("Board")
				local list = gui and gui:FindFirstChild("List")
				local title = gui and gui:FindFirstChild("Title")
				if title and title:IsA("TextLabel") then
					title.Text = TITLES[stat]
				end
				if list then
					for _, child in list:GetChildren() do
						if child:IsA("TextLabel") then
							child:Destroy()
						end
					end
					for i, row in rows do
						local label = Instance.new("TextLabel")
						label.Name = "Row" .. i
						label.LayoutOrder = i
						label.BackgroundTransparency = 1
						label.Size = UDim2.new(1, 0, 0.09, 0)
						label.TextScaled = true
						label.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
						label.TextColor3 = if i == 1 then Color3.fromHex("#FFD447") elseif i == 2 then Color3.fromHex("#E3E9F2") elseif i == 3 then Color3.fromHex("#FFB07A") else Color3.new(1, 1, 1)
						label.Text = string.format("#%d  %s  -  %s", i, row.Name, display(stat, row.Value))
						local stroke = Instance.new("UIStroke")
						stroke.Thickness = 2
						stroke.Parent = label
						label.Parent = list
					end
				end
			end
		end
	end
	serverInfo:FireAllClients({ Kind = "Leaderboards", Boards = boards })
end

local nameCache: { [number]: string } = {}

local function namesFor(userIds: { number }): { [number]: string }
	local out = {}
	for _, id in userIds do
		local player = Players:GetPlayerByUserId(id)
		if player then
			out[id] = player.DisplayName
		elseif nameCache[id] then
			out[id] = nameCache[id]
		else
			local ok, name = pcall(function()
				return Players:GetNameFromUserIdAsync(id)
			end)
			out[id] = if ok and name then name else ("Player " .. id)
			if ok and name then
				nameCache[id] = name
			end
		end
	end
	return out
end

local function refresh()
	for _, stat in STATS do
		local store = stores[stat]
		if store then
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				if profile then
					local value = encode(stat, statValue(profile, stat))
					if value > 0 then
						pcall(function()
							store:SetAsync(tostring(player.UserId), value)
						end)
					end
				end
			end
			local ok, pages = pcall(function()
				return store:GetSortedAsync(false, 10)
			end)
			if ok and pages then
				local entries = pages:GetCurrentPage()
				local ids = {}
				for _, e in entries do
					table.insert(ids, tonumber(e.key) or 0)
				end
				local names = namesFor(ids)
				local rows = {}
				for _, e in entries do
					table.insert(rows, { Name = names[tonumber(e.key) or 0] or "?", Value = decode(stat, e.value) })
				end
				boards[stat] = rows
			end
		else
			-- no DataStore access (Studio without API): show this server's players
			local rows = {}
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				if profile then
					table.insert(rows, { Name = player.DisplayName, Value = statValue(profile, stat) })
				end
			end
			table.sort(rows, function(a, b)
				return a.Value > b.Value
			end)
			while #rows > 10 do
				table.remove(rows)
			end
			boards[stat] = rows
		end
	end
	renderBoards()
end

function LeaderboardService.Init()
	serverInfo = Remotes.Event("ServerInfo")
	for _, stat in STATS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("SkyGlide_LB_" .. stat .. "_v1")
		end)
		if ok and store then
			local probe = pcall(function()
				store:GetSortedAsync(false, 1)
			end)
			if probe then
				stores[stat] = store
			end
		end
	end
	local _ = Map
end

function LeaderboardService.Start()
	Players.PlayerAdded:Connect(setupLeaderstats)
	for _, player in Players:GetPlayers() do
		if not player:FindFirstChild("leaderstats") then
			setupLeaderstats(player)
		end
	end
	DataService.Changed:Connect(function(player, profile)
		updateLeaderstats(player, profile)
	end)
	DataService.Loaded:Connect(function(player, profile)
		updateLeaderstats(player, profile)
	end)
	task.spawn(function()
		task.wait(8)
		while true do
			refresh()
			task.wait(120)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
-- Builds every world (World/MapBuilder) and answers spatial questions for other services from
-- the shared layout in Config/Map: "which pad is this player standing on?", "is the player in
-- the Throw Zone?", "where is the tutorial target?". Positions are derived from config, never
-- from anything a client sends.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Map = require(Shared.Config.Map)
local Worlds = require(Shared.Definitions.Worlds)
local Training = require(Shared.Definitions.Training)

local Server = script.Parent.Parent
local MapBuilder = require(Server.World.MapBuilder)

local MapService = {}

MapService.Folder = nil :: Folder?
MapService.Built = false

local function rootPosition(player: Player): Vector3?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end
MapService.RootPosition = rootPosition

local function worldOf(position: Vector3): number?
	local index = math.floor(position.X / Map.WorldSpacing + 0.5) + 1
	if Worlds.Get(index) then
		return index
	end
	return nil
end

-- World area the player is physically in (nil while dead/loading).
function MapService.WorldAt(player: Player): number?
	local pos = rootPosition(player)
	return if pos then worldOf(pos) else nil
end

local function local_(worldId: number, pos: Vector3): Vector3
	return pos - Map.Origin(worldId)
end

-- Training pad under the player (in the given world), or nil.
function MapService.PadAt(player: Player, worldId: number): Training.Pad?
	local pos = rootPosition(player)
	if not pos then
		return nil
	end
	local l = local_(worldId, pos)
	local half = Map.PadSize / 2 + Vector3.new(Map.StandTolerance, 0, Map.StandTolerance)
	for _, pad in Training.ForWorld(worldId) do
		local c = Map.PadPosition(pad.Slot)
		if math.abs(l.X - c.X) <= half.X and math.abs(l.Z - c.Z) <= half.Z and l.Y > c.Y - 2 and l.Y < c.Y + 12 then
			return pad
		end
	end
	return nil
end

function MapService.InThrowZone(player: Player, worldId: number): boolean
	local pos = rootPosition(player)
	if not pos then
		return false
	end
	local l = local_(worldId, pos)
	local z = Map.ThrowZone
	local tol = Map.StandTolerance
	return l.X >= z.MinX - tol and l.X <= z.MaxX + tol and l.Z >= z.MinZ - tol and l.Z <= z.MaxZ + tol and l.Y > -4 and l.Y < 16
end

function MapService.SpawnCFrame(worldId: number): CFrame
	local p = Map.Origin(worldId) + Map.Spawn
	return CFrame.lookAt(p, p + Vector3.new(0, 0, -1))
end

function MapService.Anchor(worldId: number, name: string): Vector3?
	local o = Map.Origin(worldId)
	if name == "Pad1" then
		return o + Map.PadPosition(1)
	elseif name == "ThrowZone" then
		return o + Vector3.new(0, 0, (Map.ThrowZone.MinZ + Map.ThrowZone.MaxZ) / 2)
	elseif name == "GliderShop" then
		return o + Map.PedestalPosition(2)
	elseif name == "Egg1" then
		return o + Map.EggPosition(1)
	end
	return nil
end

-- Near a world-space point? (used for pedestal / egg / portal prompts as a second check)
function MapService.Near(player: Player, point: Vector3, radius: number): boolean
	local pos = rootPosition(player)
	return pos ~= nil and (pos - point).Magnitude <= radius
end

function MapService.WorldModel(worldId: number): Instance?
	local folder = MapService.Folder
	return if folder then folder:FindFirstChild("World_" .. worldId) else nil
end

function MapService.Init()
	local folder = Instance.new("Folder")
	folder.Name = "Worlds"
	folder.Parent = Workspace
	MapService.Folder = folder
	for _, world in Worlds.List do
		local ok, err = pcall(MapBuilder.Build, world, folder)
		if not ok then
			warn(string.format("[MapService] building %s failed: %s", world.Name, tostring(err)))
		end
	end
	MapService.Built = true
end

function MapService.Start()
	-- nothing at runtime; prompts are wired by the services that own them
	local _ = Players
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes, developer products and the limited relic stock.
--
-- * Pass ownership is checked with UserOwnsGamePassAsync on join and updated on purchase.
-- * Products are granted exactly once per receipt (profile receipt log) and only confirmed to
--   Roblox after the profile saved successfully (ProcessReceipt contract).
-- * Ids left at 0 in Config/Monetization are "not configured": Studio grants them for free so
--   every flow can be tested; live servers refuse them (the client shows them as unavailable).
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Relics = require(Shared.Definitions.Relics)
local Worlds = require(Shared.Definitions.Worlds)
local Boosts = require(Shared.Definitions.Boosts)
local Economy = require(Shared.Config.Economy)
local Remotes = require(Shared.Net.Remotes)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)

local MonetizationService = {}

local IS_STUDIO = RunService:IsStudio()

local registry: { [string]: any } = {}
local owned: { [Player]: { [string]: boolean } } = {}
local productById: { [number]: Monetization.Product } = {}
local passById: { [number]: Monetization.Pass } = {}

-- Relic stock (global). sold[id] = units sold across all servers (cached, refreshed periodically).
local relicSold: { [string]: number } = {}
local globalStore: any = nil
local mockGlobal: { [string]: number } = {}

local serverInfo: RemoteEvent

local function bumpGlobal(key: string, delta: number): number?
	if globalStore then
		local ok, result = pcall(function()
			return globalStore:UpdateAsync(key, function(old: any)
				return (if type(old) == "number" then old else 0) + delta
			end)
		end)
		if ok and type(result) == "number" then
			return result
		end
		warn("[Monetization] global counter update failed: " .. tostring(result))
		return nil
	end
	mockGlobal[key] = (mockGlobal[key] or 0) + delta
	return mockGlobal[key]
end

local function readGlobal(key: string): number?
	if globalStore then
		local ok, result = pcall(function()
			return globalStore:GetAsync(key)
		end)
		if ok then
			return if type(result) == "number" then result else 0
		end
		return nil
	end
	return mockGlobal[key] or 0
end

local function broadcastRelics(target: Player?)
	local payload = { Kind = "Relics", Relics = {} :: { [string]: any } }
	for _, relic in Relics.List do
		payload.Relics[relic.Id] = { Sold = relicSold[relic.Id] or 0, Stock = relic.Stock }
	end
	if target then
		serverInfo:FireClient(target, payload)
	else
		serverInfo:FireAllClients(payload)
	end
end

local function refreshRelicStock()
	for _, relic in Relics.List do
		local v = readGlobal("RelicSold_" .. relic.Id)
		if v then
			relicSold[relic.Id] = v
		end
	end
	broadcastRelics(nil)
end

function MonetizationService.RelicRemaining(id: string): number
	local relic = Relics.Get(id)
	if not relic then
		return 0
	end
	return math.max(0, relic.Stock - (relicSold[id] or 0))
end

-- Pass ownership map for multipliers and feature gates.
function MonetizationService.Passes(player: Player): { [string]: boolean }
	local out = table.clone(owned[player] or {})
	if IS_STUDIO then
		local profile = DataService.Get(player)
		if profile then
			for key in profile.TestPasses do
				out[key] = true
			end
		end
	end
	return out
end

function MonetizationService.HasPass(player: Player, key: string): boolean
	return MonetizationService.Passes(player)[key] == true
end

local function onPassGranted(player: Player, pass: Monetization.Pass)
	local notify = registry.NotifyService
	if notify then
		notify.Toast(player, pass.Name .. " unlocked!", "Success")
	end
	DataService.MarkChanged(player)
	local character = registry.CharacterService
	if character then
		character.Refresh(player)
	end
end

local function grantProduct(player: Player, product: Monetization.Product, robux: number): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	local notify = registry.NotifyService
	if product.Kind == "Skill" then
		local world = Worlds.Get(profile.World)
		local amount = (product.Amount or 0) * (if world then world.SkillPackScale else 1)
		registry.StatService.AddSkill(player, amount, "Product")
		if notify then
			notify.Toast(player, "+" .. Format.Short(amount) .. " Skill!", "Success")
		end
	elseif product.Kind == "StarterPack" then
		local pack = Monetization.StarterPack
		DataService.Update(player, function(p)
			p.Flags.StarterPack = true
			for id, n in pack.Potions do
				p.Potions[id] = math.min(Economy.Limits.MaxPotions, (p.Potions[id] or 0) + n)
			end
			return true
		end)
		registry.StatService.AddWins(player, pack.Wins, "Product")
		registry.PetService.GivePet(player, pack.Pet, "Starter Pack")
	elseif product.Kind == "Relic" then
		local relicId = product.Ref or ""
		local relic = Relics.Get(relicId)
		if not relic then
			return false
		end
		local isNew = not profile.Relics[relicId]
		DataService.Update(player, function(p)
			p.Relics[relicId] = true
			p.Relic = relicId
			return true
		end)
		if isNew then
			-- count every paid sale even if the DataStore is briefly unavailable
			task.spawn(function()
				for attempt = 1, 6 do
					local sold = bumpGlobal("RelicSold_" .. relicId, 1)
					if sold then
						relicSold[relicId] = sold
						broadcastRelics(nil)
						return
					end
					task.wait(2 ^ attempt)
				end
				warn("[Monetization] could not record a relic sale for " .. relicId)
			end)
		end
		if notify then
			notify.Toast(player, relic.Name .. " equipped! Always 125% better.", "Rare")
		end
		local character = registry.CharacterService
		if character then
			character.Refresh(player)
		end
	elseif product.Kind == "Egg" then
		registry.PetService.HatchFree(player, product.Ref or "", 1)
	elseif product.Kind == "Potion" then
		local id = product.Ref or ""
		if not Boosts.Exists(id) then
			return false
		end
		DataService.Update(player, function(p)
			p.Potions[id] = math.min(Economy.Limits.MaxPotions, (p.Potions[id] or 0) + (product.Amount or 1))
			return true
		end)
		if notify then
			notify.Toast(player, "Potions added to your inventory!", "Success")
		end
	else
		return false
	end
	if robux > 0 then
		DataService.Update(player, function(p)
			p.Stats.RobuxSpent += robux
			return true
		end)
	end
	return true
end

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local product = productById[receipt.ProductId]
	if product == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.WaitFor(player, 15)
	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(profile.Receipts, purchaseId) == nil then
		local ok = grantProduct(player, product, receipt.CurrencySpent or product.Robux)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		DataService.Update(player, function(p)
			table.insert(p.Receipts, purchaseId)
			while #p.Receipts > 100 do
				table.remove(p.Receipts, 1)
			end
			return true
		end)
	end
	if not DataService.SaveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function requestPurchase(player: Player, kind: any, key: any): { [string]: any }
	if type(key) ~= "string" or #key > 32 then
		return { ok = false, error = "Unknown item." }
	end
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if kind == "Pass" then
		local pass = Monetization.Pass(key)
		if not pass then
			return { ok = false, error = "Unknown pass." }
		end
		if MonetizationService.HasPass(player, key) then
			return { ok = false, error = "You already own this!" }
		end
		if pass.Id == 0 then
			if IS_STUDIO then
				DataService.Update(player, function(p)
					p.TestPasses[key] = true
					return true
				end)
				onPassGranted(player, pass)
				return { ok = true, message = "Studio test: " .. pass.Name .. " granted" }
			end
			return { ok = false, error = "This pass is not available yet." }
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		return { ok = true, prompted = true }
	elseif kind == "Product" then
		local product = Monetization.Product(key)
		if not product then
			return { ok = false, error = "Unknown product." }
		end
		if product.Kind == "StarterPack" and profile.Flags.StarterPack then
			return { ok = false, error = "You already bought the Starter Pack!" }
		end
		if product.Kind == "Relic" then
			local relicId = product.Ref or ""
			if profile.Relics[relicId] then
				return { ok = false, error = "You already own this relic!" }
			end
			-- refresh the global count right before prompting (other servers sell too)
			local fresh = readGlobal("RelicSold_" .. relicId)
			if fresh then
				relicSold[relicId] = math.max(relicSold[relicId] or 0, fresh)
			end
			if MonetizationService.RelicRemaining(relicId) <= 0 then
				return { ok = false, error = "Sold out!" }
			end
		end
		if product.Id == 0 then
			if IS_STUDIO then
				local ok = grantProduct(player, product, 0)
				return if ok then { ok = true, message = "Studio test grant: " .. product.Name } else { ok = false, error = "Could not grant." }
			end
			return { ok = false, error = "This item is not available yet." }
		end
		MarketplaceService:PromptProductPurchase(player, product.Id)
		return { ok = true, prompted = true }
	end
	return { ok = false, error = "Unknown purchase type." }
end

local function loadOwnership(player: Player)
	local map = owned[player] or {}
	owned[player] = map
	for _, pass in Monetization.Passes do
		if pass.Id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				map[pass.Key] = true
			end
		end
	end
	DataService.MarkDirty(player)
end

function MonetizationService.Init(reg: { [string]: any })
	registry = reg
	serverInfo = Remotes.Event("ServerInfo")
	for _, product in Monetization.Products do
		if product.Id ~= 0 then
			productById[product.Id] = product
		end
	end
	for _, pass in Monetization.Passes do
		if pass.Id ~= 0 then
			passById[pass.Id] = pass
		end
	end
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore("SkyGlide_Global_v1")
	end)
	if ok and store then
		local probe = pcall(function()
			store:GetAsync("__probe")
		end)
		if probe then
			globalStore = store
		end
	end
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local pass = passById[passId]
		if pass and purchased then
			local map = owned[player] or {}
			owned[player] = map
			map[pass.Key] = true
			onPassGranted(player, pass)
		end
	end)
	Guard.OnInvoke(Remotes.Function("RequestPurchase"), 2, 4, requestPurchase)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(loadOwnership, player)
		task.delay(3, broadcastRelics, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(loadOwnership, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)
	task.spawn(function()
		while true do
			refreshRelicStock()
			task.wait(60)
		end
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">NotifyService</string>
            <string name="Source"><![CDATA[--!strict
-- Toasts to one player or everyone. Kinds: Info | Success | Error | Level | Rare
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Net.Remotes)

local NotifyService = {}

local remote: RemoteEvent

function NotifyService.Toast(player: Player, text: string, kind: string?)
	if remote and player.Parent then
		remote:FireClient(player, { Text = text, Kind = kind or "Info" })
	end
end

function NotifyService.All(text: string, kind: string?)
	if remote then
		remote:FireAllClients({ Text = text, Kind = kind or "Info" })
	end
end

function NotifyService.Init()
	remote = Remotes.Event("Notify")
end

return NotifyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!strict
-- Eggs and pets. Hatches are rolled on the server (weighted, Luck boosts Rare+ tiers).
-- Equipped pet ids are mirrored to a player attribute so every client can draw followers.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Map = require(Shared.Config.Map)
local Rarity = require(Shared.Config.Rarity)
local Pets = require(Shared.Definitions.Pets)
local Eggs = require(Shared.Definitions.Eggs)
local Progression = require(Shared.Sim.Progression)
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)
local MapService = require(script.Parent.MapService)

local PetService = {}

local registry: { [string]: any } = {}
local hatchResult: RemoteEvent
local rng = Random.new()

local EGG_REACH = 30

local function petCount(p: DataService.Profile): number
	local n = 0
	for _ in p.Pets do
		n += 1
	end
	return n
end

local function slots(player: Player): number
	return Progression.PetSlots(StatService.Context(player))
end

local function mirror(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local ids = {}
	for _, uid in profile.EquippedPets do
		local pet = profile.Pets[uid]
		if pet then
			table.insert(ids, pet.Id)
		end
	end
	player:SetAttribute("Pets", table.concat(ids, ","))
end
PetService.Mirror = mirror

local function score(id: string): number
	local def = Pets.Get(id)
	return if def then def.SkillBoost * 1000 + def.WinsBoost else 0
end

-- Adds a pet, auto-equipping it when a slot is free or it beats the weakest equipped pet, and
-- records it in the Index. Returns the new uid and whether this species is new to the Index.
local function addPet(player: Player, petId: string): (string?, boolean)
	local maxSlots = slots(player)
	local discovered = false
	local uid = DataService.Update(player, function(p)
		local id = tostring(p.NextPetId)
		p.NextPetId += 1
		p.Pets[id] = { Id = petId, Locked = false }
		discovered = not p.Index[petId]
		p.Index[petId] = true
		if #p.EquippedPets < maxSlots then
			table.insert(p.EquippedPets, id)
		else
			local weakestIndex, weakestScore = 0, math.huge
			for i, eq in p.EquippedPets do
				local owned = p.Pets[eq]
				local s = if owned then score(owned.Id) else -1
				if s < weakestScore then
					weakestIndex, weakestScore = i, s
				end
			end
			if weakestIndex > 0 and score(petId) > weakestScore then
				p.EquippedPets[weakestIndex] = id
			end
		end
		return id
	end)
	return uid, uid ~= nil and discovered
end

local function roll(egg: Eggs.Egg, luck: number): string
	local odds = Eggs.Odds(egg, luck)
	local r = rng:NextNumber()
	for _, entry in odds do
		r -= entry.Chance
		if r <= 0 then
			return entry.Pet
		end
	end
	return odds[#odds].Pet
end

local function announce(player: Player, petId: string)
	local def = Pets.Get(petId)
	if def and Rarity.Order(def.Rarity) >= Rarity.Order("Legendary") then
		local notify = registry.NotifyService
		if notify then
			notify.All(string.format("%s hatched a %s %s!", player.DisplayName, def.Rarity, def.Name), "Rare")
		end
	end
end

local function hatch(player: Player, egg: Eggs.Egg, count: number): { { Uid: string, Id: string, New: boolean } }
	local luck = StatService.Luck(player)
	local results = {}
	for _ = 1, count do
		local petId = roll(egg, luck)
		local uid, isNew = addPet(player, petId)
		if uid then
			table.insert(results, { Uid = uid, Id = petId, New = isNew })
			announce(player, petId)
		end
	end
	DataService.Update(player, function(p)
		p.Stats.Hatches += #results
		return true
	end)
	mirror(player)
	hatchResult:FireClient(player, { Egg = egg.Id, Pets = results })
	local tutorial = registry.TutorialService
	if tutorial then
		tutorial.Event(player, "Hatch")
	end
	return results
end

-- Robux egg / rewards: hatch without paying Wins (inventory cap is not enforced on paid hatches).
function PetService.HatchFree(player: Player, eggId: string, count: number)
	local egg = Eggs.Get(eggId)
	if egg then
		hatch(player, egg, math.clamp(count, 1, 3))
	end
end

function PetService.GivePet(player: Player, petId: string, source: string)
	if not Pets.Exists(petId) then
		return
	end
	local _, isNew = addPet(player, petId)
	mirror(player)
	local def = Pets.Get(petId) :: Pets.Pet
	local notify = registry.NotifyService
	if notify then
		notify.Toast(player, string.format("%s: you got %s!", source, def.Name), "Success")
	end
	hatchResult:FireClient(player, { Egg = "", Pets = { { Uid = "", Id = petId, New = isNew } }, Source = source })
end

local function eggPosition(egg: Eggs.Egg, worldId: number): Vector3?
	for i, e in Eggs.ForWorld(worldId) do
		if e.Id == egg.Id then
			return Map.Origin(worldId) + Map.EggPosition(i)
		end
	end
	return nil
end

local function requestHatch(player: Player, eggId: any, count: any): { [string]: any }
	if not Eggs.Exists(eggId) or not Validate.Integer(count, 1, 3) then
		return { ok = false, error = "Unknown egg." }
	end
	local egg = Eggs.Get(eggId) :: Eggs.Egg
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if egg.ProductKey then
		return { ok = false, error = "This egg is bought with Robux.", product = egg.ProductKey }
	end
	if count == 3 then
		local monetization = registry.MonetizationService
		if not (monetization and monetization.HasPass(player, "TripleHatch")) then
			return { ok = false, error = "Triple Hatch needs the Triple Hatch pass!", pass = "TripleHatch" }
		end
	elseif count ~= 1 then
		return { ok = false, error = "Hatch 1 or 3." }
	end
	local worldId = egg.World or profile.World
	if not profile.Worlds[tostring(worldId)] or profile.World ~= worldId then
		return { ok = false, error = "Go to this egg's world first!" }
	end
	local pos = eggPosition(egg, worldId)
	if not pos or not MapService.Near(player, pos, EGG_REACH) then
		return { ok = false, error = "Walk up to the egg to hatch it." }
	end
	if petCount(profile) + count > Economy.PetInventory then
		return { ok = false, error = "Your pet inventory is full! Delete some pets." }
	end
	local cost = egg.Price * count
	if not StatService.SpendWins(player, cost) then
		return { ok = false, error = string.format("You need %s Wins!", Format.Short(cost)) }
	end
	local results = hatch(player, egg, count)
	return { ok = true, pets = results }
end

local function petAction(player: Player, action: any, arg: any): { [string]: any }
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	local maxSlots = slots(player)
	if action == "Equip" then
		if type(arg) ~= "string" or not profile.Pets[arg] then
			return { ok = false, error = "Unknown pet." }
		end
		if table.find(profile.EquippedPets, arg) then
			return { ok = true }
		end
		if #profile.EquippedPets >= maxSlots then
			return { ok = false, error = string.format("All %d slots are full!", maxSlots) }
		end
		DataService.Update(player, function(p)
			table.insert(p.EquippedPets, arg)
			return true
		end)
	elseif action == "Unequip" then
		if type(arg) ~= "string" then
			return { ok = false, error = "Unknown pet." }
		end
		DataService.Update(player, function(p)
			local i = table.find(p.EquippedPets, arg)
			if i then
				table.remove(p.EquippedPets, i)
			end
			return true
		end)
	elseif action == "EquipBest" then
		DataService.Update(player, function(p)
			local uids = {}
			for uid in p.Pets do
				table.insert(uids, uid)
			end
			table.sort(uids, function(a, b)
				local sa, sb = score(p.Pets[a].Id), score(p.Pets[b].Id)
				if sa == sb then
					return a < b
				end
				return sa > sb
			end)
			p.EquippedPets = {}
			for i = 1, math.min(maxSlots, #uids) do
				table.insert(p.EquippedPets, uids[i])
			end
			return true
		end)
	elseif action == "UnequipAll" then
		DataService.Update(player, function(p)
			p.EquippedPets = {}
			return true
		end)
	elseif action == "Lock" or action == "Unlock" then
		if type(arg) ~= "string" or not profile.Pets[arg] then
			return { ok = false, error = "Unknown pet." }
		end
		DataService.Update(player, function(p)
			p.Pets[arg].Locked = action == "Lock"
			return true
		end)
	elseif action == "Delete" then
		if type(arg) ~= "table" or #arg == 0 or #arg > Economy.PetInventory + 20 then
			return { ok = false, error = "Pick pets to delete." }
		end
		local deleted = 0
		DataService.Update(player, function(p)
			for _, uid in arg do
				if type(uid) == "string" and p.Pets[uid] and not p.Pets[uid].Locked then
					p.Pets[uid] = nil
					local i = table.find(p.EquippedPets, uid)
					if i then
						table.remove(p.EquippedPets, i)
					end
					deleted += 1
				end
			end
			return true
		end)
		mirror(player)
		return { ok = true, message = string.format("Deleted %d pet%s.", deleted, if deleted == 1 then "" else "s") }
	else
		return { ok = false, error = "Unknown action." }
	end
	mirror(player)
	return { ok = true }
end

function PetService.Init(reg: { [string]: any })
	registry = reg
	hatchResult = Remotes.Event("HatchResult")
	DataService.Loaded:Connect(function(player)
		-- No trimming here: pass ownership may still be loading. Extra equips beyond the current
		-- slot count simply don't count (Progression.PetBoosts) until slots come back.
		mirror(player)
	end)
end

function PetService.Start()
	Guard.OnInvoke(Remotes.Function("RequestHatchEgg"), 2, 4, requestHatch)
	Guard.OnInvoke(Remotes.Function("RequestPetAction"), 5, 10, petAction)
	local _ = Players
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!strict
-- Rebirth: available at the level cap. Resets Skill, Level and XP; keeps Wins, gliders, pets,
-- trails and worlds; raises the permanent Skill multiplier and the level cap.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Progression = require(Shared.Sim.Progression)
local Remotes = require(Shared.Net.Remotes)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)

local RebirthService = {}

local registry: { [string]: any } = {}

local function requestRebirth(player: Player): { [string]: any }
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if registry.FlightService and registry.FlightService.IsFlying(player) then
		return { ok = false, error = "Wait until your glider lands." }
	end
	if not Progression.CanRebirth(profile) then
		return { ok = false, error = string.format("Reach level %d to rebirth!", Progression.LevelCap(profile)) }
	end
	local rebirths = DataService.Update(player, function(p)
		p.Rebirths += 1
		p.Skill = 0
		Progression.SyncLevel(p)
		return p.Rebirths
	end) or 0
	DataService.SaveNow(player)
	local notify = registry.NotifyService
	if notify then
		notify.Toast(player, string.format("REBIRTH %d! Skill multiplier x%d", rebirths, Economy.RebirthMultiplier(rebirths)), "Rare")
	end
	return { ok = true, rebirths = rebirths }
end

function RebirthService.Init(reg: { [string]: any })
	registry = reg
end

function RebirthService.Start()
	Guard.OnInvoke(Remotes.Function("RequestRebirth"), 1, 2, requestRebirth)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
-- Free rewards: playtime gifts (per session), the 7-day daily track, codes, and potion use.
-- Timers are measured on the server; the client only asks to claim.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Rewards = require(Shared.Definitions.Rewards)
local Boosts = require(Shared.Definitions.Boosts)
local Pets = require(Shared.Definitions.Pets)
local Training = require(Shared.Definitions.Training)
local Zones = require(Shared.Definitions.Zones)
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Codes = require(Server.Data.Codes)
local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)

local RewardService = {}

local registry: { [string]: any } = {}
local joinedAt: { [Player]: number } = {}
local claimed: { [Player]: { [number]: boolean } } = {}

local function today(): number
	return os.time() // 86400
end

-- Best pad multiplier this player can currently use in their world (for "Reps" rewards).
local function bestPad(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	local best = 1
	local training = registry.TrainingService
	for _, pad in Training.ForWorld(profile.World) do
		if pad.Multiplier > best and training and training.PadUnlocked(player, pad) then
			best = pad.Multiplier
		end
	end
	return best
end

local function winsScale(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	local zones = Zones.ForWorld(profile.World)
	return if zones[1] then zones[1].Wins else 1
end

-- Grants one reward entry. Returns a short human-readable description.
function RewardService.Grant(player: Player, reward: Rewards.Reward, source: string): string
	if reward.Kind == "Wins" then
		local amount = (reward.Amount or 0) * winsScale(player)
		StatService.AddWins(player, amount, source)
		return "+" .. Format.Short(amount) .. " Wins"
	elseif reward.Kind == "Skill" then
		local amount = StatService.RepsToSkill(player, reward.Reps or 0, bestPad(player))
		StatService.AddSkill(player, amount, source)
		return "+" .. Format.Short(amount) .. " Skill"
	elseif reward.Kind == "Potion" then
		local id = reward.Id or ""
		local def = Boosts.Get(id)
		if def then
			local count = reward.Count or 1
			DataService.Update(player, function(p)
				p.Potions[id] = math.min(Economy.Limits.MaxPotions, (p.Potions[id] or 0) + count)
				return true
			end)
			return string.format("%dx %s", count, def.Name)
		end
	elseif reward.Kind == "Pet" then
		local id = reward.Id or ""
		local def = Pets.Get(id)
		if def and registry.PetService then
			registry.PetService.GivePet(player, id, source)
			return def.Name
		end
	end
	return ""
end

local function claimGift(player: Player, index: any): { [string]: any }
	if not Validate.Integer(index, 1, #Rewards.Gifts) then
		return { ok = false, error = "Unknown gift." }
	end
	local start = joinedAt[player]
	if not start or not DataService.Get(player) then
		return { ok = false, error = "Still loading..." }
	end
	local gift = Rewards.Gifts[index]
	local set = claimed[player]
	if set[index] then
		return { ok = false, error = "Already claimed!" }
	end
	local remaining = gift.Minutes * 60 - (os.time() - start)
	if remaining > 0 then
		return { ok = false, error = "Ready in " .. Format.Duration(remaining) }
	end
	set[index] = true
	local text = RewardService.Grant(player, gift.Reward, "Gift")
	DataService.MarkDirty(player)
	return { ok = true, message = text }
end

local function claimDaily(player: Player): { [string]: any }
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	local day = today()
	if profile.Daily.Day >= day then
		return { ok = false, error = "Come back tomorrow!" }
	end
	local streak = if profile.Daily.Day == day - 1 then profile.Daily.Streak + 1 else 1
	DataService.Update(player, function(p)
		p.Daily.Day = day
		p.Daily.Streak = streak
		return true
	end)
	local reward = Rewards.Daily[(streak - 1) % #Rewards.Daily + 1]
	local text = RewardService.Grant(player, reward, "Daily reward")
	return { ok = true, message = string.format("Day %d: %s", streak, text) }
end

local function redeemCode(player: Player, raw: any): { [string]: any }
	if not Validate.String(raw, 32) then
		return { ok = false, error = "Invalid code." }
	end
	local code = string.upper((string.gsub(raw, "%s", "")))
	local def = Codes[code]
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if not def or (def.Expires > 0 and os.time() > def.Expires) then
		return { ok = false, error = "That code is invalid or expired." }
	end
	if profile.Codes[code] then
		return { ok = false, error = "You already redeemed this code." }
	end
	DataService.Update(player, function(p)
		p.Codes[code] = true
		return true
	end)
	local parts = {}
	for _, reward in def.Rewards do
		table.insert(parts, RewardService.Grant(player, reward, "Code"))
	end
	return { ok = true, message = "Redeemed: " .. table.concat(parts, ", ") }
end

local function useBoost(player: Player, id: any): { [string]: any }
	if not Boosts.Exists(id) then
		return { ok = false, error = "Unknown potion." }
	end
	local def = Boosts.Get(id) :: Boosts.Boost
	local ok = DataService.Update(player, function(p)
		local count = p.Potions[id] or 0
		if count <= 0 then
			return false
		end
		local now = os.time()
		local current = math.max(now, p.Boosts[id] or 0)
		if current - now + def.Duration > Boosts.MaxStackSeconds then
			return false
		end
		if count > 1 then
			p.Potions[id] = count - 1
		else
			p.Potions[id] = nil :: any
		end
		p.Boosts[id] = current + def.Duration
		return true
	end)
	if not ok then
		return { ok = false, error = "You can't use that right now." }
	end
	return { ok = true, message = def.Name .. " active!" }
end

function RewardService.Init(reg: { [string]: any })
	registry = reg
	DataService.AddDecorator(function(player, view)
		local start = joinedAt[player] or os.time()
		local set: { [number]: boolean } = claimed[player] or {}
		local list = {}
		for i in set do
			table.insert(list, i)
		end
		view.Session = { Playtime = os.time() - start, GiftsClaimed = list }
		view.DailyReady = (DataService.Get(player) :: any).Daily.Day < today()
	end)
end

function RewardService.Start()
	Guard.OnInvoke(Remotes.Function("RequestClaimGift"), 2, 4, claimGift)
	Guard.OnInvoke(Remotes.Function("RequestClaimDaily"), 1, 2, claimDaily)
	Guard.OnInvoke(Remotes.Function("RequestRedeemCode"), 0.5, 3, redeemCode)
	Guard.OnInvoke(Remotes.Function("RequestUseBoost"), 2, 4, useBoost)
	local function added(player: Player)
		joinedAt[player] = os.time()
		claimed[player] = {}
	end
	Players.PlayerAdded:Connect(added)
	for _, player in Players:GetPlayers() do
		added(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local start = joinedAt[player]
		if start then
			DataService.Update(player, function(p)
				p.Stats.Playtime += os.time() - start
				return true
			end)
		end
		joinedAt[player] = nil
		claimed[player] = nil
	end)
	-- refresh client timers / expire boosts once in a while
	task.spawn(function()
		while true do
			task.wait(15)
			local now = os.time()
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				if profile then
					for id, expiry in profile.Boosts do
						if expiry <= now then
							profile.Boosts[id] = nil
						end
					end
					DataService.MarkDirty(player)
				end
			end
		end
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[--!strict
-- Toggles and cosmetic preferences. AUTO THROW requires its game pass; AUTO train is free.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)

local SettingsService = {}

local registry: { [string]: any } = {}

local PREFERENCES = { FollowCam = true, Sfx = true, LowFx = true }

local function onToggle(player: Player, key: any, on: any)
	if not Validate.Boolean(on) then
		return
	end
	if key == "AutoTrain" then
		DataService.Update(player, function(p)
			p.Settings.AutoTrain = on
			return true
		end)
	elseif key == "AutoThrow" then
		if on then
			local monetization = registry.MonetizationService
			if not (monetization and monetization.HasPass(player, "AutoThrow")) then
				local notify = registry.NotifyService
				if notify then
					notify.Toast(player, "Auto Throw needs the Auto Throw pass!", "Error")
				end
				return
			end
		end
		DataService.Update(player, function(p)
			p.Settings.AutoThrow = on
			return true
		end)
	end
end

local function onSetting(player: Player, key: any, value: any)
	if type(key) ~= "string" or not PREFERENCES[key] or not Validate.Boolean(value) then
		return
	end
	DataService.Update(player, function(p)
		(p.Settings :: any)[key] = value
		return true
	end)
end

function SettingsService.Init(reg: { [string]: any })
	registry = reg
end

function SettingsService.Start()
	Guard.OnEvent(Remotes.Event("RequestToggle"), 4, 6, onToggle)
	Guard.OnEvent(Remotes.Event("RequestSetting"), 4, 8, onSetting)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Gliders (throwables), relic equip and trails. Wins are spent atomically on the server; the
-- client only names what it wants.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Trails = require(Shared.Definitions.Trails)
local Map = require(Shared.Config.Map)
local Remotes = require(Shared.Net.Remotes)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)
local MapService = require(script.Parent.MapService)

local ShopService = {}

local registry: { [string]: any } = {}

local PEDESTAL_REACH = 40

local function refreshCharacter(player: Player)
	local character = registry.CharacterService
	if character then
		character.Refresh(player)
	end
end

local function pedestalPosition(glider: Gliders.Glider): Vector3
	local index = 0
	for i, g in Gliders.ForWorld(glider.World) do
		if g.Id == glider.Id then
			index = i
			break
		end
	end
	return Map.Origin(glider.World) + Map.PedestalPosition(index)
end

local function buyGlider(player: Player, id: any): { [string]: any }
	if not Gliders.Exists(id) then
		return { ok = false, error = "Unknown glider." }
	end
	local glider = Gliders.Get(id) :: Gliders.Glider
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if profile.Gliders[glider.Id] then
		return { ok = false, error = "You already own this glider." }
	end
	if not profile.Worlds[tostring(glider.World)] then
		return { ok = false, error = "Unlock that world first!" }
	end
	if not MapService.Near(player, pedestalPosition(glider), PEDESTAL_REACH) then
		return { ok = false, error = "Walk up to the pedestal to buy it." }
	end
	if profile.Wins < glider.Price then
		return { ok = false, error = string.format("You need %s more Wins!", Format.Short(glider.Price - profile.Wins)) }
	end
	if not StatService.SpendWins(player, glider.Price) then
		return { ok = false, error = "Not enough Wins!" }
	end
	local equipped = false
	DataService.Update(player, function(p)
		p.Gliders[glider.Id] = true
		local current = Gliders.Get(p.Glider)
		if p.Relic == "" and (not current or glider.SkillPerRing > current.SkillPerRing) then
			p.Glider = glider.Id
			equipped = true
		end
		return true
	end)
	refreshCharacter(player)
	local tutorial = registry.TutorialService
	if tutorial then
		tutorial.Event(player, "BuyGlider")
	end
	return { ok = true, message = glider.Name .. (if equipped then " bought and equipped!" else " bought!") }
end

local function equipThrowable(player: Player, id: any): { [string]: any }
	if type(id) ~= "string" or #id > 48 then
		return { ok = false, error = "Unknown item." }
	end
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if registry.FlightService and registry.FlightService.IsFlying(player) then
		return { ok = false, error = "Wait until your glider lands." }
	end
	local relicId = string.match(id, "^relic:(.+)$")
	if relicId then
		if not Relics.Exists(relicId) or not profile.Relics[relicId] then
			return { ok = false, error = "You don't own that relic." }
		end
		DataService.Update(player, function(p)
			p.Relic = relicId
			return true
		end)
	elseif id == "relic:" or id == "norelic" then
		DataService.Update(player, function(p)
			p.Relic = ""
			return true
		end)
	else
		if not Gliders.Exists(id) or not profile.Gliders[id] then
			return { ok = false, error = "You don't own that glider." }
		end
		DataService.Update(player, function(p)
			p.Glider = id
			p.Relic = ""
			return true
		end)
	end
	refreshCharacter(player)
	return { ok = true }
end

local function trailAction(player: Player, action: any, id: any): { [string]: any }
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if action == "Unequip" then
		DataService.Update(player, function(p)
			p.Trail = ""
			return true
		end)
		refreshCharacter(player)
		return { ok = true }
	end
	if not Trails.Exists(id) then
		return { ok = false, error = "Unknown trail." }
	end
	local trail = Trails.Get(id) :: Trails.Trail
	if action == "Buy" then
		if profile.Trails[trail.Id] then
			return { ok = false, error = "You already own this trail." }
		end
		if not StatService.SpendWins(player, trail.Price) then
			return { ok = false, error = string.format("You need %s more Wins!", Format.Short(math.max(0, trail.Price - profile.Wins))) }
		end
		DataService.Update(player, function(p)
			p.Trails[trail.Id] = true
			p.Trail = trail.Id
			return true
		end)
		refreshCharacter(player)
		return { ok = true, message = trail.Name .. " equipped!" }
	elseif action == "Equip" then
		if not profile.Trails[trail.Id] then
			return { ok = false, error = "Buy this trail first." }
		end
		DataService.Update(player, function(p)
			p.Trail = trail.Id
			return true
		end)
		refreshCharacter(player)
		return { ok = true }
	end
	return { ok = false, error = "Unknown action." }
end

function ShopService.Init(reg: { [string]: any })
	registry = reg
end

function ShopService.Start()
	Guard.OnInvoke(Remotes.Function("RequestBuyThrowable"), 3, 5, buyGlider)
	Guard.OnInvoke(Remotes.Function("RequestEquipThrowable"), 3, 5, equipThrowable)
	Guard.OnInvoke(Remotes.Function("RequestTrailAction"), 3, 5, trailAction)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">StatService</string>
            <string name="Source"><![CDATA[--!strict
-- Central place where Skill, Wins and XP are granted. Every reward in the game flows through
-- here, so multipliers, limits, stats and level-ups are applied consistently and only on the
-- server. Also tracks the Friend Boost (friends in the same server).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Progression = require(Shared.Sim.Progression)
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)

local DataService = require(script.Parent.DataService)

local StatService = {}

StatService.LevelUp = Signal.new() -- (player, newLevel)
StatService.SkillGained = Signal.new() -- (player, amount, source)
StatService.WinsGained = Signal.new() -- (player, amount, source)

local registry: { [string]: any } = {}
local friendCounts: { [Player]: number } = {}
local friendCache: { [Player]: { [number]: boolean } } = {}

-- Pass ownership lives in MonetizationService (late-bound to avoid a require cycle).
local function passes(player: Player): { [string]: boolean }
	local monetization = registry.MonetizationService
	if monetization then
		return monetization.Passes(player)
	end
	return {}
end

function StatService.Context(player: Player): Progression.Context
	local events = registry.EventService
	return {
		Passes = passes(player),
		Friends = friendCounts[player] or 0,
		Premium = player.MembershipType == Enum.MembershipType.Premium,
		Now = os.time(),
		EventSkill = if events then events.SkillMultiplier() else 1,
		EventWins = if events then events.WinsMultiplier() else 1,
	}
end

function StatService.SkillMultiplier(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	return Progression.SkillMultiplier(profile, StatService.Context(player))
end

function StatService.WinsMultiplier(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	return Progression.WinsMultiplier(profile, StatService.Context(player))
end

function StatService.Luck(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	return Progression.Luck(profile, StatService.Context(player))
end

-- Adds already-multiplied Skill and re-derives the level. Training and rings stop paying at the
-- level cap (Economy.CappedSources); purchases, gifts and codes always pay. Returns the amount added.
function StatService.AddSkill(player: Player, amount: number, source: string): number
	if amount ~= amount or amount <= 0 then
		return 0
	end
	local levels = 0
	local reachedCap = false
	local added = DataService.Update(player, function(p)
		if not Progression.SourcePays(p, source) then
			return 0
		end
		local before = p.Skill
		p.Skill = math.min(Economy.Limits.MaxSkill, p.Skill + amount)
		local delta = p.Skill - before
		p.Stats.TotalSkill = math.min(1e300, p.Stats.TotalSkill + delta)
		levels = Progression.SyncLevel(p)
		reachedCap = levels > 0 and Progression.IsMaxLevel(p)
		return delta
	end) or 0
	if added > 0 then
		StatService.SkillGained:Fire(player, added, source)
	end
	if levels > 0 then
		local profile = DataService.Get(player)
		if profile then
			StatService.LevelUp:Fire(player, profile.Level)
		end
		local notify = registry.NotifyService
		if notify and reachedCap then
			notify.Toast(player, "MAX LEVEL! Rebirth is ready (100%)", "Success")
		end
	end
	return added
end

-- True when training/rings no longer pay (level cap reached).
function StatService.AtCap(player: Player): boolean
	local profile = DataService.Get(player)
	return profile ~= nil and Progression.IsMaxLevel(profile)
end

-- Adds already-multiplied Wins. Returns the amount actually added.
function StatService.AddWins(player: Player, amount: number, source: string): number
	if amount ~= amount or amount <= 0 then
		return 0
	end
	local added = DataService.Update(player, function(p)
		local before = p.Wins
		p.Wins = math.min(Economy.Limits.MaxWins, p.Wins + amount)
		local delta = p.Wins - before
		p.Stats.TotalWins = math.min(1e300, p.Stats.TotalWins + delta)
		return delta
	end) or 0
	if added > 0 then
		StatService.WinsGained:Fire(player, added, source)
	end
	return added
end

-- Spends Wins atomically. Returns false (and changes nothing) if the player can't afford it.
function StatService.SpendWins(player: Player, amount: number): boolean
	if amount ~= amount or amount < 0 then
		return false
	end
	return DataService.Update(player, function(p)
		if p.Wins < amount then
			return false
		end
		p.Wins -= amount
		return true
	end) == true
end

-- Training-rep-equivalent Skill (used by gifts/daily: "Reps" rewards).
function StatService.RepsToSkill(player: Player, reps: number, padMultiplier: number): number
	return reps * Economy.TrainRepBase * padMultiplier * StatService.SkillMultiplier(player)
end

function StatService.FriendBoost(player: Player): number
	return Progression.FriendBoost(friendCounts[player] or 0)
end

local function recountFriends()
	local list = Players:GetPlayers()
	for _, player in list do
		local cache = friendCache[player]
		local count = 0
		if cache then
			for _, other in list do
				if other ~= player and cache[other.UserId] then
					count += 1
				end
			end
		end
		if friendCounts[player] ~= count then
			friendCounts[player] = count
			DataService.MarkDirty(player)
		end
	end
end

local function cacheFriendships(player: Player)
	local cache = friendCache[player] or {}
	friendCache[player] = cache
	for _, other in Players:GetPlayers() do
		if other ~= player and cache[other.UserId] == nil then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWithAsync(other.UserId)
			end)
			if ok then
				cache[other.UserId] = isFriend
				local otherCache = friendCache[other]
				if otherCache then
					otherCache[player.UserId] = isFriend
				end
			end
		end
	end
	recountFriends()
end

function StatService.Init(reg: { [string]: any })
	registry = reg
	DataService.AddDecorator(function(player, view)
		local profile = DataService.Get(player)
		if not profile then
			return
		end
		local ctx = StatService.Context(player)
		local breakdown = Progression.SkillBreakdown(profile, ctx)
		view.Derived = {
			SkillMultiplier = breakdown.Total,
			Breakdown = breakdown,
			WinsMultiplier = Progression.WinsMultiplier(profile, ctx),
			Luck = Progression.Luck(profile, ctx),
			FriendBoost = Progression.FriendBoost(ctx.Friends),
			Friends = ctx.Friends,
			LevelCap = Progression.LevelCap(profile),
			XPToNext = Economy.XPToNext(profile.Level),
			RebirthProgress = Progression.RebirthProgress(profile),
			CanRebirth = Progression.CanRebirth(profile),
			NextRebirthMultiplier = Economy.RebirthMultiplier(profile.Rebirths + 1),
			SkillPerRing = Progression.SkillPerRing(profile),
			PetSlots = Progression.PetSlots(ctx),
			Passes = table.clone(ctx.Passes),
			ServerTime = os.time(),
		}
	end)
end

function StatService.Start()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(cacheFriendships, player)
		for _, other in Players:GetPlayers() do
			if other ~= player then
				task.spawn(cacheFriendships, other)
			end
		end
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(cacheFriendships, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		friendCache[player] = nil
		friendCounts[player] = nil
		task.defer(recountFriends)
	end)
end

StatService.Format = Format

return StatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">TrainingService</string>
            <string name="Source"><![CDATA[--!strict
-- Training pads: tap (RequestTrain, rate limited) or AUTO (server ticks) while standing on a pad.
-- The server decides which pad you are on from your character position and checks its rebirth /
-- game-pass lock before paying Pad multiplier x Skill multiplier.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Monetization = require(Shared.Config.Monetization)
local Training = require(Shared.Definitions.Training)
local Remotes = require(Shared.Net.Remotes)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)
local MapService = require(script.Parent.MapService)

local TrainingService = {}

local registry: { [string]: any } = {}
local trainResult: RemoteEvent
local lastWarn: { [Player]: number } = {}

local function warnOnce(player: Player, text: string)
	local t = os.clock()
	if (lastWarn[player] or 0) + 2.5 > t then
		return
	end
	lastWarn[player] = t
	local notify = registry.NotifyService
	if notify then
		notify.Toast(player, text, "Error")
	end
end

-- Is the pad open for this player? Returns (ok, reason)
function TrainingService.PadUnlocked(player: Player, pad: Training.Pad): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Loading"
	end
	if pad.PassKey then
		local monetization = registry.MonetizationService
		if not (monetization and monetization.HasPass(player, pad.PassKey)) then
			local pass = Monetization.Pass(pad.PassKey)
			return false, string.format("Unlock this pad with the %s pass!", if pass then pass.Name else pad.PassKey)
		end
		return true, nil
	end
	if profile.Rebirths < pad.Rebirths then
		return false, string.format("Needs %d rebirths!", pad.Rebirths)
	end
	return true, nil
end

local function rep(player: Player, manual: boolean): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	if registry.FlightService and registry.FlightService.IsFlying(player) then
		return false
	end
	local pad = MapService.PadAt(player, profile.World)
	if not pad then
		if manual then
			warnOnce(player, "Stand on a training pad to train!")
		end
		return false
	end
	local ok, reason = TrainingService.PadUnlocked(player, pad)
	if not ok then
		warnOnce(player, reason or "Locked")
		return false
	end
	if StatService.AtCap(player) then
		warnOnce(player, "MAX LEVEL! Rebirth to keep gaining Skill.")
		return false
	end
	local amount = pad.Multiplier * Economy.TrainRepBase * StatService.SkillMultiplier(player)
	local added = StatService.AddSkill(player, amount, "Train")
	if added > 0 then
		trainResult:FireClient(player, { Amount = added, Pad = pad.Id })
		local tutorial = registry.TutorialService
		if tutorial then
			tutorial.Event(player, "Train")
		end
	end
	return true
end

function TrainingService.Init(reg: { [string]: any })
	registry = reg
	trainResult = Remotes.Event("TrainResult")
end

function TrainingService.Start()
	Guard.OnEvent(Remotes.Event("RequestTrain"), Economy.TrainManualRate, Economy.TrainManualRate + 2, function(player)
		rep(player, true)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastWarn[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Economy.TrainAutoInterval)
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				if profile and profile.Settings.AutoTrain then
					rep(player, false)
				end
			end
		end
	end)
end

return TrainingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
-- Advances the first-session guide from real server events (Definitions/Tutorial).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tutorial = require(Shared.Definitions.Tutorial)
local Remotes = require(Shared.Net.Remotes)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)

local TutorialService = {}

local registry: { [string]: any } = {}

function TutorialService.Event(player: Player, event: string, amount: number?)
	local profile = DataService.Get(player)
	if not profile or profile.Tutorial.Done then
		return
	end
	local step = Tutorial.Steps[profile.Tutorial.Step]
	if not step or step.Event ~= event then
		return
	end
	DataService.Update(player, function(p)
		p.Tutorial.Progress += amount or 1
		if p.Tutorial.Progress >= (step.Count or 1) then
			p.Tutorial.Step += 1
			p.Tutorial.Progress = 0
			if p.Tutorial.Step > #Tutorial.Steps then
				p.Tutorial.Done = true
			end
		end
		return true
	end)
	local updated = DataService.Get(player)
	if updated and updated.Tutorial.Done then
		local notify = registry.NotifyService
		if notify then
			notify.Toast(player, "Tutorial complete! Fly farther to unlock new zones.", "Success")
		end
	end
end

function TutorialService.Init(reg: { [string]: any })
	registry = reg
end

function TutorialService.Start()
	Guard.OnEvent(Remotes.Event("RequestTutorial"), 1, 2, function(player, action)
		if action == "Skip" then
			DataService.Update(player, function(p)
				p.Tutorial.Done = true
				return true
			end)
		end
	end)
	-- "Walk into the Throw Zone" is detected on the server from the character position.
	task.spawn(function()
		local Players = game:GetService("Players")
		while true do
			task.wait(0.5)
			local map = registry.MapService
			for _, player in Players:GetPlayers() do
				local profile = DataService.Get(player)
				if profile and not profile.Tutorial.Done and map then
					local step = Tutorial.Steps[profile.Tutorial.Step]
					if step and step.Event == "EnterThrowZone" and map.InThrowZone(player, profile.World) then
						TutorialService.Event(player, "EnterThrowZone")
					end
				end
			end
		end
	end)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- World unlocks and travel. Unlocking costs Wins and needs rebirths (checked here); travelling
-- moves the character to that world's spawn. Characters always respawn in their current world.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)
local MapService = require(script.Parent.MapService)

local WorldService = {}

local registry: { [string]: any } = {}
local worldChanged: RemoteEvent

local function placeCharacter(player: Player, worldId: number)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(MapService.SpawnCFrame(worldId) + Vector3.new(math.random(-6, 6), 0, math.random(-4, 4)))
	end
	player:SetAttribute("World", worldId)
end

local function enterWorld(player: Player, worldId: any): { [string]: any }
	if not Validate.Integer(worldId, 1, Worlds.Count) then
		return { ok = false, error = "Unknown world." }
	end
	local world = Worlds.Get(worldId) :: Worlds.World
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false, error = "Still loading..." }
	end
	if registry.FlightService and registry.FlightService.IsFlying(player) then
		return { ok = false, error = "Wait until your glider lands." }
	end
	local key = tostring(world.Id)
	local unlockedNow = false
	if not profile.Worlds[key] then
		if world.Id > 1 and not profile.Worlds[tostring(world.Id - 1)] then
			return { ok = false, error = "Unlock the previous world first!" }
		end
		if world.UnlockZone and not profile.Zones[world.UnlockZone] then
			local zone = Zones.Get(world.UnlockZone)
			local prevWorld = Worlds.Get(world.Id - 1)
			return {
				ok = false,
				error = string.format("Throw to %s in %s to unlock %s!", if zone then zone.Name else "the end of the river", if prevWorld then prevWorld.Name else "the last world", world.Name),
			}
		end
		if profile.Rebirths < world.UnlockRebirths then
			return { ok = false, error = string.format("%s needs %d rebirths!", world.Name, world.UnlockRebirths) }
		end
		if not StatService.SpendWins(player, world.UnlockWins) then
			return { ok = false, error = string.format("%s costs %s Wins!", world.Name, Format.Short(world.UnlockWins)) }
		end
		DataService.Update(player, function(p)
			p.Worlds[key] = true
			return true
		end)
		unlockedNow = true
	end
	DataService.Update(player, function(p)
		p.World = world.Id
		return true
	end)
	placeCharacter(player, world.Id)
	worldChanged:FireClient(player, world.Id)
	local notify = registry.NotifyService
	if notify and unlockedNow then
		notify.All(string.format("%s unlocked %s!", player.DisplayName, world.Name), "Success")
	end
	return { ok = true, unlocked = unlockedNow }
end

function WorldService.Init(reg: { [string]: any })
	registry = reg
	worldChanged = Remotes.Event("WorldChanged")
end

function WorldService.Start()
	Guard.OnInvoke(Remotes.Function("RequestEnterWorld"), 1, 3, enterWorld)
	local function onCharacter(player: Player, character: Model)
		-- a respawn mid-flight cancels that flight (no payout for a throw you can't watch)
		if registry.FlightService then
			registry.FlightService.Cancel(player)
		end
		local profile = DataService.WaitFor(player, 30)
		local worldId = if profile then profile.World else 1
		if not character:FindFirstChild("HumanoidRootPart") then
			character:WaitForChild("HumanoidRootPart", 10)
		end
		task.wait()
		if character.Parent and player.Character == character then
			placeCharacter(player, worldId)
			worldChanged:FireClient(player, worldId)
		end
	end
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		-- already spawned (players present before this service started, e.g. Studio Play Solo)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="71">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
-- Remote hardening: per-player token-bucket rate limits around every client->server endpoint.
-- Handlers still validate every argument (see Shared/Util/Validate) and check server state.
local Players = game:GetService("Players")

local Guard = {}

type Bucket = { tokens: number, updated: number, strikes: number }

local buckets: { [Player]: { [string]: Bucket } } = {}

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

-- Returns true if the player may perform `key` now. `rate` = tokens per second, `burst` = bucket size.
function Guard.Allow(player: Player, key: string, rate: number, burst: number): boolean
	local perPlayer = buckets[player]
	if perPlayer == nil then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[key]
	if bucket == nil then
		bucket = { tokens = burst, updated = now, strikes = 0 }
		perPlayer[key] = bucket
	end
	bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.updated) * rate)
	bucket.updated = now
	if bucket.tokens >= 1 then
		bucket.tokens -= 1
		return true
	end
	bucket.strikes += 1
	if bucket.strikes % 50 == 0 then
		warn(string.format("[Guard] %s is spamming %s (%d rejected)", player.Name, key, bucket.strikes))
	end
	return false
end

-- Connects a RemoteEvent with rate limiting; handler errors are contained and logged.
function Guard.OnEvent(remote: RemoteEvent, rate: number, burst: number, handler: (Player, ...any) -> ...any)
	remote.OnServerEvent:Connect(function(player: Player, ...)
		if not Guard.Allow(player, remote.Name, rate, burst) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Guard] %s handler error for %s: %s", remote.Name, player.Name, tostring(err)))
		end
	end)
end

function Guard.OnUnreliable(remote: UnreliableRemoteEvent, rate: number, burst: number, handler: (Player, ...any) -> ...any)
	remote.OnServerEvent:Connect(function(player: Player, ...)
		if not Guard.Allow(player, remote.Name, rate, burst) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Guard] %s handler error for %s: %s", remote.Name, player.Name, tostring(err)))
		end
	end)
end

-- RemoteFunction with rate limiting; always returns a result table to the client.
function Guard.OnInvoke(remote: RemoteFunction, rate: number, burst: number, handler: (Player, ...any) -> { [string]: any })
	remote.OnServerInvoke = function(player: Player, ...)
		if not Guard.Allow(player, remote.Name, rate, burst) then
			return { ok = false, error = "Slow down!" }
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Guard] %s handler error for %s: %s", remote.Name, player.Name, tostring(result)))
			return { ok = false, error = "Something went wrong. Try again." }
		end
		return result
	end
end

return Guard
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="73">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural world builder (server). MapBuilder.Build(world, parent) builds one complete world at
-- Map.Origin(world.Id) from Config/Map, Config/Flight, Sim/FlightSim, Visual/Themes and the
-- definitions, and parents a Model "World_<id>" to `parent`:
--   hub (checker floor, stone path, checker cliff walls with grass tops, spawn plate, title arch),
--   the Throw Zone platform at the channel edge, the long channel with zone arches (MapChannel),
--   the interactive stations (MapStations) and themed decoration (MapProps).
-- Child names follow docs/DESIGN.md §5 exactly; clients depend on them. Everything is anchored,
-- only walkable/blocking geometry collides, and the build never yields. Lighting is per client
-- (WorldController), so it is not touched here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Map = require(Shared.Config.Map)
local Themes = require(Shared.Visual.Themes)
local Worlds = require(Shared.Definitions.Worlds)
local Training = require(Shared.Definitions.Training)
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Eggs = require(Shared.Definitions.Eggs)
local Zones = require(Shared.Definitions.Zones)

local World = script.Parent
local MapKit = require(World.MapKit)
local MapProps = require(World.MapProps)
local MapChannel = require(World.MapChannel)
local MapStations = require(World.MapStations)

local MapBuilder = {}

MapBuilder.PartBudget = 2500 -- soft target per world; Build warns above it

local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)

local HUB = Map.Hub
local WALL_T = 12 -- hub wall thickness
local TILE_X = (HUB.MaxX - HUB.MinX) / 24 -- ~13.3 stud floor tiles
local TILE_Z = (HUB.MaxZ - HUB.MinZ) / 20 -- 13.5
local PATH_HALF = TILE_X -- the stone path covers two tile columns
local PATH_END = Map.Spawn.Z + 10
local TITLE_Z = 150 -- title arch over the path, ahead of spawn
local OPENING = MapChannel.CliffX -- hub front is open over the channel for |X| < this

type Rect = { X0: number, X1: number, Z0: number, Z1: number }

local function inside(r: Rect, x0: number, x1: number, z0: number, z1: number): boolean
	return x0 >= r.X0 - 0.01 and x1 <= r.X1 + 0.01 and z0 >= r.Z0 - 0.01 and z1 <= r.Z1 + 0.01
end

-- HUB ---------------------------------------------------------------------------------------------

local function buildFloor(ctx: MapKit.Ctx, hub: Instance)
	local pal = ctx.Pal
	local at = function(x: number, y: number, z: number): Vector3
		return MapKit.At(ctx, x, y, z)
	end
	local floor = MapKit.Group(hub, "Floor")
	MapKit.Box(floor, at(HUB.MinX, -16, HUB.MinZ), at(HUB.MaxX, 0, HUB.MaxZ), pal.FloorA, {
		Solid = true,
		Name = "Ground",
	})
	-- checkerboard: FloorB tiles sit 0.05 proud of the ground; tiles hidden under the throw zone or
	-- the path are skipped
	local covered: { Rect } = {
		{ X0 = Map.ThrowZone.MinX, X1 = Map.ThrowZone.MaxX, Z0 = Map.ThrowZone.MinZ, Z1 = Map.ThrowZone.MaxZ },
		{ X0 = -PATH_HALF, X1 = PATH_HALF, Z0 = Map.ThrowZone.MaxZ, Z1 = PATH_END },
	}
	for i = 0, 23 do
		for j = 0, 19 do
			if (i + j) % 2 == 1 then
				local x0 = HUB.MinX + i * TILE_X
				local z0 = HUB.MinZ + j * TILE_Z
				local hidden = false
				for _, r in covered do
					if inside(r, x0, x0 + TILE_X, z0, z0 + TILE_Z) then
						hidden = true
						break
					end
				end
				if not hidden then
					MapKit.Box(floor, at(x0, -0.15, z0), at(x0 + TILE_X, 0.05, z0 + TILE_Z), pal.FloorB, { Name = "Tile" })
				end
			end
		end
	end
	-- retaining face under the hub's open front, seen from the channel
	-- (0.3 proud of the ground's front face and 0.05 below its top, so no faces coincide)
	MapKit.CheckerWall(floor, at(-OPENING, Map.WaterY - 8, HUB.MinZ - 0.3), at(OPENING, Map.WaterY - 8, HUB.MinZ - 0.3), Vector3.new(0, 0, -1), 8 - Map.WaterY - 0.05, pal.Cliff, pal.CliffAlt, pal.CliffTop, {
		Thickness = 2,
		BlockLength = 14,
		Rows = 1,
	})
end

local function buildPath(ctx: MapKit.Ctx, hub: Instance)
	local pal = ctx.Pal
	local path = MapKit.Group(hub, "Path")
	local z0, z1 = Map.ThrowZone.MaxZ, PATH_END
	MapKit.Box(path, MapKit.At(ctx, -PATH_HALF, -0.2, z0), MapKit.At(ctx, PATH_HALF, 0.2, z1), pal.Path, {
		Solid = true,
		Name = "Stone",
	})
	local edge = MapKit.Shade(pal.Path, 0.18)
	for side = -1, 1, 2 do
		MapKit.Box(path, MapKit.At(ctx, side * PATH_HALF, 0.2, z0), MapKit.At(ctx, side * (PATH_HALF - 1.2), 0.3, z1), edge, { Name = "Edge" })
	end
	-- two columns of alternating stones
	local rows = 14
	local rowLen = (z1 - z0) / rows
	local stone = MapKit.Shade(pal.Path, 0.07)
	for r = 0, rows - 1 do
		for c = 0, 1 do
			if (r + c) % 2 == 1 then
				local x0 = -PATH_HALF + c * PATH_HALF
				MapKit.Box(path, MapKit.At(ctx, x0 + 1.2 * (1 - c), 0.2, z0 + r * rowLen), MapKit.At(ctx, x0 + PATH_HALF - 1.2 * c, 0.26, z0 + (r + 1) * rowLen), stone, {
					Name = "Slab",
				})
			end
		end
	end
end

local function buildWalls(ctx: MapKit.Ctx, hub: Instance)
	local pal = ctx.Pal
	local walls = MapKit.Group(hub, "Walls")
	local h = HUB.WallHeight
	local function wall(a: Vector3, b: Vector3, inward: Vector3, e0: number, e1: number)
		MapKit.CheckerWall(walls, MapKit.At(ctx, a.X, 0, a.Z), MapKit.At(ctx, b.X, 0, b.Z), inward, h, pal.Cliff, pal.CliffAlt, pal.CliffTop, {
			Thickness = WALL_T,
			BlockLength = TILE_X,
			Rows = 3,
			Below = 16,
			ExtendStart = e0,
			ExtendEnd = e1,
			Cap = true,
			CapOverhang = 1.2,
			Drips = ctx.Rng,
		})
	end
	wall(Vector3.new(HUB.MinX, 0, HUB.MaxZ), Vector3.new(HUB.MaxX, 0, HUB.MaxZ), Vector3.new(0, 0, -1), WALL_T, WALL_T)
	wall(Vector3.new(HUB.MinX, 0, HUB.MinZ), Vector3.new(HUB.MinX, 0, HUB.MaxZ), Vector3.new(1, 0, 0), WALL_T, 0)
	wall(Vector3.new(HUB.MaxX, 0, HUB.MinZ), Vector3.new(HUB.MaxX, 0, HUB.MaxZ), Vector3.new(-1, 0, 0), WALL_T, 0)
	wall(Vector3.new(HUB.MinX, 0, HUB.MinZ), Vector3.new(-OPENING, 0, HUB.MinZ), Vector3.new(0, 0, 1), WALL_T, 0)
	wall(Vector3.new(OPENING, 0, HUB.MinZ), Vector3.new(HUB.MaxX, 0, HUB.MinZ), Vector3.new(0, 0, 1), 0, WALL_T)
	-- grass plateau around the hub at wall-top height (no floating-island look from above)
	local top = h + 2
	local outer = MapChannel.OuterX
	local back = HUB.MaxZ + WALL_T
	local front = HUB.MinZ - WALL_T
	local opts: MapKit.PartOpts = { Solid = true, Shadow = false, Name = "Plateau" }
	MapKit.Box(walls, MapKit.At(ctx, -outer, top - 6, front), MapKit.At(ctx, HUB.MinX - WALL_T, top, back + 120), pal.CliffTop, opts)
	MapKit.Box(walls, MapKit.At(ctx, HUB.MaxX + WALL_T, top - 6, front), MapKit.At(ctx, outer, top, back + 120), pal.CliffTop, opts)
	MapKit.Box(walls, MapKit.At(ctx, HUB.MinX - WALL_T, top - 6, back), MapKit.At(ctx, HUB.MaxX + WALL_T, top, back + 120), pal.CliffTop, opts)
end

-- Spawn plate (every world) and the real SpawnLocation (world 1 only; WorldService teleports
-- players into the other worlds).
local function buildSpawn(ctx: MapKit.Ctx, hub: Instance)
	local pal = ctx.Pal
	local s = Map.Spawn
	local plate = MapKit.Group(hub, "SpawnPlate")
	MapKit.Disc(plate, 24, 0.5, MapKit.CF(ctx, s.X, 0.25, s.Z), pal.Accent, { Material = NEON, Name = "Glow" })
	MapKit.Disc(plate, 21, 0.62, MapKit.CF(ctx, s.X, 0.31, s.Z), pal.Stone, { Solid = true, Name = "Plate" })
	MapKit.Disc(plate, 9, 0.66, MapKit.CF(ctx, s.X, 0.33, s.Z), MapKit.Tint(pal.Accent, 0.35), { Name = "Center" })
	if ctx.World.Id == 1 then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "SpawnLocation"
		spawn.Size = Vector3.new(12, 1, 12)
		local pos = MapKit.At(ctx, s.X, 0.5, s.Z)
		spawn.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1)) -- players spawn facing the channel
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.CanTouch = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Enabled = true
		spawn.Parent = ctx.Model
	end
end

-- Title arch over the path ("SUNNY ISLES"), readable from both sides.
local function buildTitle(ctx: MapKit.Ctx, hub: Instance)
	local pal = ctx.Pal
	local world = ctx.World
	local title = MapKit.Group(hub, "TitleSign")
	local px = PATH_HALF + 3.5
	for side = -1, 1, 2 do
		MapKit.Part(title, Vector3.new(3.4, 30, 3.4), MapKit.CF(ctx, side * px, 15, TITLE_Z), pal.Stone, { Solid = true, Shadow = true, Name = "Pillar" })
		MapKit.Part(title, Vector3.new(4.2, 2, 4.2), MapKit.CF(ctx, side * px, 8, TITLE_Z), pal.Accent, { Name = "Band" })
		MapKit.Ball(title, 4.6, MapKit.CF(ctx, side * px, 31.5, TITLE_Z), pal.Accent, { Material = NEON, Name = "Lamp" })
	end
	local width = px * 2 + 8
	local center = MapKit.At(ctx, 0, 25, TITLE_Z)
	local board = MapKit.Part(title, Vector3.new(width, 9, 2), MapKit.Facing(center, Vector3.zAxis), MapKit.Shade(pal.Accent, 0.55), {
		Shadow = true,
		Name = "Board",
	})
	-- thinner than the board and centred on it, so both sign faces stay in front of the border
	MapKit.Part(title, Vector3.new(width + 2, 11, 1.4), MapKit.Facing(center, Vector3.zAxis), pal.Accent, { Name = "Border" })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = MapKit.Surface(board, "Title", face, 20)
		local name = MapKit.Text(gui, "Name", string.upper(world.Name), 0.04, 0.62, WHITE, { StrokeThickness = 5 })
		MapKit.Gradient(name, { WHITE, MapKit.Tint(pal.Accent, 0.4) }).Rotation = 90
		MapKit.Text(gui, "Sub", string.format("WORLD %d  •  %s", world.Id, world.Description), 0.68, 0.28, MapKit.Tint(pal.Accent, 0.6), {
			Font = MapKit.Fonts.Body,
			StrokeThickness = 2,
		})
	end
end

-- THROW ZONE --------------------------------------------------------------------------------------

local function buildThrowZone(ctx: MapKit.Ctx, hub: Instance)
	local pal = ctx.Pal
	local tz = Map.ThrowZone
	local cx = (tz.MinX + tz.MaxX) / 2
	local cz = (tz.MinZ + tz.MaxZ) / 2
	local w = tz.MaxX - tz.MinX
	local d = tz.MaxZ - tz.MinZ
	local zone = MapKit.Part(ctx.Model, Vector3.new(w, 1, d), MapKit.CF(ctx, cx, -0.1, cz), pal.ThrowZone, {
		Solid = true,
		Shadow = true,
		Name = "ThrowZone",
	})
	zone.CanTouch = true -- clients may use touch/overlap queries on the zone
	zone:SetAttribute("ThrowZone", true)

	local deco = MapKit.Group(hub, "ThrowZoneDecor")
	local dark = MapKit.Shade(pal.ThrowZone, 0.1)
	local cols, rows = 6, 4
	local tw, td = w / cols, d / rows
	for c = 0, cols - 1 do
		for r = 0, rows - 1 do
			if (c + r) % 2 == 1 then
				local x0 = tz.MinX + c * tw
				local z0 = tz.MinZ + r * td
				MapKit.Box(deco, MapKit.At(ctx, x0, 0.4, z0), MapKit.At(ctx, x0 + tw, 0.46, z0 + td), dark, { Name = "Tile" })
			end
		end
	end
	-- border trim, neon launch edge toward the channel
	local trim = MapKit.Shade(pal.ThrowZone, 0.3)
	MapKit.Box(deco, MapKit.At(ctx, tz.MinX, 0.4, tz.MaxZ - 1.4), MapKit.At(ctx, tz.MaxX, 0.52, tz.MaxZ), trim, { Name = "Trim" })
	MapKit.Box(deco, MapKit.At(ctx, tz.MinX, 0.4, tz.MinZ), MapKit.At(ctx, tz.MinX + 1.4, 0.52, tz.MaxZ), trim, { Name = "Trim" })
	MapKit.Box(deco, MapKit.At(ctx, tz.MaxX - 1.4, 0.4, tz.MinZ), MapKit.At(ctx, tz.MaxX, 0.52, tz.MaxZ), trim, { Name = "Trim" })
	MapKit.Box(deco, MapKit.At(ctx, tz.MinX, 0.4, tz.MinZ), MapKit.At(ctx, tz.MaxX, 0.55, tz.MinZ + 1.4), MapKit.Tint(pal.ThrowZone, 0.4), {
		Material = NEON,
		Name = "LaunchEdge",
	})
	-- "THROW ZONE" painted on the floor, upright for players walking in from spawn (-Z)
	local decal = MapKit.FloorDecal(deco, MapKit.At(ctx, cx, 0.58, cz + 2), Vector3.new(0, 0, -1), w - 10, d * 0.42)
	local gui = MapKit.Surface(decal, "Paint", Enum.NormalId.Front, 16)
	MapKit.Text(gui, "Text", "THROW ZONE", 0, 1, pal.ThrowZoneText, {
		Stroke = MapKit.StrokeFor(pal.ThrowZoneText),
		StrokeThickness = 6,
	})
	-- low railing across the whole open front, plus an invisible barrier so nobody falls in
	local railZ = HUB.MinZ + 0.5
	local posts = 13
	for i = 0, posts - 1 do
		local x = -OPENING + 1 + (OPENING * 2 - 2) * i / (posts - 1)
		MapKit.Part(deco, Vector3.new(0.9, 3.4, 0.9), MapKit.CF(ctx, x, 1.7, railZ), pal.Stone, { Name = "Post" })
	end
	MapKit.Box(deco, MapKit.At(ctx, -OPENING, 3.2, railZ - 0.5), MapKit.At(ctx, OPENING, 3.9, railZ + 0.5), pal.Accent, { Name = "Rail" })
	MapKit.Box(deco, MapKit.At(ctx, -OPENING, 1.6, railZ - 0.3), MapKit.At(ctx, OPENING, 2, railZ + 0.3), WHITE, { Name = "Rail" })
	MapKit.Box(deco, MapKit.At(ctx, -OPENING, 0, HUB.MinZ - 1), MapKit.At(ctx, OPENING, 14, HUB.MinZ), WHITE, {
		Solid = true,
		Transparency = 1,
		Shadow = false,
		Name = "Barrier",
	})
end

-- DECORATION --------------------------------------------------------------------------------------

type Spot = { X: number, Z: number, Role: string, Scale: number }

-- Hand-placed hub spots (world-local), clear of the path, pads, pedestals, eggs, portals and boards.
local HUB_SPOTS: { Spot } = {
	{ X = -143, Z = -25, Role = "Tree", Scale = 1.2 },
	{ X = -128, Z = -24, Role = "Bush", Scale = 1 },
	{ X = -152, Z = -4, Role = "Rock", Scale = 1.1 },
	{ X = -134, Z = 9, Role = "Tree", Scale = 1 },
	{ X = -100, Z = -20, Role = "Feature", Scale = 1 },
	{ X = -60, Z = -26, Role = "Small", Scale = 1 },
	{ X = -80, Z = -2, Role = "Bush", Scale = 0.9 },
	{ X = -140, Z = 42, Role = "Bush", Scale = 1 },
	{ X = -142, Z = 72, Role = "Tree", Scale = 1.15 },
	{ X = -134, Z = 95, Role = "Small", Scale = 1 },
	{ X = -60, Z = 34, Role = "Feature", Scale = 1 },
	{ X = -46, Z = 78, Role = "Tree", Scale = 1 },
	{ X = -70, Z = 118, Role = "Small", Scale = 1 },
	{ X = -36, Z = 120, Role = "Bush", Scale = 0.9 },
	{ X = -40, Z = 160, Role = "Rock", Scale = 1 },
	{ X = -64, Z = 178, Role = "Tree", Scale = 1.1 },
	{ X = 30, Z = 30, Role = "Small", Scale = 0.9 },
	{ X = 42, Z = 64, Role = "Bush", Scale = 1 },
	{ X = 52, Z = 102, Role = "Tree", Scale = 1 },
	{ X = 34, Z = 136, Role = "Small", Scale = 1 },
	{ X = 54, Z = 176, Role = "Rock", Scale = 1 },
	{ X = 140, Z = 30, Role = "Tree", Scale = 1.1 },
	{ X = 150, Z = 72, Role = "Bush", Scale = 1 },
	{ X = 138, Z = 112, Role = "Tree", Scale = 1 },
	{ X = 150, Z = 150, Role = "Small", Scale = 1 },
	{ X = 140, Z = 186, Role = "Rock", Scale = 1 },
	{ X = 112, Z = -22, Role = "Feature", Scale = 1 },
	{ X = 144, Z = -25, Role = "Tree", Scale = 1.2 },
	{ X = 54, Z = -26, Role = "Small", Scale = 1 },
	{ X = 128, Z = 6, Role = "Bush", Scale = 1 },
	{ X = 146, Z = 216, Role = "Tree", Scale = 1 },
	{ X = 16, Z = 220, Role = "Bush", Scale = 1 },
	{ X = -10, Z = 222, Role = "Rock", Scale = 0.9 },
	{ X = -136, Z = 217, Role = "Tree", Scale = 1 },
}

-- Facing toward the middle of the hub (props with a front, like the igloo or the statue).
local function hubFacing(ctx: MapKit.Ctx, x: number, z: number): CFrame
	local pos = MapKit.At(ctx, x, 0, z)
	local target = MapKit.At(ctx, 0, 0, 100)
	if (target - pos).Magnitude < 1 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, target)
end

local function decorateHub(ctx: MapKit.Ctx, decor: Instance)
	local family = ctx.Theme.Props
	local props: MapProps.Ctx = { Pal = ctx.Pal, Rng = ctx.Rng, Shadow = true }
	local hub = MapKit.Group(decor, "Hub")
	for _, spot in HUB_SPOTS do
		MapProps.Place(family, spot.Role, hub, hubFacing(ctx, spot.X, spot.Z), spot.Scale, props)
	end
	-- signature set pieces per family
	if family == "Volcano" then
		MapProps.DragonStatue(hub, hubFacing(ctx, 132, -12), 1, props)
		MapProps.LavaPool(hub, MapKit.CF(ctx, 100, 0, 186), 1.1, props)
	elseif family == "Pirate" then
		MapProps.SkullFlag(hub, MapKit.CF(ctx, -150, 0, -32), 1.4, props)
		MapProps.SkullFlag(hub, MapKit.CF(ctx, 150, 0, -32) * CFrame.Angles(0, math.pi, 0), 1.4, props)
		MapProps.TreasureChest(hub, hubFacing(ctx, 147, 198), 1.2, props)
	elseif family == "Ice" then
		MapProps.Crystal(hub, MapKit.CF(ctx, 147, 0, 198), 1.6, props)
		MapProps.IceSpike(hub, MapKit.CF(ctx, 100, 0, 186), 1.2, props)
	else
		MapProps.Umbrella(hub, MapKit.CF(ctx, 147, 0, 198), 1, props)
		MapProps.Palm(hub, MapKit.CF(ctx, 100, 0, 186), 1, props)
	end
end

-- Props along the banks and on the plateau behind the cliffs. Dense near the hub where the camera
-- lingers, sparse far out; never on top of a zone arch.
local function decorateChannel(ctx: MapKit.Ctx, decor: Instance, archZ: { number })
	local family = ctx.Theme.Props
	local rng = ctx.Rng
	local props: MapProps.Ctx = { Pal = ctx.Pal, Rng = rng, Shadow = false }
	local banks = MapKit.Group(decor, "Banks")
	local function nearArch(z: number): boolean
		for _, az in archZ do
			if math.abs(z - az) < 16 then
				return true
			end
		end
		return false
	end
	local finish = if #archZ > 0 then Map.ChannelStartZ - archZ[#archZ] else 5000
	local limit = finish + 400
	local bankY = MapChannel.BankTop
	local roles = { "Bush", "Rock", "Small" }
	local d = 70
	local side = 1
	local n = 0
	while d < limit do
		local step = if d < 2400 then 115 else 290
		local z = Map.ChannelStartZ - d
		if not nearArch(z) then
			local x = side * rng:NextNumber(52, 60)
			MapProps.Place(family, "Tree", banks, MapKit.CF(ctx, x, bankY, z), rng:NextNumber(1, 1.25), props)
		end
		local z2 = z - step * 0.5
		if not nearArch(z2) then
			n += 1
			local x2 = -side * rng:NextNumber(53, 64)
			MapProps.Place(family, roles[n % #roles + 1], banks, MapKit.CF(ctx, x2, bankY, z2) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), rng:NextNumber(1, 1.4), props)
		end
		d += step * rng:NextNumber(0.85, 1.15)
		side = -side
	end
	-- plateau trees peeking over the cliffs near the hub
	local plateau = MapKit.Group(decor, "Plateau")
	local topY = MapChannel.PlateauY
	d = 140
	side = 1
	while d < 1700 do
		local z = Map.ChannelStartZ - d
		MapProps.Place(family, "Tree", plateau, MapKit.CF(ctx, side * rng:NextNumber(95, 230), topY, z), rng:NextNumber(1.5, 1.9), props)
		d += rng:NextNumber(120, 170)
		side = -side
	end
	-- big stepped hills far out on the plateau break up the horizon during long flights
	local hills = MapKit.Group(decor, "Hills")
	d = 500
	side = if rng:NextNumber() < 0.5 then 1 else -1
	local hillSide = MapKit.Shade(ctx.Pal.Cliff, 0.05)
	while d < MapChannel.Length() - 300 do
		local z = Map.ChannelStartZ - d
		local w = rng:NextNumber(70, 140)
		local h = rng:NextNumber(14, 34)
		local x = side * rng:NextNumber(120 + w / 2, MapChannel.OuterX - w / 2)
		local depth = rng:NextNumber(80, 180)
		MapKit.Box(hills, MapKit.At(ctx, x - w / 2, topY - 2, z - depth / 2), MapKit.At(ctx, x + w / 2, topY + h - 3, z + depth / 2), hillSide, { Name = "Hill" })
		MapKit.Box(hills, MapKit.At(ctx, x - w / 2 - 1, topY + h - 3, z - depth / 2 - 1), MapKit.At(ctx, x + w / 2 + 1, topY + h, z + depth / 2 + 1), ctx.Pal.CliffTop, { Name = "HillTop" })
		d += rng:NextNumber(380, 620)
		side = -side
	end
	-- landmarks
	local landmarks = MapKit.Group(decor, "Landmarks")
	if family == "Volcano" then
		-- rising out of the plateau's outer edge, visible over the cliffs from the Throw Zone
		local hub = MapKit.At(ctx, 0, topY - 2, 0)
		for _, v in { { -470, -700, 1.6 }, { 560, -1800, 2 } } do
			MapProps.Volcano(landmarks, CFrame.lookAt(MapKit.At(ctx, v[1], topY - 2, v[2]), hub), v[3], props)
		end
	elseif family == "Pirate" then
		MapProps.Ship(landmarks, CFrame.lookAt(MapKit.At(ctx, -27, Map.WaterY, -260), MapKit.At(ctx, -27, Map.WaterY, -400)), 1.3, props)
		MapProps.Ship(landmarks, CFrame.lookAt(MapKit.At(ctx, 27, Map.WaterY, -1900), MapKit.At(ctx, 27, Map.WaterY, -1700)), 1.4, props)
	elseif family == "Ice" then
		for i = 0, 3 do
			local s = if i % 2 == 0 then 1 else -1
			MapProps.Crystal(landmarks, MapKit.CF(ctx, s * rng:NextNumber(110, 200), topY, Map.ChannelStartZ - 300 - i * 420), 4, props)
		end
	end
end

-- BUILD -------------------------------------------------------------------------------------------

local function countParts(root: Instance): number
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

local function section(name: string, worldId: number, fn: () -> ())
	xpcall(fn, function(err: any)
		warn(string.format("[MapBuilder] world %d: %s failed: %s\n%s", worldId, name, tostring(err), debug.traceback()))
	end)
end

-- Builds world `world` and parents "World_<id>" to `parent`. Never yields. A failing section is
-- reported and skipped so one bad definition can't take the whole world down.
function MapBuilder.Build(world: Worlds.World, parent: Instance): Model
	local theme = Themes[world.Theme] or Themes.Isles
	local origin = Map.Origin(world.Id)
	local model = Instance.new("Model")
	model.Name = "World_" .. world.Id
	model:SetAttribute("WorldId", world.Id)
	model.WorldPivot = CFrame.new(origin)
	local ctx: MapKit.Ctx = {
		World = world,
		Theme = theme,
		Pal = MapKit.Palette(theme),
		Origin = origin,
		Model = model,
		Rng = Random.new(world.Id * 7919 + 17),
	}
	local id = world.Id
	local hub = MapKit.Folder(model, "Hub")
	local stations = {
		Pads = MapKit.Folder(model, "Pads"),
		Pedestals = MapKit.Folder(model, "Pedestals"),
		Eggs = MapKit.Folder(model, "Eggs"),
		Portals = MapKit.Folder(model, "Portals"),
		Boards = MapKit.Folder(model, "Boards"),
		Zones = MapKit.Folder(model, "Zones"),
	}
	local channel = MapKit.Folder(model, "Channel")
	local decor = MapKit.Folder(model, "Decor")

	section("throw zone", id, function()
		buildThrowZone(ctx, hub)
	end)
	section("floor", id, function()
		buildFloor(ctx, hub)
	end)
	section("path", id, function()
		buildPath(ctx, hub)
	end)
	section("walls", id, function()
		buildWalls(ctx, hub)
	end)
	section("spawn", id, function()
		buildSpawn(ctx, hub)
	end)
	section("title", id, function()
		buildTitle(ctx, hub)
	end)
	section("channel", id, function()
		MapChannel.Build(ctx, channel)
	end)
	local archZ: { number } = {}
	section("zones", id, function()
		archZ = MapChannel.BuildZones(ctx, stations.Zones)
	end)
	section("pads", id, function()
		MapStations.Pads(ctx, stations.Pads)
	end)
	section("pedestals", id, function()
		MapStations.Pedestals(ctx, stations.Pedestals)
	end)
	section("eggs", id, function()
		MapStations.Eggs(ctx, stations.Eggs)
	end)
	section("portals", id, function()
		MapStations.Portals(ctx, stations.Portals)
	end)
	section("boards", id, function()
		MapStations.Boards(ctx, stations.Boards)
	end)
	section("hub decor", id, function()
		decorateHub(ctx, decor)
	end)
	section("channel decor", id, function()
		decorateChannel(ctx, decor, archZ)
	end)

	local parts = countParts(model)
	model:SetAttribute("PartCount", parts)
	if parts > MapBuilder.PartBudget then
		warn(string.format("[MapBuilder] %s uses %d parts (budget %d)", world.Name, parts, MapBuilder.PartBudget))
	end
	model.Parent = parent
	return model
end

-- Builds world 1 into a temporary folder, checks the naming contract clients rely on, destroys it.
-- Returns true when everything is in place (false and the first problem otherwise).
function MapBuilder.Validate(): (boolean, string?)
	local world = Worlds.Get(1)
	if not world then
		return false, "no world 1"
	end
	local folder = Instance.new("Folder")
	folder.Name = "MapBuilderValidate"
	local ok, result = pcall(MapBuilder.Build, world, folder)
	if not ok then
		folder:Destroy()
		return false, tostring(result)
	end
	local model = folder:FindFirstChild("World_1")
	local problem: string? = nil
	local function need(path: { string }, ...: string)
		if problem or not model then
			return
		end
		local node: Instance? = model
		for _, name in path do
			node = node and node:FindFirstChild(name)
		end
		if not node then
			problem = "missing " .. table.concat(path, "/")
			return
		end
		for _, child in { ... } do
			if not node:FindFirstChild(child, true) then
				problem = string.format("%s has no %s", table.concat(path, "/"), child)
				return
			end
		end
	end
	if not model then
		problem = "World_1 not built"
	end
	need({ "ThrowZone" })
	for _, pad in Training.ForWorld(1) do
		need({ "Pads", "Pad_" .. pad.Id }, "Label", "Gate", "Status", "Mult")
	end
	for _, glider in Gliders.ForWorld(1) do
		need({ "Pedestals", "Pedestal_" .. glider.Id }, "Base", "BuyPrompt", "Status", "Skill", "Price", "Display")
	end
	for _, relic in Relics.List do
		need({ "Pedestals", "Relic_" .. relic.Id }, "Base", "BuyPrompt", "Stock", "Title", "Bonus", "Price")
	end
	for _, egg in Eggs.ForWorld(1) do
		need({ "Eggs", "Egg_" .. egg.Id }, "Base", "HatchPrompt", "Name", "Price")
	end
	if Worlds.Get(2) then
		need({ "Portals", "Portal_2" }, "Frame", "PortalPrompt", "Name", "Requirement")
	end
	for _, entry in Map.Leaderboards do
		need({ "Boards", "Board_" .. entry.Stat }, "Board", "Title", "List")
	end
	for _, zone in Zones.ForWorld(1) do
		need({ "Zones", "ZoneSign_" .. zone.Id })
	end
	folder:Destroy()
	if problem then
		return false, problem
	end
	return true, nil
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">MapChannel</string>
            <string name="Source"><![CDATA[--!strict
-- The long glide channel of a world and its distance-zone arches. The channel runs from
-- Map.ChannelStartZ toward -Z for Flight.RenderMaxZ + 600 studs in Map.ChannelSegment-long
-- segments: water (Glass, or Neon lava), a bed, grass banks, checker cliffs and the plateau
-- behind them, a handful of long parts per segment. Checker blocks get longer with distance so
-- the far channel stays cheap. Zone arches stand at Z = ChannelStartZ - FlightSim.RenderZ(zone
-- distance), exactly where flights cross into the zone; the last zone gets a grand finish arch.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Map = require(Shared.Config.Map)
local Flight = require(Shared.Config.Flight)
local FlightSim = require(Shared.Sim.FlightSim)
local Format = require(Shared.Util.Format)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)

local MapKit = require(script.Parent.MapKit)

local MapChannel = {}

local HALF = Map.ChannelHalfWidth
local WATER_Y = Map.WaterY
MapChannel.BankTop = WATER_Y + 5 -- grass bank surface
MapChannel.CliffX = HALF + Map.BankWidth -- inner face of the cliffs
MapChannel.TopY = MapChannel.BankTop + Map.CliffHeight -- cliff top
MapChannel.PlateauY = MapChannel.TopY + 1 -- walkable surface behind the cliffs
MapChannel.OuterX = 330 -- plateau outer edge (worlds are 3200 apart)
MapChannel.SignBottom = 54 -- arch beams sit above typical flight altitude
MapChannel.SignTop = 68

local BANK_TOP = MapChannel.BankTop
local CLIFF_X = MapChannel.CliffX
local TOP_Y = MapChannel.TopY
local OUTER = MapChannel.OuterX
local CLIFF_T = 10
local PILLAR_X = HALF + 6

local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromHex("#15151C")
local PANEL = Color3.fromHex("#1B2140")
local GOLD = Color3.fromHex("#FFC93C")

-- Rendered channel length (studs).
function MapChannel.Length(): number
	return Flight.RenderMaxZ + 600
end

-- World-local Z of a zone's arch. The first zone starts at 0 m; its arch sits a few studs past the
-- Throw Zone edge so it frames the start instead of standing on it.
function MapChannel.ZoneZ(zone: Zones.Zone, world: Worlds.World): number
	return Map.ChannelStartZ - math.max(FlightSim.RenderZ(zone.Distance, world.DistanceScale), 6)
end

-- Checker block length for a stretch of cliff `d` studs down the channel. Every value divides a
-- segment into an even number of columns, so the pattern stays continuous across segments.
local function blockLength(d: number): number
	if d < 800 then
		return 12.5
	elseif d < 2800 then
		return 25
	elseif d < 5600 then
		return 50
	end
	return 100
end

local function segment(ctx: MapKit.Ctx, parent: Instance, index: number, d0: number, d1: number)
	local pal = ctx.Pal
	local at = function(x: number, y: number, z: number): Vector3
		return MapKit.At(ctx, x, y, z)
	end
	local lava = ctx.Theme.WaterMaterial == "Neon"
	local z0 = Map.ChannelStartZ - d0
	local z1 = Map.ChannelStartZ - d1
	local seg = MapKit.Group(parent, "Segment_" .. index)

	MapKit.Box(seg, at(-HALF, WATER_Y - 1, z1), at(HALF, WATER_Y, z0), pal.Water, {
		Material = MapKit.Material(ctx.Theme.WaterMaterial),
		Transparency = if lava then 0 else 0.15,
		Name = "Water",
	})
	MapKit.Box(seg, at(-HALF - 1, WATER_Y - 8, z1), at(HALF + 1, WATER_Y - 6, z0), MapKit.Shade(pal.Water, if lava then 0.6 else 0.45), {
		Solid = true,
		Shadow = false,
		Name = "Bed",
	})
	local foam = if lava then MapKit.Tint(pal.Water, 0.55) else WHITE
	local blockLen = blockLength(d0)
	for side = -1, 1, 2 do
		MapKit.Box(seg, at(side * HALF, WATER_Y - 7, z1), at(side * CLIFF_X, BANK_TOP - 1, z0), MapKit.Shade(pal.Cliff, 0.12), {
			Solid = true,
			Name = "Bank",
		})
		MapKit.Box(seg, at(side * (HALF - 0.6), BANK_TOP - 1, z1), at(side * CLIFF_X, BANK_TOP, z0), pal.CliffTop, {
			Solid = true,
			Name = "Grass",
		})
		MapKit.Box(seg, at(side * (HALF - 2.4), WATER_Y, z1), at(side * (HALF - 0.6), WATER_Y + 0.12, z0), foam, {
			Transparency = 0.25,
			Name = "Foam",
		})
		MapKit.CheckerWall(seg, at(side * CLIFF_X, BANK_TOP, z0), at(side * CLIFF_X, BANK_TOP, z1), Vector3.new(-side, 0, 0), Map.CliffHeight, pal.Cliff, pal.CliffAlt, pal.CliffTop, {
			Thickness = CLIFF_T,
			BlockLength = blockLen,
			Rows = 2,
			Below = 2,
		})
		MapKit.Box(seg, at(side * (CLIFF_X - 1), TOP_Y - 3, z1), at(side * OUTER, MapChannel.PlateauY, z0), pal.CliffTop, {
			Solid = true,
			Shadow = false,
			Name = "Plateau",
		})
	end
end

-- Water, banks, cliffs and plateau for the whole channel, plus the cap at the far end.
function MapChannel.Build(ctx: MapKit.Ctx, parent: Instance)
	local length = MapChannel.Length()
	local step = Map.ChannelSegment
	local count = math.ceil(length / step)
	for k = 0, count - 1 do
		segment(ctx, parent, k + 1, k * step, math.min(length, (k + 1) * step))
	end
	-- end wall across the channel (fog normally hides it)
	local pal = ctx.Pal
	local endZ = Map.ChannelStartZ - length
	local cap = MapKit.Group(parent, "EndCap")
	MapKit.Box(cap, MapKit.At(ctx, -OUTER, WATER_Y - 8, endZ - 14), MapKit.At(ctx, OUTER, MapChannel.PlateauY, endZ - 2), pal.Cliff, {
		Solid = true,
		Name = "Wall",
	})
	MapKit.CheckerWall(cap, MapKit.At(ctx, -CLIFF_X, WATER_Y - 1, endZ), MapKit.At(ctx, CLIFF_X, WATER_Y - 1, endZ), Vector3.new(0, 0, 1), TOP_Y - WATER_Y + 1, pal.Cliff, pal.CliffAlt, pal.CliffTop, {
		Thickness = 2,
		BlockLength = 14,
		Rows = 2,
	})
end

-- ZONE ARCHES -------------------------------------------------------------------------------------

local function signText(gui: SurfaceGui, name: string, text: string, y: number, h: number, color: Color3, strokeWidth: number)
	local label = MapKit.Text(gui, name, text, y, h, color, {
		Stroke = if MapKit.Luminance(color) > 0.9 then MapKit.StrokeColor else WHITE,
		StrokeThickness = strokeWidth,
	})
	label.Position = UDim2.fromScale(0.03, y)
	label.Size = UDim2.fromScale(0.94, h)
end

-- Neon line across the water where the zone begins, with a buoy at each end.
local function waterLine(ctx: MapKit.Ctx, sign: Model, z: number, color: Color3)
	MapKit.Box(sign, MapKit.At(ctx, -HALF, WATER_Y, z - 0.6), MapKit.At(ctx, HALF, WATER_Y + 0.15, z + 0.6), color, {
		Material = NEON,
		Transparency = 0.15,
		Name = "Line",
	})
	for side = -1, 1, 2 do
		MapKit.Ball(sign, 3, MapKit.CF(ctx, side * (HALF - 4), WATER_Y + 0.4, z), color, { Name = "Buoy" })
	end
end

local function pillar(ctx: MapKit.Ctx, sign: Model, x: number, z: number, width: number, top: number, color: Color3, band: Color3)
	local h = top - BANK_TOP
	MapKit.Part(sign, Vector3.new(width, h, width), MapKit.CF(ctx, x, BANK_TOP + h / 2, z), color, {
		Shadow = true,
		Name = "Pillar",
	})
	for _, y in { BANK_TOP + h * 0.3, BANK_TOP + h * 0.65 } do
		MapKit.Part(sign, Vector3.new(width + 0.8, 2.6, width + 0.8), MapKit.CF(ctx, x, y, z), band, { Name = "Band" })
	end
	MapKit.Part(sign, Vector3.new(width + 1, 3, width + 1), MapKit.CF(ctx, x, top + 1.5, z), band, {
		Material = NEON,
		Name = "Cap",
	})
end

-- Sign panel facing the hub (+Z) with a coloured border; returns the panel and its SurfaceGui.
local function panel(ctx: MapKit.Ctx, sign: Model, z: number, width: number, bottom: number, top: number, border: Color3, ppsHint: number): (Part, SurfaceGui)
	local h = top - bottom
	local center = MapKit.At(ctx, 0, bottom + h / 2, z)
	local board = MapKit.Part(sign, Vector3.new(width, h, 2.4), MapKit.Facing(center, Vector3.zAxis), PANEL, {
		Shadow = true,
		Name = "Panel",
	})
	MapKit.Part(sign, Vector3.new(width + 3, h + 3, 2), MapKit.Facing(center - Vector3.new(0, 0, 0.6), Vector3.zAxis), border, {
		Name = "Border",
	})
	local gui = MapKit.Surface(board, "Sign", Enum.NormalId.Front, ppsHint)
	return board, gui
end

local function arch(ctx: MapKit.Ctx, sign: Model, zone: Zones.Zone, z: number)
	local color = MapKit.Hex(zone.Color)
	local stone = ctx.Pal.Stone
	for side = -1, 1, 2 do
		pillar(ctx, sign, side * PILLAR_X, z, 5, MapChannel.SignTop, stone, color)
	end
	local board, gui = panel(ctx, sign, z, PILLAR_X * 2 + 10, MapChannel.SignBottom, MapChannel.SignTop, color, 10)
	signText(gui, "Name", string.upper(zone.Name), 0.04, 0.6, color, 4)
	signText(gui, "Distance", Format.Meters(zone.Distance), 0.66, 0.3, WHITE, 3)
	sign.PrimaryPart = board
	waterLine(ctx, sign, z, color)
end

-- Grand finish arch for the last zone: chequered pillars and flag row, a big rainbow sign and a
-- teaser for the next world.
local function finishArch(ctx: MapKit.Ctx, sign: Model, zone: Zones.Zone, z: number)
	local color = MapKit.Hex(zone.Color)
	local top = MapChannel.SignTop + 8
	local bottom = MapChannel.SignBottom - 4
	local x = PILLAR_X + 2
	for side = -1, 1, 2 do
		local h = top - BANK_TOP
		MapKit.Part(sign, Vector3.new(8, h, 8), MapKit.CF(ctx, side * x, BANK_TOP + h / 2, z), WHITE, {
			Shadow = true,
			Name = "Pillar",
		})
		for i = 0, 3 do
			local y = BANK_TOP + h * (0.12 + i * 0.22)
			MapKit.Part(sign, Vector3.new(8.6, h * 0.11, 8.6), MapKit.CF(ctx, side * x, y, z), BLACK, { Name = "Check" })
		end
		local cap = MapKit.Part(sign, Vector3.new(9.5, 4, 9.5), MapKit.CF(ctx, side * x, top + 2, z), GOLD, {
			Material = NEON,
			Name = "Cap",
		})
		MapKit.Sparkles(cap, GOLD, 8, 9)
	end
	local width = x * 2 + 14
	local board, gui = panel(ctx, sign, z, width, bottom, top, GOLD, 10)
	sign.PrimaryPart = board
	local title = MapKit.Text(gui, "Title", "🏁 END OF THE RIVER 🏁", 0.03, 0.42, WHITE, { StrokeThickness = 5 })
	MapKit.Gradient(title, MapKit.Rainbow)
	signText(gui, "Name", string.upper(zone.Name) .. "  •  " .. Format.Meters(zone.Distance), 0.47, 0.24, color, 3)
	local nextWorld = Worlds.Get(ctx.World.Id + 1)
	local teaser = if nextWorld then nextWorld.Name .. " awaits!" else "You reached the edge of the sky!"
	signText(gui, "Next", teaser, 0.73, 0.23, GOLD, 3)
	-- chequered flag row on top of the panel
	local cells = 8
	local cellW = width / cells
	for i = 0, cells - 1 do
		local cx = -width / 2 + cellW * (i + 0.5)
		MapKit.Part(sign, Vector3.new(cellW, 4, 2.6), MapKit.CF(ctx, cx, top + 3.5, z), if i % 2 == 0 then BLACK else WHITE, {
			Name = "Flag",
		})
	end
	-- chequered finish line across the water
	MapKit.Box(sign, MapKit.At(ctx, -HALF, WATER_Y, z - 2), MapKit.At(ctx, HALF, WATER_Y + 0.15, z + 2), WHITE, { Name = "Finish" })
	local tiles = 8
	local tileW = HALF * 2 / tiles
	for i = 0, tiles - 1 do
		for row = 0, 1 do
			if (i + row) % 2 == 0 then
				local cx = -HALF + tileW * (i + 0.5)
				MapKit.Part(sign, Vector3.new(tileW, 0.2, 2), MapKit.CF(ctx, cx, WATER_Y + 0.12, z - 1 + row * 2), BLACK, { Name = "FinishTile" })
			end
		end
	end
end

-- One ZoneSign_<zoneId> model per zone of the world (see docs/DESIGN.md §5).
function MapChannel.BuildZones(ctx: MapKit.Ctx, parent: Instance): { number }
	local zones = Zones.ForWorld(ctx.World.Id)
	local positions = {}
	for i, zone in zones do
		local z = MapChannel.ZoneZ(zone, ctx.World)
		local sign = Instance.new("Model")
		sign.Name = "ZoneSign_" .. zone.Id
		sign:SetAttribute("Zone", zone.Id)
		sign:SetAttribute("Distance", zone.Distance)
		if i == #zones then
			finishArch(ctx, sign, zone, z)
		else
			arch(ctx, sign, zone, z)
		end
		sign.Parent = parent
		table.insert(positions, z)
	end
	return positions
end

return MapChannel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[--!strict
-- Primitive builders for the procedural map (server side): parts, boxes, discs, balls, wedges,
-- floor decals, checker walls, surface/billboard text, proximity prompts, lights, particles and
-- animated beam rings. Every part is anchored. Decoration is non-colliding, non-queryable and
-- non-touchable, and only solid structure casts shadows unless asked. Text uses built-in fonts and
-- emoji only, and textures are built-in rbxasset:// files (no uploaded assets).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Themes = require(Shared.Visual.Themes)
local Worlds = require(Shared.Definitions.Worlds)

local MapKit = {}

export type Palette = {
	FloorA: Color3,
	FloorB: Color3,
	Path: Color3,
	Cliff: Color3,
	CliffAlt: Color3,
	CliffTop: Color3,
	Water: Color3,
	ThrowZone: Color3,
	ThrowZoneText: Color3,
	Accent: Color3,
	Trunk: Color3,
	Leaves: Color3,
	Rock: Color3, -- derived from the prop family
	Stone: Color3, -- light stone for pedestals, pillars and stands
}

export type PartOpts = {
	Material: Enum.Material?,
	Transparency: number?,
	Solid: boolean?, -- collides and can be raycast (default false)
	Shadow: boolean?, -- casts shadows (default = Solid)
	Shape: Enum.PartType?,
	Name: string?,
	Reflectance: number?,
}

export type TextOpts = {
	Font: Font?,
	Stroke: Color3?,
	StrokeThickness: number?,
	XAlign: Enum.TextXAlignment?,
	Transparency: number?,
	Rich: boolean?,
}

export type WallOpts = {
	Thickness: number,
	BlockLength: number, -- target checker block length along the wall
	Rows: number, -- checker rows over the wall height
	Below: number?, -- extra solid depth under the base line (hides gaps)
	ExtendStart: number?, -- base wall extends past `a` by this much (corners)
	ExtendEnd: number?,
	Cap: boolean?, -- grass cap on top
	CapOverhang: number?,
	Drips: Random?, -- when set, grass blocks "drip" down the inner face at random columns
	Solid: boolean?,
	Parity: number?, -- 0/1 flips the checker
}

-- Everything one world build shares (MapBuilder creates it, the section builders read it).
export type Ctx = {
	World: Worlds.World,
	Theme: Themes.Theme,
	Pal: Palette,
	Origin: Vector3, -- Map.Origin(world.Id); every layout coordinate is relative to it
	Model: Model, -- World_<id>
	Rng: Random, -- seeded per world: the same world always builds the same way
}

local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis (local X) -> world up

MapKit.Fonts = {
	Display = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Regular),
	Numbers = Font.new("rbxasset://fonts/families/LuckiestGuy.json", Enum.FontWeight.Regular),
	Body = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold),
}
MapKit.StrokeColor = Color3.fromHex("#0B0F24")
MapKit.White = WHITE
MapKit.Black = BLACK

MapKit.SparkTexture = "rbxasset://textures/particles/sparkles_main.dds"
MapKit.SmokeTexture = "rbxasset://textures/particles/smoke_main.dds"

local ROCK: { [string]: string } = {
	Palm = "#A7ADB5",
	Volcano = "#2E2A2A",
	Pirate = "#A39E93",
	Ice = "#B9C7D9",
}

local STONE: { [string]: string } = {
	Palm = "#F3EFE6",
	Volcano = "#4A4040",
	Pirate = "#EADCC0",
	Ice = "#F4FAFF",
}

-- World-local layout coordinates -> world space.
function MapKit.At(ctx: Ctx, x: number, y: number, z: number): Vector3
	return ctx.Origin + Vector3.new(x, y, z)
end

function MapKit.CF(ctx: Ctx, x: number, y: number, z: number): CFrame
	return CFrame.new(ctx.Origin + Vector3.new(x, y, z))
end

function MapKit.Folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function MapKit.Group(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- "#RRGGBB" -> Color3 with a fallback for malformed strings (definitions are data).
function MapKit.Hex(hex: string?, fallback: Color3?): Color3
	if type(hex) == "string" then
		local ok, color = pcall(Color3.fromHex, hex)
		if ok then
			return color
		end
	end
	return fallback or WHITE
end

function MapKit.Palette(theme: Themes.Theme): Palette
	local h = MapKit.Hex
	return {
		FloorA = h(theme.FloorA),
		FloorB = h(theme.FloorB),
		Path = h(theme.Path),
		Cliff = h(theme.Cliff),
		CliffAlt = h(theme.CliffAlt),
		CliffTop = h(theme.CliffTop),
		Water = h(theme.Water),
		ThrowZone = h(theme.ThrowZone),
		ThrowZoneText = h(theme.ThrowZoneText),
		Accent = h(theme.Accent),
		Trunk = h(theme.Trunk),
		Leaves = h(theme.Leaves),
		Rock = h(ROCK[theme.Props] or ROCK.Palm),
		Stone = h(STONE[theme.Props] or STONE.Palm),
	}
end

function MapKit.Shade(c: Color3, amount: number): Color3
	return c:Lerp(BLACK, amount)
end

function MapKit.Tint(c: Color3, amount: number): Color3
	return c:Lerp(WHITE, amount)
end

-- Perceived brightness 0..1.
function MapKit.Luminance(c: Color3): number
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

-- Readable outline for text of colour `c`: dark for light text, white for dark text.
function MapKit.StrokeFor(c: Color3): Color3
	return if MapKit.Luminance(c) > 0.45 then MapKit.StrokeColor else WHITE
end

function MapKit.Material(name: string): Enum.Material
	if name == "Neon" then
		return Enum.Material.Neon
	elseif name == "Glass" then
		return Enum.Material.Glass
	elseif name == "Ice" then
		return Enum.Material.Ice
	end
	return Enum.Material.SmoothPlastic
end

local function finish(p: BasePart, parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: PartOpts?)
	p.Anchored = true
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	p.CFrame = cf
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local solid = false
	local shadow = false
	p.Material = Enum.Material.SmoothPlastic
	if opts then
		solid = opts.Solid == true
		shadow = if opts.Shadow ~= nil then opts.Shadow else solid
		if opts.Material then
			p.Material = opts.Material
		end
		if opts.Transparency then
			p.Transparency = opts.Transparency
		end
		if opts.Reflectance then
			p.Reflectance = opts.Reflectance
		end
		if opts.Name then
			p.Name = opts.Name
		end
	end
	p.CanCollide = solid
	p.CanQuery = solid -- CanQuery may only be off when CanCollide is off
	p.CanTouch = false
	p.CastShadow = shadow
	p.Parent = parent
end

-- Block (or opts.Shape) centred on `cf`.
function MapKit.Part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: PartOpts?): Part
	local p = Instance.new("Part")
	if opts and opts.Shape then
		p.Shape = opts.Shape
	end
	finish(p, parent, size, cf, color, opts)
	return p
end

-- Axis-aligned block spanning two opposite corners (world coordinates).
function MapKit.Box(parent: Instance, a: Vector3, b: Vector3, color: Color3, opts: PartOpts?): Part
	local lo = a:Min(b)
	local hi = a:Max(b)
	return MapKit.Part(parent, hi - lo, CFrame.new((lo + hi) / 2), color, opts)
end

-- Wedge: full height at local +Z, sloping down to local -Z.
function MapKit.Wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: PartOpts?): WedgePart
	local p = Instance.new("WedgePart")
	finish(p, parent, size, cf, color, opts)
	return p
end

-- Upright cylinder (axis = world up of `cf`), centred on `cf`.
function MapKit.Disc(parent: Instance, diameter: number, height: number, cf: CFrame, color: Color3, opts: PartOpts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	finish(p, parent, Vector3.new(height, diameter, diameter), cf * UPRIGHT, color, opts)
	return p
end

-- Cylinder whose flat faces point along `cf`'s look vector (portals, wheels, signs).
function MapKit.FacingDisc(parent: Instance, diameter: number, thickness: number, cf: CFrame, color: Color3, opts: PartOpts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	finish(p, parent, Vector3.new(thickness, diameter, diameter), cf * CFrame.Angles(0, math.pi / 2, 0), color, opts)
	return p
end

function MapKit.Ball(parent: Instance, diameter: number, cf: CFrame, color: Color3, opts: PartOpts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	finish(p, parent, Vector3.new(diameter, diameter, diameter), cf, color, opts)
	return p
end

-- Block running from `from` to `to` (trunks, rails, lava falls); `width` x `depth` cross-section.
function MapKit.Beam(parent: Instance, from: Vector3, to: Vector3, width: number, depth: number, color: Color3, opts: PartOpts?): Part
	local length = (to - from).Magnitude
	local mid = (from + to) / 2
	local dir = to - from
	local cf: CFrame
	if length < 1e-4 then
		cf = CFrame.new(mid)
	else
		local up = if math.abs(dir.Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
		cf = CFrame.lookAt(mid, to, up)
	end
	return MapKit.Part(parent, Vector3.new(width, depth, length), cf, color, opts)
end

-- CFrame whose Front face (local -Z) points along `dir`, so a Front SurfaceGui faces that way.
function MapKit.Facing(position: Vector3, dir: Vector3): CFrame
	return CFrame.lookAt(position, position + dir)
end

-- Invisible flat part lying on the ground with its Front face pointing up. A Front SurfaceGui on
-- it reads upright for someone looking along `up` (horizontal unit vector = the text's top).
function MapKit.FloorDecal(parent: Instance, center: Vector3, up: Vector3, width: number, height: number): Part
	local y = up.Unit
	local z = Vector3.new(0, -1, 0)
	local x = y:Cross(z)
	return MapKit.Part(parent, Vector3.new(width, height, 0.05), CFrame.fromMatrix(center, x, y, z), WHITE, {
		Transparency = 1,
		Name = "Decal",
	})
end

-- Checker wall whose inner face runs along the line a -> b (both at the wall's base height),
-- facing `inward`. One solid base slab plus alternate-colour blocks that stand 0.6 studs proud of
-- the inner face, so it reads as voxel blocks with a handful of parts.
function MapKit.CheckerWall(parent: Instance, a: Vector3, b: Vector3, inward: Vector3, height: number, colorA: Color3, colorB: Color3, top: Color3, o: WallOpts)
	local along = b - a
	local length = along.Magnitude
	if length < 0.5 or height <= 0 then
		return
	end
	local dir = along.Unit
	local up = Vector3.yAxis
	local n = inward.Unit
	local thickness = o.Thickness
	local below = o.Below or 0
	local e0 = o.ExtendStart or 0
	local e1 = o.ExtendEnd or 0
	local solid = if o.Solid == nil then true else o.Solid
	-- base slab
	local baseStart = a - dir * e0
	local baseEnd = b + dir * e1
	local baseLen = length + e0 + e1
	local mid = (baseStart + baseEnd) / 2 - n * (thickness / 2) + up * ((height - below) / 2)
	MapKit.Part(parent, Vector3.new(baseLen, height + below, thickness), CFrame.lookAt(mid, mid + n), colorA, {
		Solid = solid,
		Shadow = true,
		Name = "Wall",
	})
	-- checker blocks on the inner face
	local columns = math.max(1, math.floor(length / o.BlockLength + 0.5))
	local rows = math.max(1, o.Rows)
	local bl = length / columns
	local rh = height / rows
	local parity = o.Parity or 0
	for c = 0, columns - 1 do
		for r = 0, rows - 1 do
			if (c + r + parity) % 2 == 1 then
				local center = a + dir * (bl * (c + 0.5)) + up * (rh * (r + 0.5))
				MapKit.Part(parent, Vector3.new(bl, rh, 1.2), CFrame.lookAt(center, center + n), colorB, { Name = "Block" })
			end
		end
	end
	if o.Cap then
		local over = o.CapOverhang or 1
		local capMid = (baseStart + baseEnd) / 2 + n * (over / 2) - n * (thickness / 2) + up * (height + 0.75)
		MapKit.Part(parent, Vector3.new(baseLen, 2.5, thickness + over), CFrame.lookAt(capMid, capMid + n), top, {
			Solid = solid,
			Shadow = true,
			Name = "Cap",
		})
		local rng = o.Drips
		if rng then
			for c = 0, columns - 1 do
				if rng:NextNumber() < 0.35 then
					local drop = rh * rng:NextNumber(0.25, 0.55)
					local center = a + dir * (bl * (c + 0.5)) + up * (height - drop / 2) + n * 0.5
					MapKit.Part(parent, Vector3.new(bl * rng:NextNumber(0.4, 0.9), drop, 1.4), CFrame.lookAt(center, center + n), top, {
						Name = "Drip",
					})
				end
			end
		end
	end
end

-- SurfaceGui sized in pixels per stud (crisp at any part size), unlit so colours stay bright.
function MapKit.Surface(part: BasePart, name: string, face: Enum.NormalId, pixelsPerStud: number): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ClipsDescendants = true
	gui.Parent = part
	return gui
end

-- World-sized billboard (Scale sizes are studs, so text shrinks with distance like real signs).
function MapKit.Billboard(part: BasePart, name: string, width: number, height: number, offsetY: number, maxDistance: number): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = UDim2.fromScale(width, height)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = part
	return gui
end

-- Scaled, stroked TextLabel. Position/size are fractions of the parent.
function MapKit.Text(parent: Instance, name: string, text: string, y: number, height: number, color: Color3, opts: TextOpts?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.fromScale(0, y)
	label.Size = UDim2.fromScale(1, height)
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.RichText = opts ~= nil and opts.Rich == true
	label.FontFace = (opts and opts.Font) or MapKit.Fonts.Display
	label.TextXAlignment = (opts and opts.XAlign) or Enum.TextXAlignment.Center
	label.TextTransparency = (opts and opts.Transparency) or 0
	local stroke = Instance.new("UIStroke")
	stroke.Color = (opts and opts.Stroke) or MapKit.StrokeColor
	stroke.Thickness = (opts and opts.StrokeThickness) or 2
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Transparency = (opts and opts.Transparency) or 0
	stroke.Parent = label
	label.Parent = parent
	return label
end

function MapKit.Corner(gui: GuiObject, scale: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(scale, 0)
	corner.Parent = gui
end

-- Horizontal colour gradient over a GuiObject (rainbow titles, sign panels).
function MapKit.Gradient(gui: GuiObject, colors: { Color3 }): UIGradient
	local keys = {}
	local count = #colors
	for i, c in colors do
		local t = if count > 1 then (i - 1) / (count - 1) else 0
		table.insert(keys, ColorSequenceKeypoint.new(t, c))
	end
	if count == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, colors[1]))
	end
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(keys)
	gradient.Parent = gui
	return gradient
end

MapKit.Rainbow = {
	Color3.fromHex("#FF4F4F"),
	Color3.fromHex("#FFB13D"),
	Color3.fromHex("#FFF05A"),
	Color3.fromHex("#5BE05B"),
	Color3.fromHex("#3FA9FF"),
	Color3.fromHex("#B65CFF"),
}

-- Interaction prompt shared by pedestals, eggs and portals (E / gamepad X, instant).
function MapKit.Prompt(parent: Instance, name: string, objectText: string, actionText: string, distance: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ObjectText = objectText
	prompt.ActionText = actionText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = distance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	prompt.Parent = parent
	return prompt
end

function MapKit.Light(part: BasePart, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = part
	return light
end

-- Soft rising sparkles (pedestal glows, portals, treasure).
function MapKit.Sparkles(part: BasePart, color: Color3, rate: number, speed: number): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Sparkles"
	pe.Texture = MapKit.SparkTexture
	pe.Color = ColorSequence.new(color, WHITE)
	pe.LightEmission = 1
	pe.LightInfluence = 0
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(1, 1.8)
	pe.Rate = rate
	pe.Speed = NumberRange.new(speed * 0.6, speed)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-90, 90)
	pe.Parent = part
	return pe
end

-- Slow dark smoke plume (volcano craters, lava vents).
function MapKit.Smoke(part: BasePart, color: Color3, size: number, rate: number): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Smoke"
	pe.Texture = MapKit.SmokeTexture
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 0
	pe.LightInfluence = 1
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size * 0.4),
		NumberSequenceKeypoint.new(1, size),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(5, 8)
	pe.Rate = rate
	pe.Speed = NumberRange.new(size * 0.15, size * 0.3)
	pe.SpreadAngle = Vector2.new(12, 12)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-20, 20)
	pe.Parent = part
	return pe
end

local function ringAttachment(part: BasePart, name: string, x: number): Attachment
	local att = Instance.new("Attachment")
	att.Name = name
	-- attachment X axis (the beam's curve direction) = the part's up vector
	att.CFrame = CFrame.fromMatrix(Vector3.new(x, 0, 0), Vector3.yAxis, -Vector3.xAxis)
	att.Parent = part
	return att
end

-- Animated glowing ring in `part`'s local XY plane, centred on the part: two semicircular beams
-- whose sparkle texture scrolls around the circle natively (no scripts). Positive `speed` runs
-- clockwise seen from the part's front.
function MapKit.BeamRing(part: BasePart, radius: number, width: number, color: Color3, speed: number, transparency: number?)
	local left = ringAttachment(part, "RingL" .. radius, -radius)
	local right = ringAttachment(part, "RingR" .. radius, radius)
	local k = radius * 4 / 3 -- cubic Bezier control distance for a semicircle
	local function beam(a0: Attachment, a1: Attachment, c0: number, c1: number)
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.CurveSize0 = c0
		b.CurveSize1 = c1
		b.Segments = 24
		b.Width0 = width
		b.Width1 = width
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Color = ColorSequence.new(color)
		b.Transparency = NumberSequence.new(transparency or 0.1)
		b.Texture = MapKit.SparkTexture
		b.TextureMode = Enum.TextureMode.Wrap
		b.TextureLength = math.max(2, width * 1.5)
		b.TextureSpeed = speed
		b.Parent = part
	end
	beam(left, right, k, -k) -- over the top
	beam(right, left, -k, k) -- back underneath
end

return MapKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">MapProps</string>
            <string name="Source"><![CDATA[--!strict
-- Decoration props for the procedural worlds, built from plain parts in the bright voxel style:
-- palms, bushes, flowers, rocks, beach umbrellas (Palm); volcanoes with lava falls, lava pools,
-- dark spires, a dragon statue (Volcano); a pirate ship, barrels, crates, treasure chests, skull
-- flags (Pirate); snowy pines, ice spikes, igloos, crystals (Ice). Every prop is a small Model of
-- anchored, non-colliding, non-queryable parts. `base` is a CFrame on the ground (its look vector
-- is the prop's facing), `s` scales the prop. Randomness comes from the caller's seeded Random so
-- a world always builds the same way.
local MapKit = require(script.Parent.MapKit)

local MapProps = {}

export type Ctx = {
	Pal: MapKit.Palette,
	Rng: Random,
	Shadow: boolean, -- big hub props cast shadows; far channel props don't
}

type Builder = (parent: Instance, base: CFrame, s: number, ctx: Ctx) -> ()

local hex = Color3.fromHex
local Part, Beam, Ball, Disc, Wedge = MapKit.Part, MapKit.Beam, MapKit.Ball, MapKit.Disc, MapKit.Wedge
local Shade, Tint = MapKit.Shade, MapKit.Tint
local NEON = Enum.Material.Neon

local FLOWER_COLORS = { hex("#FF5FA2"), hex("#FFD447"), hex("#FFFFFF"), hex("#FF6B4A"), hex("#B98CFF") }
local LAVA = hex("#FF6A1F")
local LAVA_HOT = hex("#FFC23D")
local GOLD = hex("#FFC93C")
local WOOD = hex("#9A6235")
local WOOD_DARK = hex("#6B4022")
local METAL = hex("#3B3F4A")
local SNOW = hex("#FFFFFF")
local ICE = hex("#BFEFFF")

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function deco(ctx: Ctx, material: Enum.Material?, transparency: number?): MapKit.PartOpts
	return { Shadow = ctx.Shadow, Material = material, Transparency = transparency }
end

-- Small detail parts never cast shadows.
local FLAT: MapKit.PartOpts = { Shadow = false }

local function yaw(rng: Random): CFrame
	return CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
end

-- PALM ------------------------------------------------------------------------------------------

function MapProps.Palm(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Palm")
	local rng = ctx.Rng
	local pal = ctx.Pal
	local height = 17 * s * rng:NextNumber(0.85, 1.15)
	local bend = rng:NextNumber(-5, 5) * s
	local frame = base * yaw(rng)
	local prev = frame.Position
	local top = prev
	for i = 1, 3 do
		local t = i / 3
		local point = frame * Vector3.new(bend * t * t, height * t, 0)
		local color = if i % 2 == 0 then Shade(pal.Trunk, 0.15) else pal.Trunk
		local w = (2 - 0.3 * i) * s
		Beam(m, prev - (point - prev).Unit * 0.4 * s, point, w, w, color, deco(ctx))
		prev = point
		top = point
	end
	local leaves = 5
	local spin = rng:NextNumber(0, math.pi * 2)
	for k = 1, leaves do
		local a = spin + (k / leaves) * math.pi * 2
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local tip = top + out * (7.5 * s) + Vector3.new(0, -3 * s, 0)
		local color = if k % 2 == 0 then Tint(pal.Leaves, 0.12) else pal.Leaves
		Beam(m, top + Vector3.new(0, 0.6 * s, 0), tip, 2.8 * s, 0.6 * s, color, deco(ctx))
	end
	Ball(m, 1.3 * s, CFrame.new(top + Vector3.new(0.8 * s, -0.9 * s, 0.3 * s)), hex("#6B4A2B"), FLAT)
	Ball(m, 1.3 * s, CFrame.new(top + Vector3.new(-0.5 * s, -1 * s, -0.7 * s)), hex("#7A5632"), FLAT)
end

function MapProps.Bush(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Bush")
	local rng = ctx.Rng
	local color = ctx.Pal.Leaves
	local offsets = { Vector3.new(0, 0.9, 0), Vector3.new(2.2, 0.5, 0.8), Vector3.new(-1.8, 0.4, -0.9) }
	local sizes = { 4.4, 3.2, 2.8 }
	for i, o in offsets do
		local c = if i == 2 then Tint(color, 0.1) elseif i == 3 then Shade(color, 0.1) else color
		Ball(m, sizes[i] * s * rng:NextNumber(0.9, 1.1), base * CFrame.new(o * s), c, FLAT)
	end
end

function MapProps.Flower(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Flowers")
	local rng = ctx.Rng
	for i = 1, 2 do
		local spot = base * CFrame.new((i - 1.5) * 1.6 * s, 0, rng:NextNumber(-0.8, 0.8) * s)
		local h = rng:NextNumber(1.4, 2.2) * s
		Beam(m, spot.Position, spot.Position + Vector3.new(0, h, 0), 0.3 * s, 0.3 * s, hex("#3FAF3A"), FLAT)
		local color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
		Ball(m, 1.2 * s, CFrame.new(spot.Position + Vector3.new(0, h + 0.3 * s, 0)), color, FLAT)
	end
end

function MapProps.Rock(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Rock")
	local rng = ctx.Rng
	local color = ctx.Pal.Rock
	local tilt = CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, math.pi), rng:NextNumber(-0.15, 0.15))
	Part(m, Vector3.new(4.2, 2.8, 3.4) * s, base * CFrame.new(0, 1 * s, 0) * tilt, color, deco(ctx))
	Part(m, Vector3.new(2.2, 1.6, 2) * s, base * CFrame.new(2.6 * s, 0.5 * s, 1.2 * s) * yaw(rng), Shade(color, 0.12), FLAT)
end

function MapProps.Umbrella(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Umbrella")
	local rng = ctx.Rng
	local colors = { hex("#FF5A5A"), hex("#3FA9FF"), hex("#FFB13D"), hex("#B65CFF") }
	local color = colors[rng:NextInteger(1, #colors)]
	local tilt = base * CFrame.Angles(0.12, 0, 0.05)
	local top = (tilt * CFrame.new(0, 9 * s, 0)).Position
	Beam(m, base.Position, top, 0.45 * s, 0.45 * s, SNOW, FLAT)
	Disc(m, 11 * s, 0.6 * s, tilt * CFrame.new(0, 8.6 * s, 0), color, deco(ctx))
	Disc(m, 6 * s, 0.7 * s, tilt * CFrame.new(0, 8.75 * s, 0), SNOW, FLAT)
	Ball(m, 0.9 * s, CFrame.new(top + Vector3.new(0, 0.3 * s, 0)), color, FLAT)
	-- beach towel beside it
	Part(m, Vector3.new(3.4, 0.12, 6.5) * s, base * CFrame.new(3.5 * s, 0.06, 1 * s) * CFrame.Angles(0, 0.3, 0), Tint(color, 0.35), FLAT)
end

-- VOLCANO -----------------------------------------------------------------------------------------

-- Huge stepped cone with a lava crater, neon lava falls (on the side `base` faces) and a smoke
-- plume (background landmark).
function MapProps.Volcano(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Volcano")
	local pal = ctx.Pal
	local tiers = 5
	local tierH = 26 * s
	local bottom = 300 * s
	local topD = bottom * 0.3
	for i = 0, tiers - 1 do
		local d = bottom + (topD - bottom) * (i / (tiers - 1))
		local color = if i % 2 == 0 then pal.Cliff else pal.CliffAlt
		Disc(m, d, tierH, base * CFrame.new(0, tierH * (i + 0.5), 0), color, { Shadow = false })
	end
	local crestY = tierH * tiers
	local lava = Disc(m, topD * 0.7, 1, base * CFrame.new(0, crestY + 0.2, 0), LAVA, { Material = NEON })
	MapKit.Smoke(lava, hex("#3A3236"), math.min(60 * s, 90), 1.2)
	MapKit.Light(lava, LAVA_HOT, 60, 3)
	-- lava falls down three sides: the tier corners are collinear, so a slab laid just outside
	-- that line reads as lava pouring over every step
	local rTop = topD / 2 - 3 * s
	local rFoot = bottom / 2 + (bottom - topD) / (2 * (tiers - 1))
	local push = 3 * s
	for k = 0, 2 do
		-- fanned around the facing direction (local -Z), so the falls face the viewer
		local a = math.rad(-90 + (k - 1) * 38)
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local from = (base * CFrame.new(out * (rTop + push) + Vector3.new(0, crestY + 0.6, 0))).Position
		local to = (base * CFrame.new(out * (rFoot + push))).Position
		Beam(m, from, to, 12 * s, 2 * s, if k == 1 then LAVA_HOT else LAVA, { Material = NEON })
	end
end

function MapProps.LavaPool(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "LavaPool")
	Disc(m, 15 * s, 1, base * CFrame.new(0, 0.5, 0), ctx.Pal.Rock, FLAT)
	local lava = Disc(m, 11.5 * s, 1.1, base * CFrame.new(0, 0.6, 0), LAVA, { Material = NEON })
	if ctx.Shadow then -- hub pools glow; the many bank pools skip the light
		MapKit.Light(lava, LAVA_HOT, 18 * s, 2)
	end
end

-- Jagged dark rock spire with a glowing crack (the volcano world's "tree").
function MapProps.Spire(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Spire")
	local rng = ctx.Rng
	local color = ctx.Pal.Rock
	local frame = base * yaw(rng)
	local h = 0
	for i = 1, 3 do
		local w = (5.5 - i * 1.3) * s
		local seg = (7 - i) * s
		Part(m, Vector3.new(w, seg, w), frame * CFrame.new(rng:NextNumber(-0.4, 0.4) * s, h + seg / 2, 0) * CFrame.Angles(0, i * 0.5, rng:NextNumber(-0.08, 0.08)), if i == 2 then Shade(color, 0.2) else color, deco(ctx))
		h += seg
	end
	Part(m, Vector3.new(0.5 * s, h * 0.7, 0.3 * s), frame * CFrame.new(0, h * 0.4, -2.2 * s), LAVA, { Material = NEON })
end

-- Charred tree with two bare branches.
function MapProps.DeadTree(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "DeadTree")
	local rng = ctx.Rng
	local color = ctx.Pal.Trunk
	local frame = base * yaw(rng)
	local top = (frame * CFrame.new(0, 11 * s, 0)).Position
	Beam(m, frame.Position, top, 1.6 * s, 1.6 * s, color, deco(ctx))
	for side = -1, 1, 2 do
		local from = (frame * CFrame.new(0, 7.5 * s, 0)).Position
		local to = (frame * CFrame.new(side * 4.5 * s, 12.5 * s, rng:NextNumber(-1, 1) * s)).Position
		Beam(m, from, to, 0.9 * s, 0.9 * s, Shade(color, 0.15), FLAT)
	end
end

-- Dragon statue on a plinth, glowing eyes, wings spread (hub landmark of the volcano world).
function MapProps.DragonStatue(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "DragonStatue")
	local stone = hex("#3A3640")
	local dark = Shade(stone, 0.25)
	local opts = { Shadow = true, Solid = false }
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x * s, y * s, z * s)
	end
	Part(m, Vector3.new(14, 3, 20) * s, at(0, 1.5, 0), ctx.Pal.Cliff, { Shadow = true, Solid = true })
	Part(m, Vector3.new(14.6, 0.6, 20.6) * s, at(0, 3.2, 0), LAVA, { Material = NEON })
	-- legs and body
	for _, x in { -2.6, 2.6 } do
		for _, z in { -3.5, 3.5 } do
			Part(m, Vector3.new(2, 4, 2) * s, at(x, 5.5, z), dark, opts)
		end
	end
	Part(m, Vector3.new(7, 6, 11) * s, at(0, 10, 0), stone, opts)
	-- neck and head (facing -Z of base)
	Beam(m, at(0, 12, -4).Position, at(0, 17.5, -8.5).Position, 3.4 * s, 3.4 * s, stone, opts)
	Part(m, Vector3.new(4.4, 3.6, 6) * s, at(0, 18.5, -10), stone, opts)
	Part(m, Vector3.new(3, 2, 3.5) * s, at(0, 17.6, -14), dark, opts)
	for _, x in { -1.3, 1.3 } do
		Part(m, Vector3.new(0.8, 0.8, 0.4) * s, at(x, 19.2, -13.1), LAVA_HOT, { Material = NEON })
		Wedge(m, Vector3.new(0.8, 3, 2.4) * s, at(x, 21.6, -8.6) * CFrame.Angles(-0.35, 0, 0), dark, opts)
	end
	-- wings
	for _, side in { -1, 1 } do
		local root = at(side * 3.5, 12, 0)
		Wedge(m, Vector3.new(0.6, 10, 12) * s, root * CFrame.new(side * 5 * s, 4 * s, 1 * s) * CFrame.Angles(0, 0, side * -0.55), dark, opts)
	end
	-- tail curling to the ground
	Beam(m, at(0, 9, 5.5).Position, at(1.5, 5, 11).Position, 2.6 * s, 2.6 * s, stone, opts)
	Beam(m, at(1.5, 5, 11).Position, at(4, 3.6, 13).Position, 1.6 * s, 1.6 * s, dark, opts)
end

-- PIRATE ------------------------------------------------------------------------------------------

-- Moored pirate ship: hull, raked bow, stern castle, deck, mast, two sails and a skull flag.
-- `base` sits at the waterline, bow along base.LookVector.
function MapProps.Ship(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "PirateShip")
	local hull = hex("#6E3F22")
	local hullDark = hex("#4A2914")
	local deck = hex("#B98A55")
	local sail = hex("#F6F0E2")
	local opts = { Shadow = true }
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x * s, y * s, z * s)
	end
	Part(m, Vector3.new(14, 7, 38) * s, at(0, -1.5, 0), hullDark, opts)
	Part(m, Vector3.new(16, 4, 36) * s, at(0, 3.5, 1), hull, opts)
	Part(m, Vector3.new(16.4, 0.8, 36.4) * s, at(0, 5.2, 1), GOLD, { Shadow = false })
	Wedge(m, Vector3.new(14, 9, 10) * s, at(0, 1, -24) * CFrame.Angles(0, math.pi, 0), hull, opts)
	Part(m, Vector3.new(15, 0.6, 33) * s, at(0, 5.6, 2), deck, { Shadow = false })
	Part(m, Vector3.new(16, 6, 9) * s, at(0, 8, 14.5), hull, opts)
	local mastTop = at(0, 38, -1).Position
	Beam(m, at(0, 5, -1).Position, mastTop, 1.4 * s, 1.4 * s, WOOD_DARK, opts)
	Part(m, Vector3.new(18, 9, 0.5) * s, at(0, 16, -1.6), sail, opts)
	Part(m, Vector3.new(14, 7.5, 0.5) * s, at(0, 27.5, -1.6), sail, opts)
	-- cannons poking out of each side
	for _, side in { -1, 1 } do
		for _, z in { -6, 6 } do
			local from = at(side * 7.5, 3.5, z).Position
			Beam(m, from, from + (base.RightVector * side) * (2.5 * s), 1.2 * s, 1.2 * s, METAL, { Shadow = false })
		end
	end
	MapProps.SkullFlag(m, CFrame.new(mastTop) * (base - base.Position), 0.8 * s, ctx)
end

function MapProps.Barrel(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Barrels")
	local rng = ctx.Rng
	local count = rng:NextInteger(1, 3)
	for i = 1, count do
		local spot = base * CFrame.new((i - 1) * 3.4 * s - (count - 1) * 1.7 * s, 0, rng:NextNumber(-0.6, 0.6) * s)
		Disc(m, 3 * s, 4 * s, spot * CFrame.new(0, 2 * s, 0), WOOD, deco(ctx))
		Disc(m, 3.2 * s, 0.35 * s, spot * CFrame.new(0, 0.9 * s, 0), METAL, FLAT)
		Disc(m, 3.2 * s, 0.35 * s, spot * CFrame.new(0, 3.1 * s, 0), METAL, FLAT)
	end
end

function MapProps.Crate(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Crate")
	local frame = base * yaw(ctx.Rng)
	local size = 3.6 * s
	Part(m, Vector3.new(size, size, size), frame * CFrame.new(0, size / 2, 0), hex("#C68B4E"), deco(ctx))
	local face = frame * CFrame.new(0, size / 2, -size / 2 - 0.05)
	Part(m, Vector3.new(size * 1.3, 0.5 * s, 0.15), face * CFrame.Angles(0, 0, math.pi / 4), WOOD_DARK, FLAT)
	Part(m, Vector3.new(size * 1.3, 0.5 * s, 0.15), face * CFrame.Angles(0, 0, -math.pi / 4), WOOD_DARK, FLAT)
end

-- Open treasure chest spilling gold, with sparkles.
function MapProps.TreasureChest(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "TreasureChest")
	Part(m, Vector3.new(5, 3, 3.4) * s, base * CFrame.new(0, 1.5 * s, 0), WOOD, deco(ctx))
	Part(m, Vector3.new(5.2, 0.5, 3.6) * s, base * CFrame.new(0, 2.6 * s, 0), GOLD, FLAT)
	Part(m, Vector3.new(5, 0.8, 3.4) * s, base * CFrame.new(0, 3.9 * s, 2.3 * s) * CFrame.Angles(math.rad(70), 0, 0), WOOD_DARK, FLAT)
	local gold = Ball(m, 3.6 * s, base * CFrame.new(0, 2.8 * s, 0), GOLD, { Material = NEON })
	Ball(m, 2.2 * s, base * CFrame.new(2.6 * s, 0.6 * s, -1.2 * s), GOLD, { Material = NEON })
	MapKit.Sparkles(gold, GOLD, 3, 3)
end

function MapProps.SkullFlag(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "SkullFlag")
	local top = (base * CFrame.new(0, 12 * s, 0)).Position
	Beam(m, base.Position, top, 0.5 * s, 0.5 * s, WOOD_DARK, FLAT)
	local flag = Part(m, Vector3.new(6, 4, 0.2) * s, base * CFrame.new(3.2 * s, 10 * s, 0), hex("#15151C"), FLAT)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = MapKit.Surface(flag, "Skull", face, 20)
		MapKit.Text(gui, "Icon", "☠", 0.05, 0.9, SNOW, { Stroke = hex("#15151C") })
	end
end

-- ICE ---------------------------------------------------------------------------------------------

-- Voxel pine: trunk plus three stacked, alternately rotated foliage blocks with snow caps.
function MapProps.Pine(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Pine")
	local rng = ctx.Rng
	local frame = base * yaw(rng)
	local green = ctx.Pal.Leaves
	Part(m, Vector3.new(1.6, 4, 1.6) * s, frame * CFrame.new(0, 2 * s, 0), ctx.Pal.Trunk, deco(ctx))
	local y = 3.5 * s
	for i = 1, 3 do
		local w = (11 - i * 2.6) * s
		local h = 4.2 * s
		local rot = frame * CFrame.Angles(0, if i % 2 == 0 then math.pi / 4 else 0, 0)
		Part(m, Vector3.new(w, h, w), rot * CFrame.new(0, y + h / 2, 0), if i == 2 then Tint(green, 0.08) else green, deco(ctx))
		Part(m, Vector3.new(w * 0.86, 0.7 * s, w * 0.86), rot * CFrame.new(0, y + h + 0.3 * s, 0), SNOW, FLAT)
		y += h * 0.9
	end
end

function MapProps.IceSpike(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "IceSpikes")
	local rng = ctx.Rng
	for i = 1, 3 do
		local h = (if i == 1 then 13 else rng:NextNumber(6, 9)) * s
		local foot = (base * CFrame.new(rng:NextNumber(-2.5, 2.5) * s, 0, rng:NextNumber(-2.5, 2.5) * s)).Position
		local tip = foot + Vector3.new(rng:NextNumber(-2, 2) * s, h, rng:NextNumber(-2, 2) * s)
		local w = (if i == 1 then 2.6 else 1.7) * s
		Beam(m, foot - Vector3.new(0, 1, 0), tip, w, w, if i == 2 then Tint(ICE, 0.4) else ICE, { Material = Enum.Material.Ice, Transparency = 0.1, Shadow = false })
	end
end

function MapProps.Igloo(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Igloo")
	Ball(m, 16 * s, base, SNOW, deco(ctx, Enum.Material.Snow))
	local door = base * CFrame.new(0, 0, -8 * s)
	MapKit.FacingDisc(m, 7 * s, 6 * s, door, Tint(ICE, 0.5), deco(ctx, Enum.Material.Snow))
	MapKit.FacingDisc(m, 4.2 * s, 0.4, door * CFrame.new(0, 0, -3 * s), hex("#1E2533"), FLAT)
end

function MapProps.Crystal(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "Crystals")
	local rng = ctx.Rng
	local color = ctx.Pal.Accent
	for i = 1, 3 do
		local h = (if i == 1 then 7 else rng:NextNumber(3.5, 5)) * s
		local w = (if i == 1 then 2 else 1.3) * s
		local cf = base * CFrame.new((i - 2) * 1.8 * s, h * 0.4, rng:NextNumber(-1, 1) * s) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)) * CFrame.Angles(0, math.pi / 4, 0)
		Part(m, Vector3.new(w, h, w), cf, if i == 1 then color else Tint(color, 0.35), { Material = if i == 1 then NEON else Enum.Material.Glass, Transparency = if i == 1 then 0.1 else 0.25 })
	end
end

function MapProps.SnowMound(parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local m = model(parent, "SnowMound")
	Ball(m, 6 * s, base, SNOW, deco(ctx, Enum.Material.Snow))
	Ball(m, 4 * s, base * CFrame.new(2.8 * s, 0, 1.2 * s), Tint(ICE, 0.7), FLAT)
end

-- THEME DISPATCH ----------------------------------------------------------------------------------

-- Role -> builders per prop family. Roles: Tree (tall), Bush, Small, Rock, Feature (hub set piece).
local FAMILIES: { [string]: { [string]: { Builder } } } = {
	Palm = {
		Tree = { MapProps.Palm },
		Bush = { MapProps.Bush },
		Small = { MapProps.Flower },
		Rock = { MapProps.Rock },
		Feature = { MapProps.Umbrella },
	},
	Volcano = {
		Tree = { MapProps.Spire, MapProps.DeadTree },
		Bush = { MapProps.Rock },
		Small = { MapProps.LavaPool },
		Rock = { MapProps.Rock, MapProps.Spire },
		Feature = { MapProps.LavaPool },
	},
	Pirate = {
		Tree = { MapProps.Palm },
		Bush = { MapProps.Barrel, MapProps.Bush },
		Small = { MapProps.Crate, MapProps.Barrel },
		Rock = { MapProps.Rock },
		Feature = { MapProps.TreasureChest, MapProps.SkullFlag },
	},
	Ice = {
		Tree = { MapProps.Pine },
		Bush = { MapProps.SnowMound },
		Small = { MapProps.Crystal },
		Rock = { MapProps.IceSpike },
		Feature = { MapProps.Igloo, MapProps.Crystal },
	},
}

-- Builds the family's prop for `role` (a random pick when the family has several).
function MapProps.Place(family: string, role: string, parent: Instance, base: CFrame, s: number, ctx: Ctx)
	local set = FAMILIES[family] or FAMILIES.Palm
	local builders = set[role] or set.Rock
	if #builders == 0 then
		return
	end
	local build = builders[ctx.Rng:NextInteger(1, #builders)]
	build(parent, base, s, ctx)
end

return MapProps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">MapStations</string>
            <string name="Source"><![CDATA[--!strict
-- Interactive hub stations, built to the naming contract in docs/DESIGN.md §5 that clients read:
-- training pads (Pads/Pad_<id>), glider pedestals and relics (Pedestals/Pedestal_<id>,
-- Pedestals/Relic_<id>), eggs (Eggs/Egg_<id>), portals (Portals/Portal_<worldId>) and global
-- leaderboards (Boards/Board_<Stat>). Labels carry neutral defaults ("LOCKED", prices); each
-- client rewrites them locally from its own data. Prompts are only intents: the owning services
-- re-check distance, ownership and price on the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Map = require(Shared.Config.Map)
local Monetization = require(Shared.Config.Monetization)
local Rarity = require(Shared.Config.Rarity)
local Format = require(Shared.Util.Format)
local Themes = require(Shared.Visual.Themes)
local GliderFactory = require(Shared.Visual.GliderFactory)
local EggFactory = require(Shared.Visual.EggFactory)
local FactoryKit = require(Shared.Visual.FactoryKit)
local Worlds = require(Shared.Definitions.Worlds)
local Zones = require(Shared.Definitions.Zones)
local Training = require(Shared.Definitions.Training)
local Gliders = require(Shared.Definitions.Gliders)
local Relics = require(Shared.Definitions.Relics)
local Eggs = require(Shared.Definitions.Eggs)

local MapKit = require(script.Parent.MapKit)

local MapStations = {}

local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)
local RED = Color3.fromHex("#FF4B4B")
local GREEN = Color3.fromHex("#5BE05B")
local GOLD = Color3.fromHex("#FFD447")
local PILL = Color3.fromHex("#141A33")
local PANEL = Color3.fromHex("#1B2140")

local PROMPT_REACH = 12
local PORTAL_REACH = 14

-- Shared visual with no dependency on the factories: used only if a factory call fails, so a
-- broken template never leaves a pedestal empty or stops the world from building.
local function fallbackModel(primary: Color3, secondary: Color3, size: number): Model
	local model = Instance.new("Model")
	local core = MapKit.Part(model, Vector3.new(size * 0.5, size * 0.12, size), CFrame.new(), primary, { Name = "Root" })
	MapKit.Part(model, Vector3.new(size, size * 0.06, size * 0.35), CFrame.new(0, 0, size * 0.1), secondary, {})
	model.PrimaryPart = core
	return model
end

-- Builds a factory model, falling back to a simple shape if the factory errors.
local function safeModel(label: string, build: () -> Model, primary: Color3, secondary: Color3, size: number): Model
	local ok, result = pcall(build)
	if ok and typeof(result) == "Instance" and result:IsA("Model") then
		return result
	end
	warn(string.format("[MapBuilder] %s model failed: %s", label, tostring(result)))
	return fallbackModel(primary, secondary, size)
end

-- Moves a model's pivot to the centre of its bounding box (so clients can spin it in place).
local function centerPivot(model: Model): Vector3
	local cf, size = model:GetBoundingBox()
	local center = CFrame.new(cf.Position)
	local primary = model.PrimaryPart
	if primary then
		primary.PivotOffset = primary.CFrame:ToObjectSpace(center)
	else
		model.WorldPivot = center
	end
	return size
end

local function anchorAll(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
end

local function label(part: BasePart, width: number, height: number, offsetY: number, maxDistance: number): BillboardGui
	return MapKit.Billboard(part, "Label", width, height, offsetY, maxDistance)
end

-- Stroked text line inside a billboard (x/width default to the full width).
local function line(gui: Instance, name: string, text: string, y: number, h: number, color: Color3, font: Font?): TextLabel
	return MapKit.Text(gui, name, text, y, h, color, { Font = font, StrokeThickness = 2.5 })
end

-- Dark rounded pill behind a short text (rebirth gates, Robux prices).
local function pill(gui: Instance, name: string, text: string, y: number, h: number, color: Color3): TextLabel
	local t = MapKit.Text(gui, name, text, y, h, color, { StrokeThickness = 1.5 })
	t.Position = UDim2.fromScale(0.22, y)
	t.Size = UDim2.fromScale(0.56, h)
	t.BackgroundColor3 = PILL
	t.BackgroundTransparency = 0.15
	MapKit.Corner(t, 0.5)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.12, 0)
	pad.PaddingBottom = UDim.new(0.12, 0)
	pad.Parent = t
	return t
end

-- PADS --------------------------------------------------------------------------------------------

function MapStations.Pads(ctx: MapKit.Ctx, parent: Instance)
	for _, pad in Training.ForWorld(ctx.World.Id) do
		local c = Map.PadPosition(pad.Slot)
		local size = Map.PadSize
		local color = MapKit.Hex(pad.Color)
		local trim = if pad.PassKey then MapKit.Hex(pad.Accent) else MapKit.Tint(color, 0.45)
		local part = MapKit.Part(parent, size, MapKit.CF(ctx, c.X, c.Y + 0.2 + size.Y / 2, c.Z), color, {
			Solid = true,
			Shadow = true,
			Name = "Pad_" .. pad.Id,
		})
		part.CanTouch = true -- clients may use touch/overlap queries on pads
		part:SetAttribute("PadId", pad.Id)
		-- glowing trim showing around the slab, and an inset square on top
		MapKit.Part(part, Vector3.new(size.X + 1.6, 0.8, size.Z + 1.6), MapKit.CF(ctx, c.X, c.Y + 0.4, c.Z), trim, {
			Material = NEON,
			Name = "Trim",
		})
		MapKit.Part(part, Vector3.new(size.X * 0.72, 0.1, size.Z * 0.72), MapKit.CF(ctx, c.X, c.Y + 0.2 + size.Y + 0.03, c.Z), MapKit.Shade(color, 0.12), {
			Name = "Inset",
		})
		-- the multiplier painted on the pad, readable from the path (east of the pads)
		local decal = MapKit.FloorDecal(part, MapKit.At(ctx, c.X, c.Y + 0.2 + size.Y + 0.1, c.Z), Vector3.new(-1, 0, 0), size.Z * 0.66, size.X * 0.4)
		local paint = MapKit.Surface(decal, "Paint", Enum.NormalId.Front, 12)
		MapKit.Text(paint, "PaintText", Format.Short(pad.Multiplier) .. "x", 0, 1, WHITE, {
			Font = MapKit.Fonts.Numbers,
			Transparency = 0.25,
			StrokeThickness = 3,
		})

		local gui = label(part, 13, 8, 9, 110)
		local multColor = WHITE
		if pad.PassKey then
			local pass = Monetization.Pass(pad.PassKey)
			line(gui, "Caption", "ALL WORLDS", 0, 0.15, WHITE, MapKit.Fonts.Body)
			pill(gui, "Gate", "R$" .. tostring(if pass then pass.Robux else 0), 0.16, 0.26, GREEN)
			multColor = color
		else
			pill(gui, "Gate", "🌀 " .. tostring(pad.Rebirths), 0.16, 0.26, WHITE)
		end
		line(gui, "Status", "LOCKED", 0.44, 0.22, RED)
		line(gui, "Mult", Format.Short(pad.Multiplier) .. "x SKILL", 0.67, 0.33, multColor)
	end
end

-- PEDESTALS ---------------------------------------------------------------------------------------

-- Round pedestal base (PrimaryPart "Base") with a glowing foot ring and an inset top.
local function pedestalBase(ctx: MapKit.Ctx, model: Model, pos: Vector3, diameter: number, height: number, stone: Color3, ring: Color3): Part
	local base = MapKit.Disc(model, diameter, height, MapKit.CF(ctx, pos.X, pos.Y + height / 2, pos.Z), stone, {
		Solid = true,
		Shadow = true,
		Name = "Base",
	})
	MapKit.Disc(model, diameter + 1.2, 0.6, MapKit.CF(ctx, pos.X, pos.Y + 0.3, pos.Z), ring, {
		Material = NEON,
		Name = "Ring",
	})
	MapKit.Disc(model, diameter * 0.75, 0.12, MapKit.CF(ctx, pos.X, pos.Y + height + 0.04, pos.Z), ring, { Name = "Top" })
	model.PrimaryPart = base
	return base
end

local function placeDisplay(model: Model, display: Model, center: Vector3)
	display.Name = "Display"
	anchorAll(display)
	centerPivot(display)
	display:PivotTo(CFrame.new(center))
	FactoryKit.Rig(display) -- the client spins it by moving the root only
	display:SetAttribute("Spin", true)
	display.Parent = model
end

local function gliderPedestal(ctx: MapKit.Ctx, parent: Instance, glider: Gliders.Glider, index: number)
	local pos = Map.PedestalPosition(index)
	local rarity = MapKit.Hex(Rarity.Get(glider.Rarity).Color)
	local model = Instance.new("Model")
	model.Name = "Pedestal_" .. glider.Id
	model:SetAttribute("Glider", glider.Id)
	local base = pedestalBase(ctx, model, pos, 10, 2.4, ctx.Pal.Stone, rarity)

	local primary = MapKit.Hex(glider.Visual.Primary)
	local secondary = MapKit.Hex(glider.Visual.Secondary)
	local display = safeModel(glider.Id, function()
		return GliderFactory.Build(glider.Visual, 5, true)
	end, primary, secondary, 5)
	placeDisplay(model, display, MapKit.At(ctx, pos.X, pos.Y + 6.5, pos.Z))
	if Rarity.Order(glider.Rarity) >= Rarity.Order("Legendary") then
		MapKit.Sparkles(base, rarity, 3, 2.5)
	end

	MapKit.Prompt(base, "BuyPrompt", glider.Name, "Buy", PROMPT_REACH)
	local gui = label(base, 10, 5.4, 11.5, 70)
	line(gui, "Status", "LOCKED", 0, 0.28, RED)
	line(gui, "Skill", "+" .. Format.Short(glider.SkillPerRing) .. " Skill", 0.28, 0.42, WHITE)
	line(gui, "Price", if glider.Price <= 0 then "FREE" else Format.Short(glider.Price) .. " Wins", 0.7, 0.3, GOLD)
	model.Parent = parent
end

local function relicPedestal(ctx: MapKit.Ctx, parent: Instance, relic: Relics.Relic, index: number)
	local pos = Map.RelicSpot + Map.PedestalStepAcross * (index - 1)
	local primary = MapKit.Hex(relic.Visual.Primary)
	local secondary = MapKit.Hex(relic.Visual.Secondary)
	local model = Instance.new("Model")
	model.Name = "Relic_" .. relic.Id
	model:SetAttribute("Relic", relic.Id)
	local base = pedestalBase(ctx, model, pos, 11, 3, MapKit.Shade(primary, 0.35), primary)
	MapKit.Disc(model, 13.5, 0.5, MapKit.CF(ctx, pos.X, pos.Y + 0.9, pos.Z), secondary, {
		Material = NEON,
		Name = "Ring2",
	})
	local display = safeModel(relic.Id, function()
		return GliderFactory.Build(relic.Visual, 6, true)
	end, primary, secondary, 6)
	placeDisplay(model, display, MapKit.At(ctx, pos.X, pos.Y + 8, pos.Z))
	MapKit.Sparkles(base, primary, 6, 4)
	MapKit.Light(base, primary, 16, 1.5)

	MapKit.Prompt(base, "BuyPrompt", relic.Name, "Buy", PROMPT_REACH)
	local product = Monetization.Product(relic.ProductKey)
	local gui = label(base, 14, 8, 14, 90)
	line(gui, "Stock", string.format("STOCK: %s/%s", Format.Commas(relic.Stock), Format.Commas(relic.Stock)), 0, 0.2, WHITE)
	local bonus = line(gui, "Bonus", string.format("ALWAYS %d%% BETTER", math.floor(relic.BonusOverBest * 100 + 0.5)), 0.2, 0.24, WHITE)
	MapKit.Gradient(bonus, MapKit.Rainbow)
	local title = line(gui, "Title", string.upper(relic.Name), 0.44, 0.3, WHITE)
	MapKit.Gradient(title, { GOLD, Color3.fromHex("#FF9A3D") })
	line(gui, "Price", "R$" .. tostring(if product then product.Robux else 0), 0.75, 0.25, GREEN)
	model.Parent = parent
end

function MapStations.Pedestals(ctx: MapKit.Ctx, parent: Instance)
	for i, glider in Gliders.ForWorld(ctx.World.Id) do
		gliderPedestal(ctx, parent, glider, i)
	end
	for i, relic in Relics.List do
		relicPedestal(ctx, parent, relic, i)
	end
end

-- EGGS --------------------------------------------------------------------------------------------

function MapStations.Eggs(ctx: MapKit.Ctx, parent: Instance)
	for i, egg in Eggs.ForWorld(ctx.World.Id) do
		local pos = Map.EggPosition(i)
		local color = MapKit.Hex(egg.Color)
		local accent = MapKit.Hex(egg.Accent)
		local model = Instance.new("Model")
		model.Name = "Egg_" .. egg.Id
		model:SetAttribute("Egg", egg.Id)
		local base = MapKit.Disc(model, 12, 2, MapKit.CF(ctx, pos.X, pos.Y + 1, pos.Z), ctx.Pal.Stone, {
			Solid = true,
			Shadow = true,
			Name = "Base",
		})
		model.PrimaryPart = base
		MapKit.Disc(model, 13, 0.6, MapKit.CF(ctx, pos.X, pos.Y + 0.3, pos.Z), accent, { Material = NEON, Name = "Ring" })
		MapKit.Disc(model, 9, 1, MapKit.CF(ctx, pos.X, pos.Y + 2.5, pos.Z), color, { Shadow = true, Name = "Stand" })

		local eggModel = safeModel(egg.Id, function()
			return EggFactory.Build(egg, 7)
		end, color, accent, 7)
		eggModel.Name = "Display"
		anchorAll(eggModel)
		local size = centerPivot(eggModel)
		eggModel:PivotTo(CFrame.new(MapKit.At(ctx, pos.X, pos.Y + 3 + size.Y / 2, pos.Z)))
		eggModel.Parent = model

		local robux = egg.ProductKey ~= nil
		if robux then
			MapKit.Sparkles(base, accent, 5, 3)
			MapKit.Light(base, accent, 14, 1.2)
		end
		MapKit.Prompt(base, "HatchPrompt", egg.Name, "Hatch", PROMPT_REACH)
		local gui = label(base, 12, 5, 13.5, 90)
		line(gui, "Name", egg.Name, 0, 0.56, color)
		local price: string
		if robux then
			local product = Monetization.Product(egg.ProductKey :: string)
			price = "R$" .. tostring(if product then product.Robux else 0)
		else
			price = "🏆 " .. Format.Short(egg.Price)
		end
		line(gui, "Price", price, 0.56, 0.44, if robux then GREEN else GOLD)
		model.Parent = parent
	end
end

-- PORTALS -----------------------------------------------------------------------------------------

local function requirementText(target: Worlds.World): string
	local parts = {}
	if target.UnlockZone then
		local zone = Zones.Get(target.UnlockZone)
		table.insert(parts, "🏁 Reach " .. (if zone then zone.Name else "the river end"))
	end
	if target.UnlockRebirths > 0 then
		table.insert(parts, "🌀 " .. target.UnlockRebirths .. " Rebirths")
	end
	if target.UnlockWins > 0 then
		table.insert(parts, "🏆 " .. Format.Short(target.UnlockWins))
	end
	return if #parts > 0 then table.concat(parts, "  +  ") else "OPEN"
end

-- Big glowing archway (PrimaryPart "Frame" = the threshold slab) with a swirling neon disc.
local function portal(ctx: MapKit.Ctx, parent: Instance, target: Worlds.World, spot: Vector3, isNext: boolean)
	local theme = Themes[target.Theme] or Themes.Isles
	local glow = MapKit.Hex(theme.Accent)
	local swirl = MapKit.Hex(theme.Water)
	local stoneA = MapKit.Hex(theme.Cliff)
	local stoneB = MapKit.Hex(theme.CliffAlt)
	local model = Instance.new("Model")
	model.Name = "Portal_" .. target.Id
	model:SetAttribute("World", target.Id)

	local x, z = spot.X, spot.Z
	local frame = MapKit.Part(model, Vector3.new(30, 1, 10), MapKit.CF(ctx, x, spot.Y + 0.5, z), ctx.Pal.Stone, {
		Solid = true,
		Shadow = true,
		Name = "Frame",
	})
	frame.CanTouch = true
	model.PrimaryPart = frame
	MapKit.Part(model, Vector3.new(31, 0.6, 11), MapKit.CF(ctx, x, spot.Y + 0.3, z), glow, { Material = NEON, Name = "Glow" })
	-- stacked checker pillars
	local blockH = 5.5
	for side = -1, 1, 2 do
		for i = 0, 3 do
			MapKit.Part(model, Vector3.new(4.5, blockH, 6), MapKit.CF(ctx, x + side * 12.5, spot.Y + 1 + blockH * (i + 0.5), z), if (i + side) % 2 == 0 then stoneA else stoneB, {
				Solid = true,
				Shadow = true,
				Name = "Pillar",
			})
		end
	end
	-- stepped voxel arch over the top: {x offset, y offset, width} per step, mirrored
	local top = spot.Y + 1 + blockH * 4
	local steps = { { 11, 0, 7.5 }, { 6, 2.4, 5 } }
	for i, step in steps do
		for side = -1, 1, 2 do
			MapKit.Part(model, Vector3.new(step[3], 4.5, 6), MapKit.CF(ctx, x + side * step[1], top + step[2] + 2.25, z), if (i + side) % 2 == 0 then stoneA else stoneB, {
				Shadow = true,
				Name = "Arch",
			})
		end
	end
	local crown = top + 3.6 + 2.25
	MapKit.Part(model, Vector3.new(8, 4.5, 6), MapKit.CF(ctx, x, crown, z), stoneA, { Shadow = true, Name = "Arch" })
	MapKit.Part(model, Vector3.new(4, 4, 6.4), MapKit.CF(ctx, x, crown, z), glow, { Material = NEON, Name = "Keystone" })
	-- swirling disc: neon discs plus animated beam rings, facing the hub (-Z)
	local center = MapKit.At(ctx, x, spot.Y + 12.5, z)
	local facing = MapKit.Facing(center, -Vector3.zAxis)
	MapKit.FacingDisc(model, 21, 0.6, facing, glow, { Material = NEON, Transparency = 0.2, Name = "Disc" })
	MapKit.FacingDisc(model, 14, 0.8, facing, swirl, { Material = NEON, Transparency = 0.15, Name = "Inner" })
	local anchor = MapKit.Part(model, Vector3.new(1, 1, 1), facing * CFrame.new(0, 0, -0.6), WHITE, {
		Transparency = 1,
		Name = "Swirl",
	})
	MapKit.BeamRing(anchor, 9.5, 2.2, MapKit.Tint(glow, 0.3), 3)
	MapKit.BeamRing(anchor, 5.5, 1.8, WHITE, -4)
	MapKit.Sparkles(anchor, glow, 6, 3)
	MapKit.Light(anchor, glow, 22, 1.5)

	local world = ctx.World
	MapKit.Prompt(frame, "PortalPrompt", target.Name, "Travel", PORTAL_REACH)
	local gui = label(frame, 18, 7, 0, 160)
	-- in front of the arch crown (toward the hub) so the arch never hides it
	gui.StudsOffsetWorldSpace = Vector3.new(0, top - spot.Y + 5, -5)
	line(gui, "Name", string.upper(target.Name), 0, 0.55, glow)
	if isNext then
		line(gui, "Requirement", requirementText(target), 0.58, 0.42, WHITE, MapKit.Fonts.Body)
	else
		line(gui, "Requirement", "Back to world " .. tostring(target.Id), 0.58, 0.42, GREEN, MapKit.Fonts.Body)
	end
	model:SetAttribute("From", world.Id)
	model.Parent = parent
end

function MapStations.Portals(ctx: MapKit.Ctx, parent: Instance)
	local id = ctx.World.Id
	local nextWorld = Worlds.Get(id + 1)
	if nextWorld then
		portal(ctx, parent, nextWorld, Map.PortalNext, true)
	end
	local prevWorld = Worlds.Get(id - 1)
	if prevWorld then
		portal(ctx, parent, prevWorld, Map.PortalPrev, false)
	end
end

-- LEADERBOARDS ------------------------------------------------------------------------------------

local BOARD_TITLES: { [string]: string } = {
	Wins = "🏆 TOP WINS",
	BestDistance = "📏 LONGEST GLIDE",
	Rebirths = "🌀 MOST REBIRTHS",
}

function MapStations.Boards(ctx: MapKit.Ctx, parent: Instance)
	local width, height = 34, 24
	for _, entry in Map.Leaderboards do
		local center = ctx.Origin + entry.Position
		local facing = MapKit.Facing(center, entry.Facing)
		local board = MapKit.Part(parent, Vector3.new(width, height, 1.2), facing, PANEL, {
			Solid = true,
			Shadow = true,
			Name = "Board_" .. entry.Stat,
		})
		-- backing frame, posts and a header block
		MapKit.Part(board, Vector3.new(width + 2.4, height + 2.4, 1), facing * CFrame.new(0, 0, 0.6), ctx.Pal.Accent, { Shadow = true, Name = "Backing" })
		for side = -1, 1, 2 do
			local foot = facing * CFrame.new(side * (width / 2 - 2), -height / 2, 0.6)
			local ground = foot.Position.Y - ctx.Origin.Y
			MapKit.Part(board, Vector3.new(1.6, ground + 1, 1.6), foot * CFrame.new(0, -(ground + 1) / 2 + 0.5, 0), ctx.Pal.Stone, { Name = "Post" })
		end
		MapKit.Part(board, Vector3.new(width * 0.5, 3, 1.6), facing * CFrame.new(0, height / 2 + 1.5, 0.3), ctx.Pal.Accent, {
			Material = NEON,
			Name = "Header",
		})

		local gui = MapKit.Surface(board, "Board", Enum.NormalId.Front, 40)
		local bg = Instance.new("Frame")
		bg.Name = "Background"
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = PANEL
		bg.BorderSizePixel = 0
		bg.ZIndex = 0
		MapKit.Gradient(bg, { MapKit.Tint(PANEL, 0.12), MapKit.Shade(PANEL, 0.25) }).Rotation = 90
		bg.Parent = gui
		local title = MapKit.Text(gui, "Title", BOARD_TITLES[entry.Stat] or string.upper(entry.Stat), 0.02, 0.15, GOLD, { StrokeThickness = 4 })
		title.ZIndex = 2
		local list = Instance.new("Frame")
		list.Name = "List"
		list.BackgroundTransparency = 1
		list.Position = UDim2.fromScale(0.05, 0.2)
		list.Size = UDim2.fromScale(0.9, 0.78)
		list.ZIndex = 2
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.FillDirection = Enum.FillDirection.Vertical
		layout.Padding = UDim.new(0.005, 0)
		layout.Parent = list
		local waiting = MapKit.Text(list, "Waiting", "Loading top players...", 0, 0.09, WHITE, { Transparency = 0.35 })
		waiting.LayoutOrder = 0
		list.Parent = gui
	end
end

return MapStations
]]></string>
          </Properties>
