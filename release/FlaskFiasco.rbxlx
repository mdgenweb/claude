		golems = { { x = -36 } },
		props = { { id = "plank", x = -5, y = 0 } },
		zones = { { id = "target", x = 52, y = 28, w = 6, h = 12, visual = "target" } },
		potions = { kaboom_cocktail = 3 },
		objective = { event = "zone", filter = "target", target = 1, mode = "count", text = "Bullseye hits" },
