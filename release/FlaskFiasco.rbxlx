			exposure = 0.1,
			fogColor = rgb(120, 170, 220),
			atmosphereDensity = 0.34,
			atmosphereHaze = 1.8,
			atmosphereColor = rgb(170, 220, 255),
			atmosphereDecay = rgb(90, 140, 200),
			tint = rgb(235, 248, 255),
			saturation = 0.1,
			contrast = 0.1,
			bloomIntensity = 0.8,
			bloomSize = 28,
