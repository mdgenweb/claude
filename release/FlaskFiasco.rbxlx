		description = "Salt from the bottom of nowhere.",
		order = 12,
	},
	{
		id = "dragon_scale",
		name = "Dragon Scale",
		icon = "🐉",
		rarity = "Epic",
		price = 200,
		unlockLevel = 17,
		color = Color3.fromRGB(222, 42, 62),
		description = "Still warm. The dragon wants it back.",
		order = 13,
	},
	{
		id = "star_shard",
		name = "Star Shard",
		icon = "⭐",
		rarity = "Legendary",
		price = 450,
		unlockLevel = 22,
		color = Color3.fromRGB(255, 250, 204),
		description = "A splinter of a fallen star.",
		order = 14,
	},
	{
		id = "philosophers_stone",
		name = "Philosopher's Stone",
		icon = "💎",
		rarity = "Mythic",
		price = 0,
		unlockLevel = 1,
		color = Color3.fromRGB(255, 40, 92),
		description = "The heart of the Magnum Opus. Earned, never bought.",
		order = 15,
	},
}

local Ingredients = {
	List = list,
	ById = {} :: { [string]: Ingredient },
}

for _, ingredient in list do
	Ingredients.ById[ingredient.id] = ingredient
end

function Ingredients.get(id: string): Ingredient?
	return Ingredients.ById[id]
end

return Ingredients
]]></string>
