local Skins = {
	List = list,
	ById = {} :: { [string]: Skin },
	DefaultId = "clay",
}

for _, skin in list do
	Skins.ById[skin.id] = skin
end

function Skins.get(id: string?): Skin
	return (id and Skins.ById[id]) or Skins.ById[Skins.DefaultId]
end

return Skins
