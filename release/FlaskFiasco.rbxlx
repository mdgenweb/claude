		},
	},
	{
		id = "storm",
		name = "Storm Spire",
		icon = "⛈️",
		description = "A rain-soaked rooftop crackling with tesla coils.",
		unlockLevel = 15,
		width = 112,
		height = 70,
		gravityScale = 1,
		builder = "StormSpire",
		order = 7,
		lighting = {
			clockTime = 21.5,
			brightness = 1,
