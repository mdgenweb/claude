		effect = "ascension",
		kind = "status",
		duration = 30,
		radius = 14,
		order = 30,
	},
}

local Potions = {
	List = list,
	ById = {} :: { [string]: Potion },
	FallbackId = "murky_sludge",
	FinalId = "philosophers_elixir",
}

for _, potion in list do
	Potions.ById[potion.id] = potion
end

table.sort(list, function(a, b)
	return a.order < b.order
end)

function Potions.get(id: string): Potion?
	return Potions.ById[id]
end

return Potions
]]></string>
