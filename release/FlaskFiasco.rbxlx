			skyBottom = rgb(255, 190, 230),
		},
	},
	{
		id = "frost",
		name = "Frost Cavern",
		icon = "🧊",
		description = "Glassy ice floors and icicles that fall when you least expect it.",
		unlockLevel = 12,
		width = 112,
