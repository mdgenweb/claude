		Size = seq(0, 0.6, 1, 0.5),
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 160)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(90, 200, 255)),
