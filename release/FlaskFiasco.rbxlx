        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">GolemPreview</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Lightweight static golem model for UI previews (shop skin cards, spawn menu).

local GolemPreview = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function part(
	model: Model,
	shape: Enum.PartType,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

function GolemPreview.build(skin): Model
	local model = Instance.new("Model")
	model.Name = "GolemPreview"
	local mat = skin.material
	local torso = part(model, Enum.PartType.Ball, Vector3.one * 3, CFrame.new(0, 4.6, 0), skin.body, mat)
	part(model, Enum.PartType.Ball, Vector3.one * 2.4, CFrame.new(0, 7.05, 0), skin.body, mat)
	for _, side in { -1, 1 } do
		-- Arms (slightly raised for a friendly pose) and legs.
		local shoulder = CFrame.new(side * 1.6, 5.5, 1.65)
		part(model, Enum.PartType.Ball, Vector3.one * 1.05, shoulder, skin.joint, mat)
		local arm = shoulder * CFrame.Angles(0, 0, math.rad(side * 18))
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(3, 0.8, 0.8),
			arm * CFrame.new(0, -1.5, 0) * UPRIGHT,
			skin.limb,
			mat
		)
		part(model, Enum.PartType.Ball, Vector3.one * 0.95, arm * CFrame.new(0, -3.1, 0), skin.body, mat)
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(3.4, 0.9, 0.9),
			CFrame.new(side * 0.75, 1.8, -0.45) * UPRIGHT,
			skin.limb,
			mat
		)
		part(
			model,
			Enum.PartType.Block,
			Vector3.new(1.35, 0.55, 1.2),
			CFrame.new(side * 0.93, 0.25, -0.2),
			skin.joint,
			mat
		)
		part(
			model,
			Enum.PartType.Ball,
			Vector3.one * 0.66,
			CFrame.new(side * 0.46, 7.23, 0.96),
			skin.eye,
			Enum.Material.SmoothPlastic
		)
		part(
			model,
			Enum.PartType.Ball,
			Vector3.one * 0.32,
			CFrame.new(side * 0.46, 7.21, 1.24),
			skin.pupil,
			Enum.Material.SmoothPlastic
		)
		part(
			model,
			Enum.PartType.Ball,
			Vector3.one * 0.34,
			CFrame.new(side * 0.8, 6.77, 0.82),
			Color3.fromRGB(255, 120, 140),
			Enum.Material.SmoothPlastic
		).Transparency =
			0.45
	end
	part(
		model,
		Enum.PartType.Block,
		Vector3.new(0.6, 0.14, 0.14),
		CFrame.new(0, 6.63, 1.12),
		Color3.fromRGB(40, 24, 30),
		Enum.Material.SmoothPlastic
	)
	part(
		model,
		Enum.PartType.Block,
		Vector3.new(0.55, 0.55, 0.2),
		CFrame.new(0, 4.95, 1.42) * CFrame.Angles(0, 0, math.rad(45)),
		skin.accent,
		Enum.Material.Neon
	)
	if skin.accessory == "strawhat" then
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(0.2, 4.2, 4.2),
			CFrame.new(0, 8.1, 0.2) * UPRIGHT,
			Color3.fromRGB(230, 196, 100),
			Enum.Material.Fabric
		)
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(1.3, 2.2, 2.2),
			CFrame.new(0, 8.7, 0.1) * UPRIGHT,
			Color3.fromRGB(230, 196, 100),
			Enum.Material.Fabric
		)
	elseif skin.accessory == "carrot" then
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(1.1, 0.34, 0.34),
			CFrame.new(0, 6.95, 1.5) * CFrame.Angles(0, math.rad(90), 0),
			Color3.fromRGB(255, 130, 30),
			Enum.Material.SmoothPlastic
		)
	elseif skin.accessory == "halo" then
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(0.15, 2.2, 2.2),
			CFrame.new(0, 8.75, 0) * UPRIGHT,
			Color3.fromRGB(255, 230, 120),
			Enum.Material.Neon
		)
	elseif skin.accessory == "crown" then
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(0.5, 1.6, 1.6),
			CFrame.new(0, 8.25, 0) * UPRIGHT,
			Color3.fromRGB(255, 200, 60),
			Enum.Material.Foil
		)
	elseif skin.accessory == "horns" then
		for _, side in { -1, 1 } do
			part(
				model,
				Enum.PartType.Block,
				Vector3.new(0.4, 1.4, 0.4),
				CFrame.new(side * 0.8, 8.25, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)),
				Color3.fromRGB(40, 30, 30),
				Enum.Material.Basalt
			)
		end
	elseif skin.accessory == "crystal" then
		part(
			model,
			Enum.PartType.Block,
			Vector3.new(0.45, 1.5, 0.45),
			CFrame.new(0.1, 8.35, 0) * CFrame.Angles(0, math.rad(45), 0),
			Color3.fromRGB(255, 140, 255),
			Enum.Material.Neon
		)
	elseif skin.accessory == "gear" then
		part(
			model,
			Enum.PartType.Cylinder,
			Vector3.new(0.25, 1.4, 1.4),
			CFrame.new(0, 4.7, 1.45) * CFrame.Angles(0, math.rad(90), 0),
			Color3.fromRGB(220, 170, 80),
			Enum.Material.Metal
		)
	elseif skin.accessory == "bolts" then
		for _, side in { -1, 1 } do
			part(
				model,
				Enum.PartType.Cylinder,
				Vector3.new(0.6, 0.4, 0.4),
				CFrame.new(side * 1.3, 6.65, 0),
				Color3.fromRGB(180, 180, 190),
				Enum.Material.Metal
			)
		end
	end
	model.PrimaryPart = torso
	model.WorldPivot = CFrame.new(0, 4.4, 0)
	return model
end

return GolemPreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PotionModel</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a small 3D potion bottle out of primitive parts. Used for thrown bottles (client),
-- feeding animations and the ViewportFrame icons in the UI.

local PotionModel = {}

type BottleInput = { color: Color3, bottle: string }

local GLASS = Color3.fromRGB(220, 240, 255)
local CORK = Color3.fromRGB(150, 104, 62)

local function newPart(model: Model, shape: Enum.PartType, size: Vector3, cf: CFrame, props: { [string]: any }?): Part
	local part = Instance.new("Part")
	part.Shape = shape
	part.Size = size
	part.CFrame = cf
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			(part :: any)[key] = value
		end
	end
	part.Parent = model
	return part
end

local function glass(model: Model, shape: Enum.PartType, size: Vector3, cf: CFrame): Part
	return newPart(model, shape, size, cf, {
		Material = Enum.Material.Glass,
		Color = GLASS,
		Transparency = 0.55,
		Reflectance = 0.15,
		Name = "Glass",
	})
end

local function liquid(model: Model, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3): Part
	return newPart(model, shape, size, cf, {
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.05,
		Name = "Liquid",
	})
end

-- Cylinders are oriented along X; this rotation stands them upright (axis along Y).
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function neckAndCork(model: Model, topY: number)
	glass(model, Enum.PartType.Cylinder, Vector3.new(0.42, 0.34, 0.34), CFrame.new(0, topY + 0.2, 0) * UPRIGHT)
	newPart(model, Enum.PartType.Cylinder, Vector3.new(0.26, 0.4, 0.4), CFrame.new(0, topY + 0.5, 0) * UPRIGHT, {
		Material = Enum.Material.Wood,
		Color = CORK,
		Name = "Cork",
	})
end

local builders: { [string]: (Model, Color3) -> () } = {
	round = function(model, color)
		glass(model, Enum.PartType.Ball, Vector3.one * 1.2, CFrame.new(0, 0, 0))
		liquid(model, Enum.PartType.Ball, Vector3.one * 0.98, CFrame.new(0, -0.04, 0), color)
		neckAndCork(model, 0.5)
	end,
	tall = function(model, color)
		glass(model, Enum.PartType.Cylinder, Vector3.new(1.45, 0.8, 0.8), CFrame.new(0, 0.05, 0) * UPRIGHT)
		liquid(model, Enum.PartType.Cylinder, Vector3.new(1.1, 0.64, 0.64), CFrame.new(0, -0.08, 0) * UPRIGHT, color)
		neckAndCork(model, 0.72)
	end,
	square = function(model, color)
		glass(model, Enum.PartType.Block, Vector3.new(0.95, 1.05, 0.95), CFrame.new(0, 0, 0))
		liquid(model, Enum.PartType.Block, Vector3.new(0.78, 0.8, 0.78), CFrame.new(0, -0.08, 0), color)
		neckAndCork(model, 0.5)
	end,
	heart = function(model, color)
		glass(model, Enum.PartType.Ball, Vector3.one * 0.78, CFrame.new(-0.22, 0.1, 0))
		glass(model, Enum.PartType.Ball, Vector3.one * 0.78, CFrame.new(0.22, 0.1, 0))
		glass(
			model,
			Enum.PartType.Block,
			Vector3.new(0.6, 0.6, 0.5),
			CFrame.new(0, -0.22, 0) * CFrame.Angles(0, 0, math.rad(45))
		)
		liquid(model, Enum.PartType.Ball, Vector3.one * 0.6, CFrame.new(-0.2, 0.08, 0), color)
		liquid(model, Enum.PartType.Ball, Vector3.one * 0.6, CFrame.new(0.2, 0.08, 0), color)
		liquid(
			model,
			Enum.PartType.Block,
			Vector3.new(0.42, 0.42, 0.36),
			CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.rad(45)),
			color
		)
		neckAndCork(model, 0.42)
	end,
	skull = function(model, color)
		glass(model, Enum.PartType.Ball, Vector3.one * 1.1, CFrame.new(0, 0.05, 0))
		glass(model, Enum.PartType.Block, Vector3.new(0.6, 0.35, 0.6), CFrame.new(0, -0.45, 0.05))
		liquid(model, Enum.PartType.Ball, Vector3.one * 0.88, CFrame.new(0, 0, 0), color)
		for _, x in { -0.2, 0.2 } do
			newPart(model, Enum.PartType.Ball, Vector3.one * 0.26, CFrame.new(x, 0.08, 0.44), {
				Material = Enum.Material.SmoothPlastic,
				Color = Color3.fromRGB(25, 15, 30),
				Name = "Socket",
			})
		end
		neckAndCork(model, 0.5)
	end,
	star = function(model, color)
		glass(model, Enum.PartType.Ball, Vector3.one * 1.05, CFrame.new(0, 0, 0))
		liquid(model, Enum.PartType.Ball, Vector3.one * 0.84, CFrame.new(0, -0.03, 0), color)
		for i = 0, 4 do
			local angle = math.rad(90 + i * 72)
			local offset = Vector3.new(math.cos(angle), math.sin(angle), 0) * 0.58
			newPart(
				model,
				Enum.PartType.Block,
				Vector3.new(0.22, 0.22, 0.22),
				CFrame.new(offset) * CFrame.Angles(0, 0, angle + math.rad(45)),
				{ Material = Enum.Material.Neon, Color = color, Name = "Spike" }
			)
		end
		neckAndCork(model, 0.46)
	end,
	flask = function(model, color)
		glass(model, Enum.PartType.Cylinder, Vector3.new(0.55, 1.25, 1.25), CFrame.new(0, -0.35, 0) * UPRIGHT)
		glass(model, Enum.PartType.Cylinder, Vector3.new(0.45, 0.85, 0.85), CFrame.new(0, 0.12, 0) * UPRIGHT)
		liquid(model, Enum.PartType.Cylinder, Vector3.new(0.42, 1.08, 1.08), CFrame.new(0, -0.38, 0) * UPRIGHT, color)
		liquid(model, Enum.PartType.Cylinder, Vector3.new(0.3, 0.7, 0.7), CFrame.new(0, 0.04, 0) * UPRIGHT, color)
		neckAndCork(model, 0.32)
	end,
}

-- Returns an anchored, non-colliding Model whose pivot is the bottle's centre.
function PotionModel.build(potion: BottleInput, scale: number?): Model
	local model = Instance.new("Model")
	model.Name = "Bottle"
	local builder = builders[potion.bottle] or builders.round
	builder(model, potion.color)

	-- Specular glint on the glass so bottles read as glossy even without bloom.
	newPart(model, Enum.PartType.Ball, Vector3.one * 0.16, CFrame.new(-0.26, 0.22, 0.5), {
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.new(1, 1, 1),
		Transparency = 0.25,
		Name = "Glint",
	})

	local primary = model:FindFirstChild("Glass") :: BasePart?
	if primary then
		model.PrimaryPart = primary
	end
	model.WorldPivot = CFrame.new()
	if scale and scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

-- Neutral grey bottle used for undiscovered potions in the codex.
function PotionModel.silhouette(bottle: string): Model
	local model = PotionModel.build({ color = Color3.fromRGB(40, 34, 60), bottle = bottle })
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Material = Enum.Material.SmoothPlastic
			part.Color = Color3.fromRGB(46, 40, 70)
			part.Transparency = 0
			part.Reflectance = 0
		end
	end
	return model
end

return PotionModel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="25">
