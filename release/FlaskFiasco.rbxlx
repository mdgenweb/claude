			atmosphereHaze = 2.2,
			atmosphereColor = rgb(200, 90, 50),
			atmosphereDecay = rgb(120, 40, 20),
			tint = rgb(255, 225, 205),
			saturation = 0.2,
			contrast = 0.12,
			bloomIntensity = 0.95,
			bloomSize = 30,
			bloomThreshold = 1.05,
			sunRays = 0.08,
			skyTop = rgb(40, 10, 8),
			skyBottom = rgb(140, 50, 20),
