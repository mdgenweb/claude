        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Ingredients</string>
            <string name="Source"><![CDATA[--!strict
-- Every brewable ingredient. `price = 0` means it cannot be bought (earned only).

export type Ingredient = {
	id: string,
	name: string,
	icon: string,
	rarity: string,
	price: number,
	unlockLevel: number,
	color: Color3,
	description: string,
	order: number,
}

local list: { Ingredient } = {
	{
		id = "ember_root",
		name = "Ember Root",
		icon = "🔥",
		rarity = "Common",
		price = 12,
		unlockLevel = 1,
		color = Color3.fromRGB(255, 122, 44),
		description = "A root that never stops smouldering.",
		order = 1,
	},
	{
		id = "frost_lotus",
		name = "Frost Lotus",
		icon = "❄️",
		rarity = "Common",
		price = 12,
		unlockLevel = 1,
		color = Color3.fromRGB(122, 214, 255),
		description = "Petals cold enough to freeze a thought.",
		order = 2,
	},
	{
		id = "gale_feather",
		name = "Gale Feather",
		icon = "🌪️",
		rarity = "Common",
		price = 12,
		unlockLevel = 1,
		color = Color3.fromRGB(214, 247, 255),
		description = "Shed by a bird that never lands.",
		order = 3,
	},
	{
		id = "slime_gel",
		name = "Slime Gel",
		icon = "💚",
		rarity = "Common",
		price = 12,
		unlockLevel = 1,
		color = Color3.fromRGB(96, 232, 96),
		description = "Wobbly, bouncy and slightly alive.",
		order = 4,
	},
	{
		id = "moon_dew",
		name = "Moon Dew",
		icon = "💧",
		rarity = "Common",
		price = 15,
		unlockLevel = 2,
		color = Color3.fromRGB(96, 146, 255),
		description = "Collected at midnight from silver leaves.",
		order = 5,
	},
	{
		id = "boom_spore",
		name = "Boom Spore",
		icon = "🍄",
		rarity = "Uncommon",
		price = 30,
		unlockLevel = 3,
