        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict
-- Redeemable codes (server-only so unreleased codes stay secret). Keys are matched case-insensitively.
-- Ship new codes on milestones ("1KLIKES", "1MVISITS"...) and announce them in the game description.

export type CodeReward = {
	coins: number?,
	spins: number?,
	ingredients: { [string]: number }?,
	skin: string?,
	expires: number?, -- os.time() after which the code stops working
}

local Codes: { [string]: CodeReward } = {
	FIRSTBREW = { coins = 150, ingredients = { ember_root = 3, frost_lotus = 3 } },
	KABOOM = { spins = 1, ingredients = { boom_spore = 3 } },
	BUBBLES = { coins = 200, ingredients = { slime_gel = 4, moon_dew = 2 } },
	GOLEMGANG = { skin = "moss", coins = 100 },
	STORMY = { ingredients = { storm_moss = 3, gale_feather = 3 } },
}

return Codes
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Server bootstrap: creates remotes, then initialises and starts every service in order.
-- Services receive a shared table of all services in Init so they can call each other at runtime
-- without circular requires.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
Net.setup()

local ORDER = {
	"DataService",
	"EconomyService",
	"ShopService",
	"LabService",
	"GolemService",
	"PropService",
	"GrabService",
	"EffectsService",
	"PotionService",
	"HazardService",
	"ChallengeService",
	"TrialService",
	"CursorService",
}

local servicesFolder = script.Parent:WaitForChild("Services")
local services = {}
for _, name in ORDER do
	services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ORDER do
	local service = services[name]
	if service.Init then
		service:Init(services)
	end
end

for _, name in ORDER do
	local service = services[name]
	if service.Start then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn(("[Main] %s failed to start: %s"):format(name, tostring(err)))
		end
	end
end

-- Only now start loading players, so every service is subscribed to ProfileLoaded.
services.DataService:BeginPlayers()

print(("[Flask Fiasco] server ready with %d services"):format(#ORDER))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
