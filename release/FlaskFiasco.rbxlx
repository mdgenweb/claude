        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Potions</string>
            <string name="Source"><![CDATA[--!strict
-- Every potion in the codex. Effects are implemented server-side (Systems/Effects) by `effect` id.
--  kind = "status": applies a status to golems within `radius` of the splash (or the fed golem).
--  kind = "field":  spawns a world effect at the impact point (or centred on the fed golem).

export type BottleShape = "round" | "tall" | "square" | "heart" | "skull" | "star" | "flask"

export type Potion = {
	id: string,
	name: string,
	rarity: string,
	color: Color3,
	bottle: BottleShape,
	recipe: { string },
	description: string,
	hint: string,
	effect: string,
	kind: "status" | "field",
	duration: number,
	radius: number,
	puddle: string?,
	order: number,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local list: { Potion } = {
	-- ── Common ──
	{
		id = "healing_elixir",
		name = "Healing Elixir",
		rarity = "Common",
		color = rgb(255, 92, 140),
		bottle = "heart",
		recipe = { "moon_dew", "moon_dew" },
		description = "Reforms a golem good as new and washes away every effect.",
		hint = "Midnight water, twice blessed.",
		effect = "heal",
		kind = "status",
		duration = 0,
		radius = 12,
		puddle = "heal",
		order = 1,
	},
	{
		id = "inferno_brew",
		name = "Inferno Brew",
		rarity = "Common",
		color = rgb(255, 106, 28),
		bottle = "round",
		recipe = { "ember_root", "ember_root" },
		description = "Sets golems ablaze. Fire spreads to anything they touch.",
		hint = "Fire, doubled.",
		effect = "burning",
		kind = "status",
		duration = 8,
		radius = 11,
		puddle = "fire",
		order = 2,
	},
	{
		id = "frost_tonic",
		name = "Frost Tonic",
		rarity = "Common",
		color = rgb(120, 220, 255),
		bottle = "tall",
		recipe = { "frost_lotus", "frost_lotus" },
		description = "Freezes golems solid. A hard hit will shatter them!",
		hint = "Cold upon cold.",
		effect = "frozen",
		kind = "status",
		duration = 10,
		radius = 11,
		puddle = "ice",
		order = 3,
	},
	{
		id = "levitation_elixir",
		name = "Levitation Elixir",
		rarity = "Common",
		color = rgb(200, 170, 255),
		bottle = "flask",
		recipe = { "gale_feather", "gale_feather" },
		description = "Golems float gently towards the ceiling.",
		hint = "Two feathers make a cloud.",
		effect = "levitating",
		kind = "status",
		duration = 9,
		radius = 11,
		order = 4,
	},
	{
		id = "bouncy_goo",
		name = "Bouncy Goo",
		rarity = "Common",
		color = rgb(110, 240, 120),
		bottle = "round",
		recipe = { "slime_gel", "slime_gel" },
		description = "Turns golems into rubber. Splashed floors become trampolines.",
		hint = "Slime, but more.",
		effect = "bouncy",
		kind = "status",
		duration = 12,
		radius = 11,
		puddle = "bounce",
		order = 5,
	},
	{
		id = "murky_sludge",
		name = "Murky Sludge",
		rarity = "Common",
		color = rgb(110, 116, 60),
		bottle = "square",
		recipe = {},
		description = "A failed brew. Smells like a swamp's sock drawer.",
		hint = "What happens when nothing matches.",
		effect = "sludge",
		kind = "field",
		duration = 7,
		radius = 12,
		puddle = "sludge",
		order = 31,
	},
	-- ── Uncommon ──
	{
