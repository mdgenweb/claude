		reaction.icon .. " " .. reaction.name:upper() .. "!",
		reaction.color,
		40,
		6,
		1.4
	)
	ring(d.p, 12, reaction.color, 0.5)
	sparkles(d.p, reaction.color, 26, 22)
	C.CameraController:Punch(0.8)
