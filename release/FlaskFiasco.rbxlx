            <string name="Name">Challenges</string>
            <string name="Source"><![CDATA[--!strict
-- Daily challenge templates and handcrafted Trials.
--
-- Events emitted by the server (Systems/ChallengeTracker):
--   damage(amount)  brew(potionId)  discover(potionId)  status(statusId, golemId)  shatter(golemId)
--   goldshatter(golemId)  height(studs)  airtime(seconds)  reaction(reactionId)  ko(golemId)
--   fling(speed)  zone(zoneId, golemId)

export type DailyTemplate = {
	id: string,
	text: string, -- "%d" is replaced by the target
	event: string,
	filter: string?,
	mode: "sum" | "count" | "max",
	targets: { number }, -- easy, medium, hard
	minLevel: number,
	icon: string,
}

export type Objective = {
	event: string,
	filter: string?,
	target: number,
	mode: "sum" | "count" | "max",
	unique: boolean?, -- count each golem only once
	text: string,
}

export type TrialGolem = { x: number, y: number?, skin: string? }
export type TrialProp = { id: string, x: number, y: number? }
export type TrialZone = { id: string, x: number, y: number, w: number, h: number, visual: string }

export type Trial = {
	id: string,
	name: string,
	icon: string,
	description: string,
	order: number,
	map: string,
	golems: { TrialGolem },
	props: { TrialProp },
	zones: { TrialZone },
	potions: { [string]: number }, -- provided free for the trial (math.huge = infinite)
	objective: Objective,
	timeLimit: number,
	stars: { number }, -- {limit for 1★, ≤ for 2★, ≤ for 3★}
	reward: { coins: number, xp: number, ingredients: { [string]: number }?, skin: string? },
	requiresStars: number?,
	final: boolean?,
}

local INF = math.huge

local Daily: { DailyTemplate } = {
	{
		id = "damage",
		text = "Deal %d damage",
		event = "damage",
		mode = "sum",
		targets = { 1500, 3500, 7000 },
		minLevel = 1,
		icon = "💥",
	},
	{
		id = "brew",
		text = "Brew %d potions",
		event = "brew",
		mode = "count",
		targets = { 3, 6, 10 },
		minLevel = 1,
		icon = "🧪",
	},
	{
		id = "burn",
		text = "Set %d golems on fire",
		event = "status",
		filter = "burning",
		mode = "count",
		targets = { 3, 6, 10 },
		minLevel = 1,
		icon = "🔥",
	},
	{
		id = "freeze",
		text = "Freeze %d golems",
		event = "status",
		filter = "frozen",
		mode = "count",
		targets = { 3, 6, 10 },
		minLevel = 1,
		icon = "❄️",
	},
	{
		id = "float",
		text = "Make %d golems levitate",
		event = "status",
		filter = "levitating",
		mode = "count",
		targets = { 3, 5, 8 },
		minLevel = 1,
		icon = "🎈",
	},
	{
		id = "shatter",
		text = "Shatter %d frozen golems",
		event = "shatter",
		mode = "count",
		targets = { 1, 3, 5 },
		minLevel = 1,
		icon = "🧊",
	},
	{
		id = "height",
		text = "Launch a golem %d studs high",
		event = "height",
		mode = "max",
		targets = { 30, 45, 120 },
		minLevel = 1,
		icon = "🚀",
	},
	{
		id = "airtime",
		text = "Keep a golem airborne for %d seconds",
		event = "airtime",
		mode = "max",
		targets = { 3, 5, 8 },
		minLevel = 1,
		icon = "🪂",
	},
	{
		id = "fling",
		text = "Fling a golem at %d studs/s",
		event = "fling",
		mode = "max",
		targets = { 110, 170, 240 },
		minLevel = 1,
		icon = "🤾",
	},
	{
		id = "ko",
		text = "Knock out %d golems",
		event = "ko",
		mode = "count",
		targets = { 2, 4, 8 },
		minLevel = 1,
		icon = "😵",
	},
	{
		id = "reaction",
		text = "Trigger %d potion reactions",
		event = "reaction",
		mode = "count",
		targets = { 1, 3, 6 },
		minLevel = 3,
		icon = "⚗️",
	},
	{
		id = "shock",
		text = "Shock %d golems",
		event = "status",
		filter = "shocked",
		mode = "count",
		targets = { 3, 6, 10 },
		minLevel = 4,
		icon = "⚡",
	},
	{
