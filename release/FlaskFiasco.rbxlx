        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">AlchemyLab</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Default lab: candle-lit stone workshop with shelves, windows, chandelier and a work table.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2
	local stone = Color3.fromRGB(96, 82, 94)
	local wood = Color3.fromRGB(96, 64, 46)
	local darkWood = Color3.fromRGB(58, 38, 30)

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(128, 88, 62),
		floorMaterial = Enum.Material.WoodPlanks,
		wallColor = stone,
		wallMaterial = Enum.Material.Brick,
		backColor = Color3.fromRGB(84, 70, 84),
		backMaterial = Enum.Material.Brick,
		ceilingColor = darkWood,
		ceilingMaterial = Enum.Material.Wood,
		frameColor = darkWood,
		frameMaterial = Enum.Material.Wood,
	})

	local deco = b:child("Decor")

	-- Stone skirting and pillars along the back wall.
	deco:part({
		name = "Skirting",
		size = Vector3.new(W, 2.4, 1.6),
		at = Vector3.new(0, 1.2, -10.2),
		color = Color3.fromRGB(70, 60, 72),
		material = Enum.Material.Cobblestone,
	})
	for _, x in { -halfW + 3, -18, 18, halfW - 3 } do
		deco:part({
			name = "Pillar",
			size = Vector3.new(4, H, 2.4),
			at = Vector3.new(x, H / 2, -9.8),
			color = Color3.fromRGB(110, 96, 108),
			material = Enum.Material.Slate,
		})
	end
	-- Ceiling beams.
	for i = -3, 3 do
		deco:part({
			name = "Beam",
			size = Vector3.new(2, 2.2, 22),
			at = Vector3.new(i * 16, H - 1.1, 0),
			color = darkWood,
			material = Enum.Material.Wood,
		})
	end

	-- Windows with moonlight.
	local moon = Color3.fromRGB(150, 180, 255)
	deco:window(-36, 34, 12, 16, darkWood, moon)
	deco:window(36, 34, 12, 16, darkWood, moon)

	-- Glowing alchemy circle on the back wall.
	local ringRot = CFrame.Angles(0, math.rad(90), 0)
	deco:part({
		name = "SigilOuter",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.2, 18, 18),
		at = Vector3.new(0, 36, -10.6),
		rot = ringRot,
		color = Color3.fromRGB(170, 90, 255),
		material = Enum.Material.Neon,
		transparency = 0.55,
		shadow = false,
	})
	deco:part({
		name = "SigilInner",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.25, 16.6, 16.6),
		at = Vector3.new(0, 36, -10.5),
		rot = ringRot,
		color = Color3.fromRGB(60, 40, 80),
		material = Enum.Material.Slate,
		shadow = false,
	})
	local core = deco:part({
		name = "SigilCore",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.3, 5, 5),
		at = Vector3.new(0, 36, -10.4),
		rot = ringRot,
		color = Color3.fromRGB(200, 140, 255),
		material = Enum.Material.Neon,
		transparency = 0.2,
		shadow = false,
	})
	for i = 0, 5 do
		local angle = math.rad(i * 60)
		deco:part({
			name = "SigilSpoke",
			size = Vector3.new(0.3, 7, 0.3),
			at = Vector3.new(math.cos(angle) * 4, 36 + math.sin(angle) * 4, -10.35),
			rot = CFrame.Angles(0, 0, angle + math.rad(90)),
			color = Color3.fromRGB(200, 140, 255),
			material = Enum.Material.Neon,
			transparency = 0.3,
			shadow = false,
		})
	end
	core:AddTag("Spinner")
	core:SetAttribute("SpinSpeed", 0.4)
	deco:light(
		core,
		"PointLight",
		{ Color = Color3.fromRGB(170, 100, 255), Brightness = 1.2, Range = 22, Shadows = false }
	)

	-- Shelves full of bottles and books.
	deco:bottleShelf(-46, 14, 14, rng)
	deco:bottleShelf(-46, 22, 14, rng)
	deco:bottleShelf(46, 18, 12, rng)
	deco:bottleShelf(-8, 50, 22, rng)
	deco:books(-28, 14.3, 9, rng)
	deco:part({
		name = "Shelf",
		size = Vector3.new(12, 0.6, 3),
		at = Vector3.new(-24, 14, -9.2),
		color = wood,
		material = Enum.Material.WoodPlanks,
	})
	deco:books(22, 24.3, 12, rng)
	deco:part({
		name = "Shelf",
		size = Vector3.new(14, 0.6, 3),
		at = Vector3.new(26, 24, -9.2),
		color = wood,
		material = Enum.Material.WoodPlanks,
	})

	-- Hanging herbs.
	for i = 1, 7 do
		local x = -30 + i * 8 + rng:NextNumber(-1, 1)
		local len = rng:NextNumber(3, 6)
		deco:part({
			name = "String",
			size = Vector3.new(0.1, len, 0.1),
			at = Vector3.new(x, H - 2.2 - len / 2, -6),
			color = Color3.fromRGB(200, 190, 160),
			material = Enum.Material.Fabric,
			shadow = false,
		})
		deco:part({
			name = "Herb",
			size = Vector3.new(1.2, 1.6, 1.2),
			at = Vector3.new(x, H - 2.6 - len, -6),
			color = Color3.fromRGB(70 + rng:NextInteger(0, 40), 120, 60),
			material = Enum.Material.LeafyGrass,
			shape = Enum.PartType.Ball,
		})
	end

	-- Chandelier.
	local chandelier = deco:part({
		name = "Chandelier",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.6, 10, 10),
		at = Vector3.new(0, H - 12, -2),
		rot = CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(70, 56, 40),
		material = Enum.Material.Metal,
	})
	deco:part({
		name = "Chain",
		size = Vector3.new(0.3, 9, 0.3),
		at = Vector3.new(0, H - 7, -2),
		color = Color3.fromRGB(70, 60, 50),
		material = Enum.Material.Metal,
	})
	for i = 0, 5 do
		local angle = math.rad(i * 60)
		local px, pz = math.cos(angle) * 4.4, math.sin(angle) * 4.4 - 2
		deco:part({
			name = "Candle",
			size = Vector3.new(0.5, 1.4, 0.5),
			at = Vector3.new(px, H - 11, pz),
			color = Color3.fromRGB(245, 236, 210),
			material = Enum.Material.SmoothPlastic,
		})
		local flame = deco:part({
			name = "CandleFlame",
			shape = Enum.PartType.Ball,
			size = Vector3.one * 0.45,
			at = Vector3.new(px, H - 10, pz),
			color = Color3.fromRGB(255, 196, 110),
			material = Enum.Material.Neon,
			shadow = false,
		})
		if i % 2 == 0 then
			local light = deco:light(
				flame,
				"PointLight",
				{ Color = Color3.fromRGB(255, 180, 110), Brightness = 1.3, Range = 22, Shadows = true }
			)
			light:AddTag("Flicker")
		end
	end
	local _ = chandelier

	-- Wall torches.
	deco:torch(-halfW + 6, 26, -8.5, Color3.fromRGB(255, 160, 70), 24)
	deco:torch(halfW - 6, 26, -8.5, Color3.fromRGB(255, 160, 70), 24)

	-- Rug.
	deco:part({
		name = "Rug",
		size = Vector3.new(30, 0.12, 9),
		at = Vector3.new(0, 0.07, -2),
		color = Color3.fromRGB(130, 40, 60),
		material = Enum.Material.Fabric,
		shadow = false,
	})
	deco:part({
		name = "RugTrim",
		size = Vector3.new(31, 0.1, 10),
		at = Vector3.new(0, 0.05, -2),
		color = Color3.fromRGB(214, 170, 82),
		material = Enum.Material.Fabric,
		shadow = false,
	})

	-- Foreground clutter on the front edge (frames the diorama without blocking play).
	deco:part({
		name = "FrontBarrel",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(3, 2.6, 2.6),
		at = Vector3.new(-halfW + 4, 1.5, 9),
		rot = CFrame.Angles(0, 0, math.rad(90)),
		color = wood,
		material = Enum.Material.Wood,
	})
	deco:part({
		name = "FrontCrate",
		size = Vector3.new(3, 2, 3),
		at = Vector3.new(halfW - 5, 1, 9.5),
		rot = CFrame.Angles(0, math.rad(20), 0),
		color = Color3.fromRGB(150, 110, 70),
		material = Enum.Material.WoodPlanks,
	})

	-- Work table (solid): golems can be knocked off it.
	local solids = b:child("Solids")
	solids:solid({
		name = "TableTop",
		size = Vector3.new(16, 1, 8),
		at = Vector3.new(26, 8, -0.5),
		color = Color3.fromRGB(140, 96, 64),
		material = Enum.Material.WoodPlanks,
	})
	for _, x in { 19.5, 32.5 } do
		solids:solid({
			name = "TableLeg",
			size = Vector3.new(1, 7.5, 1),
			at = Vector3.new(x, 3.75, -0.5),
			color = darkWood,
			material = Enum.Material.Wood,
		})
	end
	-- A high wooden ledge on the left.
	solids:solid({
		name = "Ledge",
		size = Vector3.new(14, 1.2, 8),
		at = Vector3.new(-halfW + 7, 30, -0.5),
		color = Color3.fromRGB(110, 76, 54),
		material = Enum.Material.WoodPlanks,
	})

	return {
		cauldron = Vector3.new(-30, 0, -5.5),
		rack = Vector3.new(halfW - 14, 0, -8.8),
		spawn = Vector3.new(0, 0, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BounceCastle</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pastel bouncy castle: rubber floor and walls plus pinball bumpers that kick golems away.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2
	local rubber = PhysicalProperties.new(0.8, 0.3, 0.95, 1, 100)

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(255, 140, 190),
		floorMaterial = Enum.Material.Rubber,
		wallColor = Color3.fromRGB(150, 200, 255),
		wallMaterial = Enum.Material.Rubber,
		backColor = Color3.fromRGB(255, 220, 150),
		backMaterial = Enum.Material.Fabric,
		ceilingColor = Color3.fromRGB(190, 150, 255),
		ceilingMaterial = Enum.Material.Rubber,
		frameColor = Color3.fromRGB(255, 120, 170),
		frameMaterial = Enum.Material.Plastic,
		floorPhysics = rubber,
		wallPhysics = rubber,
	})

	local solids = b:child("Solids")
	local deco = b:child("Decor")

	-- Inflatable stripes on the back wall.
	local stripeColors = {
		Color3.fromRGB(255, 120, 170),
		Color3.fromRGB(120, 200, 255),
		Color3.fromRGB(255, 220, 90),
		Color3.fromRGB(150, 255, 160),
	}
	for i = 0, 13 do
		deco:part({
			name = "Stripe",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(H, 4, 4),
			at = Vector3.new(-halfW + 4 + i * 8, H / 2, -10.2),
			rot = CFrame.Angles(0, 0, math.rad(90)),
			color = stripeColors[i % 4 + 1],
			material = Enum.Material.Rubber,
		})
	end
	-- Turrets with flags along the top.
	for _, x in { -halfW + 8, -20, 20, halfW - 8 } do
		deco:part({
			name = "Turret",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(10, 7, 7),
			at = Vector3.new(x, H - 6, -8),
			rot = CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(255, 160, 200),
			material = Enum.Material.Rubber,
		})
		deco:part({
			name = "FlagPole",
			size = Vector3.new(0.3, 5, 0.3),
			at = Vector3.new(x, H + 1.5, -8),
			color = Color3.fromRGB(240, 240, 240),
			material = Enum.Material.Metal,
		})
		deco:part({
			name = "Flag",
			size = Vector3.new(3, 1.8, 0.1),
			at = Vector3.new(x + 1.6, H + 3, -8),
			color = stripeColors[rng:NextInteger(1, 4)],
			material = Enum.Material.Fabric,
		})
	end

	-- Bumpers (round discs facing the camera).
	local bumpers = {
		{ x = -30, y = 22, r = 5 },
		{ x = 0, y = 34, r = 6 },
		{ x = 30, y = 22, r = 5 },
		{ x = -14, y = 46, r = 4 },
		{ x = 14, y = 46, r = 4 },
	}
	for _, spec in bumpers do
		local bumper = solids:solid({
			name = "Bumper",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(8, spec.r * 2, spec.r * 2),
			at = Vector3.new(spec.x, spec.y, -0.5),
			rot = CFrame.Angles(0, math.rad(90), 0),
			color = Color3.fromRGB(255, 80, 150),
			material = Enum.Material.Neon,
			physics = rubber,
			attributes = { Hazard = "Bumper", BumperForce = 140 },
		})
		bumper.CanTouch = true
		local ring = deco:part({
			name = "BumperRing",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(8.4, spec.r * 2 + 1, spec.r * 2 + 1),
			at = Vector3.new(spec.x, spec.y, -0.8),
			rot = CFrame.Angles(0, math.rad(90), 0),
			color = Color3.fromRGB(255, 255, 255),
			material = Enum.Material.SmoothPlastic,
		})
		local _ = ring
		deco:light(bumper, "PointLight", { Color = Color3.fromRGB(255, 120, 190), Brightness = 1, Range = 14 })
	end

	-- Springy platforms near the floor.
	for _, x in { -40, 40 } do
		local pad = solids:solid({
			name = "SpringPad",
			size = Vector3.new(10, 1, 8),
			at = Vector3.new(x, 1.5, -0.5),
			color = Color3.fromRGB(120, 255, 160),
			material = Enum.Material.Neon,
			physics = PhysicalProperties.new(0.8, 0.3, 1, 1, 100),
			attributes = { Hazard = "Trampoline", LaunchSpeed = 140 },
		})
		pad.CanTouch = true
	end

	-- Confetti drifting from above.
	local confettiHost = deco:part({
		name = "Confetti",
		size = Vector3.new(W, 1, 6),
		at = Vector3.new(0, H - 2, -1),
		transparency = 1,
		shadow = false,
	})
	deco:emitter(confettiHost, {
		Texture = "rbxasset://textures/particles/SquareParticle.png",
		Rate = 10,
		Lifetime = NumberRange.new(5, 8),
		Speed = NumberRange.new(1, 3),
		Size = b.seq(0, 0.35, 1, 0.3),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 170)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(120, 200, 255)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(255, 220, 90)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 255, 160)),
		}),
		EmissionDirection = Enum.NormalId.Bottom,
		Shape = Enum.ParticleEmitterShape.Box,
		Acceleration = Vector3.new(0, -3, 0),
	})
	local sun = deco:part({
		name = "Glow",
		size = Vector3.new(1, 1, 1),
		at = Vector3.new(0, H - 8, 6),
		transparency = 1,
		shadow = false,
	})
	deco:light(
		sun,
		"PointLight",
		{ Color = Color3.fromRGB(255, 240, 250), Brightness = 1.2, Range = 60, Shadows = true }
	)

	return {
		cauldron = Vector3.new(-24, 0, -5.5),
		rack = Vector3.new(halfW - 14, 0, -8.8),
		spawn = Vector3.new(0, 0, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Tiny declarative helper for building lab geometry from primitive parts.
-- All positions are LOCAL to the lab origin: x = right, y = up (floor at 0), z = towards camera
-- (z = 0 is the play plane, the back wall sits around z = -10).

local Builder = {}
Builder.__index = Builder

export type PartSpec = {
	name: string?,
	size: Vector3,
	at: Vector3,
	rot: CFrame?,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	shape: Enum.PartType?,
	collide: boolean?, -- default false (decoration)
	query: boolean?, -- default = collide
	touch: boolean?, -- default false
	shadow: boolean?, -- default true
	physics: PhysicalProperties?,
	attributes: { [string]: any }?,
	tags: { string }?,
	class: string?, -- "Part" | "WedgePart" | "CornerWedgePart" | "TrussPart"
}

function Builder.new(parent: Instance, origin: CFrame)
	return setmetatable({ parent = parent, origin = origin, count = 0 }, Builder)
end

function Builder:child(name: string)
	local folder = Instance.new("Model")
	folder.Name = name
	folder.Parent = self.parent
	return setmetatable({ parent = folder, origin = self.origin, count = 0 }, Builder), folder
end

function Builder:world(localPosition: Vector3): Vector3
	return self.origin * localPosition
end

function Builder:part(spec: PartSpec): BasePart
	local part = Instance.new(spec.class or "Part") :: BasePart
	if spec.shape and part:IsA("Part") then
		part.Shape = spec.shape
	end
	part.Name = spec.name or "Part"
	part.Size = spec.size
	part.CFrame = self.origin * CFrame.new(spec.at) * (spec.rot or CFrame.identity)
	part.Anchored = true
	part.Color = spec.color or Color3.fromRGB(120, 110, 130)
	part.Material = spec.material or Enum.Material.SmoothPlastic
	part.Transparency = spec.transparency or 0
	part.Reflectance = spec.reflectance or 0
	local collide = spec.collide == true
	part.CanCollide = collide
	part.CanQuery = if spec.query ~= nil then spec.query else collide
	part.CanTouch = spec.touch == true
	part.CastShadow = spec.shadow ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if collide then
		part.CollisionGroup = "Static"
	end
	if spec.physics then
		part.CustomPhysicalProperties = spec.physics
	end
	if spec.attributes then
		for key, value in spec.attributes do
			part:SetAttribute(key, value)
		end
	end
	if spec.tags then
		for _, tag in spec.tags do
			part:AddTag(tag)
		end
	end
	part.Parent = self.parent
	self.count += 1
	return part
end

-- Solid static collider (floors, walls, platforms).
function Builder:solid(spec: PartSpec): BasePart
	spec.collide = true
	return self:part(spec)
end

function Builder:light(part: BasePart, kind: string, props: { [string]: any }): Light
	local light = Instance.new(kind) :: Light
	for key, value in props do
		(light :: any)[key] = value
	end
	light.Parent = part
	return light
end

function Builder:emitter(part: Instance, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = part
	return emitter
end

local function seq(...): NumberSequence
	local points = { ... }
	local keypoints = {}
	for i = 1, #points, 2 do
		table.insert(keypoints, NumberSequenceKeypoint.new(points[i], points[i + 1]))
	end
	return NumberSequence.new(keypoints)
end
Builder.seq = seq

-- Standard room shell: floor, back wall, side walls, ceiling and a diorama frame at the front.
export type ShellSpec = {
	width: number,
	height: number,
	floorColor: Color3,
	floorMaterial: Enum.Material,
	wallColor: Color3,
	wallMaterial: Enum.Material,
	backColor: Color3?,
	backMaterial: Enum.Material?,
	ceilingColor: Color3?,
	ceilingMaterial: Enum.Material?,
	frameColor: Color3,
	frameMaterial: Enum.Material,
	noCeiling: boolean?,
	floorPhysics: PhysicalProperties?,
	wallPhysics: PhysicalProperties?,
}

function Builder:shell(spec: ShellSpec)
	local W, H = spec.width, spec.height
	local halfW = W / 2
	local shell, model = self:child("Shell")

	shell:solid({
		name = "Floor",
		size = Vector3.new(W + 12, 6, 24),
		at = Vector3.new(0, -3, 1),
		color = spec.floorColor,
		material = spec.floorMaterial,
		physics = spec.floorPhysics,
	})
	shell:solid({
		name = "BackWall",
		size = Vector3.new(W + 12, H + 12, 3),
		at = Vector3.new(0, H / 2, -12.5),
		color = spec.backColor or spec.wallColor,
		material = spec.backMaterial or spec.wallMaterial,
	})
	for _, side in { -1, 1 } do
		shell:solid({
			name = if side < 0 then "LeftWall" else "RightWall",
			size = Vector3.new(8, H + 12, 24),
			at = Vector3.new(side * (halfW + 4), H / 2, 1),
			color = spec.wallColor,
			material = spec.wallMaterial,
			physics = spec.wallPhysics,
		})
	end
	if not spec.noCeiling then
		shell:solid({
			name = "Ceiling",
			size = Vector3.new(W + 12, 6, 24),
			at = Vector3.new(0, H + 3, 1),
			color = spec.ceilingColor or spec.wallColor,
			material = spec.ceilingMaterial or spec.wallMaterial,
			physics = spec.wallPhysics,
		})
	end

	-- Diorama frame around the opening (visual only).
	local frameDepth = 2
	local z = 13 + frameDepth / 2
	local frame = {
		{ size = Vector3.new(10, H + 22, frameDepth), at = Vector3.new(-(halfW + 5), H / 2, z) },
		{ size = Vector3.new(10, H + 22, frameDepth), at = Vector3.new(halfW + 5, H / 2, z) },
		{ size = Vector3.new(W + 30, 6, frameDepth), at = Vector3.new(0, H + 5, z) },
		{ size = Vector3.new(W + 30, 6, frameDepth), at = Vector3.new(0, -5, z) },
	}
	for _, piece in frame do
		shell:part({
			name = "Frame",
			size = piece.size,
			at = piece.at,
			color = spec.frameColor,
			material = spec.frameMaterial,
		})
	end
	-- Gold trim along the inner edge of the frame.
	local trim = Color3.fromRGB(214, 170, 82)
	shell:part({
		name = "Trim",
		size = Vector3.new(0.6, H + 10, 0.6),
		at = Vector3.new(-(halfW + 0.3), H / 2, z + 1),
		color = trim,
		material = Enum.Material.Foil,
	})
	shell:part({
		name = "Trim",
		size = Vector3.new(0.6, H + 10, 0.6),
		at = Vector3.new(halfW + 0.3, H / 2, z + 1),
		color = trim,
		material = Enum.Material.Foil,
	})
	shell:part({
		name = "Trim",
		size = Vector3.new(W + 1.2, 0.6, 0.6),
		at = Vector3.new(0, H + 2.3, z + 1),
		color = trim,
		material = Enum.Material.Foil,
	})
	shell:part({
		name = "Trim",
		size = Vector3.new(W + 1.2, 0.6, 0.6),
		at = Vector3.new(0, -2.3, z + 1),
		color = trim,
		material = Enum.Material.Foil,
	})
	return model
end

-- A window in the back wall: dark frame, glass pane, moonlight beam and a soft light.
function Builder:window(x: number, y: number, w: number, h: number, frameColor: Color3, lightColor: Color3)
	local zWall = -10.9
	self:part({
		name = "WindowGlass",
		size = Vector3.new(w, h, 0.2),
		at = Vector3.new(x, y, zWall),
		color = lightColor,
		material = Enum.Material.Neon,
		transparency = 0.55,
	})
	self:part({
		name = "WindowFrame",
		size = Vector3.new(w + 1.2, 0.8, 0.8),
		at = Vector3.new(x, y + h / 2 + 0.4, zWall + 0.3),
		color = frameColor,
		material = Enum.Material.Wood,
	})
	self:part({
		name = "WindowFrame",
		size = Vector3.new(w + 1.2, 1.2, 1.4),
		at = Vector3.new(x, y - h / 2 - 0.6, zWall + 0.6),
		color = frameColor,
		material = Enum.Material.Wood,
	})
	self:part({
		name = "WindowFrame",
		size = Vector3.new(0.8, h, 0.8),
		at = Vector3.new(x - w / 2 - 0.2, y, zWall + 0.3),
		color = frameColor,
		material = Enum.Material.Wood,
	})
	self:part({
		name = "WindowFrame",
		size = Vector3.new(0.8, h, 0.8),
		at = Vector3.new(x + w / 2 + 0.2, y, zWall + 0.3),
		color = frameColor,
		material = Enum.Material.Wood,
	})
	self:part({
		name = "WindowMullion",
		size = Vector3.new(0.4, h, 0.4),
		at = Vector3.new(x, y, zWall + 0.2),
		color = frameColor,
		material = Enum.Material.Wood,
	})
	self:part({
		name = "WindowMullion",
		size = Vector3.new(w, 0.4, 0.4),
		at = Vector3.new(x, y, zWall + 0.2),
		color = frameColor,
		material = Enum.Material.Wood,
	})
	local emitterHost = self:part({
		name = "WindowLight",
		size = Vector3.new(w, h, 0.2),
		at = Vector3.new(x, y, zWall + 0.5),
		transparency = 1,
		shadow = false,
	})
	self:light(
		emitterHost,
		"SurfaceLight",
		{ Face = Enum.NormalId.Front, Color = lightColor, Brightness = 1.4, Range = 26, Angle = 70, Shadows = true }
	)
	-- Dust motes drifting in the light.
	self:emitter(emitterHost, {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Rate = 3,
		Lifetime = NumberRange.new(4, 7),
		Speed = NumberRange.new(0.3, 0.8),
		SpreadAngle = Vector2.new(60, 60),
		Size = seq(0, 0.12, 0.5, 0.18, 1, 0),
		Transparency = seq(0, 1, 0.3, 0.4, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(lightColor),
		EmissionDirection = Enum.NormalId.Front,
	})
end

-- Torch/candle with flickering light (client animates lights tagged "Flicker").
function Builder:torch(x: number, y: number, z: number, color: Color3, range: number?)
	self:part({
		name = "TorchHolder",
		size = Vector3.new(0.8, 2.2, 0.8),
		at = Vector3.new(x, y - 1, z),
		color = Color3.fromRGB(60, 46, 40),
		material = Enum.Material.Metal,
	})
	local flame = self:part({
		name = "TorchFlame",
		size = Vector3.new(0.5, 0.8, 0.5),
		at = Vector3.new(x, y + 0.5, z),
		color = color,
		material = Enum.Material.Neon,
		shadow = false,
		shape = Enum.PartType.Ball,
	})
	local light =
		self:light(flame, "PointLight", { Color = color, Brightness = 1.6, Range = range or 18, Shadows = true })
	light:AddTag("Flicker")
	self:emitter(flame, {
		Texture = "rbxasset://textures/particles/fire_main.dds",
		Rate = 14,
		Lifetime = NumberRange.new(0.35, 0.6),
		Speed = NumberRange.new(2, 3.5),
		SpreadAngle = Vector2.new(8, 8),
		Size = seq(0, 0.7, 0.5, 0.5, 1, 0),
		Transparency = seq(0, 0.3, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(color, Color3.fromRGB(255, 80, 30)),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 2, 0),
	})
	return flame
end

-- A shelf with assorted glowing bottles (pure decoration, lots of colour).
function Builder:bottleShelf(x: number, y: number, width: number, rng: Random)
	local wood = Color3.fromRGB(92, 60, 42)
	self:part({
		name = "Shelf",
		size = Vector3.new(width, 0.6, 3),
		at = Vector3.new(x, y, -9.2),
		color = wood,
		material = Enum.Material.WoodPlanks,
	})
	self:part({
		name = "ShelfBracket",
		size = Vector3.new(0.5, 1.6, 2.4),
		at = Vector3.new(x - width / 2 + 1, y - 1, -9.6),
		color = wood,
		material = Enum.Material.Wood,
	})
	self:part({
		name = "ShelfBracket",
		size = Vector3.new(0.5, 1.6, 2.4),
		at = Vector3.new(x + width / 2 - 1, y - 1, -9.6),
		color = wood,
		material = Enum.Material.Wood,
	})
	local palette = {
		Color3.fromRGB(255, 90, 140),
		Color3.fromRGB(90, 220, 255),
		Color3.fromRGB(150, 255, 90),
		Color3.fromRGB(255, 200, 60),
		Color3.fromRGB(190, 110, 255),
		Color3.fromRGB(255, 120, 40),
	}
	local cursor = x - width / 2 + 1.2
	while cursor < x + width / 2 - 1 do
		local h = rng:NextNumber(1.2, 2.6)
		local w = rng:NextNumber(0.7, 1.3)
		local color = palette[rng:NextInteger(1, #palette)]
		local shape = if rng:NextNumber() < 0.4 then Enum.PartType.Ball else Enum.PartType.Block
		if shape == Enum.PartType.Ball then
			self:part({
				name = "Bottle",
				size = Vector3.one * w * 1.2,
				at = Vector3.new(cursor, y + 0.3 + w * 0.6, -9),
				color = Color3.fromRGB(220, 240, 255),
				material = Enum.Material.Glass,
				transparency = 0.5,
				shadow = false,
				shape = shape,
			})
			self:part({
				name = "BottleLiquid",
				size = Vector3.one * w,
				at = Vector3.new(cursor, y + 0.3 + w * 0.55, -9),
				color = color,
				material = Enum.Material.Neon,
				shadow = false,
				shape = shape,
			})
		else
			self:part({
				name = "Bottle",
				size = Vector3.new(w, h, w),
				at = Vector3.new(cursor, y + 0.3 + h / 2, -9),
				color = Color3.fromRGB(220, 240, 255),
				material = Enum.Material.Glass,
				transparency = 0.5,
				shadow = false,
			})
			self:part({
				name = "BottleLiquid",
				size = Vector3.new(w * 0.8, h * 0.6, w * 0.8),
				at = Vector3.new(cursor, y + 0.3 + h * 0.32, -9),
				color = color,
				material = Enum.Material.Neon,
				shadow = false,
			})
		end
		cursor += w + rng:NextNumber(0.25, 0.7)
	end
end

-- Stack of books on a shelf.
function Builder:books(x: number, y: number, count: number, rng: Random)
	local colors = {
		Color3.fromRGB(150, 40, 50),
		Color3.fromRGB(40, 80, 140),
		Color3.fromRGB(60, 120, 70),
		Color3.fromRGB(140, 100, 40),
		Color3.fromRGB(90, 50, 120),
	}
	local cursor = x
	for _ = 1, count do
		local h = rng:NextNumber(1.6, 2.4)
		local w = rng:NextNumber(0.35, 0.6)
		self:part({
			name = "Book",
			size = Vector3.new(w, h, 1.8),
			at = Vector3.new(cursor, y + h / 2, -9.4),
			color = colors[rng:NextInteger(1, #colors)],
			material = Enum.Material.Fabric,
		})
		cursor += w + 0.05
	end
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CrusherWorks</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Factory floor with two hydraulic crushers and a conveyor belt feeding them.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2
	local steel = Color3.fromRGB(88, 94, 104)

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(110, 112, 116),
		floorMaterial = Enum.Material.Concrete,
		wallColor = steel,
		wallMaterial = Enum.Material.DiamondPlate,
		backColor = Color3.fromRGB(78, 84, 92),
		backMaterial = Enum.Material.CorrodedMetal,
		ceilingColor = Color3.fromRGB(60, 64, 72),
		ceilingMaterial = Enum.Material.Metal,
		frameColor = Color3.fromRGB(40, 42, 48),
		frameMaterial = Enum.Material.Metal,
	})

	local solids = b:child("Solids")
	local deco = b:child("Decor")
	local hazards = b:child("Hazards")

	-- Hazard stripes along the floor edge.
	for i = 0, 27 do
		deco:part({
			name = "Stripe",
			size = Vector3.new(2, 0.12, 1.4),
			at = Vector3.new(-halfW + 2 + i * 4, 0.07, -7.6),
			rot = CFrame.Angles(0, math.rad(35), 0),
			color = if i % 2 == 0 then Color3.fromRGB(255, 200, 40) else Color3.fromRGB(30, 30, 34),
			material = Enum.Material.SmoothPlastic,
			shadow = false,
		})
	end

	-- Two crushers. HazardService animates parts tagged "Crusher".
	for index, x in { -22, 16 } do
		deco:part({
			name = "PistonHousing",
			size = Vector3.new(8, 8, 9),
			at = Vector3.new(x, H - 4, -1),
			color = Color3.fromRGB(70, 74, 84),
			material = Enum.Material.DiamondPlate,
		})
		local head = hazards:solid({
			name = "CrusherHead",
			size = Vector3.new(12, 5, 10),
			at = Vector3.new(x, H - 12, -0.5),
			color = Color3.fromRGB(210, 60, 50),
			material = Enum.Material.Metal,
			attributes = { Hazard = "Crusher", TopY = H - 12, BottomY = 2.6, Period = 3.4, Phase = index * 1.6 },
		})
		head.CanTouch = true
		-- Warning stripes on the head.
		for s = -2, 2 do
			hazards:part({
				name = "HeadStripe",
				size = Vector3.new(1.2, 4.6, 0.2),
				at = Vector3.new(x + s * 2.4, H - 12, 4.6),
				rot = CFrame.Angles(0, 0, math.rad(30)),
				color = Color3.fromRGB(255, 210, 40),
				material = Enum.Material.SmoothPlastic,
				shadow = false,
				attributes = { CrusherChild = index },
			})
		end
		head:SetAttribute("CrusherIndex", index)
		local rod = hazards:part({
			name = "CrusherRod",
			size = Vector3.new(2.4, 10, 2.4),
			at = Vector3.new(x, H - 6, -0.5),
			color = Color3.fromRGB(200, 205, 215),
			material = Enum.Material.Metal,
			attributes = { CrusherChild = index },
		})
		local _ = rod
		-- Warning lamp.
		local lamp = deco:part({
			name = "WarningLamp",
			shape = Enum.PartType.Ball,
			size = Vector3.one * 1.4,
			at = Vector3.new(x + 5, H - 2, 3),
			color = Color3.fromRGB(255, 120, 30),
			material = Enum.Material.Neon,
			shadow = false,
		})
		deco:light(lamp, "PointLight", { Color = Color3.fromRGB(255, 120, 30), Brightness = 1.5, Range = 16 })
			:AddTag("Flicker")
	end

	-- Conveyor belt on the right that carries things towards the crusher.
	local belt = hazards:solid({
		name = "Conveyor",
		size = Vector3.new(24, 1.2, 9),
		at = Vector3.new(halfW - 14, 0.6, -0.5),
		color = Color3.fromRGB(40, 40, 46),
		material = Enum.Material.Rubber,
		physics = PhysicalProperties.new(1, 1.2, 0, 2, 1),
		attributes = { Hazard = "Conveyor" },
	})
	belt.AssemblyLinearVelocity = Vector3.new(-22, 0, 0)
	for i = 0, 5 do
		local chevron = deco:part({
			name = "Chevron",
			size = Vector3.new(0.4, 0.1, 2.6),
			at = Vector3.new(halfW - 24 + i * 4, 1.25, 3),
			rot = CFrame.Angles(0, math.rad(45), 0),
			color = Color3.fromRGB(80, 255, 140),
			material = Enum.Material.Neon,
			shadow = false,
		})
		chevron:AddTag("Scroller")
		chevron:SetAttribute("ScrollSpeed", -22)
		chevron:SetAttribute("ScrollMin", halfW - 26)
		chevron:SetAttribute("ScrollMax", halfW - 2)
	end

	-- Catwalk (solid) and pipes.
	solids:solid({
		name = "Catwalk",
		size = Vector3.new(22, 1, 8),
		at = Vector3.new(-halfW + 11, 22, -0.5),
		color = Color3.fromRGB(80, 86, 96),
		material = Enum.Material.DiamondPlate,
	})
	for _, y in { 32, 38, 44 } do
		deco:part({
			name = "Pipe",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(W, 1.6, 1.6),
			at = Vector3.new(0, y, -10),
			color = Color3.fromRGB(120 + rng:NextInteger(0, 40), 90, 70),
			material = Enum.Material.CorrodedMetal,
		})
	end
	for _ = 1, 6 do
		local gauge = deco:part({
			name = "Gauge",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(0.4, 2.2, 2.2),
			at = Vector3.new(rng:NextNumber(-halfW + 6, halfW - 6), rng:NextNumber(8, 28), -10.6),
			rot = CFrame.Angles(0, math.rad(90), 0),
			color = Color3.fromRGB(230, 230, 220),
			material = Enum.Material.SmoothPlastic,
		})
		local _ = gauge
	end
	-- Big industrial lights.
	for _, x in { -36, 0, 36 } do
		local lampHousing = deco:part({
			name = "HighBay",
			size = Vector3.new(5, 1, 5),
			at = Vector3.new(x, H - 1, 0),
			color = Color3.fromRGB(50, 52, 60),
			material = Enum.Material.Metal,
		})
		local bulb = deco:part({
			name = "HighBayBulb",
			size = Vector3.new(4, 0.3, 4),
			at = Vector3.new(x, H - 1.6, 0),
			color = Color3.fromRGB(255, 250, 230),
			material = Enum.Material.Neon,
			shadow = false,
		})
		deco:light(bulb, "SpotLight", {
			Face = Enum.NormalId.Bottom,
			Color = Color3.fromRGB(255, 245, 225),
			Brightness = 2.2,
			Range = 60,
			Angle = 70,
			Shadows = true,
		})
		local _ = lampHousing
	end

	return {
		cauldron = Vector3.new(-40, 0, -5.5),
		rack = Vector3.new(halfW - 10, 0, -8.8),
		spawn = Vector3.new(halfW - 14, 1.4, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">FrostCavern</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ice cave: zero-friction floor, glowing crystals and icicles that drop when struck.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2
	local iceFloor = PhysicalProperties.new(0.9, 0.02, 0.05, 100, 1)

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(190, 230, 255),
		floorMaterial = Enum.Material.Ice,
		wallColor = Color3.fromRGB(120, 160, 200),
		wallMaterial = Enum.Material.Glacier,
		backColor = Color3.fromRGB(90, 130, 175),
		backMaterial = Enum.Material.Glacier,
		ceilingColor = Color3.fromRGB(100, 140, 185),
		ceilingMaterial = Enum.Material.Glacier,
		frameColor = Color3.fromRGB(60, 90, 130),
		frameMaterial = Enum.Material.Rock,
		floorPhysics = iceFloor,
	})

	local solids = b:child("Solids")
	local deco = b:child("Decor")
	local hazards = b:child("Hazards")

	-- Rock formations on the back wall.
	for _ = 1, 14 do
		local s = rng:NextNumber(4, 10)
		deco:part({
			name = "Rock",
			size = Vector3.new(s, s * rng:NextNumber(0.6, 1.4), 4),
			at = Vector3.new(rng:NextNumber(-halfW, halfW), rng:NextNumber(0, H), -10),
			rot = CFrame.Angles(0, 0, math.rad(rng:NextNumber(0, 90))),
			color = Color3.fromRGB(80 + rng:NextInteger(0, 30), 120, 160),
			material = Enum.Material.Glacier,
		})
	end
	-- Glowing crystal clusters.
	local crystalColors =
		{ Color3.fromRGB(120, 230, 255), Color3.fromRGB(170, 140, 255), Color3.fromRGB(120, 255, 220) }
	for i = 1, 7 do
		local x = -halfW + 6 + (i - 1) * ((W - 12) / 6)
		local color = crystalColors[rng:NextInteger(1, #crystalColors)]
		local host
		for c = 1, 3 do
			local h = rng:NextNumber(3, 7)
			local crystal = deco:part({
				name = "Crystal",
				size = Vector3.new(1.2, h, 1.2),
				at = Vector3.new(x + (c - 2) * 1.2, h / 2, -8.8),
				rot = CFrame.Angles(0, math.rad(45), math.rad((c - 2) * 18)),
				color = color,
				material = Enum.Material.Neon,
				transparency = 0.25,
				shadow = false,
			})
			host = host or crystal
		end
		deco:light(host, "PointLight", { Color = color, Brightness = 1.2, Range = 16 })
	end

	-- Icicles hanging from the ceiling (HazardService drops them when hit).
	for i = 1, 9 do
		local x = -halfW + 8 + (i - 1) * ((W - 16) / 8) + rng:NextNumber(-2, 2)
		local length = rng:NextNumber(4, 8)
		local icicle = hazards:part({
			name = "Icicle",
			class = "WedgePart",
			size = Vector3.new(2, length, 2),
			at = Vector3.new(x, H - length / 2, -0.5),
			rot = CFrame.Angles(math.rad(180), 0, 0),
			color = Color3.fromRGB(200, 240, 255),
			material = Enum.Material.Ice,
			transparency = 0.15,
			collide = true,
			attributes = { Hazard = "Icicle" },
		})
		icicle.CanTouch = true
	end

	-- Frozen ledges.
	solids:solid({
		name = "IceLedge",
		size = Vector3.new(16, 1.4, 8),
		at = Vector3.new(-30, 16, -0.5),
		color = Color3.fromRGB(200, 235, 255),
		material = Enum.Material.Ice,
		physics = iceFloor,
	})
	solids:solid({
		name = "IceLedge",
		size = Vector3.new(16, 1.4, 8),
		at = Vector3.new(30, 26, -0.5),
		color = Color3.fromRGB(200, 235, 255),
		material = Enum.Material.Ice,
		physics = iceFloor,
	})
	-- A snow ramp (wedge) on the right.
	solids:solid({
		name = "SnowRamp",
		class = "WedgePart",
		size = Vector3.new(8, 8, 18),
		at = Vector3.new(halfW - 10, 4, -0.5),
		rot = CFrame.Angles(0, math.rad(-90), 0),
		color = Color3.fromRGB(240, 248, 255),
		material = Enum.Material.Snow,
		physics = iceFloor,
	})

	-- Falling snow.
	local snowHost = deco:part({
		name = "Snow",
		size = Vector3.new(W, 1, 14),
		at = Vector3.new(0, H - 1, 0),
		transparency = 1,
		shadow = false,
	})
	deco:emitter(snowHost, {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Rate = 40,
		Lifetime = NumberRange.new(5, 9),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(20, 20),
		Size = b.seq(0, 0.25, 1, 0.2),
		Transparency = b.seq(0, 0.2, 0.9, 0.4, 1, 1),
		LightEmission = 0.4,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
		EmissionDirection = Enum.NormalId.Bottom,
		Shape = Enum.ParticleEmitterShape.Box,
	})
	local fill = deco:part({
		name = "Fill",
		size = Vector3.one,
		at = Vector3.new(0, H - 10, 8),
		transparency = 1,
		shadow = false,
	})
	deco:light(
		fill,
		"PointLight",
		{ Color = Color3.fromRGB(170, 210, 255), Brightness = 1.4, Range = 60, Shadows = true }
	)

	return {
		cauldron = Vector3.new(-14, 0, -5.5),
		rack = Vector3.new(halfW - 24, 0, -8.8),
		spawn = Vector3.new(0, 0, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">LavaForge</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Smithy above a lava pool. Touching lava ignites golems and pops them back out.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2
	local basalt = Color3.fromRGB(46, 40, 42)
	local lavaColor = Color3.fromRGB(255, 110, 30)
	local pitHalf = 15

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(60, 52, 50),
		floorMaterial = Enum.Material.Basalt,
		wallColor = basalt,
		wallMaterial = Enum.Material.Basalt,
		backColor = Color3.fromRGB(52, 40, 38),
		backMaterial = Enum.Material.Rock,
		frameColor = Color3.fromRGB(34, 26, 24),
		frameMaterial = Enum.Material.Slate,
	})

	local solids = b:child("Solids")
	-- Carve the pit: the shell floor is replaced locally by a lower lava surface.
	local shellFloor = b.parent:FindFirstChild("Shell") and b.parent.Shell:FindFirstChild("Floor")
	if shellFloor then
		shellFloor:Destroy()
	end
	local sideWidth = halfW - pitHalf + 6
	solids:solid({
		name = "FloorL",
		size = Vector3.new(sideWidth, 6, 24),
		at = Vector3.new(-halfW - 6 + sideWidth / 2, -3, 1),
		color = Color3.fromRGB(60, 52, 50),
		material = Enum.Material.Basalt,
	})
	solids:solid({
		name = "FloorR",
		size = Vector3.new(sideWidth, 6, 24),
		at = Vector3.new(halfW + 6 - sideWidth / 2, -3, 1),
		color = Color3.fromRGB(60, 52, 50),
		material = Enum.Material.Basalt,
	})
	solids:solid({
		name = "PitBottom",
		size = Vector3.new(pitHalf * 2, 4, 24),
		at = Vector3.new(0, -9, 1),
		color = Color3.fromRGB(40, 20, 18),
		material = Enum.Material.Basalt,
	})
	local lava = solids:solid({
		name = "Lava",
		size = Vector3.new(pitHalf * 2, 1, 24),
		at = Vector3.new(0, -5.5, 1),
		color = lavaColor,
		material = Enum.Material.CrackedLava,
		physics = PhysicalProperties.new(2, 0.1, 0.4, 1, 1),
		attributes = { Hazard = "Lava" },
	})
	lava.CanTouch = true
	-- Glowing surface layer + light + bubbling.
	local glow = b:part({
		name = "LavaGlow",
		size = Vector3.new(pitHalf * 2, 0.2, 22),
		at = Vector3.new(0, -4.9, 1),
		color = Color3.fromRGB(255, 150, 40),
		material = Enum.Material.Neon,
		transparency = 0.35,
		shadow = false,
	})
	b:light(
		glow,
		"SurfaceLight",
		{ Face = Enum.NormalId.Top, Color = lavaColor, Brightness = 3, Range = 30, Angle = 120, Shadows = false }
	)
	b:emitter(glow, {
		Texture = "rbxasset://textures/particles/fire_sparks_main.dds",
		Rate = 30,
		Lifetime = NumberRange.new(1, 2.4),
		Speed = NumberRange.new(4, 12),
		SpreadAngle = Vector2.new(25, 25),
		Size = b.seq(0, 0.35, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 60, 20)),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 4, 0),
	})
	b:emitter(glow, {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Rate = 6,
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(2, 4),
		Size = b.seq(0, 3, 1, 8),
		Transparency = b.seq(0, 0.6, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(80, 50, 40)),
		EmissionDirection = Enum.NormalId.Top,
	})
	-- Pit rim stones.
	for _, side in { -1, 1 } do
		solids:solid({
			name = "Rim",
			size = Vector3.new(2, 2, 24),
			at = Vector3.new(side * (pitHalf + 1), 1, 1),
			color = Color3.fromRGB(80, 60, 54),
			material = Enum.Material.Rock,
		})
	end

	local deco = b:child("Decor")
	-- Forge furnace on the back wall.
	deco:part({
		name = "Furnace",
		size = Vector3.new(16, 18, 5),
		at = Vector3.new(-34, 9, -9),
		color = Color3.fromRGB(70, 56, 50),
		material = Enum.Material.Cobblestone,
	})
	local mouth = deco:part({
		name = "FurnaceMouth",
		size = Vector3.new(8, 6, 0.4),
		at = Vector3.new(-34, 6, -6.4),
		color = Color3.fromRGB(255, 120, 30),
		material = Enum.Material.Neon,
	})
	deco:light(
		mouth,
		"SurfaceLight",
		{ Face = Enum.NormalId.Front, Color = Color3.fromRGB(255, 120, 40), Brightness = 2.5, Range = 24, Angle = 80 }
	):AddTag("Flicker")
	deco:emitter(mouth, {
		Texture = "rbxasset://textures/particles/fire_main.dds",
		Rate = 24,
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(2, 4),
		Size = b.seq(0, 2.4, 1, 0),
		Transparency = b.seq(0, 0.2, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 60, 10)),
		EmissionDirection = Enum.NormalId.Top,
	})
	deco:part({
		name = "Chimney",
		size = Vector3.new(6, H - 18, 4),
		at = Vector3.new(-34, 18 + (H - 18) / 2, -9.5),
		color = Color3.fromRGB(64, 50, 46),
		material = Enum.Material.Brick,
	})
	-- Anvils and tools.
	deco:part({
		name = "AnvilDeco",
		size = Vector3.new(4, 1.6, 2),
		at = Vector3.new(34, 3.8, -6),
		color = Color3.fromRGB(60, 62, 70),
		material = Enum.Material.Metal,
	})
	deco:part({
		name = "AnvilBase",
		size = Vector3.new(2, 3, 1.6),
		at = Vector3.new(34, 1.5, -6),
		color = Color3.fromRGB(50, 52, 60),
		material = Enum.Material.Metal,
	})
	for i = 1, 6 do
		deco:part({
			name = "Tool",
			size = Vector3.new(0.4, rng:NextNumber(3, 5), 0.4),
			at = Vector3.new(20 + i * 2.2, 20, -10.4),
			rot = CFrame.Angles(0, 0, math.rad(rng:NextNumber(-8, 8))),
			color = Color3.fromRGB(80, 80, 90),
			material = Enum.Material.Metal,
		})
	end
	-- Glowing cracks in the back wall.
	for _ = 1, 10 do
		deco:part({
			name = "Crack",
			size = Vector3.new(rng:NextNumber(3, 9), 0.3, 0.2),
			at = Vector3.new(rng:NextNumber(-halfW + 6, halfW - 6), rng:NextNumber(8, H - 6), -10.9),
			rot = CFrame.Angles(0, 0, math.rad(rng:NextNumber(-40, 40))),
			color = Color3.fromRGB(255, 110, 30),
			material = Enum.Material.Neon,
			transparency = 0.15,
			shadow = false,
		})
	end
	deco:torch(-halfW + 6, 30, -8.5, Color3.fromRGB(255, 130, 50), 22)
	deco:torch(halfW - 6, 30, -8.5, Color3.fromRGB(255, 130, 50), 22)
	-- Hanging chains over the pit.
	for _, x in { -9, 0, 9 } do
		deco:part({
			name = "Chain",
			size = Vector3.new(0.35, 22, 0.35),
			at = Vector3.new(x, H - 11, -4),
			color = Color3.fromRGB(60, 56, 54),
			material = Enum.Material.Metal,
		})
	end
	-- Stone platform over the pit (solid).
	solids:solid({
		name = "Platform",
		size = Vector3.new(10, 1.4, 8),
		at = Vector3.new(0, 18, -0.5),
		color = Color3.fromRGB(80, 64, 58),
		material = Enum.Material.Cobblestone,
	})

	return {
		cauldron = Vector3.new(-24, 0, -5.5),
		rack = Vector3.new(halfW - 12, 0, -8.8),
		spawn = Vector3.new(-30, 0, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SkyShaft</string>
            <string name="Source"><![CDATA[--!nonstrict
-- A tall brick tower with height markers, ledges and updraft fans at the bottom.

local function markerLabel(part: BasePart, text: string)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.CanvasSize = Vector2.new(200, 100)
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 240, 200)
	label.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	label.Parent = gui
end

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(120, 110, 100),
		floorMaterial = Enum.Material.Cobblestone,
		wallColor = Color3.fromRGB(150, 110, 90),
		wallMaterial = Enum.Material.Brick,
		backColor = Color3.fromRGB(165, 125, 100),
		backMaterial = Enum.Material.Brick,
		ceilingColor = Color3.fromRGB(90, 70, 60),
		ceilingMaterial = Enum.Material.WoodPlanks,
		frameColor = Color3.fromRGB(70, 50, 40),
		frameMaterial = Enum.Material.Wood,
	})

	local solids = b:child("Solids")
	local deco = b:child("Decor")
	local hazards = b:child("Hazards")

	-- Height markers every 25 studs.
	for y = 25, H - 10, 25 do
		deco:part({
			name = "MarkerLine",
			size = Vector3.new(W, 0.3, 0.2),
			at = Vector3.new(0, y, -10.8),
			color = Color3.fromRGB(255, 220, 120),
			material = Enum.Material.Neon,
			transparency = 0.4,
			shadow = false,
		})
		local plate = deco:part({
			name = "MarkerPlate",
			size = Vector3.new(6, 3, 0.4),
			at = Vector3.new(-halfW + 5, y + 2, -10.6),
			color = Color3.fromRGB(60, 40, 30),
			material = Enum.Material.Wood,
		})
		markerLabel(plate, tostring(y))
	end

	-- Windows up the tower.
	local sky = Color3.fromRGB(180, 215, 255)
	for y = 30, H - 20, 45 do
		deco:window(14 * (if (y // 45) % 2 == 0 then 1 else -1), y, 9, 14, Color3.fromRGB(80, 56, 40), sky)
	end

	-- Ledges.
	local ledges = {
		{ x = -halfW + 8, y = 40 },
		{ x = halfW - 8, y = 75 },
		{ x = -halfW + 8, y = 115 },
		{ x = halfW - 8, y = 150 },
		{ x = 0, y = 190 },
	}
	for _, ledge in ledges do
		solids:solid({
			name = "Ledge",
			size = Vector3.new(14, 1.4, 8),
			at = Vector3.new(ledge.x, ledge.y, -0.5),
			color = Color3.fromRGB(120, 86, 60),
			material = Enum.Material.WoodPlanks,
		})
		deco:part({
			name = "LedgeBracket",
			size = Vector3.new(1.2, 3, 6),
			at = Vector3.new(ledge.x, ledge.y - 2, -3),
			color = Color3.fromRGB(80, 56, 40),
			material = Enum.Material.Wood,
		})
	end

	-- Updraft fans in the floor.
	for _, x in { -16, 16 } do
		deco:part({
			name = "FanGrate",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(0.6, 10, 10),
			at = Vector3.new(x, 0.2, -0.5),
			rot = CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(60, 64, 72),
			material = Enum.Material.DiamondPlate,
		})
		local blades = deco:part({
			name = "FanBlades",
			size = Vector3.new(9, 0.2, 1.2),
			at = Vector3.new(x, 0.6, -0.5),
			color = Color3.fromRGB(200, 205, 215),
			material = Enum.Material.Metal,
		})
		blades:AddTag("Spinner")
		blades:SetAttribute("SpinSpeed", 12)
		blades:SetAttribute("SpinAxis", "Y")
		local zone = hazards:part({
			name = "FanZone",
			size = Vector3.new(10, 70, 12),
			at = Vector3.new(x, 35, -0.5),
			transparency = 1,
			shadow = false,
			attributes = { Hazard = "Fan", FanAccel = 330 },
		})
		local _ = zone
		local streaks = deco:part({
			name = "FanStreaks",
			size = Vector3.new(9, 0.2, 9),
			at = Vector3.new(x, 1, -0.5),
			transparency = 1,
			shadow = false,
		})
		deco:emitter(streaks, {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Rate = 16,
			Lifetime = NumberRange.new(1.2, 2),
			Speed = NumberRange.new(28, 40),
			Size = b.seq(0, 0.25, 1, 0.1),
			Transparency = b.seq(0, 0.3, 1, 1),
			LightEmission = 0.6,
			Color = ColorSequence.new(Color3.fromRGB(220, 240, 255)),
			EmissionDirection = Enum.NormalId.Top,
			Shape = Enum.ParticleEmitterShape.Box,
		})
	end

	for y = 20, H - 10, 40 do
		deco:torch(-halfW + 4, y, -8.5, Color3.fromRGB(255, 170, 90), 26)
		deco:torch(halfW - 4, y + 20, -8.5, Color3.fromRGB(255, 170, 90), 26)
	end
	-- Banner at the top.
	deco:part({
		name = "Banner",
		size = Vector3.new(10, 16, 0.3),
		at = Vector3.new(0, H - 14, -10.4),
		color = Color3.fromRGB(150, 40, 60),
		material = Enum.Material.Fabric,
	})
	local _ = rng

	return {
		cauldron = Vector3.new(-24, 0, -5.5),
		rack = Vector3.new(halfW - 10, 0, -8.8),
		spawn = Vector3.new(0, 0, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">StormSpire</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Rain-soaked rooftop with two tesla coils that zap nearby golems.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(70, 66, 80),
		floorMaterial = Enum.Material.RoofShingles,
		wallColor = Color3.fromRGB(56, 60, 76),
		wallMaterial = Enum.Material.Slate,
		backColor = Color3.fromRGB(24, 28, 44),
		backMaterial = Enum.Material.Slate,
		ceilingColor = Color3.fromRGB(30, 32, 48),
		ceilingMaterial = Enum.Material.Slate,
		frameColor = Color3.fromRGB(30, 30, 40),
		frameMaterial = Enum.Material.Metal,
	})
	-- Open sky: the ceiling and back wall become nearly invisible (still solid).
	local shell = b.parent:FindFirstChild("Shell")
	if shell then
		local ceiling = shell:FindFirstChild("Ceiling")
		if ceiling then
			ceiling.Transparency = 1
			ceiling.CastShadow = false
		end
		local back = shell:FindFirstChild("BackWall")
		if back then
			back.Transparency = 0.92
			back.Material = Enum.Material.Glass
		end
	end

	local solids = b:child("Solids")
	local deco = b:child("Decor")
	local hazards = b:child("Hazards")

	-- City skyline silhouettes far behind (glowing windows).
	for i = 0, 11 do
		local h = rng:NextNumber(20, 55)
		local w = rng:NextNumber(8, 14)
		local x = -halfW - 20 + i * 14
		deco:part({
			name = "Tower",
			size = Vector3.new(w, h, 6),
			at = Vector3.new(x, h / 2 - 8, -60),
			color = Color3.fromRGB(26, 28, 44),
			material = Enum.Material.Concrete,
			shadow = false,
		})
		for _ = 1, 4 do
			deco:part({
				name = "TowerWindow",
				size = Vector3.new(1, 1.4, 0.2),
				at = Vector3.new(x + rng:NextNumber(-w / 2 + 1, w / 2 - 1), rng:NextNumber(0, h - 10), -56.8),
				color = Color3.fromRGB(255, 220, 140),
				material = Enum.Material.Neon,
				shadow = false,
			})
		end
	end

	-- Chimneys and antenna on the roof (solid).
	solids:solid({
		name = "Chimney",
		size = Vector3.new(6, 12, 8),
		at = Vector3.new(-halfW + 8, 6, -0.5),
		color = Color3.fromRGB(110, 70, 60),
		material = Enum.Material.Brick,
	})
	solids:solid({
		name = "Vent",
		size = Vector3.new(10, 4, 8),
		at = Vector3.new(4, 2, -0.5),
		color = Color3.fromRGB(90, 96, 110),
		material = Enum.Material.DiamondPlate,
	})
	deco:part({
		name = "Antenna",
		size = Vector3.new(0.4, 30, 0.4),
		at = Vector3.new(halfW - 6, 15, -8),
		color = Color3.fromRGB(150, 150, 160),
		material = Enum.Material.Metal,
	})
	local beacon = deco:part({
		name = "Beacon",
		shape = Enum.PartType.Ball,
		size = Vector3.one,
		at = Vector3.new(halfW - 6, 30.5, -8),
		color = Color3.fromRGB(255, 50, 50),
		material = Enum.Material.Neon,
		shadow = false,
	})
	deco:light(beacon, "PointLight", { Color = Color3.fromRGB(255, 60, 60), Brightness = 1.4, Range = 12 })
		:AddTag("Flicker")

	-- Tesla coils.
	for _, x in { -26, 30 } do
		solids:solid({
			name = "CoilBase",
			size = Vector3.new(6, 3, 8),
			at = Vector3.new(x, 1.5, -0.5),
			color = Color3.fromRGB(70, 74, 90),
			material = Enum.Material.Metal,
		})
		deco:part({
			name = "CoilShaft",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(14, 2.4, 2.4),
			at = Vector3.new(x, 10, -0.5),
			rot = CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(184, 115, 51),
			material = Enum.Material.Metal,
		})
		for ring = 0, 5 do
			deco:part({
				name = "CoilRing",
				shape = Enum.PartType.Cylinder,
				size = Vector3.new(0.4, 3.4, 3.4),
				at = Vector3.new(x, 4.5 + ring * 2, -0.5),
				rot = CFrame.Angles(0, 0, math.rad(90)),
				color = Color3.fromRGB(220, 160, 80),
				material = Enum.Material.Metal,
			})
		end
		local top = hazards:part({
			name = "TeslaTop",
			shape = Enum.PartType.Ball,
			size = Vector3.one * 5,
			at = Vector3.new(x, 19, -0.5),
			color = Color3.fromRGB(150, 220, 255),
			material = Enum.Material.Neon,
			shadow = false,
			attributes = { Hazard = "Tesla", TeslaRange = 34, TeslaInterval = 3 },
		})
		deco:light(top, "PointLight", { Color = Color3.fromRGB(140, 200, 255), Brightness = 2, Range = 22 })
			:AddTag("Flicker")
		deco:emitter(top, {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Rate = 18,
			Lifetime = NumberRange.new(0.2, 0.5),
			Speed = NumberRange.new(4, 8),
			SpreadAngle = Vector2.new(180, 180),
			Size = b.seq(0, 0.6, 1, 0),
			LightEmission = 1,
			Color = ColorSequence.new(Color3.fromRGB(180, 230, 255)),
		})
	end

	-- Rain.
	local rainHost = deco:part({
		name = "Rain",
		size = Vector3.new(W + 20, 1, 30),
		at = Vector3.new(0, H + 4, 0),
		transparency = 1,
		shadow = false,
	})
	deco:emitter(rainHost, {
		Texture = "rbxasset://textures/particles/SquareParticle.png",
		Rate = 160,
		Lifetime = NumberRange.new(0.8, 1.1),
		Speed = NumberRange.new(80, 95),
		Size = b.seq(0, 0.07, 1, 0.07),
		Transparency = b.seq(0, 0.45, 1, 0.6),
		Squash = b.seq(0, 6, 1, 6),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Color = ColorSequence.new(Color3.fromRGB(180, 200, 240)),
		EmissionDirection = Enum.NormalId.Bottom,
		Shape = Enum.ParticleEmitterShape.Box,
	})
	local moonHost = deco:part({
		name = "Moonlight",
		size = Vector3.one,
		at = Vector3.new(-20, H, 20),
		transparency = 1,
		shadow = false,
	})
	deco:light(
		moonHost,
		"PointLight",
		{ Color = Color3.fromRGB(140, 160, 255), Brightness = 1.2, Range = 90, Shadows = true }
	)

	return {
		cauldron = Vector3.new(-8, 0, -5.5),
		rack = Vector3.new(halfW - 16, 0, -8.8),
		spawn = Vector3.new(0, 4, 0),
	}
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">VoidObservatory</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Low-gravity observatory floating among the stars.

return function(b, info, rng: Random)
	local W, H = info.width, info.height
	local halfW = W / 2

	b:shell({
		width = W,
		height = H,
		floorColor = Color3.fromRGB(46, 36, 70),
		floorMaterial = Enum.Material.Marble,
		wallColor = Color3.fromRGB(30, 22, 50),
		wallMaterial = Enum.Material.Marble,
		backColor = Color3.fromRGB(10, 6, 22),
		backMaterial = Enum.Material.Slate,
		ceilingColor = Color3.fromRGB(20, 14, 36),
		ceilingMaterial = Enum.Material.Slate,
		frameColor = Color3.fromRGB(40, 30, 70),
		frameMaterial = Enum.Material.Marble,
	})

	local solids = b:child("Solids")
	local deco = b:child("Decor")

	-- Starfield on the back wall.
	for _ = 1, 140 do
		local s = rng:NextNumber(0.15, 0.5)
		deco:part({
			name = "Star",
			shape = Enum.PartType.Ball,
			size = Vector3.one * s,
			at = Vector3.new(rng:NextNumber(-halfW, halfW), rng:NextNumber(1, H), -10.8),
			color = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(190, 160, 255), rng:NextNumber()),
			material = Enum.Material.Neon,
			shadow = false,
		})
	end
	-- Planets.
	local planets = {
		{ x = -38, y = 46, r = 12, color = Color3.fromRGB(255, 140, 90) },
		{ x = 40, y = 52, r = 7, color = Color3.fromRGB(120, 200, 255) },
		{ x = 18, y = 22, r = 4, color = Color3.fromRGB(200, 255, 160) },
	}
	for _, p in planets do
		local planet = deco:part({
			name = "Planet",
			shape = Enum.PartType.Ball,
			size = Vector3.one * p.r * 2,
			at = Vector3.new(p.x, p.y, -10 - p.r),
			color = p.color,
			material = Enum.Material.Sand,
			shadow = false,
		})
		deco:light(planet, "PointLight", { Color = p.color, Brightness = 0.6, Range = p.r * 2 })
	end
	deco:part({
		name = "Ring",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.3, 34, 34),
		at = Vector3.new(-38, 46, -22),
		rot = CFrame.Angles(math.rad(70), 0, math.rad(20)),
		color = Color3.fromRGB(255, 210, 160),
		material = Enum.Material.Neon,
		transparency = 0.6,
		shadow = false,
	})

	-- Telescope.
	deco:part({
		name = "TelescopeBase",
		size = Vector3.new(6, 6, 6),
		at = Vector3.new(halfW - 10, 3, -6),
		color = Color3.fromRGB(70, 60, 100),
		material = Enum.Material.Marble,
	})
	deco:part({
		name = "TelescopeTube",
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(16, 3, 3),
		at = Vector3.new(halfW - 14, 10, -6),
		rot = CFrame.Angles(0, 0, math.rad(35)),
		color = Color3.fromRGB(200, 160, 80),
		material = Enum.Material.Metal,
	})

	-- Floating platforms (solid) with glowing undersides.
	local platforms = {
		{ x = -30, y = 18, w = 16 },
		{ x = 0, y = 30, w = 14 },
		{ x = 30, y = 18, w = 16 },
		{ x = -14, y = 46, w = 10 },
		{ x = 18, y = 50, w = 10 },
	}
	for _, p in platforms do
		solids:solid({
			name = "FloatPlatform",
			size = Vector3.new(p.w, 1.6, 8),
			at = Vector3.new(p.x, p.y, -0.5),
			color = Color3.fromRGB(80, 66, 120),
			material = Enum.Material.Marble,
		})
		local glow = deco:part({
			name = "PlatformGlow",
			size = Vector3.new(p.w - 1, 0.2, 7),
			at = Vector3.new(p.x, p.y - 0.9, -0.5),
			color = Color3.fromRGB(170, 110, 255),
			material = Enum.Material.Neon,
			shadow = false,
		})
		deco:light(glow, "SurfaceLight", {
			Face = Enum.NormalId.Bottom,
			Color = Color3.fromRGB(170, 110, 255),
			Brightness = 1.5,
			Range = 14,
			Angle = 90,
		})
	end

	-- Floor runes.
	for i = -5, 5 do
		deco:part({
			name = "FloorRune",
			size = Vector3.new(2.4, 0.1, 2.4),
			at = Vector3.new(i * 9, 0.06, -3),
			rot = CFrame.Angles(0, math.rad(45), 0),
			color = Color3.fromRGB(150, 100, 255),
			material = Enum.Material.Neon,
			transparency = 0.4,
			shadow = false,
		})
	end

	-- Space dust.
	local dustHost = deco:part({
		name = "Dust",
		size = Vector3.new(W, H, 4),
		at = Vector3.new(0, H / 2, -4),
		transparency = 1,
		shadow = false,
	})
	deco:emitter(dustHost, {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Rate = 10,
		Lifetime = NumberRange.new(6, 10),
		Speed = NumberRange.new(0.2, 0.8),
		SpreadAngle = Vector2.new(180, 180),
		Size = b.seq(0, 0, 0.5, 0.25, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(200, 170, 255)),
		Shape = Enum.ParticleEmitterShape.Box,
	})
	local fill = deco:part({
		name = "Fill",
		size = Vector3.one,
		at = Vector3.new(0, H - 6, 10),
		transparency = 1,
		shadow = false,
	})
	deco:light(
		fill,
		"PointLight",
		{ Color = Color3.fromRGB(190, 160, 255), Brightness = 1.2, Range = 70, Shadows = true }
	)

	return {
		cauldron = Vector3.new(-42, 0, -5.5),
		rack = Vector3.new(halfW - 26, 0, -8.8),
		spawn = Vector3.new(0, 0, 0),
	}
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ChallengeService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Daily challenges (3 per UTC day, deterministic per player) and the gameplay event bus that also
-- feeds the TrialService.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Challenges = require(Shared.Data.Challenges)

local ChallengeService = {}

local function today(): number
	return math.floor(os.time() / 86400)
end
ChallengeService.Today = today

function ChallengeService:Init(services)
	self.S = services
	self._dirty = {}
end

function ChallengeService:Start()
	self.S.DataService.ProfileLoaded:Connect(function(player, data)
		self:_ensureDaily(player, data)
		self.S.DataService:Replicate(player, "daily")
	end)
	Players.PlayerRemoving:Connect(function(player)
		self._dirty[player] = nil
	end)
	-- Batch "daily" replication and roll over at midnight UTC.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player in table.clone(self._dirty) do
				self._dirty[player] = nil
				if player.Parent then
					self.S.DataService:Replicate(player, "daily")
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			for _, player in Players:GetPlayers() do
				local data = self.S.DataService:Get(player)
				if data and data.daily.day ~= today() then
					self:_ensureDaily(player, data)
					self.S.DataService:Replicate(player, "daily")
					self.S.ShopService:Notify(player, "toast", { text = "New daily challenges are in!", kind = "info" })
				end
			end
		end
	end)
end

function ChallengeService:_ensureDaily(player: Player, data)
	local day = today()
	if data.daily.day == day and #data.daily.list == Challenges.DailyCount then
		return
	end
	local rng = Random.new(day * 7919 + player.UserId % 100000)
	local eligible = {}
	for _, template in Challenges.Daily do
		if data.level >= template.minLevel then
			table.insert(eligible, template)
		end
	end
	local list = {}
	for tier = 1, Challenges.DailyCount do
		if #eligible == 0 then
			break
		end
		local index = rng:NextInteger(1, #eligible)
		local template = table.remove(eligible, index)
		local effectiveTier = tier
		if template.id == "height" and data.level < 7 then
			effectiveTier = math.min(tier, 2) -- the hard target needs the Sky Shaft
		end
		table.insert(list, {
			id = template.id,
			tier = tier,
			target = template.targets[effectiveTier],
			progress = 0,
			done = false,
		})
	end
	data.daily = { day = day, list = list, bonusClaimed = false }
end

-- Re-rolls nothing; just makes sure today's list exists (e.g. after a level up).
function ChallengeService:RefreshDaily(player: Player)
	local data = self.S.DataService:Get(player)
	if data then
		self:_ensureDaily(player, data)
	end
end

-- Gameplay event entry point. `extra` may contain status / golem / potion / reaction ids.
function ChallengeService:Event(player: Player, event: string, value: number, extra)
	if not player or not player.Parent then
		return
	end
	local data = self.S.DataService:Get(player)
	if not data then
		return
	end
	extra = extra or {}
	self:_ensureDaily(player, data)
	for _, challenge in data.daily.list do
		if challenge.done then
			continue
		end
		local template = Challenges.DailyById[challenge.id]
		if not template or template.event ~= event then
			continue
		end
		if template.filter and template.filter ~= extra.status then
			continue
		end
		if template.mode == "max" then
			challenge.progress = math.max(challenge.progress, math.floor(value))
		else
			challenge.progress += value
		end
		if challenge.progress >= challenge.target then
			challenge.progress = challenge.target
			challenge.done = true
			self:_reward(player, data, challenge, template)
		end
		self._dirty[player] = true
	end
	if self.S.TrialService then
		self.S.TrialService:Event(player, event, value, extra)
	end
end

function ChallengeService:_reward(player: Player, data, challenge, template)
	local coins = Challenges.DailyRewards.coins[challenge.tier] or 60
	local xp = Challenges.DailyRewards.xp[challenge.tier] or 50
	self.S.EconomyService:AddCoins(player, coins, "challenge")
	self.S.EconomyService:AddXp(player, xp)
	self.S.ShopService:Notify(player, "challenge", {
		text = template.text:format(challenge.target),
		icon = template.icon,
		coins = coins,
		xp = xp,
	})
	local allDone = true
	for _, other in data.daily.list do
		if not other.done then
			allDone = false
		end
	end
	if allDone and not data.daily.bonusClaimed then
		data.daily.bonusClaimed = true
		data.spins += 1
		self.S.DataService:Replicate(player, "spins")
		self.S.ShopService:Notify(
			player,
			"toast",
			{ text = "All daily challenges done! +1 Mystery Flask", kind = "reward" }
		)
	end
end

return ChallengeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">CursorService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Live multiplayer cursors: every player streams their in-lab cursor (unreliable, ~12 Hz) and the
-- server relays it to everyone else viewing the same lab.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local World = require(script.Parent.Parent.Systems.World)

local CursorService = {}

function CursorService:Init(services)
	self.S = services
	self._cursors = {}
end

function CursorService:Start()
	local remote = Net.unreliable("Cursor")
	remote.OnServerEvent:Connect(function(player, x, y, state)
		if typeof(x) ~= "number" or typeof(y) ~= "number" or x ~= x or y ~= y then
			return
		end
		self._cursors[player] =
			{ x = x, y = y, s = if typeof(state) == "string" then state:sub(1, 8) else "", t = os.clock() }
	end)
	Players.PlayerRemoving:Connect(function(player)
		self._cursors[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1 / 12)
			local now = os.clock()
			for _, lab in World.labs do
				local viewers = World.viewers(lab)
				if #viewers < 2 then
					continue
				end
				local list = {}
				for _, viewer in viewers do
					local cursor = self._cursors[viewer]
					if cursor and now - cursor.t < 2 then
						table.insert(list, { viewer.UserId, cursor.x, cursor.y, cursor.s, viewer.DisplayName })
					end
				end
				if #list > 0 then
					for _, viewer in viewers do
						remote:FireClient(viewer, list)
					end
				end
			end
		end
	end)
end

return CursorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player persistence: session-locked DataStore profiles with autosave, retries, schema reconcile
-- and BindToClose flushing. Falls back to in-memory profiles when DataStores are unavailable
-- (e.g. Studio without "Enable Studio Access to API Services").

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Skins = require(Shared.Data.Skins)

local STORE_NAME = "FlaskFiasco_Profiles_v1"
local LOCK_TIMEOUT = 30 * 60
local AUTOSAVE_INTERVAL = 120
local MAX_RECEIPTS = 60

local DataService = {
	ProfileLoaded = Signal.new(),
	ProfileReleasing = Signal.new(),
	_profiles = {} :: { [Player]: any },
	_loading = {} :: { [Player]: boolean },
	_memoryOnly = false,
}

local store: DataStore? = nil

local function template()
	return {
		version = 1,
		coins = Config.Economy.StartingCoins,
		xp = 0,
		level = 1,
		ingredients = table.clone(Config.StartingIngredients),
		potions = {},
		brewCount = {},
		discovered = {},
		reactions = {},
		skins = { [Skins.DefaultId] = true },
		equippedSkin = Skins.DefaultId,
		maps = {},
		daily = { day = 0, list = {}, bonusClaimed = false },
		trials = {},
		streak = { day = 0, count = 0 },
		spins = 1,
		rack = { stock = 3, last = 0 },
		codes = {},
		settings = {
			sfx = 0.8,
			music = 0.5,
			quality = "high",
			privacy = "everyone",
			shake = 1,
			tutorial = 0,
		},
		stats = {
			brews = 0,
			damage = 0,
			golemsSpawned = 0,
			potionsUsed = 0,
			shatters = 0,
			kos = 0,
			playtime = 0,
			maxHeight = 0,
			reactions = 0,
			chaos = 0,
		},
		receipts = {},
		title = "",
		firstJoin = 0,
		lastJoin = 0,
	}
end

DataService.Template = template

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Adds any keys present in the template but missing in saved data (schema evolution).
local function reconcile(data, defaults)
	for key, value in defaults do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			-- Only recurse into "record" tables (with string keys), not id->value maps that start empty.
			reconcile(data[key], value)
		end
	end
	return data
end

local function migrate(data)
	data.version = data.version or 1
	-- Future migrations go here: if data.version < 2 then ... data.version = 2 end
	return data
end

local function profileKey(userId: number): string
	return "u_" .. tostring(userId)
end

local function getStore(): DataStore?
	if store or DataService._memoryOnly then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory-only profiles:", result)
		DataService._memoryOnly = true
	end
	return store
end

-- Loads (and session-locks) a profile. Returns data or nil if the player left meanwhile.
local function loadProfile(player: Player)
	local ds = getStore()
	if not ds then
		return reconcile({}, template()), true
	end
	local key = profileKey(player.UserId)
	for attempt = 1, 6 do
		if not player.Parent then
			return nil, false
		end
		local lockedElsewhere = false
		local loaded = nil
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(record)
				record = record or {}
				local lock = record.lock
				local now = os.time()
				-- Respect a fresh lock owned by another server for the first few attempts,
				-- then steal it (the other server most likely crashed or is mid-save).
				if lock and lock.job ~= game.JobId and (now - (lock.time or 0)) < LOCK_TIMEOUT and attempt < 5 then
					lockedElsewhere = true
					return nil
				end
				record.lock = { job = game.JobId, time = now }
				loaded = record.data
				return record
			end)
		end)
		if ok and not lockedElsewhere then
			local data = loaded and migrate(loaded) or template()
			return reconcile(data, template()), false
		end
		if not ok then
			warn(("[DataService] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(err)))
			if tostring(err):find("StudioAccessToApisNotAllowed") or tostring(err):find("403") then
				DataService._memoryOnly = true
				store = nil
				return reconcile({}, template()), true
			end
		end
		task.wait(if lockedElsewhere then 3 else 1.5 * attempt)
	end
	warn("[DataService] giving up loading profile for", player.Name, "- using a temporary profile")
	return reconcile({}, template()), true
end

local function saveProfile(player: Player, data, release: boolean)
	local ds = getStore()
	if not ds or DataService._memoryOnly then
		return true
	end
	local key = profileKey(player.UserId)
	for attempt = 1, 4 do
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(record)
				record = record or {}
				local lock = record.lock
				if lock and lock.job ~= game.JobId and (os.time() - (lock.time or 0)) < LOCK_TIMEOUT then
					-- Another server stole the session; never overwrite its newer data.
					return nil
				end
				record.data = data
				record.lock = if release then nil else { job = game.JobId, time = os.time() }
				return record
			end)
		end)
		if ok then
			return true
		end
		warn(("[DataService] save attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(err)))
		task.wait(attempt * 2)
	end
	return false
end

function DataService:Init(services)
	self.S = services
end

function DataService:Start()
	Net.event("Data")
	Players.PlayerRemoving:Connect(function(player)
		self:_onPlayerRemoving(player)
	end)

	-- Autosave loop.
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, data in self._profiles do
				task.spawn(saveProfile, player, data, false)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and self._memoryOnly then
			return
		end
		local pending = 0
		for player, data in self._profiles do
			pending += 1
			task.spawn(function()
				saveProfile(player, data, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

-- Called by Main once every service has started, so no one misses ProfileLoaded (in Studio a
-- failed DataStore call can return instantly and fire the signal before others subscribe).
function DataService:BeginPlayers()
	Players.PlayerAdded:Connect(function(player)
		self:_onPlayerAdded(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(self._onPlayerAdded, self, player)
	end
end

function DataService:_onPlayerAdded(player: Player)
	if self._loading[player] or self._profiles[player] then
		return
	end
	self._loading[player] = true
	local data, temporary = loadProfile(player)
	self._loading[player] = nil
	if not data then
		return
	end
	if not player.Parent then
		-- Left while loading: release the lock we just took.
		task.spawn(saveProfile, player, data, true)
		return
	end
	local now = os.time()
	if data.firstJoin == 0 then
		data.firstJoin = now
	end
	data.lastJoin = now
	data._temporary = temporary
	self._profiles[player] = data
	player:SetAttribute("DataLoaded", true)
	self.ProfileLoaded:Fire(player, data)
	self:SendSnapshot(player)
end

function DataService:_onPlayerRemoving(player: Player)
	local data = self._profiles[player]
	if not data then
		return
	end
	self.ProfileReleasing:Fire(player, data)
	self._profiles[player] = nil
	data._temporary = nil
	task.spawn(saveProfile, player, data, true)
end

function DataService:Get(player: Player)
	return self._profiles[player]
end

-- Yields until the profile exists (or the player leaves).
function DataService:WaitFor(player: Player, timeout: number?)
	local started = os.clock()
	while player.Parent and not self._profiles[player] do
		if timeout and os.clock() - started > timeout then
			return nil
		end
		task.wait(0.1)
	end
	return self._profiles[player]
end

local function publicView(data)
	local view = {}
	for key, value in data do
		if key ~= "receipts" and key:sub(1, 1) ~= "_" then
			view[key] = value
		end
	end
	return view
end

function DataService:SendSnapshot(player: Player)
	local data = self._profiles[player]
	if data then
		Net.event("Data"):FireClient(player, "init", publicView(data))
	end
end

-- Replicates the given top-level keys to the owning client.
function DataService:Replicate(player: Player, ...: string)
	local data = self._profiles[player]
	if not data then
		return
	end
	local patch = {}
	for _, key in { ... } do
		patch[key] = data[key]
	end
	Net.event("Data"):FireClient(player, "patch", patch)
end

-- Receipt idempotency helpers used by ShopService.ProcessReceipt.
function DataService:HasReceipt(player: Player, purchaseId: string): boolean
	local data = self._profiles[player]
	return data ~= nil and table.find(data.receipts, purchaseId) ~= nil
end

function DataService:AddReceipt(player: Player, purchaseId: string)
	local data = self._profiles[player]
	if not data then
		return
	end
	table.insert(data.receipts, purchaseId)
	while #data.receipts > MAX_RECEIPTS do
		table.remove(data.receipts, 1)
	end
end

-- Forces a save now (used right after purchases so Robux rewards are never lost).
function DataService:SaveNow(player: Player): boolean
	local data = self._profiles[player]
	if not data then
		return false
	end
	return saveProfile(player, data, false)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Coins, XP & levels, and the Chaos Points combo meter that turns mayhem into rewards.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Ingredients = require(Shared.Data.Ingredients)
local Maps = require(Shared.Data.Maps)
local Skins = require(Shared.Data.Skins)
local PropsData = require(Shared.Data.Props)

local E = Config.Economy
local EconomyService = {}

function EconomyService:Init(services)
	self.S = services
	self._chaos = {}
end

function EconomyService:Start()
	self.S.DataService.ProfileLoaded:Connect(function(player, data)
		self:_setupLeaderstats(player, data)
		self._chaos[player] = {
			combo = 1,
			comboChaos = 0,
			lastHit = 0,
			pending = 0,
			unsent = 0,
			minute = 0,
			minuteStart = os.clock(),
			coinRemainder = 0,
			xpRemainder = 0,
			lastSend = 0,
		}
	end)
	Players.PlayerRemoving:Connect(function(player)
		self._chaos[player] = nil
	end)
	-- Convert accumulated chaos into coins/XP once per second (keeps remote traffic low).
	task.spawn(function()
		while true do
			task.wait(1)
			for player, state in self._chaos do
				if player.Parent then
					self:_flush(player, state)
				end
			end
		end
	end)
end

function EconomyService:_setupLeaderstats(player: Player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = data.level
	level.Parent = stats
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = data.coins
	coins.Parent = stats
	stats.Parent = player
end

function EconomyService:_syncLeaderstats(player: Player, data)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local level = stats:FindFirstChild("Level") :: IntValue?
		local coins = stats:FindFirstChild("Coins") :: IntValue?
		if level then
			level.Value = data.level
		end
		if coins then
			coins.Value = data.coins
		end
	end
end

local function multiplier(self, player: Player): number
	if self.S.ShopService and self.S.ShopService:HasPass(player, "VIP") then
		return E.VipMultiplier
	end
	return 1
end

-- `raw` skips the VIP multiplier (purchases, refunds).
function EconomyService:AddCoins(player: Player, amount: number, reason: string?, raw: boolean?)
	local data = self.S.DataService:Get(player)
	if not data or amount == 0 then
		return 0
	end
	local value = if raw or amount < 0 then amount else math.floor(amount * multiplier(self, player))
	data.coins = math.max(0, data.coins + value)
	self.S.DataService:Replicate(player, "coins")
	self:_syncLeaderstats(player, data)
	if reason and value > 0 and reason ~= "chaos" then
		Net.unreliable("FXU"):FireClient(player, "coins", { a = value, r = reason })
	end
	return value
end

function EconomyService:SpendCoins(player: Player, amount: number): boolean
	local data = self.S.DataService:Get(player)
	if not data or amount < 0 or data.coins < amount then
		return false
	end
	data.coins -= amount
	self.S.DataService:Replicate(player, "coins")
	self:_syncLeaderstats(player, data)
	return true
end

-- What a level unlocks (used for the level-up popup).
local function unlocksAt(level: number)
	local list = {}
	for _, ingredient in Ingredients.List do
		if ingredient.unlockLevel == level and ingredient.price > 0 then
			table.insert(list, { kind = "ingredient", name = ingredient.name, icon = ingredient.icon })
		end
	end
	for _, map in Maps.List do
		if map.unlockLevel == level then
			table.insert(list, { kind = "map", name = map.name, icon = map.icon })
		end
	end
	for _, skin in Skins.List do
		if skin.source == "level" and skin.level == level then
			table.insert(list, { kind = "skin", name = skin.name, icon = "🗿" })
		end
	end
	for _, prop in PropsData.List do
		if prop.unlockLevel == level and level > 1 then
			table.insert(list, { kind = "item", name = prop.name, icon = prop.icon })
		end
	end
	return list
end

function EconomyService:AddXp(player: Player, amount: number, raw: boolean?)
	local data = self.S.DataService:Get(player)
	if not data or amount <= 0 then
		return
	end
	data.xp += if raw then amount else math.floor(amount * multiplier(self, player))
	local leveled = false
	while data.level < E.MaxLevel and data.xp >= Config.xpForLevel(data.level) do
		data.xp -= Config.xpForLevel(data.level)
		data.level += 1
		leveled = true
		local bonus = data.level * E.LevelUpCoinsPerLevel
		data.coins += bonus
		if data.level % 5 == 0 then
			data.spins += 1
		end
		for _, skin in Skins.List do
			if skin.source == "level" and skin.level and data.level >= skin.level then
				data.skins[skin.id] = true
			end
		end
		self.S.ShopService:Notify(player, "levelup", {
			level = data.level,
			rank = Config.rankForLevel(data.level),
			coins = bonus,
			unlocks = unlocksAt(data.level),
		})
	end
	if data.level >= E.MaxLevel then
		data.xp = math.min(data.xp, Config.xpForLevel(data.level))
	end
	if leveled then
		self.S.DataService:Replicate(player, "xp", "level", "coins", "spins", "skins")
	else
		self.S.DataService:Replicate(player, "xp")
	end
	if leveled then
		self:_syncLeaderstats(player, data)
		self.S.ChallengeService:RefreshDaily(player)
	end
end

-- ─────────────────────────────── chaos ───────────────────────────────

function EconomyService:AddChaos(player: Player, amount: number, _lab)
	local state = self._chaos[player]
	local data = self.S.DataService:Get(player)
	if not state or not data or amount <= 0 then
		return
	end
	local now = os.clock()
	if now - state.minuteStart > 60 then
		state.minuteStart = now
		state.minute = 0
	end
	if state.minute >= E.ChaosPerMinuteCap then
		return
	end
	if now - state.lastHit > E.ComboWindow then
		state.combo = 1
		state.comboChaos = 0
	end
	state.lastHit = now
	state.comboChaos += amount
	state.combo = math.min(E.ComboMax, 1 + math.floor(state.comboChaos / E.ComboStep))
	local gained = math.min(math.floor(amount * state.combo), E.ChaosPerMinuteCap - state.minute)
	state.minute += gained
	state.pending += gained
	state.unsent += gained
	data.stats.chaos += gained
	-- Live meter update (unreliable, throttled to ~12 Hz).
	if now - state.lastSend > 0.08 then
		state.lastSend = now
		Net.unreliable("FXU"):FireClient(player, "chaos", { g = state.unsent, c = state.combo, w = E.ComboWindow })
		state.unsent = 0
	end
end

function EconomyService:_flush(player: Player, state)
	if state.unsent > 0 then
		Net.unreliable("FXU"):FireClient(player, "chaos", { g = state.unsent, c = state.combo, w = E.ComboWindow })
		state.unsent = 0
	end
	if state.pending <= 0 then
		return
	end
	local chaos = state.pending
	state.pending = 0
	local coinTotal = chaos + state.coinRemainder
	local coins = coinTotal // E.ChaosPerCoin
	state.coinRemainder = coinTotal % E.ChaosPerCoin
	local xpTotal = chaos + state.xpRemainder
	local xp = xpTotal // E.ChaosPerXp
	state.xpRemainder = xpTotal % E.ChaosPerXp
	if coins > 0 then
		self:AddCoins(player, coins, "chaos")
	end
	if xp > 0 then
		self:AddXp(player, xp)
	end
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">EffectsService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The effect engine: applies potions, runs statuses on golems, world "fields" (black holes,
-- tornadoes, meteors...), puddles, explosions, lightning, shatters and the reaction rules that make
-- potions combine in surprising ways.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Reactions = require(Shared.Data.Reactions)

local ServerRoot = script.Parent.Parent
local Physics2D = require(ServerRoot.Systems.Physics2D)
local Vfx = require(ServerRoot.Systems.Effects.Vfx)
local Statuses = require(ServerRoot.Systems.Effects.Statuses)
local Fields = require(ServerRoot.Systems.Effects.Fields)
local Puddles = require(ServerRoot.Systems.Effects.Puddles)

local EffectsService = {
	Statuses = Statuses,
	Fields = Fields,
}

local LOOK_EXCLUDE = {
	EyeL = true,
	EyeR = true,
	PupilL = true,
	PupilR = true,
	KOMark = true,
	Mouth = true,
	Blush = true,
	Rune = true,
	Halo = true,
	Balloon = true,
	BalloonKnot = true,
	Booster = true,
	BoosterCone = true,
	Wing = true,
}

function EffectsService:Init(services)
	self.S = services
end

function EffectsService:Start() end

-- ─────────────────────────────── potions ───────────────────────────────

function EffectsService:ApplyPotion(lab, potion, position: Vector3, ctx)
	ctx = ctx or {}
	ctx.potion = potion
	local potency = ctx.potency or 1
	local feed = ctx.mode == "feed"
	local duration = potion.duration * potency * (if feed then Config.Potions.FeedDurationMultiplier else 1)
	local source = ctx.source
	local affected = 0

	if potion.kind == "field" then
		local center = position
		if feed and ctx.target and ctx.target.byName.Torso then
			center = ctx.target.byName.Torso.Position
		end
		local fn = Fields[potion.effect]
		if fn then
			fn(self, lab, center, potion, ctx, duration)
		end
		affected = 1
	else
		local targets
		if feed and ctx.target then
			targets = { ctx.target }
		else
			targets = self.S.GolemService:InRadius(lab, position, potion.radius)
		end
		for _, golem in targets do
			if
				self:ApplyStatus(
					golem,
					potion.effect,
					{ duration = duration, source = source, potency = potency, potion = potion, origin = position }
				)
			then
				affected += 1
			end
		end
		-- Fire also lights explosive props.
		if potion.effect == "burning" and self.S.PropService then
			for _, prop in self.S.PropService:InRadius(lab, position, potion.radius) do
				self.S.PropService:Ignite(prop, source)
			end
		end
	end

	if not feed and potion.puddle then
		self:CreatePuddle(lab, potion.puddle, position, ctx.normal, potion.color, source)
	end
	if source and affected > 0 then
		self.S.EconomyService:AddChaos(source, 25 * affected, lab)
	end
end

-- ─────────────────────────────── statuses ───────────────────────────────

function EffectsService:HasStatus(golem, id: string): boolean
	return golem.statuses[id] ~= nil
end

function EffectsService:_reactionsBefore(golem, id: string, opts): boolean
	local lab = golem.lab
	local torso = golem.byName.Torso
	local position = if torso then torso.Position else lab.origin
	local source = opts.source
	local has = golem.statuses
	if id == "burning" then
		if has.frozen then
			self:RemoveStatus(golem, "frozen")
			self:Reaction(lab, "steam", position, source)
			Fields.steam(self, lab, position, nil, { source = source }, 0, 13)
			return false
		end
		if has.wet then
			self:RemoveStatus(golem, "wet")
			self.S.LabService:FX(lab, "sizzle", { p = position })
			return false
		end
		if has.balloons then
			self:RemoveStatus(golem, "balloons", "pop")
			self:Reaction(lab, "pop", position, source)
		end
		if has.ghost then
			opts.spirit = true
			self:Reaction(lab, "spiritflame", position, source)
		end
	elseif id == "frozen" then
		if has.burning then
			self:RemoveStatus(golem, "burning")
			self:Reaction(lab, "steam", position, source)
			Fields.steam(self, lab, position, nil, { source = source }, 0, 13)
			return false
		end
	elseif id == "shocked" then
		if has.wet or has.sticky or has.bouncy then
			opts.overcharge = true
			self:Reaction(lab, "overcharge", position, source)
		end
		if (has.golden or has.magnetic or golem.skin.traits.conductive) and not opts.chained then
			opts.conductor = true
			self:Reaction(lab, "conductor", position, source)
		end
		if has.rocket then
			has.rocket.data.overdrive = true
			has.rocket.remaining += 2
			self:Reaction(lab, "overdrive", position, source)
		end
		if has.balloons then
			self:RemoveStatus(golem, "balloons", "pop")
			self:Reaction(lab, "pop", position, source)
		end
	elseif id == "heal" then
		if has.zombie then
			self:Reaction(lab, "cure", position, source)
		end
	elseif id == "acid" then
		if has.golden then
			self:RemoveStatus(golem, "golden")
			self:Reaction(lab, "goldmelt", position, source)
			self:CoinBurst(lab, position, source, 3)
			return false
		end
	elseif id == "giant" then
		if has.tiny then
			self:RemoveStatus(golem, "tiny")
		end
	elseif id == "tiny" then
		if has.giant then
			self:RemoveStatus(golem, "giant")
		end
	end
	return true
end

-- Applies (or refreshes) a status. Returns the status record, or nil if blocked.
function EffectsService:ApplyStatus(golem, id: string, opts)
	opts = opts or {}
	if golem.dead or not golem.model.Parent then
		return nil
	end
	local def = Statuses[id]
	if not def then
		warn("[Effects] unknown status", id)
		return nil
	end
	local protectedStatus = id == "heal" or id == "ascension"
	if golem.statuses.ascension and not protectedStatus then
		return nil -- ascended golems are untouchable
	end
	if def.immune and def.immune(golem) then
		local torso = golem.byName.Torso
		if torso then
			self.S.LabService:FXU(golem.lab, "immune", { p = torso.Position + Vector3.new(0, 4, 0) })
		end
		return nil
	end
	if not self:_reactionsBefore(golem, id, opts) then
		return nil
	end
	if opts.source then
		self.S.GolemService:Touch(golem, opts.source)
	end

	if def.instant then
		def.apply(
			self,
			golem,
			{ id = id, data = {}, instances = {}, source = opts.source, potency = opts.potency or 1, opts = opts }
		)
		self:_statusEvent(golem, id, opts.source)
		return true
	end

	local duration = opts.duration or def.duration or 5
	if golem.skin.traits.flammable and id == "burning" then
		duration *= 2
	end
	local existing = golem.statuses[id]
	if existing then
		existing.remaining = math.max(existing.remaining, duration)
		existing.source = opts.source or existing.source
		if def.refresh then
			def.refresh(self, golem, existing, opts)
		end
		return existing
	end
	local st = {
		id = id,
		def = def,
		golem = golem,
		duration = duration,
		remaining = duration,
		source = opts.source,
		potency = opts.potency or 1,
		data = {},
		instances = {},
		opts = opts,
		age = 0,
	}
	golem.statuses[id] = st
	golem.model:SetAttribute("S_" .. id, true)
	local ok, err = pcall(def.apply, self, golem, st, opts)
	if not ok then
		warn("[Effects] apply failed", id, err)
	end
	self.S.GolemService:ApplyActuators(golem, true)
	self.S.GolemService:_updateUpright(golem)
	self.S.GolemService:RefreshGravity(golem)
	self:_statusEvent(golem, id, opts.source)
	return st
end

function EffectsService:_statusEvent(golem, id: string, source: Player?)
	local actor = source or self.S.GolemService:Attribution(golem)
	if actor then
		self.S.ChallengeService:Event(actor, "status", 1, { status = id, golem = golem.id })
	end
end

function EffectsService:RemoveStatus(golem, id: string, reason: string?)
	local st = golem.statuses[id]
	if not st then
		return
	end
	golem.statuses[id] = nil
	if golem.model then
		golem.model:SetAttribute("S_" .. id, nil)
	end
	if st.def.remove and not golem.dead then
		local ok, err = pcall(st.def.remove, self, golem, st, reason)
		if not ok then
			warn("[Effects] remove failed", id, err)
		end
	end
	Vfx.clean(st.instances)
	if not golem.dead then
		self.S.GolemService:ApplyActuators(golem, true)
		self.S.GolemService:_updateUpright(golem)
		self.S.GolemService:RefreshGravity(golem)
	end
end

-- Removes every status. `silent` skips end-of-effect behaviour (used before rebuilding a golem).
function EffectsService:ClearAll(golem, silent: boolean?)
	for id, st in table.clone(golem.statuses) do
		if silent then
			golem.statuses[id] = nil
			if st.def.cleanup then
				pcall(st.def.cleanup, self, golem, st)
			end
			Vfx.clean(st.instances)
			if golem.model then
				golem.model:SetAttribute("S_" .. id, nil)
			end
		else
			self:RemoveStatus(golem, id, "clear")
		end
	end
	golem.looks = nil
	golem.physLayers = nil
	golem.reformAt = nil
end

function EffectsService:CureAllZombies(lab)
	for _, golem in lab.golems do
		if golem.statuses.zombie then
			self:RemoveStatus(golem, "zombie", "cure")
			local torso = golem.byName.Torso
			if torso then
				self.S.LabService:FX(lab, "cure", { p = torso.Position })
			end
		end
	end
end

-- ─────────────────────────────── looks & physical layers ───────────────────────────────

-- Visual override layers; the highest priority wins. spec = {priority, color?, tint?, tintAlpha?,
-- material?, transparency?, reflectance?}
function EffectsService:SetLook(golem, key: string, spec)
	golem.looks = golem.looks or {}
	golem.looks[key] = spec
	self:RefreshLook(golem)
end

function EffectsService:RefreshLook(golem)
	if golem.dead or not golem.model.Parent then
		return
	end
	golem.baseLook = golem.baseLook or {}
	if golem.baseModel ~= golem.model then
		golem.baseModel = golem.model
		table.clear(golem.baseLook)
	end
	local best
	for _, spec in golem.looks or {} do
		if not best or spec.priority > best.priority then
			best = spec
		end
	end
	for _, part in golem.model:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		local base = golem.baseLook[part]
		if not base then
			if part.Transparency >= 1 then
				continue
			end
			base = {
				Color = part.Color,
				Material = part.Material,
				Transparency = part.Transparency,
				Reflectance = part.Reflectance,
			}
			golem.baseLook[part] = base
		end
		local excluded = LOOK_EXCLUDE[part.Name]
		if not best or (excluded and not best.includeFace) then
			if part.Name ~= "KOMark" then
				part.Color = base.Color
				part.Material = base.Material
				part.Reflectance = base.Reflectance
				if not (golem.face == "ko" and (part.Name:sub(1, 3) == "Eye" or part.Name:sub(1, 5) == "Pupil")) then
					part.Transparency = base.Transparency
				end
			end
			if excluded and best and best.transparency then
				part.Transparency = math.max(base.Transparency, best.transparency)
			end
		else
			local color = base.Color
			if best.color then
				color = best.color
			elseif best.tint then
				color = base.Color:Lerp(best.tint, best.tintAlpha or 0.5)
			end
			part.Color = color
			part.Material = best.material or base.Material
			part.Reflectance = best.reflectance or base.Reflectance
			part.Transparency = math.max(base.Transparency, best.transparency or 0)
		end
	end
end

-- Physical property layers merged by priority over the skin's base properties.
function EffectsService:SetPhys(golem, key: string, spec)
	golem.physLayers = golem.physLayers or {}
	golem.physLayers[key] = spec
	self:RefreshPhys(golem)
end

function EffectsService:RefreshPhys(golem)
	local skin = golem.skin
	local props = {
		density = Config.Physics.GolemDensity * skin.density,
		friction = skin.friction,
		elasticity = skin.elasticity,
		frictionWeight = 1,
		elasticityWeight = 1,
	}
	local layers = {}
	for _, spec in golem.physLayers or {} do
		table.insert(layers, spec)
	end
	table.sort(layers, function(a, b)
		return a.priority < b.priority
	end)
	for _, spec in layers do
		for key, value in spec do
			if key ~= "priority" then
				props[key] = if key == "densityMul" then props.density * value else value
			end
		end
	end
	local physical = PhysicalProperties.new(
		math.max(props.density, 0.01),
		math.clamp(props.friction, 0, 2),
		math.clamp(props.elasticity, 0, 1),
		props.frictionWeight,
		props.elasticityWeight
	)
	for _, part in golem.parts do
		if part.Parent then
			part.CustomPhysicalProperties = physical
		end
	end
	local mass = 0
	for _, part in golem.parts do
		if part.Parent then
			mass += part:GetMass()
		end
	end
	golem.mass = mass
	self.S.GolemService:RefreshGravity(golem)
end

-- ─────────────────────────────── shared effect helpers ───────────────────────────────

function EffectsService:Reaction(lab, id: string, position: Vector3, source: Player?)
	local reaction = Reactions.ById[id]
	if not reaction then
		return
	end
	self.S.LabService:FX(lab, "reaction", { id = id, p = position })
	local actor = source or lab.lastActor
	if actor and actor.Parent then
		self.S.EconomyService:AddChaos(actor, reaction.chaos, lab)
		self.S.ChallengeService:Event(actor, "reaction", 1, { reaction = id })
		self.S.ShopService:DiscoverReaction(actor, id)
	end
end

-- Velocity change applied to every physical part of an object (mass-independent "kick").
function EffectsService:Kick(object, velocityChange: Vector3, perPart: ((BasePart) -> Vector3)?)
	if object.dead then
		return
	end
	self.S.GrabService:Claim(object)
	local seen = {}
	for _, part in object.parts do
		if part.Parent and not part.Anchored then
			local root = part.AssemblyRootPart or part
			if not seen[root] then
				seen[root] = true
				local dv = if perPart then perPart(root) else velocityChange
				Physics2D.impulse(root, dv * root.AssemblyMass)
			end
		end
	end
	if object.kind == "golem" then
		self.S.GolemService:ResetMotionHistory(object, 0.12)
	end
end

-- Lightweight per-frame push (no ownership claim, skips held objects). Used by continuous fields.
function EffectsService:Pull(object, velocityChange: Vector3)
	if object.dead or object.grabbedBy then
		return
	end
	local seen = {}
	for _, part in object.parts do
		if part.Parent and not part.Anchored then
			local root = part.AssemblyRootPart or part
			if not seen[root] then
				seen[root] = true
				root:ApplyImpulse(Vector3.new(velocityChange.X, velocityChange.Y, 0) * root.AssemblyMass)
			end
		end
	end
end

-- Air drag channels: the strongest active channel wins.
function EffectsService:SetDrag(golem, key: string, value: number?)
	golem.dragMods = golem.dragMods or {}
	golem.dragMods[key] = value
	local best = 0
	for _, v in golem.dragMods do
		best = math.max(best, v)
	end
	golem.drag = if best > 0 then best else nil
end

function EffectsService:Explosion(lab, position: Vector3, radius: number, power: number, opts)
	opts = opts or {}
	local source = opts.source
	local G = self.S.GolemService
	-- Mega Blast: exploding right on top of a giant golem doubles the radius.
	for _, golem in lab.golems do
		local torso = golem.byName.Torso
		if golem.statuses.giant and torso and (torso.Position - position).Magnitude < 7 * golem.scale then
			radius *= 2
			power *= 1.4
			self:Reaction(lab, "megablast", position, source)
			break
		end
	end
	self.S.LabService:FX(
		lab,
		"explode",
		{ p = position, r = radius, c = opts.color or Color3.fromRGB(255, 150, 60), big = opts.big }
	)
	local ts = lab.timeScale
	local hits = 0
	for _, golem in G:InRadius(lab, position, radius) do
		hits += 1
		local torso = golem.byName.Torso
		local d = if torso then (torso.Position - position).Magnitude else radius
		local falloff = math.clamp(1 - d / radius, 0.15, 1)
		if source then
			G:Touch(golem, source)
		end
		if golem.statuses.balloons then
			self:RemoveStatus(golem, "balloons", "pop")
			self:Reaction(lab, "pop", position, source)
		end
		if golem.statuses.frozen or golem.statuses.golden or (golem.skin.traits.brittle and falloff > 0.7) then
			self:Shatter(
				golem,
				if golem.statuses.golden then "gold" elseif golem.statuses.frozen then "ice" else "crystal",
				source,
				position
			)
			continue
		end
		G:Stun(golem, 2.2)
		self:Kick(golem, Vector3.zero, function(part)
			local offset = part.Position - position
			local dir = if offset.Magnitude > 0.1 then offset.Unit else Vector3.yAxis
			dir = (Vector3.new(dir.X, dir.Y, 0) + Vector3.new(0, 0.45, 0)).Unit
			return dir * 135 * power * falloff * ts
		end)
		G:Damage(
			golem,
			48 * power * falloff * falloff,
			{ source = source, position = torso and torso.Position, kind = "blast" }
		)
		-- Close blasts pop a limb off.
		if falloff > 0.72 and power >= 1 and math.random() < 0.35 then
			local joints = { "ShoulderL", "ShoulderR", "HipL", "HipR", "ElbowL", "ElbowR" }
			G:Detach(golem, joints[math.random(1, #joints)], Vector3.new(0, 30, 0))
		end
	end
	if self.S.PropService then
		for _, prop in self.S.PropService:InRadius(lab, position, radius) do
			if prop.explosive and prop.root and (prop.root.Position - position).Magnitude > 0.5 then
				task.delay(0.08 + math.random() * 0.12, function()
					self.S.PropService:Ignite(prop, source)
				end)
			end
			local offset = prop.root.Position - position
			local d = offset.Magnitude
			local falloff = math.clamp(1 - d / radius, 0.15, 1)
			local dir = if d > 0.1 then offset.Unit else Vector3.yAxis
			dir = (Vector3.new(dir.X, dir.Y, 0) + Vector3.new(0, 0.4, 0)).Unit
			self:Kick(prop, dir * 120 * power * falloff * ts)
			prop.lastActor = source or prop.lastActor
			prop.lastActorTime = os.clock()
		end
	end
	if source then
		self.S.EconomyService:AddChaos(source, 40 + hits * 20, lab)
	end
end

function EffectsService:Lightning(lab, from: Vector3, to: Vector3, color: Color3?)
	self.S.LabService:FX(lab, "lightning", { a = from, b = to, c = color or Color3.fromRGB(170, 220, 255) })
end

function EffectsService:CoinBurst(lab, position: Vector3, source: Player?, multiplier: number?)
	lab.lastCoinBurst = lab.lastCoinBurst or 0
	local now = os.clock()
	local coins = 0
	if source and now - lab.lastCoinBurst > 2.5 then
		lab.lastCoinBurst = now
		coins = math.floor(Config.Economy.GoldShatterCoins * (multiplier or 1))
		self.S.EconomyService:AddCoins(source, coins, "gold")
	end
	self.S.LabService:FX(lab, "coins", { p = position, n = math.max(coins, 6) })
end

-- Breaks a golem apart; it reforms automatically a few seconds later.
function EffectsService:Shatter(golem, kind: string, source: Player?, from: Vector3?)
	if golem.dead or golem.shattered then
		return
	end
	local lab = golem.lab
	local torso = golem.byName.Torso
	local position = if torso then torso.Position else lab.origin
	source = source or self.S.GolemService:Attribution(golem)
	golem.shattered = true
	if kind == "ice" then
		self:Reaction(lab, "shatter", position, source)
	end
	if kind == "gold" then
		self:CoinBurst(lab, position, source, 1)
		if source then
			self.S.ChallengeService:Event(source, "goldshatter", 1, { golem = golem.id })
		end
	end
	if source then
		self.S.ChallengeService:Event(source, "shatter", 1, { golem = golem.id })
		local data = self.S.DataService:Get(source)
		if data then
			data.stats.shatters += 1
		end
	end
	self.S.LabService:FX(lab, "shatter", { p = position, kind = kind, c = golem.skin.body })
	-- Unlock the statue so the pieces tumble freely.
	for id in table.clone(golem.statuses) do
		if id == "frozen" or id == "golden" then
			self:RemoveStatus(golem, id, "shatter")
		end
	end
	self.S.GolemService:SetRigid(golem, false)
	self.S.GolemService:DetachAll(golem, 55)
	if from then
		self:Kick(golem, Vector3.zero, function(part)
			local offset = part.Position - from
			local dir = if offset.Magnitude > 0.1 then offset.Unit else Vector3.yAxis
			return (Vector3.new(dir.X, dir.Y, 0) + Vector3.new(0, 0.5, 0)).Unit * 60
		end)
	end
	self.S.GolemService:Damage(golem, 35, { source = source, position = position, kind = "shatter" })
	golem.reformAt = os.clock() + 3.5
end

function EffectsService:CreatePuddle(
	lab,
	kind: string,
	position: Vector3,
	normal: Vector3?,
	color: Color3,
	source: Player?
)
	Puddles.create(self, lab, kind, position, normal, color, source)
end

function EffectsService:AddField(lab, field)
	field.remaining = field.remaining or 5
	field.age = 0
	table.insert(lab.fields, field)
	return field
end

-- ─────────────────────────────── hooks ───────────────────────────────

-- Called by GolemService for every hard impact. Return true to suppress normal impact damage.
function EffectsService:OnImpact(golem, part: BasePart, dv: number): boolean
	if golem.shattered then
		return true
	end
	local s = golem.statuses
	if s.ghost or s.ascension then
		return true
	end
	if s.frozen and dv > 50 then
		local velocity = part.AssemblyLinearVelocity
		local from = if velocity.Magnitude > 0.5 then part.Position - velocity.Unit * 2 else nil
		self:Shatter(golem, "ice", nil, from)
		return true
	end
	if s.golden and dv > 68 then
		self:Shatter(golem, "gold", nil, nil)
		return true
	end
	if golem.skin.traits.brittle and dv > 115 then
		self:Shatter(golem, "crystal", nil, nil)
		return true
	end
	if s.bouncy then
		return dv < 80
	end
	return false
end

function EffectsService:OnTimeScale(lab, ratio: number)
	local _ = ratio
	for _, golem in lab.golems do
		for _, st in golem.statuses do
			if st.def.timescale then
				pcall(st.def.timescale, self, golem, st, lab.timeScale)
			end
		end
	end
end

function EffectsService:ClearLab(lab)
	for _, field in lab.fields do
		if field.finish and not field.finished then
			field.finished = true
			pcall(field.finish, self, lab, field, true)
		end
		Vfx.clean(field.instances)
	end
	table.clear(lab.fields)
	Puddles.clear(lab)
end

-- ─────────────────────────────── update ───────────────────────────────

function EffectsService:Update(lab, dt: number, labDt: number)
	local now = os.clock()
	for _, golem in table.clone(lab.golems) do
		if golem.dead then
			continue
		end
		if golem.reformAt and now >= golem.reformAt then
			golem.reformAt = nil
			golem.shattered = nil
			self.S.GolemService:Reform(golem)
			continue
		end
		if labDt <= 0 then
			continue
		end
		for id, st in table.clone(golem.statuses) do
			if golem.statuses[id] ~= st then
				continue
			end
			st.remaining -= labDt
			st.age += labDt
			if st.def.tick then
				local ok, err = pcall(st.def.tick, self, golem, st, dt, labDt)
				if not ok then
					warn("[Effects] tick failed", id, err)
				end
			end
			if golem.dead then
				break
			end
			if st.remaining <= 0 and golem.statuses[id] == st then
				self:RemoveStatus(golem, id, "expired")
			end
		end
		-- Generic air drag used by floaty statuses.
		if golem.drag and golem.drag > 0 and not golem.grabbedBy and not golem.dead then
			local damp = math.clamp(1 - golem.drag * labDt, 0, 1)
			for _, part in golem.parts do
				if part.Parent and not part.Anchored then
					part.AssemblyLinearVelocity *= damp
				end
			end
		end
	end

	-- World fields.
	for i = #lab.fields, 1, -1 do
		local field = lab.fields[i]
		if labDt > 0 then
			field.remaining -= labDt
			field.age += labDt
			if field.tick then
				local ok, err = pcall(field.tick, self, lab, field, dt, labDt)
				if not ok then
					warn("[Effects] field tick failed", field.kind, err)
					field.remaining = 0
				end
			end
		end
		if field.remaining <= 0 then
			table.remove(lab.fields, i)
			if field.finish and not field.finished then
				field.finished = true
				local ok, err = pcall(field.finish, self, lab, field, false)
				if not ok then
					warn("[Effects] field finish failed", field.kind, err)
				end
			end
			Vfx.clean(field.instances)
		end
	end

	Puddles.update(self, lab, dt, labDt)
	local _ = Workspace
end

return EffectsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">GolemService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Golem lifecycle and behaviour: spawning, the stand/stun/get-up/KO state machine, impact damage,
-- airtime/height tracking, pose servos, reforming (healing), scaling and dismemberment.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Skins = require(Shared.Data.Skins)

local Systems = script.Parent.Parent.Systems
local World = require(Systems.World)
local Physics2D = require(Systems.Physics2D)
local GolemFactory = require(Systems.GolemFactory)

local P = Config.Physics
local GolemService = {}

-- Rest pose (degrees). Positive = counter-clockwise from the camera.
local REST_POSE = {
	Neck = 0,
	ShoulderL = -10,
	ShoulderR = 10,
	ElbowL = 12,
	ElbowR = -12,
	HipL = -4,
	HipR = 4,
	KneeL = 0,
	KneeR = 0,
}
GolemService.RestPose = REST_POSE

local KIND_TORQUE = {
	neck = 0.35,
	shoulder = 0.12,
	elbow = 0.08,
	hip = 1,
	knee = 0.9,
}

function GolemService:Init(services)
	self.S = services
end

function GolemService:Start() end

-- ─────────────────────────────── helpers ───────────────────────────────

local function countGolems(lab): number
	local n = 0
	for _ in lab.golems do
		n += 1
	end
	return n
end
GolemService.Count = countGolems

local function allocateGroup(lab): number?
	for i = 1, Config.MaxGolemsExpanded do
		if not lab.groupUsed[i] then
			lab.groupUsed[i] = true
			return i
		end
	end
	return nil
end

function GolemService:Attribution(golem): Player?
	local now = os.clock()
	local window = Config.Economy.ChaosAttributionWindow
	if golem.lastActor and golem.lastActor.Parent and now - golem.lastActorTime < window then
		return golem.lastActor
	end
	local lab = golem.lab
	if lab.lastActor and lab.lastActor.Parent and now - lab.lastActionTime < window then
		return lab.lastActor
	end
	return nil
end

function GolemService:Touch(golem, player: Player?)
	if player then
		golem.lastActor = player
		golem.lastActorTime = os.clock()
	end
end

local function setFace(golem, mode: string)
	if golem.face == mode then
		return
	end
	golem.face = mode
	local ko = mode == "ko"
	for _, part in golem.model:GetChildren() do
		if part.Name == "KOMark" then
			part.Transparency = if ko then 0 else 1
		elseif part.Name == "EyeL" or part.Name == "EyeR" or part.Name == "PupilL" or part.Name == "PupilR" then
			part.Transparency = if ko then 1 else 0
		end
	end
	local mouth = golem.faces.Mouth
	if mouth and mouth.Parent then
		if mode == "ko" or mode == "hurt" then
			mouth.Size = Vector3.new(0.5, 0.32, 0.14)
		elseif mode == "happy" then
			mouth.Size = Vector3.new(0.8, 0.18, 0.14)
		else
			mouth.Size = Vector3.new(0.6, 0.14, 0.14)
		end
	end
	golem.model:SetAttribute("Face", mode)
end
GolemService.SetFace = setFace

local function isActive(golem): boolean
	return golem.state == "standing"
		or golem.state == "gettingup"
		or (golem.state == "controlled" and not golem.controllerStunned)
end

-- Pushes servo/motor settings to the hinges according to state, pose and modifiers.
function GolemService:ApplyActuators(golem, force: boolean?)
	local massFactor = golem.mass * golem.scale
	local g = Workspace.Gravity
	local ts = golem.lab.timeScale
	local ts2 = ts * ts
	if golem.rigid then
		for name, hinge in golem.joints do
			if hinge.Parent then
				hinge.ActuatorType = Enum.ActuatorType.Servo
				hinge.TargetAngle = golem.rigidPose[name] or hinge.CurrentAngle
				hinge.ServoMaxTorque = 1e7
				hinge.AngularSpeed = 20
			end
		end
		return
	end
	local active = isActive(golem) and next(golem.mods.limp) == nil
	for name, hinge in golem.joints do
		if not hinge.Parent then
			continue
		end
		local kind = hinge:GetAttribute("Kind")
		if active then
			local target = golem.pose[name] or REST_POSE[name] or 0
			local torque = massFactor * P.LegServoTorquePerMass * (KIND_TORQUE[kind] or 0.2) * golem.poseStrength * ts2
			if kind == "shoulder" or kind == "elbow" then
				-- Arms are light: a gentler servo so they swing on impacts but hold a pose.
				torque = massFactor
					* P.ArmServoTorquePerMass
					* 40
					* (KIND_TORQUE[kind] or 0.1)
					* (golem.armStrength or 1)
					* ts2
			end
			if hinge.ActuatorType ~= Enum.ActuatorType.Servo then
				hinge.ActuatorType = Enum.ActuatorType.Servo
			end
			if force or math.abs(hinge.TargetAngle - target) > 1.5 then
				hinge.TargetAngle = target
			end
			hinge.ServoMaxTorque = torque
			hinge.AngularSpeed = (golem.poseSpeed or 7) * ts
			hinge.AngularResponsiveness = 40
		else
			if hinge.ActuatorType ~= Enum.ActuatorType.Motor then
				hinge.ActuatorType = Enum.ActuatorType.Motor
			end
			hinge.AngularVelocity = 0
			-- Joint friction: a fraction of the child limb's own gravity torque, so limbs still dangle.
			local child = hinge.Attachment1 and hinge.Attachment1.Parent
			local childMass = if child and child:IsA("BasePart") then child:GetMass() else 1
			hinge.MotorMaxTorque = childMass * g * ts2 * 0.45 * golem.scale * (golem.limpFriction or 1)
		end
	end
end

function GolemService:SetPose(golem, pose: { [string]: number }?, strength: number?, speed: number?)
	golem.pose = pose or REST_POSE
	golem.poseStrength = strength or 1
	golem.poseSpeed = speed or 7
	if isActive(golem) then
		self:ApplyActuators(golem)
	end
end

function GolemService:SetState(golem, state: string)
	if golem.state == state then
		return
	end
	if golem.state == "ko" and state ~= "standing" and state ~= "gettingup" then
		-- KO golems only leave KO by healing.
		if not golem.reviving then
			return
		end
	end
	golem.state = state
	golem.stateTime = 0
	golem.model:SetAttribute("State", state)
	if state == "ko" then
		setFace(golem, "ko")
	elseif state == "stunned" then
		setFace(golem, "hurt")
	else
		setFace(golem, if golem.mods.happy then "happy" else "normal")
	end
	self:ApplyActuators(golem, true)
	self:_updateUpright(golem)
end

function GolemService:_updateUpright(golem)
	local upright = golem.upright
	if not upright or not upright.Parent then
		return
	end
	local wants = (
		golem.state == "standing"
		or golem.state == "gettingup"
		or (golem.state == "controlled" and golem.controllerUpright and not golem.controllerStunned)
	)
		and not golem.rigid
		and next(golem.mods.noUpright) == nil
		and next(golem.mods.limp) == nil
		and not golem.grabbedBy
		and not golem.detached.Neck
	upright.Enabled = wants
	local ts = golem.lab.timeScale
	local ramp = 1
	if golem.state == "gettingup" then
		ramp = math.clamp(golem.stateTime / P.GetUpTime, 0.25, 1)
	end
	-- Torque ∝ total mass × lever arm (∝ scale).
	upright.MaxTorque = golem.mass
		* golem.scale
		* P.UprightTorquePerMass
		* ramp
		* ts
		* ts
		* (golem.uprightStrength or 1)
	upright.Responsiveness = 30 * ts
end

-- Total gravity multiplier for a golem (map × modifiers × slow-mo²).
function GolemService:GravityScale(golem): number
	local scale = golem.lab.map.gravityScale
	for _, factor in golem.mods.gravity do
		scale *= factor
	end
	local ts = golem.lab.timeScale
	return scale * ts * ts
end

function GolemService:RefreshGravity(golem)
	local scale = self:GravityScale(golem)
	golem.gravityScale = scale
	for _, part in golem.parts do
		if part.Parent and not part.Anchored then
			Physics2D.setGravityScale(part, scale)
		end
	end
end

function GolemService:ResetMotionHistory(golem, grace: number?)
	table.clear(golem.prevVel)
	golem.impactGrace = math.max(golem.impactGrace or 0, grace or 0.2)
end

-- ─────────────────────────────── spawning ───────────────────────────────

function GolemService:Spawn(lab, skinId: string?, localPos: Vector3?, options)
	local opts = options or {}
	local cap = lab.maxGolems
	if countGolems(lab) >= cap then
		return nil, ("Too many golems (max %d)"):format(cap)
	end
	local groupIndex = allocateGroup(lab)
	if not groupIndex then
		return nil, "No collision group available"
	end
	local skin = Skins.get(skinId)
	local spot = localPos or lab.layout.spawn
	local feet = lab.origin + Vector3.new(spot.X, spot.Y, 0)
	local result = GolemFactory.build(skin.id, feet, lab.planeOrigin, Physics2D.GolemGroups[groupIndex], lab.dynamic)

	local golem: any = {
		kind = "golem",
		id = opts.id or World.nextId(),
		lab = lab,
		skin = skin,
		groupIndex = groupIndex,
		maxHealth = Config.Golem.MaxHealth,
		health = Config.Golem.MaxHealth,
		state = "none",
		stateTime = 0,
		statuses = {},
		mods = { gravity = {}, noUpright = {}, limp = {}, damage = {} },
		prevVel = {},
		impactGrace = 0.4,
		grounded = true,
		airTime = 0,
		flightMaxHeight = 0,
		lastHeightEmit = 0,
		scale = 1,
		detached = {},
		rigid = false,
		rigidPose = {},
		pose = REST_POSE,
		poseStrength = 1,
		poseSpeed = 7,
		lastActor = opts.source,
		lastActorTime = if opts.source then os.clock() else 0,
		lastImpactFx = 0,
		checkTimer = 0,
		gravityTimer = 0,
		gravityScale = 1,
		spawnTime = os.clock(),
	}
	self:_adoptBuild(golem, result)
	lab.golems[golem.id] = golem
	World.register(golem)
	self:SetState(golem, "standing")
	self:RefreshGravity(golem)
	Physics2D.setOwner(golem.parts, nil)
	if lab.paused then
		self.S.LabService:FreezeObject(lab, golem)
	end
	return golem
end

function GolemService:_adoptBuild(golem, result)
	golem.model = result.model
	golem.parts = result.physical
	golem.byName = result.parts
	golem.joints = result.joints
	golem.upright = result.upright
	golem.lift = result.lift
	golem.mass = result.mass
	golem.baseMass = result.mass
	golem.faces = result.faces
	golem.face = nil
	golem.model:SetAttribute("GolemId", golem.id)
	golem.model:SetAttribute("Health", golem.health)
	golem.model:SetAttribute("MaxHealth", golem.maxHealth)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { golem.model }
	params.RespectCanCollide = true
	golem.rayParams = params
end

function GolemService:Despawn(golem)
	local lab = golem.lab
	if lab.golems[golem.id] ~= golem then
		return
	end
	if self.S.EffectsService then
		self.S.EffectsService:ClearAll(golem, true)
	end
	if golem.grabbedBy and self.S.GrabService then
		self.S.GrabService:ForceRelease(golem)
	end
	World.unregister(golem)
	lab.golems[golem.id] = nil
	lab.groupUsed[golem.groupIndex] = nil
	golem.dead = true
	if golem.model then
		golem.model:Destroy()
	end
end

-- Heal = rebuild the golem fresh where it currently is (keeps id, skin and group).
function GolemService:Reform(golem, options)
	local opts = options or {}
	if golem.dead then
		return
	end
	local lab = golem.lab
	if golem.grabbedBy and self.S.GrabService then
		self.S.GrabService:ForceRelease(golem)
	end
	if self.S.EffectsService then
		self.S.EffectsService:ClearAll(golem, true)
	end
	local torso = golem.byName.Torso
	local at = if torso and torso.Parent then torso.Position else lab.origin + lab.layout.spawn
	-- Find the ground under the golem.
	local hit = Workspace:Raycast(at + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), lab.staticRayParams)
	local feetY = if hit then hit.Position.Y + 0.05 else at.Y - 4.6
	local localX = math.clamp(at.X - lab.origin.X, lab.minX + 4, lab.maxX - 4)
	local localY = math.clamp(feetY - lab.origin.Y, 0, lab.map.height - 10)
	if opts.toSpawn then
		localX, localY = lab.layout.spawn.X, lab.layout.spawn.Y
	end

	World.unregister(golem)
	golem.model:Destroy()
	golem.health = golem.maxHealth
	golem.scale = 1
	golem.rigid = false
	golem.rigidPose = {}
	golem.detached = {}
	golem.statuses = {}
	golem.mods = { gravity = {}, noUpright = {}, limp = {}, damage = {} }
	golem.controller = nil
	golem.controllerUpright = nil
	golem.pose = REST_POSE
	golem.poseStrength = 1
	golem.uprightStrength = nil
	golem.armStrength = nil
	golem.limpFriction = nil
	table.clear(golem.prevVel)
	golem.impactGrace = 0.5
	golem.airTime = 0
	golem.flightMaxHeight = 0
	golem.state = "none"
	golem.reviving = true

	local feet = lab.origin + Vector3.new(localX, localY, 0)
	local result =
		GolemFactory.build(golem.skin.id, feet, lab.planeOrigin, Physics2D.GolemGroups[golem.groupIndex], lab.dynamic)
	self:_adoptBuild(golem, result)
	World.register(golem)
	self:SetState(golem, "standing")
	golem.reviving = nil
	self:RefreshGravity(golem)
	Physics2D.setOwner(golem.parts, nil)
	if lab.paused then
		self.S.LabService:FreezeObject(lab, golem)
	end
	if not opts.silent then
		self.S.LabService:FX(lab, "reform", { p = feet + Vector3.new(0, 4.5, 0), c = golem.skin.accent })
	end
	return golem
end

-- ─────────────────────────────── damage ───────────────────────────────

function GolemService:Damage(golem, amount: number, options)
	local info = options or {}
	if golem.dead or amount <= 0 then
		return 0
	end
	for _, factor in golem.mods.damage do
		amount *= factor
	end
	if amount < 0.5 then
		return 0
	end
	amount = math.floor(amount + 0.5)
	local wasAlive = golem.health > 0
	golem.health = math.max(0, golem.health - amount)
	golem.model:SetAttribute("Health", golem.health)

	local actor = info.source or self:Attribution(golem)
	local position = info.position or (golem.byName.Torso and golem.byName.Torso.Position)
	if position and not info.silent then
		self.S.LabService:FXU(golem.lab, "dmg", { p = position, a = amount, k = info.kind })
	end
	if actor then
		self.S.EconomyService:AddChaos(actor, amount, golem.lab)
		self.S.ChallengeService:Event(actor, "damage", amount)
		local data = self.S.DataService:Get(actor)
		if data then
			data.stats.damage += amount
		end
	end
	if wasAlive and golem.health <= 0 then
		self:SetState(golem, "ko")
		self.S.LabService:FX(golem.lab, "ko", { p = position })
		if actor then
			self.S.EconomyService:AddChaos(actor, 150, golem.lab)
			self.S.ChallengeService:Event(actor, "ko", 1, { golem = golem.id })
			local data = self.S.DataService:Get(actor)
			if data then
				data.stats.kos += 1
			end
		end
	end
	return amount
end

function GolemService:Stun(golem, duration: number?)
	if golem.dead or golem.state == "ko" or golem.rigid then
		return
	end
	if golem.state == "controlled" then
		golem.controllerStunned = math.max(golem.controllerStunned or 0, duration or P.StunTime)
		self:ApplyActuators(golem, true)
		self:_updateUpright(golem)
		return
	end
	self:SetState(golem, "stunned")
	golem.stunDuration = duration or P.StunTime
end

-- ─────────────────────────────── posing / rigid ───────────────────────────────

function GolemService:SetRigid(golem, rigid: boolean)
	if golem.rigid == rigid then
		return
	end
	golem.rigid = rigid
	if rigid then
		for name, hinge in golem.joints do
			golem.rigidPose[name] = hinge.CurrentAngle
		end
	end
	self:ApplyActuators(golem, true)
	self:_updateUpright(golem)
end

function GolemService:Detach(golem, jointName: string, impulse: Vector3?)
	local hinge = golem.joints[jointName]
	if not hinge or golem.detached[jointName] then
		return nil
	end
	local child = hinge.Attachment1 and hinge.Attachment1.Parent
	local pivot = hinge.Attachment0 and hinge.Attachment0.WorldPosition
	hinge:Destroy()
	golem.joints[jointName] = nil
	golem.detached[jointName] = true
	if child and child:IsA("BasePart") then
		-- The freed limb chain needs its own rotation lock now.
		local att = Physics2D.planeAttachment(child)
		local lock = Instance.new("AlignOrientation")
		lock.Name = "Lock2D"
		lock.Mode = Enum.OrientationAlignmentMode.OneAttachment
		lock.AlignType = Enum.AlignType.PrimaryAxisParallel
		lock.Attachment0 = att
		lock.PrimaryAxis = Vector3.zAxis
		lock.RigidityEnabled = true
		lock.Parent = child
		if impulse then
			Physics2D.impulse(child, impulse)
		end
	end
	if pivot then
		self.S.LabService:FX(golem.lab, "pop", { p = pivot, c = golem.skin.limb })
	end
	if jointName == "Neck" or (golem.detached.HipL and golem.detached.HipR) then
		self:Stun(golem, 999)
	end
	self:_updateUpright(golem)
	return child
end

function GolemService:DetachAll(golem, strength: number)
	local torso = golem.byName.Torso
	for name in table.clone(golem.joints) do
		local hinge = golem.joints[name]
		local child = hinge and hinge.Attachment1 and hinge.Attachment1.Parent
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, 0).Unit
		if child and child:IsA("BasePart") and torso then
			local offset = child.Position - torso.Position
			if offset.Magnitude > 0.1 then
				dir = (Vector3.new(offset.X, offset.Y, 0).Unit + Vector3.new(0, 0.6, 0)).Unit
			end
		end
		local mass = if child and child:IsA("BasePart") then child:GetMass() else 1
		self:Detach(golem, name, dir * mass * strength)
	end
	self:Stun(golem, 999)
end

-- Smoothly scales the golem (Model:ScaleTo in small steps so the solver can push out of the floor).
function GolemService:SetScale(golem, target: number, duration: number?)
	golem.scaleTarget = target
	golem.scaleFrom = golem.scale
	golem.scaleT = 0
	golem.scaleDuration = duration or 0.6
end

local function stepScale(self, golem, dt: number)
	if not golem.scaleTarget then
		return
	end
	golem.scaleT += dt
	local alpha = math.clamp(golem.scaleT / golem.scaleDuration, 0, 1)
	local eased = 1 - (1 - alpha) ^ 3
	local scale = golem.scaleFrom + (golem.scaleTarget - golem.scaleFrom) * eased
	if math.abs(scale - golem.scale) > 0.01 or alpha >= 1 then
		local ok = pcall(function()
			golem.model:ScaleTo(scale)
		end)
		if ok then
			golem.scale = scale
			golem.model:SetAttribute("Scale", scale)
			local mass = 0
			for _, part in golem.parts do
				if part.Parent then
					mass += part:GetMass()
				end
			end
			golem.mass = mass -- always the real total mass
			self:RefreshGravity(golem)
			self:ApplyActuators(golem)
			self:_updateUpright(golem)
			self:ResetMotionHistory(golem, 0.15)
		end
	end
	if alpha >= 1 then
		golem.scaleTarget = nil
	end
end

-- ─────────────────────────────── per-frame update ───────────────────────────────

local IMPACT_PARTS = { "Torso", "Head" }

function GolemService:Update(lab, dt: number, labDt: number)
	if lab.paused then
		return
	end
	local g = Workspace.Gravity
	local ts = math.max(lab.timeScale, 0.05)
	for _, golem in lab.golems do
		if golem.dead then
			continue
		end
		local torso: BasePart? = golem.byName.Torso
		if not torso or not torso.Parent then
			continue
		end

		stepScale(self, golem, labDt)

		-- Periodic gravity refresh (mass changes when scaling, statuses change modifiers).
		golem.gravityTimer -= dt
		if golem.gravityTimer <= 0 then
			golem.gravityTimer = 0.25
			self:RefreshGravity(golem)
			self:_updateUpright(golem)
		end

		-- ── Impact detection via Δv against expected gravity ──
		golem.impactGrace = math.max(0, (golem.impactGrace or 0) - dt)
		local expectedDv = Vector3.new(0, -g * golem.gravityScale * dt, 0)
		for _, name in IMPACT_PARTS do
			local part = golem.byName[name]
			if part and part.Parent and not part.Anchored then
				local v = part.AssemblyLinearVelocity
				local prev = golem.prevVel[name]
				golem.prevVel[name] = v
				if prev and golem.impactGrace <= 0 then
					local dv = (v - (prev + expectedDv)).Magnitude / ts
					local threshold = P.ImpactThreshold * (if golem.grabbedBy then 1.9 else 1)
					if dv > threshold then
						self:_onImpact(golem, part, dv, threshold)
					end
				end
			end
		end

		-- ── Ground / airtime / height (20 Hz) ──
		golem.checkTimer -= dt
		if golem.checkTimer <= 0 then
			golem.checkTimer = 0.05
			local down = if golem.gravityScale < 0 then 1 else -1
			local hit = Workspace:Raycast(torso.Position, Vector3.new(0, down * 6.2 * golem.scale, 0), golem.rayParams)
			local wasGrounded = golem.grounded
			golem.grounded = hit ~= nil
			local height = torso.Position.Y - lab.origin.Y
			if not golem.grounded and not golem.grabbedBy then
				golem.flightMaxHeight = math.max(golem.flightMaxHeight, height)
			end
			if golem.grounded and not wasGrounded then
				self:_onLanded(golem)
			end
		end
		if not golem.grounded and not golem.grabbedBy and not torso.Anchored then
			golem.airTime += labDt
			if golem.airTime > 1 and os.clock() - golem.lastHeightEmit > 0.5 then
				golem.lastHeightEmit = os.clock()
				local actor = self:Attribution(golem)
				if actor then
					self.S.ChallengeService:Event(actor, "airtime", golem.airTime)
					self.S.ChallengeService:Event(actor, "height", golem.flightMaxHeight)
				end
			end
		end

		-- ── State machine ──
		golem.stateTime += labDt
		local speed = torso.AssemblyLinearVelocity.Magnitude / ts
		if golem.state == "standing" then
			-- Fell over (pushed hard enough to tip) → stunned.
			if torso.CFrame.UpVector.Y < 0.45 and not golem.rigid then
				self:Stun(golem)
			elseif golem.grabbedBy then
				self:Stun(golem, P.StunTime)
			end
		elseif golem.state == "stunned" then
			local duration = golem.stunDuration or P.StunTime
			if golem.grabbedBy or speed > 9 or not golem.grounded then
				golem.stateTime = math.min(golem.stateTime, duration * 0.6)
			end
			if
				golem.stateTime >= duration
				and golem.health > 0
				and next(golem.mods.limp) == nil
				and not golem.rigid
			then
				if golem.controller then
					self:SetState(golem, "controlled")
				else
					self:SetState(golem, "gettingup")
				end
			end
		elseif golem.state == "gettingup" then
			local lift = golem.lift
			local t = golem.stateTime / P.GetUpTime
			if lift and lift.Parent then
				lift.Enabled = t < 0.6
				lift.Force =
					Vector3.new(0, golem.mass * g * math.max(golem.gravityScale, 0.2) * 1.15 * math.max(0, 1 - t), 0)
			end
			self:_updateUpright(golem)
			if golem.stateTime >= P.GetUpTime then
				if lift then
					lift.Enabled = false
				end
				self:SetState(golem, if golem.controller then "controlled" else "standing")
			end
		elseif golem.state == "controlled" then
			if golem.controllerStunned then
				-- Stay limp while flying around; recover once settled.
				if speed < 12 and golem.grounded then
					golem.controllerStunned -= labDt
				end
				if golem.controllerStunned <= 0 then
					golem.controllerStunned = nil
					self:ApplyActuators(golem, true)
					self:_updateUpright(golem)
				end
			end
			if not golem.controller then
				self:SetState(golem, "standing")
			end
		end
		if golem.state ~= "gettingup" and golem.lift and golem.lift.Enabled then
			golem.lift.Enabled = false
		end

		-- Status-driven behaviour (zombie, hyper, disco...).
		if golem.controller and not golem.grabbedBy and golem.state ~= "ko" and not golem.rigid then
			local ok, err = pcall(golem.controller, golem, dt, labDt)
			if not ok then
				warn("[GolemService] controller error:", err)
				golem.controller = nil
			end
		end

		-- Idle breathing while standing.
		if golem.state == "standing" and not golem.controller then
			local t = os.clock() + golem.id
			local sway = math.sin(t * 1.6) * 4
			local pose = golem.idlePose or table.clone(REST_POSE)
			golem.idlePose = pose
			pose.ShoulderL = REST_POSE.ShoulderL - sway
			pose.ShoulderR = REST_POSE.ShoulderR + sway
			pose.Neck = math.sin(t * 0.7) * 6
			golem.pose = pose
			if math.floor(t * 8) ~= golem.lastIdleTick then
				golem.lastIdleTick = math.floor(t * 8)
				self:ApplyActuators(golem)
			end
		end

		-- ── Safety: velocity clamp and out-of-bounds recovery ──
		if not golem.grabbedBy then
			local v = torso.AssemblyLinearVelocity
			local limit = P.MaxSpeed * ts
			if v.Magnitude > limit then
				for _, part in golem.parts do
					if part.Parent and not part.Anchored then
						local pv = part.AssemblyLinearVelocity
						-- Only rescale parts that are actually too fast (never normalise a zero vector).
						if pv.Magnitude > limit then
							part.AssemblyLinearVelocity = pv.Unit * limit * 0.9
						end
					end
				end
			end
		end
		local p = torso.Position - lab.origin
		if p ~= p or p.X < lab.minX - 30 or p.X > lab.maxX + 30 or p.Y < -40 or p.Y > lab.map.height + 40 then
			self:Reform(golem, { toSpawn = true })
		end
	end
end

function GolemService:_onImpact(golem, part: BasePart, dv: number, threshold: number)
	local lab = golem.lab
	local damage = (dv - threshold) * P.ImpactDamageScale * (if part.Name == "Head" then 1.3 else 1)
	if golem.grabbedBy then
		damage *= 0.6
	end
	if self.S.EffectsService then
		local handled = self.S.EffectsService:OnImpact(golem, part, dv)
		if handled then
			return
		end
	end
	self:Damage(golem, damage, { position = part.Position, kind = "impact", silent = damage < 2 })
	if dv > P.KnockdownThreshold and golem.state == "standing" then
		self:Stun(golem)
	end
	local now = os.clock()
	if now - golem.lastImpactFx > 0.09 then
		golem.lastImpactFx = now
		self.S.LabService:FXU(
			lab,
			"impact",
			{ p = part.Position, s = math.clamp(dv / 120, 0.1, 1.5), c = golem.skin.body }
		)
	end
end

function GolemService:_onLanded(golem)
	local actor = self:Attribution(golem)
	if golem.airTime > 0.6 and actor then
		self.S.ChallengeService:Event(actor, "airtime", golem.airTime)
		self.S.ChallengeService:Event(actor, "height", golem.flightMaxHeight)
		if golem.airTime > 2 then
			self.S.EconomyService:AddChaos(actor, math.floor(golem.airTime * 30), golem.lab)
		end
		local data = self.S.DataService:Get(actor)
		if data and golem.flightMaxHeight > data.stats.maxHeight then
			data.stats.maxHeight = math.floor(golem.flightMaxHeight)
		end
	end
	if golem.scale > 1.8 and golem.airTime > 0.4 then
		self.S.LabService:FX(golem.lab, "quake", { p = golem.byName.Torso.Position, s = golem.scale })
	end
	golem.airTime = 0
	golem.flightMaxHeight = 0
end

function GolemService:HealAll(lab)
	for _, golem in table.clone(lab.golems) do
		self:Reform(golem)
	end
end

function GolemService:ClearAll(lab)
	for _, golem in table.clone(lab.golems) do
		self:Despawn(golem)
	end
end

-- Nearest golem to a world point (optionally filtered).
function GolemService:Nearest(lab, position: Vector3, maxDistance: number, filter: ((any) -> boolean)?)
	local best, bestDistance = nil, maxDistance
	for _, golem in lab.golems do
		local torso = golem.byName.Torso
		if not golem.dead and torso and torso.Parent and (not filter or filter(golem)) then
			local d = (torso.Position - position).Magnitude
			if d < bestDistance then
				best, bestDistance = golem, d
			end
		end
	end
	return best, bestDistance
end

function GolemService:InRadius(lab, position: Vector3, radius: number)
	local list = {}
	for _, golem in lab.golems do
		if golem.dead then
			continue
		end
		local closest = math.huge
		for _, part in golem.parts do
			if part.Parent then
				local d = (part.Position - position).Magnitude
				if d < closest then
					closest = d
				end
			end
		end
		if closest <= radius * math.max(1, golem.scale * 0.6) then
			table.insert(list, golem)
		end
	end
	return list
end

return GolemService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">GrabService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Grab & fling. The grabbing client receives network ownership of the object so dragging is
-- latency-free (the client drives an AlignPosition locally). Ownership returns to the server
-- shortly after release so potion effects stay server-authoritative.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Systems = script.Parent.Parent.Systems
local World = require(Systems.World)
local Physics2D = require(Systems.Physics2D)

local P = Config.Physics
local GrabService = {
	held = {} :: { [Player]: any },
}

function GrabService:Init(services)
	self.S = services
	self._lastGrab = {}
end

function GrabService:Start()
	Net.func("Grab").OnServerInvoke = function(player, part, offset)
		return self:_grab(player, part, offset)
	end
	Net.event("GrabRelease").OnServerEvent:Connect(function(player)
		self:Release(player)
	end)
end

local function rootOf(object): BasePart?
	if object.kind == "golem" then
		return object.byName and object.byName.Torso
	end
	return object.root
end

function GrabService:_grab(player: Player, part: any, offset: any)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return false
	end
	if offset ~= nil and typeof(offset) ~= "Vector3" then
		return false
	end
	local now = os.clock()
	if now - (self._lastGrab[player] or 0) < 0.08 then
		return false
	end
	self._lastGrab[player] = now

	local object = World.objectFromPart(part)
	local lab = World.viewLab[player]
	if not object or object.dead or object.static or object.lab ~= lab then
		return false
	end
	if object.grabbedBy and object.grabbedBy ~= player then
		return false
	end
	if object.kind == "golem" and object.rigid and object.statuses.stasis then
		return false
	end
	local current = self.held[player]
	if current and current ~= object then
		self:Release(player)
	end

	if lab.paused then
		self.S.LabService:UnfreezeObject(lab, object)
	end
	object.grabbedBy = player
	object.ownerToken = nil
	self.held[player] = object
	Physics2D.setOwner(object.parts, player)
	self.S.LabService:MarkAction(lab, player)

	if object.kind == "golem" then
		local golems = self.S.GolemService
		golems:Touch(object, player)
		golems:ResetMotionHistory(object, 0.25)
		if object.state ~= "ko" and object.state ~= "controlled" then
			golems:Stun(object, P.StunTime)
		end
		golems:_updateUpright(object)
	else
		object.lastActor = player
		object.lastActorTime = now
	end
	return true
end

function GrabService:Release(player: Player)
	local object = self.held[player]
	if not object then
		return
	end
	self.held[player] = nil
	if object.grabbedBy ~= player then
		return
	end
	object.grabbedBy = nil
	object.lastGrabber = player
	local lab = object.lab

	if object.kind == "golem" then
		self.S.GolemService:Touch(object, player)
		self.S.GolemService:_updateUpright(object)
		self.S.GolemService:ResetMotionHistory(object, 0.2)
	end

	if lab.paused then
		-- Time is stopped: the object freezes where it was dropped.
		Physics2D.setOwner(object.parts, nil)
		self.S.LabService:FreezeObject(lab, object)
		return
	end

	-- Measure the fling a moment later (the client applies its fling velocity on release).
	task.delay(0.12, function()
		if object.dead or not player.Parent then
			return
		end
		local root = rootOf(object)
		if root and root.Parent then
			local speed = root.AssemblyLinearVelocity.Magnitude / math.max(lab.timeScale, 0.05)
			if object.kind == "golem" then
				self.S.ChallengeService:Event(player, "fling", speed)
				if speed > 120 then
					self.S.EconomyService:AddChaos(player, math.floor(speed * 0.6), lab)
				end
			end
		end
	end)

	local token = {}
	object.ownerToken = token
	task.delay(P.OwnershipReturnDelay, function()
		if object.ownerToken == token and not object.grabbedBy and not object.dead then
			object.ownerToken = nil
			Physics2D.setOwner(object.parts, nil)
			if object.kind == "golem" then
				self.S.GolemService:ResetMotionHistory(object, 0.15)
			end
		end
	end)
end

-- Server needs authority right now (e.g. an explosion hits a held object).
function GrabService:ForceRelease(object)
	local player = object.grabbedBy
	if player then
		self.held[player] = nil
		object.grabbedBy = nil
		if player.Parent then
			Net.event("FX"):FireClient(player, "drop", {})
		end
	end
	object.ownerToken = nil
	if not object.dead then
		Physics2D.setOwner(object.parts, nil)
		if object.kind == "golem" then
			self.S.GolemService:ResetMotionHistory(object, 0.15)
			self.S.GolemService:_updateUpright(object)
		end
	end
end

function GrabService:ReleaseAllFor(player: Player)
	local object = self.held[player]
	if object then
		self:ForceRelease(object)
	end
	self.held[player] = nil
	self._lastGrab[player] = nil
end

function GrabService:ReleaseLab(lab)
	for player, object in table.clone(self.held) do
		if object.lab == lab then
			self:ForceRelease(object)
			self.held[player] = nil
		end
	end
end

-- Ensures the server can apply impulses to this object (reclaims ownership if needed).
function GrabService:Claim(object)
	if object.grabbedBy then
		self:ForceRelease(object)
	elseif object.ownerToken then
		object.ownerToken = nil
		Physics2D.setOwner(object.parts, nil)
	end
end

return GrabService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">HazardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Map hazards driven by part attributes set in the map builders:
--   Lava, Bumper, Trampoline, Crusher (physics piston), Conveyor, Fan (updraft zone), Tesla, Icicle.

local Workspace = game:GetService("Workspace")

local Systems = script.Parent.Parent.Systems
local World = require(Systems.World)
local Physics2D = require(Systems.Physics2D)

local HazardService = {}

local function rand(a: number, b: number): number
	return a + math.random() * (b - a)
end

function HazardService:Init(services)
	self.S = services
	self._labs = {}
end

function HazardService:Start() end

local function objectOf(part: BasePart)
	return World.objectFromPart(part)
end

local function cooldownOk(store, key, seconds: number): boolean
	local now = os.clock()
	if (store[key] or 0) > now then
		return false
	end
	store[key] = now + seconds
	return true
end

-- ─────────────────────────────── registration ───────────────────────────────

function HazardService:RegisterLab(lab)
	local state = {
		lab = lab,
		connections = {},
		crushers = {},
		fans = {},
		teslas = {},
		icicles = {},
		conveyors = {},
		cooldowns = {},
		fanTimer = 0,
		icicleTimer = rand(6, 10),
	}
	self._labs[lab] = state
	for _, part in lab.room:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Hazard") then
			self:_register(state, part)
		end
	end
end

function HazardService:RegisterPart(lab, part: BasePart)
	local state = self._labs[lab]
	if state then
		self:_register(state, part)
	end
end

function HazardService:UnregisterPart(lab, part: BasePart)
	local state = self._labs[lab]
	if not state then
		return
	end
	local conn = state.connections[part]
	if conn then
		conn:Disconnect()
		state.connections[part] = nil
	end
end

function HazardService:UnregisterLab(lab)
	local state = self._labs[lab]
	if not state then
		return
	end
	for _, conn in state.connections do
		conn:Disconnect()
	end
	self._labs[lab] = nil
end

function HazardService:_register(state, part: BasePart)
	local kind = part:GetAttribute("Hazard")
	local lab = state.lab
	if kind == "Lava" then
		part.CanTouch = true
		state.connections[part] = part.Touched:Connect(function(other)
			self:_lavaTouch(state, other)
		end)
	elseif kind == "Bumper" then
		part.CanTouch = true
		state.connections[part] = part.Touched:Connect(function(other)
			self:_bumperTouch(state, part, other)
		end)
	elseif kind == "Trampoline" then
		part.CanTouch = true
		state.connections[part] = part.Touched:Connect(function(other)
			self:_trampolineTouch(state, part, other)
		end)
	elseif kind == "Crusher" then
		self:_setupCrusher(state, part)
	elseif kind == "Conveyor" then
		table.insert(state.conveyors, { part = part, base = part.AssemblyLinearVelocity })
	elseif kind == "Fan" then
		table.insert(state.fans, part)
	elseif kind == "Tesla" then
		table.insert(
			state.teslas,
			{ part = part, timer = rand(1, (part:GetAttribute("TeslaInterval") :: number?) or 3) }
		)
	elseif kind == "Icicle" then
		part.CanTouch = true
		local record = { part = part, template = part:Clone(), cframe = part.CFrame, falling = false }
		table.insert(state.icicles, record)
		state.connections[part] = part.Touched:Connect(function(other)
			if not record.falling then
				local object = objectOf(other)
				if object then
					self:_dropIcicle(state, record)
				end
			end
		end)
	end
	local _ = lab
end

-- ─────────────────────────────── touch hazards ───────────────────────────────

function HazardService:_lavaTouch(state, other: BasePart)
	local object = objectOf(other)
	if not object or object.dead then
		return
	end
	local lab = state.lab
	if not cooldownOk(state.cooldowns, object, 0.45) then
		return
	end
	local E = self.S.EffectsService
	if object.kind == "golem" then
		E:ApplyStatus(object, "burning", { duration = 5 })
		self.S.GolemService:Damage(object, 8, { position = other.Position, kind = "lava" })
		self.S.GolemService:Stun(object, 1.5)
		E:Kick(object, Vector3.new(rand(-12, 12), 70 * lab.timeScale, 0))
		self.S.LabService:FXU(lab, "lavasplash", { p = other.Position })
	elseif object.kind == "prop" then
		if object.explosive then
			self.S.PropService:Ignite(object, nil)
		else
			E:Kick(object, Vector3.new(0, 45 * lab.timeScale, 0))
		end
	end
end

function HazardService:_bumperTouch(state, bumper: BasePart, other: BasePart)
	local object = objectOf(other)
	if not object or object.dead then
		return
	end
	if not cooldownOk(state.cooldowns, object, 0.25) then
		return
	end
	local lab = state.lab
	local offset = other.Position - bumper.Position
	local dir = Vector3.new(offset.X, offset.Y, 0)
	dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.yAxis
	local force = bumper:GetAttribute("BumperForce") or 120
	self.S.EffectsService:Kick(object, dir * force * lab.timeScale)
	if object.kind == "golem" then
		self.S.GolemService:Stun(object, 1.2)
		self.S.GolemService:Damage(object, 4, { position = other.Position, kind = "bumper" })
	end
	self.S.LabService:FXU(lab, "bumper", { p = bumper.Position, c = bumper.Color })
end

function HazardService:_trampolineTouch(state, pad: BasePart, other: BasePart)
	local object = objectOf(other)
	if not object or object.dead then
		return
	end
	if other.Position.Y < pad.Position.Y then
		return
	end
	if not cooldownOk(state.cooldowns, object, 0.45) then
		return
	end
	local lab = state.lab
	local speed = pad:GetAttribute("LaunchSpeed") or 140
	self.S.EffectsService:Kick(object, Vector3.new(rand(-6, 6), speed * lab.timeScale, 0))
	if object.kind == "golem" then
		self.S.GolemService:Stun(object, 1.2)
	end
	self.S.LabService:FXU(lab, "boing", { p = pad.Position })
end

-- ─────────────────────────────── crushers (physics pistons) ───────────────────────────────

function HazardService:_setupCrusher(state, head: BasePart)
	local lab = state.lab
	local index = head:GetAttribute("CrusherIndex")
	local topY = head:GetAttribute("TopY") or 40
	local bottomY = head:GetAttribute("BottomY") or 3
	local travel = topY - bottomY
	-- Weld decoration children to the head.
	local container = head.Parent
	if container then
		for _, child in container:GetChildren() do
			if child:IsA("BasePart") and child ~= head and child:GetAttribute("CrusherChild") == index then
				child.Anchored = false
				child.CanCollide = false
				child.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = head
				weld.Part1 = child
				weld.Parent = child
			end
		end
	end
	local anchor = Instance.new("Part")
	anchor.Name = "CrusherAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(head.Position)
	anchor.Parent = head.Parent
	local a0 = Instance.new("Attachment")
	a0.CFrame = Physics2D.UpRotation
	a0.Parent = anchor
	local a1 = Instance.new("Attachment")
	a1.CFrame = head.CFrame:ToObjectSpace(CFrame.new(head.Position) * Physics2D.UpRotation)
	a1.Parent = head
	local slider = Instance.new("PrismaticConstraint")
	slider.Attachment0 = a0
	slider.Attachment1 = a1
	slider.LimitsEnabled = true
	slider.LowerLimit = -travel
	slider.UpperLimit = 0
	slider.ActuatorType = Enum.ActuatorType.Servo
	slider.ServoMaxForce = 5e7
	slider.Speed = 12
	slider.TargetPosition = 0
	slider.LinearResponsiveness = 120
	slider.Parent = head
	head.CustomPhysicalProperties = PhysicalProperties.new(20, 0.5, 0, 1, 1)
	head.Anchored = false
	head.CanTouch = true
	pcall(head.SetNetworkOwner, head, nil)

	local crusher = {
		head = head,
		slider = slider,
		travel = travel,
		period = head:GetAttribute("Period") or 3.4,
		phase = head:GetAttribute("Phase") or 0,
		t = 0,
		down = false,
	}
	table.insert(state.crushers, crusher)
	state.connections[head] = head.Touched:Connect(function(other)
		if not crusher.down then
			return
		end
		local object = objectOf(other)
		if not object or object.dead then
			return
		end
		if not cooldownOk(state.cooldowns, object, 0.6) then
			return
		end
		if object.kind == "golem" then
			self.S.GolemService:Damage(object, 30, { position = other.Position, kind = "crush" })
			self.S.GolemService:Stun(object, 2)
			self.S.LabService:FX(lab, "crush", { p = other.Position })
			if object.statuses.frozen or object.statuses.golden then
				self.S.EffectsService:Shatter(
					object,
					if object.statuses.golden then "gold" else "ice",
					nil,
					head.Position
				)
			end
		elseif object.kind == "prop" then
			if object.explosive then
				self.S.PropService:Explode(object)
			elseif object.propId == "crate" then
				self.S.LabService:FX(lab, "splinter", { p = object.root.Position })
				self.S.PropService:Despawn(object)
			end
		end
	end)
end

-- ─────────────────────────────── icicles ───────────────────────────────

function HazardService:_dropIcicle(state, record)
	if record.falling or not record.part.Parent then
		return
	end
	local lab = state.lab
	record.falling = true
	local part = record.part
	part.Anchored = false
	part.CollisionGroup = "Props"
	Physics2D.attach(part, lab.planeOrigin, { lockRotation = true, gravity = false })
	pcall(part.SetNetworkOwner, part, nil)
	self.S.LabService:FXU(lab, "crack", { p = part.Position })
	local hitConn
	hitConn = part.Touched:Connect(function(other)
		local object = objectOf(other)
		if object and object.kind == "golem" and part.AssemblyLinearVelocity.Magnitude > 20 then
			hitConn:Disconnect()
			self.S.GolemService:Damage(object, 22, { position = part.Position, kind = "icicle" })
			self.S.EffectsService:ApplyStatus(object, "frozen", { duration = 3 })
			self.S.LabService:FX(lab, "shatter", { p = part.Position, kind = "ice", c = part.Color, small = true })
			part:Destroy()
		end
	end)
	task.delay(2.5, function()
		if hitConn.Connected then
			hitConn:Disconnect()
		end
		if part.Parent then
			self.S.LabService:FX(lab, "shatter", { p = part.Position, kind = "ice", c = part.Color, small = true })
			part:Destroy()
		end
	end)
	task.delay(10, function()
		if lab.destroyed or not self._labs[lab] or state ~= self._labs[lab] then
			return
		end
		local fresh = record.template:Clone()
		fresh.CFrame = record.cframe
		fresh.Parent = lab.room:FindFirstChild("Hazards") or lab.room
		record.part = fresh
		record.falling = false
		state.connections[fresh] = fresh.Touched:Connect(function(other)
			if not record.falling and objectOf(other) then
				self:_dropIcicle(state, record)
			end
		end)
	end)
end

-- ─────────────────────────────── per-frame ───────────────────────────────

function HazardService:Update(lab, dt: number, labDt: number)
	local state = self._labs[lab]
	if not state then
		return
	end
	local ts = lab.timeScale

	-- Crushers: wait at the top, slam down fast, rise slowly. Paused labs freeze them.
	for _, crusher in state.crushers do
		local head = crusher.head
		if not head.Parent then
			continue
		end
		if lab.paused then
			if not head.Anchored then
				head.Anchored = true
			end
			continue
		elseif head.Anchored then
			head.Anchored = false
		end
		crusher.t += labDt
		local cycle = (crusher.t + crusher.phase) % crusher.period
		local wantDown = cycle > crusher.period * 0.55 and cycle < crusher.period * 0.72
		if wantDown ~= crusher.down then
			crusher.down = wantDown
			crusher.slider.TargetPosition = if wantDown then -crusher.travel else 0
			crusher.slider.Speed = (if wantDown then 85 else 14) * ts
			if wantDown then
				self.S.LabService:FX(lab, "crusherslam", { p = head.Position })
			end
		end
	end

	-- Conveyors follow the lab's time scale.
	for _, conveyor in state.conveyors do
		local target = conveyor.base * (if lab.paused then 0 else ts)
		if (conveyor.part.AssemblyLinearVelocity - target).Magnitude > 0.01 then
			conveyor.part.AssemblyLinearVelocity = target
		end
	end

	if labDt <= 0 then
		return
	end

	-- Updraft fans.
	state.fanTimer -= labDt
	if state.fanTimer <= 0 and #state.fans > 0 then
		local step = 0.1 - state.fanTimer
		state.fanTimer = 0.1
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { lab.dynamic }
		for _, zone in state.fans do
			local seen = {}
			for _, part in Workspace:GetPartBoundsInBox(zone.CFrame, zone.Size, params) do
				local object = objectOf(part)
				if object and not seen[object] then
					seen[object] = true
					local accel = zone:GetAttribute("FanAccel") or 300
					self.S.EffectsService:Pull(object, Vector3.new(0, accel * step, 0))
					if object.kind == "golem" then
						self.S.GolemService:Stun(object, 1)
					end
				end
			end
		end
	end

	-- Tesla coils.
	for _, tesla in state.teslas do
		tesla.timer -= labDt
		if tesla.timer <= 0 then
			tesla.timer = (tesla.part:GetAttribute("TeslaInterval") or 3) * rand(0.8, 1.3)
			local range = tesla.part:GetAttribute("TeslaRange") or 30
			local from = tesla.part.Position
			local target = self.S.GolemService:Nearest(lab, from, range)
			if target then
				local to = target.byName.Torso.Position
				self.S.EffectsService:Lightning(lab, from, to)
				self.S.EffectsService:ApplyStatus(target, "shocked", { duration = 2.5, chained = false })
			else
				local miss = from + Vector3.new(rand(-14, 14), rand(-16, -6), 0)
				self.S.EffectsService:Lightning(lab, from, miss)
			end
		end
	end

	-- Random icicle drops keep the cavern lively.
	if #state.icicles > 0 then
		state.icicleTimer -= labDt
		if state.icicleTimer <= 0 then
			state.icicleTimer = rand(7, 13)
			local record = state.icicles[math.random(1, #state.icicles)]
			self:_dropIcicle(state, record)
		end
	end
	local _ = dt
end

return HazardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">LabService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Labs: one private 2D physics room per player (6 per server). Handles building rooms, map
-- switching, visiting, lab commands (heal / reset / slow-mo / pause / undo), the per-lab clock,
-- FX broadcasting and the single Heartbeat loop that drives every gameplay system.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Maps = require(Shared.Data.Maps)

local ServerRoot = script.Parent.Parent
local World = require(ServerRoot.Systems.World)
local Physics2D = require(ServerRoot.Systems.Physics2D)
local LabFurniture = require(ServerRoot.Systems.LabFurniture)
local Builder = require(ServerRoot.Maps.Builder)

local LabService = {}

local labsFolder: Folder

local COMMAND_COOLDOWN = 0.25

function LabService:Init(services)
	self.S = services
	self._commandTimes = {}
	Physics2D.setupCollisionGroups()
	labsFolder = Instance.new("Folder")
	labsFolder.Name = "Labs"
	labsFolder.Parent = Workspace
end

function LabService:Start()
	local S = self.S
	S.DataService.ProfileLoaded:Connect(function(player, data)
		self:CreateLab(player, data)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onPlayerRemoving(player)
	end)

	Net.event("Command").OnServerEvent:Connect(function(player, command, arg)
		if typeof(command) ~= "string" then
			return
		end
		local now = os.clock()
		if now - (self._commandTimes[player] or 0) < COMMAND_COOLDOWN then
			return
		end
		self._commandTimes[player] = now
		self:HandleCommand(player, command, arg)
	end)

	Net.func("Visit").OnServerInvoke = function(player, ownerUserId)
		return self:Visit(player, ownerUserId)
	end

	RunService.Heartbeat:Connect(function(dt)
		self:_step(math.min(dt, 1 / 20))
	end)
end

-- ─────────────────────────────── lab lifecycle ───────────────────────────────

local function freeSlot(): number?
	for slot = 0, Config.MaxLabs - 1 do
		if not World.labs[slot] then
			return slot
		end
	end
	return nil
end

function LabService:CreateLab(owner: Player, data)
	if World.ownerLab[owner] then
		return World.ownerLab[owner]
	end
	local slot = freeSlot()
	if not slot then
		warn("[LabService] no free lab slot for", owner.Name)
		return nil
	end
	local origin = Vector3.new(slot * Config.LabSpacing, 0, 0)
	local model = Instance.new("Model")
	model.Name = "Lab_" .. owner.UserId
	model:SetAttribute("OwnerId", owner.UserId)
	model:SetAttribute("Slot", slot)
	model.Parent = labsFolder

	local dynamic = Instance.new("Folder")
	dynamic.Name = "Dynamic"
	dynamic.Parent = model
	local effects = Instance.new("Folder")
	effects.Name = "Effects"
	effects.Parent = model

	local lab: any = {
		slot = slot,
		owner = owner,
		ownerId = owner.UserId,
		model = model,
		dynamic = dynamic,
		effects = effects,
		origin = origin,
		planeOrigin = Physics2D.createLabAnchor(model, origin),
		golems = {},
		props = {},
		puddles = {},
		projectiles = {},
		fields = {},
		zones = {},
		groupUsed = {},
		timeScale = 1,
		paused = false,
		clock = 0,
		spawnHistory = {},
		lastSpawn = { kind = "golem", id = data.equippedSkin },
		privacy = data.settings.privacy or "everyone",
		maxGolems = Config.MaxGolems,
		lastActor = nil,
		lastActionTime = 0,
		mapId = nil,
		trial = nil,
	}
	if self.S.ShopService and self.S.ShopService:HasPass(owner, "LabExpansion") then
		lab.maxGolems = Config.MaxGolemsExpanded
	end
	World.labs[slot] = lab
	World.ownerLab[owner] = lab
	World.viewLab[owner] = lab

	self:BuildRoom(lab, Config.DefaultMap)
	self.S.GolemService:Spawn(lab, data.equippedSkin)
	self:RefreshRack(lab)
	self:BroadcastState(lab)
	return lab
end

function LabService:_onPlayerRemoving(player: Player)
	self._commandTimes[player] = nil
	local owned = World.ownerLab[player]
	World.viewLab[player] = nil
	if self.S.GrabService then
		self.S.GrabService:ReleaseAllFor(player)
	end
	if owned then
		-- Send visitors home before the lab disappears.
		for _, viewer in World.viewers(owned) do
			if viewer ~= player then
				local home = World.ownerLab[viewer]
				World.viewLab[viewer] = home
				self:SendState(viewer)
				self.S.ShopService:Notify(
					viewer,
					"toast",
					{ text = player.DisplayName .. "'s lab closed. Back home!", kind = "info" }
				)
			end
		end
		self:DestroyLab(owned)
		World.ownerLab[player] = nil
	end
	-- Update visitor lists of any lab this player was viewing.
	for _, lab in World.labs do
		self:BroadcastState(lab)
	end
end

function LabService:DestroyLab(lab)
	self:ClearDynamic(lab)
	if self.S.HazardService then
		self.S.HazardService:UnregisterLab(lab)
	end
	World.labs[lab.slot] = nil
	lab.destroyed = true
	lab.model:Destroy()
end

-- ─────────────────────────────── rooms ───────────────────────────────

function LabService:BuildRoom(lab, mapId: string)
	local info = Maps.get(mapId)
	if lab.room then
		if self.S.HazardService then
			self.S.HazardService:UnregisterLab(lab)
		end
		lab.room:Destroy()
	end
	local room = Instance.new("Model")
	room.Name = "Room"
	room.Parent = lab.model
	lab.room = room
	lab.mapId = info.id
	lab.map = info

	local builderModule = ServerRoot.Maps:FindFirstChild(info.builder)
	local build = require(builderModule)
	local b = Builder.new(room, CFrame.new(lab.origin))
	local layout = build(b, info, Random.new(lab.slot * 7919 + #info.id))
	lab.layout = layout

	lab.cauldron = LabFurniture.cauldron(room, CFrame.new(lab.origin + layout.cauldron))
	lab.rack = LabFurniture.rack(room, CFrame.new(lab.origin + layout.rack))
	lab.minX = -info.width / 2
	lab.maxX = info.width / 2

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { room }
	params.RespectCanCollide = true
	lab.staticRayParams = params
	local allParams = RaycastParams.new()
	allParams.FilterType = Enum.RaycastFilterType.Include
	allParams.FilterDescendantsInstances = { room, lab.dynamic }
	allParams.RespectCanCollide = true
	lab.worldRayParams = allParams

	lab.model:SetAttribute("MapId", info.id)
	lab.model:SetAttribute("Width", info.width)
	lab.model:SetAttribute("Height", info.height)
	if self.S.HazardService then
		self.S.HazardService:RegisterLab(lab)
	end
	self:RefreshRack(lab)
end

function LabService:CanUseMap(player: Player, mapId: string): (boolean, string?)
	local info = Maps.ById[mapId]
	if not info then
		return false, "Unknown lab"
	end
	local data = self.S.DataService:Get(player)
	if not data then
		return false, "Loading..."
	end
	if data.level >= info.unlockLevel or data.maps[mapId] or self.S.ShopService:HasPass(player, "MasterKey") then
		return true
	end
	return false, ("Unlocks at level %d"):format(info.unlockLevel)
end

function LabService:SetMap(lab, mapId: string, options)
	local opts = options or {}
	if self.S.TrialService and lab.trial and not opts.fromTrial then
		self.S.TrialService:Abort(lab, "map")
	end
	self:SetPaused(lab, false)
	self:SetTimeScale(lab, 1)
	self:ClearDynamic(lab)
	self:BuildRoom(lab, mapId)
	if not opts.noGolem then
		local data = self.S.DataService:Get(lab.owner)
		self.S.GolemService:Spawn(lab, data and data.equippedSkin)
	end
	self:BroadcastState(lab)
end

-- Removes golems, props, puddles, projectiles and field effects.
function LabService:ClearDynamic(lab)
	if self.S.GrabService then
		self.S.GrabService:ReleaseLab(lab)
	end
	if self.S.EffectsService then
		self.S.EffectsService:ClearLab(lab)
	end
	self.S.GolemService:ClearAll(lab)
	if self.S.PropService then
		self.S.PropService:ClearAll(lab)
	end
	table.clear(lab.projectiles)
	table.clear(lab.spawnHistory)
	lab.dynamic:ClearAllChildren()
	lab.effects:ClearAllChildren()
	lab.frozenParts = nil
end

function LabService:Reset(lab)
	local skin = if lab.lastSpawn.kind == "golem" then lab.lastSpawn.id else nil
	self:SetPaused(lab, false)
	self:SetTimeScale(lab, 1)
	self:ClearDynamic(lab)
	local data = self.S.DataService:Get(lab.owner)
	self.S.GolemService:Spawn(lab, skin or (data and data.equippedSkin))
	self:FX(lab, "reset", { p = lab.origin + Vector3.new(0, lab.map.height / 2, 0) })
	self:BroadcastState(lab)
end

-- Shows the owner's free ingredient stock as jars on the rack.
function LabService:RefreshRack(lab)
	local rack = lab.rack
	local data = self.S.DataService and self.S.DataService:Get(lab.owner)
	if not rack or not data then
		return
	end
	local stock = data.rack.stock
	local palette = {
		Color3.fromRGB(255, 122, 44),
		Color3.fromRGB(122, 214, 255),
		Color3.fromRGB(214, 247, 255),
		Color3.fromRGB(96, 232, 96),
		Color3.fromRGB(96, 146, 255),
		Color3.fromRGB(255, 140, 232),
	}
	for i = 1, 6 do
		local content = rack:FindFirstChild("JarContent" .. i)
		if content then
			content.Transparency = if i <= stock then 0.05 else 1
			content.Color = palette[i]
		end
	end
end

-- ─────────────────────────────── time control ───────────────────────────────

local function forEachAssembly(lab, fn: (BasePart) -> ())
	local seen = {}
	local function visit(object)
		for _, part in object.parts do
			if part.Parent and not part.Anchored then
				local root = part.AssemblyRootPart or part
				if not seen[root] then
					seen[root] = true
					fn(root)
				end
			end
		end
	end
	for _, golem in lab.golems do
		visit(golem)
	end
	for _, prop in lab.props do
		visit(prop)
	end
end

function LabService:SetTimeScale(lab, scale: number)
	local old = lab.timeScale
	if math.abs(old - scale) < 1e-3 then
		return
	end
	local ratio = scale / old
	lab.timeScale = scale
	if lab.paused and lab.frozenParts then
		for _, record in lab.frozenParts do
			record.v *= ratio
			record.w *= ratio
		end
	else
		forEachAssembly(lab, function(root)
			root.AssemblyLinearVelocity *= ratio
			root.AssemblyAngularVelocity *= ratio
		end)
	end
	-- Projectiles integrate in lab-time, so their velocities are already time-scale independent.
	for _, golem in lab.golems do
		self.S.GolemService:RefreshGravity(golem)
		self.S.GolemService:ApplyActuators(golem, true)
		self.S.GolemService:_updateUpright(golem)
		self.S.GolemService:ResetMotionHistory(golem, 0.2)
	end
	if self.S.PropService then
		self.S.PropService:RefreshGravity(lab)
	end
	if self.S.EffectsService then
		self.S.EffectsService:OnTimeScale(lab, ratio)
	end
	self:BroadcastState(lab)
end

function LabService:FreezeObject(lab, object)
	if not lab.paused then
		return
	end
	lab.frozenParts = lab.frozenParts or {}
	for _, part in object.parts do
		if part.Parent and not part.Anchored then
			lab.frozenParts[part] = { v = part.AssemblyLinearVelocity, w = part.AssemblyAngularVelocity }
			part.Anchored = true
		end
	end
end

function LabService:UnfreezeObject(lab, object)
	if not lab.frozenParts then
		return
	end
	for _, part in object.parts do
		local record = lab.frozenParts[part]
		if record then
			lab.frozenParts[part] = nil
			if part.Parent then
				part.Anchored = false
			end
		end
	end
end

function LabService:SetPaused(lab, paused: boolean)
	if lab.paused == paused then
		return
	end
	if paused then
		lab.paused = true
		lab.frozenParts = {}
		for _, golem in lab.golems do
			self:FreezeObject(lab, golem)
		end
		for _, prop in lab.props do
			if not prop.static then
				self:FreezeObject(lab, prop)
			end
		end
	else
		lab.paused = false
		local frozen = lab.frozenParts or {}
		lab.frozenParts = nil
		local parts = {}
		for part in frozen do
			if part.Parent then
				part.Anchored = false
				table.insert(parts, part)
			end
		end
		for part, record in frozen do
			if part.Parent then
				part.AssemblyLinearVelocity = record.v
				part.AssemblyAngularVelocity = record.w
			end
		end
		Physics2D.setOwner(parts, nil)
		for _, golem in lab.golems do
			self.S.GolemService:ResetMotionHistory(golem, 0.25)
		end
	end
	self:BroadcastState(lab)
end

-- ─────────────────────────────── commands ───────────────────────────────

function LabService:IsOwner(player: Player, lab): boolean
	return lab ~= nil and lab.owner == player
end

function LabService:MarkAction(lab, player: Player?)
	if player then
		lab.lastActor = player
		lab.lastActionTime = os.clock()
	end
end

function LabService:HandleCommand(player: Player, command: string, arg: any)
	local lab = World.viewLab[player]
	if not lab or lab.destroyed then
		return
	end
	local owner = self:IsOwner(player, lab)
	local inTrial = lab.trial ~= nil
	self:MarkAction(lab, player)

	if command == "heal" then
		self.S.GolemService:HealAll(lab)
		self:FX(lab, "healall", {})
	elseif command == "reset" then
		if not owner then
			self:_deny(player, "Only the lab owner can reset the room.")
			return
		end
		if inTrial then
			self.S.TrialService:Restart(lab)
		else
			self:Reset(lab)
		end
	elseif command == "slowmo" then
		if not owner then
			self:_deny(player, "Only the lab owner can bend time here.")
			return
		end
		self:SetTimeScale(lab, if lab.timeScale < 1 then 1 else Config.Physics.SlowMoScale)
	elseif command == "pause" then
		if not owner then
			self:_deny(player, "Only the lab owner can stop time here.")
			return
		end
		self:SetPaused(lab, not lab.paused)
	elseif command == "undo" then
		self:Undo(lab, player)
	elseif command == "spawnLast" then
		if inTrial then
			self:_deny(player, "Spawning is disabled during trials.")
			return
		end
		local last = lab.lastSpawn
		if last.kind == "golem" then
			self:SpawnGolemFor(player, lab, last.id, nil)
		elseif last.kind == "prop" and self.S.PropService then
			self.S.PropService:SpawnFor(player, lab, last.id, nil)
		end
	elseif command == "clearZombies" then
		if self.S.EffectsService then
			self.S.EffectsService:CureAllZombies(lab)
		end
	elseif command == "clearProps" then
		if not owner then
			return
		end
		if self.S.PropService then
			self.S.PropService:ClearAll(lab)
		end
	elseif command == "setMap" then
		if not owner or typeof(arg) ~= "string" then
			return
		end
		if inTrial then
			self:_deny(player, "Finish or quit the trial first.")
			return
		end
		local ok, reason = self:CanUseMap(player, arg)
		if not ok then
			self:_deny(player, reason or "Locked")
			return
		end
		self:SetMap(lab, arg)
	elseif command == "privacy" then
		if typeof(arg) ~= "string" or (arg ~= "everyone" and arg ~= "friends" and arg ~= "nobody") then
			return
		end
		local own = World.ownerLab[player]
		if own then
			own.privacy = arg
			local data = self.S.DataService:Get(player)
			if data then
				data.settings.privacy = arg
				self.S.DataService:Replicate(player, "settings")
			end
			if arg ~= "everyone" then
				for _, viewer in World.viewers(own) do
					if viewer ~= player and (arg == "nobody" or not viewer:IsFriendsWithAsync(player.UserId)) then
						self:GoHome(viewer, "The lab owner closed their lab.")
					end
				end
			end
			self:BroadcastState(own)
		end
	elseif command == "home" then
		self:GoHome(player)
	end
end

function LabService:_deny(player: Player, text: string)
	self.S.ShopService:Notify(player, "toast", { text = text, kind = "error" })
end

function LabService:SpawnGolemFor(player: Player, lab, skinId: string?, localPos: Vector3?)
	local data = self.S.DataService:Get(player)
	if not data then
		return nil
	end
	skinId = skinId or data.equippedSkin
	if not data.skins[skinId] then
		skinId = data.equippedSkin
	end
	local golem, err = self.S.GolemService:Spawn(lab, skinId, localPos, { source = player })
	if not golem then
		self:_deny(player, err or "Can't spawn")
		return nil
	end
	lab.lastSpawn = { kind = "golem", id = skinId }
	table.insert(lab.spawnHistory, { kind = "golem", ref = golem })
	data.stats.golemsSpawned += 1
	self:FX(lab, "spawn", { p = golem.byName.Torso.Position, c = golem.skin.accent })
	return golem
end

function LabService:Undo(lab, player: Player)
	while #lab.spawnHistory > 0 do
		local entry = table.remove(lab.spawnHistory)
		local ref = entry.ref
		if entry.kind == "golem" and ref and not ref.dead then
			local position = ref.byName.Torso and ref.byName.Torso.Position
			self.S.GolemService:Despawn(ref)
			if position then
				self:FX(lab, "poof", { p = position })
			end
			return
		elseif entry.kind == "prop" and ref and not ref.dead and self.S.PropService then
			local position = ref.root and ref.root.Position
			self.S.PropService:Despawn(ref)
			if position then
				self:FX(lab, "poof", { p = position })
			end
			return
		end
	end
	self:_deny(player, "Nothing to undo.")
end

-- ─────────────────────────────── visiting ───────────────────────────────

function LabService:Visit(player: Player, ownerUserId: any)
	if typeof(ownerUserId) ~= "number" then
		return { ok = false, reason = "Invalid lab" }
	end
	if ownerUserId == player.UserId then
		self:GoHome(player)
		return { ok = true }
	end
	local target
	for _, lab in World.labs do
		if lab.ownerId == ownerUserId then
			target = lab
		end
	end
	if not target then
		return { ok = false, reason = "That lab is closed." }
	end
	if target.privacy == "nobody" then
		return { ok = false, reason = "That lab is private." }
	end
	if target.privacy == "friends" then
		local ok, isFriend = pcall(player.IsFriendsWithAsync, player, ownerUserId)
		if not ok or not isFriend then
			return { ok = false, reason = "Friends only!" }
		end
	end
	if self.S.GrabService then
		self.S.GrabService:ReleaseAllFor(player)
	end
	local previous = World.viewLab[player]
	World.viewLab[player] = target
	self:SendState(player)
	self:BroadcastState(target)
	if previous and previous ~= target then
		self:BroadcastState(previous)
	end
	self.S.ShopService:Notify(
		target.owner,
		"toast",
		{ text = player.DisplayName .. " is visiting your lab!", kind = "social" }
	)
	return { ok = true }
end

function LabService:GoHome(player: Player, reason: string?)
	local home = World.ownerLab[player]
	if not home then
		return
	end
	if self.S.GrabService then
		self.S.GrabService:ReleaseAllFor(player)
	end
	local previous = World.viewLab[player]
	World.viewLab[player] = home
	self:SendState(player)
	if previous and previous ~= home then
		self:BroadcastState(previous)
	end
	if reason then
		self.S.ShopService:Notify(player, "toast", { text = reason, kind = "info" })
	end
end

-- ─────────────────────────────── replication ───────────────────────────────

function LabService:StateFor(lab, player: Player)
	local visitors = {}
	for _, viewer in World.viewers(lab) do
		table.insert(visitors, { userId = viewer.UserId, name = viewer.DisplayName })
	end
	local open = {}
	for _, other in World.labs do
		if other ~= lab then
			table.insert(
				open,
				{ userId = other.ownerId, name = other.owner.DisplayName, privacy = other.privacy, mapId = other.mapId }
			)
		end
	end
	return {
		slot = lab.slot,
		ownerId = lab.ownerId,
		ownerName = lab.owner.DisplayName,
		isOwner = lab.owner == player,
		origin = lab.origin,
		mapId = lab.mapId,
		width = lab.map.width,
		height = lab.map.height,
		paused = lab.paused,
		slowmo = lab.timeScale < 1,
		timeScale = lab.timeScale,
		privacy = lab.privacy,
		visitors = visitors,
		labs = open,
		golems = self.S.GolemService.Count(lab),
		maxGolems = lab.maxGolems,
		trial = if lab.trial then lab.trial.id else nil,
		cauldron = lab.origin + lab.layout.cauldron,
		rack = lab.origin + lab.layout.rack,
	}
end

function LabService:SendState(player: Player)
	local lab = World.viewLab[player]
	if lab and not lab.destroyed then
		Net.event("Lab"):FireClient(player, self:StateFor(lab, player))
	end
end

function LabService:BroadcastState(lab)
	if lab.destroyed then
		return
	end
	for _, viewer in World.viewers(lab) do
		Net.event("Lab"):FireClient(viewer, self:StateFor(lab, viewer))
	end
end

function LabService:FX(lab, kind: string, payload: { [string]: any })
	local remote = Net.event("FX")
	for _, viewer in World.viewers(lab) do
		remote:FireClient(viewer, kind, payload)
	end
end

function LabService:FXU(lab, kind: string, payload: { [string]: any })
	local remote = Net.unreliable("FXU")
	for _, viewer in World.viewers(lab) do
		remote:FireClient(viewer, kind, payload)
	end
end

-- ─────────────────────────────── main loop ───────────────────────────────

function LabService:_step(dt: number)
	local S = self.S
	for _, lab in World.labs do
		if lab.destroyed then
			continue
		end
		local labDt = if lab.paused then 0 else dt * lab.timeScale
		lab.clock += labDt
		local ok, err = pcall(function()
			S.GolemService:Update(lab, dt, labDt)
			if S.PropService then
				S.PropService:Update(lab, dt, labDt)
			end
			if S.EffectsService then
				S.EffectsService:Update(lab, dt, labDt)
			end
			if S.PotionService then
				S.PotionService:Update(lab, dt, labDt)
			end
			if S.HazardService then
				S.HazardService:Update(lab, dt, labDt)
			end
			if S.TrialService then
				S.TrialService:Update(lab, dt, labDt)
			end
		end)
		if not ok then
			warn("[LabService] update error in lab", lab.slot, err)
		end
	end
end

return LabService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">PotionService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Brewing (recipe resolution, discovery, mastery) and using potions: thrown bottles are simulated
-- server-side as ballistic projectiles (lab-time integrated, so slow-mo and pause just work) and
-- rendered client-side from the launch parameters.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Potions = require(Shared.Data.Potions)
local Ingredients = require(Shared.Data.Ingredients)
local Recipes = require(Shared.Data.Recipes)
local Rarity = require(Shared.Data.Rarity)

local Systems = script.Parent.Parent.Systems
local World = require(Systems.World)

local PotionService = {}

local recipeIndex = Recipes.buildIndex(Potions.List)
PotionService.RecipeIndex = recipeIndex

function PotionService:Init(services)
	self.S = services
	self._lastUse = {}
	self._lastBrew = {}
end

function PotionService:Start()
	Net.func("Brew").OnServerInvoke = function(player, ids)
		return self:Brew(player, ids)
	end
	Net.event("Use").OnServerEvent:Connect(function(player, payload)
		local ok, err = pcall(self.Use, self, player, payload)
		if not ok then
			warn("[PotionService] use error:", err)
		end
	end)
end

-- ─────────────────────────────── inventory helpers ───────────────────────────────

function PotionService:IsMastered(data, potionId: string): boolean
	return (data.brewCount[potionId] or 0) >= Config.Potions.MasteryBrews
end

-- Returns available, infinite, potency.
function PotionService:Availability(player: Player, lab, potionId: string): (boolean, boolean, number)
	local data = self.S.DataService:Get(player)
	if not data then
		return false, false, 1
	end
	if lab and lab.trial then
		local provided = lab.trial.potions[potionId]
		if lab.owner ~= player then
			return false, false, 1
		end
		if provided and provided > 0 then
			return true, provided == math.huge, 1
		end
		return false, false, 1
	end
	if self:IsMastered(data, potionId) then
		return true, true, Config.Potions.MasteryPotency
	end
	return (data.potions[potionId] or 0) > 0, false, 1
end

local function consume(self, player: Player, lab, potionId: string)
	if lab and lab.trial then
		local provided = lab.trial.potions[potionId]
		if provided and provided ~= math.huge then
			lab.trial.potions[potionId] = provided - 1
			self.S.TrialService:SendPotions(lab)
		end
		return
	end
	local data = self.S.DataService:Get(player)
	if data and not self:IsMastered(data, potionId) then
		data.potions[potionId] = math.max(0, (data.potions[potionId] or 0) - 1)
		if data.potions[potionId] == 0 then
			data.potions[potionId] = nil
		end
		self.S.DataService:Replicate(player, "potions")
	end
end

-- ─────────────────────────────── brewing ───────────────────────────────

function PotionService:Brew(player: Player, ids: any)
	local data = self.S.DataService:Get(player)
	if not data then
		return { ok = false, reason = "Still loading..." }
	end
	if typeof(ids) ~= "table" or #ids < Recipes.MinIngredients or #ids > Recipes.MaxIngredients then
		return { ok = false, reason = "Add 2 or 3 ingredients." }
	end
	local clean = {}
	for i = 1, #ids do
		local id = ids[i]
		if typeof(id) ~= "string" or not Ingredients.ById[id] then
			return { ok = false, reason = "Unknown ingredient." }
		end
		table.insert(clean, id)
	end
	local now = os.clock()
	if now - (self._lastBrew[player] or 0) < 0.8 then
		return { ok = false, reason = "The cauldron is still bubbling!" }
	end
	self._lastBrew[player] = now
	if not Recipes.canAfford(data.ingredients, clean) then
		return { ok = false, reason = "You don't have those ingredients." }
	end
	for id, amount in Recipes.requirements(clean) do
		data.ingredients[id] -= amount
		if data.ingredients[id] <= 0 then
			data.ingredients[id] = nil
		end
	end

	local potionId = Recipes.resolve(recipeIndex, clean) or Potions.FallbackId
	local potion = Potions.ById[potionId]
	local bottles = Config.Potions.BottlesPerBrew
	if self.S.ShopService:HasPass(player, "Satchel") then
		bottles += Config.Potions.SatchelBonus
	end
	data.potions[potionId] = (data.potions[potionId] or 0) + bottles
	data.brewCount[potionId] = (data.brewCount[potionId] or 0) + 1
	data.stats.brews += 1

	local discovered = data.discovered[potionId] == nil
	local rewardXp, rewardCoins = 6, 0
	if discovered then
		data.discovered[potionId] = os.time()
		local rarity = Rarity[potion.rarity]
		if potionId ~= Potions.FallbackId and rarity then
			rewardXp += rarity.discoverXp
			rewardCoins += rarity.discoverCoins
		end
	end
	local mastered = data.brewCount[potionId] == Config.Potions.MasteryBrews

	local hint
	if potionId == Potions.FallbackId then
		local closest = Recipes.closestUndiscovered(Potions.List, data.discovered, clean)
		if closest then
			hint = Potions.ById[closest].hint
		end
	end

	self.S.DataService:Replicate(player, "ingredients", "potions", "brewCount", "discovered", "stats")
	if rewardCoins > 0 then
		self.S.EconomyService:AddCoins(player, rewardCoins, "discover")
	end
	self.S.EconomyService:AddXp(player, rewardXp)
	self.S.ChallengeService:Event(player, "brew", 1, { potion = potionId })
	if discovered and potionId ~= Potions.FallbackId then
		self.S.ChallengeService:Event(player, "discover", 1, { potion = potionId })
		self.S.ShopService:OnDiscovery(player, potionId)
	end

	local lab = World.viewLab[player]
	if lab then
		self.S.LabService:FX(
			lab,
			"brew",
			{ p = lab.origin + lab.layout.cauldron, c = potion.color, pid = potionId, who = player.UserId }
		)
	end
	return {
		ok = true,
		potionId = potionId,
		discovered = discovered and potionId ~= Potions.FallbackId,
		mastered = mastered,
		bottles = bottles,
		hint = hint,
		xp = rewardXp,
		coins = rewardCoins,
	}
end

-- ─────────────────────────────── using items ───────────────────────────────

local function finite(n: any): boolean
	return typeof(n) == "number" and n == n and n > -1e6 and n < 1e6
end

function PotionService:Use(player: Player, payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local kind, id = payload.kind, payload.id
	if typeof(kind) ~= "string" or typeof(id) ~= "string" or not finite(payload.x) or not finite(payload.y) then
		return
	end
	local lab = World.viewLab[player]
	if not lab or lab.destroyed then
		return
	end
	local now = os.clock()
	if now - (self._lastUse[player] or 0) < Config.Potions.ThrowCooldown then
		return
	end
	self._lastUse[player] = now

	-- Clamp the target into the room (local coordinates).
	local lx = math.clamp(payload.x - lab.origin.X, lab.minX + 1, lab.maxX - 1)
	local ly = math.clamp(payload.y - lab.origin.Y, 0.5, lab.map.height - 1)
	local target = lab.origin + Vector3.new(lx, ly, 0)
	self.S.LabService:MarkAction(lab, player)

	if kind == "potion" then
		local potion = Potions.ById[id]
		if not potion then
			return
		end
		local available, _infinite, potency = self:Availability(player, lab, id)
		if not available then
			self.S.ShopService:Notify(
				player,
				"toast",
				{ text = "Out of " .. potion.name .. "! Brew more at the cauldron.", kind = "error" }
			)
			return
		end
		local mode = if payload.mode == "feed" then "feed" else "throw"
		if mode == "feed" then
			local golem
			local part = payload.target
			if typeof(part) == "Instance" then
				local object = World.objectFromPart(part)
				if object and object.kind == "golem" and object.lab == lab then
					golem = object
				end
			end
			golem = golem or self.S.GolemService:Nearest(lab, target, 7)
			if golem then
				consume(self, player, lab, id)
				self:_feed(player, lab, golem, potion, potency)
				return
			end
		end
		if self:_countProjectiles(lab) >= Config.MaxProjectiles then
			return
		end
		consume(self, player, lab, id)
		self:_throw(player, lab, potion, target, potency)
		local data = self.S.DataService:Get(player)
		if data then
			data.stats.potionsUsed += 1
		end
	elseif kind == "golem" then
		if lab.trial then
			self.S.ShopService:Notify(player, "toast", { text = "Spawning is disabled during trials.", kind = "error" })
			return
		end
		local feetY = math.max(0, ly - 4.6)
		self.S.LabService:SpawnGolemFor(player, lab, id, Vector3.new(lx, feetY, 0))
	elseif kind == "prop" then
		if lab.trial then
			self.S.ShopService:Notify(player, "toast", { text = "Spawning is disabled during trials.", kind = "error" })
			return
		end
		self.S.PropService:SpawnFor(player, lab, id, Vector3.new(lx, ly, 0))
	end
end

function PotionService:_countProjectiles(lab): number
	local n = 0
	for _ in lab.projectiles do
		n += 1
	end
	return n
end

-- Lobs a bottle from just below the ceiling so it lands exactly on the target.
function PotionService:_throw(player: Player, lab, potion, target: Vector3, potency: number)
	local localX = target.X - lab.origin.X
	local side = if localX > 0 then -1 else 1
	local originLocal = Vector3.new(
		math.clamp(localX + side * 16, lab.minX + 2, lab.maxX - 2),
		math.min(lab.map.height - 3, (target.Y - lab.origin.Y) + 26),
		0
	)
	local origin = lab.origin + originLocal
	local g = Workspace.Gravity * lab.map.gravityScale
	local gravity = Vector3.new(0, -g, 0)
	local distance = (target - origin).Magnitude
	local flight = math.clamp(distance / 70, 0.38, 0.75)
	local velocity = (target - origin - gravity * (0.5 * flight * flight)) / flight
	-- Velocity is in studs per lab-second; Update integrates with lab time (dt × timeScale), so
	-- slow motion and pause affect flight without changing the trajectory.
	local projectile = {
		id = World.nextId(),
		potion = potion,
		owner = player,
		position = origin,
		velocity = velocity,
		gravity = gravity,
		age = 0,
		potency = potency,
	}
	lab.projectiles[projectile.id] = projectile
	self.S.LabService:FX(lab, "throw", { id = projectile.id, o = origin, v = velocity, g = g, pid = potion.id })
end

function PotionService:_feed(player: Player, lab, golem, potion, potency: number)
	local torso = golem.byName.Torso
	self.S.LabService:FX(lab, "feed", { golem = golem.id, pid = potion.id, p = torso and torso.Position })
	local data = self.S.DataService:Get(player)
	if data then
		data.stats.potionsUsed += 1
	end
	task.delay(0.55, function()
		if golem.dead or lab.destroyed then
			return
		end
		local at = golem.byName.Torso and golem.byName.Torso.Position or lab.origin
		self.S.EffectsService:ApplyPotion(
			lab,
			potion,
			at,
			{ mode = "feed", target = golem, source = player, potency = potency }
		)
	end)
end

function PotionService:_shatter(lab, projectile, position: Vector3, normal: Vector3?, hitPart: Instance?)
	lab.projectiles[projectile.id] = nil
	self.S.LabService:FX(
		lab,
		"shatter",
		{ id = projectile.id, p = position, n = normal or Vector3.yAxis, pid = projectile.potion.id }
	)
	self.S.EffectsService:ApplyPotion(lab, projectile.potion, position, {
		mode = "throw",
		source = projectile.owner,
		potency = projectile.potency,
		normal = normal,
		hitPart = hitPart,
	})
end

-- Ballistic integration in lab time with a raycast per step for hit detection.
function PotionService:Update(lab, _dt: number, labDt: number)
	if labDt <= 0 then
		return
	end
	for _, projectile in table.clone(lab.projectiles) do
		if not lab.projectiles[projectile.id] then
			continue
		end
		local velocity = projectile.velocity
		local step = velocity * labDt + projectile.gravity * (0.5 * labDt * labDt)
		local hit = Workspace:Raycast(projectile.position, step, lab.worldRayParams)
		projectile.age += labDt
		if hit then
			self:_shatter(lab, projectile, hit.Position, hit.Normal, hit.Instance)
		else
			projectile.position += step
			projectile.velocity = velocity + projectile.gravity * labDt
			local p = projectile.position - lab.origin
			if projectile.age > 4 or p.Y < -5 or p.X < lab.minX - 5 or p.X > lab.maxX + 5 then
				self:_shatter(lab, projectile, projectile.position, nil, nil)
			end
		end
	end
end

return PotionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">PropService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Spawnable physics props (crates, barrels, balls, planks, anvils, TNT, trampolines).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PropsData = require(Shared.Data.Props)

local Systems = script.Parent.Parent.Systems
local World = require(Systems.World)
local Physics2D = require(Systems.Physics2D)

local PropService = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

function PropService:Init(services)
	self.S = services
end

function PropService:Start() end

local function newPart(model: Model, spec: { [string]: any }): Part
	local part = Instance.new("Part")
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in spec do
		(part :: any)[key] = value
	end
	part.Parent = model
	return part
end

local function deco(model: Model, root: BasePart, spec: { [string]: any }): Part
	spec.CanCollide = false
	spec.CanQuery = false
	spec.CanTouch = false
	spec.Massless = true
	local part = newPart(model, spec)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function collider(model: Model, spec: { [string]: any }): Part
	spec.CanCollide = true
	spec.CanQuery = true
	spec.CanTouch = true
	spec.CollisionGroup = "Props"
	return newPart(model, spec)
end

-- Each builder returns root, extraColliders, flags.
local BUILDERS = {}

BUILDERS.crate = function(model: Model, at: CFrame)
	local root = collider(model, {
		Name = "Crate",
		Size = Vector3.one * 3.6,
		CFrame = at * CFrame.new(0, 1.8, 0),
		Color = Color3.fromRGB(176, 128, 76),
		Material = Enum.Material.WoodPlanks,
		CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.6, 0.15, 1, 1),
	})
	local edge = Color3.fromRGB(110, 74, 44)
	for _, y in { -1.6, 1.6 } do
		deco(model, root, {
			Name = "Edge",
			Size = Vector3.new(3.7, 0.4, 3.7),
			CFrame = root.CFrame * CFrame.new(0, y, 0),
			Color = edge,
			Material = Enum.Material.Wood,
		})
	end
	for _, x in { -1.6, 1.6 } do
		deco(model, root, {
			Name = "Edge",
			Size = Vector3.new(0.4, 3.7, 3.7),
			CFrame = root.CFrame * CFrame.new(x, 0, 0),
			Color = edge,
			Material = Enum.Material.Wood,
		})
	end
	deco(model, root, {
		Name = "Brace",
		Size = Vector3.new(0.35, 4.6, 0.3),
		CFrame = root.CFrame * CFrame.new(0, 0, 1.85) * CFrame.Angles(0, 0, math.rad(45)),
		Color = edge,
		Material = Enum.Material.Wood,
	})
	return root, {}, {}
end

BUILDERS.barrel = function(model: Model, at: CFrame)
	local root = collider(model, {
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4.2, 3.2, 3.2),
		CFrame = at * CFrame.new(0, 2.1, 0) * UPRIGHT,
		Color = Color3.fromRGB(200, 44, 40),
		Material = Enum.Material.Metal,
		CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.5, 0.2, 1, 1),
	})
	for _, y in { -1.4, 1.4 } do
		deco(model, root, {
			Name = "Band",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.35, 3.35, 3.35),
			CFrame = root.CFrame * CFrame.new(y, 0, 0),
			Color = Color3.fromRGB(60, 60, 66),
			Material = Enum.Material.Metal,
		})
	end
	local symbol = deco(model, root, {
		Name = "Hazard",
		Size = Vector3.new(1.3, 1.3, 0.2),
		CFrame = CFrame.new(root.Position + Vector3.new(0, 0, 1.6)) * CFrame.Angles(0, 0, math.rad(45)),
		Color = Color3.fromRGB(255, 210, 40),
		Material = Enum.Material.Neon,
	})
	local _ = symbol
	return root, {}, { explosive = true, blastRadius = 17, blastPower = 1.2, fuse = 0 }
end

BUILDERS.ball = function(model: Model, at: CFrame)
	local root = collider(model, {
		Name = "BeachBall",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.6,
		CFrame = at * CFrame.new(0, 1.8, 0),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		CustomPhysicalProperties = PhysicalProperties.new(0.12, 0.4, 0.85, 1, 100),
	})
	-- Coloured stripes: thin discs through the centre whose rims poke out of the ball surface.
	local colors = { Color3.fromRGB(255, 70, 80), Color3.fromRGB(70, 160, 255), Color3.fromRGB(255, 210, 60) }
	for i, color in colors do
		deco(model, root, {
			Name = "Stripe",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.7, 3.66, 3.66),
			CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(i * 60)),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	return root, {}, {}
end

BUILDERS.plank = function(model: Model, at: CFrame)
	local root = collider(model, {
		Name = "Plank",
		Size = Vector3.new(16, 0.9, 2.6),
		CFrame = at * CFrame.new(0, 0.45, 0),
		Color = Color3.fromRGB(168, 118, 74),
		Material = Enum.Material.WoodPlanks,
		CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.7, 0.1, 1, 1),
	})
	return root, {}, {}
end

BUILDERS.anvil = function(model: Model, at: CFrame)
	local metal = Color3.fromRGB(64, 66, 76)
	local heavy = PhysicalProperties.new(9, 0.7, 0.02, 1, 1)
	local root = collider(model, {
		Name = "AnvilTop",
		Size = Vector3.new(4.2, 1.4, 2.4),
		CFrame = at * CFrame.new(0, 2.8, 0),
		Color = metal,
		Material = Enum.Material.Metal,
		CustomPhysicalProperties = heavy,
	})
	local base = collider(model, {
		Name = "AnvilBase",
		Size = Vector3.new(2.6, 2.1, 2.2),
		CFrame = at * CFrame.new(0, 1.05, 0),
		Color = metal,
		Material = Enum.Material.Metal,
		CustomPhysicalProperties = heavy,
	})
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = base
	weld.Parent = base
	deco(model, root, {
		Name = "Horn",
		Size = Vector3.new(1.8, 0.9, 1.8),
		CFrame = root.CFrame * CFrame.new(-2.8, 0.2, 0) * CFrame.Angles(0, 0, math.rad(-20)),
		Color = metal,
		Material = Enum.Material.Metal,
	})
	return root, { base }, { heavy = true }
end

BUILDERS.bowling = function(model: Model, at: CFrame)
	local root = collider(model, {
		Name = "BowlingBall",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2.8,
		CFrame = at * CFrame.new(0, 1.4, 0),
		Color = Color3.fromRGB(40, 60, 170),
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.25,
		CustomPhysicalProperties = PhysicalProperties.new(4, 0.3, 0.3, 1, 1),
	})
	for i, offset in { Vector3.new(-0.35, 0.5, 1.15), Vector3.new(0.35, 0.5, 1.15), Vector3.new(0, -0.1, 1.3) } do
		deco(model, root, {
			Name = "Hole" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.45,
			CFrame = root.CFrame * CFrame.new(offset),
			Color = Color3.fromRGB(15, 15, 20),
			Material = Enum.Material.SmoothPlastic,
		})
	end
	return root, {}, {}
end

BUILDERS.tnt = function(model: Model, at: CFrame)
	local root = collider(model, {
		Name = "TNT",
		Size = Vector3.one * 2.8,
		CFrame = at * CFrame.new(0, 1.4, 0),
		Color = Color3.fromRGB(210, 40, 36),
		Material = Enum.Material.SmoothPlastic,
		CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.6, 0.1, 1, 1),
	})
	deco(model, root, {
		Name = "Band",
		Size = Vector3.new(2.9, 0.9, 2.9),
		CFrame = root.CFrame,
		Color = Color3.fromRGB(240, 230, 210),
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(120, 40)
	gui.LightInfluence = 0.4
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "TNT"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(180, 20, 20)
	label.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	label.Parent = gui
	local band = model:FindFirstChild("Band")
	gui.Parent = band
	local fuse = deco(model, root, {
		Name = "Fuse",
		Size = Vector3.new(0.2, 1, 0.2),
		CFrame = root.CFrame * CFrame.new(0, 1.9, 0),
		Color = Color3.fromRGB(60, 50, 40),
		Material = Enum.Material.Fabric,
	})
	local _ = fuse
	return root, {}, { explosive = true, blastRadius = 19, blastPower = 1.4, fuse = 2.4 }
end

BUILDERS.trampoline = function(model: Model, at: CFrame)
	local frame = collider(model, {
		Name = "TrampolineFrame",
		Size = Vector3.new(10, 1.6, 6),
		CFrame = at * CFrame.new(0, 0.8, 0),
		Color = Color3.fromRGB(60, 64, 80),
		Material = Enum.Material.Metal,
		Anchored = true,
	})
	local top = collider(model, {
		Name = "TrampolineTop",
		Size = Vector3.new(9, 0.4, 5.4),
		CFrame = at * CFrame.new(0, 1.75, 0),
		Color = Color3.fromRGB(80, 180, 255),
		Material = Enum.Material.Rubber,
		Anchored = true,
		CustomPhysicalProperties = PhysicalProperties.new(0.8, 0.3, 1, 1, 100),
	})
	top:SetAttribute("Hazard", "Trampoline")
	top:SetAttribute("LaunchSpeed", 150)
	for _, x in { -4.4, 4.4 } do
		newPart(model, {
			Name = "Spring",
			Size = Vector3.new(0.6, 1.4, 0.6),
			CFrame = at * CFrame.new(x, 1.8, 2.2),
			Color = Color3.fromRGB(220, 220, 230),
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
		})
	end
	return frame, { top }, { static = true }
end

-- ─────────────────────────────── spawning ───────────────────────────────

local function countProps(lab): number
	local n = 0
	for _ in lab.props do
		n += 1
	end
	return n
end

function PropService:Spawn(lab, propId: string, localPos: Vector3, options)
	local opts = options or {}
	local builder = BUILDERS[propId]
	if not builder then
		return nil, "Unknown item"
	end
	if countProps(lab) >= Config.MaxProps then
		return nil, ("Too many items (max %d)"):format(Config.MaxProps)
	end
	local model = Instance.new("Model")
	model.Name = "Prop_" .. propId
	local world = lab.origin + Vector3.new(localPos.X, localPos.Y, 0)
	local at = CFrame.new(world)
	local root, extra, flags = builder(model, at)
	local parts = { root }
	for _, part in extra do
		table.insert(parts, part)
	end
	model.PrimaryPart = root
	model:SetAttribute("PropId", propId)

	local prop: any = {
		kind = "prop",
		id = World.nextId(),
		propId = propId,
		lab = lab,
		model = model,
		root = root,
		parts = parts,
		static = flags.static == true,
		explosive = flags.explosive == true,
		blastRadius = flags.blastRadius,
		blastPower = flags.blastPower,
		fuseTime = flags.fuse,
		fuse = nil,
		prevVel = nil,
		lastActor = opts.source,
		lastActorTime = if opts.source then os.clock() else 0,
		mods = { gravity = {} },
		statuses = {},
	}
	model.Parent = lab.dynamic
	if not prop.static then
		Physics2D.attach(root, lab.planeOrigin, { lockRotation = true, gravity = true })
		self:_refreshGravityFor(prop)
		Physics2D.setOwner(parts, nil)
	else
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
		if self.S.HazardService then
			for _, part in parts do
				if part:GetAttribute("Hazard") then
					self.S.HazardService:RegisterPart(lab, part)
				end
			end
		end
	end
	lab.props[prop.id] = prop
	World.register(prop)
	if lab.paused and not prop.static then
		self.S.LabService:FreezeObject(lab, prop)
	end
	return prop
end

function PropService:SpawnFor(player: Player, lab, propId: string, localPos: Vector3?)
	local info = PropsData.ById[propId]
	local data = self.S.DataService:Get(player)
	if not info or not data then
		return nil
	end
	if data.level < info.unlockLevel then
		self.S.ShopService:Notify(
			player,
			"toast",
			{ text = ("%s unlocks at level %d"):format(info.name, info.unlockLevel), kind = "error" }
		)
		return nil
	end
	local position = localPos or Vector3.new(0, 20, 0)
	if propId == "trampoline" then
		-- Snap to the surface below the cursor.
		local hit = Workspace:Raycast(
			lab.origin + Vector3.new(position.X, position.Y + 2, 0),
			Vector3.new(0, -120, 0),
			lab.staticRayParams
		)
		if not hit then
			return nil
		end
		position = Vector3.new(position.X, hit.Position.Y - lab.origin.Y, 0)
	end
	local prop, err = self:Spawn(lab, propId, position, { source = player })
	if not prop then
		self.S.ShopService:Notify(player, "toast", { text = err or "Can't place that here", kind = "error" })
		return nil
	end
	lab.lastSpawn = { kind = "prop", id = propId }
	table.insert(lab.spawnHistory, { kind = "prop", ref = prop })
	self.S.LabService:FX(lab, "spawn", { p = prop.root.Position, c = Color3.fromRGB(255, 230, 160) })
	return prop
end

function PropService:Despawn(prop)
	local lab = prop.lab
	if lab.props[prop.id] ~= prop then
		return
	end
	if self.S.GrabService then
		self.S.GrabService:ForceRelease(prop)
	end
	if self.S.HazardService then
		for _, part in prop.parts do
			self.S.HazardService:UnregisterPart(lab, part)
		end
	end
	World.unregister(prop)
	lab.props[prop.id] = nil
	prop.dead = true
	prop.model:Destroy()
end

function PropService:ClearAll(lab)
	for _, prop in table.clone(lab.props) do
		self:Despawn(prop)
	end
end

function PropService:_refreshGravityFor(prop)
	if prop.static then
		return
	end
	local lab = prop.lab
	local scale = lab.map.gravityScale * lab.timeScale * lab.timeScale
	for _, factor in prop.mods.gravity do
		scale *= factor
	end
	Physics2D.setGravityScale(prop.root, scale)
end

function PropService:RefreshGravity(lab)
	for _, prop in lab.props do
		self:_refreshGravityFor(prop)
	end
end

-- Lights a fuse (TNT) or detonates immediately (barrels).
function PropService:Ignite(prop, source: Player?)
	if not prop.explosive or prop.dead or prop.fuse then
		return
	end
	if source then
		prop.lastActor = source
		prop.lastActorTime = os.clock()
	end
	if (prop.fuseTime or 0) <= 0 then
		self:Explode(prop)
		return
	end
	prop.fuse = prop.fuseTime
	local spark = Instance.new("ParticleEmitter")
	spark.Texture = "rbxasset://textures/particles/fire_sparks_main.dds"
	spark.Rate = 40
	spark.Lifetime = NumberRange.new(0.2, 0.4)
	spark.Speed = NumberRange.new(4, 8)
	spark.SpreadAngle = Vector2.new(60, 60)
	spark.LightEmission = 1
	spark.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120))
	spark.Size = NumberSequence.new(0.3, 0)
	spark.Parent = prop.model:FindFirstChild("Fuse") or prop.root
	local light = Instance.new("PointLight")
	light.Name = "FuseLight"
	light.Color = Color3.fromRGB(255, 160, 60)
	light.Range = 10
	light.Brightness = 2
	light.Parent = prop.root
	self.S.LabService:FX(prop.lab, "fuse", { p = prop.root.Position })
end

function PropService:Explode(prop)
	if prop.dead then
		return
	end
	local lab = prop.lab
	local position = prop.root.Position
	local source = if prop.lastActor
			and os.clock() - prop.lastActorTime < Config.Economy.ChaosAttributionWindow
		then prop.lastActor
		else nil
	self:Despawn(prop)
	if self.S.EffectsService then
		self.S.EffectsService:Explosion(
			lab,
			position,
			prop.blastRadius or 16,
			prop.blastPower or 1,
			{ source = source, color = Color3.fromRGB(255, 140, 50) }
		)
	end
end

function PropService:Update(lab, dt: number, labDt: number)
	if lab.paused then
		return
	end
	local ts = math.max(lab.timeScale, 0.05)
	for _, prop in table.clone(lab.props) do
		if prop.dead or prop.static then
			continue
		end
		local root = prop.root
		if not root.Parent then
			self:Despawn(prop)
			continue
		end
		-- Explosives react to hard knocks.
		if prop.explosive and not root.Anchored then
			local v = root.AssemblyLinearVelocity
			if prop.prevVel then
				local dv = (v - prop.prevVel).Magnitude / ts
				if dv > 75 then
					self:Ignite(prop, prop.lastActor)
				end
			end
			prop.prevVel = v
		end
		if prop.fuse then
			prop.fuse -= labDt
			local light = root:FindFirstChild("FuseLight")
			if light then
				light.Enabled = math.floor(prop.fuse * 8) % 2 == 0
			end
			if prop.fuse <= 0 then
				self:Explode(prop)
				continue
			end
		end
		-- Out of bounds cleanup.
		local p = root.Position - lab.origin
		if p ~= p or p.X < lab.minX - 30 or p.X > lab.maxX + 30 or p.Y < -40 or p.Y > lab.map.height + 40 then
			self:Despawn(prop)
		end
	end
end

-- Props within a radius (used by explosions, black holes, magnets...).
function PropService:InRadius(lab, position: Vector3, radius: number)
	local list = {}
	for _, prop in lab.props do
		if not prop.dead and not prop.static and prop.root.Parent then
			if (prop.root.Position - position).Magnitude <= radius then
				table.insert(list, prop)
			end
		end
	end
	return list
end

return PropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Monetization and rewards: game passes, developer products (idempotent receipts), codes,
-- Mystery Flask spins, daily login streak, the free ingredient rack, skins and the shop.
-- Also the central place for player notifications, badges and codex milestones.

local BadgeService = game:GetService("BadgeService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Ingredients = require(Shared.Data.Ingredients)
local Potions = require(Shared.Data.Potions)
local Skins = require(Shared.Data.Skins)
local Spins = require(Shared.Data.Spins)

local Codes = require(script.Parent.Parent.Data.Codes)
local World = require(script.Parent.Parent.Systems.World)

local ShopService = {}

-- Mystery Flask prizes live in shared data so the client reel matches the server roll.
local SPIN_TABLE = Spins.List
ShopService.SpinTable = SPIN_TABLE

local function today(): number
	return math.floor(os.time() / 86400)
end

function ShopService:Init(services)
	self.S = services
	self._passes = {}
	self._lastAction = {}
end

function ShopService:Start()
	MarketplaceService.ProcessReceipt = function(receipt)
		return self:_processReceipt(receipt)
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			for key, id in Config.GamePasses do
				if id == passId then
					self._passes[player] = self._passes[player] or {}
					self._passes[player][key] = true
					self:_applyPassPerks(player, key)
					self:Notify(player, "toast", { text = "Thanks for supporting the lab! 💜", kind = "reward" })
				end
			end
		end
	end)
	self.S.DataService.ProfileLoaded:Connect(function(player, data)
		task.spawn(function()
			self:_checkPasses(player)
			self:_updateRack(player, data)
			self:_checkBadges(player, data)
			self:_award(player, Config.BadgeIds.Welcome)
			local streakReady = data.streak.day ~= today()
			self:Notify(player, "welcome", { streakReady = streakReady, temporary = data._temporary == true })
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self._passes[player] = nil
		self._lastAction[player] = nil
	end)
	Net.func("Shop").OnServerInvoke = function(player, action, a, b)
		local now = os.clock()
		if now - (self._lastAction[player] or 0) < 0.15 then
			return { ok = false, reason = "Slow down!" }
		end
		self._lastAction[player] = now
		local ok, result = pcall(self._handle, self, player, action, a, b)
		if not ok then
			warn("[ShopService] action failed", action, result)
			return { ok = false, reason = "Something went wrong." }
		end
		return result
	end
	Net.event("Settings").OnServerEvent:Connect(function(player, key, value)
		self:_setting(player, key, value)
	end)
	-- Ingredient rack regrowth tick.
	task.spawn(function()
		while true do
			task.wait(20)
			for _, player in Players:GetPlayers() do
				local data = self.S.DataService:Get(player)
				if data and self:_updateRack(player, data) then
					self.S.DataService:Replicate(player, "rack")
				end
			end
		end
	end)
end

-- ─────────────────────────────── notifications & badges ───────────────────────────────

function ShopService:Notify(player: Player, kind: string, payload)
	if player and player.Parent then
		Net.event("Notify"):FireClient(player, kind, payload or {})
	end
end

function ShopService:_award(player: Player, badgeId: number)
	if not badgeId or badgeId == 0 then
		return
	end
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, badgeId)
		if ok and not has then
			pcall(BadgeService.AwardBadge, BadgeService, player.UserId, badgeId)
		end
	end)
end

function ShopService:_checkBadges(player: Player, data)
	local discovered, total = 0, 0
	for _, potion in Potions.List do
		if #potion.recipe >= 2 then
			total += 1
			if data.discovered[potion.id] then
				discovered += 1
			end
		end
	end
	if discovered >= 1 then
		self:_award(player, Config.BadgeIds.FirstDiscovery)
	end
	if discovered >= total / 2 then
		self:_award(player, Config.BadgeIds.HalfCodex)
	end
	if discovered >= total then
		self:_award(player, Config.BadgeIds.FullCodex)
	end
	return discovered, total
end

function ShopService:OnDiscovery(player: Player, potionId: string)
	local data = self.S.DataService:Get(player)
	if not data then
		return
	end
	local discovered, total = self:_checkBadges(player, data)
	self:Notify(player, "discover", { id = potionId, count = discovered, total = total })
	if discovered == total - 1 and not data.discovered[Potions.FinalId] then
		self:Notify(
			player,
			"toast",
			{ text = "Only the Philosopher's Elixir remains... clear the Magnum Opus trial!", kind = "reward" }
		)
	end
end

function ShopService:DiscoverReaction(player: Player, reactionId: string)
	local data = self.S.DataService:Get(player)
	if not data or data.reactions[reactionId] then
		return
	end
	data.reactions[reactionId] = true
	data.stats.reactions += 1
	self.S.DataService:Replicate(player, "reactions", "stats")
	self.S.EconomyService:AddXp(player, 80)
	self:Notify(player, "reactionDiscovered", { id = reactionId })
end

function ShopService:OnAscension(player: Player)
	local data = self.S.DataService:Get(player)
	if not data then
		return
	end
	if not data.skins.ascended then
		data.skins.ascended = true
		data.title = "Grand Alchemist"
		self.S.DataService:Replicate(player, "skins", "title")
		self:_award(player, Config.BadgeIds.GrandAlchemist)
		self:Notify(player, "ascended", {})
	end
end

-- ─────────────────────────────── passes & products ───────────────────────────────

function ShopService:HasPass(player: Player, key: string): boolean
	local cache = self._passes[player]
	return cache ~= nil and cache[key] == true
end

function ShopService:_checkPasses(player: Player)
	self._passes[player] = self._passes[player] or {}
	for key, id in Config.GamePasses do
		if id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				self._passes[player][key] = true
				self:_applyPassPerks(player, key)
			end
		end
	end
	self:Notify(player, "passes", self._passes[player])
end

function ShopService:_applyPassPerks(player: Player, key: string)
	local data = self.S.DataService:Get(player)
	if not data then
		return
	end
	if key == "VIP" and not data.skins.gold then
		data.skins.gold = true
		self.S.DataService:Replicate(player, "skins")
	elseif key == "LabExpansion" then
		local lab = World.ownerLab[player]
		if lab then
			lab.maxGolems = Config.MaxGolemsExpanded
			self.S.LabService:BroadcastState(lab)
		end
	end
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	self:Notify(player, "passes", self._passes[player])
end

function ShopService:_processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = self.S.DataService:WaitFor(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if self.S.DataService:HasReceipt(player, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local reward = Config.Products[receipt.ProductId]
	if not reward then
		warn("[ShopService] unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if reward.coins then
		data.coins += reward.coins
	end
	if reward.spins then
		data.spins += reward.spins
	end
	self.S.DataService:AddReceipt(player, purchaseId)
	-- Persist before acknowledging so a crash can never lose a paid reward.
	if not self.S.DataService:SaveNow(player) and not self.S.DataService._memoryOnly then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	self.S.DataService:Replicate(player, "coins", "spins")
	self.S.EconomyService:_syncLeaderstats(player, data)
	self:Notify(player, "toast", { text = "Purchase complete! Thank you 💜", kind = "reward" })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ─────────────────────────────── rack & streak ───────────────────────────────

local COMMON_IDS = { "ember_root", "frost_lotus", "gale_feather", "slime_gel", "moon_dew" }

-- Regrows rack stock over real time. Returns true when stock changed.
function ShopService:_updateRack(player: Player, data): boolean
	local rack = data.rack
	local now = os.time()
	if rack.last == 0 then
		rack.last = now
		return false
	end
	local cap = Config.Economy.RackCapacity
	if rack.stock >= cap then
		rack.last = now
		return false
	end
	local grown = (now - rack.last) // Config.Economy.RackRegrowSeconds
	if grown <= 0 then
		return false
	end
	rack.stock = math.min(cap, rack.stock + grown)
	rack.last += grown * Config.Economy.RackRegrowSeconds
	local lab = World.ownerLab[player]
	if lab then
		self.S.LabService:RefreshRack(lab)
	end
	return true
end

local function grantIngredients(data, bundle: { [string]: number })
	for id, amount in bundle do
		data.ingredients[id] = (data.ingredients[id] or 0) + amount
	end
end

local function randomOfRarity(rarity: string, level: number): string?
	local pool = {}
	for _, ingredient in Ingredients.List do
		if
			ingredient.rarity == rarity
			and ingredient.price > 0
			and ingredient.unlockLevel <= math.max(level, 1) + 4
		then
			table.insert(pool, ingredient.id)
		end
	end
	if #pool == 0 then
		for _, ingredient in Ingredients.List do
			if ingredient.rarity == rarity and ingredient.price > 0 then
				table.insert(pool, ingredient.id)
			end
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(1, #pool)]
end

-- ─────────────────────────────── actions ───────────────────────────────

function ShopService:_handle(player: Player, action: any, a: any, b: any)
	local data = self.S.DataService:Get(player)
	if not data then
		return { ok = false, reason = "Loading..." }
	end
	local DS, Econ = self.S.DataService, self.S.EconomyService

	if action == "buyIngredient" then
		local ingredient = typeof(a) == "string" and Ingredients.ById[a]
		local qty = if typeof(b) == "number" then math.clamp(math.floor(b), 1, 25) else 1
		if not ingredient or ingredient.price <= 0 then
			return { ok = false, reason = "Not for sale." }
		end
		if data.level < ingredient.unlockLevel then
			return { ok = false, reason = ("Unlocks at level %d"):format(ingredient.unlockLevel) }
		end
		local cost = ingredient.price * qty
		if not Econ:SpendCoins(player, cost) then
			return { ok = false, reason = "Not enough coins." }
		end
		data.ingredients[ingredient.id] = (data.ingredients[ingredient.id] or 0) + qty
		DS:Replicate(player, "ingredients")
		return { ok = true }
	elseif action == "buySkin" then
		local skin = typeof(a) == "string" and Skins.ById[a]
		if not skin or skin.source ~= "shop" or not skin.price then
			return { ok = false, reason = "Not for sale." }
		end
		if data.skins[skin.id] then
			return { ok = false, reason = "Already owned." }
		end
		if not Econ:SpendCoins(player, skin.price) then
			return { ok = false, reason = "Not enough coins." }
		end
		data.skins[skin.id] = true
		data.equippedSkin = skin.id
		DS:Replicate(player, "skins", "equippedSkin")
		return { ok = true }
	elseif action == "equipSkin" then
		if typeof(a) ~= "string" or not data.skins[a] or not Skins.ById[a] then
			return { ok = false, reason = "Locked." }
		end
		data.equippedSkin = a
		DS:Replicate(player, "equippedSkin")
		local lab = World.ownerLab[player]
		if lab then
			lab.lastSpawn = { kind = "golem", id = a }
		end
		return { ok = true }
	elseif action == "redeemCode" then
		if typeof(a) ~= "string" or #a > 32 then
			return { ok = false, reason = "Invalid code." }
		end
		local code = a:upper():gsub("%s", "")
		local reward = Codes[code]
		if not reward or (reward.expires and os.time() > reward.expires) then
			return { ok = false, reason = "That code doesn't exist (or expired)." }
		end
		if data.codes[code] then
			return { ok = false, reason = "Already redeemed!" }
		end
		data.codes[code] = os.time()
		if reward.coins then
			data.coins += reward.coins
		end
		if reward.spins then
			data.spins += reward.spins
		end
		if reward.ingredients then
			grantIngredients(data, reward.ingredients)
		end
		if reward.skin then
			data.skins[reward.skin] = true
		end
		DS:Replicate(player, "coins", "spins", "ingredients", "skins", "codes")
		Econ:_syncLeaderstats(player, data)
		return { ok = true, reward = reward }
	elseif action == "spin" then
		if data.spins <= 0 then
			return { ok = false, reason = "No Mystery Flasks left." }
		end
		data.spins -= 1
		local total = 0
		for _, entry in SPIN_TABLE do
			total += entry.weight
		end
		local roll = math.random() * total
		local index = #SPIN_TABLE
		for i, entry in SPIN_TABLE do
			roll -= entry.weight
			if roll <= 0 then
				index = i
				break
			end
		end
		local entry = SPIN_TABLE[index]
		local granted = { label = entry.label, icon = entry.icon, items = {} }
		if entry.kind == "coins" then
			data.coins += entry.amount
		elseif entry.kind == "bundle" then
			for _ = 1, 3 do
				local id = randomOfRarity(entry.rarity, data.level)
				if id then
					data.ingredients[id] = (data.ingredients[id] or 0) + entry.amount
					granted.items[id] = (granted.items[id] or 0) + entry.amount
				end
			end
		elseif entry.kind == "ingredient" then
			data.ingredients[entry.id] = (data.ingredients[entry.id] or 0) + entry.amount
			granted.items[entry.id] = entry.amount
		elseif entry.kind == "potions" then
			local pool = {}
			for id in data.discovered do
				if Potions.ById[id] and id ~= Potions.FinalId then
					table.insert(pool, id)
				end
			end
			if #pool == 0 then
				pool = { "inferno_brew", "frost_tonic", "bouncy_goo" }
			end
			for _ = 1, entry.amount do
				local id = pool[math.random(1, #pool)]
				data.potions[id] = (data.potions[id] or 0) + 1
			end
		elseif entry.kind == "skin" then
			if data.skins[entry.id] then
				data.coins += 500
				granted.duplicate = true
			else
				data.skins[entry.id] = true
			end
		end
		DS:Replicate(player, "coins", "spins", "ingredients", "potions", "skins")
		Econ:_syncLeaderstats(player, data)
		return { ok = true, index = index, prize = granted }
	elseif action == "claimDaily" then
		local day = today()
		if data.streak.day == day then
			return { ok = false, reason = "Come back tomorrow!" }
		end
		data.streak.count = if data.streak.day == day - 1 then data.streak.count + 1 else 1
		data.streak.day = day
		local reward = Config.DailyStreakRewards[(data.streak.count - 1) % #Config.DailyStreakRewards + 1]
		if reward.coins then
			data.coins += reward.coins
		end
		if reward.spins then
			data.spins += reward.spins
		end
		if reward.ingredients then
			grantIngredients(data, reward.ingredients)
		end
		DS:Replicate(player, "coins", "spins", "ingredients", "streak")
		Econ:_syncLeaderstats(player, data)
		return { ok = true, day = data.streak.count, reward = reward }
	elseif action == "claimRack" then
		local lab = World.viewLab[player]
		if lab and lab.owner ~= player then
			return { ok = false, reason = "That's " .. lab.owner.DisplayName .. "'s herb rack!" }
		end
		self:_updateRack(player, data)
		local stock = data.rack.stock
		if stock <= 0 then
			local wait = Config.Economy.RackRegrowSeconds - (os.time() - data.rack.last)
			return { ok = false, reason = ("Herbs regrow in %ds"):format(math.max(1, wait)) }
		end
		local got = {}
		for _ = 1, stock do
			local id = COMMON_IDS[math.random(1, #COMMON_IDS)]
			data.ingredients[id] = (data.ingredients[id] or 0) + 1
			got[id] = (got[id] or 0) + 1
		end
		data.rack.stock = 0
		data.rack.last = os.time()
		DS:Replicate(player, "ingredients", "rack")
		if World.ownerLab[player] then
			self.S.LabService:RefreshRack(World.ownerLab[player])
		end
		return { ok = true, items = got }
	end
	return { ok = false, reason = "Unknown action." }
end

function ShopService:_setting(player: Player, key: any, value: any)
	local data = self.S.DataService:Get(player)
	if not data or typeof(key) ~= "string" then
		return
	end
	local settings = data.settings
	if (key == "sfx" or key == "music" or key == "shake") and typeof(value) == "number" then
		settings[key] = math.clamp(value, 0, 1)
	elseif key == "quality" and (value == "high" or value == "low") then
		settings.quality = value
	elseif key == "tutorial" and typeof(value) == "number" then
		settings.tutorial = math.clamp(math.floor(value), 0, 99)
	else
		return
	end
	self.S.DataService:Replicate(player, "settings")
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">TrialService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Trials: handcrafted objective levels played inside the owner's lab. A trial sets up the room,
-- provides free potions, tracks one objective and awards 1-3 stars based on lab-time.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Challenges = require(Shared.Data.Challenges)

local Systems = script.Parent.Parent.Systems
local World = require(Systems.World)

local TrialService = {}

function TrialService:Init(services)
	self.S = services
end

function TrialService:Start()
	Net.func("TrialRequest").OnServerInvoke = function(player, action, trialId)
		if action == "start" and typeof(trialId) == "string" then
			return self:Begin(player, trialId)
		elseif action == "quit" then
			local lab = World.ownerLab[player]
			if lab and lab.trial then
				self:Abort(lab, "quit")
				self.S.LabService:Reset(lab)
			end
			return { ok = true }
		end
		return { ok = false }
	end
end

function TrialService:TotalStars(data): number
	local total = 0
	for _, record in data.trials do
		total += record.stars or 0
	end
	return total
end

function TrialService:CanStart(player: Player, trial): (boolean, string?)
	local data = self.S.DataService:Get(player)
	if not data then
		return false, "Loading..."
	end
	-- Trials unlock in order.
	for _, other in Challenges.Trials do
		if other.order < trial.order and not data.trials[other.id] then
			return false, "Clear " .. other.name .. " first."
		end
	end
	if trial.requiresStars and self:TotalStars(data) < trial.requiresStars then
		return false, ("Needs %d ★"):format(trial.requiresStars)
	end
	return true
end

local function zoneVisual(lab, zone)
	local model = Instance.new("Model")
	model.Name = "TrialZone_" .. zone.id
	local center = lab.origin + Vector3.new(zone.x, zone.y, 0)
	local function part(props)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		for key, value in props do
			(p :: any)[key] = value
		end
		p.Parent = model
		return p
	end
	if zone.visual == "basket" then
		local wicker = Color3.fromRGB(190, 140, 80)
		part({
			Size = Vector3.new(zone.w, 0.6, 6),
			CFrame = CFrame.new(center + Vector3.new(0, -zone.h / 2, 0)),
			Color = wicker,
			Material = Enum.Material.Fabric,
			CanCollide = true,
			CollisionGroup = "Static",
		})
		for _, side in { -1, 1 } do
			part({
				Size = Vector3.new(0.6, zone.h, 6),
				CFrame = CFrame.new(center + Vector3.new(side * zone.w / 2, 0, 0)),
				Color = wicker,
				Material = Enum.Material.Fabric,
				CanCollide = true,
				CollisionGroup = "Static",
			})
		end
		part({
			Size = Vector3.new(zone.w, zone.h, 0.2),
			CFrame = CFrame.new(center + Vector3.new(0, 0, -3)),
			Color = Color3.fromRGB(150, 100, 60),
			Material = Enum.Material.Fabric,
		})
	elseif zone.visual == "ring" then
		local ring = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, zone.w, zone.w),
			CFrame = CFrame.new(center) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(255, 210, 60),
			Material = Enum.Material.Neon,
			Transparency = 0.1,
		})
		part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.7, zone.w - 1.4, zone.w - 1.4),
			CFrame = CFrame.new(center) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(40, 30, 60),
			Material = Enum.Material.Glass,
			Transparency = 0.8,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 220, 120)
		light.Range = 14
		light.Parent = ring
	elseif zone.visual == "target" then
		local colors = {
			Color3.fromRGB(255, 255, 255),
			Color3.fromRGB(230, 50, 50),
			Color3.fromRGB(255, 255, 255),
			Color3.fromRGB(230, 50, 50),
		}
		for i, color in colors do
			local d = zone.h * (1 - (i - 1) * 0.22)
			part({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3 + i * 0.05, d, d),
				CFrame = CFrame.new(center + Vector3.new(0, 0, -2 + i * 0.05)) * CFrame.Angles(0, math.rad(90), 0),
				Color = color,
				Material = Enum.Material.SmoothPlastic,
			})
		end
	end
	local glow = part({ Size = Vector3.new(zone.w, zone.h, 1), CFrame = CFrame.new(center), Transparency = 1 })
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Rate = 6
	sparkle.Lifetime = NumberRange.new(1, 1.6)
	sparkle.Speed = NumberRange.new(0.5, 1.5)
	sparkle.Size = NumberSequence.new(0.5, 0)
	sparkle.LightEmission = 1
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 230, 140))
	sparkle.Parent = glow
	model.Parent = lab.effects
	return model
end

function TrialService:Begin(player: Player, trialId: string)
	local trial = Challenges.TrialsById[trialId]
	local lab = World.ownerLab[player]
	if not trial or not lab then
		return { ok = false, reason = "Unknown trial" }
	end
	local ok, reason = self:CanStart(player, trial)
	if not ok then
		return { ok = false, reason = reason }
	end
	if World.viewLab[player] ~= lab then
		self.S.LabService:GoHome(player)
	end
	if lab.trial then
		self:Abort(lab, "restart")
	end
	local LabService = self.S.LabService
	LabService:SetPaused(lab, false)
	LabService:SetTimeScale(lab, 1)
	if lab.mapId ~= trial.map then
		LabService:SetMap(lab, trial.map, { fromTrial = true, noGolem = true })
	else
		LabService:ClearDynamic(lab)
	end
	local data = self.S.DataService:Get(player)
	for _, spec in trial.golems do
		self.S.GolemService:Spawn(lab, spec.skin or (data and data.equippedSkin), Vector3.new(spec.x, spec.y or 0, 0))
	end
	for _, spec in trial.props do
		self.S.PropService:Spawn(lab, spec.id, Vector3.new(spec.x, spec.y or 0, 0))
	end
	local zones = {}
	for _, zone in trial.zones do
		table.insert(zones, { def = zone, model = zoneVisual(lab, zone) })
	end
	lab.trial = {
		id = trial.id,
		def = trial,
		potions = table.clone(trial.potions),
		startClock = lab.clock,
		progress = 0,
		uniques = {},
		zones = zones,
		zoneTimer = 0,
		ended = false,
	}
	self:_send(lab, "start", {
		id = trial.id,
		name = trial.name,
		icon = trial.icon,
		text = trial.objective.text,
		target = trial.objective.target,
		timeLimit = trial.timeLimit,
		stars = trial.stars,
		potions = self:_potionList(lab),
	})
	LabService:BroadcastState(lab)
	return { ok = true }
end

function TrialService:_potionList(lab)
	local list = {}
	for id, count in lab.trial.potions do
		table.insert(list, { id = id, count = if count == math.huge then -1 else count })
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

function TrialService:SendPotions(lab)
	if lab.trial then
		self:_send(lab, "potions", { potions = self:_potionList(lab) })
	end
end

function TrialService:_send(lab, phase: string, payload)
	local remote = Net.event("Trial")
	for _, viewer in World.viewers(lab) do
		remote:FireClient(viewer, phase, payload)
	end
end

function TrialService:Restart(lab)
	if lab.trial then
		local id = lab.trial.id
		self:Abort(lab, "restart")
		self:Begin(lab.owner, id)
	end
end

function TrialService:Abort(lab, reason: string)
	local trial = lab.trial
	if not trial then
		return
	end
	lab.trial = nil
	for _, zone in trial.zones do
		zone.model:Destroy()
	end
	self:_send(lab, "end", { id = trial.id, success = false, aborted = true, reason = reason })
	self.S.LabService:BroadcastState(lab)
end

-- Gameplay events forwarded by ChallengeService.
function TrialService:Event(player: Player, event: string, value: number, extra)
	local lab = World.ownerLab[player]
	local trial = lab and lab.trial
	if not trial or trial.ended then
		return
	end
	local objective = trial.def.objective
	if objective.event ~= event then
		return
	end
	if objective.filter and objective.filter ~= (extra.status or extra.zone) then
		return
	end
	if objective.unique then
		local key = extra.golem
		if key == nil or trial.uniques[key] then
			return
		end
		trial.uniques[key] = true
		trial.progress += 1
	elseif objective.mode == "max" then
		trial.progress = math.max(trial.progress, math.floor(value))
	else
		trial.progress += value
	end
	self:_send(lab, "progress", { progress = math.min(trial.progress, objective.target), target = objective.target })
	if trial.progress >= objective.target then
		self:_complete(lab)
	end
end

function TrialService:_complete(lab)
	local trial = lab.trial
	if not trial or trial.ended then
		return
	end
	trial.ended = true
	local player = lab.owner
	local def = trial.def
	local elapsed = lab.clock - trial.startClock
	local stars = Challenges.starsFor(def, elapsed)
	local data = self.S.DataService:Get(player)
	local rewards = { coins = 0, xp = 0, ingredients = {}, skin = nil }
	local firstClear = false
	local newBest = false
	if data then
		local record = data.trials[def.id]
		local previousStars = if record then record.stars else 0
		firstClear = record == nil
		if not record or elapsed < record.best then
			newBest = true
		end
		data.trials[def.id] = {
			stars = math.max(previousStars, stars),
			best = if record then math.min(record.best, elapsed) else elapsed,
		}
		if firstClear then
			rewards.coins = def.reward.coins
			rewards.xp = def.reward.xp
			for id, amount in def.reward.ingredients or {} do
				data.ingredients[id] = (data.ingredients[id] or 0) + amount
				rewards.ingredients[id] = amount
			end
			if def.reward.skin then
				data.skins[def.reward.skin] = true
				rewards.skin = def.reward.skin
			end
		elseif stars > previousStars then
			rewards.coins = 60 * (stars - previousStars)
			rewards.xp = 40 * (stars - previousStars)
		end
		if rewards.coins > 0 then
			self.S.EconomyService:AddCoins(player, rewards.coins, "trial")
		end
		if rewards.xp > 0 then
			self.S.EconomyService:AddXp(player, rewards.xp)
		end
		self.S.DataService:Replicate(player, "trials", "ingredients", "skins")
	end
	for _, zone in trial.zones do
		zone.model:Destroy()
	end
	lab.trial = nil
	self:_send(lab, "end", {
		id = def.id,
		success = true,
		stars = stars,
		time = elapsed,
		firstClear = firstClear,
		newBest = newBest,
		rewards = rewards,
		final = def.final == true,
	})
	self.S.LabService:FX(lab, "confetti", { p = lab.origin + Vector3.new(0, lab.map.height * 0.6, 0) })
	self.S.LabService:BroadcastState(lab)
end

function TrialService:_fail(lab)
	local trial = lab.trial
	if not trial then
		return
	end
	trial.ended = true
	for _, zone in trial.zones do
		zone.model:Destroy()
	end
	lab.trial = nil
	self:_send(lab, "end", { id = trial.id, success = false, timeout = true })
	self.S.LabService:BroadcastState(lab)
end

function TrialService:Update(lab, _dt: number, labDt: number)
	local trial = lab.trial
	if not trial or trial.ended then
		return
	end
	local elapsed = lab.clock - trial.startClock
	if elapsed > trial.def.timeLimit then
		self:_fail(lab)
		return
	end
	if labDt <= 0 or #trial.zones == 0 then
		return
	end
	trial.zoneTimer -= labDt
	if trial.zoneTimer > 0 then
		return
	end
	trial.zoneTimer = 0.1
	for _, zone in trial.zones do
		local def = zone.def
		local center = lab.origin + Vector3.new(def.x, def.y, 0)
		for _, golem in lab.golems do
			local torso = golem.byName.Torso
			if torso and not golem.grabbedBy then
				local offset = torso.Position - center
				if math.abs(offset.X) < def.w / 2 and math.abs(offset.Y) < def.h / 2 then
					self:Event(lab.owner, "zone", 1, { zone = def.id, golem = golem.id })
					if not lab.trial then
						return
					end
				end
			end
		end
	end
end

return TrialService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="Folder" referent="55">
          <Properties>
            <string name="Name">Effects</string>
          </Properties>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Fields</string>
              <string name="Source"><![CDATA[--!nonstrict
-- World "field" effects spawned at a splash point: steam blasts, explosions, black holes, stasis
-- bubbles, meteor showers, tornadoes, supernovas, stink clouds and the Chaos Potion.
-- Signature: Fields[effect](E, lab, center, potion, ctx, duration, radiusOverride?)

local Workspace = game:GetService("Workspace")

local World = require(script.Parent.Parent.World)

local Fields = {}

local function rand(a: number, b: number): number
	return a + math.random() * (b - a)
end

local function objectsInRadius(E, lab, position: Vector3, radius: number)
	local list = {}
	for _, golem in E.S.GolemService:InRadius(lab, position, radius) do
		table.insert(list, golem)
	end
	if E.S.PropService then
		for _, prop in E.S.PropService:InRadius(lab, position, radius) do
			table.insert(list, prop)
		end
	end
	return list
end

local function rootPosition(object): Vector3?
	if object.kind == "golem" then
		local torso = object.byName.Torso
		return torso and torso.Position
	end
	return object.root and object.root.Position
end

-- ── Steam: radial push that leaves everything wet ──
function Fields.steam(E, lab, center: Vector3, _potion, ctx, _duration, radiusOverride: number?)
	local radius = radiusOverride or (_potion and _potion.radius) or 15
	local source = ctx and ctx.source
	E.S.LabService:FX(lab, "steam", { p = center, r = radius })
	for _, object in objectsInRadius(E, lab, center, radius) do
		local position = rootPosition(object)
		if position then
			local offset = position - center
			local d = offset.Magnitude
			local falloff = math.clamp(1 - d / radius, 0.2, 1)
			local dir = if d > 0.1 then offset.Unit else Vector3.yAxis
			dir = (Vector3.new(dir.X, dir.Y, 0) + Vector3.new(0, 0.5, 0)).Unit
			E:Kick(object, dir * 85 * falloff * lab.timeScale)
			if object.kind == "golem" then
				E.S.GolemService:Stun(object, 1.5)
				E.S.GolemService:Damage(object, 10 * falloff, { source = source, position = position, kind = "steam" })
				E:ApplyStatus(object, "wet", { duration = 6, source = source })
			end
		end
	end
end

-- ── Explosion ──
function Fields.explosion(E, lab, center: Vector3, potion, ctx)
	local potency = ctx.potency or 1
	E:Explosion(lab, center, potion.radius * math.sqrt(potency), potency, { source = ctx.source })
end

-- ── Stink cloud ──
function Fields.sludge(E, lab, center: Vector3, potion, ctx, duration: number)
	local radius = potion.radius
	E.S.LabService:FX(lab, "stink", { p = center, r = radius, d = duration })
	E:AddField(lab, {
		kind = "stink",
		position = center,
		radius = radius,
		remaining = duration,
		timer = 0,
		tick = function(_E, _lab, field, _dt, labDt)
			field.timer -= labDt
			if field.timer > 0 then
				return
			end
			field.timer = 0.5
			for _, golem in E.S.GolemService:InRadius(lab, field.position, field.radius) do
				E:ApplyStatus(golem, "stinky", { duration = 4, source = ctx.source })
			end
		end,
	})
end

-- ── Black hole ──
function Fields.blackhole(E, lab, center: Vector3, potion, ctx, duration: number)
	local radius = potion.radius
	local id = World.nextId()
	E.S.LabService:FX(lab, "blackhole", { id = id, p = center, r = radius, d = duration })
	E:AddField(lab, {
		kind = "blackhole",
		id = id,
		position = center,
		radius = radius,
		remaining = duration,
		tick = function(_E, _lab, field, _dt, labDt)
			local strength = 230 * math.min(1, field.age / 0.8 + 0.25)
			for _, object in objectsInRadius(E, lab, field.position, field.radius) do
				local position = rootPosition(object)
				if position then
					local offset = field.position - position
					local d = offset.Magnitude
					if d > 0.5 then
						local falloff = 1 - d / field.radius
						local tangent = Vector3.new(-offset.Y, offset.X, 0).Unit
						local pull = offset.Unit * strength * (falloff + 0.35) + tangent * 60 * falloff
						-- Damp existing speed near the core so things orbit instead of slingshotting.
						E:Pull(object, pull * labDt)
					end
					if object.kind == "golem" then
						E.S.GolemService:Stun(object, 1)
						if d < 5 then
							field.dmg = (field.dmg or 0) + 14 * labDt
							if field.dmg >= 4 then
								E.S.GolemService:Damage(
									object,
									field.dmg,
									{ source = ctx.source, position = position, kind = "void" }
								)
								field.dmg = 0
							end
						end
					end
				end
			end
		end,
		finish = function(_E, _lab, field, aborted)
			E.S.LabService:FX(lab, "blackholeend", { id = field.id, p = field.position })
			if not aborted then
				E:Explosion(
					lab,
					field.position,
					field.radius * 0.55,
					0.9,
					{ source = ctx.source, color = Color3.fromRGB(170, 90, 255) }
				)
			end
		end,
	})
end

-- ── Stasis bubble: time stops inside ──
function Fields.stasis(E, lab, center: Vector3, potion, ctx, duration: number)
	local radius = potion.radius
	E.S.LabService:FX(lab, "stasis", { p = center, r = radius, d = duration })
	local frozen = {}
	local objects = objectsInRadius(E, lab, center, radius)
	for _, object in objects do
		E.S.GrabService:Claim(object)
		object.inStasis = true
		for _, part in object.parts do
			if part.Parent and not part.Anchored then
				frozen[part] = { v = part.AssemblyLinearVelocity, w = part.AssemblyAngularVelocity }
				part.Anchored = true
			end
		end
		if object.kind == "golem" then
			E:ApplyStatus(object, "stasis", { duration = duration, source = ctx.source })
		end
	end
	E:AddField(lab, {
		kind = "stasis",
		position = center,
		radius = radius,
		remaining = duration,
		finish = function()
			for _, object in objects do
				object.inStasis = nil
			end
			local released = {}
			for part, record in frozen do
				if part.Parent then
					if lab.paused then
						lab.frozenParts = lab.frozenParts or {}
						lab.frozenParts[part] = record
					else
						part.Anchored = false
						table.insert(released, { part, record })
					end
				end
			end
			for _, entry in released do
				entry[1].AssemblyLinearVelocity = entry[2].v
				entry[1].AssemblyAngularVelocity = entry[2].w
			end
			for _, object in objects do
				if object.kind == "golem" and not object.dead then
					E.S.GolemService:ResetMotionHistory(object, 0.3)
				end
			end
			E.S.LabService:FX(lab, "stasisend", { p = center, r = radius })
		end,
	})
end

-- ── Meteor shower ──
function Fields.meteors(E, lab, center: Vector3, potion, ctx, duration: number)
	local spread = potion.radius
	local count = 7
	E.S.LabService:FX(lab, "meteorcall", { p = center })
	local field
	field = E:AddField(lab, {
		kind = "meteors",
		position = center,
		remaining = duration + 3,
		spawned = 0,
		next = 0.15,
		meteors = {},
		tick = function(_E, _lab, f, _dt, labDt)
			if f.spawned < count and f.age >= f.next then
				f.spawned += 1
				f.next = f.age + duration / count
				local top = lab.origin.Y + lab.map.height - 2
				local startX = math.clamp(
					center.X + rand(-spread / 2, spread / 2) - 14,
					lab.origin.X + lab.minX + 2,
					lab.origin.X + lab.maxX - 2
				)
				local meteor = {
					id = World.nextId(),
					position = Vector3.new(startX, top, lab.origin.Z),
					velocity = Vector3.new(rand(18, 34), -rand(95, 120), 0),
				}
				table.insert(f.meteors, meteor)
				E.S.LabService:FX(lab, "meteor", { id = meteor.id, p = meteor.position, v = meteor.velocity })
			end
			for i = #f.meteors, 1, -1 do
				local m = f.meteors[i]
				local step = m.velocity * labDt
				local hit = Workspace:Raycast(m.position, step, lab.worldRayParams)
				if hit or m.position.Y < lab.origin.Y - 10 then
					local at = if hit then hit.Position else m.position
					table.remove(f.meteors, i)
					E.S.LabService:FX(lab, "meteorhit", { id = m.id, p = at })
					E:Explosion(lab, at, 10, 0.8, { source = ctx.source, color = Color3.fromRGB(255, 120, 40) })
				else
					m.position += step
				end
			end
			if f.spawned >= count and #f.meteors == 0 then
				f.remaining = 0
			end
		end,
	})
	local _ = field
end

-- ── Tornado ──
function Fields.tornado(E, lab, center: Vector3, potion, ctx, duration: number)
	local id = World.nextId()
	local floorY = lab.origin.Y
	local height = math.min(lab.map.height - 2, 60)
	E.S.LabService:FX(
		lab,
		"tornado",
		{ id = id, p = Vector3.new(center.X, floorY, center.Z), d = duration, h = height }
	)
	E:AddField(lab, {
		kind = "tornado",
		id = id,
		x = center.X,
		targetX = center.X,
		remaining = duration,
		send = 0,
		tick = function(_E, _lab, field, _dt, labDt)
			if math.abs(field.x - field.targetX) < 2 then
				field.targetX =
					math.clamp(field.x + rand(-26, 26), lab.origin.X + lab.minX + 8, lab.origin.X + lab.maxX - 8)
			end
			field.x += math.sign(field.targetX - field.x) * 10 * labDt
			local halfWidth = potion.radius * 0.6
			for _, object in objectsInRadius(E, lab, Vector3.new(field.x, floorY + height / 2, center.Z), height) do
				local position = rootPosition(object)
				if position then
					local dx = position.X - field.x
					local dy = position.Y - floorY
					if math.abs(dx) < halfWidth and dy < height then
						local lift = if dy < height * 0.85 then 230 else -60
						local swirl = math.sin(field.age * 7 + dy * 0.3) * 130
						local center = -dx * 9
						E:Pull(object, Vector3.new(swirl + center, lift, 0) * labDt)
						if object.kind == "golem" then
							E.S.GolemService:Stun(object, 1.2)
							local torso = object.byName.Torso
							if torso and not torso.Anchored and not object.grabbedBy then
								torso.AssemblyAngularVelocity = Vector3.new(0, 0, 9)
							end
						end
					end
				end
			end
			field.send -= labDt
			if field.send <= 0 then
				field.send = 0.12
				E.S.LabService:FXU(lab, "tornadomove", { id = field.id, x = field.x })
			end
		end,
		finish = function(_E, _lab, field)
			E.S.LabService:FX(lab, "tornadoend", { id = field.id })
		end,
	})
	local _ = ctx
end

-- ── Supernova: blinding flash, then the biggest blast in the game ──
function Fields.supernova(E, lab, center: Vector3, potion, ctx)
	E.S.LabService:FX(lab, "supernova", { p = center, r = potion.radius })
	task.delay(0.75, function()
		if lab.destroyed then
			return
		end
		E:Explosion(
			lab,
			center,
			potion.radius,
			2.2 * (ctx.potency or 1),
			{ source = ctx.source, color = Color3.fromRGB(255, 250, 210), big = true }
		)
		for _, golem in E.S.GolemService:InRadius(lab, center, potion.radius * 0.8) do
			E:ApplyStatus(golem, "burning", { duration = 6, source = ctx.source })
		end
	end)
end

-- ── Chaos Potion: three random effects ──
local CHAOS_STATUSES = {
	"burning",
	"frozen",
	"levitating",
	"bouncy",
	"shocked",
	"giant",
	"tiny",
	"gravityflip",
	"ghost",
	"zombie",
	"golden",
	"magnetic",
	"disco",
	"acid",
	"rocket",
	"balloons",
	"hyper",
}
local CHAOS_FIELDS = { "explosion", "blackhole", "stasis", "tornado", "meteors", "steam" }

function Fields.chaos(E, lab, center: Vector3, potion, ctx)
	E.S.LabService:FX(lab, "chaos", { p = center })
	local used = {}
	for _ = 1, 3 do
		if math.random() < 0.6 then
			local id
			repeat
				id = CHAOS_STATUSES[math.random(1, #CHAOS_STATUSES)]
			until not used[id]
			used[id] = true
			for _, golem in E.S.GolemService:InRadius(lab, center, potion.radius) do
				E:ApplyStatus(golem, id, { source = ctx.source })
			end
		else
			local id
			repeat
				id = CHAOS_FIELDS[math.random(1, #CHAOS_FIELDS)]
			until not used[id]
			used[id] = true
			local fake = { radius = if id == "blackhole" then 26 elseif id == "explosion" then 16 else 14 }
			local fn = Fields[id]
			if fn then
				fn(E, lab, center + Vector3.new(rand(-4, 4), rand(0, 4), 0), fake, ctx, 5)
			end
		end
	end
end

return Fields
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Puddles</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Splash puddles: thrown potions leave a material on the floor that keeps affecting anything
-- standing in it (fire patches, ice, trampoline goo, glue, acid, sludge, healing pools).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Vfx = require(script.Parent.Vfx)

local Puddles = {}

local function rand(a: number, b: number): number
	return a + math.random() * (b - a)
end

local KINDS = {
	fire = {
		material = Enum.Material.Neon,
		transparency = 0.25,
		life = 10,
		emitter = "fire",
		light = Color3.fromRGB(255, 130, 50),
	},
	ice = {
		material = Enum.Material.Ice,
		transparency = 0.15,
		life = 16,
		collide = true,
		physics = PhysicalProperties.new(0.9, 0, 0.05, 100, 1),
		emitter = "frost",
		color = Color3.fromRGB(190, 240, 255),
	},
	bounce = {
		material = Enum.Material.Neon,
		transparency = 0.2,
		life = 14,
		collide = true,
		physics = PhysicalProperties.new(0.8, 0.3, 1, 1, 100),
		emitter = "slime",
	},
	glue = {
		material = Enum.Material.SmoothPlastic,
		transparency = 0.15,
		life = 12,
		emitter = "slime",
		reflectance = 0.2,
	},
	sludge = {
		material = Enum.Material.Mud,
		transparency = 0.1,
		life = 10,
		emitter = "stink",
	},
	acid = {
		material = Enum.Material.Neon,
		transparency = 0.3,
		life = 9,
		emitter = "acid",
		light = Color3.fromRGB(170, 255, 60),
	},
	heal = {
		material = Enum.Material.Neon,
		transparency = 0.35,
		life = 10,
		emitter = "sparkle",
		light = Color3.fromRGB(255, 120, 170),
	},
}

local function insideGolems(E, lab, puddle)
	local list = {}
	local p = puddle.position
	for _, golem in lab.golems do
		if golem.dead then
			continue
		end
		for _, part in golem.parts do
			if part.Parent then
				local offset = part.Position - p
				if math.abs(offset.X) < puddle.radius and offset.Y > -1.5 and offset.Y < 3.2 then
					table.insert(list, golem)
					break
				end
			end
		end
	end
	local _ = E
	return list
end

local BEHAVIOUR = {
	fire = function(E, lab, puddle)
		for _, golem in insideGolems(E, lab, puddle) do
			E:ApplyStatus(golem, "burning", { duration = 3, source = puddle.source })
		end
		if E.S.PropService then
			for _, prop in E.S.PropService:InRadius(lab, puddle.position, puddle.radius) do
				E.S.PropService:Ignite(prop, puddle.source)
			end
		end
	end,
	bounce = function(E, lab, puddle)
		puddle.cooldown = puddle.cooldown or {}
		local now = os.clock()
		for _, golem in insideGolems(E, lab, puddle) do
			if (puddle.cooldown[golem] or 0) < now then
				puddle.cooldown[golem] = now + 0.7
				E:Kick(golem, Vector3.new(rand(-8, 8), 95 * lab.timeScale, 0))
				E.S.GolemService:Stun(golem, 1.2)
				E.S.LabService:FXU(lab, "boing", { p = puddle.position })
			end
		end
	end,
	glue = function(E, lab, puddle)
		for _, golem in insideGolems(E, lab, puddle) do
			E.S.GolemService:Stun(golem, 1)
			if not golem.grabbedBy then
				for _, part in golem.parts do
					if part.Parent and not part.Anchored then
						part.AssemblyLinearVelocity *= 0.25
					end
				end
			end
		end
	end,
	sludge = function(E, lab, puddle)
		for _, golem in insideGolems(E, lab, puddle) do
			E:ApplyStatus(golem, "stinky", { duration = 3, source = puddle.source })
		end
	end,
	acid = function(E, lab, puddle)
		for _, golem in insideGolems(E, lab, puddle) do
			E.S.GolemService:Damage(golem, 3, { source = puddle.source, kind = "acid" })
		end
	end,
	heal = function(E, lab, puddle)
		for _, golem in insideGolems(E, lab, puddle) do
			if golem.state == "ko" or golem.shattered then
				E.S.GolemService:Reform(golem)
			elseif golem.health < golem.maxHealth then
				golem.health = math.min(golem.maxHealth, golem.health + 6)
				golem.model:SetAttribute("Health", golem.health)
			end
		end
	end,
}

function Puddles.create(E, lab, kind: string, position: Vector3, _normal: Vector3?, color: Color3, source: Player?)
	local spec = KINDS[kind]
	if not spec then
		return nil
	end
	local hit = Workspace:Raycast(position + Vector3.new(0, 1.5, 0), Vector3.new(0, -26, 0), lab.staticRayParams)
	if not hit or hit.Normal.Y < 0.6 then
		return nil
	end
	local radius = 5.5
	local normal = hit.Normal
	local side = Vector3.zAxis:Cross(normal)
	if side.Magnitude < 0.1 then
		side = Vector3.xAxis
	end
	local part = Instance.new("Part")
	part.Name = "Puddle_" .. kind
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.32, radius * 2, radius * 2)
	part.CFrame = CFrame.fromMatrix(hit.Position + normal * 0.14, normal, side.Unit)
	part.Color = spec.color or color
	part.Material = spec.material
	part.Transparency = spec.transparency
	part.Reflectance = spec.reflectance or 0
	part.Anchored = true
	part.CanCollide = spec.collide == true
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.CollisionGroup = "Static"
	if spec.physics then
		part.CustomPhysicalProperties = spec.physics
	end
	if spec.emitter then
		Vfx.emitter(
			part,
			spec.emitter,
			{ Rate = 8, Shape = Enum.ParticleEmitterShape.Disc, EmissionDirection = Enum.NormalId.Right }
		)
	end
	if spec.light then
		Vfx.light(part, spec.light, 12, 1.4, kind == "fire")
	end
	part.Parent = lab.effects

	local puddle = {
		kind = kind,
		part = part,
		position = hit.Position,
		radius = radius,
		remaining = spec.life or Config.Potions.PuddleLifetime,
		life = spec.life or Config.Potions.PuddleLifetime,
		baseTransparency = spec.transparency,
		source = source,
		timer = 0,
	}
	table.insert(lab.puddles, puddle)
	while #lab.puddles > Config.MaxPuddles do
		local oldest = table.remove(lab.puddles, 1)
		if oldest.part then
			oldest.part:Destroy()
		end
	end
	E.S.LabService:FX(lab, "puddle", { p = hit.Position, c = part.Color, r = radius })
	return puddle
end

function Puddles.update(E, lab, _dt: number, labDt: number)
	if labDt <= 0 then
		return
	end
	for i = #lab.puddles, 1, -1 do
		local puddle = lab.puddles[i]
		puddle.remaining -= labDt
		if puddle.remaining <= 0 or not puddle.part.Parent then
			table.remove(lab.puddles, i)
			puddle.part:Destroy()
			continue
		end
		if puddle.remaining < 1.5 then
			local alpha = 1 - puddle.remaining / 1.5
			puddle.part.Transparency = puddle.baseTransparency + (1 - puddle.baseTransparency) * alpha
		end
		puddle.timer -= labDt
		if puddle.timer <= 0 then
			puddle.timer = 0.2
			local behaviour = BEHAVIOUR[puddle.kind]
			if behaviour then
				local ok, err = pcall(behaviour, E, lab, puddle)
				if not ok then
					warn("[Puddles]", puddle.kind, err)
				end
			end
		end
	end
end

function Puddles.clear(lab)
	for _, puddle in lab.puddles do
		if puddle.part then
			puddle.part:Destroy()
		end
	end
	table.clear(lab.puddles)
end

return Puddles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Statuses</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Status effect definitions applied to golems by potions, puddles, hazards and reactions.
-- Each definition may implement: immune(golem), apply(E, golem, st, opts), refresh(...),
-- tick(E, golem, st, dt, labDt), remove(E, golem, st, reason), cleanup(E, golem, st).
-- `E` is the EffectsService; `E.S` gives access to every other service.

local Workspace = game:GetService("Workspace")

local Physics2D = require(script.Parent.Parent.Physics2D)
local World = require(script.Parent.Parent.World)
local Vfx = require(script.Parent.Vfx)

local Statuses = {}

local function rand(a: number, b: number): number
	return a + math.random() * (b - a)
end

local function torsoOf(golem): BasePart?
	local torso = golem.byName and golem.byName.Torso
	if torso and torso.Parent then
		return torso
	end
	return nil
end

local function add(st, instance)
	table.insert(st.instances, instance)
	return instance
end

-- Accumulates fractional damage so per-frame DoT still lands as whole numbers.
local function dot(E, golem, st, perSecond: number, labDt: number, kind: string)
	st.data.dotAcc = (st.data.dotAcc or 0) + perSecond * labDt
	if st.data.dotAcc >= 3 then
		local amount = st.data.dotAcc
		st.data.dotAcc = 0
		E.S.GolemService:Damage(golem, amount, { source = st.source, kind = kind })
	end
end

local function setController(golem, st, fn, upright: boolean?)
	st.data.controller = fn
	golem.controller = fn
	golem.controllerUpright = upright
	if golem.state == "standing" or golem.state == "gettingup" then
		golem.state = "stunned"
		golem.stateTime = 999 -- leave stun immediately → "controlled"
	end
end

local function clearController(E, golem, st)
	if golem.controller == st.data.controller then
		golem.controller = nil
		golem.controllerUpright = nil
		E.S.GolemService:SetPose(golem, nil)
		if golem.state == "controlled" then
			E.S.GolemService:SetState(golem, "standing")
		end
	end
end

local function limbList(golem): { BasePart }
	local list = {}
	for _, name in { "Torso", "Head", "UpperArmL", "UpperArmR", "LowerLegL", "LowerLegR" } do
		local part = golem.byName[name]
		if part and part.Parent then
			table.insert(list, part)
		end
	end
	return list
end

-- ─────────────────────────────── BURNING ───────────────────────────────

local function panicController(golem, _dt, labDt)
	local st = golem.statuses.burning
	if not st then
		return
	end
	st.data.panic = (st.data.panic or 0) - labDt
	if st.data.panic <= 0 and golem.grounded then
		st.data.panic = rand(0.35, 0.6)
		st.data.dir = -(st.data.dir or 1)
		st.E:Kick(golem, Vector3.new(st.data.dir * rand(16, 24), rand(24, 34), 0))
		st.E.S.GolemService:SetPose(golem, {
			ShoulderL = rand(-170, -90),
			ShoulderR = rand(90, 170),
			ElbowL = rand(0, 90),
			ElbowR = rand(-90, 0),
			HipL = rand(-30, 10),
			HipR = rand(-10, 30),
			KneeL = 0,
			KneeR = 0,
			Neck = rand(-20, 20),
		}, 0.7, 12)
	end
end

Statuses.burning = {
	duration = 8,
	immune = function(golem)
		return golem.skin.traits.fireproof == true or golem.statuses.ascension ~= nil
	end,
	apply = function(E, golem, st, opts)
		st.E = E
		local spirit = opts.spirit == true
		st.data.spirit = spirit
		local colors = if spirit
			then ColorSequence.new(Color3.fromRGB(160, 230, 255), Color3.fromRGB(40, 120, 255))
			else ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 60, 20))
		for _, part in limbList(golem) do
			local big = part.Name == "Torso" or part.Name == "Head"
			add(st, Vfx.emitter(part, "fire", { Rate = if big then 34 else 14, Color = colors }))
		end
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "embers"))
			add(st, Vfx.emitter(torso, "smoke"))
			add(
				st,
				Vfx.light(
					torso,
					if spirit then Color3.fromRGB(120, 190, 255) else Color3.fromRGB(255, 140, 50),
					14,
					2.2,
					true
				)
			)
		end
		st.data.char = 0
		E:SetLook(golem, "burning", { priority = 20, tint = Color3.fromRGB(28, 18, 18), tintAlpha = 0 })
		golem.model:SetAttribute("Burning", true)
		if not spirit then
			setController(golem, st, panicController, true)
		end
	end,
	tick = function(E, golem, st, _dt, labDt)
		if not st.data.spirit then
			local rate = if golem.skin.traits.melts then 10 else 5
			dot(E, golem, st, rate, labDt, "burn")
			st.data.char = math.min(0.7, st.data.char + labDt * 0.09)
			st.data.lookTimer = (st.data.lookTimer or 0) - labDt
			if st.data.lookTimer <= 0 then
				st.data.lookTimer = 0.5
				E:SetLook(
					golem,
					"burning",
					{ priority = 20, tint = Color3.fromRGB(28, 18, 18), tintAlpha = st.data.char }
				)
			end
		end
		-- Spread to anything touching.
		st.data.spread = (st.data.spread or 0) - labDt
		if st.data.spread <= 0 then
			st.data.spread = 0.4
			local torso = torsoOf(golem)
			if torso then
				for _, other in E.S.GolemService:InRadius(golem.lab, torso.Position, 4.2 * golem.scale) do
					if other ~= golem and not other.statuses.burning then
						E:ApplyStatus(other, "burning", { duration = 6, source = st.source })
					end
				end
				if E.S.PropService then
					for _, prop in E.S.PropService:InRadius(golem.lab, torso.Position, 6 * golem.scale) do
						E.S.PropService:Ignite(prop, st.source)
					end
				end
			end
		end
	end,
	remove = function(E, golem, st)
		E:SetLook(golem, "burning", nil)
		golem.model:SetAttribute("Burning", nil)
		clearController(E, golem, st)
		local torso = torsoOf(golem)
		if torso then
			E.S.LabService:FX(golem.lab, "smokepuff", { p = torso.Position })
		end
	end,
	cleanup = function(_E, golem)
		golem.model:SetAttribute("Burning", nil)
	end,
}

-- ─────────────────────────────── FROZEN ───────────────────────────────

Statuses.frozen = {
	duration = 10,
	immune = function(golem)
		return golem.skin.traits.frostproof == true
	end,
	apply = function(E, golem, st)
		E.S.GolemService:SetRigid(golem, true)
		golem.mods.noUpright.frozen = true
		golem.mods.damage.frozen = 0.5
		E:SetLook(golem, "frozen", {
			priority = 50,
			tint = Color3.fromRGB(175, 232, 255),
			tintAlpha = 0.72,
			material = Enum.Material.Ice,
			reflectance = 0.25,
		})
		E:SetPhys(golem, "frozen", { priority = 50, friction = 0.04, frictionWeight = 100, elasticity = 0.05 })
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "frost", { Rate = 16 }))
			add(st, Vfx.light(torso, Color3.fromRGB(160, 220, 255), 9, 1))
			E.S.LabService:FX(golem.lab, "freeze", { p = torso.Position })
		end
		st.data.savedController = golem.controller
		golem.controller = nil
	end,
	remove = function(E, golem, st, reason)
		golem.mods.noUpright.frozen = nil
		golem.mods.damage.frozen = nil
		if not golem.statuses.golden then
			E.S.GolemService:SetRigid(golem, false)
		end
		E:SetLook(golem, "frozen", nil)
		E:SetPhys(golem, "frozen", nil)
		if st.data.savedController and golem.controller == nil then
			golem.controller = st.data.savedController
		end
		local torso = torsoOf(golem)
		if torso and reason ~= "shatter" then
			E.S.LabService:FX(golem.lab, "thaw", { p = torso.Position })
		end
	end,
}

-- ─────────────────────────────── LEVITATING ───────────────────────────────

Statuses.levitating = {
	duration = 9,
	apply = function(E, golem, st)
		golem.mods.gravity.levitate = -0.16
		golem.mods.limp.levitate = true
		E:SetDrag(golem, "levitate", 1.1)
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "float"))
			add(st, Vfx.light(torso, Color3.fromRGB(200, 160, 255), 10, 1.2))
		end
		E:Kick(golem, Vector3.new(0, 14, 0))
	end,
	tick = function(E, golem, st, _dt, labDt)
		st.data.wobble = (st.data.wobble or 0) - labDt
		if st.data.wobble <= 0 then
			st.data.wobble = rand(0.5, 0.9)
			E:Pull(golem, Vector3.new(rand(-5, 5), rand(-1, 3), 0))
		end
	end,
	remove = function(E, golem)
		golem.mods.gravity.levitate = nil
		golem.mods.limp.levitate = nil
		E:SetDrag(golem, "levitate", nil)
	end,
}

-- ─────────────────────────────── BOUNCY ───────────────────────────────

Statuses.bouncy = {
	duration = 12,
	apply = function(E, golem, st)
		E:SetPhys(
			golem,
			"bouncy",
			{ priority = 40, elasticity = 1, elasticityWeight = 100, friction = 0.15, frictionWeight = 50 }
		)
		E:SetLook(
			golem,
			"bouncy",
			{ priority = 15, tint = Color3.fromRGB(110, 240, 120), tintAlpha = 0.35, material = Enum.Material.Rubber }
		)
		golem.mods.limp.bouncy = true
		golem.mods.damage.bouncy = 0.35
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "slime"))
		end
		E:Kick(golem, Vector3.new(rand(-10, 10), 45, 0))
	end,
	remove = function(E, golem)
		E:SetPhys(golem, "bouncy", nil)
		E:SetLook(golem, "bouncy", nil)
		golem.mods.limp.bouncy = nil
		golem.mods.damage.bouncy = nil
	end,
}

-- ─────────────────────────────── ROCKET ───────────────────────────────

Statuses.rocket = {
	duration = 3.2,
	apply = function(E, golem, st)
		local torso = torsoOf(golem)
		if not torso then
			return
		end
		local s = golem.scale
		local booster = Instance.new("Part")
		booster.Name = "Booster"
		booster.Shape = Enum.PartType.Cylinder
		booster.Size = Vector3.new(4.6 * s, 1.3 * s, 1.3 * s)
		booster.CFrame = torso.CFrame * CFrame.new(0, 0.3 * s, -1.5 * s) * CFrame.Angles(0, 0, math.rad(90))
		booster.Color = Color3.fromRGB(230, 60, 50)
		booster.Material = Enum.Material.Metal
		booster.CanCollide = false
		booster.CanQuery = false
		booster.CanTouch = false
		booster.Massless = true
		booster.Parent = golem.model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = booster
		weld.Parent = booster
		add(st, booster)
		local cone = booster:Clone()
		cone.Name = "BoosterCone"
		cone.Shape = Enum.PartType.Ball
		cone.Size = Vector3.one * 1.3 * s
		cone.CFrame = torso.CFrame * CFrame.new(0, 2.6 * s, -1.5 * s)
		cone.Color = Color3.fromRGB(240, 240, 250)
		cone:ClearAllChildren()
		cone.Parent = golem.model
		local coneWeld = Instance.new("WeldConstraint")
		coneWeld.Part0 = torso
		coneWeld.Part1 = cone
		coneWeld.Parent = cone
		add(st, cone)
		local nozzle = Instance.new("Attachment")
		nozzle.Name = "Nozzle"
		nozzle.CFrame = CFrame.new(0, -2.2 * s, -1.5 * s)
		nozzle.Parent = torso
		add(st, nozzle)
		add(st, Vfx.emitter(nozzle, "thrust"))
		add(st, Vfx.emitter(nozzle, "thrustSmoke"))
		add(st, Vfx.light(booster, Color3.fromRGB(255, 160, 60), 16, 2.5, true))
		local thrust = Instance.new("VectorForce")
		thrust.Name = "Thrust"
		thrust.Attachment0 = torso:FindFirstChild("UprightAtt") :: Attachment
		thrust.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
		thrust.ApplyAtCenterOfMass = true
		thrust.Force = Vector3.zero
		thrust.Parent = torso
		add(st, thrust)
		st.data.thrust = thrust
		golem.mods.limp.rocket = true
		E.S.GolemService:Stun(golem, 4)
		E.S.LabService:FX(golem.lab, "ignite", { p = torso.Position })
	end,
	tick = function(E, golem, st, _dt, labDt)
		local thrust = st.data.thrust
		if not thrust or not thrust.Parent then
			return
		end
		st.data.sputter = (st.data.sputter or 0) - labDt
		if st.data.sputter <= 0 then
			st.data.sputter = 0.1
			st.data.factor = rand(0.8, 1.2)
		end
		local ts = golem.lab.timeScale
		local power = if st.data.overdrive then 4.4 else 2.7
		-- Thrust along the torso's up axis (attachment X axis).
		thrust.Force = Vector3.new(golem.mass * Workspace.Gravity * power * (st.data.factor or 1) * ts * ts, 0, 0)
		dot(E, golem, st, 2, labDt, "rocket")
	end,
	remove = function(E, golem, st, reason)
		golem.mods.limp.rocket = nil
		local torso = torsoOf(golem)
		if torso and reason == "expired" then
			E:Explosion(golem.lab, torso.Position, 9, 0.55, { source = st.source })
		end
	end,
}

-- ─────────────────────────────── SHOCKED ───────────────────────────────

Statuses.shocked = {
	duration = 4,
	apply = function(E, golem, st, opts)
		local torso = torsoOf(golem)
		if not torso then
			return
		end
		local lab = golem.lab
		local G = E.S.GolemService
		G:Stun(golem, st.remaining + 0.5)
		golem.mods.limp.shocked = true
		local multiplier = (if opts.overcharge then 2 else 1) * (if golem.skin.traits.conductive then 1.5 else 1)
		if opts.overcharge then
			st.remaining += 2
		end
		if not opts.chained then
			local top = Vector3.new(torso.Position.X + rand(-6, 6), lab.origin.Y + lab.map.height - 1, torso.Position.Z)
			E:Lightning(lab, top, torso.Position)
		end
		G:Damage(
			golem,
			16 * multiplier * (st.potency or 1),
			{ source = st.source, position = torso.Position, kind = "shock" }
		)
		add(st, Vfx.emitter(torso, "shock"))
		add(st, Vfx.light(torso, Color3.fromRGB(150, 210, 255), 12, 2.5, true))
		E:Kick(golem, Vector3.new(0, 16, 0))
		-- Chain lightning.
		if not opts.chained then
			local count = 0
			local range = 16
			for _, other in lab.golems do
				local otherTorso = torsoOf(other)
				if other ~= golem and otherTorso and not other.statuses.shocked and count < 5 then
					local d = (otherTorso.Position - torso.Position).Magnitude
					local metal = other.skin.traits.conductive or other.statuses.golden or other.statuses.magnetic
					if d < range or (opts.conductor and metal) then
						count += 1
						E:Lightning(lab, torso.Position, otherTorso.Position)
						E:ApplyStatus(
							other,
							"shocked",
							{ duration = st.duration * 0.75, source = st.source, chained = true, potency = st.potency }
						)
					end
				end
			end
		end
	end,
	tick = function(E, golem, st, _dt, labDt)
		st.data.twitch = (st.data.twitch or 0) - labDt
		if st.data.twitch <= 0 then
			st.data.twitch = 0.11
			st.data.flash = not st.data.flash
			E:SetLook(
				golem,
				"shock",
				if st.data.flash
					then { priority = 70, color = Color3.fromRGB(235, 248, 255), material = Enum.Material.Neon }
					else nil
			)
			for _ = 1, 2 do
				local part = golem.parts[math.random(1, #golem.parts)]
				if part and part.Parent and not part.Anchored and not golem.grabbedBy then
					part:ApplyImpulse(Vector3.new(rand(-1, 1), rand(-0.5, 1), 0) * part.AssemblyMass * 16)
				end
			end
		end
	end,
	remove = function(E, golem)
		golem.mods.limp.shocked = nil
		E:SetLook(golem, "shock", nil)
		local torso = torsoOf(golem)
		if torso then
			E.S.LabService:FX(golem.lab, "smokepuff", { p = torso.Position })
		end
	end,
}

-- ─────────────────────────────── WET ───────────────────────────────

Statuses.wet = {
	duration = 6,
	apply = function(E, golem, st)
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "drip"))
		end
		E:SetLook(
			golem,
			"wet",
			{ priority = 5, tint = Color3.fromRGB(110, 160, 255), tintAlpha = 0.18, reflectance = 0.2 }
		)
	end,
	remove = function(E, golem)
		E:SetLook(golem, "wet", nil)
	end,
}

-- ─────────────────────────────── HYPER ───────────────────────────────

local function hyperController(golem, _dt, labDt)
	local st = golem.statuses.hyper
	if not st then
		return
	end
	st.data.cd = (st.data.cd or 0) - labDt
	if st.data.cd <= 0 and golem.grounded then
		st.data.cd = rand(0.4, 0.75)
		st.E:Kick(golem, Vector3.new(rand(-1, 1) * 42, rand(55, 85), 0))
		local torso = torsoOf(golem)
		if torso and not torso.Anchored then
			torso.AssemblyAngularVelocity += Vector3.new(0, 0, rand(-9, 9))
		end
		st.E.S.LabService:FXU(golem.lab, "boing", { p = (torso and torso.Position) or golem.lab.origin })
	end
end

Statuses.hyper = {
	duration = 9,
	apply = function(E, golem, st)
		st.E = E
		golem.mods.limp.hyper = true
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "shock", { Rate = 10, Color = ColorSequence.new(Color3.fromRGB(80, 255, 220)) }))
		end
		setController(golem, st, hyperController, false)
	end,
	remove = function(E, golem, st)
		golem.mods.limp.hyper = nil
		clearController(E, golem, st)
	end,
}

-- ─────────────────────────────── GIANT / TINY ───────────────────────────────

Statuses.giant = {
	duration = 15,
	apply = function(E, golem)
		E.S.GolemService:SetScale(golem, 2.4, 0.8)
		local torso = torsoOf(golem)
		if torso then
			E.S.LabService:FX(golem.lab, "grow", { p = torso.Position })
		end
	end,
	remove = function(E, golem, _st, reason)
		if reason ~= "clear" then
			E.S.GolemService:SetScale(golem, if golem.statuses.tiny then 0.45 else 1, 0.6)
		end
	end,
}

Statuses.tiny = {
	duration = 15,
	apply = function(E, golem)
		E.S.GolemService:SetScale(golem, 0.45, 0.6)
		golem.model:SetAttribute("Squeaky", true)
		local torso = torsoOf(golem)
		if torso then
			E.S.LabService:FX(golem.lab, "shrink", { p = torso.Position })
		end
	end,
	remove = function(E, golem, _st, reason)
		golem.model:SetAttribute("Squeaky", nil)
		if reason ~= "clear" then
			E.S.GolemService:SetScale(golem, if golem.statuses.giant then 2.4 else 1, 0.6)
		end
	end,
}

-- ─────────────────────────────── GRAVITY FLIP ───────────────────────────────

Statuses.gravityflip = {
	duration = 9,
	apply = function(E, golem, st)
		golem.mods.gravity.flip = -1
		golem.mods.limp.flip = true
		local torso = torsoOf(golem)
		if torso then
			add(
				st,
				Vfx.emitter(
					torso,
					"float",
					{ Color = ColorSequence.new(Color3.fromRGB(150, 130, 255)), Acceleration = Vector3.new(0, 6, 0) }
				)
			)
			add(st, Vfx.light(torso, Color3.fromRGB(140, 120, 255), 10, 1.4))
		end
		E:Kick(golem, Vector3.new(0, 22, 0))
	end,
	remove = function(_E, golem)
		golem.mods.gravity.flip = nil
		golem.mods.limp.flip = nil
	end,
}

-- ─────────────────────────────── GHOST ───────────────────────────────

Statuses.ghost = {
	duration = 8,
	apply = function(E, golem, st)
		E:SetLook(golem, "ghost", {
			priority = 45,
			color = Color3.fromRGB(190, 255, 255),
			material = Enum.Material.ForceField,
			transparency = 0.3,
		})
		st.data.collide = {}
		for _, part in golem.parts do
			st.data.collide[part] = part.CanCollide
			part.CanCollide = false
		end
		golem.mods.gravity.ghost = 0
		golem.mods.damage.ghost = 0
		golem.mods.limp.ghost = true
		E:SetDrag(golem, "ghost", 1.4)
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "ghost"))
			add(st, Vfx.light(torso, Color3.fromRGB(170, 255, 255), 12, 1.2))
		end
	end,
	tick = function(E, golem, st, _dt, labDt)
		local torso = torsoOf(golem)
		if not torso then
			return
		end
		st.data.drift = (st.data.drift or 0) - labDt
		if st.data.drift <= 0 then
			st.data.drift = rand(0.5, 1)
			local lab = golem.lab
			local p = torso.Position - lab.origin
			local push = Vector3.new(rand(-12, 12), rand(-6, 10), 0)
			if p.X < lab.minX + 6 then
				push += Vector3.new(18, 0, 0)
			elseif p.X > lab.maxX - 6 then
				push -= Vector3.new(18, 0, 0)
			end
			if p.Y < 3 then
				push += Vector3.new(0, 16, 0)
			elseif p.Y > lab.map.height - 5 then
				push -= Vector3.new(0, 16, 0)
			end
			E:Pull(golem, push)
		end
	end,
	remove = function(E, golem, st)
		E:SetLook(golem, "ghost", nil)
		for part, collide in st.data.collide or {} do
			if part.Parent then
				part.CanCollide = collide
			end
		end
		golem.mods.gravity.ghost = nil
		golem.mods.damage.ghost = nil
		golem.mods.limp.ghost = nil
		E:SetDrag(golem, "ghost", nil)
		-- If it drifted somewhere it can't be, bring it back.
		local torso = torsoOf(golem)
		if torso then
			local lab = golem.lab
			local p = torso.Position - lab.origin
			if p.Y < 0.5 or p.X < lab.minX or p.X > lab.maxX or p.Y > lab.map.height then
				task.defer(function()
					E.S.GolemService:Reform(golem, { toSpawn = true })
				end)
			end
		end
	end,
}

-- ─────────────────────────────── ZOMBIE ───────────────────────────────

local ZOMBIE_POSE = {
	ShoulderL = -100,
	ShoulderR = 100,
	ElbowL = 20,
	ElbowR = -20,
	HipL = 0,
	HipR = 0,
	KneeL = 0,
	KneeR = 0,
	Neck = 15,
}

local function zombieController(golem, _dt, labDt)
	local st = golem.statuses.zombie
	if not st then
		return
	end
	local E = st.E
	local torso = torsoOf(golem)
	if not torso then
		return
	end
	local G = E.S.GolemService
	local target = G:Nearest(golem.lab, torso.Position, 160, function(other)
		return other ~= golem and not other.statuses.zombie and not other.shattered and not other.statuses.ascension
	end)
	st.data.hop = (st.data.hop or 0) - labDt
	if golem.grounded and st.data.hop <= 0 and not golem.controllerStunned then
		st.data.hop = rand(0.75, 1.15)
		local dir = if target
			then math.sign(target.byName.Torso.Position.X - torso.Position.X)
			else (if math.random() < 0.5 then -1 else 1)
		if dir == 0 then
			dir = 1
		end
		E:Kick(golem, Vector3.new(dir * rand(20, 30), rand(40, 52), 0))
		st.data.step = not st.data.step
		local pose = table.clone(ZOMBIE_POSE)
		pose.HipL = if st.data.step then -18 else 10
		pose.HipR = if st.data.step then -10 else 18
		G:SetPose(golem, pose, 0.8, 6)
	end
	st.data.bite = (st.data.bite or 0) - labDt
	if target and st.data.bite <= 0 then
		local targetTorso = target.byName.Torso
		local reach = 5.4 * math.max(golem.scale, target.scale)
		if targetTorso and (targetTorso.Position - torso.Position).Magnitude < reach then
			st.data.bite = 1
			E:ApplyStatus(target, "zombie", { source = st.source, duration = st.duration })
			G:Damage(target, 10, { source = st.source, position = targetTorso.Position, kind = "bite" })
			E.S.LabService:FX(golem.lab, "infect", { p = targetTorso.Position })
		end
	end
end

Statuses.zombie = {
	duration = 45,
	immune = function(golem)
		return golem.statuses.ascension ~= nil
	end,
	apply = function(E, golem, st)
		st.E = E
		E:SetLook(golem, "zombie", { priority = 30, tint = Color3.fromRGB(96, 172, 64), tintAlpha = 0.55 })
		st.data.pupils = {}
		for _, name in { "PupilL", "PupilR" } do
			local pupil = golem.faces[name]
			if pupil and pupil.Parent then
				st.data.pupils[pupil] = { pupil.Color, pupil.Material }
				pupil.Color = Color3.fromRGB(255, 40, 40)
				pupil.Material = Enum.Material.Neon
			end
		end
		golem.model:SetAttribute("Zombie", true)
		golem.uprightStrength = 0.75
		setController(golem, st, zombieController, true)
		E.S.GolemService:SetPose(golem, ZOMBIE_POSE, 0.8, 6)
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "stink", { Color = ColorSequence.new(Color3.fromRGB(110, 170, 60)), Rate = 3 }))
			E.S.LabService:FX(golem.lab, "infect", { p = torso.Position })
		end
	end,
	remove = function(E, golem, st)
		E:SetLook(golem, "zombie", nil)
		for pupil, saved in st.data.pupils or {} do
			if pupil.Parent then
				pupil.Color = saved[1]
				pupil.Material = saved[2]
			end
		end
		golem.model:SetAttribute("Zombie", nil)
		golem.uprightStrength = nil
		clearController(E, golem, st)
	end,
}

-- ─────────────────────────────── GOLDEN ───────────────────────────────

Statuses.golden = {
	duration = 20,
	apply = function(E, golem, st)
		E.S.GolemService:SetRigid(golem, true)
		golem.mods.noUpright.golden = true
		golem.mods.damage.golden = 0.25
		E:SetLook(
			golem,
			"golden",
			{ priority = 60, color = Color3.fromRGB(255, 198, 56), material = Enum.Material.Foil, reflectance = 0.3 }
		)
		E:SetPhys(golem, "golden", { priority = 60, densityMul = 3 })
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "gold"))
			add(st, Vfx.light(torso, Color3.fromRGB(255, 210, 90), 12, 1.6))
			E.S.LabService:FX(golem.lab, "gild", { p = torso.Position })
		end
		st.data.savedController = golem.controller
		golem.controller = nil
	end,
	remove = function(E, golem, st)
		golem.mods.noUpright.golden = nil
		golem.mods.damage.golden = nil
		if not golem.statuses.frozen then
			E.S.GolemService:SetRigid(golem, false)
		end
		E:SetLook(golem, "golden", nil)
		E:SetPhys(golem, "golden", nil)
		if st.data.savedController and golem.controller == nil then
			golem.controller = st.data.savedController
		end
	end,
}

-- ─────────────────────────────── MAGNETIC ───────────────────────────────

Statuses.magnetic = {
	duration = 9,
	apply = function(_E, golem, st)
		local torso = torsoOf(golem)
		if torso then
			add(
				st,
				Vfx.emitter(
					torso,
					"sparkle",
					{ Color = ColorSequence.new(Color3.fromRGB(255, 80, 90), Color3.fromRGB(90, 140, 255)), Rate = 20 }
				)
			)
			add(st, Vfx.light(torso, Color3.fromRGB(255, 90, 110), 14, 1.6, true))
		end
		golem.model:SetAttribute("Magnet", true)
	end,
	tick = function(E, golem, _st, _dt, labDt)
		local torso = torsoOf(golem)
		if not torso then
			return
		end
		local range = 24 * golem.scale
		local function pull(object, position: Vector3, strength: number)
			local offset = torso.Position - position
			local d = offset.Magnitude
			if d > 1.5 and d < range then
				local falloff = 1 - d / range + 0.25
				E:Pull(object, offset.Unit * strength * falloff * labDt)
			end
		end
		for _, other in golem.lab.golems do
			local otherTorso = torsoOf(other)
			if other ~= golem and otherTorso then
				pull(other, otherTorso.Position, if other.skin.traits.conductive then 160 else 95)
			end
		end
		if E.S.PropService then
			for _, prop in E.S.PropService:InRadius(golem.lab, torso.Position, range) do
				pull(prop, prop.root.Position, if prop.propId == "anvil" or prop.propId == "barrel" then 180 else 90)
			end
		end
	end,
	remove = function(_E, golem)
		golem.model:SetAttribute("Magnet", nil)
	end,
}

-- ─────────────────────────────── DISCO ───────────────────────────────

local DANCE = {
	{ ShoulderL = -150, ShoulderR = 30, ElbowL = 40, ElbowR = -40, HipL = -10, HipR = 10, Neck = 15 },
	{ ShoulderL = -30, ShoulderR = 150, ElbowL = 40, ElbowR = -40, HipL = 10, HipR = -10, Neck = -15 },
	{ ShoulderL = -160, ShoulderR = 160, ElbowL = 20, ElbowR = -20, HipL = -20, HipR = 20, Neck = 0 },
	{ ShoulderL = -60, ShoulderR = 60, ElbowL = 120, ElbowR = -120, HipL = 0, HipR = 0, Neck = 10 },
}

local function discoController(golem, _dt, labDt)
	local st = golem.statuses.disco
	if not st then
		return
	end
	st.data.beat = (st.data.beat or 0) - labDt
	if st.data.beat <= 0 then
		st.data.beat = 0.42
		st.data.move = (st.data.move or 0) % #DANCE + 1
		st.E.S.GolemService:SetPose(golem, DANCE[st.data.move], 1, 14)
		if st.data.move == 3 and golem.grounded then
			st.E:Kick(golem, Vector3.new(0, 22, 0))
		end
	end
end

Statuses.disco = {
	duration = 12,
	apply = function(E, golem, st)
		st.E = E
		golem.model:SetAttribute("Disco", true)
		golem.mods.happy = true
		local torso = torsoOf(golem)
		if torso then
			add(
				st,
				Vfx.emitter(torso, "sparkle", {
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 200)),
						ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 220, 255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 80)),
					}),
					Rate = 24,
				})
			)
			local light = add(st, Vfx.light(torso, Color3.fromRGB(255, 120, 255), 18, 2))
			light:AddTag("DiscoLight")
		end
		setController(golem, st, discoController, true)
	end,
	remove = function(E, golem, st)
		golem.model:SetAttribute("Disco", nil)
		golem.mods.happy = nil
		clearController(E, golem, st)
	end,
}

-- ─────────────────────────────── ACID ───────────────────────────────

Statuses.acid = {
	duration = 7,
	apply = function(E, golem, st)
		E:SetLook(golem, "acid", { priority = 25, tint = Color3.fromRGB(170, 255, 60), tintAlpha = 0.45 })
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "acid"))
			add(st, Vfx.light(torso, Color3.fromRGB(170, 255, 60), 10, 1.2))
		end
		st.data.detach = 1.4
		E.S.GolemService:Stun(golem, 2)
	end,
	tick = function(E, golem, st, _dt, labDt)
		dot(E, golem, st, 6, labDt, "acid")
		st.data.detach -= labDt
		if st.data.detach <= 0 then
			st.data.detach = 1.6
			local order = { "ElbowL", "ElbowR", "KneeL", "KneeR", "ShoulderL", "ShoulderR", "HipL", "HipR" }
			for _, name in order do
				if golem.joints[name] then
					E.S.GolemService:Detach(golem, name, Vector3.new(rand(-6, 6), 10, 0))
					break
				end
			end
		end
	end,
	remove = function(E, golem)
		E:SetLook(golem, "acid", nil)
	end,
}

-- ─────────────────────────────── INSTANT: HEAL / CLONE ───────────────────────────────

Statuses.heal = {
	instant = true,
	apply = function(E, golem)
		local torso = torsoOf(golem)
		local position = if torso then torso.Position else golem.lab.origin
		E.S.GolemService:Reform(golem, { silent = true })
		E.S.LabService:FX(golem.lab, "heal", { p = position })
	end,
}

Statuses.clone = {
	instant = true,
	apply = function(E, golem, st)
		local torso = torsoOf(golem)
		if not torso then
			return
		end
		local lab = golem.lab
		local localPos = torso.Position - lab.origin
		local offset = if localPos.X > 0 then -5 else 5
		local spawnAt =
			Vector3.new(math.clamp(localPos.X + offset, lab.minX + 4, lab.maxX - 4), math.max(0, localPos.Y - 4.6), 0)
		local clone, err = E.S.GolemService:Spawn(lab, golem.skin.id, spawnAt, { source = st.source })
		if clone then
			E.S.LabService:FX(lab, "clone", { p = clone.byName.Torso.Position, c = golem.skin.body })
			for id, other in golem.statuses do
				if id ~= "clone" and Statuses[id] and not Statuses[id].instant then
					E:ApplyStatus(clone, id, { duration = other.remaining, source = st.source })
				end
			end
		elseif st.source then
			E.S.ShopService:Notify(st.source, "toast", { text = err or "Lab is full!", kind = "error" })
		end
	end,
}

-- ─────────────────────────────── DRAGON BREATH ───────────────────────────────

local function breathController(golem, _dt, labDt)
	local st = golem.statuses.dragonbreath
	if not st then
		return
	end
	local E = st.E
	local head = golem.byName.Head
	local att: Attachment? = st.data.mouth
	if not head or not head.Parent or not att then
		return
	end
	local mouth = head.CFrame * CFrame.new(0, -0.4 * golem.scale, 1.2 * golem.scale)
	local target = E.S.GolemService:Nearest(golem.lab, head.Position, 44, function(other)
		return other ~= golem
	end)
	local dir
	if target then
		local offset = target.byName.Torso.Position - mouth.Position
		dir = Vector3.new(offset.X, offset.Y, 0)
	else
		st.data.sweep = (st.data.sweep or 0) + labDt * 1.6
		dir = Vector3.new(math.cos(st.data.sweep), math.sin(st.data.sweep) * 0.4, 0)
	end
	if dir.Magnitude < 0.1 then
		dir = Vector3.xAxis
	end
	dir = dir.Unit
	local right = dir:Cross(Vector3.zAxis)
	if right.Magnitude < 0.1 then
		right = Vector3.xAxis
	end
	local world = CFrame.fromMatrix(mouth.Position, right.Unit, dir)
	att.CFrame = head.CFrame:ToObjectSpace(world)

	st.data.burn = (st.data.burn or 0) - labDt
	if st.data.burn <= 0 then
		st.data.burn = 0.15
		for _, other in golem.lab.golems do
			local otherTorso = torsoOf(other)
			if other ~= golem and otherTorso then
				local offset = otherTorso.Position - mouth.Position
				local d = offset.Magnitude
				if d < 28 and d > 0.1 and offset.Unit:Dot(dir) > 0.9 then
					E:ApplyStatus(other, "burning", { duration = 4, source = st.source })
					E:Pull(other, dir * 9)
				end
			end
		end
		if E.S.PropService then
			for _, prop in E.S.PropService:InRadius(golem.lab, mouth.Position, 28) do
				local offset = prop.root.Position - mouth.Position
				if offset.Magnitude > 0.1 and offset.Unit:Dot(dir) > 0.9 then
					E.S.PropService:Ignite(prop, st.source)
				end
			end
		end
		E:Pull(golem, -dir * 3)
	end
end

Statuses.dragonbreath = {
	duration = 6,
	apply = function(E, golem, st)
		st.E = E
		local head = golem.byName.Head
		if not head then
			return
		end
		local mouth = Instance.new("Attachment")
		mouth.Name = "BreathAtt"
		mouth.CFrame = CFrame.new(0, -0.4, 1.2)
		mouth.Parent = head
		add(st, mouth)
		st.data.mouth = mouth
		add(st, Vfx.emitter(mouth, "breath"))
		add(st, Vfx.light(head, Color3.fromRGB(255, 130, 40), 18, 2.6, true))
		setController(golem, st, breathController, true)
		E.S.LabService:FX(golem.lab, "roar", { p = head.Position })
	end,
	remove = function(E, golem, st)
		clearController(E, golem, st)
	end,
}

-- ─────────────────────────────── BALLOONS ───────────────────────────────

local BALLOON_COLORS = { Color3.fromRGB(255, 70, 110), Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 220, 60) }

Statuses.balloons = {
	duration = 14,
	apply = function(E, golem, st)
		local lab = golem.lab
		local anchors = {
			{ part = golem.byName.LowerArmL, offset = Vector3.new(0, -0.8, 0) },
			{ part = golem.byName.Head, offset = Vector3.new(0, 1.1, 0) },
			{ part = golem.byName.LowerArmR, offset = Vector3.new(0, -0.8, 0) },
		}
		st.data.balloons = {}
		for i, anchor in anchors do
			local host = anchor.part
			if not host or not host.Parent then
				continue
			end
			local s = golem.scale
			local balloon = Instance.new("Part")
			balloon.Name = "Balloon"
			balloon.Shape = Enum.PartType.Ball
			balloon.Size = Vector3.one * 2.8 * math.max(s, 0.6)
			balloon.Color = BALLOON_COLORS[i]
			balloon.Material = Enum.Material.SmoothPlastic
			balloon.Reflectance = 0.15
			balloon.CustomPhysicalProperties = PhysicalProperties.new(0.02, 0.2, 0.5, 1, 1)
			balloon.CollisionGroup = Physics2D.GolemGroups[golem.groupIndex]
			balloon.CanQuery = true
			balloon.CanTouch = true
			local top = host.Position + Vector3.new((i - 2) * 2.4 * s, 7 * s, 0)
			balloon.CFrame = CFrame.new(Vector3.new(top.X, top.Y, host.Position.Z))
			balloon.Parent = golem.model
			add(st, balloon)
			Physics2D.attach(balloon, lab.planeOrigin, { lockRotation = false, gravity = false })
			local knot = Instance.new("Attachment")
			knot.Name = "BalloonKnot"
			knot.Position = Vector3.new(0, -balloon.Size.Y / 2, 0)
			knot.Parent = balloon
			local hold = Instance.new("Attachment")
			hold.Name = "BalloonHold"
			hold.Position = anchor.offset * s
			hold.Parent = host
			add(st, hold)
			local rope = Instance.new("RopeConstraint")
			rope.Attachment0 = knot
			rope.Attachment1 = hold
			rope.Length = 6 * s
			rope.Visible = true
			rope.Thickness = 0.08
			rope.Color = BrickColor.new("Institutional white")
			rope.Parent = balloon
			local buoy = Instance.new("VectorForce")
			buoy.Name = "Buoy"
			buoy.Attachment0 = knot
			buoy.RelativeTo = Enum.ActuatorRelativeTo.World
			buoy.ApplyAtCenterOfMass = true
			buoy.Parent = balloon
			table.insert(st.data.balloons, { part = balloon, force = buoy })
			World.partToObject[balloon] = golem
		end
		golem.mods.limp.balloons = true
		E:SetDrag(golem, "balloons", 0.6)
		E.S.LabService:FX(lab, "inflate", { p = golem.byName.Head.Position })
	end,
	tick = function(_E, golem, st)
		local alive = 0
		for _, b in st.data.balloons do
			if b.part.Parent then
				alive += 1
			end
		end
		local ts = golem.lab.timeScale
		local g = Workspace.Gravity
		for _, b in st.data.balloons do
			if b.part.Parent then
				-- Three balloons lift ~1.45x the golem's weight in total.
				local lift = (golem.mass * 1.45 / math.max(alive, 1) * (alive / 3) + b.part:GetMass()) * g * ts * ts
				b.force.Force = Vector3.new(0, lift, 0)
			end
		end
	end,
	remove = function(E, golem, st, reason)
		for _, b in st.data.balloons or {} do
			World.partToObject[b.part] = nil
			if b.part.Parent and reason ~= "clear" then
				E.S.LabService:FX(golem.lab, "balloonpop", { p = b.part.Position, c = b.part.Color })
			end
		end
		golem.mods.limp.balloons = nil
		E:SetDrag(golem, "balloons", nil)
	end,
	cleanup = function(_E, _golem, st)
		for _, b in st.data.balloons or {} do
			World.partToObject[b.part] = nil
		end
	end,
}

-- ─────────────────────────────── STICKY ───────────────────────────────

Statuses.sticky = {
	duration = 10,
	apply = function(E, golem, st)
		E:SetLook(
			golem,
			"sticky",
			{ priority = 12, tint = Color3.fromRGB(150, 230, 60), tintAlpha = 0.35, reflectance = 0.15 }
		)
		golem.mods.limp.sticky = true
		st.data.welds = 0
		st.data.conns = {}
		local torso = torsoOf(golem)
		if torso then
			add(st, Vfx.emitter(torso, "slime", { Rate = 10, Color = ColorSequence.new(Color3.fromRGB(160, 240, 70)) }))
		end
		for _, part in golem.parts do
			local conn = part.Touched:Connect(function(other: BasePart)
				if st.data.welds >= 5 or not golem.statuses.sticky or golem.grabbedBy then
					return
				end
				if not other.CanCollide or other:IsDescendantOf(golem.model) or other.Name == "Balloon" then
					return
				end
				if other.CollisionGroup == "Debris" then
					return
				end
				st.data.welds += 1
				local weld = Instance.new("WeldConstraint")
				weld.Name = "StickyWeld"
				weld.Part0 = part
				weld.Part1 = other
				weld.Parent = part
				add(st, weld)
				E.S.LabService:FXU(golem.lab, "splat", { p = part.Position, c = Color3.fromRGB(150, 230, 60) })
			end)
			table.insert(st.data.conns, conn)
		end
	end,
	remove = function(E, golem, st)
		for _, conn in st.data.conns or {} do
			conn:Disconnect()
		end
		golem.mods.limp.sticky = nil
		E:SetLook(golem, "sticky", nil)
	end,
	cleanup = function(_E, _golem, st)
		for _, conn in st.data.conns or {} do
			conn:Disconnect()
		end
	end,
}

-- ─────────────────────────────── STINKY (sludge) ───────────────────────────────

Statuses.stinky = {
	duration = 5,
	apply = function(_E, golem, st)
		local head = golem.byName.Head
		if head then
			add(st, Vfx.emitter(head, "stink"))
		end
	end,
	tick = function(E, golem, st, _dt, labDt)
		dot(E, golem, st, 1.5, labDt, "stink")
		st.data.cough = (st.data.cough or 0.3) - labDt
		if st.data.cough <= 0 then
			st.data.cough = rand(0.9, 1.4)
			if golem.grounded then
				E:Pull(golem, Vector3.new(rand(-6, 6), 16, 0))
			end
			local head = golem.byName.Head
			if head then
				E.S.LabService:FXU(golem.lab, "cough", { p = head.Position })
			end
		end
	end,
}

-- ─────────────────────────────── STASIS marker ───────────────────────────────

Statuses.stasis = {
	duration = 5,
	apply = function(E, golem)
		E:SetLook(golem, "stasis", { priority = 55, tint = Color3.fromRGB(110, 255, 255), tintAlpha = 0.35 })
	end,
	remove = function(E, golem)
		E:SetLook(golem, "stasis", nil)
	end,
}

-- ─────────────────────────────── ASCENSION (endgame) ───────────────────────────────

local ASCEND_POSE = {
	ShoulderL = -140,
	ShoulderR = 140,
	ElbowL = 10,
	ElbowR = -10,
	HipL = -4,
	HipR = 4,
	KneeL = 0,
	KneeR = 0,
	Neck = 0,
}

local function ascendController(golem, _dt, labDt)
	local st = golem.statuses.ascension
	if not st then
		return
	end
	st.data.bob = (st.data.bob or 0) + labDt
	if math.floor(st.data.bob * 2) ~= st.data.lastBob then
		st.data.lastBob = math.floor(st.data.bob * 2)
		st.E:Pull(golem, Vector3.new(0, math.sin(st.data.bob * 2) * 4, 0))
	end
end

Statuses.ascension = {
	duration = 30,
	apply = function(E, golem, st)
		st.E = E
		local torso = torsoOf(golem)
		local head = golem.byName.Head
		if not torso or not head then
			return
		end
		E:SetLook(
			golem,
			"ascension",
			{ priority = 90, color = Color3.fromRGB(255, 246, 228), material = Enum.Material.Marble, reflectance = 0.1 }
		)
		golem.mods.gravity.ascend = -0.03
		golem.mods.damage.ascend = 0
		E:SetDrag(golem, "ascend", 1.6)
		local s = golem.scale
		local function weldDeco(part: BasePart)
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			part.Parent = golem.model
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = torso
			weld.Part1 = part
			weld.Parent = part
			add(st, part)
		end
		local halo = Instance.new("Part")
		halo.Name = "Halo"
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.18, 2.4 * s, 2.4 * s)
		halo.CFrame = head.CFrame * CFrame.new(0, 1.8 * s, 0) * CFrame.Angles(0, 0, math.rad(90))
		halo.Color = Color3.fromRGB(255, 230, 120)
		halo.Material = Enum.Material.Neon
		weldDeco(halo)
		for _, side in { -1, 1 } do
			local wing = Instance.new("Part")
			wing.Name = "Wing"
			wing.Size = Vector3.new(4.4 * s, 2.2 * s, 0.25 * s)
			wing.CFrame = torso.CFrame
				* CFrame.new(side * 2.9 * s, 0.9 * s, -1.1 * s)
				* CFrame.Angles(0, 0, math.rad(side * 24))
			wing.Color = Color3.fromRGB(255, 252, 240)
			wing.Material = Enum.Material.Neon
			wing.Transparency = 0.15
			weldDeco(wing)
		end
		add(st, Vfx.emitter(torso, "aura"))
		add(st, Vfx.emitter(torso, "gold", { Rate = 20 }))
		add(st, Vfx.light(torso, Color3.fromRGB(255, 230, 160), 26, 2.4))
		setController(golem, st, ascendController, true)
		E.S.GolemService:SetPose(golem, ASCEND_POSE, 1, 3)
		E.S.LabService:FX(golem.lab, "ascend", { p = torso.Position })
		-- Blessing shockwave: heals every other golem and showers coins.
		for _, other in golem.lab.golems do
			if other ~= golem then
				task.defer(function()
					if not other.dead then
						E.S.GolemService:Reform(other)
					end
				end)
			end
		end
		E:CoinBurst(golem.lab, torso.Position, st.source, 10)
		if st.source then
			E.S.ShopService:OnAscension(st.source)
		end
	end,
	remove = function(E, golem, st)
		golem.mods.gravity.ascend = nil
		golem.mods.damage.ascend = nil
		E:SetDrag(golem, "ascend", nil)
		E:SetLook(golem, "ascension", nil)
		clearController(E, golem, st)
	end,
}

return Statuses
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Vfx</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Server-side persistent effect instances (particle emitters and lights attached to golems).
-- One-shot bursts are sent to clients as FX events instead.

local Vfx = {}

local function seq(...): NumberSequence
	local points = { ... }
	local keypoints = {}
	for i = 1, #points, 2 do
		table.insert(keypoints, NumberSequenceKeypoint.new(points[i], points[i + 1]))
	end
	return NumberSequence.new(keypoints)
end
Vfx.seq = seq

local TEX = {
	fire = "rbxasset://textures/particles/fire_main.dds",
	sparks = "rbxasset://textures/particles/fire_sparks_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	circle = "rbxasset://textures/whiteCircle.png",
	square = "rbxasset://textures/particles/SquareParticle.png",
}
Vfx.Textures = TEX

local PRESETS = {
	fire = {
		Texture = TEX.fire,
		Rate = 28,
		Lifetime = NumberRange.new(0.35, 0.7),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(20, 20),
		Size = seq(0, 1.6, 0.5, 1.2, 1, 0),
		Transparency = seq(0, 0.15, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 60, 20)),
		Acceleration = Vector3.new(0, 12, 0),
		EmissionDirection = Enum.NormalId.Top,
		RotSpeed = NumberRange.new(-60, 60),
		Rotation = NumberRange.new(0, 360),
	},
	embers = {
		Texture = TEX.sparks,
		Rate = 14,
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(4, 9),
		SpreadAngle = Vector2.new(40, 40),
		Size = seq(0, 0.3, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 120)),
		Acceleration = Vector3.new(0, 8, 0),
		EmissionDirection = Enum.NormalId.Top,
	},
	smoke = {
		Texture = TEX.smoke,
		Rate = 6,
		Lifetime = NumberRange.new(1.2, 2.2),
		Speed = NumberRange.new(2, 4),
		Size = seq(0, 1, 1, 4),
		Transparency = seq(0, 0.6, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(60, 56, 60)),
		Acceleration = Vector3.new(0, 4, 0),
		EmissionDirection = Enum.NormalId.Top,
	},
	frost = {
		Texture = TEX.sparkle,
		Rate = 10,
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = seq(0, 0.5, 1, 0),
		LightEmission = 0.8,
		Color = ColorSequence.new(Color3.fromRGB(200, 245, 255)),
		Acceleration = Vector3.new(0, -2, 0),
	},
	sparkle = {
		Texture = TEX.sparkle,
		Rate = 12,
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		Size = seq(0, 0.6, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
	},
	shock = {
		Texture = TEX.sparkle,
		Rate = 40,
		Lifetime = NumberRange.new(0.1, 0.25),
		Speed = NumberRange.new(6, 14),
		SpreadAngle = Vector2.new(180, 180),
		Size = seq(0, 0.7, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(180, 230, 255)),
	},
	slime = {
		Texture = TEX.circle,
		Rate = 6,
		Lifetime = NumberRange.new(0.6, 1),
		Speed = NumberRange.new(0, 1),
		Size = seq(0, 0.35, 1, 0.1),
		Transparency = seq(0, 0.2, 1, 0.6),
		LightEmission = 0.3,
		Color = ColorSequence.new(Color3.fromRGB(120, 240, 90)),
		Acceleration = Vector3.new(0, -30, 0),
	},
	drip = {
		Texture = TEX.circle,
		Rate = 5,
		Lifetime = NumberRange.new(0.5, 0.8),
		Speed = NumberRange.new(0, 0.5),
		Size = seq(0, 0.22, 1, 0.12),
		Transparency = seq(0, 0.3, 1, 0.8),
		LightEmission = 0.2,
		Color = ColorSequence.new(Color3.fromRGB(140, 200, 255)),
		Acceleration = Vector3.new(0, -40, 0),
	},
	ghost = {
		Texture = TEX.glow,
		Rate = 8,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = seq(0, 1.6, 1, 0),
		Transparency = seq(0, 0.5, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(170, 255, 255)),
	},
	gold = {
		Texture = TEX.sparkle,
		Rate = 10,
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(180, 180),
		Size = seq(0, 0.7, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 120)),
	},
	acid = {
		Texture = TEX.smoke,
		Rate = 10,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(1, 3),
		Size = seq(0, 0.8, 1, 2.4),
		Transparency = seq(0, 0.5, 1, 1),
		LightEmission = 0.4,
		Color = ColorSequence.new(Color3.fromRGB(170, 255, 60)),
		Acceleration = Vector3.new(0, 4, 0),
		EmissionDirection = Enum.NormalId.Top,
	},
	stink = {
		Texture = TEX.smoke,
		Rate = 5,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(0.5, 1.5),
		Size = seq(0, 1, 1, 3),
		Transparency = seq(0, 0.55, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(130, 140, 60)),
		Acceleration = Vector3.new(0, 1.5, 0),
	},
	float = {
		Texture = TEX.sparkle,
		Rate = 10,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = seq(0, 0.5, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(210, 170, 255)),
		Acceleration = Vector3.new(0, -3, 0),
	},
	heal = {
		Texture = TEX.sparkle,
		Rate = 0,
		Lifetime = NumberRange.new(0.8, 1.2),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(60, 60),
		Size = seq(0, 0.8, 1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 140, 190)),
		EmissionDirection = Enum.NormalId.Top,
	},
	thrust = {
		Texture = TEX.fire,
		Rate = 60,
		Lifetime = NumberRange.new(0.15, 0.3),
		Speed = NumberRange.new(20, 30),
		SpreadAngle = Vector2.new(8, 8),
		Size = seq(0, 1.4, 1, 0.2),
		Transparency = seq(0, 0, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 90, 20)),
		EmissionDirection = Enum.NormalId.Bottom,
	},
	thrustSmoke = {
		Texture = TEX.smoke,
		Rate = 22,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(8, 14),
		SpreadAngle = Vector2.new(14, 14),
		Size = seq(0, 0.8, 1, 3.2),
		Transparency = seq(0, 0.4, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(200, 196, 190)),
		EmissionDirection = Enum.NormalId.Bottom,
	},
	breath = {
		Texture = TEX.fire,
		Rate = 70,
		Lifetime = NumberRange.new(0.45, 0.6),
		Speed = NumberRange.new(36, 46),
		SpreadAngle = Vector2.new(9, 9),
		Size = seq(0, 0.8, 0.4, 2.6, 1, 4),
		Transparency = seq(0, 0.05, 0.7, 0.3, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 140), Color3.fromRGB(255, 70, 20)),
		EmissionDirection = Enum.NormalId.Top,
		Drag = 2,
	},
	aura = {
		Texture = TEX.glow,
		Rate = 6,
		Lifetime = NumberRange.new(1, 1.6),
		Speed = NumberRange.new(0, 0.5),
		Size = seq(0, 4, 1, 7),
		Transparency = seq(0, 0.7, 1, 1),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 140)),
		LockedToPart = true,
	},
}

-- Creates an emitter from a preset; `overrides` replace preset fields.
function Vfx.emitter(parent: Instance, preset: string, overrides: { [string]: any }?): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Fx_" .. preset
	for key, value in PRESETS[preset] or {} do
		(emitter :: any)[key] = value
	end
	if overrides then
		for key, value in overrides do
			(emitter :: any)[key] = value
		end
	end
	emitter.Parent = parent
	return emitter
end

function Vfx.light(parent: Instance, color: Color3, range: number, brightness: number, flicker: boolean?): PointLight
	local light = Instance.new("PointLight")
	light.Name = "FxLight"
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	if flicker then
		light:AddTag("Flicker")
	end
	return light
end

-- Destroys a list of instances safely.
function Vfx.clean(list: { Instance }?)
	if not list then
		return
	end
	for _, instance in list do
		if typeof(instance) == "Instance" then
			instance:Destroy()
		end
	end
	table.clear(list)
end

return Vfx
]]></string>
            </Properties>
