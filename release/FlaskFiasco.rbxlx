	},
	{
		id = "pinball",
		name = "Pinball Wizard",
		icon = "🕹️",
		description = "Rack up 1,500 damage in the Bounce Castle.",
		order = 6,
		map = "bounce",
		golems = { { x = -10 }, { x = 10 } },
		props = {},
		zones = {},
