		Transparency = seq(0, 0.4, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(110, 190, 60)),
		LightEmission = 0.2,
	})
	floatText(d.p + Vector3.new(0, 3, 2), "🧟", Color3.fromRGB(150, 255, 90), 34, 4, 0.9)
