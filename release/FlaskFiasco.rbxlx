		d.p,
		Color3.fromRGB(255, 205, 60),
		math.clamp(d.n or 8, 4, 22),
		40,
		{ shape = "coin", material = Enum.Material.Foil, reflectance = 0.3 }
	)
	sparkles(d.p, Color3.fromRGB(255, 220, 100), 20, 20)
	for i = 0, 3 do
		task.delay(i * 0.07, function()
			play("coin", d.p)
		end)
	end
end
