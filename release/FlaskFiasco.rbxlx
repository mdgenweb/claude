            <string name="Source"><![CDATA[--!strict
-- Spawnable physics props (the "Items" tab). Built server-side by Systems/PropFactory.

export type PropInfo = {
	id: string,
	name: string,
	icon: string,
	description: string,
	unlockLevel: number,
	order: number,
}

local list: { PropInfo } = {
	{
		id = "crate",
