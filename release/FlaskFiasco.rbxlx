	ring(d.p + Vector3.new(0, 0.2, 0), (d.r or 5) + 1, d.c or Color3.fromRGB(200, 200, 255), 0.35, true)
	droplets(d.p, d.c or Color3.fromRGB(200, 200, 255), 10, 14)
end
H.steam = function(d)
	local r = d.r or 14
	burst(d.p, 26, {
		Texture = TEX.smoke,
		Lifetime = NumberRange.new(0.9, 1.7),
		Speed = NumberRange.new(r, r * 2),
		Size = seq(0, 2.5, 1, 7),
		Transparency = seq(0, 0.25, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(245, 248, 252)),
		LightEmission = 0.1,
		Drag = 3,
	})
	ring(d.p, r, Color3.fromRGB(240, 245, 250), 0.45)
	shake(0.25, d.p)
	play("sizzle", d.p, { pitch = 0.7, volume = 1.4 })
	play("whoosh", d.p, { pitch = 0.6 })
end
H.stink = function(d)
	local host = hostPart(d.p, Vector3.new(d.r or 10, 4, 2))
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = TEX.smoke
	emitter.Rate = 14 * quality()
	emitter.Lifetime = NumberRange.new(1.5, 2.5)
	emitter.Speed = NumberRange.new(0.5, 2)
	emitter.Size = seq(0, 2, 1, 5)
	emitter.Transparency = seq(0, 0.5, 1, 1)
	emitter.Color = ColorSequence.new(Color3.fromRGB(140, 150, 60))
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.Parent = host
	task.delay(d.d or 7, function()
		emitter.Enabled = false
	end)
	Debris:AddItem(host, (d.d or 7) + 3)
	play("splash", d.p, { pitch = 0.6 })
end
H.blackhole = function(d)
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.CastShadow = false
	core.Material = Enum.Material.SmoothPlastic
	core.Color = Color3.fromRGB(8, 0, 16)
	core.Size = Vector3.one * 0.5
	core.CFrame = CFrame.new(d.p)
	core.Parent = fxRoot
	local disc = Instance.new("Part")
	disc.Shape = Enum.PartType.Cylinder
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CastShadow = false
	disc.Material = Enum.Material.Neon
	disc.Color = Color3.fromRGB(170, 80, 255)
	disc.Transparency = 0.25
	disc.Size = Vector3.new(0.2, 1, 1)
	disc.CFrame = CFrame.new(d.p - Vector3.new(0, 0, 0.6)) * CFrame.Angles(0, math.rad(90), 0)
	disc.Parent = fxRoot
	local vortex = Instance.new("ParticleEmitter")
	vortex.Texture = TEX.vortex
	vortex.Rate = 30 * quality()
	vortex.Lifetime = NumberRange.new(0.6, 1)
	vortex.Speed = NumberRange.new(14, 22)
	vortex.Shape = Enum.ParticleEmitterShape.Sphere
	vortex.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	vortex.Size = seq(0, 2, 1, 0)
	vortex.LightEmission = 1
	vortex.Color = ColorSequence.new(Color3.fromRGB(200, 120, 255), Color3.fromRGB(80, 20, 160))
	vortex.Parent = core
	local streaks = Instance.new("ParticleEmitter")
	streaks.Texture = TEX.sparkle
	streaks.Rate = 40 * quality()
	streaks.Lifetime = NumberRange.new(0.5, 0.9)
	streaks.Speed = NumberRange.new(20, 34)
	streaks.Shape = Enum.ParticleEmitterShape.Sphere
	streaks.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	streaks.Size = seq(0, 0.5, 1, 0)
	streaks.LightEmission = 1
	streaks.Color = ColorSequence.new(Color3.fromRGB(240, 200, 255))
	streaks.Parent = core
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(160, 80, 255)
	light.Range = 30
	light.Brightness = 3
	light.Parent = core
	TweenService:Create(core, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Size = Vector3.one * 5.5 }):Play()
	TweenService:Create(disc, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Size = Vector3.new(0.2, 15, 15) }):Play()
	blackholes[d.id] = { core = core, disc = disc, p = d.p, t = 0 }
	shake(0.3, d.p)
	play("thunder", d.p, { pitch = 0.6 })
end
H.blackholeend = function(d)
	local entry = blackholes[d.id]
	if not entry then
		return
	end
	blackholes[d.id] = nil
	TweenService:Create(
		entry.core,
		TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
		{ Size = Vector3.one * 0.1 }
	):Play()
	TweenService:Create(
		entry.disc,
		TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
		{ Size = Vector3.new(0.2, 0.1, 0.1) }
	):Play()
	Debris:AddItem(entry.core, 0.3)
	Debris:AddItem(entry.disc, 0.3)
end
H.stasis = function(d)
	local bubble = Instance.new("Part")
	bubble.Shape = Enum.PartType.Ball
	bubble.Anchored = true
	bubble.CanCollide = false
	bubble.CanQuery = false
	bubble.CanTouch = false
	bubble.CastShadow = false
	bubble.Material = Enum.Material.ForceField
	bubble.Color = Color3.fromRGB(110, 255, 255)
	bubble.Size = Vector3.one
	bubble.CFrame = CFrame.new(d.p)
	bubble.Parent = fxRoot
	TweenService:Create(bubble, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Size = Vector3.one * (d.r or 16) * 2 })
		:Play()
	table.insert(stasisBubbles, { part = bubble, p = d.p })
	ring(d.p, d.r or 16, Color3.fromRGB(150, 255, 255), 0.5)
	play("freeze", d.p, { pitch = 0.5 })
	play("magic", d.p, { pitch = 0.6 })
end
H.stasisend = function(d)
	local best, bestIndex = nil, nil
	for i, entry in stasisBubbles do
		local dist = (entry.p - d.p).Magnitude
		if not best or dist < best then
			best, bestIndex = dist, i
		end
	end
	if bestIndex then
		local entry = table.remove(stasisBubbles, bestIndex)
		TweenService:Create(entry.part, TweenInfo.new(0.3), { Size = Vector3.one * 0.5, Transparency = 1 }):Play()
		Debris:AddItem(entry.part, 0.35)
		play("whoosh", d.p, { pitch = 1.6 })
	end
end
H.meteorcall = function(d)
	C.UIController:ScreenFlash(Color3.fromRGB(255, 120, 60), 0.15, 0.6)
	play("thunder", d.p, { pitch = 0.7 })
end
H.meteor = function(d)
	local rock = Instance.new("Part")
	rock.Shape = Enum.PartType.Ball
	rock.Size = Vector3.one * 3.2
	rock.Material = Enum.Material.CrackedLava
	rock.Color = Color3.fromRGB(80, 40, 30)
	rock.Anchored = true
	rock.CanCollide = false
	rock.CanQuery = false
	rock.CanTouch = false
	rock.CFrame = CFrame.new(d.p)
	rock.Parent = fxRoot
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = TEX.fire
	fire.Rate = 60 * quality()
	fire.Lifetime = NumberRange.new(0.3, 0.5)
	fire.Speed = NumberRange.new(2, 5)
	fire.Size = seq(0, 3, 1, 0)
	fire.LightEmission = 1
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 60, 20))
	fire.Parent = rock
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1.2, 0)
	a0.Parent = rock
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1.2, 0)
	a1.Parent = rock
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Transparency = seq(0, 0.1, 1, 1)
	trail.Parent = rock
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 18
	light.Brightness = 3
	light.Parent = rock
	meteors[d.id] = { part = rock, p = d.p, v = d.v, t = 0 }
	play("whoosh", d.p, { pitch = 0.5 })
end
H.meteorhit = function(d)
	local meteor = meteors[d.id]
	if meteor then
		meteors[d.id] = nil
		meteor.part:Destroy()
	end
end
H.tornado = function(d)
	local model = Instance.new("Model")
	model.Name = "FxTornado"
	local rings = {}
	local h = d.h or 50
	for i = 1, 10 do
		local t = (i - 1) / 9
		local radius = 3 + t * 11
		local part = Instance.new("Part")
		part.Shape = Enum.PartType.Cylinder
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.ForceField
		part.Color = Color3.fromRGB(220, 235, 255)
		part.Size = Vector3.new(h / 10 + 0.5, radius * 2, radius * 2)
		part.Parent = model
		table.insert(rings, { part = part, y = t * h, radius = radius, phase = i * 0.6 })
	end
	local host = Instance.new("Part")
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Size = Vector3.new(14, h, 4)
	host.Parent = model
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = TEX.smoke
	dust.Rate = 30 * quality()
	dust.Lifetime = NumberRange.new(0.8, 1.4)
	dust.Speed = NumberRange.new(4, 10)
	dust.Size = seq(0, 2, 1, 4)
	dust.Transparency = seq(0, 0.5, 1, 1)
	dust.Color = ColorSequence.new(Color3.fromRGB(210, 220, 235))
	dust.Shape = Enum.ParticleEmitterShape.Box
	dust.Acceleration = Vector3.new(0, 20, 0)
	dust.Parent = host
	model.Parent = fxRoot
	tornadoes[d.id] = { model = model, rings = rings, host = host, x = d.p.X, targetX = d.p.X, base = d.p, h = h }
	play("wind", d.p, { volume = 2 })
	play("whoosh", d.p, { pitch = 0.5 })
end
H.tornadomove = function(d)
	local entry = tornadoes[d.id]
	if entry then
		entry.targetX = d.x
	end
end
H.tornadoend = function(d)
	local entry = tornadoes[d.id]
	if entry then
		tornadoes[d.id] = nil
		for _, ringEntry in entry.rings do
			TweenService:Create(ringEntry.part, TweenInfo.new(0.4), { Transparency = 1 }):Play()
		end
		Debris:AddItem(entry.model, 0.45)
	end
end
H.supernova = function(d)
	local glow = Instance.new("Part")
	glow.Shape = Enum.PartType.Ball
	glow.Anchored = true
	glow.CanCollide = false
	glow.CanQuery = false
	glow.CanTouch = false
	glow.Material = Enum.Material.Neon
	glow.Color = Color3.fromRGB(255, 252, 220)
	glow.Size = Vector3.one
	glow.CFrame = CFrame.new(d.p)
	glow.Parent = fxRoot
	TweenService
		:Create(glow, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.one * 12 })
		:Play()
	flash(d.p, Color3.fromRGB(255, 250, 220), 80, 12, 1.4)
	Debris:AddItem(glow, 0.8)
	C.UIController:ScreenFlash(Color3.fromRGB(255, 255, 240), 0.6, 1.3)
	play("magic", d.p, { pitch = 0.5 })
end
H.chaos = function(d)
	sparkles(d.p, Color3.fromRGB(255, 80, 200), 20, 24)
	sparkles(d.p, Color3.fromRGB(80, 220, 255), 20, 24)
	floatText(d.p + Vector3.new(0, 4, 2), "???", Color3.fromRGB(255, 120, 220), 44, 5, 1.1)
	play("magic", d.p, { pitch = 0.7 })
end
H.fuse = function(d)
	play("sizzle", d.p)
	sparks(d.p, Color3.fromRGB(255, 220, 120), 8, 12)
end
H.crush = function(d)
	smoke(d.p, Color3.fromRGB(180, 170, 160), 10, 1.8)
	floatText(d.p + Vector3.new(0, 3, 2), "SQUASH!", Color3.fromRGB(255, 220, 90), 34, 3, 0.8)
	shake(0.35, d.p)
	play("crush", d.p)
end
H.crusherslam = function(d)
	play("whoosh", d.p, { pitch = 0.45, volume = 0.8 })
end
H.splinter = function(d)
	debris(d.p, Color3.fromRGB(170, 120, 70), 12, 34, { material = Enum.Material.Wood })
	play("crack", d.p, { pitch = 0.5 })
end
H.lavasplash = function(d)
	sparks(d.p, Color3.fromRGB(255, 160, 40), 18, 30)
	droplets(d.p, Color3.fromRGB(255, 110, 30), 10, 26)
	play("sizzle", d.p)
end
H.bumper = function(d)
	ring(d.p, 7, d.c or Color3.fromRGB(255, 90, 160), 0.25)
	flash(d.p, d.c or Color3.fromRGB(255, 90, 160), 18, 5, 0.25)
	play("boing", d.p, { pitch = 1.4 })
end
H.boing = function(d)
	play("boing", d.p)
end
H.crack = function(d)
	play("crack", d.p)
	sparkles(d.p, Color3.fromRGB(220, 245, 255), 8, 8)
end
H.cough = function(d)
	smoke(d.p, Color3.fromRGB(130, 150, 60), 4, 0.9)
end
H.splat = function(d)
	droplets(d.p, d.c or Color3.fromRGB(150, 230, 60), 8, 12)
	play("splash", d.p, { pitch = 1.8, volume = 0.6 })
end
H.immune = function(d)
	floatText(d.p, "IMMUNE", Color3.fromRGB(200, 200, 220), 26, 3, 0.8)
end
H.quake = function(d)
	ring(d.p - Vector3.new(0, 4, 0), 18, Color3.fromRGB(200, 180, 150), 0.5, true)
	smoke(d.p - Vector3.new(0, 4, 0), Color3.fromRGB(190, 170, 150), 12, 2.5)
	shake(0.55, d.p)
	play("crush", d.p)
end
H.ko = function(d)
	if d.p then
		floatText(d.p + Vector3.new(0, 4, 2), "K.O.!", Color3.fromRGB(255, 90, 90), 44, 4, 1.1)
		sparkles(d.p, Color3.fromRGB(255, 240, 120), 12, 10)
		play("oof", d.p)
	end
end
H.shatterGolem = function(d)
	local color = if d.kind == "gold"
		then Color3.fromRGB(255, 205, 60)
		elseif d.kind == "crystal" then Color3.fromRGB(170, 230, 255)
		else Color3.fromRGB(190, 240, 255)
	local small = d.small == true
	debris(d.p, color, if small then 6 else 20, if small then 25 else 45, {
		material = if d.kind == "gold" then Enum.Material.Foil else Enum.Material.Ice,
		transparency = if d.kind == "gold" then 0 else 0.2,
		reflectance = 0.25,
		minSize = 0.3,
		maxSize = if small then 0.6 else 1.1,
	})
	sparkles(d.p, color, if small then 8 else 24, 22)
	if not small then
		ring(d.p, 10, color, 0.4)
		shake(0.3, d.p)
	end
	play("crack", d.p, { pitch = 0.8 })
	play("glass", d.p, { pitch = 0.7 })
end
H.brew = function(d)
	local labModel = C.State:LabModel()
	local room = labModel and labModel:FindFirstChild("Room")
	local cauldron = room and room:FindFirstChild("Cauldron")
	local liquid = cauldron and cauldron:FindFirstChild("CauldronLiquid") :: BasePart?
	if liquid then
		liquid.Color = d.c
		local glow = liquid:FindFirstChild("LiquidGlow") :: PointLight?
		if glow then
			glow.Color = d.c
		end
		local bubbles = liquid:FindFirstChild("Bubbles") :: ParticleEmitter?
		if bubbles then
			bubbles.Color = ColorSequence.new(d.c)
			bubbles:Emit(25)
		end
	end
	local top = d.p + Vector3.new(0, 7, 0)
	sparkles(top, d.c, 30, 16)
	burst(top, 10, {
		Texture = TEX.smoke,
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(6, 12),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(25, 25),
		Size = seq(0, 1.5, 1, 4),
		Transparency = seq(0, 0.4, 1, 1),
		Color = ColorSequence.new(d.c),
		LightEmission = 0.4,
	})
	ring(top, 6, d.c, 0.4, true)
	flash(top, d.c, 26, 6, 0.6)
	play("brew", top)
end
H.reset = function(d)
	C.UIController:ScreenFlash(Color3.fromRGB(200, 170, 255), 0.25, 0.5)
	sparkles(d.p, Color3.fromRGB(200, 170, 255), 40, 40)
	play("whoosh", d.p, { pitch = 0.8 })
end
H.drop = function()
	C.GrabController:ForceDrop()
end

-- ─────────────────────────────── per-frame updates ───────────────────────────────

local function update(dt: number)
	local ts = C.State:TimeScale()
	local labDt = dt * ts
	for id, p in projectiles do
		p.t += labDt
		if p.t > 5 then
			p.model:Destroy()
			projectiles[id] = nil
			continue
		end
		local pos = p.o + p.v * p.t + Vector3.new(0, -p.g, 0) * (0.5 * p.t * p.t)
		p.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, 0, p.t * p.spin))
	end
	for id, m in meteors do
		m.t += labDt
		if m.t > 4 then
			m.part:Destroy()
			meteors[id] = nil
			continue
		end
		m.part.CFrame = CFrame.new(m.p + m.v * m.t) * CFrame.Angles(m.t * 4, m.t * 3, 0)
	end
	for _, entry in blackholes do
		entry.t += labDt
		entry.disc.CFrame = CFrame.new(entry.p - Vector3.new(0, 0, 0.6))
			* CFrame.Angles(0, math.rad(90), 0)
			* CFrame.Angles(entry.t * 4, 0, 0)
		entry.core.CFrame = CFrame.new(entry.p)
	end
	for _, entry in tornadoes do
		entry.x += (entry.targetX - entry.x) * math.min(1, dt * 6)
		local t = os.clock()
		for _, ringEntry in entry.rings do
			local wobble = math.sin(t * 3 + ringEntry.phase) * (1 + ringEntry.y * 0.04)
			ringEntry.part.CFrame = CFrame.new(entry.x + wobble, entry.base.Y + ringEntry.y, entry.base.Z)
				* CFrame.Angles(0, t * 6 * (1 + ringEntry.phase * 0.1), math.rad(90))
			ringEntry.part.Transparency = 0.25 + math.sin(t * 5 + ringEntry.phase) * 0.1
		end
		entry.host.CFrame = CFrame.new(entry.x, entry.base.Y + entry.h / 2, entry.base.Z)
	end
end

-- ─────────────────────────────── wiring ───────────────────────────────

function VFXController:Init(controllers)
	C = controllers
	self.C = controllers
end

function VFXController:Start()
	fxRoot = Instance.new("Folder")
	fxRoot.Name = "ClientFX"
	fxRoot.Parent = Workspace

	local function dispatch(kind: string, payload)
		if kind == "chaos" or (kind == "coins" and payload.a) then
			self.HudEvent:Fire(kind, payload)
			return
		end
		if kind == "shatter" and payload.kind then
			kind = "shatterGolem"
		end
		local handler = H[kind]
		if handler then
			local ok, err = pcall(handler, payload)
			if not ok then
				warn("[VFX]", kind, err)
			end
		end
	end
	Net.event("FX").OnClientEvent:Connect(dispatch)
	Net.unreliable("FXU").OnClientEvent:Connect(dispatch)
	RunService.RenderStepped:Connect(update)

	-- Clear lingering local effects when switching labs.
	C.State.LabChanged:Connect(function(lab, previous)
		if previous and previous.ownerId ~= lab.ownerId then
			for id, p in projectiles do
				p.model:Destroy()
				projectiles[id] = nil
			end
			for id, entry in tornadoes do
				entry.model:Destroy()
				tornadoes[id] = nil
			end
			for id, entry in blackholes do
				entry.core:Destroy()
				entry.disc:Destroy()
				blackholes[id] = nil
			end
		end
	end)
end

-- Public helpers for other controllers / UI.
VFXController.Sparkles = function(position: Vector3, color: Color3, count: number)
	sparkles(position, color, count, 14)
end
VFXController.Ring = ring
VFXController.FloatText = floatText

return VFXController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="80">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client bootstrap: requires every controller, gives them a shared table and starts them in order.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Potions = require(Shared.Data.Potions)
local Recipes = require(Shared.Data.Recipes)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local ORDER = {
	{ "State", Controllers },
	{ "CameraController", Controllers },
	{ "InputController", Controllers },
	{ "SoundController", Controllers },
	{ "LightingController", Controllers },
	{ "VFXController", Controllers },
	{ "AmbientController", Controllers },
	{ "GrabController", Controllers },
	{ "ToolController", Controllers },
	{ "UIController", UI },
	{ "CursorController", Controllers },
}

local controllers = {
	PotionIndex = Recipes.buildIndex(Potions.List),
}
for _, entry in ORDER do
	controllers[entry[1]] = require(entry[2]:WaitForChild(entry[1]))
end

-- State hooks up remotes first so nothing replicated early is missed.
controllers.State:Init()
for _, entry in ORDER do
	local controller = controllers[entry[1]]
	if entry[1] ~= "State" and controller.Init then
		controller:Init(controllers)
	end
end
for _, entry in ORDER do
	local controller = controllers[entry[1]]
	if controller.Start then
		local ok, err = pcall(controller.Start, controller)
		if not ok then
			warn(("[Main] %s failed to start: %s"):format(entry[1], tostring(err)))
		end
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">BrewPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The cauldron: pick 2-3 ingredients, watch the brew colour mix, BREW, and get the result.
-- Known recipes on the right refill the cauldron in one click.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Ingredients = require(Shared.Data.Ingredients)
local Potions = require(Shared.Data.Potions)
local Recipes = require(Shared.Data.Recipes)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local BrewPanel = {}

function BrewPanel:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	self.selected = {}
	local modal = C.Modal({ parent = ui.modals, title = "🧪 Cauldron", size = Vector2.new(1180, 700) })
	self.modal = modal
	modal.onClose = function()
		ui:PanelClosed("brew")
	end
	local body = modal.body

	-- Left: ingredient pouch.
	C.text({
		parent = body,
		text = "Ingredient Pouch",
		type = "Heading",
		size = UDim2.fromOffset(440, 30),
		color = Theme.Color.Text.Secondary,
	})
	local pouch = C.Scroll({ parent = body, size = UDim2.fromOffset(450, 540), position = UDim2.fromOffset(0, 40) })
	C.grid(pouch, Vector2.new(140, 132), Theme.Space.SM)
	C.padding(pouch, 4)
	self.pouch = pouch
	self.cards = {}
	for _, ingredient in Ingredients.List do
		self.cards[ingredient.id] = self:_ingredientCard(pouch, ingredient)
	end

	-- Centre: cauldron with slots and brew button.
	local center = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(360, 580),
		Position = UDim2.fromOffset(470, 0),
		Parent = body,
	})
	local _, bowl = C.card({
		parent = center,
		size = UDim2.fromOffset(340, 300),
		position = UDim2.fromOffset(10, 10),
		radius = UDim.new(0.5, 0),
		stroke = Theme.Color.Stroke.Strong,
	})
	local liquid = C.frame({
		parent = bowl,
		color = Color3.fromRGB(110, 255, 140),
		size = UDim2.fromOffset(250, 120),
		position = UDim2.fromScale(0.5, 0.42),
		anchor = Vector2.new(0.5, 0.5),
		radius = UDim.new(0.5, 0),
	})
	local liquidGradient = C.gradient(liquid, Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150))
	local _ = liquidGradient
	self.liquid = liquid
	self.bubbles = {}
	for i = 1, 7 do
		local bubble = C.frame({
			parent = liquid,
			color = Color3.new(1, 1, 1),
			transparency = 0.5,
			size = UDim2.fromOffset(14, 14),
			position = UDim2.fromScale(0.15 + i * 0.1, 0.6),
			anchor = Vector2.new(0.5, 0.5),
			radius = UDim.new(0.5, 0),
		})
		table.insert(self.bubbles, { frame = bubble, phase = i * 0.7 })
	end
	game:GetService("RunService").RenderStepped:Connect(function()
		if not modal.isOpen() then
			return
		end
		local t = os.clock()
		for _, b in self.bubbles do
			local y = 0.75 - ((t * 0.6 + b.phase) % 1) * 0.6
			b.frame.Position = UDim2.fromScale(b.frame.Position.X.Scale, y)
			b.frame.BackgroundTransparency = 0.3 + (1 - y) * 0.6
		end
	end)
	-- Ingredient slots.
	local slots = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(340, 90),
		Position = UDim2.fromOffset(10, 320),
		Parent = center,
	})
	C.list(slots, Enum.FillDirection.Horizontal, Theme.Space.MD, Enum.HorizontalAlignment.Center)
	self.slotButtons = {}
	for i = 1, 3 do
		local slot = C.new("TextButton", {
			Name = "Slot" .. i,
			AutoButtonColor = false,
			Text = "",
			BackgroundColor3 = Theme.Color.Surface.Sunken,
			Size = UDim2.fromOffset(90, 90),
			LayoutOrder = i,
			Parent = slots,
		})
		C.corner(slot, UDim.new(0.5, 0))
		local stroke = C.stroke(slot, Theme.Color.Stroke.Subtle, Theme.Stroke.Emphasis)
		local icon = C.text({
			parent = slot,
			text = "+",
			type = "Title",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromScale(1, 1),
			color = Theme.Color.Text.Muted,
			outline = false,
		})
		C.interactive(slot)
		slot.Activated:Connect(function()
			if self.selected[i] then
				table.remove(self.selected, i)
				C.sound("click")
				self:Refresh()
			end
		end)
		self.slotButtons[i] = { button = slot, icon = icon, stroke = stroke }
	end
	self.mixLabel = C.text({
		parent = center,
		text = "Add 2 or 3 ingredients",
		type = "Label",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.fromOffset(0, 420),
		color = Theme.Color.Text.Secondary,
		wrap = true,
	})
	self.brewButton = C.Button({
		parent = center,
		text = "BREW!",
		icon = "✨",
		variant = "primary",
		size = "lg",
		width = 300,
		position = UDim2.fromOffset(30, 456),
		keybind = "Enter",
		onClick = function()
			self:Brew()
		end,
	})
	self.clearButton = C.Button({
		parent = center,
		text = "Empty cauldron",
		variant = "ghost",
		size = "sm",
		width = 200,
		position = UDim2.fromOffset(80, 530),
		onClick = function()
			table.clear(self.selected)
			self:Refresh()
		end,
	})
	self.resultLabel = C.text({
		parent = center,
		text = "",
		type = "Label",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 40),
		position = UDim2.fromOffset(0, 566),
		wrap = true,
		color = Theme.Color.Accent.Gold,
	})

	-- Right: recipe book.
	C.text({
		parent = body,
		text = "Recipe Book",
		type = "Heading",
		size = UDim2.fromOffset(280, 30),
		position = UDim2.fromOffset(850, 0),
		color = Theme.Color.Text.Secondary,
	})
	local book = C.Scroll({ parent = body, size = UDim2.fromOffset(280, 500), position = UDim2.fromOffset(850, 40) })
	C.list(book, Enum.FillDirection.Vertical, Theme.Space.SM)
	C.padding(book, 4)
	self.book = book
	C.Button({
		parent = body,
		text = "Buy ingredients",
		icon = "🛒",
		size = "sm",
		width = 280,
		position = UDim2.fromOffset(850, 552),
		onClick = function()
			ui:Open("shop")
			local shop = ui.panels.shop
			if shop and shop.ShowTab then
				shop:ShowTab("ingredients")
			end
		end,
	})

	controllers.State.Changed:Connect(function(key)
		if key == "*" or key == "ingredients" or key == "discovered" or key == "level" then
			if modal.isOpen() then
				self:Refresh()
			end
		end
	end)
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if modal.isOpen() and not processed and input.KeyCode == Enum.KeyCode.Return then
			self:Brew()
		end
	end)
end

function BrewPanel:_ingredientCard(parent: Instance, ingredient)
	local button = C.new("TextButton", {
		Name = ingredient.id,
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Theme.Color.Surface.Raised,
		LayoutOrder = ingredient.order,
		Parent = parent,
	})
	C.corner(button, Theme.Radius.MD)
	local stroke = C.stroke(button, Theme.rarityColor(ingredient.rarity), Theme.Stroke.Default)
	C.gradient(button, Theme.Color.Surface.Raised, Theme.Color.Surface.Sunken)
	C.text({
		parent = button,
		text = ingredient.icon,
		type = "Title",
		textSize = 44,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 60),
		position = UDim2.fromOffset(0, 6),
		outline = false,
	})
	C.text({
		parent = button,
		text = ingredient.name,
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, -8, 0, 34),
		position = UDim2.fromOffset(4, 66),
		wrap = true,
	})
	local count = C.text({
		parent = button,
		text = "x0",
		type = "Label",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.fromOffset(0, 102),
		color = Theme.Color.Accent.Gold,
	})
	local lock = C.text({
		parent = button,
		text = "",
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.fromOffset(0, 102),
		color = Theme.Color.Text.Muted,
		visible = false,
	})
	C.interactive(button)
	button.Activated:Connect(function()
		self:Add(ingredient.id)
	end)
	button.MouseEnter:Connect(function()
		C.showTooltip(
			ingredient.name .. "  ·  " .. ingredient.rarity,
			ingredient.description,
			Theme.rarityColor(ingredient.rarity)
		)
	end)
	button.MouseLeave:Connect(function()
		C.hideTooltip()
	end)
	return { button = button, count = count, lock = lock, stroke = stroke }
end

local function blend(ids: { string }): Color3
	if #ids == 0 then
		return Color3.fromRGB(110, 255, 140)
	end
	local r, g, b = 0, 0, 0
	for _, id in ids do
		local color = Ingredients.ById[id].color
		r += color.R
		g += color.G
		b += color.B
	end
	return Color3.new(r / #ids, g / #ids, b / #ids)
end

function BrewPanel:Add(id: string)
	local data = self.C.State.data
	if not data then
		return
	end
	if #self.selected >= 3 then
		self.ui:Toast("The cauldron holds 3 ingredients max.", "info")
		return
	end
	local need = Recipes.requirements(self.selected)
	if (data.ingredients[id] or 0) <= (need[id] or 0) then
		C.sound("error")
		self.ui:Toast("Not enough " .. Ingredients.ById[id].name .. ". Buy more in the shop!", "error")
		return
	end
	table.insert(self.selected, id)
	C.sound("click")
	self.C.SoundController:Play("bubble", nil, { ui = true, pitch = 1 + #self.selected * 0.15 })
	C.pulse(self.liquid, 1.08)
	self:Refresh()
end

function BrewPanel:Brew()
	if #self.selected < 2 or self.brewing then
		if #self.selected < 2 then
			self.ui:Toast("Add at least 2 ingredients.", "info")
		end
		return
	end
	self.brewing = true
	self.brewButton.setDisabled(true)
	self.brewButton.setText("Brewing...")
	self.C.SoundController:Play("brew", nil, { ui = true })
	-- Swirl animation while the server resolves the brew.
	for _ = 1, 3 do
		C.pulse(self.liquid, 1.15)
		task.wait(0.18)
	end
	local ids = table.clone(self.selected)
	local result = Net.func("Brew"):InvokeServer(ids)
	self.brewing = false
	self.brewButton.setDisabled(false)
	self.brewButton.setText("BREW!")
	if not result or not result.ok then
		self.ui:Toast(result and result.reason or "The brew fizzled.", "error")
		return
	end
	local potion = Potions.ById[result.potionId]
	self.liquid.BackgroundColor3 = potion.color
	if result.potionId == Potions.FallbackId then
		self.resultLabel.Text = "💩 Murky Sludge... " .. (if result.hint then "Hint: " .. result.hint else "")
		self.resultLabel.TextColor3 = Theme.Color.Text.Secondary
	else
		self.resultLabel.Text = ("Brewed %d× %s!%s"):format(
			result.bottles,
			potion.name,
			if result.mastered then "  ⭐ MASTERED (∞)" else ""
		)
		self.resultLabel.TextColor3 = Theme.rarityColor(potion.rarity)
	end
	-- Keep the same recipe ready if the player can afford it again.
	local data = self.C.State.data
	if data and not Recipes.canAfford(data.ingredients, ids) then
		table.clear(self.selected)
	end
	self:Refresh()
	-- Select the new potion for quick testing.
	if result.potionId ~= Potions.FallbackId then
		self.C.State:Select({ kind = "potion", id = result.potionId })
	end
	if result.discovered then
		self.ui:Close()
	end
end

function BrewPanel:Refresh()
	local data = self.C.State.data
	if not data then
		return
	end
	local need = Recipes.requirements(self.selected)
	for id, card in self.cards do
		local ingredient = Ingredients.ById[id]
		local owned = data.ingredients[id] or 0
		local left = owned - (need[id] or 0)
		local locked = ingredient.price > 0 and data.level < ingredient.unlockLevel and owned == 0
		card.count.Text = "x" .. left
		card.count.Visible = not locked
		card.lock.Visible = locked
		card.lock.Text = "🔒 Lv " .. ingredient.unlockLevel
		card.button.BackgroundTransparency = if left <= 0 then 0.55 else 0
		card.button.Visible = not (ingredient.price == 0 and owned == 0)
	end
	for i, slot in self.slotButtons do
		local id = self.selected[i]
		if id then
			local ingredient = Ingredients.ById[id]
			slot.icon.Text = ingredient.icon
			slot.icon.TextColor3 = Theme.Color.Text.Primary
			slot.stroke.Color = ingredient.color
		else
			slot.icon.Text = "+"
			slot.icon.TextColor3 = Theme.Color.Text.Muted
			slot.stroke.Color = Theme.Color.Stroke.Subtle
		end
	end
	C.tween(self.liquid, Theme.Motion.Count, { BackgroundColor3 = blend(self.selected) })
	if #self.selected >= 2 then
		local known = Recipes.resolve(self.C.PotionIndex, self.selected)
		if known and data.discovered[known] then
			self.mixLabel.Text = "Known recipe: " .. Potions.ById[known].name
		else
			self.mixLabel.Text = "Unknown mix... what will happen?"
		end
	else
		self.mixLabel.Text = "Add 2 or 3 ingredients"
	end
	self.brewButton.setDisabled(#self.selected < 2)

	-- Recipe book.
	for _, child in self.book:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local count = 0
	for _, potion in Potions.List do
		if data.discovered[potion.id] and #potion.recipe >= 2 then
			count += 1
			local affordable = Recipes.canAfford(data.ingredients, potion.recipe)
			local icons = {}
			for _, id in potion.recipe do
				table.insert(icons, Ingredients.ById[id].icon)
			end
			local row = C.new("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = Theme.Color.Surface.Raised,
				BackgroundTransparency = if affordable then 0 else 0.5,
				Size = UDim2.new(1, -8, 0, 64),
				LayoutOrder = potion.order,
				Parent = self.book,
			})
			C.corner(row, Theme.Radius.MD)
			C.stroke(row, Theme.rarityColor(potion.rarity), 1)
			C.BottleIcon({
				parent = row,
				potion = potion,
				size = UDim2.fromOffset(56, 56),
				position = UDim2.fromOffset(4, 4),
			})
			C.text({
				parent = row,
				text = potion.name,
				type = "Caption",
				size = UDim2.new(1, -70, 0, 26),
				position = UDim2.fromOffset(64, 6),
				color = Theme.rarityColor(potion.rarity),
				truncate = true,
			})
			C.text({
				parent = row,
				text = table.concat(icons, " + ") .. (if self.C.State:IsMastered(potion.id) then "   ⭐" else ""),
				type = "Label",
				size = UDim2.new(1, -70, 0, 26),
				position = UDim2.fromOffset(64, 32),
				outline = false,
			})
			C.interactive(row)
			row.Activated:Connect(function()
				if not affordable then
					C.sound("error")
					self.ui:Toast("Missing ingredients for " .. potion.name, "error")
					return
				end
				C.sound("click")
				self.selected = table.clone(potion.recipe)
				self:Refresh()
			end)
		end
	end
	if count == 0 then
		C.text({
			parent = self.book,
			text = "Discovered recipes show up here. Try mixing two of the same ingredient first!",
			type = "Caption",
			wrap = true,
			size = UDim2.new(1, -8, 0, 80),
			color = Theme.Color.Text.Muted,
		})
	end
end

function BrewPanel:Open()
	self.resultLabel.Text = ""
	self:Refresh()
	self.modal.open()
end

function BrewPanel:Close()
	self.modal.close()
end

return BrewPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">ChallengesPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Quests: today's 3 daily challenges (with a reset countdown) and the Trials ladder.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Challenges = require(Shared.Data.Challenges)
local Format = require(Shared.Util.Format)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local ChallengesPanel = {}

function ChallengesPanel:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local modal = C.Modal({ parent = ui.modals, title = "🏆 Quests", size = Vector2.new(1100, 690) })
	self.modal = modal
	modal.onClose = function()
		ui:PanelClosed("challenges")
	end
	self.tab = "daily"
	self.tabs = C.Tabs({
		parent = modal.body,
		tabs = {
			{ id = "daily", label = "Daily", icon = "📅" },
			{ id = "trials", label = "Trials", icon = "⚔️" },
		},
		onSelect = function(id)
			self.tab = id
			self:Refresh()
		end,
	})
	self.reset = C.text({
		parent = modal.body,
		text = "",
		type = "Label",
		alignX = Enum.TextXAlignment.Right,
		size = UDim2.fromOffset(400, 30),
		position = UDim2.new(1, 0, 0, 8),
		anchor = Vector2.new(1, 0),
		color = Theme.Color.Text.Secondary,
	})
	self.content = C.Scroll({ parent = modal.body, size = UDim2.new(1, 0, 1, -60), position = UDim2.fromOffset(0, 60) })
	C.list(self.content, Enum.FillDirection.Vertical, Theme.Space.MD)
	C.padding(self.content, 4)
	controllers.State.Changed:Connect(function(key)
		if modal.isOpen() and (key == "*" or key == "daily" or key == "trials") then
			self:Refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if modal.isOpen() and self.tab == "daily" then
				local secondsLeft = 86400 - (os.time() % 86400)
				self.reset.Text = "New challenges in " .. Format.duration(secondsLeft)
			end
		end
	end)
end

function ChallengesPanel:ShowTab(id: string)
	self.tabs.select(id)
end

function ChallengesPanel:_clear()
	for _, child in self.content:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function ChallengesPanel:_daily(data)
	self.reset.Visible = true
	local done = 0
	for index, challenge in data.daily.list do
		local template = Challenges.DailyById[challenge.id]
		if not template then
			continue
		end
		if challenge.done then
			done += 1
		end
		local tierNames = { "Easy", "Medium", "Hard" }
		local tierColors = { Theme.Color.State.Success, Theme.Color.State.Warning, Theme.Color.State.Danger }
		local _, card = C.card({
			parent = self.content,
			size = UDim2.new(1, -12, 0, 118),
			order = index,
			radius = Theme.Radius.LG,
			stroke = if challenge.done then Theme.Color.State.Success else Theme.Color.Stroke.Subtle,
		})
		C.text({
			parent = card,
			text = template.icon,
			type = "Title",
			textSize = 52,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromOffset(90, 118),
			outline = false,
		})
		C.text({
			parent = card,
			text = template.text:format(challenge.target),
			type = "Heading",
			size = UDim2.new(1, -330, 0, 34),
			position = UDim2.fromOffset(96, 16),
		})
		local chip = C.frame({
			parent = card,
			color = tierColors[challenge.tier] or Theme.Color.State.Info,
			size = UDim2.fromOffset(80, 24),
			position = UDim2.fromOffset(96, 54),
			radius = Theme.Radius.Pill,
		})
		C.text({
			parent = chip,
			text = tierNames[challenge.tier] or "",
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromScale(1, 1),
			color = Theme.Color.Text.Inverse,
			outline = false,
		})
		local bar = C.Progress({
			parent = card,
			size = UDim2.new(1, -330, 0, 18),
			position = UDim2.fromOffset(96, 86),
			showLabel = true,
			color = Theme.Color.Accent.Lime,
			color2 = Theme.Color.State.Success,
		})
		bar.set(
			challenge.progress / math.max(challenge.target, 1),
			("%s / %s"):format(Format.commas(challenge.progress), Format.commas(challenge.target)),
			true
		)
		local coins = Challenges.DailyRewards.coins[challenge.tier] or 60
		local xp = Challenges.DailyRewards.xp[challenge.tier] or 50
		C.text({
			parent = card,
			text = if challenge.done then "✅ Done!" else ("+%d 🪙   +%d XP"):format(coins, xp),
			type = "Heading",
			alignX = Enum.TextXAlignment.Right,
			size = UDim2.fromOffset(220, 40),
			position = UDim2.new(1, -20, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = if challenge.done then Theme.Color.State.Success else Theme.Color.Accent.Gold,
		})
	end
	local _, bonus = C.card({
		parent = self.content,
		size = UDim2.new(1, -12, 0, 80),
		order = 10,
		radius = Theme.Radius.LG,
		stroke = if data.daily.bonusClaimed then Theme.Color.State.Success else Theme.Color.Stroke.Gold,
	})
	C.text({
		parent = bonus,
		text = ("🎁 Finish all 3 for a free Mystery Flask!  (%d/3)"):format(done),
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		color = if data.daily.bonusClaimed then Theme.Color.State.Success else Theme.Color.Accent.Gold,
	})
end

function ChallengesPanel:_trials(data)
	self.reset.Visible = true
	local totalStars = 0
	for _, record in data.trials do
		totalStars += record.stars or 0
	end
	self.reset.Text = ("Total: %d ★  ·  Magnum Opus needs %d ★"):format(totalStars, 20)
	local previousCleared = true
	for _, trial in Challenges.Trials do
		local record = data.trials[trial.id]
		local starsOk = not trial.requiresStars or totalStars >= trial.requiresStars
		local unlocked = previousCleared and starsOk
		local _, card = C.card({
			parent = self.content,
			size = UDim2.new(1, -12, 0, 104),
			order = trial.order,
			radius = Theme.Radius.LG,
			stroke = if trial.final
				then Theme.Color.Rarity.Mythic
				elseif record then Theme.Color.Stroke.Gold
				else Theme.Color.Stroke.Subtle,
		})
		C.text({
			parent = card,
			text = if unlocked then trial.icon else "🔒",
			type = "Title",
			textSize = 48,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromOffset(90, 104),
			outline = false,
		})
		C.text({
			parent = card,
			text = ("%d. %s"):format(trial.order, trial.name),
			type = "Heading",
			size = UDim2.new(1, -420, 0, 32),
			position = UDim2.fromOffset(96, 12),
			color = if trial.final then Theme.Color.Rarity.Mythic else Theme.Color.Text.Primary,
		})
		C.text({
			parent = card,
			text = trial.description,
			type = "Caption",
			wrap = true,
			size = UDim2.new(1, -420, 0, 40),
			position = UDim2.fromOffset(96, 46),
			color = Theme.Color.Text.Secondary,
		})
		local stars = record and record.stars or 0
		C.text({
			parent = card,
			text = string.rep("★", stars) .. string.rep("☆", 3 - stars),
			type = "Title",
			textSize = 34,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromOffset(140, 40),
			position = UDim2.new(1, -330, 0, 14),
			color = Theme.Color.Accent.Gold,
		})
		C.text({
			parent = card,
			text = if record then "Best " .. Format.seconds(record.best) else ("3★ ≤ %ds"):format(trial.stars[3]),
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromOffset(140, 22),
			position = UDim2.new(1, -330, 0, 58),
			color = Theme.Color.Text.Muted,
		})
		local button = C.Button({
			parent = card,
			text = if not unlocked
				then (if not previousCleared then "Locked" else ("Needs %d★"):format(trial.requiresStars or 0))
				elseif record then "Replay"
				else "Start",
			icon = if unlocked then "▶" else nil,
			variant = if unlocked and not record then "primary" else "secondary",
			width = 160,
			size = "md",
			position = UDim2.new(1, -20, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			onClick = function()
				local result = Net.func("TrialRequest"):InvokeServer("start", trial.id)
				if result and result.ok then
					self.ui:Close()
				elseif result then
					self.ui:Toast(result.reason or "Locked", "error")
				end
			end,
		})
		button.setDisabled(not unlocked)
		previousCleared = record ~= nil
	end
end

function ChallengesPanel:Refresh()
	local data = self.C.State.data
	if not data then
		return
	end
	self:_clear()
	if self.tab == "daily" then
		self:_daily(data)
	else
		self:_trials(data)
	end
end

function ChallengesPanel:Open()
	self:Refresh()
	self.modal.open()
end

function ChallengesPanel:Close()
	self.modal.close()
end

return ChallengesPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">CodexPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Codex: every potion (silhouettes + hints until discovered), mastery progress, and reactions.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Ingredients = require(Shared.Data.Ingredients)
local Potions = require(Shared.Data.Potions)
local Reactions = require(Shared.Data.Reactions)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local CodexPanel = {}

function CodexPanel:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local modal = C.Modal({ parent = ui.modals, title = "📖 Alchemist's Codex", size = Vector2.new(1180, 700) })
	self.modal = modal
	modal.onClose = function()
		ui:PanelClosed("codex")
	end
	local body = modal.body
	self.tab = "potions"
	C.Tabs({
		parent = body,
		tabs = {
			{ id = "potions", label = "Potions", icon = "🧪" },
			{ id = "reactions", label = "Reactions", icon = "⚗️" },
		},
		onSelect = function(id)
			self.tab = id
			self:Refresh()
		end,
	})
	self.progress = C.Progress({
		parent = body,
		size = UDim2.fromOffset(420, 22),
		position = UDim2.new(1, 0, 0, 10),
		anchor = Vector2.new(1, 0),
		showLabel = true,
		color = Theme.Color.Accent.Magenta,
		color2 = Theme.Color.Accent.Gold,
	})
	self.grid = C.Scroll({ parent = body, size = UDim2.fromOffset(700, 540), position = UDim2.fromOffset(0, 60) })
	C.grid(self.grid, Vector2.new(128, 150), Theme.Space.SM)
	C.padding(self.grid, 4)

	local _, detail = C.card({
		parent = body,
		size = UDim2.fromOffset(400, 540),
		position = UDim2.fromOffset(730, 60),
		radius = Theme.Radius.LG,
	})
	self.detail = detail
	controllers.State.Changed:Connect(function(key)
		if modal.isOpen() and (key == "*" or key == "discovered" or key == "brewCount" or key == "reactions") then
			self:Refresh()
		end
	end)
end

function CodexPanel:_clearDetail()
	for _, child in self.detail:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function CodexPanel:ShowPotion(potion)
	local data = self.C.State.data
	self:_clearDetail()
	local known = data.discovered[potion.id] ~= nil
	local color = Theme.rarityColor(potion.rarity)
	C.BottleIcon({
		parent = self.detail,
		potion = potion,
		silhouette = not known,
		size = UDim2.fromOffset(200, 200),
		position = UDim2.new(0.5, 0, 0, 10),
		anchor = Vector2.new(0.5, 0),
		spin = known,
	})
	C.text({
		parent = self.detail,
		text = if known then potion.name else "???",
		type = "Title",
		textSize = 32,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 40),
		position = UDim2.fromOffset(0, 214),
		color = color,
	})
	local chip = C.frame({
		parent = self.detail,
		color = color,
		size = UDim2.fromOffset(130, 26),
		position = UDim2.new(0.5, 0, 0, 258),
		anchor = Vector2.new(0.5, 0),
		radius = Theme.Radius.Pill,
	})
	C.text({
		parent = chip,
		text = potion.rarity:upper(),
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		color = Theme.Color.Text.Inverse,
		outline = false,
	})
	C.text({
		parent = self.detail,
		text = if known then potion.description else ("Hint: " .. potion.hint),
		type = "Body",
		textSize = 18,
		alignX = Enum.TextXAlignment.Center,
		wrap = true,
		size = UDim2.new(1, -40, 0, 80),
		position = UDim2.fromOffset(20, 294),
		color = Theme.Color.Text.Secondary,
	})
	if known and #potion.recipe > 0 then
		local parts = {}
		for _, id in potion.recipe do
			local ingredient = Ingredients.ById[id]
			table.insert(parts, ingredient.icon .. " " .. ingredient.name)
		end
		C.text({
			parent = self.detail,
			text = table.concat(parts, "  +  "),
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, -30, 0, 50),
			position = UDim2.fromOffset(15, 380),
		})
		local brews = data.brewCount[potion.id] or 0
		local mastery = Config.Potions.MasteryBrews
		local bar = C.Progress({
			parent = self.detail,
			size = UDim2.new(1, -60, 0, 18),
			position = UDim2.fromOffset(30, 446),
			showLabel = true,
		})
		bar.set(
			math.min(brews / mastery, 1),
			if brews >= mastery
				then "⭐ MASTERED: infinite bottles"
				else ("Mastery %d / %d brews"):format(brews, mastery),
			true
		)
		C.text({
			parent = self.detail,
			text = ("Bottles: %s   ·   Throw radius: %d"):format(
				if brews >= mastery then "∞" else tostring(data.potions[potion.id] or 0),
				potion.radius
			),
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 24),
			position = UDim2.fromOffset(0, 476),
			color = Theme.Color.Text.Muted,
		})
	elseif not known and potion.id == Potions.FinalId then
		C.text({
			parent = self.detail,
			text = "Needs the Philosopher's Stone from the final trial: the Magnum Opus.",
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, -30, 0, 60),
			position = UDim2.fromOffset(15, 390),
			color = Theme.Color.Rarity.Mythic,
		})
	end
end

function CodexPanel:Refresh()
	local data = self.C.State.data
	if not data then
		return
	end
	for _, child in self.grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if self.tab == "potions" then
		local discovered, total = 0, 0
		local first
		for _, potion in Potions.List do
			total += 1
			local known = data.discovered[potion.id] ~= nil
			if known then
				discovered += 1
			end
			local card = C.new("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = Theme.Color.Surface.Raised,
				LayoutOrder = potion.order,
				Parent = self.grid,
			})
			C.corner(card, Theme.Radius.MD)
			C.stroke(
				card,
				if known then Theme.rarityColor(potion.rarity) else Theme.Color.Stroke.Subtle,
				Theme.Stroke.Default
			)
			C.gradient(card, Theme.Color.Surface.Raised, Theme.Color.Surface.Sunken)
			C.BottleIcon({
				parent = card,
				potion = potion,
				silhouette = not known,
				size = UDim2.fromOffset(96, 96),
				position = UDim2.new(0.5, 0, 0, 6),
				anchor = Vector2.new(0.5, 0),
			})
			C.text({
				parent = card,
				text = if known then potion.name else "???",
				type = "Caption",
				alignX = Enum.TextXAlignment.Center,
				wrap = true,
				size = UDim2.new(1, -8, 0, 40),
				position = UDim2.fromOffset(4, 104),
				color = if known then Theme.Color.Text.Primary else Theme.Color.Text.Muted,
			})
			if self.C.State:IsMastered(potion.id) then
				C.text({
					parent = card,
					text = "⭐",
					type = "Label",
					size = UDim2.fromOffset(24, 24),
					position = UDim2.fromOffset(6, 4),
					outline = false,
				})
			end
			C.interactive(card)
			card.Activated:Connect(function()
				C.sound("click")
				self:ShowPotion(potion)
			end)
			first = first or potion
		end
		self.progress.set(discovered / total, ("%d / %d potions discovered"):format(discovered, total))
		if first then
			self:ShowPotion(first)
		end
	else
		local found, total = 0, #Reactions.List
		self:_clearDetail()
		C.text({
			parent = self.detail,
			text = "Reactions happen when effects collide. Discover them all for bonus XP!",
			type = "Body",
			wrap = true,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, -40, 0, 120),
			position = UDim2.fromOffset(20, 30),
			color = Theme.Color.Text.Secondary,
		})
		for index, reaction in Reactions.List do
			local known = data.reactions[reaction.id] == true
			if known then
				found += 1
			end
			local card = C.frame({
				parent = self.grid,
				color = Theme.Color.Surface.Raised,
				order = index,
				stroke = if known then reaction.color else Theme.Color.Stroke.Subtle,
			})
			C.text({
				parent = card,
				text = if known then reaction.icon else "❔",
				type = "Title",
				textSize = 46,
				alignX = Enum.TextXAlignment.Center,
				size = UDim2.new(1, 0, 0, 70),
				position = UDim2.fromOffset(0, 8),
				outline = false,
			})
			C.text({
				parent = card,
				text = if known then reaction.name else "???",
				type = "Caption",
				alignX = Enum.TextXAlignment.Center,
				size = UDim2.new(1, -8, 0, 24),
				position = UDim2.fromOffset(4, 80),
				color = if known then reaction.color else Theme.Color.Text.Muted,
			})
			C.text({
				parent = card,
				text = if known then reaction.description else "",
				type = "Caption",
				textSize = 11,
				alignX = Enum.TextXAlignment.Center,
				wrap = true,
				size = UDim2.new(1, -8, 0, 44),
				position = UDim2.fromOffset(4, 102),
				color = Theme.Color.Text.Secondary,
				outline = false,
			})
		end
		self.progress.set(found / total, ("%d / %d reactions found"):format(found, total))
	end
end

function CodexPanel:Open()
	self:Refresh()
	self.modal.open()
end

function CodexPanel:Close()
	self.modal.close()
end

return CodexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--!nonstrict
-- UI component library built on Theme tokens (see docs/UI_DESIGN_SYSTEM.md).

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PotionModel = require(Shared.Visual.PotionModel)

local Theme = require(script.Parent.Theme)

local C = {}

local soundHandler: ((string) -> ())? = nil
function C.setSoundHandler(fn: (string) -> ())
	soundHandler = fn
end
local function sound(name: string)
	if soundHandler then
		soundHandler(name)
	end
end
C.sound = sound

-- ─────────────────────────────── primitives ───────────────────────────────

function C.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function C.tween(instance: Instance, info: TweenInfo, goal: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

function C.corner(parent: Instance, radius: UDim?): UICorner
	return C.new("UICorner", { CornerRadius = radius or Theme.Radius.MD, Parent = parent })
end

function C.stroke(
	parent: Instance,
	color: Color3?,
	thickness: number?,
	transparency: number?,
	border: boolean?
): UIStroke
	return C.new("UIStroke", {
		Color = color or Theme.Color.Stroke.Subtle,
		Thickness = thickness or Theme.Stroke.Default,
		Transparency = transparency or 0,
		ApplyStrokeMode = if border == false then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function C.padding(parent: Instance, all: number, horizontal: number?): UIPadding
	local h = horizontal or all
	return C.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, h),
		PaddingRight = UDim.new(0, h),
		Parent = parent,
	})
end

function C.list(
	parent: Instance,
	direction: Enum.FillDirection?,
	gap: number?,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	return C.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or Theme.Space.SM),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function C.grid(parent: Instance, cell: Vector2, gap: number?): UIGridLayout
	return C.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(gap or Theme.Space.MD, gap or Theme.Space.MD),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function C.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return C.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

-- Text label using a Theme type token. Outline stroke for readability over the 3D scene.
function C.text(props: { [string]: any }): TextLabel
	local typeToken = Theme.Type[props.type or "Body"]
	local label = C.new("TextLabel", {
		Name = props.name or "Text",
		BackgroundTransparency = 1,
		Size = props.size or UDim2.new(1, 0, 0, typeToken.size + 6),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		Text = props.text or "",
		FontFace = typeToken.font,
		TextSize = props.textSize or typeToken.size,
		TextColor3 = props.color or Theme.Color.Text.Primary,
		TextXAlignment = props.alignX or Enum.TextXAlignment.Left,
		TextYAlignment = props.alignY or Enum.TextYAlignment.Center,
		TextWrapped = props.wrap == true,
		RichText = props.rich == true,
		TextTruncate = if props.truncate then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
		AutomaticSize = props.autoSize or Enum.AutomaticSize.None,
		LayoutOrder = props.order or 0,
		ZIndex = props.z or 1,
		Parent = props.parent,
	})
	if props.outline ~= false then
		C.stroke(label, Theme.Color.Text.Outline, props.outlineThickness or 2, props.outlineTransparency or 0.25, false)
	end
	return label
end

function C.frame(props: { [string]: any }): Frame
	local frame = C.new("Frame", {
		Name = props.name or "Frame",
		BackgroundColor3 = props.color or Theme.Color.Surface.Panel,
		BackgroundTransparency = props.transparency or 0,
		BorderSizePixel = 0,
		Size = props.size or UDim2.fromScale(1, 1),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		ZIndex = props.z or 1,
		AutomaticSize = props.autoSize or Enum.AutomaticSize.None,
		ClipsDescendants = props.clip == true,
		Visible = props.visible ~= false,
		Parent = props.parent,
	})
	if props.radius ~= false then
		C.corner(frame, props.radius or Theme.Radius.MD)
	end
	if props.stroke then
		C.stroke(frame, props.stroke, props.strokeThickness, props.strokeTransparency)
	end
	return frame
end

-- Glass panel with fake drop shadow (returns outer container, inner panel).
function C.card(props: { [string]: any }): (Frame, Frame)
	local elevation = Theme.Elevation[props.elevation or "E1"]
	local outer = C.new("Frame", {
		Name = props.name or "Card",
		BackgroundTransparency = 1,
		Size = props.size or UDim2.fromOffset(200, 100),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		ZIndex = props.z or 1,
		Parent = props.parent,
	})
	local shadow = C.frame({
		name = "Shadow",
		parent = outer,
		color = Color3.new(0, 0, 0),
		transparency = elevation.transparency,
		position = UDim2.fromOffset(0, elevation.offset),
		radius = props.radius,
		z = props.z,
	})
	local _ = shadow
	local inner = C.frame({
		name = "Body",
		parent = outer,
		color = props.color or Theme.Color.Surface.Panel,
		transparency = props.transparency or Theme.Color.PanelTransparency,
		radius = props.radius,
		stroke = props.stroke or Theme.Color.Stroke.Subtle,
		strokeThickness = props.strokeThickness,
		z = props.z,
		clip = props.clip,
	})
	if props.gradient ~= false then
		C.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 195, 235)),
			Rotation = 90,
			Parent = inner,
		})
	end
	return outer, inner
end

-- Springy hover/press behaviour shared by every button.
function C.interactive(button: GuiButton, opts: { [string]: any }?)
	local options = opts or {}
	local scale = button:FindFirstChildOfClass("UIScale") or C.new("UIScale", { Parent = button })
	local base = options.baseScale or 1
	local hovering = false
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		hovering = true
		C.tween(scale, Theme.Motion.Hover, { Scale = base * 1.06 })
		sound("hover")
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		C.tween(scale, Theme.Motion.Hover, { Scale = base })
	end)
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		C.tween(scale, Theme.Motion.Press, { Scale = base * 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		C.tween(scale, Theme.Motion.Release, { Scale = if hovering then base * 1.06 else base })
	end)
	return scale
end

function C.keyBadge(parent: Instance, key: string, z: number?): Frame
	local badge = C.frame({
		name = "KeyBadge",
		parent = parent,
		color = Theme.Color.Surface.Base,
		transparency = 0.1,
		size = UDim2.fromOffset(math.max(24, 12 + #key * 9), 22),
		position = UDim2.new(1, 6, 0, -8),
		anchor = Vector2.new(1, 0),
		radius = Theme.Radius.SM,
		stroke = Theme.Color.Stroke.Gold,
		strokeThickness = 1,
		z = (z or 1) + 3,
	})
	C.text({
		parent = badge,
		text = key,
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		color = Theme.Color.Accent.Gold,
		outline = false,
		z = (z or 1) + 4,
	})
	return badge
end

local VARIANTS = {
	primary = {
		fill = Theme.Color.Accent.Gold,
		fill2 = Theme.Color.Accent.GoldDeep,
		text = Theme.Color.Text.Inverse,
		stroke = Theme.Color.Stroke.Gold,
		outline = false,
	},
	secondary = {
		fill = Theme.Color.Surface.Raised,
		fill2 = Theme.Color.Surface.Panel,
		text = Theme.Color.Text.Primary,
		stroke = Theme.Color.Stroke.Strong,
		outline = true,
	},
	ghost = {
		fill = Theme.Color.Surface.Panel,
		fill2 = Theme.Color.Surface.Panel,
		text = Theme.Color.Text.Secondary,
		stroke = Theme.Color.Stroke.Subtle,
		outline = true,
		transparency = 0.6,
	},
	danger = {
		fill = Theme.Color.State.Danger,
		fill2 = Color3.fromRGB(190, 40, 70),
		text = Theme.Color.Text.Primary,
		stroke = Color3.fromRGB(255, 140, 150),
		outline = true,
	},
}

export type ButtonHandle = {
	button: TextButton,
	label: TextLabel,
	setText: (string) -> (),
	setDisabled: (boolean) -> (),
	setVariant: (string) -> (),
}

function C.Button(props: { [string]: any }): ButtonHandle
	local variantName = props.variant or "secondary"
	local height = Theme.Size.Button[props.size or "md"]
	local button = C.new("TextButton", {
		Name = props.name or "Button",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = props.width and UDim2.fromOffset(props.width, height) or (props.sizeUDim or UDim2.new(1, 0, 0, height)),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		ZIndex = props.z or 1,
		Parent = props.parent,
	})
	C.corner(button, props.radius or Theme.Radius.MD)
	local stroke = C.stroke(button, nil, Theme.Stroke.Default)
	local gradient = C.new("UIGradient", { Rotation = 90, Parent = button })
	local label = C.text({
		parent = button,
		text = if props.icon then props.icon .. "  " .. (props.text or "") else (props.text or ""),
		type = if props.size == "lg" then "Heading" elseif props.size == "sm" then "Caption" else "Label",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		z = (props.z or 1) + 1,
	})
	label.TextScaled = false
	local labelStroke = label:FindFirstChildOfClass("UIStroke")
	local disabled = false
	local function apply()
		local v = VARIANTS[variantName] or VARIANTS.secondary
		if disabled then
			button.BackgroundColor3 = Theme.Color.State.Disabled
			gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 210))
			label.TextColor3 = Theme.Color.Text.Muted
			stroke.Color = Theme.Color.Stroke.Subtle
			button.BackgroundTransparency = 0.2
		else
			button.BackgroundColor3 = Color3.new(1, 1, 1)
			gradient.Color = ColorSequence.new(v.fill, v.fill2)
			label.TextColor3 = v.text
			stroke.Color = v.stroke
			button.BackgroundTransparency = v.transparency or 0
		end
		if labelStroke then
			labelStroke.Enabled = v.outline and not disabled
		end
	end
	apply()
	C.interactive(button)
	if props.keybind then
		C.keyBadge(button, props.keybind, props.z)
	end
	button.Activated:Connect(function()
		if disabled then
			sound("error")
			return
		end
		sound("click")
		if props.onClick then
			props.onClick()
		end
	end)
	return {
		button = button,
		label = label,
		setText = function(text: string)
			label.Text = if props.icon then props.icon .. "  " .. text else text
		end,
		setDisabled = function(value: boolean)
			disabled = value
			button:SetAttribute("Disabled", value or nil)
			apply()
		end,
		setVariant = function(name: string)
			variantName = name
			apply()
		end,
	}
end

export type IconButtonHandle = {
	button: TextButton,
	setActive: (boolean) -> (),
	setIcon: (string) -> (),
	setCaption: (string) -> (),
	setBadge: (string?) -> (),
}

function C.IconButton(props: { [string]: any }): IconButtonHandle
	local size = props.sizePx or Theme.Size.IconButton
	local button = C.new("TextButton", {
		Name = props.name or "IconButton",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Theme.Color.Surface.Panel,
		BackgroundTransparency = Theme.Color.PanelTransparency,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size, size),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		ZIndex = props.z or 1,
		Parent = props.parent,
	})
	C.corner(button, Theme.Radius.LG)
	local stroke = C.stroke(button, Theme.Color.Stroke.Strong, Theme.Stroke.Default)
	C.gradient(button, Theme.Color.Surface.Raised, Theme.Color.Surface.Panel)
	local icon = C.text({
		parent = button,
		name = "Icon",
		text = props.icon or "?",
		type = "Heading",
		textSize = math.floor(size * 0.42),
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 1, if props.caption then -16 else 0),
		outline = false,
		z = (props.z or 1) + 1,
	})
	local caption
	if props.caption then
		caption = C.text({
			parent = button,
			name = "Caption",
			text = props.caption,
			type = "Caption",
			textSize = 12,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 16),
			position = UDim2.new(0, 0, 1, -19),
			color = Theme.Color.Text.Secondary,
			z = (props.z or 1) + 1,
		})
	end
	local glow = C.new("UIGradient", {
		Color = ColorSequence.new(Theme.Color.Accent.Gold, Theme.Color.Accent.GoldDeep),
		Rotation = 90,
		Enabled = false,
	})
	glow.Parent = button
	local badge: Frame? = nil
	local badgeLabel: TextLabel? = nil
	C.interactive(button)
	if props.keybind then
		C.keyBadge(button, props.keybind, props.z)
	end
	button.Activated:Connect(function()
		sound("click")
		if props.onClick then
			props.onClick()
		end
	end)
	if props.tooltip then
		button.MouseEnter:Connect(function()
			C.showTooltip(props.tooltip, props.tooltipBody, nil)
		end)
		button.MouseLeave:Connect(function()
			C.hideTooltip()
		end)
	end
	return {
		button = button,
		setActive = function(active: boolean)
			stroke.Color = if active then Theme.Color.Stroke.Gold else Theme.Color.Stroke.Strong
			stroke.Thickness = if active then Theme.Stroke.Emphasis else Theme.Stroke.Default
			button.BackgroundColor3 = if active then Theme.Color.Accent.GoldDeep else Theme.Color.Surface.Panel
			button.BackgroundTransparency = if active then 0.35 else Theme.Color.PanelTransparency
		end,
		setIcon = function(text: string)
			icon.Text = text
		end,
		setCaption = function(text: string)
			if caption then
				caption.Text = text
			end
		end,
		setBadge = function(text: string?)
			if not text then
				if badge then
					badge.Visible = false
				end
				return
			end
			local current = badge
			if not current then
				current = C.frame({
					name = "Badge",
					parent = button,
					color = Theme.Color.Accent.Magenta,
					size = UDim2.fromOffset(24, 24),
					position = UDim2.new(0, -6, 0, -6),
					radius = Theme.Radius.Pill,
					z = (props.z or 1) + 5,
				})
				badge = current
				badgeLabel = C.text({
					parent = current,
					text = text,
					type = "Caption",
					alignX = Enum.TextXAlignment.Center,
					size = UDim2.fromScale(1, 1),
					z = (props.z or 1) + 6,
				})
			end
			current.Visible = true
			if badgeLabel then
				badgeLabel.Text = text
			end
		end,
	}
end

-- Small pill with an icon and value (coins, flasks...).
function C.Pill(props: { [string]: any }): (Frame, TextLabel)
	local pill = C.frame({
		name = props.name or "Pill",
		parent = props.parent,
		color = Theme.Color.Surface.Sunken,
		transparency = 0.15,
		size = props.size or UDim2.fromOffset(150, 38),
		position = props.position,
		anchor = props.anchor,
		radius = Theme.Radius.Pill,
		stroke = props.stroke or Theme.Color.Stroke.Subtle,
		order = props.order,
	})
	C.text({
		parent = pill,
		text = props.icon or "",
		type = "Body",
		size = UDim2.fromOffset(34, 38),
		alignX = Enum.TextXAlignment.Center,
		outline = false,
	})
	local value = C.text({
		parent = pill,
		name = "Value",
		text = props.text or "",
		type = "Body",
		size = UDim2.new(1, -40, 1, 0),
		position = UDim2.fromOffset(34, 0),
		color = props.color or Theme.Color.Text.Primary,
	})
	return pill, value
end

-- ─────────────────────────────── progress ───────────────────────────────

export type ProgressHandle = { frame: Frame, set: (number, string?, boolean?) -> (), setColor: (Color3, Color3?) -> () }

function C.Progress(props: { [string]: any }): ProgressHandle
	local track = C.frame({
		name = props.name or "Progress",
		parent = props.parent,
		color = Theme.Color.Surface.Sunken,
		transparency = 0.1,
		size = props.size or UDim2.new(1, 0, 0, 14),
		position = props.position,
		anchor = props.anchor,
		radius = Theme.Radius.Pill,
		stroke = Theme.Color.Stroke.Subtle,
		strokeThickness = 1,
		order = props.order,
		clip = true,
	})
	local fill = C.frame({
		name = "Fill",
		parent = track,
		color = Color3.new(1, 1, 1),
		size = UDim2.fromScale(0, 1),
		radius = Theme.Radius.Pill,
	})
	local gradient = C.new("UIGradient", {
		Color = ColorSequence.new(props.color or Theme.Color.Accent.Gold, props.color2 or Theme.Color.Accent.GoldDeep),
		Parent = fill,
	})
	local label
	if props.showLabel then
		label = C.text({
			parent = track,
			text = "",
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromScale(1, 1),
			z = 3,
		})
	end
	return {
		frame = track,
		set = function(fraction: number, text: string?, instant: boolean?)
			fraction = math.clamp(fraction, 0, 1)
			if instant then
				fill.Size = UDim2.fromScale(fraction, 1)
			else
				C.tween(fill, Theme.Motion.Count, { Size = UDim2.fromScale(fraction, 1) })
			end
			if label and text then
				label.Text = text
			end
		end,
		setColor = function(a: Color3, b: Color3?)
			gradient.Color = ColorSequence.new(a, b or a)
		end,
	}
end

-- ─────────────────────────────── tabs ───────────────────────────────

export type TabsHandle = { frame: Frame, select: (string) -> (), selected: () -> string }

function C.Tabs(props: { [string]: any }): TabsHandle
	local frame = C.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = props.size or UDim2.new(1, 0, 0, 44),
		Position = props.position or UDim2.new(),
		Parent = props.parent,
	})
	C.list(frame, Enum.FillDirection.Horizontal, Theme.Space.SM)
	local buttons = {}
	local current = props.tabs[1].id
	local function refresh()
		for id, handle in buttons do
			handle.setVariant(if id == current then "primary" else "ghost")
		end
	end
	for index, tab in props.tabs do
		local handle = C.Button({
			parent = frame,
			text = tab.label,
			icon = tab.icon,
			width = tab.width or 150,
			size = "md",
			order = index,
			radius = Theme.Radius.Pill,
			onClick = function()
				if current ~= tab.id then
					current = tab.id
					refresh()
					if props.onSelect then
						props.onSelect(tab.id)
					end
				end
			end,
		})
		buttons[tab.id] = handle
	end
	refresh()
	return {
		frame = frame,
		select = function(id: string)
			current = id
			refresh()
			if props.onSelect then
				props.onSelect(id)
			end
		end,
		selected = function()
			return current
		end,
	}
end

-- ─────────────────────────────── scrolling ───────────────────────────────

function C.Scroll(props: { [string]: any }): ScrollingFrame
	local scroll = C.new("ScrollingFrame", {
		Name = props.name or "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = props.size or UDim2.fromScale(1, 1),
		Position = props.position or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = props.axis or Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke.Strong,
		ScrollingDirection = props.direction or Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.Always,
		Parent = props.parent,
	})
	return scroll
end

-- ─────────────────────────────── modal ───────────────────────────────

export type ModalHandle = {
	root: Frame,
	panel: Frame,
	body: Frame,
	header: Frame,
	open: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
	onClose: (() -> ())?,
	onOpen: (() -> ())?,
}

function C.Modal(props: { [string]: any }): ModalHandle
	local size = props.size or Theme.Size.Modal
	local root = C.new("Frame", {
		Name = props.name or "Modal",
		BackgroundColor3 = Theme.Color.Surface.Base,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 50,
		Active = true,
		Parent = props.parent,
	})
	local scale = C.new("UIScale", { Scale = 0.92 })
	local outer, panel = C.card({
		parent = root,
		size = UDim2.fromOffset(size.X, size.Y),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		radius = Theme.Radius.LG,
		elevation = "E2",
		stroke = Theme.Color.Stroke.Strong,
		z = 51,
	})
	scale.Parent = outer
	local group = C.new("CanvasGroup", {
		Name = "Fade",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 0,
		Parent = panel,
	})
	local header =
		C.new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Parent = group })
	C.padding(header, 0, Theme.Space.XL)
	C.text({
		parent = header,
		text = props.title or "",
		type = "Title",
		size = UDim2.new(1, -60, 1, 0),
		position = UDim2.fromOffset(0, 4),
		color = Theme.Color.Accent.Gold,
	})
	local close = C.new("TextButton", {
		Name = "Close",
		AutoButtonColor = false,
		Text = "✕",
		FontFace = Theme.Font.UI,
		TextSize = 22,
		TextColor3 = Theme.Color.Text.Primary,
		BackgroundColor3 = Theme.Color.Surface.Raised,
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = header,
	})
	C.corner(close, Theme.Radius.Pill)
	C.stroke(close, Theme.Color.Stroke.Strong)
	C.interactive(close)
	C.new("Frame", {
		Name = "Divider",
		BackgroundColor3 = Theme.Color.Stroke.Subtle,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -48, 0, 2),
		Position = UDim2.fromOffset(24, 64),
		Parent = group,
	})
	local body = C.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -48, 1, -88),
		Position = UDim2.fromOffset(24, 76),
		Parent = group,
	})
	local open = false
	local handle
	local blur: BlurEffect? = nil
	local function closeModal()
		if not open then
			return
		end
		open = false
		C.hideTooltip()
		sound("close")
		C.tween(scale, Theme.Motion.PanelOut, { Scale = 0.94 })
		C.tween(group, Theme.Motion.PanelOut, { GroupTransparency = 1 })
		C.tween(root, Theme.Motion.PanelOut, { BackgroundTransparency = 1 })
		if blur then
			C.tween(blur, Theme.Motion.PanelOut, { Size = 0 })
		end
		task.delay(Theme.Motion.PanelOut.Time, function()
			if not open then
				root.Visible = false
			end
		end)
		if handle.onClose then
			handle.onClose()
		end
	end
	local function openModal()
		if open then
			return
		end
		open = true
		root.Visible = true
		sound("open")
		scale.Scale = 0.92
		group.GroupTransparency = 1
		C.tween(scale, Theme.Motion.PanelIn, { Scale = 1 })
		C.tween(group, Theme.Motion.Fade, { GroupTransparency = 0 })
		C.tween(root, Theme.Motion.Fade, { BackgroundTransparency = 0.45 })
		local current = blur
		if not current then
			current = Instance.new("BlurEffect")
			current.Name = "ModalBlur"
			current.Size = 0
			current.Parent = game:GetService("Lighting")
			blur = current
		end
		C.tween(current, Theme.Motion.Fade, { Size = 10 })
		if handle.onOpen then
			handle.onOpen()
		end
	end
	close.Activated:Connect(closeModal)
	handle = {
		root = root,
		panel = panel,
		body = body,
		header = header,
		open = openModal,
		close = closeModal,
		isOpen = function()
			return open
		end,
		onClose = nil,
		onOpen = nil,
	}
	return handle
end

-- ─────────────────────────────── 3D viewports ───────────────────────────────

local spinning = {} :: { [ViewportFrame]: { model: Model, base: CFrame, speed: number, active: boolean } }

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for viewport, entry in spinning do
		if not viewport.Parent then
			spinning[viewport] = nil
		elseif entry.active and viewport.Visible then
			entry.model:PivotTo(entry.base * CFrame.Angles(0, t * entry.speed, math.sin(t * 2) * 0.08))
		end
	end
end)

-- ViewportFrame showing `model`, framed automatically. Returns viewport and a setter for spin.
function C.Viewport(props: { [string]: any }): (ViewportFrame, (boolean) -> ())
	local viewport = C.new("ViewportFrame", {
		Name = props.name or "Viewport",
		BackgroundTransparency = 1,
		Size = props.size or UDim2.fromScale(1, 1),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		Ambient = props.ambient or Color3.fromRGB(150, 140, 180),
		LightColor = props.light or Color3.fromRGB(255, 245, 230),
		LightDirection = Vector3.new(-0.6, -1, -0.8),
		ZIndex = props.z or 1,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	})
	local model: Model = props.model
	local camera = Instance.new("Camera")
	camera.FieldOfView = props.fov or 30
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	model.Parent = viewport
	local cf, extents = model:GetBoundingBox()
	local radius = extents.Magnitude / 2
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * (props.zoom or 1.05)
	local center = cf.Position
	camera.CFrame = CFrame.lookAt(center + Vector3.new(0, radius * 0.18, distance), center)
	local base = model:GetPivot()
	local entry = { model = model, base = base, speed = props.spinSpeed or 1.2, active = props.spin == true }
	spinning[viewport] = entry
	return viewport,
		function(active: boolean)
			entry.active = active
			if not active then
				model:PivotTo(base)
			end
		end
end

function C.BottleIcon(props: { [string]: any }): (ViewportFrame, (boolean) -> ())
	local model = if props.silhouette
		then PotionModel.silhouette(props.potion.bottle)
		else PotionModel.build(props.potion)
	return C.Viewport({
		parent = props.parent,
		model = model,
		size = props.size,
		position = props.position,
		anchor = props.anchor,
		z = props.z,
		order = props.order,
		spin = props.spin,
		zoom = props.zoom or 1.15,
		ambient = Color3.fromRGB(170, 160, 200),
	})
end

-- ─────────────────────────────── tooltip ───────────────────────────────

local tooltip: Frame? = nil
local tooltipTitle: TextLabel? = nil
local tooltipBody: TextLabel? = nil

function C.mountTooltip(parent: Instance)
	local frame = C.frame({
		name = "Tooltip",
		parent = parent,
		color = Theme.Color.Surface.Panel,
		transparency = 0.02,
		size = UDim2.fromOffset(280, 0),
		autoSize = Enum.AutomaticSize.Y,
		radius = Theme.Radius.MD,
		stroke = Theme.Color.Stroke.Strong,
		z = 200,
		visible = false,
	})
	C.padding(frame, Theme.Space.MD)
	C.list(frame, Enum.FillDirection.Vertical, Theme.Space.XS)
	tooltipTitle = C.text({
		parent = frame,
		text = "",
		type = "Label",
		order = 1,
		z = 201,
		wrap = true,
		autoSize = Enum.AutomaticSize.Y,
	})
	tooltipBody = C.text({
		parent = frame,
		text = "",
		type = "Caption",
		order = 2,
		color = Theme.Color.Text.Secondary,
		wrap = true,
		autoSize = Enum.AutomaticSize.Y,
		z = 201,
	})
	tooltip = frame
	RunService.RenderStepped:Connect(function()
		if frame.Visible then
			-- The tooltip lives inside a UIScale'd root: convert viewport pixels to design pixels.
			local uiScale = parent:FindFirstChildOfClass("UIScale")
			local s = if uiScale then math.max(uiScale.Scale, 0.01) else 1
			local mouse = UserInputService:GetMouseLocation() / s
			local parentSize = ((parent :: any).AbsoluteSize or Vector2.new(1920, 1080)) / s
			local frameSize = frame.AbsoluteSize / s
			local x = math.min(mouse.X + 18, parentSize.X - frameSize.X - 8)
			local y = math.min(mouse.Y + 18, parentSize.Y - frameSize.Y - 8)
			frame.Position = UDim2.fromOffset(x, y)
		end
	end)
end

function C.showTooltip(title: string, body: string?, color: Color3?)
	if not tooltip or not tooltipTitle or not tooltipBody then
		return
	end
	tooltipTitle.Text = title
	tooltipTitle.TextColor3 = color or Theme.Color.Text.Primary
	tooltipBody.Text = body or ""
	tooltipBody.Visible = body ~= nil and body ~= ""
	tooltip.Visible = true
end

function C.hideTooltip()
	if tooltip then
		tooltip.Visible = false
	end
end

-- ─────────────────────────────── slider ───────────────────────────────

function C.Slider(props: { [string]: any })
	local frame = C.new("Frame", {
		Name = "Slider",
		BackgroundTransparency = 1,
		Size = props.size or UDim2.new(1, 0, 0, 56),
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	})
	C.text({ parent = frame, text = props.label or "", type = "Label", size = UDim2.new(0.5, 0, 0, 24) })
	local valueLabel = C.text({
		parent = frame,
		text = "",
		type = "Label",
		size = UDim2.new(0.5, 0, 0, 24),
		position = UDim2.fromScale(0.5, 0),
		alignX = Enum.TextXAlignment.Right,
		color = Theme.Color.Accent.Gold,
	})
	local track = C.new("TextButton", {
		Name = "Track",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Color.Surface.Sunken,
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 34),
		Parent = frame,
	})
	C.corner(track, Theme.Radius.Pill)
	C.stroke(track, Theme.Color.Stroke.Subtle, 1)
	local fill = C.frame({
		parent = track,
		color = Theme.Color.Accent.Gold,
		size = UDim2.fromScale(0, 1),
		radius = Theme.Radius.Pill,
	})
	local knob = C.frame({
		parent = track,
		color = Theme.Color.Text.Primary,
		size = UDim2.fromOffset(24, 24),
		anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0, 0.5),
		radius = Theme.Radius.Pill,
		stroke = Theme.Color.Stroke.Gold,
	})
	local value = props.value or 0.5
	local function set(v: number, fire: boolean?)
		value = math.clamp(v, 0, 1)
		fill.Size = UDim2.fromScale(value, 1)
		knob.Position = UDim2.fromScale(value, 0.5)
		valueLabel.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
		if fire and props.onChange then
			props.onChange(value)
		end
	end
	set(value)
	local dragging = false
	local function update(x: number)
		local absPos, absSize = track.AbsolutePosition.X, track.AbsoluteSize.X
		if absSize > 0 then
			set((x - absPos) / absSize, true)
		end
	end
	track.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			update(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			update(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			if dragging then
				dragging = false
				sound("click")
			end
		end
	end)
	return { frame = frame, set = set }
end

-- Number count-up animation on a TextLabel (uses an IntValue to tween).
function C.countTo(label: TextLabel, from: number, to: number, format: (number) -> string)
	local value = Instance.new("NumberValue")
	value.Value = from
	value.Changed:Connect(function(v)
		label.Text = format(v)
	end)
	local tween = C.tween(value, Theme.Motion.Count, { Value = to })
	tween.Completed:Connect(function()
		label.Text = format(to)
		value:Destroy()
	end)
end

function C.pulse(instance: GuiObject, amount: number?)
	local scale = instance:FindFirstChild("PulseScale") :: UIScale?
	if not scale then
		scale = C.new("UIScale", { Name = "PulseScale", Parent = instance })
	end
	if scale then
		scale.Scale = amount or 1.25
		C.tween(scale, Theme.Motion.Pulse, { Scale = 1 })
	end
end

return C
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">HelpPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- F1 help: every keybind plus touch and gamepad controls and a few pro tips.

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local HelpPanel = {}

local KEYS = {
	{ "LMB (drag)", "Grab & fling" },
	{ "RMB", "Throw / feed potion or place item" },
	{ "1–9", "Select potion" },
	{ "Q", "Switch Throw / Feed" },
	{ "G", "Slow motion" },
	{ "Space", "Stop time" },
	{ "H", "Heal every golem" },
	{ "R", "Reset the room" },
	{ "N", "Spawn last golem / item" },
	{ "Z", "Undo last spawn" },
	{ "K", "Cure all zombies" },
	{ "B", "Cauldron" },
	{ "C", "Codex" },
	{ "J", "Quests" },
	{ "O", "Shop" },
	{ "M", "World menu" },
	{ "F", "Follow hovered golem" },
	{ "P", "Photo mode" },
	{ "Wheel / WASD / MMB", "Zoom & pan camera" },
	{ "Esc", "Close / deselect" },
}

local OTHER = {
	"📱 Touch: drag a golem to grab it, tap empty space to use your potion, pinch to zoom, two fingers to pan.",
	"🎮 Gamepad: left stick moves the cursor, A grabs, X uses, Y switches mode, LB/RB cycle potions, D-pad controls time.",
	"💡 Frozen golems shatter on hard hits. Fire melts ice into a steam explosion.",
	"💡 Mix anything! Unknown mixes make Murky Sludge, but the cauldron gives you a hint.",
	"💡 Brew a potion 5 times to master it: infinite bottles and +25% power.",
	"💡 Thrown potions leave puddles: fire, ice, glue, trampoline goo...",
}

function HelpPanel:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local modal = C.Modal({ parent = ui.modals, title = "❔ Controls & Tips", size = Vector2.new(1100, 680) })
	self.modal = modal
	modal.onClose = function()
		ui:PanelClosed("help")
	end
	local left = C.Scroll({ parent = modal.body, size = UDim2.new(0.5, -12, 1, 0) })
	C.list(left, Enum.FillDirection.Vertical, Theme.Space.XS)
	for index, entry in KEYS do
		local row = C.frame({
			parent = left,
			color = Theme.Color.Surface.Raised,
			transparency = if index % 2 == 0 then 0.4 else 0.15,
			size = UDim2.new(1, -8, 0, 34),
			order = index,
			radius = Theme.Radius.SM,
		})
		local key = C.frame({
			parent = row,
			color = Theme.Color.Surface.Base,
			size = UDim2.fromOffset(190, 26),
			position = UDim2.fromOffset(6, 4),
			radius = Theme.Radius.SM,
			stroke = Theme.Color.Stroke.Gold,
			strokeThickness = 1,
		})
		C.text({
			parent = key,
			text = entry[1],
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromScale(1, 1),
			color = Theme.Color.Accent.Gold,
			outline = false,
		})
		C.text({
			parent = row,
			text = entry[2],
			type = "Label",
			size = UDim2.new(1, -220, 1, 0),
			position = UDim2.fromOffset(210, 0),
		})
	end
	local right =
		C.Scroll({ parent = modal.body, size = UDim2.new(0.5, -12, 1, 0), position = UDim2.new(0.5, 12, 0, 0) })
	C.list(right, Enum.FillDirection.Vertical, Theme.Space.MD)
	for index, line in OTHER do
		local _, card =
			C.card({ parent = right, size = UDim2.new(1, -8, 0, 84), order = index, radius = Theme.Radius.MD })
		C.text({
			parent = card,
			text = line,
			type = "Body",
			textSize = 17,
			wrap = true,
			size = UDim2.new(1, -24, 1, -12),
			position = UDim2.fromOffset(12, 6),
		})
	end
end

function HelpPanel:Open()
	self.modal.open()
end

function HelpPanel:Close()
	self.modal.close()
end

return HelpPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Hotbar</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Potion hotbar: 3D bottles in viewport slots, counts / ∞ mastery, rarity borders, 1-9 keys,
-- paging, the Throw/Feed mode toggle and the "placing" chip for golems/props.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Potions = require(Shared.Data.Potions)
local PropsData = require(Shared.Data.Props)
local Skins = require(Shared.Data.Skins)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Hotbar = {}

local SLOTS = 9

function Hotbar:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local root = ui.hud
	local State = controllers.State
	local touch = ui.touch
	local slotSize = if touch then Theme.Size.SlotTouch else Theme.Size.Slot
	self.page = 0
	self.slots = {}

	local bar = C.new("Frame", {
		Name = "Hotbar",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(SLOTS * (slotSize + Theme.Size.SlotGap) + 220, slotSize + 40),
		Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = root,
	})
	self.bar = bar
	local _, background = C.card({
		parent = bar,
		size = UDim2.new(1, 0, 0, slotSize + 24),
		position = UDim2.fromOffset(0, 16),
		radius = Theme.Radius.LG,
	})
	local _ = background

	-- Mode toggle (Throw / Feed).
	local mode = C.IconButton({
		parent = bar,
		icon = "🧪",
		caption = "Throw",
		keybind = if touch then nil else "Q",
		sizePx = slotSize,
		position = UDim2.fromOffset(12, 28),
		onClick = function()
			controllers.InputController.Action:Fire("mode")
		end,
		tooltip = "Throw / Feed",
		tooltipBody = "Throw: splash everything nearby and leave a puddle.\nFeed: one golem drinks it (1.5x duration).",
	})
	State.ModeChanged:Connect(function(value)
		mode.setIcon(if value == "feed" then "🥄" else "🧪")
		mode.setCaption(if value == "feed" then "Feed" else "Throw")
		mode.setActive(value == "feed")
	end)

	local row = C.new("Frame", {
		Name = "Slots",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(SLOTS * (slotSize + Theme.Size.SlotGap), slotSize),
		Position = UDim2.fromOffset(slotSize + 28, 28),
		Parent = bar,
	})
	C.list(row, Enum.FillDirection.Horizontal, Theme.Size.SlotGap)
	for index = 1, SLOTS do
		self.slots[index] = self:_slot(row, index, slotSize, touch)
	end

	-- Paging arrows.
	local pager = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(70, slotSize),
		Position = UDim2.new(1, -82, 0, 28),
		Parent = bar,
	})
	local up = C.Button({
		parent = pager,
		text = "▲",
		width = 70,
		size = "sm",
		variant = "ghost",
		onClick = function()
			self:Page(-1)
		end,
	})
	local down = C.Button({
		parent = pager,
		text = "▼",
		width = 70,
		size = "sm",
		variant = "ghost",
		position = UDim2.new(0, 0, 1, -36),
		onClick = function()
			self:Page(1)
		end,
	})
	self.pageLabel = C.text({
		parent = pager,
		text = "1/1",
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 20),
		position = UDim2.new(0, 0, 0.5, -10),
		color = Theme.Color.Text.Muted,
	})
	local _ = up
	local _2 = down

	-- Placing chip (golem / prop tool).
	local chipOuter, chip = C.card({
		parent = root,
		size = UDim2.fromOffset(360, 48),
		position = UDim2.new(0.5, 0, 1, -(slotSize + 72)),
		anchor = Vector2.new(0.5, 1),
		radius = Theme.Radius.Pill,
		stroke = Theme.Color.Accent.Cyan,
	})
	chipOuter.Visible = false
	local chipLabel = C.text({
		parent = chip,
		text = "",
		type = "Label",
		size = UDim2.new(1, -60, 1, 0),
		position = UDim2.fromOffset(18, 0),
	})
	C.Button({
		parent = chip,
		text = "✕",
		width = 40,
		size = "sm",
		variant = "ghost",
		position = UDim2.new(1, -6, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		onClick = function()
			State:Select(nil)
		end,
	})
	self.chip, self.chipLabel = chipOuter, chipLabel
	self.empty = C.text({
		parent = bar,
		text = "No potions yet. Open the cauldron (B) and brew something!",
		type = "Label",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, -200, 0, slotSize),
		position = UDim2.fromOffset(slotSize + 28, 28),
		color = Theme.Color.Text.Secondary,
		z = 3,
	})

	State.Changed:Connect(function(key)
		if key == "*" or key == "potions" or key == "brewCount" then
			self:Refresh()
		end
	end)
	State.TrialChanged:Connect(function()
		self.page = 0
		self:Refresh()
	end)
	State.LabChanged:Connect(function()
		self:Refresh()
	end)
	State.SelectionChanged:Connect(function()
		self:_highlight()
	end)
	controllers.InputController.Action:Connect(function(action)
		local index = tonumber(action:match("^slot(%d)$"))
		if index then
			self:SelectIndex(index)
		elseif action == "slotNext" or action == "slotPrev" then
			self:Cycle(if action == "slotNext" then 1 else -1)
		end
	end)
	controllers.ToolController.Used:Connect(function(selection)
		for _, slot in self.slots do
			if slot.potionId and selection.kind == "potion" and slot.potionId == selection.id then
				C.pulse(slot.button, 0.9)
			end
		end
	end)
	self:Refresh()
end

function Hotbar:_slot(parent: Instance, index: number, size: number, touch: boolean)
	local button = C.new("TextButton", {
		Name = "Slot" .. index,
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Theme.Color.Surface.Raised,
		BackgroundTransparency = 0.1,
		Size = UDim2.fromOffset(size, size),
		LayoutOrder = index,
		Parent = parent,
	})
	C.corner(button, Theme.Radius.MD)
	local stroke = C.stroke(button, Theme.Color.Rarity.Common, Theme.Stroke.Emphasis)
	C.gradient(button, Theme.Color.Surface.Raised, Theme.Color.Surface.Sunken)
	local holder = C.new("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		Parent = button,
	})
	if not touch then
		C.text({
			parent = button,
			text = tostring(index),
			type = "Caption",
			size = UDim2.fromOffset(20, 18),
			position = UDim2.fromOffset(6, 4),
			color = Theme.Color.Text.Secondary,
			z = 4,
		})
	end
	local countBadge = C.frame({
		parent = button,
		color = Theme.Color.Surface.Base,
		transparency = 0.1,
		size = UDim2.fromOffset(34, 22),
		position = UDim2.new(1, -4, 1, -4),
		anchor = Vector2.new(1, 1),
		radius = Theme.Radius.Pill,
		z = 4,
	})
	local countLabel = C.text({
		parent = countBadge,
		text = "",
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		z = 5,
	})
	local scale = C.interactive(button)
	local slot = {
		button = button,
		stroke = stroke,
		holder = holder,
		count = countLabel,
		countBadge = countBadge,
		scale = scale,
		potionId = nil,
		viewport = nil,
		spin = nil,
		selected = false,
	}
	button.Activated:Connect(function()
		C.sound("click")
		if slot.potionId then
			local State = self.C.State
			if State.selected and State.selected.kind == "potion" and State.selected.id == slot.potionId then
				State:Select(nil)
			else
				State:Select({ kind = "potion", id = slot.potionId })
			end
		end
	end)
	button.MouseEnter:Connect(function()
		if slot.potionId then
			local potion = Potions.ById[slot.potionId]
			local count = self.C.State:PotionCount(slot.potionId)
			local body = potion.description
				.. "\n"
				.. (if count < 0 then "∞ Mastered" else ("%d bottles"):format(count))
			C.showTooltip(potion.name .. "  ·  " .. potion.rarity, body, Theme.rarityColor(potion.rarity))
			if slot.spin then
				slot.spin(true)
			end
		end
	end)
	button.MouseLeave:Connect(function()
		C.hideTooltip()
		if slot.spin and not slot.selected then
			slot.spin(false)
		end
	end)
	return slot
end

function Hotbar:_list(): { string }
	return self.C.State:HotbarPotions()
end

function Hotbar:Refresh()
	local list = self:_list()
	local pages = math.max(1, math.ceil(#list / SLOTS))
	self.page = math.clamp(self.page, 0, pages - 1)
	self.pageLabel.Text = ("%d/%d"):format(self.page + 1, pages)
	self.empty.Visible = #list == 0
	for index, slot in self.slots do
		local potionId = list[self.page * SLOTS + index]
		if slot.potionId ~= potionId then
			if slot.viewport then
				slot.viewport:Destroy()
				slot.viewport, slot.spin = nil, nil
			end
			slot.potionId = potionId
			if potionId then
				local potion = Potions.ById[potionId]
				slot.viewport, slot.spin =
					C.BottleIcon({ parent = slot.holder, potion = potion, size = UDim2.fromScale(1, 1), zoom = 1.25 })
				slot.stroke.Color = Theme.rarityColor(potion.rarity)
			else
				slot.stroke.Color = Theme.Color.Stroke.Subtle
			end
		end
		slot.button.Visible = #list > 0
		if potionId then
			local count = self.C.State:PotionCount(potionId)
			slot.count.Text = if count < 0 then "∞" else tostring(count)
			slot.count.TextColor3 = if count < 0
				then Theme.Color.Accent.Gold
				elseif count == 0 then Theme.Color.State.Danger
				else Theme.Color.Text.Primary
			slot.countBadge.Visible = true
			slot.button.BackgroundTransparency = if count == 0 then 0.6 else 0.1
		else
			slot.countBadge.Visible = false
			slot.button.BackgroundTransparency = 0.6
		end
	end
	-- Drop the selection if the selected potion is no longer available.
	local State = self.C.State
	if State.selected and State.selected.kind == "potion" and State:PotionCount(State.selected.id) == 0 then
		State:Select(nil)
	end
	self:_highlight()
end

function Hotbar:_highlight()
	local selection = self.C.State.selected
	for _, slot in self.slots do
		local selected = selection ~= nil and selection.kind == "potion" and slot.potionId == selection.id
		slot.selected = selected
		slot.scale.Scale = if selected then 1.1 else 1
		if slot.potionId then
			local potion = Potions.ById[slot.potionId]
			slot.stroke.Color = if selected then Theme.Color.Accent.Gold else Theme.rarityColor(potion.rarity)
			slot.stroke.Thickness = if selected then 4 else Theme.Stroke.Emphasis
		end
		if slot.spin then
			slot.spin(selected)
		end
	end
	if selection and selection.kind ~= "potion" then
		local label
		if selection.kind == "golem" then
			label = "🗿 Placing: " .. Skins.get(selection.id).name
		else
			local prop = PropsData.ById[selection.id]
			label = (if prop then prop.icon .. " Placing: " .. prop.name else "Placing")
		end
		self.chipLabel.Text = label .. (if self.ui.touch then "  (tap)" else "  (right-click)")
		self.chip.Visible = true
	else
		self.chip.Visible = false
	end
end

function Hotbar:SelectIndex(index: number)
	local slot = self.slots[index]
	if slot and slot.potionId then
		local State = self.C.State
		if State.selected and State.selected.kind == "potion" and State.selected.id == slot.potionId then
			State:Select(nil)
		else
			State:Select({ kind = "potion", id = slot.potionId })
			self.C.SoundController:Play("click", nil, { ui = true })
		end
	end
end

function Hotbar:Cycle(direction: number)
	local list = self:_list()
	if #list == 0 then
		return
	end
	local State = self.C.State
	local current = 0
	if State.selected and State.selected.kind == "potion" then
		current = table.find(list, State.selected.id) or 0
	end
	local nextIndex = (current - 1 + direction) % #list + 1
	State:Select({ kind = "potion", id = list[nextIndex] })
	self.page = (nextIndex - 1) // SLOTS
	self:Refresh()
end

function Hotbar:Page(direction: number)
	self.page += direction
	self:Refresh()
end

return Hotbar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- HUD: player card (level, rank, XP, coins, flasks), chaos combo meter, lab bar (owner, visitors,
-- home/visit), left menu rail and right lab-control rail.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Hud = {}

function Hud:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local root = ui.hud
	local State = controllers.State
	local touch = ui.touch

	-- ── Player card (top-left) ──
	local cardOuter, card = C.card({
		parent = root,
		size = UDim2.fromOffset(380, 112),
		position = UDim2.fromOffset(20, 16),
		radius = Theme.Radius.LG,
	})
	local badge = C.frame({
		parent = card,
		color = Theme.Color.Accent.Gold,
		size = UDim2.fromOffset(74, 74),
		position = UDim2.fromOffset(14, 14),
		radius = Theme.Radius.Pill,
		stroke = Theme.Color.Stroke.Gold,
		strokeThickness = 3,
	})
	C.gradient(badge, Theme.Color.Accent.Gold, Theme.Color.Accent.GoldDeep)
	local levelLabel = C.text({
		parent = badge,
		text = "1",
		type = "Title",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		color = Theme.Color.Text.Inverse,
		outline = false,
	})
	local _nameLabel = C.text({
		parent = card,
		text = controllers.State and game:GetService("Players").LocalPlayer.DisplayName or "",
		type = "Heading",
		size = UDim2.new(1, -110, 0, 30),
		position = UDim2.fromOffset(100, 10),
		truncate = true,
	})
	local rankLabel = C.text({
		parent = card,
		text = "Apprentice",
		type = "Caption",
		size = UDim2.new(1, -110, 0, 20),
		position = UDim2.fromOffset(100, 40),
		color = Theme.Color.Accent.Gold,
	})
	local xpBar = C.Progress({
		parent = card,
		size = UDim2.new(1, -116, 0, 16),
		position = UDim2.fromOffset(100, 66),
		showLabel = true,
		color = Theme.Color.Accent.Cyan,
		color2 = Color3.fromRGB(80, 140, 255),
	})
	local _ = cardOuter
	local pills = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 40),
		Position = UDim2.fromOffset(20, 136),
		Parent = root,
	})
	C.list(pills, Enum.FillDirection.Horizontal, Theme.Space.SM)
	local coinPill, coinLabel = C.Pill({
		parent = pills,
		icon = "🪙",
		text = "0",
		size = UDim2.fromOffset(170, 40),
		order = 1,
		stroke = Theme.Color.Stroke.Gold,
	})
	local flaskPill, flaskLabel =
		C.Pill({ parent = pills, icon = "🎁", text = "0", size = UDim2.fromOffset(110, 40), order = 2 })
	local coinButton =
		C.new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), Parent = coinPill })
	coinButton.Activated:Connect(function()
		ui:Open("shop")
	end)
	local flaskButton =
		C.new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), Parent = flaskPill })
	flaskButton.Activated:Connect(function()
		ui:Open("shop")
		local shop = ui.panels.shop
		if shop and shop.ShowTab then
			shop:ShowTab("flasks")
		end
	end)
	self.coinPill = coinPill

	local shownCoins = 0
	local function refresh(key)
		local data = State.data
		if not data then
			return
		end
		if key == "*" or key == "level" or key == "xp" then
			levelLabel.Text = tostring(data.level)
			rankLabel.Text = (if data.title ~= "" then data.title .. " · " else "") .. Config.rankForLevel(data.level)
			local need = Config.xpForLevel(data.level)
			xpBar.set(data.xp / need, ("%s / %s XP"):format(Format.short(data.xp), Format.short(need)))
		end
		if key == "*" or key == "coins" then
			local target = data.coins
			if key == "*" then
				coinLabel.Text = Format.commas(target)
			else
				C.countTo(coinLabel, shownCoins, target, function(v)
					return Format.commas(math.floor(v))
				end)
				if target > shownCoins then
					C.pulse(coinPill, 1.12)
				end
			end
			shownCoins = target
		end
		if key == "*" or key == "spins" then
			flaskLabel.Text = tostring(data.spins)
		end
		if key == "*" or key == "title" then
			rankLabel.Text = (if data.title ~= "" then data.title .. " · " else "") .. Config.rankForLevel(data.level)
		end
	end
	State.Changed:Connect(refresh)
	if State.data then
		refresh("*")
	end

	-- ── Chaos meter (top-centre) ──
	local chaosOuter, chaos = C.card({
		parent = root,
		size = UDim2.fromOffset(460, 86),
		position = UDim2.new(0.5, 0, 0, 14),
		anchor = Vector2.new(0.5, 0),
		radius = Theme.Radius.LG,
	})
	local chaosGroup = C.new(
		"CanvasGroup",
		{ BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), GroupTransparency = 1, Parent = chaosOuter }
	)
	chaos.Parent = chaosGroup
	local shadow = chaosOuter:FindFirstChild("Shadow")
	if shadow then
		shadow.Parent = chaosGroup
		shadow.ZIndex = 0
	end
	C.text({
		parent = chaos,
		text = "CHAOS",
		type = "Label",
		size = UDim2.fromOffset(120, 24),
		position = UDim2.fromOffset(20, 10),
		color = Theme.Color.Text.Secondary,
	})
	local chaosValue = C.text({
		parent = chaos,
		text = "0",
		type = "Title",
		textSize = 40,
		size = UDim2.new(1, -150, 0, 44),
		position = UDim2.fromOffset(20, 30),
		color = Theme.Color.Text.Primary,
	})
	local multiplier = C.frame({
		parent = chaos,
		color = Theme.comboColor(1),
		size = UDim2.fromOffset(96, 56),
		position = UDim2.new(1, -16, 0, 14),
		anchor = Vector2.new(1, 0),
		radius = Theme.Radius.MD,
	})
	local multiplierLabel = C.text({
		parent = multiplier,
		text = "x1",
		type = "Title",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		color = Theme.Color.Text.Inverse,
		outline = false,
	})
	local decay = C.Progress({
		parent = chaos,
		size = UDim2.new(1, -40, 0, 6),
		position = UDim2.new(0, 20, 1, -12),
		color = Theme.Color.Accent.Magenta,
		color2 = Theme.Color.Accent.Gold,
	})
	self.chaosGroup = chaosGroup
	local sessionChaos = 0
	local lastGain = 0
	local comboWindow = Config.Economy.ComboWindow
	controllers.VFXController.HudEvent:Connect(function(kind, payload)
		if kind == "chaos" then
			if payload.g and payload.g > 0 then
				local from = sessionChaos
				sessionChaos += payload.g
				C.countTo(chaosValue, from, sessionChaos, function(v)
					return Format.commas(math.floor(v))
				end)
				C.pulse(chaosValue, 1.18)
				lastGain = os.clock()
			end
			local level = payload.c or 1
			comboWindow = payload.w or comboWindow
			if multiplierLabel.Text ~= "x" .. level then
				multiplierLabel.Text = "x" .. level
				multiplier.BackgroundColor3 = Theme.comboColor(level)
				C.pulse(multiplier, 1.35)
				if level > 1 then
					controllers.SoundController:Play("coin", nil, { pitch = 0.7 + level * 0.15, ui = true })
				end
			end
		elseif kind == "coins" then
			C.pulse(coinPill, 1.15)
			local pop = C.text({
				parent = root,
				text = "+" .. Format.commas(payload.a),
				type = "Heading",
				size = UDim2.fromOffset(200, 30),
				position = UDim2.fromOffset(200, 176),
				color = Theme.Color.Accent.Gold,
				z = 5,
			})
			C.tween(
				pop,
				TweenInfo.new(1, Enum.EasingStyle.Quad),
				{ Position = UDim2.fromOffset(200, 150), TextTransparency = 1 }
			)
			task.delay(1, function()
				pop:Destroy()
			end)
		end
	end)
	RunService.RenderStepped:Connect(function()
		local since = os.clock() - lastGain
		local visible = since < 4 and not State.trial
		local target = if visible then 0 else 1
		chaosGroup.GroupTransparency += (target - chaosGroup.GroupTransparency) * 0.12
		decay.set(math.clamp(1 - since / comboWindow, 0, 1), nil, true)
		if since > comboWindow and multiplierLabel.Text ~= "x1" then
			multiplierLabel.Text = "x1"
			multiplier.BackgroundColor3 = Theme.comboColor(1)
		end
	end)

	-- ── Lab bar (top-right) ──
	local labOuter, lab = C.card({
		parent = root,
		size = UDim2.fromOffset(400, 64),
		position = UDim2.new(1, -20, 0, 16),
		anchor = Vector2.new(1, 0),
		radius = Theme.Radius.LG,
	})
	local labTitle = C.text({
		parent = lab,
		text = "🧪 Lab",
		type = "Label",
		size = UDim2.new(1, -150, 0, 26),
		position = UDim2.fromOffset(16, 8),
		truncate = true,
	})
	local labInfo = C.text({
		parent = lab,
		text = "",
		type = "Caption",
		size = UDim2.new(1, -150, 0, 20),
		position = UDim2.fromOffset(16, 34),
		color = Theme.Color.Text.Secondary,
		truncate = true,
	})
	local homeButton = C.Button({
		parent = lab,
		text = "Visit",
		icon = "🚪",
		width = 120,
		size = "sm",
		position = UDim2.new(1, -12, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		variant = "secondary",
		onClick = function()
			local labState = State.lab
			if labState and not labState.isOwner then
				Net.event("Command"):FireServer("home")
			else
				ui:Open("menu")
				local menu = ui.panels.menu
				if menu and menu.ShowTab then
					menu:ShowTab("visit")
				end
			end
		end,
	})
	local _ = labOuter
	State.LabChanged:Connect(function(labState)
		local mapName = require(Shared.Data.Maps).get(labState.mapId).name
		labTitle.Text = (if labState.isOwner then "🏠 Your Lab" else "🔍 " .. labState.ownerName .. "'s Lab")
			.. "  ·  "
			.. mapName
		local status = {}
		table.insert(status, ("🗿 %d/%d"):format(labState.golems, labState.maxGolems))
		if #labState.visitors > 1 then
			table.insert(status, ("👥 %d here"):format(#labState.visitors))
		end
		if labState.paused then
			table.insert(status, "⏸️ Paused")
		elseif labState.slowmo then
			table.insert(status, "🐌 Slow-mo")
		end
		labInfo.Text = table.concat(status, "   ")
		homeButton.setText(if labState.isOwner then "Visit" else "Home")
	end)

	-- ── Left rail: menus ──
	local leftRail = C.new("Frame", {
		Name = "LeftRail",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(90, 560),
		Position = UDim2.new(0, 22, 0.5, 30),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = root,
	})
	C.list(leftRail, Enum.FillDirection.Vertical, Theme.Space.MD)
	local size = if touch then Theme.Size.IconButtonTouch else Theme.Size.IconButton
	local leftButtons = {
		{ id = "brew", icon = "🧪", caption = "Brew", key = "B" },
		{ id = "codex", icon = "📖", caption = "Codex", key = "C" },
		{ id = "challenges", icon = "🏆", caption = "Quests", key = "J" },
		{ id = "shop", icon = "🛒", caption = "Shop", key = "O" },
		{ id = "menu", icon = "🗺️", caption = "World", key = "M" },
		{ id = "help", icon = "❔", caption = "Keys", key = "F1" },
	}
	self.railButtons = {}
	for index, spec in leftButtons do
		local handle = C.IconButton({
			parent = leftRail,
			icon = spec.icon,
			caption = spec.caption,
			keybind = if touch then nil else spec.key,
			sizePx = size,
			order = index,
			onClick = function()
				ui:Toggle(spec.id)
			end,
		})
		self.railButtons[spec.id] = handle
	end

	-- ── Right rail: lab controls ──
	local rightRail = C.new("Frame", {
		Name = "RightRail",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(90, 640),
		Position = UDim2.new(1, -22, 0.5, 30),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = root,
	})
	C.list(rightRail, Enum.FillDirection.Vertical, Theme.Space.MD, Enum.HorizontalAlignment.Right)
	local rightButtons = {
		{ id = "slowmo", icon = "🐌", caption = "Slow-mo", key = "G" },
		{ id = "pause", icon = "⏸️", caption = "Pause", key = "Space" },
		{ id = "heal", icon = "💖", caption = "Heal", key = "H" },
		{ id = "spawnLast", icon = "🗿", caption = "Spawn", key = "N" },
		{ id = "undo", icon = "↩️", caption = "Undo", key = "Z" },
		{ id = "reset", icon = "🔄", caption = "Reset", key = "R" },
		{ id = "photo", icon = "📷", caption = "Photo", key = "P" },
	}
	self.controlButtons = {}
	for index, spec in rightButtons do
		local handle = C.IconButton({
			parent = rightRail,
			icon = spec.icon,
			caption = spec.caption,
			keybind = if touch then nil else spec.key,
			sizePx = size,
			order = index,
			onClick = function()
				controllers.InputController.Action:Fire(spec.id)
			end,
		})
		self.controlButtons[spec.id] = handle
	end
	State.LabChanged:Connect(function(labState)
		self.controlButtons.slowmo.setActive(labState.slowmo)
		self.controlButtons.pause.setActive(labState.paused)
		self.controlButtons.pause.setIcon(if labState.paused then "▶️" else "⏸️")
	end)

	-- Notification dots on the rail.
	local function badges()
		local data = State.data
		if not data then
			return
		end
		local dailyLeft = 0
		for _, challenge in data.daily.list do
			if not challenge.done then
				dailyLeft += 1
			end
		end
		self.railButtons.challenges.setBadge(if dailyLeft > 0 then tostring(dailyLeft) else nil)
		self.railButtons.shop.setBadge(if data.spins > 0 then tostring(data.spins) else nil)
		local stock = data.rack and data.rack.stock or 0
		self.railButtons.brew.setBadge(if stock > 0 then "🌿" else nil)
	end
	State.Changed:Connect(function(key)
		if key == "*" or key == "daily" or key == "spins" or key == "rack" then
			badges()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">MenuPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- World menu: switch labs (maps), spawn golems & items, visit other players' labs, settings.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Maps = require(Shared.Data.Maps)
local PropsData = require(Shared.Data.Props)
local Skins = require(Shared.Data.Skins)
local GolemPreview = require(Shared.Visual.GolemPreview)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local MenuPanel = {}

function MenuPanel:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local modal = C.Modal({ parent = ui.modals, title = "🗺️ World", size = Vector2.new(1180, 700) })
	self.modal = modal
	modal.onClose = function()
		ui:PanelClosed("menu")
	end
	self.tab = "maps"
	self.tabs = C.Tabs({
		parent = modal.body,
		tabs = {
			{ id = "maps", label = "Labs", icon = "🏰" },
			{ id = "spawn", label = "Spawn", icon = "🗿" },
			{ id = "visit", label = "Visit", icon = "🚪" },
			{ id = "settings", label = "Settings", icon = "⚙️" },
		},
		onSelect = function(id)
			self.tab = id
			self:Refresh()
		end,
	})
	self.content = C.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -60),
		Position = UDim2.fromOffset(0, 60),
		Parent = modal.body,
	})
	controllers.State.LabChanged:Connect(function()
		if modal.isOpen() and (self.tab == "maps" or self.tab == "visit") then
			self:Refresh()
		end
	end)
end

function MenuPanel:ShowTab(id: string)
	self.tabs.select(id)
end

function MenuPanel:_clear()
	for _, child in self.content:GetChildren() do
		child:Destroy()
	end
end

function MenuPanel:_maps(data, lab)
	local scroll = C.Scroll({ parent = self.content })
	C.grid(scroll, Vector2.new(270, 250), Theme.Space.MD)
	C.padding(scroll, 4)
	for _, map in Maps.List do
		local unlocked = data.level >= map.unlockLevel or data.maps[map.id] or self.C.State.passes.MasterKey
		local current = lab and lab.mapId == map.id
		local _, card = C.card({
			parent = scroll,
			order = map.order,
			radius = Theme.Radius.LG,
			stroke = if current then Theme.Color.Stroke.Gold else Theme.Color.Stroke.Subtle,
		})
		local sky = C.frame({
			parent = card,
			size = UDim2.new(1, -16, 0, 110),
			position = UDim2.fromOffset(8, 8),
			radius = Theme.Radius.MD,
			color = Color3.new(1, 1, 1),
		})
		C.gradient(sky, map.lighting.skyTop, map.lighting.skyBottom)
		C.text({
			parent = sky,
			text = map.icon,
			type = "Display",
			textSize = 64,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.fromScale(1, 1),
			outline = false,
		})
		C.text({
			parent = card,
			text = map.name,
			type = "Heading",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 30),
			position = UDim2.fromOffset(0, 122),
		})
		C.text({
			parent = card,
			text = map.description,
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, -20, 0, 44),
			position = UDim2.fromOffset(10, 152),
			color = Theme.Color.Text.Secondary,
		})
		local button = C.Button({
			parent = card,
			text = if current
				then "You're here"
				elseif unlocked then "Go!"
				else ("🔒 Level %d"):format(map.unlockLevel),
			variant = if current then "ghost" elseif unlocked then "primary" else "secondary",
			size = "sm",
			width = 200,
			position = UDim2.new(0.5, 0, 1, -12),
			anchor = Vector2.new(0.5, 1),
			onClick = function()
				if lab and not lab.isOwner then
					self.ui:Toast("You can only change maps in your own lab.", "error")
					return
				end
				Net.event("Command"):FireServer("setMap", map.id)
				self.ui:Close()
			end,
		})
		button.setDisabled(not unlocked or current)
	end
end

function MenuPanel:_spawn(data)
	local scroll = C.Scroll({ parent = self.content })
	C.list(scroll, Enum.FillDirection.Vertical, Theme.Space.MD)
	C.padding(scroll, 4)
	C.text({
		parent = scroll,
		text = "Golems: pick one, then right-click / tap in the lab to place it",
		type = "Heading",
		size = UDim2.new(1, 0, 0, 30),
		order = 1,
		color = Theme.Color.Text.Secondary,
	})
	local golemRow = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = scroll,
	})
	C.grid(golemRow, Vector2.new(170, 210), Theme.Space.SM)
	for _, skin in Skins.List do
		if data.skins[skin.id] then
			local button = C.new("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = Theme.Color.Surface.Raised,
				LayoutOrder = skin.order,
				Parent = golemRow,
			})
			C.corner(button, Theme.Radius.MD)
			C.stroke(button, Theme.rarityColor(skin.rarity), Theme.Stroke.Default)
			local _, spin = C.Viewport({
				parent = button,
				model = GolemPreview.build(skin),
				size = UDim2.new(1, -10, 0, 160),
				position = UDim2.fromOffset(5, 5),
				zoom = 0.95,
			})
			C.text({
				parent = button,
				text = skin.name,
				type = "Caption",
				alignX = Enum.TextXAlignment.Center,
				size = UDim2.new(1, 0, 0, 30),
				position = UDim2.fromOffset(0, 172),
			})
			C.interactive(button)
			button.MouseEnter:Connect(function()
				spin(true)
			end)
			button.MouseLeave:Connect(function()
				spin(false)
			end)
			button.Activated:Connect(function()
				C.sound("click")
				self.C.State:Select({ kind = "golem", id = skin.id })
				self.ui:Close()
			end)
		end
	end
	C.text({
		parent = scroll,
		text = "Items",
		type = "Heading",
		size = UDim2.new(1, 0, 0, 30),
		order = 3,
		color = Theme.Color.Text.Secondary,
	})
	local propRow = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = scroll,
	})
	C.grid(propRow, Vector2.new(170, 150), Theme.Space.SM)
	for _, prop in PropsData.List do
		local locked = data.level < prop.unlockLevel
		local button = C.new("TextButton", {
			AutoButtonColor = false,
			Text = "",
			BackgroundColor3 = Theme.Color.Surface.Raised,
			BackgroundTransparency = if locked then 0.5 else 0,
			LayoutOrder = prop.order,
			Parent = propRow,
		})
		C.corner(button, Theme.Radius.MD)
		C.stroke(button, Theme.Color.Stroke.Strong, Theme.Stroke.Default)
		C.text({
			parent = button,
			text = prop.icon,
			type = "Display",
			textSize = 52,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 70),
			position = UDim2.fromOffset(0, 8),
			outline = false,
		})
		C.text({
			parent = button,
			text = prop.name,
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 24),
			position = UDim2.fromOffset(0, 80),
		})
		C.text({
			parent = button,
			text = if locked then ("🔒 Level %d"):format(prop.unlockLevel) else prop.description,
			type = "Caption",
			textSize = 12,
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, -10, 0, 40),
			position = UDim2.fromOffset(5, 104),
			color = Theme.Color.Text.Secondary,
		})
		C.interactive(button)
		button.Activated:Connect(function()
			if locked then
				C.sound("error")
				return
			end
			C.sound("click")
			self.C.State:Select({ kind = "prop", id = prop.id })
			self.ui:Close()
		end)
	end
	C.Button({
		parent = scroll,
		text = "Clear all items",
		icon = "🧹",
		variant = "danger",
		size = "md",
		width = 260,
		order = 5,
		onClick = function()
			Net.event("Command"):FireServer("clearProps")
		end,
	})
end

function MenuPanel:_visit(lab)
	local holder = self.content
	local State = self.C.State
	if not lab then
		return
	end
	if not lab.isOwner then
		C.text({
			parent = holder,
			text = ("You're visiting %s's lab."):format(lab.ownerName),
			type = "Heading",
			size = UDim2.new(1, 0, 0, 34),
		})
		C.Button({
			parent = holder,
			text = "Go home",
			icon = "🏠",
			variant = "primary",
			width = 220,
			position = UDim2.fromOffset(0, 44),
			onClick = function()
				Net.event("Command"):FireServer("home")
				self.ui:Close()
			end,
		})
	else
		C.text({ parent = holder, text = "Who can visit your lab?", type = "Heading", size = UDim2.new(1, 0, 0, 34) })
		local row = C.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 48),
			Position = UDim2.fromOffset(0, 40),
			Parent = holder,
		})
		C.list(row, Enum.FillDirection.Horizontal, Theme.Space.SM)
		for index, option in
			{ { "everyone", "🌍 Everyone" }, { "friends", "🤝 Friends" }, { "nobody", "🔒 Nobody" } }
		do
			C.Button({
				parent = row,
				text = option[2],
				width = 180,
				order = index,
				variant = if lab.privacy == option[1] then "primary" else "secondary",
				onClick = function()
					Net.event("Command"):FireServer("privacy", option[1])
					task.delay(0.3, function()
						self:Refresh()
					end)
				end,
			})
		end
	end
	C.text({
		parent = holder,
		text = "Labs on this server",
		type = "Heading",
		size = UDim2.new(1, 0, 0, 34),
		position = UDim2.fromOffset(0, 110),
		color = Theme.Color.Text.Secondary,
	})
	local list = C.Scroll({ parent = holder, size = UDim2.new(1, 0, 1, -160), position = UDim2.fromOffset(0, 150) })
	C.list(list, Enum.FillDirection.Vertical, Theme.Space.SM)
	if #lab.labs == 0 then
		C.text({
			parent = list,
			text = "No other labs yet. Invite a friend!",
			type = "Body",
			size = UDim2.new(1, 0, 0, 40),
			color = Theme.Color.Text.Muted,
		})
	end
	for index, other in lab.labs do
		local _, card =
			C.card({ parent = list, size = UDim2.new(1, -12, 0, 72), order = index, radius = Theme.Radius.MD })
		local map = Maps.get(other.mapId)
		C.text({
			parent = card,
			text = ("%s  %s's Lab"):format(map.icon, other.name),
			type = "Heading",
			size = UDim2.new(1, -260, 0, 32),
			position = UDim2.fromOffset(16, 8),
		})
		C.text({
			parent = card,
			text = map.name .. "  ·  " .. (if other.privacy == "everyone"
				then "Open"
				elseif other.privacy == "friends" then "Friends only"
				else "Private"),
			type = "Caption",
			size = UDim2.new(1, -260, 0, 22),
			position = UDim2.fromOffset(16, 40),
			color = Theme.Color.Text.Secondary,
		})
		local button = C.Button({
			parent = card,
			text = if other.userId == lab.ownerId then "Here" else "Visit",
			icon = "🚪",
			width = 160,
			variant = "primary",
			position = UDim2.new(1, -14, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			onClick = function()
				local result = Net.func("Visit"):InvokeServer(other.userId)
				if result and result.ok then
					self.ui:Close()
					self.ui:Toast("Welcome to " .. other.name .. "'s lab! 👋", "social")
				else
					self.ui:Toast(result and result.reason or "Can't visit right now.", "error")
				end
			end,
		})
		button.setDisabled(other.privacy == "nobody" or other.userId == lab.ownerId)
	end
	local _ = State
end

function MenuPanel:_settings(data)
	local scroll = C.Scroll({ parent = self.content })
	C.list(scroll, Enum.FillDirection.Vertical, Theme.Space.LG)
	C.padding(scroll, 8, 40)
	local settings = data.settings
	local function send(key, value)
		Net.event("Settings"):FireServer(key, value)
	end
	C.Slider({
		parent = scroll,
		label = "🔊 Sound effects",
		value = settings.sfx or 0.8,
		order = 1,
		onChange = function(v)
			send("sfx", v)
		end,
	})
	C.Slider({
		parent = scroll,
		label = "🎵 Music",
		value = settings.music or 0.5,
		order = 2,
		onChange = function(v)
			send("music", v)
		end,
	})
	C.Slider({
		parent = scroll,
		label = "📳 Screen shake",
		value = settings.shake or 1,
		order = 3,
		onChange = function(v)
			send("shake", v)
		end,
	})
	local qualityRow =
		C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 4, Parent = scroll })
	C.text({ parent = qualityRow, text = "✨ Graphics", type = "Label", size = UDim2.fromOffset(200, 50) })
	for index, option in { { "high", "High" }, { "low", "Performance" } } do
		C.Button({
			parent = qualityRow,
			text = option[2],
			width = 180,
			position = UDim2.fromOffset(200 + (index - 1) * 190, 0),
			variant = if (settings.quality or "high") == option[1] then "primary" else "secondary",
			onClick = function()
				send("quality", option[1])
				task.delay(0.3, function()
					self:Refresh()
				end)
			end,
		})
	end
	C.Button({
		parent = scroll,
		text = "Replay the tutorial",
		icon = "🎓",
		width = 300,
		order = 5,
		onClick = function()
			send("tutorial", 0)
			self.ui:Close()
			self.ui.Tutorial:Begin(1)
		end,
	})
	C.text({
		parent = scroll,
		text = "Flask Fiasco · an original potion sandbox. Have fun experimenting!",
		type = "Caption",
		size = UDim2.new(1, 0, 0, 24),
		order = 6,
		color = Theme.Color.Text.Muted,
	})
end

function MenuPanel:Refresh()
	local State = self.C.State
	local data, lab = State.data, State.lab
	if not data then
		return
	end
	self:_clear()
	if self.tab == "maps" then
		self:_maps(data, lab)
	elseif self.tab == "spawn" then
		self:_spawn(data)
	elseif self.tab == "visit" then
		self:_visit(lab)
	else
		self:_settings(data)
	end
end

function MenuPanel:Open()
	self:Refresh()
	self.modal.open()
end

function MenuPanel:Close()
	self.modal.close()
end

return MenuPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Feedback layer: toasts, level-up banner, the full-screen potion discovery reveal, reaction
-- discoveries, challenge completions, the daily streak popup and the endgame "Ascended" moment.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Potions = require(Shared.Data.Potions)
local Reactions = require(Shared.Data.Reactions)
local Rarity = require(Shared.Data.Rarity)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Notifications = {}

local TOAST_ICONS = { info = "💬", success = "✅", error = "⚠️", reward = "🎁", social = "👋" }
local MAX_TOASTS = 4

function Notifications:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local root = ui.overlayScaled
	self.root = root
	self.toasts = {}
	self.queue = {}
	self.revealing = false

	local stack = C.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(Theme.Size.Toast.X, 400),
		Position = UDim2.new(1, -20, 0, 150),
		AnchorPoint = Vector2.new(1, 0),
		Parent = root,
	})
	C.list(stack, Enum.FillDirection.Vertical, Theme.Space.SM, Enum.HorizontalAlignment.Right)
	self.stack = stack

	controllers.State.Notified:Connect(function(kind, payload)
		self:_handle(kind, payload)
	end)
end

function Notifications:Toast(text: string, kind: string?)
	kind = kind or "info"
	local accent = Theme.Color.Toast[kind] or Theme.Color.Toast.info
	local outer, body = C.card({
		parent = self.stack,
		size = UDim2.fromOffset(Theme.Size.Toast.X, Theme.Size.Toast.Y),
		radius = Theme.Radius.MD,
		stroke = accent,
	})
	outer.LayoutOrder = -os.clock() * 1000
	local bar = C.frame({
		parent = body,
		color = accent,
		size = UDim2.new(0, 6, 1, -16),
		position = UDim2.fromOffset(8, 8),
		radius = Theme.Radius.Pill,
	})
	local _ = bar
	C.text({
		parent = body,
		text = TOAST_ICONS[kind] or "💬",
		type = "Heading",
		size = UDim2.fromOffset(40, 64),
		position = UDim2.fromOffset(18, 0),
		alignX = Enum.TextXAlignment.Center,
		outline = false,
	})
	C.text({
		parent = body,
		text = text,
		type = "Caption",
		textSize = 15,
		size = UDim2.new(1, -72, 1, -8),
		position = UDim2.fromOffset(62, 4),
		wrap = true,
	})
	local scale = C.new("UIScale", { Scale = 0.6, Parent = outer })
	C.tween(scale, Theme.Motion.ToastIn, { Scale = 1 })
	table.insert(self.toasts, outer)
	while #self.toasts > MAX_TOASTS do
		local oldest = table.remove(self.toasts, 1)
		oldest:Destroy()
	end
	if kind == "error" then
		self.C.SoundController:Play("error", nil, { ui = true })
	elseif kind == "reward" then
		self.C.SoundController:Play("coin", nil, { ui = true })
	end
	task.delay(Theme.Motion.ToastHold, function()
		if outer.Parent then
			C.tween(scale, Theme.Motion.ToastOut, { Scale = 0 })
			task.wait(Theme.Motion.ToastOut.Time)
			local index = table.find(self.toasts, outer)
			if index then
				table.remove(self.toasts, index)
			end
			outer:Destroy()
		end
	end)
end

-- Centre banner (level up, challenge done...).
function Notifications:Banner(title: string, subtitle: string, color: Color3, chips: { string }?)
	local outer, body = C.card({
		parent = self.root,
		size = UDim2.fromOffset(620, if chips and #chips > 0 then 170 else 124),
		position = UDim2.new(0.5, 0, 0.22, 0),
		anchor = Vector2.new(0.5, 0.5),
		radius = Theme.Radius.LG,
		stroke = color,
		elevation = "E2",
	})
	C.text({
		parent = body,
		text = title,
		type = "Display",
		textSize = 52,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 64),
		position = UDim2.fromOffset(0, 10),
		color = color,
	})
	C.text({
		parent = body,
		text = subtitle,
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 32),
		position = UDim2.fromOffset(0, 74),
	})
	if chips and #chips > 0 then
		local row = C.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -40, 0, 36),
			Position = UDim2.fromOffset(20, 118),
			Parent = body,
		})
		C.list(row, Enum.FillDirection.Horizontal, Theme.Space.SM, Enum.HorizontalAlignment.Center)
		for index, chip in chips do
			local pill = C.frame({
				parent = row,
				color = Theme.Color.Surface.Raised,
				size = UDim2.fromOffset(0, 34),
				autoSize = Enum.AutomaticSize.X,
				radius = Theme.Radius.Pill,
				stroke = Theme.Color.Stroke.Gold,
				order = index,
			})
			C.padding(pill, 0, Theme.Space.MD)
			C.text({
				parent = pill,
				text = chip,
				type = "Caption",
				size = UDim2.fromOffset(0, 34),
				autoSize = Enum.AutomaticSize.X,
				alignX = Enum.TextXAlignment.Center,
			})
		end
	end
	local scale = C.new("UIScale", { Scale = 0.4, Parent = outer })
	C.tween(scale, Theme.Motion.Reveal, { Scale = 1 })
	task.delay(3.2, function()
		C.tween(scale, Theme.Motion.PanelOut, { Scale = 0 })
		task.wait(0.2)
		outer:Destroy()
	end)
end

-- Rotating light rays behind reveals.
local function rays(parent: Instance, color: Color3, z: number)
	local holder = C.new("Frame", {
		Name = "Rays",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(900, 900),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = z,
		Parent = parent,
	})
	for layer = 1, 2 do
		local fan =
			C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = holder })
		for i = 0, 11 do
			local ray = C.new("Frame", {
				BackgroundColor3 = color,
				BackgroundTransparency = 0.55 + layer * 0.12,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 34 - layer * 8, 0.5, 0),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 1),
				Rotation = i * 30 + layer * 15,
				ZIndex = z,
				Parent = fan,
			})
			C.new("UIGradient", { Transparency = NumberSequence.new(0, 1), Rotation = -90, Parent = ray })
		end
		fan:SetAttribute("Speed", if layer == 1 then 20 else -14)
	end
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not holder.Parent then
			conn:Disconnect()
			return
		end
		for _, fan in holder:GetChildren() do
			if fan:IsA("Frame") then
				for _, ray in fan:GetChildren() do
					if ray:IsA("Frame") then
						ray.Rotation += (fan:GetAttribute("Speed") or 20) * dt
					end
				end
			end
		end
	end)
	return holder
end

local function confetti(parent: Instance, z: number)
	local colors =
		{ Theme.Color.Accent.Gold, Theme.Color.Accent.Magenta, Theme.Color.Accent.Cyan, Theme.Color.Accent.Lime }
	for _ = 1, 60 do
		local piece = C.new("Frame", {
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(math.random(8, 16), math.random(6, 12)),
			Position = UDim2.new(0.5, 0, 0.45, 0),
			Rotation = math.random(0, 360),
			ZIndex = z,
			Parent = parent,
		})
		local angle = math.random() * math.pi * 2
		local distance = math.random(250, 700)
		local target = UDim2.new(0.5, math.cos(angle) * distance, 0.45, math.sin(angle) * distance * 0.7 + 200)
		C.tween(
			piece,
			TweenInfo.new(math.random(10, 18) / 10, Enum.EasingStyle.Quart),
			{ Position = target, Rotation = piece.Rotation + math.random(-360, 360), BackgroundTransparency = 1 }
		)
		task.delay(2, function()
			piece:Destroy()
		end)
	end
end

function Notifications:Reveal(potionId: string)
	local potion = Potions.ById[potionId]
	if not potion then
		return
	end
	if self.revealing then
		table.insert(self.queue, potionId)
		return
	end
	self.revealing = true
	local color = Theme.rarityColor(potion.rarity)
	local screen = C.new("Frame", {
		Name = "Reveal",
		BackgroundColor3 = Theme.Color.Surface.Base,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 250,
		Active = true,
		Parent = self.root,
	})
	C.tween(screen, Theme.Motion.Fade, { BackgroundTransparency = 0.25 })
	rays(screen, color, 251)
	local viewport, spin = C.BottleIcon({
		parent = screen,
		potion = potion,
		size = UDim2.fromOffset(300, 300),
		position = UDim2.fromScale(0.5, 0.42),
		anchor = Vector2.new(0.5, 0.5),
		z = 253,
		spin = true,
		zoom = 1.1,
	})
	local _ = spin
	local vscale = C.new("UIScale", { Scale = 0.2, Parent = viewport })
	C.tween(vscale, Theme.Motion.Reveal, { Scale = 1 })
	C.text({
		parent = screen,
		text = "NEW POTION DISCOVERED!",
		type = "Title",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 44),
		position = UDim2.fromScale(0.5, 0.13),
		anchor = Vector2.new(0.5, 0.5),
		color = Theme.Color.Accent.Gold,
		z = 254,
	})
	local chip = C.frame({
		parent = screen,
		color = color,
		size = UDim2.fromOffset(170, 34),
		position = UDim2.fromScale(0.5, 0.62),
		anchor = Vector2.new(0.5, 0.5),
		radius = Theme.Radius.Pill,
		z = 254,
	})
	C.text({
		parent = chip,
		text = potion.rarity:upper(),
		type = "Label",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromScale(1, 1),
		color = Theme.Color.Text.Inverse,
		outline = false,
		z = 255,
	})
	C.text({
		parent = screen,
		text = potion.name,
		type = "Display",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 72),
		position = UDim2.fromScale(0.5, 0.7),
		anchor = Vector2.new(0.5, 0.5),
		color = color,
		z = 254,
	})
	C.text({
		parent = screen,
		text = potion.description,
		type = "Body",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(0, 760, 0, 60),
		position = UDim2.fromScale(0.5, 0.78),
		anchor = Vector2.new(0.5, 0.5),
		wrap = true,
		color = Theme.Color.Text.Secondary,
		z = 254,
	})
	local rarity = Rarity[potion.rarity]
	C.text({
		parent = screen,
		text = ("+%d XP   +%d 🪙"):format(rarity and rarity.discoverXp or 0, rarity and rarity.discoverCoins or 0),
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 34),
		position = UDim2.fromScale(0.5, 0.84),
		anchor = Vector2.new(0.5, 0.5),
		color = Theme.Color.Accent.Gold,
		z = 254,
	})
	confetti(screen, 252)
	self.C.SoundController:Play("discover", nil, { ui = true })
	local function close()
		if not screen.Parent then
			return
		end
		C.tween(screen, Theme.Motion.PanelOut, { BackgroundTransparency = 1 })
		screen:Destroy()
		self.revealing = false
		local nextId = table.remove(self.queue, 1)
		if nextId then
			task.delay(0.2, function()
				self:Reveal(nextId)
			end)
		end
	end
	C.Button({
		parent = screen,
		text = "Awesome!",
		icon = "✨",
		variant = "primary",
		size = "lg",
		width = 260,
		position = UDim2.fromScale(0.5, 0.92),
		anchor = Vector2.new(0.5, 0.5),
		z = 256,
		onClick = close,
	})
	task.delay(7, close)
end

function Notifications:_handle(kind: string, payload)
	local State = self.C.State
	if kind == "toast" then
		self:Toast(payload.text, payload.kind)
	elseif kind == "levelup" then
		local chips = {}
		for _, unlock in payload.unlocks or {} do
			table.insert(chips, unlock.icon .. " " .. unlock.name)
		end
		self:Banner(
			"LEVEL " .. payload.level .. "!",
			payload.rank .. "  ·  +" .. payload.coins .. " 🪙",
			Theme.Color.Accent.Gold,
			chips
		)
		self.C.SoundController:Play("levelup", nil, { ui = true })
	elseif kind == "discover" then
		self:Reveal(payload.id)
	elseif kind == "reactionDiscovered" then
		local reaction = Reactions.ById[payload.id]
		if reaction then
			self:Banner(
				reaction.icon .. " NEW REACTION!",
				reaction.name .. ": " .. reaction.description,
				reaction.color
			)
			self.C.SoundController:Play("discover", nil, { ui = true })
		end
	elseif kind == "challenge" then
		self:Toast(
			("%s Challenge complete: %s  (+%d 🪙  +%d XP)"):format(
				payload.icon or "🏆",
				payload.text,
				payload.coins,
				payload.xp
			),
			"reward"
		)
		self.C.SoundController:Play("reward", nil, { ui = true })
	elseif kind == "welcome" then
		if payload.temporary then
			self:Toast("Saving is unavailable right now. Your progress this session may not be kept.", "error")
		end
		if payload.streakReady then
			task.delay(1.5, function()
				self:StreakPopup()
			end)
		end
	elseif kind == "ascended" then
		self:Banner(
			"ASCENDED!",
			"You are a Grand Alchemist. The Ascended Golem skin is yours.",
			Theme.Color.Rarity.Mythic,
			{ "😇 Ascended Golem", "👑 Grand Alchemist title" }
		)
	end
	local _ = State
end

function Notifications:StreakPopup()
	local State = self.C.State
	local data = State.data
	if not data then
		return
	end
	local today = math.floor(os.time() / 86400)
	local nextCount = if data.streak.day == today - 1 then data.streak.count + 1 else 1
	local modal = C.Modal({ parent = self.ui.modals, title = "🎁 Daily Reward", size = Vector2.new(860, 420) })
	local row = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 170), Parent = modal.body })
	C.list(row, Enum.FillDirection.Horizontal, Theme.Space.SM, Enum.HorizontalAlignment.Center)
	for day, reward in Config.DailyStreakRewards do
		local cycleDay = (nextCount - 1) % #Config.DailyStreakRewards + 1
		local isToday = day == cycleDay
		local claimed = day < cycleDay
		local _, cell = C.card({
			parent = row,
			size = UDim2.fromOffset(104, 160),
			order = day,
			radius = Theme.Radius.MD,
			stroke = if isToday then Theme.Color.Stroke.Gold else Theme.Color.Stroke.Subtle,
		})
		C.text({
			parent = cell,
			text = "Day " .. day,
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 26),
			position = UDim2.fromOffset(0, 8),
			color = if isToday then Theme.Color.Accent.Gold else Theme.Color.Text.Secondary,
		})
		C.text({
			parent = cell,
			text = if claimed then "✅" elseif reward.spins then "🎁" else "🪙",
			type = "Title",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 50),
			position = UDim2.fromOffset(0, 40),
			outline = false,
		})
		C.text({
			parent = cell,
			text = tostring(reward.coins or 0),
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 24),
			position = UDim2.fromOffset(0, 96),
		})
		if reward.spins then
			C.text({
				parent = cell,
				text = "+" .. reward.spins .. " flask",
				type = "Caption",
				alignX = Enum.TextXAlignment.Center,
				size = UDim2.new(1, 0, 0, 20),
				position = UDim2.fromOffset(0, 122),
				color = Theme.Color.Accent.Magenta,
			})
		end
	end
	C.text({
		parent = modal.body,
		text = ("Streak: %d day%s. Come back tomorrow for more!"):format(nextCount, if nextCount == 1 then "" else "s"),
		type = "Body",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 30),
		position = UDim2.fromOffset(0, 190),
		color = Theme.Color.Text.Secondary,
	})
	C.Button({
		parent = modal.body,
		text = "Claim!",
		icon = "🎁",
		variant = "primary",
		size = "lg",
		width = 280,
		position = UDim2.new(0.5, 0, 0, 236),
		anchor = Vector2.new(0.5, 0),
		onClick = function()
			local result = Net.func("Shop"):InvokeServer("claimDaily")
			if result and result.ok then
				self:Toast(("Day %d reward claimed!"):format(result.day), "reward")
				self.C.SoundController:Play("reward", nil, { ui = true })
			elseif result then
				self:Toast(result.reason or "Already claimed", "info")
			end
			modal.close()
		end,
	})
	modal.onClose = function()
		task.delay(0.3, function()
			modal.root:Destroy()
		end)
	end
	modal.open()
	local _ = TweenService
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Shop: ingredients, golem skins (3D previews), Mystery Flask spins (animated reel), Robux passes
-- and products, and code redemption.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Ingredients = require(Shared.Data.Ingredients)
local Net = require(Shared.Net)
local Skins = require(Shared.Data.Skins)
local Spins = require(Shared.Data.Spins)
local GolemPreview = require(Shared.Visual.GolemPreview)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local ShopPanel = {}

local PASSES = {
	{
		key = "VIP",
		icon = "👑",
		name = "VIP",
		body = "2x coins & XP, the Gold Golem skin and a golden name.",
		robux = 249,
	},
	{
		key = "Satchel",
		icon = "🎒",
		name = "Alchemist's Satchel",
		body = "+2 bottles every time you brew.",
		robux = 299,
	},
	{
		key = "LabExpansion",
		icon = "🏗️",
		name = "Lab Expansion",
		body = "Up to 12 golems in your lab at once.",
		robux = 199,
	},
	{ key = "MasterKey", icon = "🗝️", name = "Master Key", body = "Unlock every lab map right now.", robux = 399 },
}

local SOURCE_TEXT = {
	level = function(skin)
		return "Reach level " .. tostring(skin.level)
	end,
	spin = function()
		return "From Mystery Flasks"
	end,
	code = function()
		return "Code reward"
	end,
	vip = function()
		return "VIP pass"
	end,
	trial = function()
		return "Brew the Philosopher's Elixir"
	end,
}

local function invoke(...)
	local ok, result = pcall(function(...)
		return Net.func("Shop"):InvokeServer(...)
	end, ...)
	if ok then
		return result
	end
	return { ok = false, reason = "Connection hiccup, try again." }
end

function ShopPanel:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local modal = C.Modal({ parent = ui.modals, title = "🛒 Alchemy Shop", size = Vector2.new(1180, 700) })
	self.modal = modal
	modal.onClose = function()
		ui:PanelClosed("shop")
	end
	self.tab = "ingredients"
	self.tabs = C.Tabs({
		parent = modal.body,
		tabs = {
			{ id = "ingredients", label = "Ingredients", icon = "🌿", width = 190 },
			{ id = "golems", label = "Golems", icon = "🗿", width = 160 },
			{ id = "flasks", label = "Flasks", icon = "🎁", width = 150 },
			{ id = "robux", label = "Robux", icon = "💎", width = 150 },
			{ id = "codes", label = "Codes", icon = "🏷️", width = 150 },
		},
		onSelect = function(id)
			self.tab = id
			self:Refresh()
		end,
	})
	self.coins = C.text({
		parent = modal.body,
		text = "",
		type = "Heading",
		alignX = Enum.TextXAlignment.Right,
		size = UDim2.fromOffset(260, 40),
		position = UDim2.new(1, 0, 0, 2),
		anchor = Vector2.new(1, 0),
		color = Theme.Color.Accent.Gold,
	})
	self.content = C.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -60),
		Position = UDim2.fromOffset(0, 60),
		Parent = modal.body,
	})
	controllers.State.Changed:Connect(function(key)
		if not modal.isOpen() then
			return
		end
		if key == "coins" or key == "*" then
			self.coins.Text = "🪙 " .. Format.commas(controllers.State.data.coins)
		end
		if
			not self.spinning
			and (key == "skins" or key == "equippedSkin" or key == "ingredients" or key == "spins" or key == "*")
		then
			self:Refresh()
		end
	end)
	controllers.State.Changed:Connect(function(key)
		if key == "passes" and modal.isOpen() and self.tab == "robux" then
			self:Refresh()
		end
	end)
end

function ShopPanel:ShowTab(id: string)
	self.tabs.select(id)
end

function ShopPanel:_clear()
	for _, child in self.content:GetChildren() do
		child:Destroy()
	end
end

function ShopPanel:_ingredients(data)
	local scroll = C.Scroll({ parent = self.content })
	C.grid(scroll, Vector2.new(214, 196), Theme.Space.MD)
	C.padding(scroll, 4)
	for _, ingredient in Ingredients.List do
		if ingredient.price <= 0 then
			continue
		end
		local locked = data.level < ingredient.unlockLevel
		local _, card = C.card({
			parent = scroll,
			order = ingredient.order,
			radius = Theme.Radius.LG,
			stroke = Theme.rarityColor(ingredient.rarity),
		})
		C.text({
			parent = card,
			text = ingredient.icon,
			type = "Title",
			textSize = 46,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 58),
			position = UDim2.fromOffset(0, 8),
			outline = false,
		})
		C.text({
			parent = card,
			text = ingredient.name,
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 24),
			position = UDim2.fromOffset(0, 68),
		})
		C.text({
			parent = card,
			text = ("%s · owned %d"):format(ingredient.rarity, data.ingredients[ingredient.id] or 0),
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 20),
			position = UDim2.fromOffset(0, 92),
			color = Theme.rarityColor(ingredient.rarity),
		})
		if locked then
			C.text({
				parent = card,
				text = "🔒 Unlocks at level " .. ingredient.unlockLevel,
				type = "Caption",
				alignX = Enum.TextXAlignment.Center,
				size = UDim2.new(1, 0, 0, 40),
				position = UDim2.fromOffset(0, 130),
				color = Theme.Color.Text.Muted,
			})
		else
			for i, qty in { 1, 5 } do
				local cost = ingredient.price * qty
				local button = C.Button({
					parent = card,
					text = ("x%d  %s"):format(qty, Format.short(cost)),
					icon = "🪙",
					size = "sm",
					width = 94,
					variant = if i == 2 then "primary" else "secondary",
					position = UDim2.new(if i == 1 then 0.27 else 0.73, 0, 1, -12),
					anchor = Vector2.new(0.5, 1),
					onClick = function()
						local result = invoke("buyIngredient", ingredient.id, qty)
						if result.ok then
							self.C.SoundController:Play("coin", nil, { ui = true })
						else
							self.ui:Toast(result.reason or "Can't buy that", "error")
						end
					end,
				})
				button.setDisabled(data.coins < cost)
			end
		end
	end
end

function ShopPanel:_golems(data)
	local scroll = C.Scroll({ parent = self.content })
	C.grid(scroll, Vector2.new(214, 290), Theme.Space.MD)
	C.padding(scroll, 4)
	for _, skin in Skins.List do
		local owned = data.skins[skin.id] == true
		local equipped = data.equippedSkin == skin.id
		local _, card = C.card({
			parent = scroll,
			order = skin.order,
			radius = Theme.Radius.LG,
			stroke = if equipped then Theme.Color.Stroke.Gold else Theme.rarityColor(skin.rarity),
		})
		local _, spin = C.Viewport({
			parent = card,
			model = GolemPreview.build(skin),
			size = UDim2.new(1, -16, 0, 160),
			position = UDim2.fromOffset(8, 8),
			zoom = 0.95,
			spinSpeed = 1,
		})
		card.MouseEnter:Connect(function()
			spin(true)
		end)
		card.MouseLeave:Connect(function()
			spin(false)
		end)
		C.text({
			parent = card,
			text = skin.name,
			type = "Label",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 24),
			position = UDim2.fromOffset(0, 170),
		})
		local traits = {}
		for trait in skin.traits do
			table.insert(traits, trait)
		end
		C.text({
			parent = card,
			text = skin.rarity .. (if #traits > 0 then " · " .. table.concat(traits, ", ") else ""),
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, -8, 0, 20),
			position = UDim2.fromOffset(4, 194),
			color = Theme.rarityColor(skin.rarity),
			truncate = true,
		})
		local label, variant, action
		if equipped then
			label, variant = "Equipped ✓", "ghost"
		elseif owned then
			label, variant, action = "Equip", "secondary", "equipSkin"
		elseif skin.source == "shop" and skin.price then
			label, variant, action = "🪙 " .. Format.commas(skin.price), "primary", "buySkin"
		else
			local describe = SOURCE_TEXT[skin.source]
			label, variant = if describe then describe(skin) else "Locked", "ghost"
		end
		local button = C.Button({
			parent = card,
			text = label,
			size = "sm",
			width = 190,
			variant = variant,
			position = UDim2.new(0.5, 0, 1, -12),
			anchor = Vector2.new(0.5, 1),
			onClick = function()
				if not action then
					return
				end
				local result = invoke(action, skin.id)
				if result.ok then
					self.C.SoundController:Play(if action == "buySkin" then "reward" else "click", nil, { ui = true })
					if action == "buySkin" then
						self.ui:Toast("New golem: " .. skin.name .. "! Spawn it from World > Spawn.", "reward")
					end
				else
					self.ui:Toast(result.reason or "Can't do that", "error")
				end
			end,
		})
		if action == "buySkin" then
			button.setDisabled(data.coins < (skin.price or 0))
		end
		if spin then
			spin(false)
		end
	end
end

function ShopPanel:_flasks(data)
	local holder = self.content
	C.text({
		parent = holder,
		text = "🎁",
		type = "Display",
		textSize = 110,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 130),
		position = UDim2.fromOffset(0, 0),
		outline = false,
	})
	C.text({
		parent = holder,
		text = ("You have %d Mystery Flask%s"):format(data.spins, if data.spins == 1 then "" else "s"),
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 34),
		position = UDim2.fromOffset(0, 130),
	})
	C.text({
		parent = holder,
		text = "Earn them from daily quests, level ups, login streaks and codes.",
		type = "Caption",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 22),
		position = UDim2.fromOffset(0, 164),
		color = Theme.Color.Text.Secondary,
	})
	-- Reel.
	local window = C.frame({
		parent = holder,
		color = Theme.Color.Surface.Sunken,
		size = UDim2.new(1, -40, 0, 150),
		position = UDim2.fromOffset(20, 200),
		radius = Theme.Radius.LG,
		stroke = Theme.Color.Stroke.Strong,
		clip = true,
	})
	local reel = C.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 130),
		Position = UDim2.fromOffset(0, 10),
		Parent = window,
	})
	local cellWidth, gap = 130, 10
	local cells = 50
	local entries = {}
	for i = 1, cells do
		local entry = Spins.List[(i - 1) % #Spins.List + 1]
		entries[i] = entry
	end
	local function buildCell(i: number, entry)
		local cell = C.frame({
			parent = reel,
			color = Theme.Color.Surface.Raised,
			size = UDim2.fromOffset(cellWidth, 130),
			position = UDim2.fromOffset((i - 1) * (cellWidth + gap), 0),
			radius = Theme.Radius.MD,
			stroke = Theme.rarityColor(entry.tier),
			strokeThickness = 3,
		})
		C.text({
			parent = cell,
			text = entry.icon,
			type = "Title",
			textSize = 50,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 70),
			position = UDim2.fromOffset(0, 8),
			outline = false,
		})
		C.text({
			parent = cell,
			text = entry.label,
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, -8, 0, 44),
			position = UDim2.fromOffset(4, 78),
		})
		return cell
	end
	for i, entry in entries do
		buildCell(i, entry)
	end
	local marker = C.frame({
		parent = window,
		color = Theme.Color.Accent.Gold,
		size = UDim2.new(0, 4, 1, 0),
		position = UDim2.fromScale(0.5, 0),
		anchor = Vector2.new(0.5, 0),
		radius = false,
	})
	local _ = marker
	local resultLabel = C.text({
		parent = holder,
		text = "",
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 36),
		position = UDim2.fromOffset(0, 362),
		color = Theme.Color.Accent.Gold,
	})
	local spinButton
	spinButton = C.Button({
		parent = holder,
		text = "Open a Mystery Flask",
		icon = "✨",
		variant = "primary",
		size = "lg",
		width = 380,
		position = UDim2.new(0.5, 0, 0, 410),
		anchor = Vector2.new(0.5, 0),
		onClick = function()
			if self.spinning then
				return
			end
			self.spinning = true
			spinButton.setDisabled(true)
			resultLabel.Text = ""
			local result = invoke("spin")
			if not result.ok then
				self.spinning = false
				spinButton.setDisabled(false)
				self.ui:Toast(result.reason or "No flasks", "error")
				return
			end
			-- Land on a cell showing the won prize, far enough along the reel.
			local landing = 38 + (result.index - 1) % #Spins.List
			while entries[landing] ~= Spins.List[result.index] do
				landing += 1
			end
			local windowWidth = window.AbsoluteSize.X
				/ math.max(self.ui.modals:FindFirstChildOfClass("UIScale").Scale, 0.01)
			local targetX = -((landing - 1) * (cellWidth + gap) + cellWidth / 2 - windowWidth / 2)
				+ math.random(-40, 40)
			reel.Position = UDim2.fromOffset(0, 10)
			local tween = TweenService:Create(
				reel,
				TweenInfo.new(4.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{ Position = UDim2.fromOffset(targetX, 10) }
			)
			tween:Play()
			task.spawn(function()
				local last = 0
				while tween.PlaybackState == Enum.PlaybackState.Playing do
					local index = math.floor(-reel.Position.X.Offset / (cellWidth + gap))
					if index ~= last then
						last = index
						self.C.SoundController:Play("hover", nil, { ui = true, pitch = 1.2 })
					end
					task.wait()
				end
			end)
			tween.Completed:Wait()
			local prize = result.prize
			resultLabel.Text = ("You got: %s %s%s"):format(
				prize.icon,
				prize.label,
				if prize.duplicate then " (duplicate → +500 🪙)" else ""
			)
			resultLabel.TextColor3 = Theme.rarityColor(Spins.List[result.index].tier)
			self.C.SoundController:Play("discover", nil, { ui = true })
			self.spinning = false
			spinButton.setDisabled((self.C.State.data.spins or 0) <= 0)
		end,
	})
	spinButton.setDisabled(data.spins <= 0)
	local productId = 0
	for _, entry in Config.ProductCatalog do
		if entry.spins and entry.productId ~= 0 then
			productId = entry.productId
		end
	end
	if productId ~= 0 then
		C.Button({
			parent = holder,
			text = "Get 5 more",
			icon = "💎",
			size = "md",
			width = 240,
			position = UDim2.new(0.5, 0, 0, 488),
			anchor = Vector2.new(0.5, 0),
			onClick = function()
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, productId)
			end,
		})
	end
end

function ShopPanel:_robux()
	local scroll = C.Scroll({ parent = self.content })
	C.grid(scroll, Vector2.new(268, 270), Theme.Space.MD)
	C.padding(scroll, 4)
	local State = self.C.State
	for index, pass in PASSES do
		local id = Config.GamePasses[pass.key] or 0
		local owned = State.passes[pass.key] == true
		local _, card =
			C.card({ parent = scroll, order = index, radius = Theme.Radius.LG, stroke = Theme.Color.Stroke.Gold })
		C.text({
			parent = card,
			text = pass.icon,
			type = "Display",
			textSize = 60,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 80),
			position = UDim2.fromOffset(0, 10),
			outline = false,
		})
		C.text({
			parent = card,
			text = pass.name,
			type = "Heading",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 30),
			position = UDim2.fromOffset(0, 92),
			color = Theme.Color.Accent.Gold,
		})
		C.text({
			parent = card,
			text = pass.body,
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, -24, 0, 60),
			position = UDim2.fromOffset(12, 126),
			color = Theme.Color.Text.Secondary,
		})
		local button = C.Button({
			parent = card,
			text = if owned then "Owned ✓" elseif id == 0 then "Coming soon" else ("R$ %d"):format(pass.robux),
			variant = if owned or id == 0 then "ghost" else "primary",
			size = "md",
			width = 220,
			position = UDim2.new(0.5, 0, 1, -14),
			anchor = Vector2.new(0.5, 1),
			onClick = function()
				if id ~= 0 and not owned then
					MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
				end
			end,
		})
		button.setDisabled(id == 0)
	end
	for index, product in Config.ProductCatalog do
		local _, card = C.card({
			parent = scroll,
			order = 10 + index,
			radius = Theme.Radius.LG,
			stroke = Theme.Color.Stroke.Strong,
		})
		C.text({
			parent = card,
			text = if product.spins then "🎁" else "🪙",
			type = "Display",
			textSize = 60,
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 80),
			position = UDim2.fromOffset(0, 10),
			outline = false,
		})
		C.text({
			parent = card,
			text = product.name,
			type = "Heading",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 30),
			position = UDim2.fromOffset(0, 92),
		})
		C.text({
			parent = card,
			text = if product.spins
				then (product.spins .. " Mystery Flasks")
				else (Format.commas(product.coins or 0) .. " coins"),
			type = "Caption",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 30),
			position = UDim2.fromOffset(0, 126),
			color = Theme.Color.Text.Secondary,
		})
		local button = C.Button({
			parent = card,
			text = if product.productId == 0 then "Coming soon" else ("R$ %d"):format(product.robux),
			variant = if product.productId == 0 then "ghost" else "primary",
			size = "md",
			width = 220,
			position = UDim2.new(0.5, 0, 1, -14),
			anchor = Vector2.new(0.5, 1),
			onClick = function()
				if product.productId ~= 0 then
					MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.productId)
				end
			end,
		})
		button.setDisabled(product.productId == 0)
	end
end

function ShopPanel:_codes()
	local holder = self.content
	C.text({
		parent = holder,
		text = "🏷️ Redeem a code",
		type = "Title",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 50),
		position = UDim2.fromOffset(0, 40),
		color = Theme.Color.Accent.Gold,
	})
	C.text({
		parent = holder,
		text = "New codes drop when the game hits like & visit milestones. Check the game description!",
		type = "Body",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 30),
		position = UDim2.fromOffset(0, 96),
		color = Theme.Color.Text.Secondary,
	})
	local box = C.new("TextBox", {
		PlaceholderText = "ENTER CODE",
		Text = "",
		ClearTextOnFocus = false,
		FontFace = Theme.Font.Title,
		TextSize = 34,
		TextColor3 = Theme.Color.Text.Primary,
		PlaceholderColor3 = Theme.Color.Text.Muted,
		BackgroundColor3 = Theme.Color.Surface.Sunken,
		Size = UDim2.fromOffset(520, 72),
		Position = UDim2.new(0.5, 0, 0, 160),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = holder,
	})
	C.corner(box, Theme.Radius.LG)
	C.stroke(box, Theme.Color.Stroke.Gold, Theme.Stroke.Emphasis)
	local status = C.text({
		parent = holder,
		text = "",
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 36),
		position = UDim2.fromOffset(0, 330),
	})
	local function redeem()
		local code = box.Text
		if #code < 2 then
			return
		end
		local result = invoke("redeemCode", code)
		if result.ok then
			status.Text = "✅ Code redeemed! Enjoy your rewards."
			status.TextColor3 = Theme.Color.State.Success
			box.Text = ""
			self.C.SoundController:Play("reward", nil, { ui = true })
		else
			status.Text = "❌ " .. (result.reason or "Invalid code")
			status.TextColor3 = Theme.Color.State.Danger
			self.C.SoundController:Play("error", nil, { ui = true })
		end
	end
	box.FocusLost:Connect(function(enter)
		if enter then
			redeem()
		end
	end)
	C.Button({
		parent = holder,
		text = "Redeem",
		icon = "🎉",
		variant = "primary",
		size = "lg",
		width = 260,
		position = UDim2.new(0.5, 0, 0, 252),
		anchor = Vector2.new(0.5, 0),
		onClick = redeem,
	})
end

function ShopPanel:Refresh()
	local data = self.C.State.data
	if not data then
		return
	end
	self.coins.Text = "🪙 " .. Format.commas(data.coins)
	self:_clear()
	if self.tab == "ingredients" then
		self:_ingredients(data)
	elseif self.tab == "golems" then
		self:_golems(data)
	elseif self.tab == "flasks" then
		self:_flasks(data)
	elseif self.tab == "robux" then
		self:_robux()
	else
		self:_codes()
	end
end

function ShopPanel:Open()
	self:Refresh()
	self.modal.open()
end

function ShopPanel:Close()
	self.modal.close()
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Design tokens. Mirrors docs/UI_DESIGN_SYSTEM.md 1:1 — UI code must read values from here.

local function hex(value: string): Color3
	return Color3.fromHex(value)
end

local Theme = {}

Theme.Color = {
	Surface = {
		Base = hex("#120D24"),
		Panel = hex("#1E1638"),
		Raised = hex("#2A2050"),
		Sunken = hex("#150F2B"),
	},
	PanelTransparency = 0.08,
	Stroke = {
		Subtle = hex("#3E3170"),
		Strong = hex("#6A55B8"),
		Gold = hex("#E8B653"),
	},
	Text = {
		Primary = hex("#FFF7E8"),
		Secondary = hex("#C9BEEA"),
		Muted = hex("#8F84B8"),
		Inverse = hex("#1A1230"),
		Outline = hex("#120A22"),
	},
	Accent = {
		Gold = hex("#FFD45E"),
		GoldDeep = hex("#E89A2C"),
		Magenta = hex("#FF4FA3"),
		Cyan = hex("#4FE3FF"),
		Lime = hex("#8CFF6B"),
	},
	State = {
		Success = hex("#6BFF8E"),
		Warning = hex("#FFB13B"),
		Danger = hex("#FF5A6A"),
		Info = hex("#6BB8FF"),
		Disabled = hex("#4A4268"),
	},
	Rarity = {
		Common = hex("#CDD4DE"),
		Uncommon = hex("#6BFF8E"),
		Rare = hex("#4FA8FF"),
		Epic = hex("#B36BFF"),
		Legendary = hex("#FFB13B"),
		Mythic = hex("#FF4F7A"),
	},
	Combo = {
		hex("#8F84B8"),
		hex("#4FE3FF"),
		hex("#8CFF6B"),
		hex("#FFC94A"),
		hex("#FF4FA3"),
	},
	Toast = {
		info = hex("#4FE3FF"),
		success = hex("#6BFF8E"),
		error = hex("#FF5A6A"),
		reward = hex("#FFD45E"),
		social = hex("#FF4FA3"),
	},
}

Theme.Font = {
	Title = Font.new("rbxasset://fonts/families/LuckiestGuy.json"),
	UI = Font.new("rbxasset://fonts/families/FredokaOne.json"),
}

Theme.Type = {
	Display = { font = Theme.Font.Title, size = 64 },
	Title = { font = Theme.Font.Title, size = 36 },
	Heading = { font = Theme.Font.UI, size = 26 },
	Body = { font = Theme.Font.UI, size = 20 },
	Label = { font = Theme.Font.UI, size = 16 },
	Caption = { font = Theme.Font.UI, size = 14 },
}

Theme.Space = { XS = 4, SM = 8, MD = 12, LG = 16, XL = 24, XXL = 32 }

Theme.Radius = {
	SM = UDim.new(0, 8),
	MD = UDim.new(0, 12),
	LG = UDim.new(0, 18),
	Pill = UDim.new(0.5, 0),
}

Theme.Stroke = { Hairline = 1, Default = 2, Emphasis = 3 }

Theme.Elevation = {
	E1 = { offset = 3, transparency = 0.6 },
	E2 = { offset = 6, transparency = 0.5 },
}

local function tween(duration: number, style: Enum.EasingStyle, direction: Enum.EasingDirection?): TweenInfo
	return TweenInfo.new(duration, style, direction or Enum.EasingDirection.Out)
end

Theme.Motion = {
	Hover = tween(0.12, Enum.EasingStyle.Quad),
	Press = tween(0.06, Enum.EasingStyle.Quad),
	Release = tween(0.22, Enum.EasingStyle.Back),
	PanelIn = tween(0.24, Enum.EasingStyle.Back),
	PanelOut = tween(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	ToastIn = tween(0.3, Enum.EasingStyle.Quint),
	ToastOut = tween(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	ToastHold = 3.2,
	Reveal = tween(0.45, Enum.EasingStyle.Back),
	Count = tween(0.5, Enum.EasingStyle.Quart),
	Pulse = tween(0.18, Enum.EasingStyle.Back),
	Fade = tween(0.2, Enum.EasingStyle.Quad),
}

Theme.Size = {
	Button = { sm = 36, md = 48, lg = 64 },
	IconButton = 72,
	IconButtonTouch = 80,
	Slot = 84,
	SlotTouch = 72,
	SlotGap = 8,
	Modal = Vector2.new(1100, 680),
	Toast = Vector2.new(360, 64),
}

Theme.DesignResolution = Vector2.new(1920, 1080)

function Theme.rarityColor(rarity: string?): Color3
	return (rarity and Theme.Color.Rarity[rarity]) or Theme.Color.Rarity.Common
end

function Theme.comboColor(level: number): Color3
	return Theme.Color.Combo[math.clamp(level, 1, #Theme.Color.Combo)]
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">TrialHud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Trial HUD: objective banner with live timer and star thresholds, plus the results screen.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Challenges = require(Shared.Data.Challenges)
local Ingredients = require(Shared.Data.Ingredients)
local Format = require(Shared.Util.Format)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local TrialHud = {}

function TrialHud:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local State = controllers.State
	local outer, body = C.card({
		parent = ui.hud,
		size = UDim2.fromOffset(560, 104),
		position = UDim2.new(0.5, 0, 0, 14),
		anchor = Vector2.new(0.5, 0),
		radius = Theme.Radius.LG,
		stroke = Theme.Color.Stroke.Gold,
	})
	outer.Visible = false
	self.outer = outer
	self.title = C.text({
		parent = body,
		text = "",
		type = "Heading",
		size = UDim2.new(1, -200, 0, 32),
		position = UDim2.fromOffset(18, 8),
		color = Theme.Color.Accent.Gold,
		truncate = true,
	})
	self.objective = C.text({
		parent = body,
		text = "",
		type = "Label",
		size = UDim2.new(1, -200, 0, 24),
		position = UDim2.fromOffset(18, 40),
		truncate = true,
	})
	self.progress = C.Progress({
		parent = body,
		size = UDim2.new(1, -200, 0, 12),
		position = UDim2.fromOffset(18, 74),
		color = Theme.Color.Accent.Lime,
		color2 = Theme.Color.State.Success,
	})
	self.timer = C.text({
		parent = body,
		text = "0.0s",
		type = "Title",
		alignX = Enum.TextXAlignment.Right,
		size = UDim2.fromOffset(160, 44),
		position = UDim2.new(1, -18, 0, 6),
		anchor = Vector2.new(1, 0),
	})
	self.starsLabel = C.text({
		parent = body,
		text = "",
		type = "Caption",
		alignX = Enum.TextXAlignment.Right,
		size = UDim2.fromOffset(170, 20),
		position = UDim2.new(1, -18, 0, 52),
		anchor = Vector2.new(1, 0),
		color = Theme.Color.Text.Secondary,
	})
	C.Button({
		parent = body,
		text = "Quit",
		width = 80,
		size = "sm",
		variant = "ghost",
		position = UDim2.new(1, -18, 1, -8),
		anchor = Vector2.new(1, 1),
		onClick = function()
			Net.func("TrialRequest"):InvokeServer("quit")
		end,
	})
	C.Button({
		parent = body,
		text = "Retry",
		width = 80,
		size = "sm",
		variant = "secondary",
		position = UDim2.new(1, -104, 1, -8),
		anchor = Vector2.new(1, 1),
		onClick = function()
			Net.event("Command"):FireServer("reset")
		end,
	})

	self.elapsed = 0
	State.TrialChanged:Connect(function(phase, payload)
		if phase == "start" then
			self:_start(payload)
		elseif phase == "progress" then
			self.progress.set(payload.progress / math.max(payload.target, 1))
			self.objective.Text = ("%s:  %s / %s"):format(
				self.def.objective.text,
				Format.commas(payload.progress),
				Format.commas(payload.target)
			)
			C.pulse(self.objective, 1.1)
			controllers.SoundController:Play("coin", nil, { ui = true })
		elseif phase == "end" then
			outer.Visible = false
			if not payload.aborted then
				self:_result(payload)
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		if outer.Visible and self.def then
			self.elapsed += dt * State:TimeScale()
			local t = self.elapsed
			self.timer.Text = Format.seconds(t)
			local stars = Challenges.starsFor(self.def, t)
			self.timer.TextColor3 = if stars >= 3
				then Theme.Color.Accent.Gold
				elseif stars == 2 then Theme.Color.Text.Primary
				else Theme.Color.State.Warning
		end
	end)
end

function TrialHud:_start(payload)
	self.def = Challenges.TrialsById[payload.id]
	self.elapsed = 0
	self.outer.Visible = true
	self.title.Text = payload.icon .. "  " .. payload.name
	self.objective.Text = ("%s:  0 / %s"):format(payload.text, Format.commas(payload.target))
	self.progress.set(0, nil, true)
	local stars = payload.stars
	self.starsLabel.Text = ("★★★ ≤%ds  ★★ ≤%ds"):format(stars[3], stars[2])
	self.ui:Close()
	self.ui:Toast(payload.icon .. " Trial started: " .. payload.text, "info")
end

function TrialHud:_result(payload)
	local modal = C.Modal({
		parent = self.ui.modals,
		title = if payload.success then "🏆 Trial Complete!" else "⏰ Time's up!",
		size = Vector2.new(720, 460),
	})
	local body = modal.body
	if payload.success then
		local row = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 120), Parent = body })
		C.list(
			row,
			Enum.FillDirection.Horizontal,
			Theme.Space.LG,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		)
		for i = 1, 3 do
			local earned = i <= payload.stars
			local star = C.text({
				parent = row,
				text = "★",
				type = "Display",
				textSize = 100,
				alignX = Enum.TextXAlignment.Center,
				size = UDim2.fromOffset(110, 110),
				order = i,
				color = if earned then Theme.Color.Accent.Gold else Theme.Color.State.Disabled,
			})
			local scale = C.new("UIScale", { Scale = 0, Parent = star })
			task.delay(0.25 + i * 0.22, function()
				C.tween(scale, Theme.Motion.Reveal, { Scale = 1 })
				if earned then
					self.C.SoundController:Play("coin", nil, { ui = true, pitch = 0.8 + i * 0.2 })
				end
			end)
		end
		C.text({
			parent = body,
			text = ("Time: %s%s"):format(
				Format.seconds(payload.time),
				if payload.newBest then "   🎉 New best!" else ""
			),
			type = "Heading",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 34),
			position = UDim2.fromOffset(0, 130),
		})
		local rewards = {}
		if payload.rewards.coins > 0 then
			table.insert(rewards, "+" .. Format.commas(payload.rewards.coins) .. " 🪙")
		end
		if payload.rewards.xp > 0 then
			table.insert(rewards, "+" .. Format.commas(payload.rewards.xp) .. " XP")
		end
		for id, amount in payload.rewards.ingredients do
			local ingredient = Ingredients.ById[id]
			if ingredient then
				table.insert(rewards, ingredient.icon .. " " .. ingredient.name .. " x" .. amount)
			end
		end
		C.text({
			parent = body,
			text = if #rewards > 0 then table.concat(rewards, "    ") else "Beat your stars for more rewards!",
			type = "Body",
			alignX = Enum.TextXAlignment.Center,
			wrap = true,
			size = UDim2.new(1, 0, 0, 60),
			position = UDim2.fromOffset(0, 172),
			color = Theme.Color.Accent.Gold,
		})
		if payload.final then
			C.text({
				parent = body,
				text = "💎 You forged the Philosopher's Stone! Brew the Philosopher's Elixir: Dragon Scale + Stone + Star Shard.",
				type = "Label",
				alignX = Enum.TextXAlignment.Center,
				wrap = true,
				size = UDim2.new(1, 0, 0, 50),
				position = UDim2.fromOffset(0, 232),
				color = Theme.Color.Rarity.Mythic,
			})
		end
		self.C.SoundController:Play("levelup", nil, { ui = true })
	else
		C.text({
			parent = body,
			text = "So close! Try a different potion combo.",
			type = "Heading",
			alignX = Enum.TextXAlignment.Center,
			size = UDim2.new(1, 0, 0, 40),
			position = UDim2.fromOffset(0, 60),
		})
	end
	local buttons = C.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.new(0, 0, 1, -64), Parent = body }
	)
	C.list(buttons, Enum.FillDirection.Horizontal, Theme.Space.MD, Enum.HorizontalAlignment.Center)
	C.Button({
		parent = buttons,
		text = "Retry",
		icon = "🔁",
		width = 180,
		size = "lg",
		order = 1,
		onClick = function()
			modal.close()
			Net.func("TrialRequest"):InvokeServer("start", payload.id)
		end,
	})
	local trial = Challenges.TrialsById[payload.id]
	local nextTrial
	for _, other in Challenges.Trials do
		if trial and other.order == trial.order + 1 then
			nextTrial = other
		end
	end
	if payload.success and nextTrial then
		C.Button({
			parent = buttons,
			text = "Next",
			icon = "➡️",
			width = 180,
			size = "lg",
			variant = "primary",
			order = 2,
			onClick = function()
				modal.close()
				local result = Net.func("TrialRequest"):InvokeServer("start", nextTrial.id)
				if result and not result.ok then
					self.ui:Toast(result.reason or "Locked", "error")
				end
			end,
		})
	end
	C.Button({
		parent = buttons,
		text = "Back to Lab",
		width = 200,
		size = "lg",
		variant = "ghost",
		order = 3,
		onClick = function()
			modal.close()
			Net.func("TrialRequest"):InvokeServer("quit")
		end,
	})
	modal.onClose = function()
		task.delay(0.3, function()
			modal.root:Destroy()
		end)
	end
	modal.open()
end

return TrialHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!nonstrict
-- First-session coach: grab → fling → open cauldron → brew Inferno Brew → throw it → heal.
-- Progress is saved in settings.tutorial so it never repeats once finished.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Tutorial = {}

local DONE = 99

local STEPS = {
	{
		id = "grab",
		text = "👋 Meet Clayton, your test golem! Click and DRAG him to grab him.",
		touch = "👋 Meet Clayton, your test golem! Touch and drag him to grab him.",
	},
	{ id = "fling", text = "Now FLING him! Drag fast and let go. 🤾" },
	{
		id = "openBrew",
		text = "Click the bubbling cauldron, or press B, to start brewing. 🧪",
		touch = "Tap the 🧪 Brew button to open the cauldron.",
	},
	{ id = "brewInferno", text = "Add 🔥 Ember Root twice, then press BREW!" },
	{
		id = "use",
		text = "Inferno Brew is ready! RIGHT-CLICK near Clayton to throw it. 🔥",
		touch = "Inferno Brew is ready! Tap near Clayton to throw it. 🔥",
	},
	{ id = "heal", text = "Ouch! Press H, or the 💖 button, to heal everyone." },
	{ id = "done", text = "You're a natural! Find all 31 potions in the Codex (C) and beat the Trials (J). 🏆" },
}

function Tutorial:Mount(ui, controllers)
	self.ui, self.C = ui, controllers
	local outer, card = C.card({
		parent = ui.hud,
		size = UDim2.fromOffset(470, 132),
		position = UDim2.new(0, 22, 1, -150),
		anchor = Vector2.new(0, 1),
		radius = Theme.Radius.LG,
		stroke = Theme.Color.Stroke.Gold,
		elevation = "E2",
	})
	outer.Visible = false
	self.outer = outer
	C.text({
		parent = card,
		text = "🧙",
		type = "Display",
		textSize = 54,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.fromOffset(80, 132),
		outline = false,
	})
	self.label = C.text({
		parent = card,
		text = "",
		type = "Body",
		textSize = 19,
		wrap = true,
		size = UDim2.new(1, -100, 0, 80),
		position = UDim2.fromOffset(84, 10),
	})
	self.dots = C.text({
		parent = card,
		text = "",
		type = "Caption",
		size = UDim2.fromOffset(200, 24),
		position = UDim2.new(0, 84, 1, -32),
		color = Theme.Color.Accent.Gold,
	})
	self.skip = C.Button({
		parent = card,
		text = "Skip",
		variant = "ghost",
		size = "sm",
		width = 90,
		position = UDim2.new(1, -12, 1, -10),
		anchor = Vector2.new(1, 1),
		onClick = function()
			self:Finish()
		end,
	})
	self.step = nil

	local function advance(id: string)
		if self.step and STEPS[self.step] and STEPS[self.step].id == id then
			self:Begin(self.step + 1)
		end
	end
	controllers.GrabController.Grabbed:Connect(function()
		advance("grab")
	end)
	controllers.GrabController.Released:Connect(function(speed)
		if speed > 45 then
			advance("fling")
		end
	end)
	ui.PanelOpened:Connect(function(name)
		if name == "brew" then
			advance("openBrew")
		end
	end)
	controllers.State.Changed:Connect(function(key)
		local data = controllers.State.data
		if (key == "discovered" or key == "brewCount") and data and data.discovered.inferno_brew then
			advance("brewInferno")
		end
	end)
	controllers.ToolController.Used:Connect(function()
		advance("use")
	end)
	controllers.InputController.Action:Connect(function(action)
		if action == "heal" then
			advance("heal")
		end
	end)

	local function maybeStart()
		local data = controllers.State.data
		if data and self.step == nil then
			local saved = data.settings.tutorial or 0
			if saved < #STEPS then
				task.delay(2, function()
					self:Begin(math.max(1, saved))
				end)
			end
		end
	end
	controllers.State.Ready:Connect(maybeStart)
	if controllers.State.ready then
		maybeStart()
	end
end

function Tutorial:Begin(step: number)
	if step > #STEPS then
		self:Finish()
		return
	end
	self.step = step
	local spec = STEPS[step]
	self.label.Text = if self.ui.touch and spec.touch then spec.touch else spec.text
	local dots = {}
	for i = 1, #STEPS do
		table.insert(dots, if i <= step then "●" else "○")
	end
	self.dots.Text = table.concat(dots, " ")
	self.outer.Visible = true
	C.pulse(self.outer, 1.06)
	Net.event("Settings"):FireServer("tutorial", step)
	if spec.id == "brewInferno" then
		-- Pre-fill the cauldron hint by selecting nothing; the brew panel shows the recipe book.
		self.C.State:Select(nil)
	end
	if spec.id == "done" then
		self.C.SoundController:Play("reward", nil, { ui = true })
		self.skip.setText("Got it!")
		task.delay(9, function()
			if self.step == step then
				self:Finish()
			end
		end)
	else
		self.skip.setText("Skip")
		if step > 1 then
			self.C.SoundController:Play("coin", nil, { ui = true })
		end
	end
end

function Tutorial:Finish()
	self.step = DONE
	self.outer.Visible = false
	Net.event("Settings"):FireServer("tutorial", DONE)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- UI root: builds the ScreenGuis, scales the 1920x1080 design to any screen, routes panels and
-- keybind actions, photo mode, screen flashes and the loading screen.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Ingredients = require(Shared.Data.Ingredients)

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Signal = require(Shared.Util.Signal)

local UIController = {
	panels = {},
	openPanel = nil,
	PanelOpened = Signal.new(), -- (name)
}

local COMMANDS = {
	slowmo = true,
	pause = true,
	heal = true,
	reset = true,
	undo = true,
	spawnLast = true,
	clearZombies = true,
}

local function makeGui(name: string, order: number, ignoreInset: boolean): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = ignoreInset
	gui.ScreenInsets = if ignoreInset then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = order
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- A container that fills the screen while its children are laid out in design pixels.
local function scaledRoot(gui: ScreenGui, touch: boolean): (Frame, UIScale)
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function update()
		local size = gui.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		local s = math.min(size.X / Theme.DesignResolution.X, size.Y / Theme.DesignResolution.Y)
		if touch then
			s *= 1.3
		end
		s = math.clamp(s, 0.45, 1.4)
		scale.Scale = s
		root.Size = UDim2.fromOffset(size.X / s, size.Y / s)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
	return root, scale
end

function UIController:Init(controllers)
	self.C = controllers
end

function UIController:Start()
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Health, false)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.EmotesMenu, false)

	local touch = self.C.InputController:IsTouch()
	self.touch = touch
	self.hudGui = makeGui("FlaskHUD", 5, false)
	self.modalGui = makeGui("FlaskModals", 20, true)
	self.overlayGui = makeGui("FlaskOverlay", 100, true)
	self.hud = scaledRoot(self.hudGui, touch)
	self.modals = scaledRoot(self.modalGui, touch)
	self.overlay = self.overlayGui
	self.overlayScaled = scaledRoot(self.overlayGui, touch)
	Components.setSoundHandler(function(name)
		self.C.SoundController:Play(name, nil, { ui = true })
	end)
	Components.mountTooltip(self.overlayScaled)

	-- Screen flash overlay.
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 1
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 300
	flash.Interactable = false
	flash.Parent = self.overlayGui
	self.flash = flash

	-- Slow-mo vignette.
	local vignette = Instance.new("Frame")
	vignette.Name = "Vignette"
	vignette.BackgroundColor3 = Color3.fromRGB(40, 90, 160)
	vignette.BackgroundTransparency = 1
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.Interactable = false
	vignette.ZIndex = 1
	vignette.Parent = self.overlayGui
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.18, 1),
		NumberSequenceKeypoint.new(0.82, 1),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	gradient.Parent = vignette
	self.vignette = vignette

	self:_loading()

	local Panels = script.Parent
	local function mount(name: string, moduleName: string)
		local module = require(Panels:WaitForChild(moduleName))
		module:Mount(self, self.C)
		self.panels[name] = module
	end
	self.Notifications = require(Panels.Notifications)
	self.Notifications:Mount(self, self.C)
	self.Hud = require(Panels.Hud)
	self.Hud:Mount(self, self.C)
	self.Hotbar = require(Panels.Hotbar)
	self.Hotbar:Mount(self, self.C)
	self.TrialHud = require(Panels.TrialHud)
	self.TrialHud:Mount(self, self.C)
	mount("brew", "BrewPanel")
	mount("codex", "CodexPanel")
	mount("challenges", "ChallengesPanel")
	mount("shop", "ShopPanel")
	mount("menu", "MenuPanel")
	mount("help", "HelpPanel")
	self.Tutorial = require(Panels.Tutorial)
	self.Tutorial:Mount(self, self.C)

	self.C.InputController.Action:Connect(function(action)
		self:_action(action)
	end)
	self.C.GrabController.InteractivePressed:Connect(function(kind)
		if kind == "Cauldron" then
			self:Open("brew")
		elseif kind == "Rack" then
			self:ClaimRack()
		end
	end)
	self.C.State.LabChanged:Connect(function(lab)
		TweenService:Create(
			vignette,
			TweenInfo.new(0.3),
			{ BackgroundTransparency = if lab.slowmo then 0.55 elseif lab.paused then 0.7 else 1 }
		):Play()
		vignette.BackgroundColor3 = if lab.paused then Color3.fromRGB(80, 80, 110) else Color3.fromRGB(40, 90, 160)
	end)
	GuiService.MenuOpened:Connect(function()
		self.C.GrabController:ForceDrop()
	end)
end

function UIController:_loading()
	local screen = Instance.new("Frame")
	screen.Name = "Loading"
	screen.BackgroundColor3 = Theme.Color.Surface.Base
	screen.Size = UDim2.fromScale(1, 1)
	screen.ZIndex = 400
	screen.Parent = self.overlayGui
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.fromRGB(40, 24, 70), Theme.Color.Surface.Base)
	gradient.Rotation = 90
	gradient.Parent = screen
	local title = Components.text({
		parent = screen,
		text = "FLASK FIASCO",
		type = "Display",
		textSize = 96,
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 110),
		position = UDim2.fromScale(0.5, 0.42),
		anchor = Vector2.new(0.5, 0.5),
		color = Theme.Color.Accent.Gold,
		z = 401,
	})
	local subtitle = Components.text({
		parent = screen,
		text = "🧪  Warming up the cauldron...",
		type = "Heading",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 40),
		position = UDim2.fromScale(0.5, 0.53),
		anchor = Vector2.new(0.5, 0.5),
		color = Theme.Color.Text.Secondary,
		z = 401,
	})
	local tips = {
		"Tip: Frozen golems shatter when they hit something hard!",
		"Tip: Mix two ingredients you've never combined to discover new potions.",
		"Tip: Press G for slow motion, Space to stop time.",
		"Tip: Brew a potion 5 times to master it: infinite bottles!",
		"Tip: Fire + Ice makes a steam explosion.",
	}
	local tip = Components.text({
		parent = screen,
		text = tips[math.random(1, #tips)],
		type = "Body",
		alignX = Enum.TextXAlignment.Center,
		size = UDim2.new(1, 0, 0, 30),
		position = UDim2.new(0.5, 0, 1, -80),
		anchor = Vector2.new(0.5, 0.5),
		color = Theme.Color.Text.Muted,
		z = 401,
	})
	local _ = tip
	local bob = 0
	local conn = game:GetService("RunService").RenderStepped:Connect(function(dt)
		bob += dt
		title.Position = UDim2.new(0.5, 0, 0.42, math.sin(bob * 2) * 6)
	end)
	local function finish()
		conn:Disconnect()
		subtitle.Text = "✨ Ready!"
		task.wait(0.4)
		local tween = TweenService:Create(screen, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
		for _, child in screen:GetDescendants() do
			if child:IsA("TextLabel") then
				TweenService:Create(child, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			elseif child:IsA("UIStroke") then
				TweenService:Create(child, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
		end
		tween:Play()
		tween.Completed:Wait()
		screen:Destroy()
	end
	task.spawn(function()
		local State = self.C.State
		local started = os.clock()
		while not (State.ready and State.lab) and os.clock() - started < 30 do
			task.wait(0.1)
		end
		finish()
	end)
end

function UIController:_action(action: string)
	local State = self.C.State
	if action == "back" then
		if self.openPanel then
			self:Close()
		elseif State.photoMode then
			self:SetPhotoMode(false)
		elseif State.selected then
			State:Select(nil)
		end
		return
	end
	if COMMANDS[action] then
		Net.event("Command"):FireServer(action)
		if action == "heal" then
			self.C.SoundController:Play("heal")
		end
		return
	end
	if action == "photo" then
		self:SetPhotoMode(not State.photoMode)
	elseif action == "follow" then
		local model = self.C.GrabController.hoverModel
		local torso = model and model:FindFirstChild("Torso")
		self.C.CameraController:Follow(torso)
		if not torso then
			self.C.CameraController:Reset()
		end
	elseif self.panels[action] then
		self:Toggle(action)
	end
end

function UIController:Open(name: string)
	local panel = self.panels[name]
	if not panel then
		return
	end
	if self.openPanel and self.openPanel ~= name then
		self.panels[self.openPanel]:Close()
	end
	self.openPanel = name
	self.C.GrabController:ForceDrop()
	panel:Open()
	self.C.InputController.enabled = false
	self.PanelOpened:Fire(name)
end

function UIController:Close()
	if self.openPanel then
		local panel = self.panels[self.openPanel]
		self.openPanel = nil
		panel:Close()
	end
	self.C.InputController.enabled = true
	Components.hideTooltip()
end

-- Panels call this when their modal closes itself (close button).
function UIController:PanelClosed(name: string)
	if self.openPanel == name then
		self.openPanel = nil
		self.C.InputController.enabled = true
	end
end

function UIController:Toggle(name: string)
	if self.openPanel == name then
		self:Close()
	else
		self:Open(name)
	end
end

function UIController:SetPhotoMode(on: boolean)
	local State = self.C.State
	State.photoMode = on
	State.PhotoModeChanged:Fire(on)
	self.hudGui.Enabled = not on
	if on then
		self:Close()
		self:Toast("📷 Photo mode: press P or Esc to exit", "info")
	end
end

function UIController:ScreenFlash(color: Color3, alpha: number, duration: number)
	self.flash.BackgroundColor3 = color
	self.flash.BackgroundTransparency = 1 - alpha
	TweenService:Create(self.flash, TweenInfo.new(duration, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
		:Play()
end

function UIController:Toast(text: string, kind: string?)
	self.Notifications:Toast(text, kind or "info")
end

function UIController:ClaimRack()
	local result = Net.func("Shop"):InvokeServer("claimRack")
	if result and result.ok then
		local parts = {}
		for id, amount in result.items do
			local ingredient = Ingredients.ById[id]
			if ingredient then
				table.insert(parts, ingredient.icon .. " x" .. amount)
			end
		end
		self:Toast("🌿 Picked fresh herbs: " .. table.concat(parts, "  "), "reward")
		self.C.SoundController:Play("reward")
	elseif result then
		self:Toast(result.reason or "Nothing to pick yet.", "info")
	end
end

-- Viewport-space position → design-space position inside a scaled root.
function UIController:ToDesign(root: Frame, viewport: Vector2): Vector2
	local scale = root:FindFirstChildOfClass("UIScale")
	local s = if scale then scale.Scale else 1
	local inset = if root:FindFirstAncestorOfClass("ScreenGui")
			and (root:FindFirstAncestorOfClass("ScreenGui") :: ScreenGui).IgnoreGuiInset
		then Vector2.zero
		else GuiService:GetGuiInset()
	return (viewport - inset) / s
end

local _ = UserInputService
local __ = Workspace
return UIController
