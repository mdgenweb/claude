          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number / time formatting helpers shared by server messages and client UI.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T" }

-- 1234 -> "1,234"
function Format.commas(n: number): string
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n)))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return if negative then "-" .. formatted else formatted
end

-- 15300 -> "15.3K"
function Format.short(n: number): string
	local abs = math.abs(n)
	if abs < 10000 then
		return Format.commas(n)
	end
	local tier = math.min(math.floor(math.log10(abs) / 3), #SUFFIXES - 1)
	local scaled = n / (1000 ^ tier)
	local text = string.format(if math.abs(scaled) >= 100 then "%.0f" else "%.1f", scaled)
	text = text:gsub("%.0$", "")
	return text .. SUFFIXES[tier + 1]
end

-- 3725 -> "1h 2m", 95 -> "1m 35s", 7 -> "7s"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- 12.345 -> "12.3s"
function Format.seconds(seconds: number): string
	return string.format("%.1fs", seconds)
end

function Format.percent(fraction: number): string
	return string.format("%d%%", math.floor(fraction * 100 + 0.5))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Lightweight pure-Luau signal. Handlers run in their own thread (task.spawn) so a yielding
-- or erroring handler never blocks or breaks the emitter.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Wait: (self: Signal<T...>) -> T...,
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}
Signal.__index = Signal

local ConnectionClass = {}
ConnectionClass.__index = ConnectionClass

function ConnectionClass:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

function Signal.new<T...>(): Signal<T...>
	local self = setmetatable({ _handlers = {} }, Signal)
	return (self :: any) :: Signal<T...>
end

function Signal:Connect(fn)
	local connection = setmetatable({ Connected = true, _signal = self, _fn = fn }, ConnectionClass)
	table.insert(self._handlers, connection)
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- Snapshot so handlers can disconnect while iterating.
	local snapshot = table.clone(self._handlers)
	for _, connection in snapshot do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in table.clone(self._handlers) do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Critically-damped-capable spring for smooth UI/camera motion. Works with numbers,
-- Vector2 and Vector3 (anything supporting + - * by number).

local Spring = {}
Spring.__index = Spring

export type Spring<T> = {
	Position: T,
	Velocity: T,
	Target: T,
	Speed: number,
	Damping: number,
	Step: (self: Spring<T>, dt: number) -> T,
	Snap: (self: Spring<T>, value: T) -> (),
	Impulse: (self: Spring<T>, velocity: T) -> (),
}

function Spring.new<T>(initial: T, speed: number?, damping: number?): Spring<T>
	local zero = (initial :: any) * 0
	local self = setmetatable({
		Position = initial,
		Velocity = zero,
		Target = initial,
		Speed = speed or 12,
		Damping = damping or 1,
	}, Spring)
	return (self :: any) :: Spring<T>
end

-- Semi-implicit Euler with sub-stepping keeps it stable for large dt (frame hitches).
function Spring:Step(dt: number)
	local steps = math.clamp(math.ceil(dt / (1 / 120)), 1, 8)
	local h = dt / steps
	local w = self.Speed
	local zeta = self.Damping
	for _ = 1, steps do
		local displacement = self.Position - self.Target
		local acceleration = displacement * (-w * w) - self.Velocity * (2 * zeta * w)
		self.Velocity += acceleration * h
		self.Position += self.Velocity * h
	end
	return self.Position
end

function Spring:Snap(value)
	self.Position = value
	self.Target = value
	self.Velocity = (value :: any) * 0
end

function Spring:Impulse(velocity)
	self.Velocity += velocity
end

return Spring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Trove</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Trove: tracks things that need cleaning up (instances, connections, threads, functions)
-- and destroys them all at once.

export type Trove = {
	Add: <T>(self: Trove, item: T) -> T,
	Connect: (self: Trove, signal: RBXScriptSignal, fn: (...any) -> ()) -> RBXScriptConnection,
	Clean: (self: Trove) -> (),
	Destroy: (self: Trove) -> (),
	Extend: (self: Trove) -> Trove,
}

local Trove = {}
Trove.__index = Trove

local function cleanItem(item: any)
	local kind = typeof(item)
	if kind == "Instance" then
		item:Destroy()
	elseif kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		if coroutine.status(item) ~= "dead" then
			pcall(task.cancel, item)
		end
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		elseif type(item.Clean) == "function" then
			item:Clean()
		end
	end
end

function Trove.new(): Trove
	local self = setmetatable({ _items = {} }, Trove)
	return (self :: any) :: Trove
end

function Trove:Add(item)
	table.insert(self._items, item)
	return item
end

function Trove:Connect(signal: RBXScriptSignal, fn)
	local connection = signal:Connect(fn)
	table.insert(self._items, connection)
	return connection
end

function Trove:Extend()
	local child = Trove.new()
	table.insert(self._items, child)
	return child
end

function Trove:Clean()
	local items = self._items
	self._items = {}
	-- Clean in reverse order of addition (LIFO), like a stack unwind.
	for i = #items, 1, -1 do
		local ok, err = pcall(cleanItem, items[i])
		if not ok then
			warn("[Trove] cleanup error:", err)
		end
	end
end

Trove.Destroy = Trove.Clean

return Trove
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="22">
