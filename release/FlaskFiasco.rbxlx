        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">GolemFactory</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds a golem (the test dummy) as a 2D active ragdoll.
--
-- Physics: 10 invisible/visible collider parts on the lab plane (z = 0), joined by Z-axis
-- HingeConstraints with limits. Visuals: massless welded decorations layered in depth
-- (arms in front of the torso, legs behind) so limbs overlap correctly in 2D.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Skins = require(Shared.Data.Skins)
local Physics2D = require(script.Parent.Physics2D)

local GolemFactory = {}

local UPRIGHT_CYL = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis X -> Y
local FACING_CYL = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis X -> Z (disc facing camera)

local ARM_Z = 1.65 -- visual depth layers
local LEG_Z = -0.45

-- Collider layout relative to the feet centre.
local PARTS = {
	{
		name = "Torso",
		shape = Enum.PartType.Ball,
		size = Vector3.one * 3.0,
		at = Vector3.new(0, 4.6, 0),
		visible = true,
	},
	{
		name = "Head",
		shape = Enum.PartType.Ball,
		size = Vector3.one * 2.4,
		at = Vector3.new(0, 7.05, 0),
		visible = true,
	},
	{ name = "UpperArmL", size = Vector3.new(0.8, 1.6, 0.8), at = Vector3.new(-1.6, 4.7, 0), limb = "arm" },
	{ name = "LowerArmL", size = Vector3.new(0.75, 1.5, 0.75), at = Vector3.new(-1.6, 3.15, 0), limb = "forearm" },
	{ name = "UpperArmR", size = Vector3.new(0.8, 1.6, 0.8), at = Vector3.new(1.6, 4.7, 0), limb = "arm" },
	{ name = "LowerArmR", size = Vector3.new(0.75, 1.5, 0.75), at = Vector3.new(1.6, 3.15, 0), limb = "forearm" },
	{ name = "UpperLegL", size = Vector3.new(0.9, 1.7, 0.9), at = Vector3.new(-0.75, 2.65, 0), limb = "thigh" },
	{ name = "LowerLegL", size = Vector3.new(0.85, 1.8, 0.85), at = Vector3.new(-0.75, 0.9, 0), limb = "shin" },
	{ name = "UpperLegR", size = Vector3.new(0.9, 1.7, 0.9), at = Vector3.new(0.75, 2.65, 0), limb = "thigh" },
	{ name = "LowerLegR", size = Vector3.new(0.85, 1.8, 0.85), at = Vector3.new(0.75, 0.9, 0), limb = "shin" },
}

-- Hinge joints. Angles in degrees, positive = counter-clockwise as seen from the camera.
local JOINTS = {
	{ name = "Neck", a = "Torso", b = "Head", pivot = Vector3.new(0, 6.0, 0), lower = -40, upper = 40, kind = "neck" },
	{
		name = "ShoulderL",
		a = "Torso",
		b = "UpperArmL",
		pivot = Vector3.new(-1.6, 5.5, 0),
		lower = -175,
		upper = 175,
		kind = "shoulder",
	},
	{
		name = "ElbowL",
		a = "UpperArmL",
		b = "LowerArmL",
		pivot = Vector3.new(-1.6, 3.9, 0),
		lower = -15,
		upper = 150,
		kind = "elbow",
	},
	{
		name = "ShoulderR",
		a = "Torso",
		b = "UpperArmR",
		pivot = Vector3.new(1.6, 5.5, 0),
		lower = -175,
		upper = 175,
		kind = "shoulder",
	},
	{
		name = "ElbowR",
		a = "UpperArmR",
		b = "LowerArmR",
		pivot = Vector3.new(1.6, 3.9, 0),
		lower = -150,
		upper = 15,
		kind = "elbow",
	},
	{
		name = "HipL",
		a = "Torso",
		b = "UpperLegL",
		pivot = Vector3.new(-0.75, 3.5, 0),
		lower = -85,
		upper = 40,
		kind = "hip",
	},
	{
		name = "KneeL",
		a = "UpperLegL",
		b = "LowerLegL",
		pivot = Vector3.new(-0.75, 1.8, 0),
		lower = -70,
		upper = 70,
		kind = "knee",
	},
	{
		name = "HipR",
		a = "Torso",
		b = "UpperLegR",
		pivot = Vector3.new(0.75, 3.5, 0),
		lower = -40,
		upper = 85,
		kind = "hip",
	},
	{
		name = "KneeR",
		a = "UpperLegR",
		b = "LowerLegR",
		pivot = Vector3.new(0.75, 1.8, 0),
		lower = -70,
		upper = 70,
		kind = "knee",
	},
}
GolemFactory.Joints = JOINTS
GolemFactory.PartNames = {}
for _, spec in PARTS do
	table.insert(GolemFactory.PartNames, spec.name)
end

local function decoration(
	parent: Model,
	host: BasePart,
	shape: Enum.PartType,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material,
	name: string
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("Deco", true)
	part.Parent = parent
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = host
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function addAccessory(model: Model, parts, skin, origin: CFrame)
	local head: BasePart = parts.Head
	local torso: BasePart = parts.Torso
	local headCF = head.CFrame
	local kind = skin.accessory
	if kind == "strawhat" then
		local straw = Color3.fromRGB(230, 196, 100)
		decoration(
			model,
			head,
			Enum.PartType.Cylinder,
			Vector3.new(0.2, 4.2, 4.2),
			headCF * CFrame.new(0, 1.05, 0.2) * UPRIGHT_CYL,
			straw,
			Enum.Material.Fabric,
			"HatBrim"
		)
		decoration(
			model,
			head,
			Enum.PartType.Cylinder,
			Vector3.new(1.3, 2.2, 2.2),
			headCF * CFrame.new(0, 1.65, 0.1) * UPRIGHT_CYL,
			straw,
			Enum.Material.Fabric,
			"HatTop"
		)
		decoration(
			model,
			head,
			Enum.PartType.Cylinder,
			Vector3.new(0.3, 2.25, 2.25),
			headCF * CFrame.new(0, 1.25, 0.1) * UPRIGHT_CYL,
			Color3.fromRGB(170, 50, 50),
			Enum.Material.Fabric,
			"HatBand"
		)
	elseif kind == "carrot" then
		decoration(
			model,
			head,
			Enum.PartType.Cylinder,
			Vector3.new(1.1, 0.34, 0.34),
			headCF * CFrame.new(0, -0.1, 1.5) * FACING_CYL,
			Color3.fromRGB(255, 130, 30),
			Enum.Material.SmoothPlastic,
			"Carrot"
		)
		for _, x in { -0.5, 0, 0.5 } do
			decoration(
				model,
				torso,
				Enum.PartType.Ball,
				Vector3.one * 0.35,
				torso.CFrame * CFrame.new(x * 0.2, 0.6 - math.abs(x), 1.42),
				Color3.fromRGB(30, 30, 30),
				Enum.Material.SmoothPlastic,
				"Button"
			)
		end
	elseif kind == "bolts" then
		for _, side in { -1, 1 } do
			decoration(
				model,
				head,
				Enum.PartType.Cylinder,
				Vector3.new(0.6, 0.4, 0.4),
				headCF * CFrame.new(side * 1.3, -0.4, 0),
				Color3.fromRGB(180, 180, 190),
				Enum.Material.Metal,
				"Bolt"
			)
		end
		decoration(
			model,
			torso,
			Enum.PartType.Block,
			Vector3.new(2.2, 0.3, 0.3),
			torso.CFrame * CFrame.new(0, -0.6, 1.35),
			Color3.fromRGB(70, 70, 80),
			Enum.Material.Metal,
			"Plate"
		)
	elseif kind == "crystal" then
		for i, offset in { Vector3.new(-0.6, 1.1, 0.2), Vector3.new(0.1, 1.3, 0), Vector3.new(0.7, 1.0, 0.1) } do
			decoration(
				model,
				head,
				Enum.PartType.Block,
				Vector3.new(0.45, 1.3 + i * 0.15, 0.45),
				headCF * CFrame.new(offset) * CFrame.Angles(0, math.rad(45), math.rad((i - 2) * 20)),
				Color3.fromRGB(255, 140, 255),
				Enum.Material.Neon,
				"Shard"
			)
		end
	elseif kind == "gear" then
		local gear = decoration(
			model,
			torso,
			Enum.PartType.Cylinder,
			Vector3.new(0.25, 1.4, 1.4),
			torso.CFrame * CFrame.new(0, 0.1, 1.45) * FACING_CYL,
			Color3.fromRGB(220, 170, 80),
			Enum.Material.Metal,
			"Gear"
		)
		gear:AddTag("Spinner")
		gear:SetAttribute("SpinSpeed", 2)
		gear:SetAttribute("SpinAxis", "Z")
	elseif kind == "horns" then
		for _, side in { -1, 1 } do
			decoration(
				model,
				head,
				Enum.PartType.Block,
				Vector3.new(0.4, 1.4, 0.4),
				headCF * CFrame.new(side * 0.8, 1.2, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)),
				Color3.fromRGB(40, 30, 30),
				Enum.Material.Basalt,
				"Horn"
			)
		end
	elseif kind == "halo" then
		local halo = decoration(
			model,
			head,
			Enum.PartType.Cylinder,
			Vector3.new(0.15, 2.2, 2.2),
			headCF * CFrame.new(0, 1.7, 0) * UPRIGHT_CYL,
			Color3.fromRGB(255, 230, 120),
			Enum.Material.Neon,
			"Halo"
		)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 220, 140)
		light.Range = 10
		light.Brightness = 1.4
		light.Parent = halo
	elseif kind == "crown" then
		local gold = Color3.fromRGB(255, 200, 60)
		decoration(
			model,
			head,
			Enum.PartType.Cylinder,
			Vector3.new(0.5, 1.6, 1.6),
			headCF * CFrame.new(0, 1.2, 0) * UPRIGHT_CYL,
			gold,
			Enum.Material.Foil,
			"CrownBand"
		)
		for _, x in { -0.55, 0, 0.55 } do
			decoration(
				model,
				head,
				Enum.PartType.Block,
				Vector3.new(0.3, 0.5, 0.3),
				headCF * CFrame.new(x, 1.6, 0.6) * CFrame.Angles(0, 0, math.rad(45)),
				gold,
				Enum.Material.Foil,
				"CrownSpike"
			)
		end
		decoration(
			model,
			head,
			Enum.PartType.Ball,
			Vector3.one * 0.3,
			headCF * CFrame.new(0, 1.25, 0.85),
			Color3.fromRGB(255, 40, 90),
			Enum.Material.Neon,
			"CrownGem"
		)
	end
	local _ = origin
end

export type BuildResult = {
	model: Model,
	parts: { [string]: BasePart },
	physical: { BasePart },
	joints: { [string]: HingeConstraint },
	upright: AlignOrientation,
	lift: VectorForce,
	mass: number,
	faces: { [string]: BasePart },
}

-- Builds and parents a golem. `feet` is the world position of the feet centre (on the plane).
function GolemFactory.build(
	skinId: string,
	feet: Vector3,
	planeOrigin: Attachment,
	group: string,
	parent: Instance
): BuildResult
	local skin = Skins.get(skinId)
	local model = Instance.new("Model")
	model.Name = "Golem"
	model:SetAttribute("Skin", skin.id)
	if skin.rainbow then
		model:SetAttribute("Rainbow", true)
	end

	local origin = CFrame.new(feet)
	local parts: { [string]: BasePart } = {}
	local physical = {}
	local physicalProps =
		PhysicalProperties.new(Config.Physics.GolemDensity * skin.density, skin.friction, skin.elasticity, 1, 1)

	for _, spec in PARTS do
		local part = Instance.new("Part")
		part.Name = spec.name
		part.Shape = spec.shape or Enum.PartType.Block
		part.Size = spec.size
		part.CFrame = origin * CFrame.new(spec.at)
		part.Color = if spec.name == "Torso" or spec.name == "Head" then skin.body else skin.limb
		part.Material = skin.material
		part.Transparency = if spec.visible then 0 else 1
		part.CanCollide = true
		part.CanQuery = true
		part.CanTouch = true
		part.CastShadow = spec.visible == true
		part.CollisionGroup = group
		part.CustomPhysicalProperties = physicalProps
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part:SetAttribute("Limb", spec.limb or spec.name)
		part.Parent = model
		parts[spec.name] = part
		table.insert(physical, part)
	end
	model.PrimaryPart = parts.Torso

	-- ── Visual layers ──
	local limbColor, jointColor, mat = skin.limb, skin.joint, skin.material
	local function limbVisual(
		part: BasePart,
		z: number,
		diameter: number,
		endBall: number?,
		endColor: Color3?,
		isLeg: boolean?
	)
		local cf = part.CFrame
		decoration(
			model,
			part,
			Enum.PartType.Cylinder,
			Vector3.new(part.Size.Y, diameter, diameter),
			cf * CFrame.new(0, 0, z) * UPRIGHT_CYL,
			limbColor,
			mat,
			"LimbVisual"
		)
		if endBall then
			local bottom = cf * CFrame.new(0, -part.Size.Y / 2, z)
			decoration(
				model,
				part,
				Enum.PartType.Ball,
				Vector3.one * endBall,
				bottom,
				endColor or jointColor,
				mat,
				if isLeg then "Knee" else "EndBall"
			)
		end
	end
	limbVisual(parts.UpperArmL, ARM_Z, 0.82, 0.9)
	limbVisual(parts.UpperArmR, ARM_Z, 0.82, 0.9)
	limbVisual(parts.LowerArmL, ARM_Z, 0.76, 0.95, skin.body)
	limbVisual(parts.LowerArmR, ARM_Z, 0.76, 0.95, skin.body)
	limbVisual(parts.UpperLegL, LEG_Z, 0.92, 0.98, nil, true)
	limbVisual(parts.UpperLegR, LEG_Z, 0.92, 0.98, nil, true)
	limbVisual(parts.LowerLegL, LEG_Z, 0.86)
	limbVisual(parts.LowerLegR, LEG_Z, 0.86)
	-- Boots.
	for _, name in { "LowerLegL", "LowerLegR" } do
		local leg = parts[name]
		local side = if name == "LowerLegL" then -1 else 1
		decoration(
			model,
			leg,
			Enum.PartType.Block,
			Vector3.new(1.35, 0.55, 1.2),
			leg.CFrame * CFrame.new(side * 0.18, -0.65, LEG_Z + 0.25),
			jointColor,
			mat,
			"Boot"
		)
	end
	-- Shoulder and hip balls (on the torso so limbs pivot under them).
	for _, x in { -1.6, 1.6 } do
		decoration(
			model,
			parts.Torso,
			Enum.PartType.Ball,
			Vector3.one * 1.05,
			origin * CFrame.new(x, 5.5, ARM_Z),
			jointColor,
			mat,
			"Shoulder"
		)
	end
	for _, x in { -0.75, 0.75 } do
		decoration(
			model,
			parts.Torso,
			Enum.PartType.Ball,
			Vector3.one * 1.0,
			origin * CFrame.new(x, 3.5, LEG_Z),
			jointColor,
			mat,
			"Hip"
		)
	end

	-- Chest rune (glowing core) and belly seam.
	local torsoCF = parts.Torso.CFrame
	local rune = decoration(
		model,
		parts.Torso,
		Enum.PartType.Block,
		Vector3.new(0.55, 0.55, 0.2),
		torsoCF * CFrame.new(0, 0.35, 1.42) * CFrame.Angles(0, 0, math.rad(45)),
		skin.accent,
		Enum.Material.Neon,
		"Rune"
	)
	rune.CastShadow = false
	local runeLight = Instance.new("PointLight")
	runeLight.Name = "RuneLight"
	runeLight.Color = skin.accent
	runeLight.Range = 7
	runeLight.Brightness = 1.1
	runeLight.Shadows = false
	runeLight.Parent = rune
	decoration(
		model,
		parts.Torso,
		Enum.PartType.Cylinder,
		Vector3.new(0.22, 2.9, 2.9),
		torsoCF * CFrame.new(0, -0.15, 0.08) * FACING_CYL,
		jointColor,
		mat,
		"Seam"
	).Transparency =
		0.0

	-- Face.
	local headCF = parts.Head.CFrame
	local faces = {}
	for _, side in { -1, 1 } do
		local tag = if side < 0 then "L" else "R"
		local eye = decoration(
			model,
			parts.Head,
			Enum.PartType.Ball,
			Vector3.one * 0.66,
			headCF * CFrame.new(side * 0.46, 0.18, 0.96),
			skin.eye,
			Enum.Material.SmoothPlastic,
			"Eye" .. tag
		)
		eye.CastShadow = false
		faces["Eye" .. tag] = eye
		-- Pupils use a Weld (not WeldConstraint) so clients can offset C0 to look at the cursor.
		local pupil = Instance.new("Part")
		pupil.Name = "Pupil" .. tag
		pupil.Shape = Enum.PartType.Ball
		pupil.Size = Vector3.one * 0.32
		pupil.Color = skin.pupil
		pupil.Material = Enum.Material.SmoothPlastic
		pupil.CanCollide = false
		pupil.CanQuery = false
		pupil.CanTouch = false
		pupil.Massless = true
		pupil.CastShadow = false
		pupil:SetAttribute("Deco", true)
		pupil.CFrame = headCF * CFrame.new(side * 0.46, 0.16, 1.24)
		pupil.Parent = model
		local weld = Instance.new("Weld")
		weld.Name = "PupilWeld"
		weld.Part0 = parts.Head
		weld.Part1 = pupil
		weld.C0 = headCF:ToObjectSpace(pupil.CFrame)
		weld.Parent = pupil
		pupil:SetAttribute("RestC0", weld.C0)
		faces["Pupil" .. tag] = pupil
		-- KO "X" eyes (hidden until knocked out).
		for _, angle in { 45, -45 } do
			local cross = decoration(
				model,
				parts.Head,
				Enum.PartType.Block,
				Vector3.new(0.62, 0.14, 0.14),
				headCF * CFrame.new(side * 0.46, 0.16, 1.2) * CFrame.Angles(0, 0, math.rad(angle)),
				Color3.fromRGB(30, 22, 30),
				Enum.Material.SmoothPlastic,
				"KOMark"
			)
			cross.Transparency = 1
			cross.CastShadow = false
		end
		-- Blush.
		local blush = decoration(
			model,
			parts.Head,
			Enum.PartType.Ball,
			Vector3.one * 0.34,
			headCF * CFrame.new(side * 0.8, -0.28, 0.82),
			Color3.fromRGB(255, 120, 140),
			Enum.Material.SmoothPlastic,
			"Blush"
		)
		blush.Transparency = 0.45
		blush.CastShadow = false
	end
	local mouth = decoration(
		model,
		parts.Head,
		Enum.PartType.Block,
		Vector3.new(0.6, 0.14, 0.14),
		headCF * CFrame.new(0, -0.42, 1.12),
		Color3.fromRGB(40, 24, 30),
		Enum.Material.SmoothPlastic,
		"Mouth"
	)
	mouth.CastShadow = false
	faces.Mouth = mouth

	addAccessory(model, parts, skin, origin)

	-- ── Physics constraints ──
	for _, part in physical do
		Physics2D.attach(part, planeOrigin, { lockRotation = part.Name == "Torso", gravity = true })
	end

	local joints = {}
	local rotation = Physics2D.PlaneRotation
	for _, spec in JOINTS do
		local a, b = parts[spec.a], parts[spec.b]
		local pivotWorld = origin * CFrame.new(spec.pivot)
		local frame = CFrame.new(pivotWorld.Position) * rotation
		local att0 = Instance.new("Attachment")
		att0.Name = spec.name .. "0"
		att0.CFrame = a.CFrame:ToObjectSpace(frame)
		att0.Parent = a
		local att1 = Instance.new("Attachment")
		att1.Name = spec.name .. "1"
		att1.CFrame = b.CFrame:ToObjectSpace(frame)
		att1.Parent = b
		local hinge = Instance.new("HingeConstraint")
		hinge.Name = spec.name
		hinge.Attachment0 = att0
		hinge.Attachment1 = att1
		hinge.LimitsEnabled = true
		hinge.LowerAngle = spec.lower
		hinge.UpperAngle = spec.upper
		hinge.Restitution = 0.05
		hinge.ActuatorType = Enum.ActuatorType.Motor
		hinge.AngularVelocity = 0
		hinge.MotorMaxTorque = 0
		hinge.Visible = false
		hinge:SetAttribute("Kind", spec.kind)
		hinge.Parent = a
		joints[spec.name] = hinge
	end

	-- Upright controller (only active while standing).
	local uprightAtt = Instance.new("Attachment")
	uprightAtt.Name = "UprightAtt"
	uprightAtt.CFrame = parts.Torso.CFrame:ToObjectSpace(CFrame.new(parts.Torso.Position) * Physics2D.UpRotation)
	uprightAtt.Parent = parts.Torso
	local upright = Instance.new("AlignOrientation")
	upright.Name = "Upright"
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	upright.AlignType = Enum.AlignType.PrimaryAxisParallel
	upright.Attachment0 = uprightAtt
	upright.PrimaryAxis = Vector3.yAxis
	upright.Responsiveness = 30
	upright.MaxTorque = 0
	upright.MaxAngularVelocity = 12
	upright.Enabled = false
	upright.Parent = parts.Torso

	local lift = Instance.new("VectorForce")
	lift.Name = "Lift"
	lift.Attachment0 = parts.Torso:FindFirstChild("Plane2D") :: Attachment
	lift.RelativeTo = Enum.ActuatorRelativeTo.World
	lift.ApplyAtCenterOfMass = true
	lift.Force = Vector3.zero
	lift.Enabled = false
	lift.Parent = parts.Torso

	model.Parent = parent

	local mass = 0
	for _, part in physical do
		mass += part:GetMass()
	end

	return {
		model = model,
		parts = parts,
		physical = physical,
		joints = joints,
		upright = upright,
		lift = lift,
		mass = mass,
		faces = faces,
	}
end

return GolemFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">LabFurniture</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Interactive lab furniture shared by every map: the brewing cauldron and the ingredient rack.

local LabFurniture = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function seq(...): NumberSequence
	local points = { ... }
	local keypoints = {}
	for i = 1, #points, 2 do
		table.insert(keypoints, NumberSequenceKeypoint.new(points[i], points[i + 1]))
	end
	return NumberSequence.new(keypoints)
end

function LabFurniture.cauldron(parent: Instance, base: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Cauldron"
	model:SetAttribute("Interactive", "Cauldron")
	local iron = Color3.fromRGB(34, 32, 40)

	part(model, {
		Name = "Pot",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5.2, 7.6, 7.6),
		CFrame = base * CFrame.new(0, 3.6, 0) * UPRIGHT,
		Color = iron,
		Material = Enum.Material.Metal,
	})
	part(model, {
		Name = "Belly",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 8.4,
		CFrame = base * CFrame.new(0, 3.1, 0),
		Color = iron,
		Material = Enum.Material.Metal,
	})
	part(model, {
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 8.4, 8.4),
		CFrame = base * CFrame.new(0, 6.3, 0) * UPRIGHT,
		Color = Color3.fromRGB(50, 46, 56),
		Material = Enum.Material.Metal,
	})
	local liquid = part(model, {
		Name = "CauldronLiquid",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 7.2, 7.2),
		CFrame = base * CFrame.new(0, 6.25, 0) * UPRIGHT,
		Color = Color3.fromRGB(120, 255, 140),
		Material = Enum.Material.Neon,
		CastShadow = false,
	})
	local glow = Instance.new("PointLight")
	glow.Name = "LiquidGlow"
	glow.Color = liquid.Color
	glow.Range = 16
	glow.Brightness = 1.6
	glow.Shadows = false
	glow.Parent = liquid
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Name = "Bubbles"
	bubbles.Texture = "rbxasset://textures/whiteCircle.png"
	bubbles.Rate = 9
	bubbles.Lifetime = NumberRange.new(0.6, 1.2)
	bubbles.Speed = NumberRange.new(1, 2.5)
	bubbles.SpreadAngle = Vector2.new(10, 10)
	bubbles.Size = seq(0, 0.2, 0.7, 0.55, 1, 0.75)
	bubbles.Transparency = seq(0, 0.25, 0.85, 0.3, 1, 1)
	bubbles.LightEmission = 0.7
	bubbles.Color = ColorSequence.new(liquid.Color)
	bubbles.EmissionDirection = Enum.NormalId.Right -- cylinder X axis points up after rotation
	bubbles.Shape = Enum.ParticleEmitterShape.Disc
	bubbles.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	bubbles.Parent = liquid
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Rate = 4
	steam.Lifetime = NumberRange.new(2, 3.5)
	steam.Speed = NumberRange.new(2, 4)
	steam.Size = seq(0, 1.5, 1, 5)
	steam.Transparency = seq(0, 0.75, 1, 1)
	steam.Color = ColorSequence.new(Color3.fromRGB(230, 255, 235))
	steam.EmissionDirection = Enum.NormalId.Right
	steam.Parent = liquid

	for i = 0, 2 do
		local angle = math.rad(i * 120 + 30)
		part(model, {
			Name = "Leg",
			Size = Vector3.new(0.9, 1.6, 0.9),
			CFrame = base * CFrame.new(math.cos(angle) * 3, 0.8, math.sin(angle) * 3),
			Color = iron,
			Material = Enum.Material.Metal,
		})
	end
	-- Fire underneath.
	for _, angle in { 25, -25 } do
		part(model, {
			Name = "Log",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(5, 0.9, 0.9),
			CFrame = base * CFrame.new(0, 0.45, 1.5) * CFrame.Angles(0, math.rad(angle), 0),
			Color = Color3.fromRGB(90, 58, 40),
			Material = Enum.Material.Wood,
		})
	end
	local fire = part(model, {
		Name = "Fire",
		Size = Vector3.new(3, 0.5, 2),
		CFrame = base * CFrame.new(0, 0.8, 1.8),
		Transparency = 1,
		CastShadow = false,
	})
	local flames = Instance.new("ParticleEmitter")
	flames.Texture = "rbxasset://textures/particles/fire_main.dds"
	flames.Rate = 20
	flames.Lifetime = NumberRange.new(0.4, 0.8)
	flames.Speed = NumberRange.new(2, 4)
	flames.Size = seq(0, 1.6, 1, 0.2)
	flames.Transparency = seq(0, 0.25, 1, 1)
	flames.LightEmission = 1
	flames.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20))
	flames.EmissionDirection = Enum.NormalId.Top
	flames.Shape = Enum.ParticleEmitterShape.Box
	flames.Parent = fire
	local fireLight = Instance.new("PointLight")
	fireLight.Color = Color3.fromRGB(255, 140, 60)
	fireLight.Range = 14
	fireLight.Brightness = 1.8
	fireLight.Parent = fire
	fireLight:AddTag("Flicker")

	-- Invisible click target for the client raycast.
	local target = part(model, {
		Name = "ClickTarget",
		Size = Vector3.new(9, 8, 9),
		CFrame = base * CFrame.new(0, 4, 0),
		Transparency = 1,
		CanQuery = true,
		CastShadow = false,
	})
	target:SetAttribute("Interactive", "Cauldron")
	model.PrimaryPart = target
	model.Parent = parent
	return model
end

function LabFurniture.rack(parent: Instance, base: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "IngredientRack"
	model:SetAttribute("Interactive", "Rack")
	local wood = Color3.fromRGB(110, 74, 50)
	for _, y in { 4.2, 8.4 } do
		part(model, {
			Name = "Board",
			Size = Vector3.new(11, 0.5, 2.6),
			CFrame = base * CFrame.new(0, y, 0),
			Color = wood,
			Material = Enum.Material.WoodPlanks,
		})
	end
	for _, x in { -5.3, 5.3 } do
		part(model, {
			Name = "Post",
			Size = Vector3.new(0.6, 10.5, 2.6),
			CFrame = base * CFrame.new(x, 5.25, 0),
			Color = Color3.fromRGB(80, 54, 38),
			Material = Enum.Material.Wood,
		})
	end
	-- Six jars; LabService shows one per stocked ingredient.
	for i = 1, 6 do
		local row = if i <= 3 then 0 else 1
		local col = (i - 1) % 3
		local cf = base * CFrame.new(-3.4 + col * 3.4, 5.6 + row * 4.2, 0.2)
		part(model, {
			Name = "Jar" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2.2, 1.9, 1.9),
			CFrame = cf * UPRIGHT,
			Color = Color3.fromRGB(220, 240, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.5,
			CastShadow = false,
		})
		local content = part(model, {
			Name = "JarContent" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.4, 1.5, 1.5),
			CFrame = cf * CFrame.new(0, -0.3, 0) * UPRIGHT,
			Color = Color3.fromRGB(255, 160, 60),
			Material = Enum.Material.Neon,
			CastShadow = false,
		})
		content.Transparency = 1
		part(model, {
			Name = "JarLid",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 2.1, 2.1),
			CFrame = cf * CFrame.new(0, 1.2, 0) * UPRIGHT,
			Color = Color3.fromRGB(150, 104, 62),
			Material = Enum.Material.Wood,
		})
	end
	-- Sign.
	local sign = part(model, {
		Name = "Sign",
		Size = Vector3.new(7, 1.8, 0.3),
		CFrame = base * CFrame.new(0, 11.2, 0.6),
		Color = Color3.fromRGB(70, 46, 32),
		Material = Enum.Material.Wood,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0.2
	gui.CanvasSize = Vector2.new(350, 90)
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "FREE HERBS"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 230, 160)
	label.FontFace = Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	label.Parent = gui

	local target = part(model, {
		Name = "ClickTarget",
		Size = Vector3.new(12, 12, 4),
		CFrame = base * CFrame.new(0, 6, 0),
		Transparency = 1,
		CanQuery = true,
		CastShadow = false,
	})
	target:SetAttribute("Interactive", "Rack")
	model.PrimaryPart = target
	model.Parent = parent
	return model
end

return LabFurniture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Physics2D</string>
            <string name="Source"><![CDATA[--!nonstrict
-- 2D physics on top of Roblox's 3D solver.
--  * PlaneConstraint keeps every dynamic part on its lab's Z plane (translation only).
--  * A rigid AlignOrientation (PrimaryAxisParallel) on free bodies keeps their local Z parallel
--    to world Z, so they only rotate around Z.
--  * A per-assembly VectorForce implements per-lab/per-object gravity scaling, which is how slow
--    motion (g·s²), levitation, gravity flip and low-gravity rooms work without touching
--    workspace.Gravity (which is global to the server).

local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Physics2D = {}

-- Rotation whose X axis is world +Z (the plane normal) and Y axis is world up.
Physics2D.PlaneRotation = CFrame.fromMatrix(Vector3.zero, Vector3.zAxis, Vector3.yAxis)
-- Rotation whose X axis is world up; used by "keep upright" controllers.
Physics2D.UpRotation = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, -Vector3.xAxis)

Physics2D.GolemGroups = {} :: { string }

function Physics2D.setupCollisionGroups()
	local function register(name: string)
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	register("Static")
	register("Props")
	register("Debris")
	register("NoCollide")
	for i = 1, Config.MaxGolemsExpanded do
		local name = "Golem" .. i
		register(name)
		Physics2D.GolemGroups[i] = name
	end
	-- A golem's own limbs overlap in 2D, so they must not collide with each other.
	for i = 1, Config.MaxGolemsExpanded do
		PhysicsService:CollisionGroupSetCollidable("Golem" .. i, "Golem" .. i, false)
	end
	PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)
	PhysicsService:CollisionGroupSetCollidable("Debris", "Props", false)
	for i = 1, Config.MaxGolemsExpanded do
		PhysicsService:CollisionGroupSetCollidable("Debris", "Golem" .. i, false)
	end
	for _, group in PhysicsService:GetRegisteredCollisionGroups() do
		PhysicsService:CollisionGroupSetCollidable("NoCollide", group.name, false)
	end
end

-- The anchored part that owns the plane origin attachment for one lab.
function Physics2D.createLabAnchor(parent: Instance, origin: Vector3): Attachment
	local anchor = Instance.new("Part")
	anchor.Name = "PlaneAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(origin)
	anchor.Parent = parent
	local attachment = Instance.new("Attachment")
	attachment.Name = "PlaneOrigin"
	attachment.CFrame = Physics2D.PlaneRotation
	attachment.Parent = anchor
	return attachment
end

-- Attachment at the part centre whose WORLD orientation is the plane frame (X = world Z).
local function planeAttachment(part: BasePart): Attachment
	local existing = part:FindFirstChild("Plane2D")
	if existing and existing:IsA("Attachment") then
		return existing
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "Plane2D"
	attachment.CFrame = part.CFrame:ToObjectSpace(CFrame.new(part.Position) * Physics2D.PlaneRotation)
	attachment.Parent = part
	return attachment
end
Physics2D.planeAttachment = planeAttachment

export type AttachOptions = {
	lockRotation: boolean?,
	gravity: boolean?,
}

-- Locks a part to the lab plane. Call while the part is already on the plane (Z = 0).
function Physics2D.attach(part: BasePart, planeOrigin: Attachment, options: AttachOptions?)
	local opts = options or {}
	local attachment = planeAttachment(part)

	local plane = Instance.new("PlaneConstraint")
	plane.Name = "Plane2D"
	plane.Attachment0 = planeOrigin
	plane.Attachment1 = attachment
	plane.Visible = false
	plane.Parent = part

	if opts.lockRotation ~= false then
		local lock = Instance.new("AlignOrientation")
		lock.Name = "Lock2D"
		lock.Mode = Enum.OrientationAlignmentMode.OneAttachment
		lock.AlignType = Enum.AlignType.PrimaryAxisParallel
		lock.Attachment0 = attachment
		lock.PrimaryAxis = Vector3.zAxis
		lock.RigidityEnabled = true
		lock.Parent = part
	end

	if opts.gravity ~= false then
		local force = Instance.new("VectorForce")
		force.Name = "Gravity2D"
		force.Attachment0 = attachment
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.ApplyAtCenterOfMass = true
		force.Force = Vector3.zero
		force.Parent = part
	end
	return attachment
end

-- Sets the effective gravity of one assembly to `scale * g` (negative = upwards).
function Physics2D.setGravityScale(part: BasePart, scale: number)
	local force = part:FindFirstChild("Gravity2D")
	if not force then
		return
	end
	-- Exactly one Gravity2D exists per assembly, so the whole assembly mass is compensated here.
	local g = Workspace.Gravity
	local mass = part.AssemblyMass
	if mass ~= mass or mass == math.huge then
		return -- anchored / invalid
	end
	local target = Vector3.new(0, mass * g * (1 - scale), 0)
	if (force.Force - target).Magnitude > 0.01 then
		force.Force = target
	end
end

function Physics2D.removePlane(part: BasePart)
	for _, name in { "Plane2D", "Lock2D", "Gravity2D" } do
		for _, child in part:GetChildren() do
			if child.Name == name and not child:IsA("Attachment") then
				child:Destroy()
			end
		end
	end
end

-- Server-authoritative impulse. Reclaims network ownership first so the impulse is not lost.
function Physics2D.impulse(part: BasePart, impulse: Vector3)
	if part.Anchored then
		return
	end
	if part:CanSetNetworkOwnership() then
		local owner = part:GetNetworkOwner()
		if owner ~= nil then
			pcall(part.SetNetworkOwner, part, nil)
		end
	end
	part:ApplyImpulse(Vector3.new(impulse.X, impulse.Y, 0))
end

function Physics2D.setVelocity(part: BasePart, velocity: Vector3)
	if part.Anchored then
		return
	end
	part.AssemblyLinearVelocity = Vector3.new(velocity.X, velocity.Y, 0)
end

function Physics2D.setOwner(parts: { BasePart }, player: Player?)
	for _, part in parts do
		if part.Parent and not part.Anchored and part:CanSetNetworkOwnership() then
			pcall(part.SetNetworkOwner, part, player)
		end
	end
end

-- Projects a world point onto the lab plane.
function Physics2D.flatten(position: Vector3, planeZ: number): Vector3
	return Vector3.new(position.X, position.Y, planeZ)
end

return Physics2D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Shared server-side registries: labs, which lab each player is viewing, and the mapping from
-- physical parts back to the golem/prop object they belong to.

local World = {
	labs = {} :: { [number]: any }, -- [slot] = Lab
	ownerLab = {} :: { [Player]: any }, -- lab owned by player
	viewLab = {} :: { [Player]: any }, -- lab the player is currently in (own or visiting)
	partToObject = (setmetatable({}, { __mode = "k" }) :: any) :: { [BasePart]: any },
	_nextId = 0,
}

function World.nextId(): number
	World._nextId += 1
	return World._nextId
end

function World.register(object)
	for _, part in object.parts do
		World.partToObject[part] = object
	end
end

function World.unregister(object)
	for _, part in object.parts do
		World.partToObject[part] = nil
	end
end

function World.objectFromPart(part: Instance?)
	if not part or not part:IsA("BasePart") then
		return nil
	end
	return World.partToObject[part]
end

-- Everyone currently looking at a lab (owner + visitors).
function World.viewers(lab): { Player }
	local list = {}
	for player, viewing in World.viewLab do
		if viewing == lab and player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

function World.labOf(player: Player)
	return World.viewLab[player]
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="64">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="65">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="66">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">400</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="67">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="68">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="69">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">AmbientController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Ambient life: spinning fans and sigils, scrolling conveyor chevrons, flickering candles, disco
-- lights, golem name/health/status billboards, eyes that follow your cursor, golem voices and
-- rainbow/disco highlights.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.Parent.UI.Theme)

local AmbientController = {}

local STATUS_ICONS = {
	burning = "🔥",
	frozen = "🧊",
	levitating = "☁️",
	bouncy = "🟢",
	rocket = "🚀",
	shocked = "⚡",
	wet = "💧",
	hyper = "🌀",
	giant = "⏫",
	tiny = "⏬",
	gravityflip = "🙃",
	ghost = "👻",
	zombie = "🧟",
	golden = "💰",
	magnetic = "🧲",
	disco = "🎶",
	acid = "🧪",
	dragonbreath = "🐉",
	balloons = "🎈",
	sticky = "🍯",
	stinky = "🤢",
	stasis = "⏳",
	ascension = "😇",
}

local spinners = {}
local scrollers = {}
local flickers = {}
local discoLights = {}
local golems = {} :: { [Model]: any }

function AmbientController:Init(controllers)
	self.C = controllers
end

local function watchTag(tag: string, onAdd: (Instance) -> ())
	for _, instance in CollectionService:GetTagged(tag) do
		task.spawn(onAdd, instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(onAdd)
end

local function labOriginX(instance: Instance): number
	local current = instance.Parent
	while current and current ~= workspace do
		local slot = current:GetAttribute("Slot")
		if typeof(slot) == "number" then
			return slot * Config.LabSpacing
		end
		current = current.Parent
	end
	return 0
end

-- ─────────────────────────────── golem billboards ───────────────────────────────

local function buildBillboard(model: Model)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "GolemTag"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(170, 54)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 500
	gui.ResetOnSpawn = false
	gui.Parent = model
	local icons = Instance.new("TextLabel")
	icons.Name = "Icons"
	icons.BackgroundTransparency = 1
	icons.Size = UDim2.new(1, 0, 0, 28)
	icons.FontFace = Theme.Font.UI
	icons.TextSize = 24
	icons.Text = ""
	icons.Parent = gui
	local track = Instance.new("Frame")
	track.Name = "Health"
	track.BackgroundColor3 = Theme.Color.Surface.Sunken
	track.BackgroundTransparency = 0.15
	track.BorderSizePixel = 0
	track.Size = UDim2.new(0.7, 0, 0, 10)
	track.Position = UDim2.new(0.15, 0, 0, 34)
	track.Visible = false
	track.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = track
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Color.Text.Outline
	stroke.Thickness = 1.5
	stroke.Parent = track
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Theme.Color.State.Success
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = track
	local fillCorner = corner:Clone()
	fillCorner.Parent = fill
	return { gui = gui, icons = icons, track = track, fill = fill, lastDamage = 0 }
end

local function refreshIcons(entry)
	local model = entry.model
	local text = {}
	for id, icon in STATUS_ICONS do
		if model:GetAttribute("S_" .. id) then
			table.insert(text, icon)
		end
	end
	table.sort(text)
	if model:GetAttribute("State") == "ko" then
		table.insert(text, 1, "💫")
	end
	entry.tag.icons.Text = table.concat(text, " ")
end

local function refreshHealth(entry)
	local model = entry.model
	local health = model:GetAttribute("Health") or 100
	local max = model:GetAttribute("MaxHealth") or 100
	local fraction = math.clamp(health / max, 0, 1)
	entry.tag.fill.Size = UDim2.fromScale(fraction, 1)
	entry.tag.fill.BackgroundColor3 = if fraction > 0.5
		then Theme.Color.State.Success
		elseif fraction > 0.2 then Theme.Color.State.Warning
		else Theme.Color.State.Danger
end

function AmbientController:_trackGolem(model: Model)
	if golems[model] or not model:GetAttribute("GolemId") then
		return
	end
	local tag = buildBillboard(model)
	if not tag then
		return
	end
	local entry =
		{ model = model, tag = tag, pupils = {}, highlight = nil, lastHealth = model:GetAttribute("Health") or 100 }
	golems[model] = entry
	for _, name in { "PupilL", "PupilR" } do
		local pupil = model:FindFirstChild(name)
		local weld = pupil and pupil:FindFirstChild("PupilWeld") :: Weld?
		if weld then
			table.insert(entry.pupils, { weld = weld, rest = weld.C0 })
		end
	end
	refreshIcons(entry)
	refreshHealth(entry)
	entry.conn = model.AttributeChanged:Connect(function(attribute)
		if attribute == "Health" then
			local health = model:GetAttribute("Health") or 100
			if health < entry.lastHealth then
				tag.lastDamage = os.clock()
			end
			entry.lastHealth = health
			refreshHealth(entry)
		elseif attribute == "State" then
			local state = model:GetAttribute("State")
			local head = model:FindFirstChild("Head") :: BasePart?
			if head and (state == "stunned" or state == "ko") and math.random() < 0.7 then
				local squeaky = model:GetAttribute("Squeaky")
				local scale = model:GetAttribute("Scale") or 1
				local pitch = if squeaky then 1.9 else math.clamp(1.15 / math.sqrt(scale), 0.5, 1.4)
				self.C.SoundController:Play(if state == "ko" then "oof" else "ouch", head.Position, { pitch = pitch })
			end
			refreshIcons(entry)
		elseif attribute:sub(1, 2) == "S_" then
			refreshIcons(entry)
		end
		if attribute == "Disco" or attribute == "Rainbow" or attribute == "S_disco" then
			self:_updateHighlight(entry)
		end
	end)
	self:_updateHighlight(entry)
end

function AmbientController:_updateHighlight(entry)
	local model = entry.model
	local wants = model:GetAttribute("Disco") or model:GetAttribute("Rainbow")
	if wants and not entry.highlight then
		local highlight = Instance.new("Highlight")
		highlight.Name = "RainbowGlow"
		highlight.FillTransparency = if model:GetAttribute("Disco") then 0.35 else 0.55
		highlight.OutlineTransparency = 0.4
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Adornee = model
		highlight.Parent = model
		entry.highlight = highlight
	elseif not wants and entry.highlight then
		entry.highlight:Destroy()
		entry.highlight = nil
	end
end

function AmbientController:_untrack(model: Model)
	local entry = golems[model]
	if entry then
		if entry.conn then
			entry.conn:Disconnect()
		end
		golems[model] = nil
	end
end

function AmbientController:_watchLab()
	if self._labConns then
		for _, conn in self._labConns do
			conn:Disconnect()
		end
	end
	self._labConns = {}
	for model in table.clone(golems) do
		self:_untrack(model)
	end
	local labModel = self.C.State:LabModel()
	local dynamic = labModel and labModel:WaitForChild("Dynamic", 5)
	if not dynamic then
		return
	end
	local function consider(child: Instance)
		if child:IsA("Model") then
			-- Attributes replicate with the instance; wait a frame for children too.
			task.defer(function()
				if child.Parent and child:GetAttribute("GolemId") then
					child:WaitForChild("Head", 3)
					self:_trackGolem(child)
				end
			end)
		end
	end
	for _, child in dynamic:GetChildren() do
		consider(child)
	end
	table.insert(self._labConns, dynamic.ChildAdded:Connect(consider))
	table.insert(
		self._labConns,
		dynamic.ChildRemoved:Connect(function(child)
			if child:IsA("Model") then
				self:_untrack(child)
			end
		end)
	)
end

-- ─────────────────────────────── start ───────────────────────────────

function AmbientController:Start()
	local State = self.C.State
	State.LabChanged:Connect(function(lab, previous)
		if not previous or previous.ownerId ~= lab.ownerId then
			task.spawn(self._watchLab, self)
		end
	end)

	watchTag("Spinner", function(part)
		if part:IsA("BasePart") and part.Anchored then
			spinners[part] = {
				base = part.CFrame,
				speed = part:GetAttribute("SpinSpeed") or 1,
				axis = part:GetAttribute("SpinAxis") or "X",
			}
		end
	end)
	watchTag("Scroller", function(part)
		if part:IsA("BasePart") then
			local originX = labOriginX(part)
			local min = part:GetAttribute("ScrollMin") or 0
			local max = part:GetAttribute("ScrollMax") or 10
			scrollers[part] = {
				base = part.CFrame,
				speed = part:GetAttribute("ScrollSpeed") or 10,
				min = min,
				max = max,
				startLocal = part.Position.X - originX,
			}
		end
	end)
	watchTag("Flicker", function(light)
		if light:IsA("Light") then
			flickers[light] = { base = light.Brightness, seed = math.random() * 100 }
		end
	end)
	watchTag("DiscoLight", function(light)
		if light:IsA("Light") then
			discoLights[light] = math.random()
		end
	end)

	local pupilTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for part, entry in spinners do
			if not part.Parent then
				spinners[part] = nil
				continue
			end
			local angle = t * entry.speed
			local rotation = if entry.axis == "Y"
				then CFrame.Angles(0, angle, 0)
				elseif entry.axis == "Z" then CFrame.Angles(0, 0, angle)
				else CFrame.Angles(angle, 0, 0)
			part.CFrame = entry.base * rotation
		end
		local timeScale = State:TimeScale()
		for part, entry in scrollers do
			if not part.Parent then
				scrollers[part] = nil
				continue
			end
			entry.offset = (entry.offset or 0) + entry.speed * dt * timeScale
			local travel = entry.max - entry.min
			local localX = (entry.startLocal - entry.min + entry.offset) % travel + entry.min
			part.CFrame = entry.base + Vector3.new(localX - entry.startLocal, 0, 0)
		end
		for light, entry in flickers do
			if not light.Parent then
				flickers[light] = nil
				continue
			end
			light.Brightness = entry.base * (0.8 + 0.3 * (math.noise(t * 7, entry.seed) + 0.5))
		end
		for light, seed in discoLights do
			if not light.Parent then
				discoLights[light] = nil
				continue
			end
			light.Color = Color3.fromHSV((t * 0.6 + seed) % 1, 0.75, 1)
		end
		for _, entry in golems do
			local highlight = entry.highlight
			if highlight then
				local hue = (t * 0.5 + entry.model:GetAttribute("GolemId") * 0.13) % 1
				highlight.FillColor = Color3.fromHSV(hue, 0.8, 1)
				highlight.OutlineColor = Color3.fromHSV((hue + 0.5) % 1, 0.6, 1)
			end
			local tag = entry.tag
			local showHealth = (t - tag.lastDamage) < 3
				or (entry.lastHealth < (entry.model:GetAttribute("MaxHealth") or 100))
			tag.track.Visible = showHealth
		end

		-- Eyes follow the cursor (cheap, 20 Hz).
		pupilTimer -= dt
		if pupilTimer <= 0 then
			pupilTimer = 0.05
			local pointer = self.C.CameraController:ScreenToPlane(self.C.InputController.pointer)
			if pointer then
				for model, entry in golems do
					local head = model:FindFirstChild("Head") :: BasePart?
					if head and model:GetAttribute("Face") ~= "ko" then
						local localTarget = head.CFrame:PointToObjectSpace(pointer)
						local dir = Vector3.new(localTarget.X, localTarget.Y, 0)
						local offset = if dir.Magnitude > 0.01
							then dir.Unit * math.min(dir.Magnitude * 0.02, 0.12)
							else Vector3.zero
						for _, pupil in entry.pupils do
							if pupil.weld.Parent then
								pupil.weld.C0 = pupil.rest * CFrame.new(offset.X, offset.Y, 0)
							end
						end
					end
				end
			end
		end
	end)
end

return AmbientController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Side-view diorama camera: frames the current lab, smooth zoom-to-cursor and pan, trauma-based
-- screen shake, FOV punches and an optional follow target.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Spring = require(Shared.Util.Spring)

local CameraController = {
	planeZ = 0,
	trauma = 0,
	shakeScale = 1,
}

local BASE_FOV = 38
local camera: Camera

local focus = Spring.new(Vector3.zero, 9, 1)
local distance = Spring.new(100, 9, 1)
local fovKick = Spring.new(0, 14, 0.55)

local fitDistance = 100
local roomWidth, roomHeight = 112, 60
local origin = Vector3.zero
local follow: BasePart? = nil

local function noise(t: number, seed: number): number
	return math.noise(t, seed * 13.37, 0.5)
end

function CameraController:Init(controllers)
	self.C = controllers
end

local function viewportAspect(): number
	local size = camera.ViewportSize
	if size.Y <= 0 then
		return 16 / 9
	end
	return size.X / size.Y
end

function CameraController:_fit(snap: boolean)
	local tanHalf = math.tan(math.rad(BASE_FOV / 2))
	local needH = (roomHeight + 12) / (2 * tanHalf)
	local needW = (roomWidth + 14) / (2 * tanHalf * viewportAspect())
	if roomHeight > roomWidth * 1.4 then
		fitDistance = needW -- tall rooms: fit the width and pan vertically
	else
		fitDistance = math.max(needH, needW)
	end
	local visibleHalfH = fitDistance * tanHalf
	local focusY = math.min(roomHeight / 2, visibleHalfH - 4)
	local target = origin + Vector3.new(0, math.max(focusY, 8), 0)
	focus.Target = target
	distance.Target = fitDistance
	if snap then
		focus:Snap(target)
		distance:Snap(fitDistance)
	end
end

function CameraController:Start()
	camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = BASE_FOV
	local State = self.C.State

	State.LabChanged:Connect(function(lab, previous)
		local changedLab = not previous or previous.ownerId ~= lab.ownerId or previous.mapId ~= lab.mapId
		origin = lab.origin
		roomWidth, roomHeight = lab.width, lab.height
		self.planeZ = lab.origin.Z
		if changedLab then
			follow = nil
			self:_fit(previous == nil or previous.ownerId ~= lab.ownerId)
		end
	end)
	State.Changed:Connect(function(key)
		if (key == "settings" or key == "*") and State.data then
			self.shakeScale = State.data.settings.shake or 1
		end
	end)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if State.lab then
			self:_fit(false)
		end
	end)

	RunService:BindToRenderStep("FlaskCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:_update(math.min(dt, 0.1))
	end)
end

function CameraController:_clamp(p: Vector3): Vector3
	local halfW, h = roomWidth / 2, roomHeight
	return Vector3.new(
		math.clamp(p.X, origin.X - halfW, origin.X + halfW),
		math.clamp(p.Y, origin.Y - 2, origin.Y + h + 2),
		origin.Z
	)
end

function CameraController:_update(dt: number)
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if follow then
		if follow.Parent then
			focus.Target = self:_clamp(follow.Position)
		else
			follow = nil
		end
	end
	focus.Target = self:_clamp(focus.Target)
	local f = focus:Step(dt)
	local d = distance:Step(dt)
	local kick = fovKick:Step(dt)

	self.trauma = math.max(0, self.trauma - dt * 1.5)
	local shake = self.trauma * self.trauma * self.shakeScale
	local t = os.clock() * 24
	local offset = Vector3.new(noise(t, 1), noise(t, 2), 0) * shake * 2.2
	local roll = noise(t, 3) * shake * math.rad(2.2)

	local position = f + Vector3.new(0, d * 0.05, d) + offset
	camera.CFrame = CFrame.lookAt(position, f + offset * 0.5) * CFrame.Angles(0, 0, roll)
	camera.FieldOfView = BASE_FOV + kick * self.shakeScale
	camera.Focus = CFrame.new(f)
end

-- ─────────────────────────────── API ───────────────────────────────

function CameraController:ScreenToPlane(viewportPosition: Vector2): Vector3?
	if not camera then
		return nil
	end
	local ray = camera:ViewportPointToRay(viewportPosition.X, viewportPosition.Y)
	if math.abs(ray.Direction.Z) < 1e-4 then
		return nil
	end
	local t = (self.planeZ - ray.Origin.Z) / ray.Direction.Z
	if t <= 0 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

function CameraController:Ray(viewportPosition: Vector2): Ray
	return camera:ViewportPointToRay(viewportPosition.X, viewportPosition.Y)
end

-- Zoom keeping the world point under the cursor fixed.
function CameraController:ZoomAt(viewportPosition: Vector2?, factor: number)
	local old = distance.Target
	local new = math.clamp(old * factor, fitDistance * 0.32, fitDistance * 1.3)
	if viewportPosition then
		local point = self:ScreenToPlane(viewportPosition)
		if point then
			local ratio = new / old
			focus.Target = point + (focus.Target - point) * ratio
		end
	end
	distance.Target = new
	follow = nil
end

function CameraController:Pan(delta: Vector3)
	focus.Target = focus.Target + Vector3.new(delta.X, delta.Y, 0)
	follow = nil
end

-- Pan by a screen-space pixel delta (drag gestures).
function CameraController:PanPixels(pixels: Vector2)
	local d = distance.Position
	local worldPerPixel = 2 * d * math.tan(math.rad(BASE_FOV / 2)) / math.max(camera.ViewportSize.Y, 1)
	self:Pan(Vector3.new(-pixels.X * worldPerPixel, pixels.Y * worldPerPixel, 0))
end

function CameraController:Reset()
	follow = nil
	self:_fit(false)
end

function CameraController:Follow(part: BasePart?)
	follow = part
end

function CameraController:Shake(amount: number, position: Vector3?)
	local scale = 1
	if position and camera then
		local focusPoint = focus.Position
		local d = (position - focusPoint).Magnitude
		scale = math.clamp(1 - d / (fitDistance * 1.2), 0.2, 1)
	end
	self.trauma = math.min(1, self.trauma + amount * scale)
end

function CameraController:Punch(amount: number)
	fovKick:Impulse(amount * 10)
end

function CameraController:Distance(): number
	return distance.Position
end

function CameraController:FitDistance(): number
	return fitDistance
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">CursorController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Custom cursor (ring + context icon) and live cursors of other players in the same lab.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Potions = require(Shared.Data.Potions)
local PropsData = require(Shared.Data.Props)

local Theme = require(script.Parent.Parent.UI.Theme)

local CursorController = {}

local localPlayer = Players.LocalPlayer
local others = {} :: { [number]: any }

function CursorController:Init(controllers)
	self.C = controllers
end

local function circle(parent: Instance, size: number, z: number): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(size, size)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.ZIndex = z
	frame.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	return frame
end

local function userColor(userId: number): Color3
	return Color3.fromHSV((userId * 0.618034) % 1, 0.65, 1)
end

function CursorController:_build(overlay: Instance)
	local root = Instance.new("Frame")
	root.Name = "Cursor"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromOffset(48, 48)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 500
	root.Interactable = false
	root.Parent = overlay
	local ring = circle(root, 34, 501)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = ring
	local shadow = Instance.new("UIStroke")
	shadow.Thickness = 1
	shadow.Color = Theme.Color.Text.Outline
	shadow.Transparency = 0.3
	local inner = circle(root, 8, 502)
	inner.BackgroundTransparency = 0
	inner.BackgroundColor3 = Color3.new(1, 1, 1)
	shadow.Parent = inner
	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromOffset(28, 28)
	icon.Position = UDim2.fromOffset(34, 30)
	icon.FontFace = Theme.Font.UI
	icon.TextSize = 22
	icon.Text = ""
	icon.ZIndex = 503
	icon.Parent = root
	local scale = Instance.new("UIScale")
	scale.Parent = root
	self.root, self.ring, self.stroke, self.inner, self.icon, self.scale = root, ring, stroke, inner, icon, scale
end

function CursorController:Start()
	local overlay = self.C.UIController.overlay
	self:_build(overlay)
	local Input = self.C.InputController
	local State = self.C.State
	local remote = Net.unreliable("Cursor")

	remote.OnClientEvent:Connect(function(list)
		local now = os.clock()
		for _, entry in list do
			local userId, x, y, state, name = entry[1], entry[2], entry[3], entry[4], entry[5]
			if userId ~= localPlayer.UserId then
				local other = others[userId]
				if not other then
					local frame = Instance.new("Frame")
					frame.Name = "RemoteCursor"
					frame.BackgroundTransparency = 1
					frame.Size = UDim2.fromOffset(160, 50)
					frame.AnchorPoint = Vector2.new(0, 0)
					frame.Interactable = false
					frame.ZIndex = 400
					frame.Parent = overlay
					local dot = circle(frame, 22, 401)
					dot.Position = UDim2.fromOffset(0, 0)
					dot.AnchorPoint = Vector2.new(0.5, 0.5)
					local stroke = Instance.new("UIStroke")
					stroke.Thickness = 3
					stroke.Color = userColor(userId)
					stroke.Parent = dot
					local label = Instance.new("TextLabel")
					label.BackgroundColor3 = userColor(userId)
					label.Size = UDim2.fromOffset(0, 22)
					label.AutomaticSize = Enum.AutomaticSize.X
					label.Position = UDim2.fromOffset(14, 10)
					label.FontFace = Theme.Font.UI
					label.TextSize = 14
					label.TextColor3 = Theme.Color.Text.Inverse
					label.Text = "  " .. tostring(name) .. "  "
					label.ZIndex = 402
					label.Parent = frame
					local corner = Instance.new("UICorner")
					corner.CornerRadius = UDim.new(0, 8)
					corner.Parent = label
					other = {
						frame = frame,
						dot = dot,
						world = Vector3.new(x, y, 0),
						smooth = nil,
						seen = now,
						state = state,
					}
					others[userId] = other
				end
				other.world = Vector3.new(x, y, State.lab and State.lab.origin.Z or 0)
				other.seen = now
				other.state = state
			end
		end
	end)
	State.LabChanged:Connect(function(lab, previous)
		if previous and previous.ownerId ~= lab.ownerId then
			for userId, other in others do
				other.frame:Destroy()
				others[userId] = nil
			end
		end
	end)

	local sendTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local device = Input.device
		local showCustom = device ~= "touch" and not State.photoMode
		UserInputService.MouseIconEnabled = device == "touch"
		self.root.Visible = showCustom
		local pointer = Input.pointer
		self.root.Position = UDim2.fromOffset(pointer.X, pointer.Y)

		-- Context state.
		local Grab = self.C.GrabController
		local selection = State.selected
		local icon, color, size = "", Color3.new(1, 1, 1), 1
		if Grab.grabbing then
			icon, color, size = "✊", Theme.Color.Accent.Gold, 0.8
			self.inner.BackgroundColor3 = Theme.Color.Accent.Gold
		elseif Grab.hoverModel then
			icon, color, size = "✋", Theme.Color.Accent.Gold, 1.25
			self.inner.BackgroundColor3 = Color3.new(1, 1, 1)
		elseif selection then
			if selection.kind == "potion" then
				local potion = Potions.ById[selection.id]
				icon = if State.mode == "feed" then "🥄" else "🧪"
				color = if potion then potion.color else color
			elseif selection.kind == "golem" then
				icon = "🗿"
				color = Theme.Color.Accent.Cyan
			else
				local prop = PropsData.ById[selection.id]
				icon = if prop then prop.icon else "📦"
				color = Theme.Color.Accent.Cyan
			end
			self.inner.BackgroundColor3 = color
		else
			self.inner.BackgroundColor3 = Color3.new(1, 1, 1)
		end
		self.icon.Text = icon
		self.stroke.Color = color
		self.scale.Scale += (size - self.scale.Scale) * math.min(1, dt * 18)

		-- Remote cursors.
		local camera = Workspace.CurrentCamera
		local now = os.clock()
		for userId, other in others do
			if now - other.seen > 2 then
				other.frame:Destroy()
				others[userId] = nil
				continue
			end
			local screen, onScreen = camera:WorldToViewportPoint(other.world)
			local target = Vector2.new(screen.X, screen.Y)
			other.smooth = if other.smooth then other.smooth:Lerp(target, math.min(1, dt * 14)) else target
			other.frame.Visible = onScreen and not State.photoMode
			other.frame.Position = UDim2.fromOffset(other.smooth.X, other.smooth.Y)
			other.dot.BackgroundTransparency = if other.state == "grab" then 0.2 else 1
		end

		-- Stream own cursor (~12 Hz) while others are around.
		sendTimer -= dt
		if sendTimer <= 0 and State.lab and #State.lab.visitors > 1 then
			sendTimer = 1 / 12
			local plane = self.C.CameraController:ScreenToPlane(pointer)
			if plane then
				remote:FireServer(plane.X, plane.Y, if Grab.grabbing then "grab" else "")
			end
		end
	end)
end

return CursorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">GrabController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Grab & fling. Hover highlights grabbable objects; pressing on one asks the server for network
-- ownership, then a local AlignPosition drags the exact point you grabbed (so ragdolls dangle
-- naturally). Releasing keeps the object's momentum, boosted slightly, for a satisfying fling.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local GrabController = {
	grabbing = false,
	hoverModel = nil :: Model?,
	hoverPart = nil :: BasePart?,
	Grabbed = Signal.new(),
	Released = Signal.new(), -- (speed)
	InteractivePressed = Signal.new(), -- (kind)
}

local P = Config.Physics
local current = nil
local pending = nil
local highlight: Highlight
local fxFolder: Folder
local pointerPart: Part
local pointerAttachment: Attachment
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

function GrabController:Init(controllers)
	self.C = controllers
end

local function objectModel(part: Instance, dynamic: Instance): Model?
	local current = part
	while current and current.Parent ~= dynamic do
		current = current.Parent
		if current == nil or current == workspace then
			return nil
		end
	end
	if current and current:IsA("Model") then
		return current
	end
	return nil
end

-- Raycast under the pointer. Returns (hit part, owning model under Dynamic, interactive kind).
function GrabController:Pick(position: Vector2)
	local labModel = self.C.State:LabModel()
	if not labModel then
		return nil
	end
	local dynamic = labModel:FindFirstChild("Dynamic")
	local room = labModel:FindFirstChild("Room")
	if not dynamic or not room then
		return nil
	end
	rayParams.FilterDescendantsInstances = { dynamic, room }
	local ray = self.C.CameraController:Ray(position)
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 800, rayParams)
	if not result then
		return nil
	end
	local part = result.Instance
	local interactive = part:GetAttribute("Interactive")
	if interactive then
		return nil, nil, interactive, result
	end
	if part:IsDescendantOf(dynamic) then
		local model = objectModel(part, dynamic)
		if model and model:FindFirstChild("TrampolineFrame") then
			return nil
		end
		return part, model, nil, result
	end
	return nil, nil, nil, result
end

local function modelMass(model: Model): number
	local mass = 0
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.CanCollide and not part.Massless then
			mass += part:GetMass()
		end
	end
	return math.max(mass, 1)
end

function GrabController:_begin(part: BasePart, model: Model, worldPoint: Vector3)
	local attachment = Instance.new("Attachment")
	attachment.Name = "GrabPoint"
	attachment.WorldPosition = worldPoint
	attachment.Parent = part
	local align = Instance.new("AlignPosition")
	align.Name = "GrabAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.ApplyAtCenterOfMass = false
	align.MaxForce = modelMass(model) * P.GrabMaxForcePerMass * (Workspace.Gravity / 196.2)
	align.MaxVelocity = P.GrabMaxVelocity
	align.Responsiveness = P.GrabResponsiveness
	align.Position = worldPoint
	align.Parent = part
	local beam = Instance.new("Beam")
	beam.Attachment0 = pointerAttachment
	beam.Attachment1 = attachment
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 224, 120), Color3.fromRGB(255, 150, 60))
	beam.Width0 = 0.4
	beam.Width1 = 0.18
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Segments = 12
	beam.Transparency = NumberSequence.new(0.15, 0.35)
	beam.Parent = pointerPart
	current = {
		part = part,
		model = model,
		attachment = attachment,
		align = align,
		beam = beam,
		samples = {},
		started = os.clock(),
	}
	self.grabbing = true
	highlight.Adornee = model
	highlight.OutlineColor = Color3.fromRGB(255, 220, 120)
	highlight.FillTransparency = 0.8
	self.Grabbed:Fire(model)
	self.C.SoundController:Play("whoosh", worldPoint, { pitch = 1.5, volume = 0.5 })
end

function GrabController:TryGrab(position: Vector2): boolean
	self.lastPressConsumed = false
	if self.grabbing or pending then
		return false
	end
	local part, model, interactive, result = self:Pick(position)
	if interactive then
		self.lastPressConsumed = true
		self.InteractivePressed:Fire(interactive)
		return true
	end
	if not part or not model or not result then
		return false
	end
	self.lastPressConsumed = true
	local plane = self.C.CameraController:ScreenToPlane(position) or result.Position
	local worldPoint = Vector3.new(result.Position.X, result.Position.Y, part.Position.Z)
	local localOffset = part.CFrame:PointToObjectSpace(worldPoint)
	local token = {}
	pending = token
	local _ = plane
	task.spawn(function()
		local ok, granted = pcall(function()
			return Net.func("Grab"):InvokeServer(part, localOffset)
		end)
		if pending ~= token then
			return
		end
		pending = nil
		if ok and granted and part.Parent and self.C.InputController.primaryDown then
			self:_begin(part, model, part.CFrame:PointToWorldSpace(localOffset))
		elseif ok and granted then
			-- Released before the server answered: give it straight back.
			Net.event("GrabRelease"):FireServer()
		end
	end)
	return true
end

function GrabController:Release(cancelled: boolean?)
	pending = nil
	if not current then
		return
	end
	local grab = current
	current = nil
	self.grabbing = false
	local speed = 0
	if not cancelled and grab.part.Parent then
		-- Momentum from the drag, boosted for a satisfying fling.
		local samples = grab.samples
		local velocity = Vector3.zero
		if #samples >= 2 then
			local first, last = samples[1], samples[#samples]
			local dt = last.t - first.t
			if dt > 0.01 then
				velocity = (last.p - first.p) / dt
			end
		end
		speed = velocity.Magnitude
		local boost = P.FlingBoost
		for _, part in grab.model:GetDescendants() do
			if part:IsA("BasePart") and not part.Anchored and part.CanCollide then
				local v = part.AssemblyLinearVelocity
				local boosted = v * boost
				if boosted.Magnitude > P.MaxSpeed * 0.75 then
					boosted = boosted.Unit * P.MaxSpeed * 0.75
				end
				part.AssemblyLinearVelocity = Vector3.new(boosted.X, boosted.Y, 0)
			end
		end
		if speed > 70 then
			self.C.SoundController:Play(
				"whoosh",
				grab.part.Position,
				{ pitch = math.clamp(0.7 + speed / 400, 0.7, 1.4), volume = 1 }
			)
			self.C.CameraController:Punch(math.clamp(speed / 300, 0.1, 0.6))
		end
	end
	grab.align:Destroy()
	grab.attachment:Destroy()
	grab.beam:Destroy()
	if not cancelled then
		Net.event("GrabRelease"):FireServer()
	end
	self.Released:Fire(speed)
end

-- Server reclaimed the object (e.g. an explosion hit it).
function GrabController:ForceDrop()
	if current then
		self:Release(true)
	end
end

function GrabController:Start()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "GrabFX"
	fxFolder.Parent = Workspace
	highlight = Instance.new("Highlight")
	highlight.Name = "HoverHighlight"
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.OutlineTransparency = 0.15
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = fxFolder
	pointerPart = Instance.new("Part")
	pointerPart.Name = "Pointer"
	pointerPart.Anchored = true
	pointerPart.CanCollide = false
	pointerPart.CanQuery = false
	pointerPart.CanTouch = false
	pointerPart.Transparency = 1
	pointerPart.Size = Vector3.one * 0.2
	pointerPart.Parent = fxFolder
	pointerAttachment = Instance.new("Attachment")
	pointerAttachment.Parent = pointerPart

	local Input = self.C.InputController
	Input.PointerDown:Connect(function(button, position)
		if button == "primary" and not self.C.State.photoMode then
			self:TryGrab(position)
		end
	end)
	Input.PointerUp:Connect(function(button)
		if button == "primary" then
			self:Release(false)
		elseif button == "cancel" then
			self:Release(true)
			Net.event("GrabRelease"):FireServer()
		end
	end)
	self.C.State.LabChanged:Connect(function(lab, previous)
		if previous and previous.ownerId ~= lab.ownerId then
			self:ForceDrop()
		end
	end)

	local hoverTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local Camera = self.C.CameraController
		local planePoint = Camera:ScreenToPlane(Input.pointer)
		if planePoint then
			pointerPart.CFrame = CFrame.new(planePoint)
		end
		if current then
			if not current.part.Parent then
				self:Release(true)
				Net.event("GrabRelease"):FireServer()
				return
			end
			if planePoint then
				current.align.Position = Vector3.new(planePoint.X, planePoint.Y, current.part.Position.Z)
				local samples = current.samples
				local now = os.clock()
				table.insert(samples, { t = now, p = planePoint })
				while #samples > 2 and now - samples[1].t > 0.1 do
					table.remove(samples, 1)
				end
			end
			return
		end
		hoverTimer -= dt
		if hoverTimer > 0 then
			return
		end
		hoverTimer = 1 / 30
		if Input.device == "touch" then
			highlight.Adornee = nil
			return
		end
		local part, model = self:Pick(Input.pointer)
		self.hoverPart = part
		if model ~= self.hoverModel then
			self.hoverModel = model
			highlight.Adornee = model
			highlight.OutlineColor = Color3.new(1, 1, 1)
			highlight.FillTransparency = 0.88
		end
	end)
end

return GrabController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Unified input: one "pointer" for mouse, touch and gamepad (virtual cursor), keybinds mapped to
-- named actions, plus camera gestures (wheel, WASD, middle-drag, pinch, two-finger pan, sticks).

local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local InputController = {
	pointer = Vector2.new(400, 300),
	device = "mouse", -- "mouse" | "touch" | "gamepad"
	PointerDown = Signal.new(), -- (button: "primary"|"secondary", position)
	PointerUp = Signal.new(), -- (button, position)
	Tap = Signal.new(), -- (position) touch tap / gamepad X
	Action = Signal.new(), -- (actionName)
	DeviceChanged = Signal.new(),
	primaryDown = false,
	enabled = true,
}

local KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.G] = "slowmo",
	[Enum.KeyCode.Space] = "pause",
	[Enum.KeyCode.H] = "heal",
	[Enum.KeyCode.R] = "reset",
	[Enum.KeyCode.N] = "spawnLast",
	[Enum.KeyCode.Z] = "undo",
	[Enum.KeyCode.K] = "clearZombies",
	[Enum.KeyCode.B] = "brew",
	[Enum.KeyCode.C] = "codex",
	[Enum.KeyCode.J] = "challenges",
	[Enum.KeyCode.M] = "menu",
	[Enum.KeyCode.O] = "shop",
	[Enum.KeyCode.P] = "photo",
	[Enum.KeyCode.F1] = "help",
	[Enum.KeyCode.Q] = "mode",
	[Enum.KeyCode.F] = "follow",
	[Enum.KeyCode.Escape] = "back",
	[Enum.KeyCode.One] = "slot1",
	[Enum.KeyCode.Two] = "slot2",
	[Enum.KeyCode.Three] = "slot3",
	[Enum.KeyCode.Four] = "slot4",
	[Enum.KeyCode.Five] = "slot5",
	[Enum.KeyCode.Six] = "slot6",
	[Enum.KeyCode.Seven] = "slot7",
	[Enum.KeyCode.Eight] = "slot8",
	[Enum.KeyCode.Nine] = "slot9",
	[Enum.KeyCode.Zero] = "deselect",
	[Enum.KeyCode.ButtonY] = "mode",
	[Enum.KeyCode.ButtonL1] = "slotPrev",
	[Enum.KeyCode.ButtonR1] = "slotNext",
	[Enum.KeyCode.DPadUp] = "slowmo",
	[Enum.KeyCode.DPadDown] = "pause",
	[Enum.KeyCode.DPadLeft] = "heal",
	[Enum.KeyCode.DPadRight] = "spawnLast",
	[Enum.KeyCode.ButtonStart] = "menu",
	[Enum.KeyCode.ButtonSelect] = "help",
	[Enum.KeyCode.ButtonB] = "back",
}
InputController.Keys = KEYS

local PAN_KEYS = {
	[Enum.KeyCode.W] = Vector3.new(0, 1, 0),
	[Enum.KeyCode.Up] = Vector3.new(0, 1, 0),
	[Enum.KeyCode.S] = Vector3.new(0, -1, 0),
	[Enum.KeyCode.Down] = Vector3.new(0, -1, 0),
	[Enum.KeyCode.A] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.Left] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.D] = Vector3.new(1, 0, 0),
	[Enum.KeyCode.Right] = Vector3.new(1, 0, 0),
}

local touchStart: { position: Vector2, time: number, input: InputObject }? = nil
local activeTouches = 0
local middleDragging = false
local lastMiddle = Vector2.zero
local stickLeft, stickRight = Vector2.zero, Vector2.zero
local triggerZoom = 0

local function setDevice(self, device: string)
	if self.device ~= device then
		self.device = device
		self.DeviceChanged:Fire(device)
	end
end

local function insetPosition(position: Vector3 | Vector2): Vector2
	local inset = GuiService:GetGuiInset()
	return Vector2.new(position.X, position.Y) + inset
end

local function typing(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

function InputController:Init(controllers)
	self.C = controllers
end

function InputController:IsTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

function InputController:Start()
	if self:IsTouch() then
		self.device = "touch"
	end
	local Camera = self.C.CameraController

	UserInputService.InputBegan:Connect(function(input, processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			setDevice(self, "mouse")
			if processed or not self.enabled then
				return
			end
			local button = if t == Enum.UserInputType.MouseButton1 then "primary" else "secondary"
			if button == "primary" then
				self.primaryDown = true
			end
			self.PointerDown:Fire(button, self.pointer)
		elseif t == Enum.UserInputType.MouseButton3 then
			if not processed then
				middleDragging = true
				lastMiddle = UserInputService:GetMouseLocation()
			end
		elseif t == Enum.UserInputType.Touch then
			setDevice(self, "touch")
			activeTouches += 1
			if processed or not self.enabled then
				return
			end
			self.pointer = insetPosition(input.Position)
			if activeTouches == 1 then
				touchStart = { position = self.pointer, time = os.clock(), input = input }
				self.primaryDown = true
				self.PointerDown:Fire("primary", self.pointer)
			elseif self.primaryDown then
				-- Second finger: cancel the grab and treat as a camera gesture.
				self.primaryDown = false
				touchStart = nil
				self.PointerUp:Fire("cancel", self.pointer)
			end
		elseif t == Enum.UserInputType.Keyboard or t.Name:sub(1, 7) == "Gamepad" then
			if t.Name:sub(1, 7) == "Gamepad" then
				setDevice(self, "gamepad")
				if input.KeyCode == Enum.KeyCode.ButtonA and not processed then
					self.primaryDown = true
					self.PointerDown:Fire("primary", self.pointer)
					return
				elseif input.KeyCode == Enum.KeyCode.ButtonX and not processed then
					self.PointerDown:Fire("secondary", self.pointer)
					return
				end
			end
			if typing() then
				return
			end
			local action = KEYS[input.KeyCode]
			if action and (not processed or action == "back" or input.KeyCode == Enum.KeyCode.F1) then
				self.Action:Fire(action)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input, _processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			local button = if t == Enum.UserInputType.MouseButton1 then "primary" else "secondary"
			if button == "primary" then
				self.primaryDown = false
			end
			self.PointerUp:Fire(button, self.pointer)
		elseif t == Enum.UserInputType.MouseButton3 then
			middleDragging = false
		elseif t == Enum.UserInputType.Touch then
			activeTouches = math.max(0, activeTouches - 1)
			local start = touchStart
			if start and start.input == input then
				touchStart = nil
				local position = insetPosition(input.Position)
				local moved = (position - start.position).Magnitude
				local quick = os.clock() - start.time < 0.28
				self.primaryDown = false
				self.PointerUp:Fire("primary", position)
				if moved < 14 and quick then
					self.Tap:Fire(position)
				end
			end
		elseif input.KeyCode == Enum.KeyCode.ButtonA then
			self.primaryDown = false
			self.PointerUp:Fire("primary", self.pointer)
		end
	end)

	UserInputService.InputChanged:Connect(function(input, processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement then
			setDevice(self, "mouse")
			self.pointer = UserInputService:GetMouseLocation()
			if middleDragging then
				local now = self.pointer
				Camera:PanPixels(now - lastMiddle)
				lastMiddle = now
			end
		elseif t == Enum.UserInputType.MouseWheel then
			if not processed and self.enabled then
				Camera:ZoomAt(self.pointer, if input.Position.Z > 0 then 0.88 else 1.14)
			end
		elseif t == Enum.UserInputType.Touch then
			if touchStart and touchStart.input == input then
				self.pointer = insetPosition(input.Position)
			end
		elseif t == Enum.UserInputType.Gamepad1 then
			if input.KeyCode == Enum.KeyCode.Thumbstick1 then
				stickLeft = Vector2.new(input.Position.X, -input.Position.Y)
			elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
				stickRight = Vector2.new(input.Position.X, input.Position.Y)
			elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
				triggerZoom = -input.Position.Z
			elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
				triggerZoom = input.Position.Z
			end
		end
	end)

	UserInputService.TouchPinch:Connect(function(_positions, scale, _velocity, state, processed)
		if processed or not self.enabled then
			return
		end
		if state == Enum.UserInputState.Change then
			self._lastPinch = self._lastPinch or 1
			local factor = self._lastPinch / math.max(scale, 0.01)
			self._lastPinch = scale
			Camera:ZoomAt(nil, math.clamp(factor, 0.8, 1.25))
		else
			self._lastPinch = 1
		end
	end)
	UserInputService.TouchPan:Connect(function(positions, _total, velocity, state, processed)
		if processed or not self.enabled or #positions < 2 then
			return
		end
		if state == Enum.UserInputState.Change then
			Camera:PanPixels(velocity * (1 / 60))
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if typing() then
			return
		end
		-- Keyboard panning.
		local pan = Vector3.zero
		for key, dir in PAN_KEYS do
			if UserInputService:IsKeyDown(key) then
				pan += dir
			end
		end
		if pan.Magnitude > 0 then
			Camera:Pan(pan.Unit * Camera:Distance() * 0.9 * dt)
		end
		-- Gamepad virtual cursor and camera.
		if self.device == "gamepad" then
			if stickLeft.Magnitude > 0.15 then
				local viewport = workspace.CurrentCamera.ViewportSize
				local speed = 950 * dt * stickLeft.Magnitude
				local next = self.pointer + stickLeft.Unit * speed
				self.pointer = Vector2.new(math.clamp(next.X, 0, viewport.X), math.clamp(next.Y, 0, viewport.Y))
			end
			if stickRight.Magnitude > 0.15 then
				Camera:Pan(Vector3.new(stickRight.X, stickRight.Y, 0) * Camera:Distance() * 0.9 * dt)
			end
			if math.abs(triggerZoom) > 0.1 then
				Camera:ZoomAt(nil, 1 + triggerZoom * dt * 1.5)
			end
		end
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">LightingController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client-side lighting: each lab's mood preset (Lighting changes made by a LocalScript are local
-- to this player) plus post-processing and the slow-motion / pause color grades.

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Maps = require(Shared.Data.Maps)

local LightingController = {}

local atmosphere: Atmosphere
local bloom: BloomEffect
local grade: ColorCorrectionEffect
local timeGrade: ColorCorrectionEffect
local sunRays: SunRaysEffect
local dof: DepthOfFieldEffect

local TRANSITION = TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local function ensure(className: string, name: string, parent: Instance): any
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local created = Instance.new(className)
	created.Name = name
	created.Parent = parent
	return created
end

function LightingController:Init(controllers)
	self.C = controllers
end

function LightingController:Start()
	atmosphere = ensure("Atmosphere", "LabAtmosphere", Lighting)
	bloom = ensure("BloomEffect", "LabBloom", Lighting)
	grade = ensure("ColorCorrectionEffect", "LabGrade", Lighting)
	timeGrade = ensure("ColorCorrectionEffect", "TimeGrade", Lighting)
	sunRays = ensure("SunRaysEffect", "LabSunRays", Lighting)
	dof = ensure("DepthOfFieldEffect", "LabDepth", Lighting)
	dof.FarIntensity = 0.16
	dof.NearIntensity = 0
	dof.InFocusRadius = 42
	timeGrade.Saturation = 0
	timeGrade.Contrast = 0

	local State = self.C.State
	State.LabChanged:Connect(function(lab, previous)
		if not previous or previous.mapId ~= lab.mapId then
			self:Apply(Maps.get(lab.mapId).lighting, previous == nil)
		end
		self:_timeGrade(lab)
	end)
	State.Changed:Connect(function(key)
		if (key == "settings" or key == "*") and State.data then
			self:SetQuality(State.data.settings.quality or "high")
		end
	end)
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if camera and dof.Enabled then
			dof.FocusDistance = self.C.CameraController:Distance()
		end
	end)
end

function LightingController:Apply(preset, instant: boolean?)
	Lighting.ClockTime = preset.clockTime
	local function to(instance: Instance, goal: { [string]: any })
		if instant then
			for key, value in goal do
				(instance :: any)[key] = value
			end
		else
			TweenService:Create(instance, TRANSITION, goal):Play()
		end
	end
	to(Lighting, {
		Brightness = preset.brightness,
		Ambient = preset.ambient,
		OutdoorAmbient = preset.outdoorAmbient,
		ExposureCompensation = preset.exposure,
		FogColor = preset.fogColor,
	})
	to(atmosphere, {
		Density = preset.atmosphereDensity,
		Haze = preset.atmosphereHaze,
		Color = preset.atmosphereColor,
		Decay = preset.atmosphereDecay,
		Glare = 0.2,
		Offset = 0.25,
	})
	to(
		grade,
		{ TintColor = preset.tint, Saturation = preset.saturation, Contrast = preset.contrast, Brightness = 0.02 }
	)
	to(bloom, { Intensity = preset.bloomIntensity, Size = preset.bloomSize, Threshold = preset.bloomThreshold })
	to(sunRays, { Intensity = preset.sunRays, Spread = 0.6 })
end

function LightingController:_timeGrade(lab)
	local goal
	if lab.paused then
		goal = { Saturation = -0.75, Contrast = 0.12, TintColor = Color3.fromRGB(235, 235, 255), Brightness = -0.02 }
	elseif lab.slowmo then
		goal = { Saturation = -0.28, Contrast = 0.16, TintColor = Color3.fromRGB(215, 235, 255), Brightness = 0 }
	else
		goal = { Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1), Brightness = 0 }
	end
	TweenService:Create(timeGrade, TweenInfo.new(0.35, Enum.EasingStyle.Quad), goal):Play()
end

-- Brief global flash used by big explosions / reveals.
function LightingController:Flash(intensity: number)
	local base = grade.Brightness
	grade.Brightness = base + intensity
	TweenService:Create(grade, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Brightness = base }):Play()
end

function LightingController:SetQuality(quality: string)
	local high = quality ~= "low"
	dof.Enabled = high
	sunRays.Enabled = high
	bloom.Enabled = true
	Lighting.GlobalShadows = high
	self.quality = quality
end

return LightingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Sound design using only audio that ships with the Roblox client (verified against the client
-- manifest) — each base sample is pitch-shifted and layered into many cues. Optional music IDs
-- can be added in Config.MusicIds.

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local SoundController = {}

local SAMPLES = {
	explosion = "rbxasset://sounds/impact_explosion_03.mp3",
	splash = "rbxasset://sounds/impact_water.mp3",
	land = "rbxasset://sounds/action_jump_land.mp3",
	jump = "rbxasset://sounds/action_jump.mp3",
	getup = "rbxasset://sounds/action_get_up.mp3",
	wind = "rbxasset://sounds/action_falling.ogg",
	swim = "rbxasset://sounds/action_swim.mp3",
	step = "rbxasset://sounds/action_footsteps_plastic.mp3",
	oof = "rbxasset://sounds/oof.ogg",
	ouch = "rbxasset://sounds/ouch.ogg",
	tick = "rbxasset://sounds/volume_slider.ogg",
}

-- cue = list of layers {sample, volume, pitchMin, pitchMax, delay?}
local CUES = {
	hover = { { "tick", 0.1, 2.2, 2.4 } },
	click = { { "tick", 0.4, 1.3, 1.4 } },
	open = { { "getup", 0.22, 1.5, 1.6 }, { "tick", 0.2, 1.8, 1.8 } },
	close = { { "getup", 0.18, 1.9, 2 } },
	error = { { "land", 0.35, 0.55, 0.6 } },
	coin = { { "tick", 0.32, 2.6, 3 } },
	reward = { { "tick", 0.4, 1.6, 1.6 }, { "tick", 0.4, 2, 2, 0.08 }, { "tick", 0.45, 2.4, 2.4, 0.16 } },
	levelup = {
		{ "tick", 0.5, 1.2, 1.2 },
		{ "tick", 0.5, 1.5, 1.5, 0.1 },
		{ "tick", 0.5, 1.8, 1.8, 0.2 },
		{ "tick", 0.55, 2.4, 2.4, 0.3 },
		{ "getup", 0.3, 1.2, 1.2, 0.3 },
	},
	discover = {
		{ "swim", 0.5, 0.7, 0.7 },
		{ "tick", 0.45, 1.5, 1.5, 0.15 },
		{ "tick", 0.45, 2, 2, 0.3 },
		{ "tick", 0.5, 2.6, 2.6, 0.45 },
	},
	glass = { { "splash", 0.5, 1.5, 1.8 }, { "tick", 0.32, 2.7, 3.1 } },
	splash = { { "splash", 0.45, 0.85, 1.05 } },
	explosion = { { "explosion", 0.8, 0.85, 1.05 } },
	bigExplosion = { { "explosion", 1, 0.55, 0.65 }, { "land", 0.6, 0.4, 0.45 } },
	thud = { { "land", 0.5, 0.75, 1 } },
	whoosh = { { "getup", 0.35, 0.8, 1.15 } },
	throw = { { "getup", 0.28, 1.25, 1.45 } },
	pop = { { "tick", 0.5, 0.5, 0.6 }, { "jump", 0.35, 1.4, 1.6 } },
	boing = { { "jump", 0.5, 0.75, 0.95 } },
	zap = { { "explosion", 0.32, 2.3, 2.7 }, { "tick", 0.3, 3, 3.4 } },
	thunder = { { "explosion", 0.55, 0.42, 0.5 } },
	freeze = { { "splash", 0.35, 2, 2.3 }, { "tick", 0.3, 3, 3.2 } },
	sizzle = { { "splash", 0.3, 2.5, 2.8 } },
	fire = { { "wind", 0.25, 1.4, 1.6 } },
	bubble = { { "swim", 0.4, 0.55, 0.75 } },
	brew = { { "swim", 0.6, 0.45, 0.5 }, { "tick", 0.4, 2.2, 2.2, 0.25 }, { "tick", 0.4, 2.8, 2.8, 0.38 } },
	ouch = { { "ouch", 0.5, 0.95, 1.1 } },
	oof = { { "oof", 0.5, 0.9, 1.1 } },
	groan = { { "oof", 0.45, 0.45, 0.55 } },
	squeak = { { "ouch", 0.45, 1.8, 2.1 } },
	heal = { { "tick", 0.35, 1.8, 1.8 }, { "tick", 0.35, 2.3, 2.3, 0.1 }, { "swim", 0.25, 1.3, 1.3 } },
	magic = { { "tick", 0.35, 2.2, 2.2 }, { "tick", 0.35, 2.7, 2.7, 0.07 }, { "getup", 0.2, 1.8, 1.8 } },
	step = { { "step", 0.35, 0.9, 1.1 } },
	crack = { { "splash", 0.35, 2.6, 3 } },
	crush = { { "land", 0.7, 0.35, 0.45 }, { "explosion", 0.3, 1.4, 1.5 } },
	spawn = { { "getup", 0.3, 1.1, 1.2 }, { "tick", 0.3, 2.4, 2.4, 0.05 } },
}
SoundController.Cues = CUES

local groups = {}
local fxRoot: Folder
local recent = {} :: { [string]: { number } }
local volumes = { sfx = 0.8, music = 0.5 }

function SoundController:Init(controllers)
	self.C = controllers
end

local function group(name: string, volume: number): SoundGroup
	local g = SoundService:FindFirstChild(name) :: SoundGroup?
	if not g then
		local created = Instance.new("SoundGroup")
		created.Name = name
		created.Volume = volume
		created.Parent = SoundService
		g = created
	end
	return g :: SoundGroup
end

function SoundController:Start()
	groups.SFX = group("SFX", 0.8)
	groups.UI = group("UI", 0.8)
	groups.Ambience = group("Ambience", 0.6)
	groups.Music = group("Music", 0.5)
	fxRoot = Instance.new("Folder")
	fxRoot.Name = "ClientSounds"
	fxRoot.Parent = Workspace

	local State = self.C.State
	State.Changed:Connect(function(key)
		if (key == "settings" or key == "*") and State.data then
			volumes.sfx = State.data.settings.sfx or 0.8
			volumes.music = State.data.settings.music or 0.5
			groups.SFX.Volume = volumes.sfx
			groups.UI.Volume = volumes.sfx
			groups.Ambience.Volume = volumes.sfx * 0.8
			groups.Music.Volume = volumes.music
		end
	end)
	State.LabChanged:Connect(function(lab, previous)
		if not previous or previous.ownerId ~= lab.ownerId or previous.mapId ~= lab.mapId then
			self:_setAmbience(lab)
		end
	end)
	self:_startMusic()
end

local anchorPart: Part? = nil
local function positionedHost(position: Vector3): Attachment
	if not anchorPart then
		local part = Instance.new("Part")
		part.Name = "SoundAnchor"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.one
		part.CFrame = CFrame.new()
		part.Parent = fxRoot
		anchorPart = part
	end
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = anchorPart
	return attachment
end

local function throttled(cue: string): boolean
	local now = os.clock()
	local list = recent[cue]
	if not list then
		list = {}
		recent[cue] = list
	end
	for i = #list, 1, -1 do
		if now - list[i] > 0.15 then
			table.remove(list, i)
		end
	end
	if #list >= 6 then
		return true
	end
	table.insert(list, now)
	return false
end

-- Plays a cue. opts: {pitch = multiplier, volume = multiplier, ui = bool}
function SoundController:Play(cue: string, position: Vector3?, opts)
	local layers = CUES[cue]
	if not layers or throttled(cue) then
		return
	end
	opts = opts or {}
	local isUi = opts.ui == true or position == nil
	local timeScale = self.C.State:TimeScale()
	local slow = if not isUi and timeScale > 0 and timeScale < 1 then 0.62 else 1
	for _, layer in layers do
		local sample, volume, pMin, pMax, delay = layer[1], layer[2], layer[3], layer[4], layer[5]
		local function fire()
			local sound = Instance.new("Sound")
			sound.SoundId = SAMPLES[sample]
			sound.Volume = volume * (opts.volume or 1)
			sound.PlaybackSpeed = (pMin + math.random() * (pMax - pMin)) * (opts.pitch or 1) * slow
			sound.SoundGroup = if isUi then groups.UI else groups.SFX
			local host: Instance
			if position and not isUi then
				local attachment = positionedHost(position)
				sound.RollOffMode = Enum.RollOffMode.InverseTapered
				sound.RollOffMinDistance = 110
				sound.RollOffMaxDistance = 600
				host = attachment
				Debris:AddItem(attachment, 6)
			else
				host = groups.UI
			end
			sound.Parent = host
			sound:Play()
			Debris:AddItem(sound, 6)
		end
		if delay and delay > 0 then
			task.delay(delay, fire)
		else
			fire()
		end
	end
end

-- Cauldron bubbling and per-map ambient loops.
function SoundController:_setAmbience(lab)
	if self._ambient then
		for _, sound in self._ambient do
			sound:Destroy()
		end
	end
	self._ambient = {}
	local function loop(sample: string, position: Vector3?, volume: number, pitch: number)
		local sound = Instance.new("Sound")
		sound.SoundId = SAMPLES[sample]
		sound.Looped = true
		sound.Volume = volume
		sound.PlaybackSpeed = pitch
		sound.SoundGroup = groups.Ambience
		if position then
			local attachment = positionedHost(position)
			sound.RollOffMode = Enum.RollOffMode.InverseTapered
			sound.RollOffMinDistance = 60
			sound.RollOffMaxDistance = 400
			sound.Parent = attachment
			table.insert(self._ambient, attachment)
		else
			sound.Parent = groups.Ambience
		end
		sound:Play()
		table.insert(self._ambient, sound)
	end
	if lab.cauldron then
		loop("swim", lab.cauldron + Vector3.new(0, 6, 0), 0.28, 0.42)
	end
	if lab.mapId == "storm" or lab.mapId == "sky" then
		loop("wind", nil, 0.18, 0.55)
	elseif lab.mapId == "lava" then
		loop("swim", lab.origin, 0.2, 0.3)
	elseif lab.mapId == "frost" or lab.mapId == "void" then
		loop("wind", nil, 0.1, 0.4)
	end
end

function SoundController:_startMusic()
	local ids = Config.MusicIds
	if #ids == 0 then
		return
	end
	local index = 0
	local music = Instance.new("Sound")
	music.Name = "Music"
	music.SoundGroup = groups.Music
	music.Volume = 0.5
	music.Parent = groups.Music
	local function nextTrack()
		index = index % #ids + 1
		music.SoundId = ids[index]
		music:Play()
	end
	music.Ended:Connect(nextTrack)
	nextTrack()
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client-side store: the player's profile (replicated by DataService), the lab being viewed,
-- the active trial and pass ownership. UI and controllers subscribe to its signals.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Potions = require(Shared.Data.Potions)

local State = {
	data = nil :: any,
	lab = nil :: any,
	trial = nil :: any,
	passes = {} :: { [string]: boolean },
	ready = false,
	Ready = Signal.new(),
	Changed = Signal.new(), -- (key)
	LabChanged = Signal.new(), -- (state, previous)
	TrialChanged = Signal.new(), -- (phase, payload)
	Notified = Signal.new(), -- (kind, payload)
	selected = nil :: any, -- {kind, id}
	SelectionChanged = Signal.new(),
	mode = "throw",
	ModeChanged = Signal.new(),
	photoMode = false,
	PhotoModeChanged = Signal.new(),
}

function State:Init()
	Net.event("Data").OnClientEvent:Connect(function(kind, payload)
		if kind == "init" then
			self.data = payload
			if not self.ready then
				self.ready = true
				self.Ready:Fire()
			end
			self.Changed:Fire("*")
		elseif kind == "patch" and self.data then
			for key, value in payload do
				self.data[key] = value
				self.Changed:Fire(key)
			end
		end
	end)
	Net.event("Lab").OnClientEvent:Connect(function(labState)
		local previous = self.lab
		self.lab = labState
		self.LabChanged:Fire(labState, previous)
	end)
	Net.event("Trial").OnClientEvent:Connect(function(phase, payload)
		if phase == "start" then
			self.trial = payload
			self.trial.progress = 0
			self.trial.startedAt = os.clock()
		elseif phase == "progress" and self.trial then
			self.trial.progress = payload.progress
		elseif phase == "potions" and self.trial then
			self.trial.potions = payload.potions
		elseif phase == "end" then
			self.trial = nil
		end
		self.TrialChanged:Fire(phase, payload)
	end)
	Net.event("Notify").OnClientEvent:Connect(function(kind, payload)
		if kind == "passes" then
			self.passes = payload or {}
			self.Changed:Fire("passes")
		end
		self.Notified:Fire(kind, payload)
	end)
end

-- ─────────────────────────────── helpers ───────────────────────────────

function State:LabModel(): Model?
	local lab = self.lab
	if not lab then
		return nil
	end
	local labs = workspace:FindFirstChild("Labs")
	return labs and labs:FindFirstChild("Lab_" .. lab.ownerId) :: Model?
end

function State:IsMastered(potionId: string): boolean
	local data = self.data
	return data ~= nil and (data.brewCount[potionId] or 0) >= Config.Potions.MasteryBrews
end

-- Returns count (or -1 for infinite) of a potion usable right now (respects trials).
function State:PotionCount(potionId: string): number
	if self.trial and self.trial.potions and self.lab and self.lab.isOwner then
		for _, entry in self.trial.potions do
			if entry.id == potionId then
				return entry.count
			end
		end
		return 0
	end
	if self:IsMastered(potionId) then
		return -1
	end
	return (self.data and self.data.potions[potionId]) or 0
end

-- Potions shown on the hotbar: trial potions during a trial, else owned/mastered potions.
function State:HotbarPotions(): { string }
	local list = {}
	if self.trial and self.trial.potions and self.lab and self.lab.isOwner then
		for _, entry in self.trial.potions do
			table.insert(list, entry.id)
		end
		return list
	end
	if not self.data then
		return list
	end
	for _, potion in Potions.List do
		if self:PotionCount(potion.id) ~= 0 then
			table.insert(list, potion.id)
		end
	end
	return list
end

function State:Select(selection)
	self.selected = selection
	self.SelectionChanged:Fire(selection)
end

function State:SetMode(mode: string)
	self.mode = mode
	self.ModeChanged:Fire(mode)
end

function State:TimeScale(): number
	local lab = self.lab
	if not lab then
		return 1
	end
	if lab.paused then
		return 0
	end
	return lab.timeScale or 1
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Using the selected item: right-click (mouse), tap empty space (touch) or X (gamepad) throws or
-- feeds the selected potion, or places the selected golem/prop at the pointer.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Potions = require(Shared.Data.Potions)
local Signal = require(Shared.Util.Signal)

local ToolController = {
	Used = Signal.new(), -- (selection)
	lastUse = 0,
}

function ToolController:Init(controllers)
	self.C = controllers
end

function ToolController:Start()
	local Input = self.C.InputController
	local State = self.C.State
	Input.PointerDown:Connect(function(button, position)
		if button == "secondary" then
			self:Use(position)
		end
	end)
	Input.Tap:Connect(function(position)
		if not self.C.GrabController.lastPressConsumed then
			self:Use(position)
		end
	end)
	Input.Action:Connect(function(action)
		if action == "mode" then
			State:SetMode(if State.mode == "throw" then "feed" else "throw")
			self.C.SoundController:Play("click", nil, { pitch = if State.mode == "feed" then 0.8 else 1.2 })
		elseif action == "deselect" then
			State:Select(nil)
		end
	end)
end

function ToolController:Use(position: Vector2)
	local State = self.C.State
	local selection = State.selected
	if not selection or State.photoMode or not State.lab then
		return
	end
	local now = os.clock()
	if now - self.lastUse < Config.Potions.ThrowCooldown then
		return
	end
	local point = self.C.CameraController:ScreenToPlane(position)
	if not point then
		return
	end
	self.lastUse = now
	if selection.kind == "potion" then
		local potion = Potions.ById[selection.id]
		local count = State:PotionCount(selection.id)
		if not potion or count == 0 then
			self.C.SoundController:Play("error")
			self.C.UIController:Toast(
				"Out of " .. (if potion then potion.name else "that potion") .. "! Brew more at the cauldron.",
				"error"
			)
			return
		end
		local target = nil
		if State.mode == "feed" then
			local part, model = self.C.GrabController:Pick(position)
			if part and model and model:GetAttribute("GolemId") then
				target = part
			end
		end
		Net.event("Use"):FireServer({
			kind = "potion",
			id = selection.id,
			mode = State.mode,
			x = point.X,
			y = point.Y,
			target = target,
		})
		self.C.VFXController.Ring(point, 2.5, potion.color, 0.25)
	else
		Net.event("Use"):FireServer({ kind = selection.kind, id = selection.id, x = point.X, y = point.Y })
		self.C.SoundController:Play("spawn", point)
	end
	self.Used:Fire(selection)
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Client-side visual effects. The server sends compact FX events; this module turns them into
-- particles, rings, flashes, debris, lightning, floating text, camera shake and sound. It also
-- renders thrown bottles, meteors, black holes, tornadoes and stasis bubbles locally so they move
-- perfectly smoothly.

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Potions = require(Shared.Data.Potions)
local Reactions = require(Shared.Data.Reactions)
local PotionModel = require(Shared.Visual.PotionModel)

local VFXController = {
	HudEvent = Signal.new(), -- (kind, payload) for chaos meter / coin pops
}

local TEX = {
	fire = "rbxasset://textures/particles/fire_main.dds",
	sparks = "rbxasset://textures/particles/fire_sparks_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	core = "rbxasset://textures/particles/explosion01_core_main.dds",
	expSmoke = "rbxasset://textures/particles/explosion01_smoke_main.dds",
	circle = "rbxasset://textures/whiteCircle.png",
	square = "rbxasset://textures/particles/SquareParticle.png",
}

local fxRoot: Folder
local C -- controllers
local projectiles = {}
local meteors = {}
local blackholes = {}
local tornadoes = {}
local stasisBubbles = {}

local function seq(...): NumberSequence
	local points = { ... }
	local keypoints = {}
	for i = 1, #points, 2 do
		table.insert(keypoints, NumberSequenceKeypoint.new(points[i], points[i + 1]))
	end
	return NumberSequence.new(keypoints)
end

local function rand(a: number, b: number): number
	return a + math.random() * (b - a)
end

local function quality(): number
	local lighting = C and C.LightingController
	return if lighting and lighting.quality == "low" then 0.5 else 1
end

-- ─────────────────────────────── primitives ───────────────────────────────

local function hostPart(position: Vector3, size: Vector3?): Part
	local part = Instance.new("Part")
	part.Name = "Fx"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = size or Vector3.one
	part.CFrame = CFrame.new(position)
	part.Parent = fxRoot
	return part
end

-- One-shot particle burst. preset fields mirror ParticleEmitter properties.
local function burst(position: Vector3, count: number, props: { [string]: any }, hostSize: Vector3?)
	local host = hostPart(position, hostSize)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Texture = TEX.sparkle
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 1
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.TimeScale = math.max(C.State:TimeScale(), 0.05)
	emitter.Parent = host
	emitter:Emit(math.max(1, math.floor(count * quality())))
	Debris:AddItem(host, (emitter.Lifetime.Max or 1) + 1.5)
	return host
end

local function sparkles(position: Vector3, color: Color3, count: number, speed: number?)
	burst(position, count, {
		Texture = TEX.sparkle,
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new((speed or 14) * 0.5, speed or 14),
		Size = seq(0, 0.9, 1, 0),
		Color = ColorSequence.new(color),
		Drag = 3,
	})
end

local function smoke(position: Vector3, color: Color3, count: number, size: number?)
	burst(position, count, {
		Texture = TEX.smoke,
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(3, 9),
		Size = seq(0, (size or 2) * 0.6, 1, (size or 2) * 2.2),
		Transparency = seq(0, 0.35, 1, 1),
		Color = ColorSequence.new(color),
		LightEmission = 0,
		Drag = 2,
		Acceleration = Vector3.new(0, 3, 0),
		RotSpeed = NumberRange.new(-40, 40),
		Rotation = NumberRange.new(0, 360),
	})
end

local function droplets(position: Vector3, color: Color3, count: number, speed: number?)
	burst(position, count, {
		Texture = TEX.circle,
		Lifetime = NumberRange.new(0.45, 0.9),
		Speed = NumberRange.new((speed or 30) * 0.4, speed or 30),
		SpreadAngle = Vector2.new(75, 75),
		EmissionDirection = Enum.NormalId.Top,
		Size = seq(0, 0.55, 1, 0.1),
		Color = ColorSequence.new(color),
		LightEmission = 0.5,
		Acceleration = Vector3.new(0, -120, 0),
	})
end

local function sparks(position: Vector3, color: Color3, count: number, speed: number?)
	burst(position, count, {
		Texture = TEX.sparks,
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new((speed or 40) * 0.5, speed or 40),
		Size = seq(0, 0.45, 1, 0),
		Color = ColorSequence.new(color),
		Acceleration = Vector3.new(0, -60, 0),
		Drag = 1,
	})
end

-- Expanding ring facing the camera (or flat on the floor).
local function ring(position: Vector3, radius: number, color: Color3, duration: number, flat: boolean?)
	local part = Instance.new("Part")
	part.Name = "FxRing"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.15
	local rotation = if flat then CFrame.Angles(0, 0, math.rad(90)) else CFrame.Angles(0, math.rad(90), 0)
	part.Size = Vector3.new(0.2, 1, 1)
	part.CFrame = CFrame.new(position) * rotation
	part.Parent = fxRoot
	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, duration + 0.1)
	return part
end

local function flash(position: Vector3, color: Color3, range: number, brightness: number, duration: number)
	local host = hostPart(position)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = host
	TweenService:Create(light, TweenInfo.new(duration, Enum.EasingStyle.Quad), { Brightness = 0 }):Play()
	Debris:AddItem(host, duration + 0.1)
end

local function orb(
	position: Vector3,
	fromSize: number,
	toSize: number,
	color: Color3,
	duration: number,
	material: Enum.Material?
)
	local part = Instance.new("Part")
	part.Name = "FxOrb"
	part.Shape = Enum.PartType.Ball
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = material or Enum.Material.Neon
	part.Color = color
	part.Size = Vector3.one * fromSize
	part.CFrame = CFrame.new(position)
	part.Parent = fxRoot
	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.one * toSize,
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, duration + 0.1)
	return part
end

-- Client-simulated debris chunks (glass shards, clay bits, wood splinters, coins).
local function debris(position: Vector3, color: Color3, count: number, speed: number, opts)
	opts = opts or {}
	count = math.floor(count * quality())
	for _ = 1, count do
		local part = Instance.new("Part")
		part.Name = "FxDebris"
		local s = rand(opts.minSize or 0.25, opts.maxSize or 0.6)
		part.Size = if opts.shape == "coin"
			then Vector3.new(0.12, 0.7, 0.7)
			else Vector3.new(s, s * rand(0.5, 1.2), s * rand(0.3, 1))
		if opts.shape == "coin" then
			part.Shape = Enum.PartType.Cylinder
		end
		part.Color = color
		part.Material = opts.material or Enum.Material.SmoothPlastic
		part.Transparency = opts.transparency or 0
		part.Reflectance = opts.reflectance or 0
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.CollisionGroup = "Debris"
		part.CFrame = CFrame.new(position + Vector3.new(rand(-0.5, 0.5), rand(-0.5, 0.5), rand(0, 1)))
			* CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6))
		part.AssemblyLinearVelocity = Vector3.new(rand(-1, 1), rand(0.2, 1.3), rand(0, 0.35)).Unit
			* speed
			* rand(0.5, 1)
		part.AssemblyAngularVelocity = Vector3.new(rand(-12, 12), rand(-12, 12), rand(-12, 12))
		part.Parent = fxRoot
		local life = rand(1.2, 2)
		task.delay(life - 0.4, function()
			if part.Parent then
				TweenService:Create(part, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
		end)
		Debris:AddItem(part, life)
	end
end

local function floatText(
	position: Vector3,
	text: string,
	color: Color3,
	size: number?,
	rise: number?,
	duration: number?,
	font: Font?
)
	local host = hostPart(position)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 80)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.StudsOffsetWorldSpace = Vector3.zero
	gui.MaxDistance = 1000
	gui.Parent = host
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size or 30
	label.FontFace = font or Font.new("rbxasset://fonts/families/LuckiestGuy.json")
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(20, 10, 30)
	stroke.Thickness = 2.5
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = label
	local d = duration or 0.9
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	TweenService:Create(
		gui,
		TweenInfo.new(d, Enum.EasingStyle.Quad),
		{ StudsOffsetWorldSpace = Vector3.new(rand(-0.6, 0.6), rise or 4, 0) }
	):Play()
	task.delay(d * 0.6, function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(d * 0.4), { TextTransparency = 1 }):Play()
			TweenService:Create(stroke, TweenInfo.new(d * 0.4), { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(host, d + 0.1)
end

-- Jagged lightning bolt from a to b (neon segments, flickers then fades).
local function bolt(a: Vector3, b: Vector3, color: Color3, width: number?)
	local model = Instance.new("Model")
	model.Name = "FxBolt"
	local segments = math.clamp(math.floor((b - a).Magnitude / 3.5), 4, 14)
	local points = { a }
	local dir = b - a
	local perp = Vector3.new(-dir.Y, dir.X, 0)
	perp = if perp.Magnitude > 0.01 then perp.Unit else Vector3.xAxis
	for i = 1, segments - 1 do
		local t = i / segments
		local jitter = (dir.Magnitude / segments) * 0.6
		table.insert(points, a + dir * t + perp * rand(-jitter, jitter) + Vector3.new(0, 0, rand(0.5, 1.2)))
	end
	table.insert(points, b)
	local parts = {}
	for i = 1, #points - 1 do
		local p0, p1 = points[i], points[i + 1]
		local len = (p1 - p0).Magnitude
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = color
		part.Size = Vector3.new(width or 0.32, width or 0.32, len)
		part.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
		part.Parent = model
		table.insert(parts, part)
	end
	model.Parent = fxRoot
	flash(b, color, 26, 6, 0.35)
	task.spawn(function()
		for flicker = 1, 3 do
			for _, part in parts do
				part.Transparency = if flicker % 2 == 0 then 0.7 else 0
			end
			task.wait(0.05)
		end
		for _, part in parts do
			TweenService
				:Create(part, TweenInfo.new(0.18), { Transparency = 1, Size = Vector3.new(0.05, 0.05, part.Size.Z) })
				:Play()
		end
	end)
	Debris:AddItem(model, 0.5)
end

local function shake(amount: number, position: Vector3?)
	C.CameraController:Shake(amount, position)
end

local function play(cue: string, position: Vector3?, opts)
	C.SoundController:Play(cue, position, opts)
end

local function potionColor(id: string?): Color3
	local potion = id and Potions.ById[id]
	return if potion then potion.color else Color3.fromRGB(200, 200, 255)
end

local function findGolem(id: number): Model?
	local labModel = C.State:LabModel()
	local dynamic = labModel and labModel:FindFirstChild("Dynamic")
	if not dynamic then
		return nil
	end
	for _, child in dynamic:GetChildren() do
		if child:GetAttribute("GolemId") == id then
			return child :: Model
		end
	end
	return nil
end

-- ─────────────────────────────── composite effects ───────────────────────────────

local function explosion(p: Vector3, radius: number, color: Color3, big: boolean?)
	local scale = math.clamp(radius / 16, 0.5, 3)
	orb(p, 2, radius * 0.9, Color3.fromRGB(255, 240, 200), 0.18)
	orb(p, 3, radius * 0.75, color, 0.42)
	ring(p, radius * 1.15, color, 0.45)
	if big then
		ring(p, radius * 1.6, Color3.fromRGB(255, 255, 255), 0.7)
		C.UIController:ScreenFlash(Color3.fromRGB(255, 250, 230), 0.25, 0.6)
		C.LightingController:Flash(0.35)
	end
	burst(p, 18, {
		Texture = TEX.core,
		Lifetime = NumberRange.new(0.3, 0.55),
		Speed = NumberRange.new(4, 14 * scale),
		Size = seq(0, 3 * scale, 1, 6 * scale),
		Transparency = seq(0, 0, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), color),
		Drag = 4,
	})
	smoke(p, Color3.fromRGB(70, 60, 64), 14, 2.4 * scale)
	sparks(p, Color3.fromRGB(255, 200, 90), 30, 55 * scale)
	debris(p, Color3.fromRGB(60, 50, 50), 8, 45 * scale, { material = Enum.Material.Slate })
	flash(p, color, radius * 3, 9, 0.5)
	shake(math.clamp(0.25 + scale * 0.22, 0.25, 1), p)
	C.CameraController:Punch(scale * 0.9)
	play(if big or radius > 25 then "bigExplosion" else "explosion", p)
end

local function splash(p: Vector3, color: Color3, normal: Vector3?)
	local _ = normal
	droplets(p, color, 26, 34)
	sparkles(p, color:Lerp(Color3.new(1, 1, 1), 0.4), 10, 16)
	ring(p, 6, color, 0.35)
	debris(
		p,
		Color3.fromRGB(220, 240, 255),
		7,
		30,
		{ material = Enum.Material.Glass, transparency = 0.35, reflectance = 0.2, minSize = 0.15, maxSize = 0.4 }
	)
	flash(p, color, 18, 4, 0.35)
	burst(p, 6, {
		Texture = TEX.glow,
		Lifetime = NumberRange.new(0.25, 0.4),
		Speed = NumberRange.new(0, 1),
		Size = seq(0, 3, 1, 8),
		Transparency = seq(0, 0.3, 1, 1),
		Color = ColorSequence.new(color),
	})
	shake(0.12, p)
	play("glass", p)
end

local function clayChunks(p: Vector3, color: Color3, strength: number)
	debris(
		p,
		color,
		math.floor(2 + strength * 4),
		18 + strength * 30,
		{ material = Enum.Material.Concrete, minSize = 0.2, maxSize = 0.5 }
	)
end

-- ─────────────────────────────── handlers ───────────────────────────────

local H = {}

H.throw = function(d)
	local potion = Potions.ById[d.pid]
	if not potion then
		return
	end
	local model = PotionModel.build(potion, 1.15)
	model.Parent = fxRoot
	local glass = model.PrimaryPart
	if glass then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.5, 0)
		a0.Parent = glass
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.5, 0)
		a1.Parent = glass
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.25
		trail.Color = ColorSequence.new(potion.color)
		trail.LightEmission = 0.8
		trail.Transparency = seq(0, 0.2, 1, 1)
		trail.FaceCamera = true
		trail.Parent = glass
		local light = Instance.new("PointLight")
		light.Color = potion.color
		light.Range = 9
		light.Brightness = 1.5
		light.Parent = glass
	end
	projectiles[d.id] =
		{ model = model, o = d.o, v = d.v, g = d.g, t = 0, spin = rand(-14, -8) * (if d.v.X < 0 then -1 else 1) }
	play("throw", d.o)
end

H.shatter = function(d)
	local projectile = projectiles[d.id]
	if projectile then
		projectile.model:Destroy()
		projectiles[d.id] = nil
	end
	splash(d.p, potionColor(d.pid), d.n)
end

H.feed = function(d)
	local potion = Potions.ById[d.pid]
	local golem = findGolem(d.golem)
	local head = golem and golem:FindFirstChild("Head") :: BasePart?
	if not potion or not head then
		return
	end
	local model = PotionModel.build(potion, 1.3)
	model.Parent = fxRoot
	local start = head.Position + Vector3.new(0, 5, 2)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - t0) / 0.55
		if t >= 1 or not head.Parent then
			conn:Disconnect()
			model:Destroy()
			droplets(head.Position + Vector3.new(0, 0.6, 1), potion.color, 10, 10)
			sparkles(head.Position, potion.color, 12, 10)
			play("bubble", head.Position, { pitch = 1.4 })
			return
		end
		local target = head.Position + Vector3.new(0.4, 2.2, 1.4)
		local pos = start:Lerp(target, 1 - (1 - t) ^ 3)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(150 * t)))
	end)
end

H.explode = function(d)
	explosion(d.p, d.r or 16, d.c or Color3.fromRGB(255, 150, 60), d.big)
end

H.lightning = function(d)
	bolt(d.a, d.b, d.c or Color3.fromRGB(170, 220, 255), 0.36)
	bolt(d.a, d.b, Color3.fromRGB(255, 255, 255), 0.14)
	sparkles(d.b, d.c or Color3.fromRGB(170, 220, 255), 16, 22)
	shake(0.18, d.b)
	play("zap", d.b)
	play("thunder", d.b)
end

H.impact = function(d)
	local s = d.s or 0.5
	burst(d.p, math.floor(3 + s * 6), {
		Texture = TEX.smoke,
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(2, 6 + s * 8),
		Size = seq(0, 0.8 + s, 1, 2 + s * 2),
		Transparency = seq(0, 0.45, 1, 1),
		Color = ColorSequence.new(Color3.fromRGB(200, 180, 170)),
		LightEmission = 0,
		Drag = 3,
	})
	if s > 0.55 then
		clayChunks(d.p, d.c or Color3.fromRGB(200, 120, 80), s)
		shake(math.min(0.08 + s * 0.15, 0.4), d.p)
	end
	play("thud", d.p, { pitch = math.clamp(1.25 - s * 0.4, 0.6, 1.3), volume = math.clamp(0.4 + s, 0.4, 1.2) })
	if s > 0.8 and math.random() < 0.5 then
		play(if math.random() < 0.5 then "ouch" else "oof", d.p)
	end
end

H.dmg = function(d)
	local amount = d.a or 0
	local color = Color3.fromRGB(255, 255, 255)
	if d.k == "burn" or d.k == "lava" then
		color = Color3.fromRGB(255, 150, 60)
	elseif d.k == "shock" then
		color = Color3.fromRGB(140, 220, 255)
	elseif d.k == "blast" or d.k == "crush" then
		color = Color3.fromRGB(255, 90, 90)
	elseif d.k == "acid" or d.k == "bite" or d.k == "stink" then
		color = Color3.fromRGB(170, 255, 80)
	elseif d.k == "void" then
		color = Color3.fromRGB(200, 140, 255)
	end
	local size = math.clamp(22 + amount * 0.35, 22, 46)
	floatText(d.p + Vector3.new(rand(-1, 1), 2.5, 2), "-" .. tostring(amount), color, size, 4, 0.8)
end

H.reform = function(d)
	sparkles(d.p, d.c or Color3.fromRGB(120, 230, 255), 24, 18)
	ring(d.p, 8, d.c or Color3.fromRGB(120, 230, 255), 0.4)
	play("magic", d.p)
end
H.spawn = function(d)
	sparkles(d.p, d.c or Color3.fromRGB(255, 230, 160), 20, 16)
	ring(d.p - Vector3.new(0, 4, 0), 6, d.c or Color3.fromRGB(255, 230, 160), 0.35, true)
	smoke(d.p - Vector3.new(0, 3.5, 0), Color3.fromRGB(230, 220, 240), 6, 1.5)
	play("spawn", d.p)
end
H.poof = function(d)
	smoke(d.p, Color3.fromRGB(230, 225, 240), 12, 2)
	sparkles(d.p, Color3.fromRGB(255, 255, 255), 10, 12)
	play("pop", d.p)
end
