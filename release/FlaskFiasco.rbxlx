		joint = rgb(150, 100, 60),
		material = Enum.Material.Fabric,
		accent = rgb(255, 150, 60),
		eye = rgb(40, 30, 20),
		pupil = rgb(40, 30, 20),
		density = 0.45,
		friction = 0.7,
		elasticity = 0.05,
		traits = { flammable = true },
		source = "shop",
		price = 300,
		accessory = "strawhat",
		order = 2,
	},
	{
		id = "snow",
		name = "Snow Golem",
		rarity = "Uncommon",
		body = rgb(245, 250, 255),
		limb = rgb(235, 242, 250),
		joint = rgb(210, 225, 240),
		material = Enum.Material.Snow,
		accent = rgb(120, 200, 255),
		eye = rgb(25, 25, 35),
		pupil = rgb(25, 25, 35),
		density = 0.7,
		friction = 0.35,
		elasticity = 0.05,
		traits = { frostproof = true, melts = true },
		source = "shop",
		price = 600,
		accessory = "carrot",
		order = 3,
	},
	{
		id = "moss",
		name = "Mossy Golem",
		rarity = "Uncommon",
		body = rgb(90, 140, 70),
		limb = rgb(110, 120, 90),
		joint = rgb(70, 90, 60),
		material = Enum.Material.LeafyGrass,
		accent = rgb(180, 255, 120),
		eye = rgb(255, 255, 220),
