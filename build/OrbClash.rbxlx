        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">GachaDefinitions</string>
            <string name="Source"><![CDATA[--!strict
-- Store crates. The Flyer crates copy the prices and odds shown in the reference store
-- screenshot exactly (CONFIRMED). Orb/Explosion/Event crate prices are (TUNABLE).
local BallDefinitions = require(script.Parent.BallDefinitions)
local CosmeticDefinitions = require(script.Parent.CosmeticDefinitions)

export type ItemKind = string -- "Ball" | "Explosion" | "Flyer"

export type PoolItem = { Kind: ItemKind, Id: string, Rarity: string }

export type Crate = {
	Id: string,
	Tab: string, -- "Events" | "Balls" | "Explosions" | "Flyers"
	DisplayName: string,
	Kind: string, -- ItemKind or "Mixed"
	Currency: string, -- "Coins" | "Gems"
	Price: number,
	Odds: { [string]: number }?, -- rarity -> percent (for rarity crates)
	Items: { { Kind: ItemKind, Id: string, Weight: number } }?, -- explicit weights (event crate)
	Art: string, -- client art key
	Theme: string, -- "Coins" | "Gems" | "Event"
	EndsAt: number?, -- unix seconds (event)
	TicketOnly: boolean?,
}

local Crates: { Crate } = {
	{
		Id = "OrbGacha",
		Tab = "Balls",
		DisplayName = "Orb Gacha",
		Kind = "Ball",
		Currency = "Coins",
		Price = 600,
		Odds = { Uncommon = 50, Rare = 32, Epic = 14, Legendary = 4 },
		Art = "Machine",
		Theme = "Coins",
	},
	{
		Id = "AdvancedOrbGacha",
		Tab = "Balls",
		DisplayName = "Advanced Orb Gacha",
		Kind = "Ball",
		Currency = "Gems",
		Price = 100,
		Odds = { Rare = 62, Epic = 27, Legendary = 9, Mythic = 2 },
		Art = "MachineAdvanced",
		Theme = "Gems",
	},
	{
		Id = "CoinsExplosionCrate",
		Tab = "Explosions",
		DisplayName = "Coins Explosion Crate",
		Kind = "Explosion",
		Currency = "Coins",
		Price = 1000,
		Odds = { Uncommon = 87, Rare = 10, Epic = 2.5, Legendary = 0.5 },
		Art = "CrateExplosion",
		Theme = "Coins",
	},
	{
		Id = "GemsExplosionCrate",
		Tab = "Explosions",
		DisplayName = "Gems Explosion Crate",
		Kind = "Explosion",
		Currency = "Gems",
		Price = 100,
		Odds = { Rare = 79, Epic = 18, Legendary = 3 },
		Art = "CrateExplosion",
		Theme = "Gems",
	},
	{
		Id = "CoinsFlyerCrate",
		Tab = "Flyers",
		DisplayName = "Coins Flyer Crate",
		Kind = "Flyer",
		Currency = "Coins",
		Price = 1000,
		Odds = { Uncommon = 87, Rare = 10, Epic = 2.5, Legendary = 0.5 },
		Art = "CrateFlyer",
		Theme = "Coins",
	},
	{
		Id = "GemsFlyerCrate",
		Tab = "Flyers",
		DisplayName = "Gems Flyer Crate",
		Kind = "Flyer",
		Currency = "Gems",
		Price = 100,
		Odds = { Rare = 79, Epic = 18, Legendary = 3 },
		Art = "CrateFlyer",
		Theme = "Gems",
	},
	{
		Id = "HarvestCrate",
		Tab = "Events",
		DisplayName = "Harvest Moon Crate",
		Kind = "Mixed",
		Currency = "Gems",
		Price = 120,
		Items = {
			{ Kind = "Ball", Id = "jack", Weight = 6 },
			{ Kind = "Flyer", Id = "broom", Weight = 24 },
			{ Kind = "Explosion", Id = "pumpkinpop", Weight = 70 },
		},
		Art = "CrateEvent",
		Theme = "Event",
		EndsAt = 1793491200, -- 2026-11-01 00:00:00 UTC
	},
}

local ById: { [string]: Crate } = {}
for _, crate in Crates do
	ById[crate.Id] = crate
end

local GachaDefinitions = {}

GachaDefinitions.Tabs = { "Events", "Balls", "Explosions", "Flyers" }

function GachaDefinitions.Get(id: string): Crate?
	return ById[id]
end

function GachaDefinitions.All(): { Crate }
	return Crates
end

function GachaDefinitions.ForTab(tab: string): { Crate }
	local out = {}
	for _, crate in Crates do
		if crate.Tab == tab then
			table.insert(out, crate)
		end
	end
	return out
end

function GachaDefinitions.IsActive(crate: Crate, now: number): boolean
	return crate.EndsAt == nil or now < crate.EndsAt
end

-- All items a crate can produce, with their rarity (used for prize previews and rolls).
function GachaDefinitions.Pool(crate: Crate): { PoolItem }
	local out: { PoolItem } = {}
	if crate.Items then
		for _, item in crate.Items do
			local rarity = "Uncommon"
			if item.Kind == "Ball" then
				local def = BallDefinitions.Get(item.Id)
				rarity = def and def.Rarity or rarity
			else
				local def = CosmeticDefinitions.Get(item.Kind, item.Id)
				rarity = def and def.Rarity or rarity
			end
			table.insert(out, { Kind = item.Kind, Id = item.Id, Rarity = rarity })
		end
		return out
	end
	local odds = crate.Odds or {}
	if crate.Kind == "Ball" then
		for _, def in BallDefinitions.All() do
			if odds[def.Rarity] and table.find(def.Obtain, crate.Id) then
				table.insert(out, { Kind = "Ball", Id = def.Id, Rarity = def.Rarity })
			end
		end
	elseif crate.Kind == "Explosion" or crate.Kind == "Flyer" then
		for _, def in CosmeticDefinitions.All(crate.Kind) do
			if odds[def.Rarity] and not def.Default and def.Event == nil then
				table.insert(out, { Kind = def.Kind :: string, Id = def.Id, Rarity = def.Rarity })
			end
		end
	end
	return out
end

return GachaDefinitions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">LevelRewards</string>
            <string name="Source"><![CDATA[--!strict
-- Level-up rewards. Reference shows "Lv 3 Reward: <ball>" (CONFIRMED that levels grant orbs).
export type Reward = { Kind: "Ball" | "Ticket" | "Coins" | "Gems", Id: string?, Amount: number? }

local Explicit: { [number]: Reward } = {
	[2] = { Kind = "Ticket", Id = "OrbGacha", Amount = 1 },
	[3] = { Kind = "Ball", Id = "sunny" },
	[4] = { Kind = "Coins", Amount = 300 },
	[5] = { Kind = "Ball", Id = "spring" },
	[6] = { Kind = "Ticket", Id = "OrbGacha", Amount = 1 },
	[7] = { Kind = "Gems", Amount = 25 },
	[8] = { Kind = "Ball", Id = "titan" },
	[10] = { Kind = "Ticket", Id = "AdvancedOrbGacha", Amount = 1 },
}

local LevelRewards = {}

function LevelRewards.For(level: number): Reward
	local explicit = Explicit[level]
	if explicit then
		return explicit
	end
	if level % 5 == 0 then
		return { Kind = "Ticket", Id = "AdvancedOrbGacha", Amount = 1 }
	end
	return { Kind = "Ticket", Id = "OrbGacha", Amount = 1 }
end

return LevelRewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">QuestDefinitions</string>
            <string name="Source"><![CDATA[--!strict
-- Daily quests (CONFIRMED in the reference HUD: "Duel with a friend 0/1", "Win 3 times 1/3",
-- "Play 10 times 1/10", each paying x200 coins). Reset time is (LIKELY) daily at 00:00 UTC.
export type Quest = {
	Id: string,
	Title: string,
	Goal: number,
	Event: "FriendDuel" | "Win" | "Play",
	Reward: { Coins: number },
}

local QuestDefinitions = {}

QuestDefinitions.Daily = {
	{ Id = "friendDuel", Title = "Duel with a friend", Goal = 1, Event = "FriendDuel", Reward = { Coins = 200 } },
	{ Id = "win3", Title = "Win 3 times", Goal = 3, Event = "Win", Reward = { Coins = 200 } },
	{ Id = "play10", Title = "Play 10 times", Goal = 10, Event = "Play", Reward = { Coins = 200 } },
} :: { Quest }

function QuestDefinitions.DayIndex(unixTime: number): number
	return unixTime // 86400
end

function QuestDefinitions.Get(id: string): Quest?
	for _, q in QuestDefinitions.Daily do
		if q.Id == id then
			return q
		end
	end
	return nil
end

return QuestDefinitions
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Net</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Single source of truth for every network endpoint. The server creates the instances
-- (Remotes.Init), clients wait for them (Remotes.Get). Clients can only *request*: there is
-- no remote that grants currency, deals damage or decides results.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Spec: { [string]: "RemoteEvent" | "RemoteFunction" | "UnreliableRemoteEvent" } = {
	-- client -> server requests
	QueueRequest = "RemoteEvent", -- (action: "Play"|"Leave"|"Practice", mode?)
	InviteRequest = "RemoteEvent", -- (targetUserId)
	InviteResponse = "RemoteEvent", -- (inviteId, accept)
	SelectionRequest = "RemoteEvent", -- (action: "Pick"|"Reroll"|"Collection", arg)
	AimUpdate = "UnreliableRemoteEvent", -- (angle) live aim, low rate
	AimLock = "RemoteEvent", -- (angle)
	TradeRequest = "RemoteEvent", -- (action, ...)
	StoreRequest = "RemoteFunction", -- (action, args) -> result

	-- server -> client
	PlayerData = "RemoteEvent", -- full sanitized profile view
	Notify = "RemoteEvent", -- toast { Text, Kind }
	StationState = "RemoteEvent", -- public station/match summary (broadcast)
	MatchPrivate = "RemoteEvent", -- participant-only phase payloads
	MatchPublic = "RemoteEvent", -- phase changes / round results for participants + spectators
	BattleEvent = "RemoteEvent", -- batched simulation events
	BattleSnapshot = "UnreliableRemoteEvent", -- binary 20 Hz snapshots
	TradeState = "RemoteEvent",
	InviteReceived = "RemoteEvent",
	LeaderboardData = "RemoteEvent",
	RewardPopup = "RemoteEvent", -- modal rewards (first battle, level up, weekly)
	OpenUI = "RemoteEvent", -- server asks client to open a screen (e.g. prompts)
}

local Remotes = {}
Remotes.Spec = Spec

local FOLDER_NAME = "Remotes"

function Remotes.Init()
	assert(RunService:IsServer(), "Remotes.Init is server-only")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for name, className in Spec do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
	end
end

function Remotes.Event(name: string): RemoteEvent
	assert(Spec[name] == "RemoteEvent", "not a RemoteEvent: " .. name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Unreliable(name: string): UnreliableRemoteEvent
	assert(Spec[name] == "UnreliableRemoteEvent", "not an UnreliableRemoteEvent: " .. name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: UnreliableRemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	assert(Spec[name] == "RemoteFunction", "not a RemoteFunction: " .. name)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SnapshotCodec</string>
            <string name="Source"><![CDATA[--!strict
-- Compact binary encoding of battle snapshots (sent over UnreliableRemoteEvent, which caps
-- payloads near 900 bytes). Layout:
--   u8  stationIndex
--   u16 sequence
--   f32 simTime
--   u8  ballCount, then per ball:   u8 id, i16 x, i16 y, u16 hp, u8 radius*20, u8 flags
--   u8  entityCount, then per ent:  u16 id, i16 x, i16 y, u8 rotation, u8 scale*20
-- Positions are quantised to 1/2000 stud (range +-16 studs).
local SnapshotCodec = {}

local POS_SCALE = 2000
local POS_LIMIT = 32767
local BALL_BYTES = 9
local ENT_BYTES = 8
local HEADER_BYTES = 1 + 2 + 4 + 1 + 1

SnapshotCodec.Flags = {
	Frozen = 1,
	Snared = 2,
	Phased = 4,
	Slowed = 8,
	Charging = 16,
	Latched = 32,
	Invulnerable = 64,
	Dead = 128,
}

export type BallState = { id: number, x: number, y: number, hp: number, r: number, flags: number }
export type EntityState = { id: number, x: number, y: number, rot: number, scale: number }
export type Snapshot = {
	station: number,
	seq: number,
	time: number,
	balls: { BallState },
	entities: { EntityState },
}

local function qpos(v: number): number
	return math.clamp(math.floor(v * POS_SCALE + 0.5), -POS_LIMIT, POS_LIMIT)
end

local function qbyte(v: number): number
	return math.clamp(math.floor(v + 0.5), 0, 255)
end

function SnapshotCodec.Encode(s: Snapshot): buffer
	local ballCount = math.min(#s.balls, 255)
	local entCount = math.min(#s.entities, 255)
	local b = buffer.create(HEADER_BYTES + ballCount * BALL_BYTES + entCount * ENT_BYTES)
	local o = 0
	buffer.writeu8(b, o, s.station)
	o += 1
	buffer.writeu16(b, o, s.seq % 65536)
	o += 2
	buffer.writef32(b, o, s.time)
	o += 4
	buffer.writeu8(b, o, ballCount)
	o += 1
	for i = 1, ballCount do
		local ball = s.balls[i]
		buffer.writeu8(b, o, ball.id % 256)
		buffer.writei16(b, o + 1, qpos(ball.x))
		buffer.writei16(b, o + 3, qpos(ball.y))
		buffer.writeu16(b, o + 5, math.clamp(math.ceil(ball.hp), 0, 65535))
		buffer.writeu8(b, o + 7, qbyte(ball.r * 20))
		buffer.writeu8(b, o + 8, ball.flags % 256)
		o += BALL_BYTES
	end
	buffer.writeu8(b, o, entCount)
	o += 1
	for i = 1, entCount do
		local e = s.entities[i]
		buffer.writeu16(b, o, e.id % 65536)
		buffer.writei16(b, o + 2, qpos(e.x))
		buffer.writei16(b, o + 4, qpos(e.y))
		buffer.writeu8(b, o + 6, math.floor(((e.rot % (2 * math.pi)) / (2 * math.pi)) * 256) % 256)
		buffer.writeu8(b, o + 7, qbyte(e.scale * 20))
		o += ENT_BYTES
	end
	return b
end

function SnapshotCodec.Decode(b: buffer): Snapshot?
	local len = buffer.len(b)
	if len < HEADER_BYTES then
		return nil
	end
	local o = 0
	local station = buffer.readu8(b, o)
	o += 1
	local seq = buffer.readu16(b, o)
	o += 2
	local time = buffer.readf32(b, o)
	o += 4
	local ballCount = buffer.readu8(b, o)
	o += 1
	if len < o + ballCount * BALL_BYTES + 1 then
		return nil
	end
	local balls: { BallState } = table.create(ballCount)
	for _ = 1, ballCount do
		table.insert(balls, {
			id = buffer.readu8(b, o),
			x = buffer.readi16(b, o + 1) / POS_SCALE,
			y = buffer.readi16(b, o + 3) / POS_SCALE,
			hp = buffer.readu16(b, o + 5),
			r = buffer.readu8(b, o + 7) / 20,
			flags = buffer.readu8(b, o + 8),
		})
		o += BALL_BYTES
	end
	local entCount = buffer.readu8(b, o)
	o += 1
	if len < o + entCount * ENT_BYTES then
		return nil
	end
	local entities: { EntityState } = table.create(entCount)
	for _ = 1, entCount do
		table.insert(entities, {
			id = buffer.readu16(b, o),
			x = buffer.readi16(b, o + 2) / POS_SCALE,
			y = buffer.readi16(b, o + 4) / POS_SCALE,
			rot = buffer.readu8(b, o + 6) / 256 * 2 * math.pi,
			scale = buffer.readu8(b, o + 7) / 20,
		})
		o += ENT_BYTES
	end
	return { station = station, seq = seq, time = time, balls = balls, entities = entities }
end

SnapshotCodec.MaxBytes = function(balls: number, entities: number): number
	return HEADER_BYTES + balls * BALL_BYTES + entities * ENT_BYTES
end

return SnapshotCodec
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number / time formatting helpers shared by UI and server messages.
local Format = {}

function Format.Commas(n: number): string
	local s = tostring(math.floor(n))
	local negative = string.sub(s, 1, 1) == "-"
	if negative then
		s = string.sub(s, 2)
	end
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (negative and "-" or "") .. out
end

-- 1234 -> "1.2K", 1500000 -> "1.5M"
function Format.Short(n: number): string
	local abs = math.abs(n)
	if abs < 10000 then
		return tostring(math.floor(n))
	end
	local values = { 1e12, 1e9, 1e6, 1e3 }
	local suffixes = { "T", "B", "M", "K" }
	for i, unit in values do
		if abs >= unit then
			local v = n / unit
			local str = if math.abs(v) >= 100 then string.format("%d", v) else string.format("%.1f", v)
			str = string.gsub(str, "%.0$", "")
			return str .. suffixes[i]
		end
	end
	return tostring(n)
end

-- seconds -> "13d 1h", "1h 16m", "4m 05s", "12s"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local d = seconds // 86400
	local h = (seconds % 86400) // 3600
	local m = (seconds % 3600) // 60
	local sec = seconds % 60
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, sec)
	end
	return string.format("%ds", sec)
end

function Format.Percent(p: number): string
	if p == math.floor(p) then
		return string.format("%.2f%%", p)
	end
	return string.format("%.2f%%", p)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
-- Maid: collects connections, instances, threads and cleanup callbacks and releases them together.
export type Task = RBXScriptConnection | Instance | thread | () -> () | { Destroy: (any) -> () }

local Maid = {}
Maid.__index = Maid

export type Maid = typeof(setmetatable({} :: { _tasks: { [any]: Task? } }, Maid))

function Maid.new(): Maid
	return setmetatable({ _tasks = {} :: { [any]: Task? } }, Maid)
end

local function cleanup(task: any)
	local kind = typeof(task)
	if kind == "RBXScriptConnection" then
		task:Disconnect()
	elseif kind == "Instance" then
		task:Destroy()
	elseif kind == "thread" then
		if coroutine.status(task) ~= "dead" then
			pcall(task.cancel, task)
		end
	elseif kind == "function" then
		task()
	elseif kind == "table" and type(task.Destroy) == "function" then
		task:Destroy()
	end
end

function Maid.Give<T>(self: Maid, task: T): T
	table.insert(self._tasks, task :: any)
	return task
end

function Maid.Set(self: Maid, key: string, task: Task?)
	local old = self._tasks[key]
	if old ~= nil and old ~= task then
		self._tasks[key] = nil
		cleanup(old)
	end
	self._tasks[key] = task
end

function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}
	for _, task in tasks do
		cleanup(task)
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic PRNG (xorshift32 with a splitmix-style seed scramble).
-- Pure Luau: identical results on server, client and the headless test runner.
local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { _state: number }, Rng))

local function scramble(seed: number): number
	local x = bit32.bxor(math.floor(seed) % 4294967296, 0x9E3779B9)
	x = bit32.bxor(x, bit32.rshift(x, 16))
	x = (x * 0x45D9F3B) % 4294967296
	x = bit32.bxor(x, bit32.rshift(x, 16))
	if x == 0 then
		x = 0x6D2B79F5
	end
	return x
end

function Rng.new(seed: number): Rng
	return setmetatable({ _state = scramble(seed) }, Rng)
end

function Rng.NextUInt(self: Rng): number
	local x = self._state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self._state = x
	return x
end

-- Uniform float in [0, 1)
function Rng.Next(self: Rng): number
	return self:NextUInt() / 4294967296
end

function Rng.Range(self: Rng, min: number, max: number): number
	return min + (max - min) * self:Next()
end

-- Uniform integer in [min, max]
function Rng.Int(self: Rng, min: number, max: number): number
	return min + math.floor(self:Next() * (max - min + 1))
end

function Rng.Chance(self: Rng, p: number): boolean
	return self:Next() < p
end

function Rng.Pick<T>(self: Rng, list: { T }): T
	return list[self:Int(1, #list)]
end

-- Weighted pick over { {value, weight} } style list via accessor.
function Rng.Weighted<T>(self: Rng, items: { T }, weightOf: (T) -> number): T?
	local total = 0
	for _, item in items do
		total += math.max(0, weightOf(item))
	end
	if total <= 0 then
		return nil
	end
	local roll = self:Next() * total
	for _, item in items do
		roll -= math.max(0, weightOf(item))
		if roll < 0 then
			return item
		end
	end
	return items[#items]
end

function Rng.Shuffle<T>(self: Rng, list: { T }): { T }
	for i = #list, 2, -1 do
		local j = self:Int(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Lightweight synchronous signal (no Roblox instances; usable in headless tests).
export type Connection = { Connected: boolean, Disconnect: (Connection) -> () }

local Signal = {}
Signal.__index = Signal

type Listener = { fn: (...any) -> (), conn: Connection }

export type Signal = typeof(setmetatable({} :: { _listeners: { Listener } }, Signal))

function Signal.new(): Signal
	return setmetatable({ _listeners = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	local listeners = self._listeners
	local conn: Connection
	conn = {
		Connected = true,
		Disconnect = function(c: Connection)
			if not c.Connected then
				return
			end
			c.Connected = false
			for i, l in listeners do
				if l.conn == c then
					table.remove(listeners, i)
					break
				end
			end
		end,
	}
	table.insert(listeners, { fn = fn, conn = conn })
	return conn
end

function Signal.Once(self: Signal, fn: (...any) -> ()): Connection
	local conn: Connection
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal.Fire(self: Signal, ...: any)
	-- Snapshot so listeners may disconnect while firing.
	local snapshot = table.clone(self._listeners)
	for _, l in snapshot do
		if l.conn.Connected then
			l.fn(...)
		end
	end
end

function Signal.DisconnectAll(self: Signal)
	for _, l in self._listeners do
		l.conn.Connected = false
	end
	table.clear(self._listeners)
end

Signal.Destroy = Signal.DisconnectAll

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime validators for untrusted remote arguments. Every server remote handler uses these.
local Validate = {}

function Validate.String(v: any, maxLen: number?): boolean
	return type(v) == "string" and #v <= (maxLen or 64) and utf8.len(v) ~= nil
end

function Validate.Id(v: any): boolean
	-- identifiers are short lowercase/uppercase alnum strings
	return type(v) == "string" and #v >= 1 and #v <= 40 and string.match(v, "^[%w_%-]+$") ~= nil
end

function Validate.Number(v: any, min: number?, max: number?): boolean
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return false
	end
	if min and v < min then
		return false
	end
	if max and v > max then
		return false
	end
	return true
end

function Validate.Integer(v: any, min: number?, max: number?): boolean
	return Validate.Number(v, min, max) and math.floor(v) == v
end

function Validate.OneOf(v: any, options: { string }): boolean
	if type(v) ~= "string" then
		return false
	end
	return table.find(options, v) ~= nil
end

function Validate.Boolean(v: any): boolean
	return type(v) == "boolean"
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Visual</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ArenaGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Shared arena measurements (studs) used by the server builder, the simulation and the
-- client camera/renderer, so all three always agree. Station local space:
--   origin = centre of the arena interior, +X = viewer's right, +Y = up, +Z = toward viewer.
-- Proportions were measured from the reference battle screenshot (see docs/RESEARCH.md §D).
export type PadSpec = { Team: number, X: number }

export type ArenaKind = {
	Half: number, -- interior half-extent (simulation bounds)
	Frame: number, -- frame thickness
	FrontZ: number, -- front face of the frame
	BackZ: number, -- inner face of the back wall
	PlaneZ: number, -- plane the orbs move in
	BaseHeight: number, -- floor to arena centre
	LedgeDrop: number, -- arena centre to ledge top (players' feet)
	LedgeInner: number, -- ledge inner x edge
	LedgeOuter: number, -- ledge outer x edge
	LedgeDepth: { number }, -- z range {back, front}
	Pads: { PadSpec },
}

local ArenaGeometry = {}

ArenaGeometry.Kinds = {
	Duel = {
		Half = 8,
		Frame = 1,
		FrontZ = 1.2,
		BackZ = -3.3,
		PlaneZ = -1.0,
		BaseHeight = 9,
		LedgeDrop = 4.8,
		LedgeInner = 9,
		LedgeOuter = 16,
		LedgeDepth = { -3.5, 4.5 },
		Pads = { { Team = 1, X = -12.5 }, { Team = 2, X = 12.5 } },
	},
	Team = {
		Half = 10,
		Frame = 1,
		FrontZ = 1.2,
		BackZ = -3.3,
		PlaneZ = -1.0,
		BaseHeight = 11,
		LedgeDrop = 4.8,
		LedgeInner = 11,
		LedgeOuter = 23,
		LedgeDepth = { -3.5, 4.5 },
		Pads = { { Team = 1, X = -14.2 }, { Team = 1, X = -19.6 }, { Team = 2, X = 14.2 }, { Team = 2, X = 19.6 } },
	},
} :: { [string]: ArenaKind }

function ArenaGeometry.Get(kind: string): ArenaKind
	return ArenaGeometry.Kinds[kind] or ArenaGeometry.Kinds.Duel
end

function ArenaGeometry.KindForMode(mode: string): string
	return if mode == "2v2" then "Team" else "Duel"
end

-- Station centre CFrame from a config floor position + yaw (degrees).
function ArenaGeometry.StationCFrame(floor: { number }, yaw: number, kind: string): CFrame
	local k = ArenaGeometry.Get(kind)
	return CFrame.new(floor[1], floor[2] + k.BaseHeight, floor[3]) * CFrame.Angles(0, math.rad(yaw), 0)
end

function ArenaGeometry.SimToWorld(station: CFrame, kind: string, x: number, y: number, zOffset: number?): Vector3
	local k = ArenaGeometry.Get(kind)
	return station:PointToWorldSpace(Vector3.new(x, y, k.PlaneZ + (zOffset or 0)))
end

-- Where a participant's character stands (HumanoidRootPart CFrame), facing the viewer.
function ArenaGeometry.PadCFrame(station: CFrame, kind: string, padIndex: number): CFrame
	local k = ArenaGeometry.Get(kind)
	local pad = k.Pads[padIndex]
	local feetY = -k.LedgeDrop
	return station * CFrame.new(pad.X, feetY + 3, 0.6) * CFrame.Angles(0, math.pi, 0)
end

-- Where a player is released after leaving the pad (in front of the station on the floor).
function ArenaGeometry.ReleaseCFrame(station: CFrame, kind: string, padIndex: number): CFrame
	local k = ArenaGeometry.Get(kind)
	local pad = k.Pads[padIndex]
	return station * CFrame.new(pad.X * 0.8, -k.BaseHeight + 3.2, 9) * CFrame.Angles(0, math.pi, 0)
end

-- Battle camera: front-on, fits the arena (and the players' ledges on wide screens).
function ArenaGeometry.CameraCFrame(station: CFrame, kind: string, aspect: number, verticalFov: number): CFrame
	local k = ArenaGeometry.Get(kind)
	local tanHalf = math.tan(math.rad(verticalFov) / 2)
	local needHalfH = k.Half + k.Frame + 0.7
	local needHalfW = if aspect >= 1.45 then k.LedgeOuter + 1 else k.Half + k.Frame + 0.8
	local dist = math.max(needHalfH / tanHalf, needHalfW / (tanHalf * aspect))
	local eye = station:PointToWorldSpace(Vector3.new(0, 0.2, k.FrontZ + dist))
	local target = station:PointToWorldSpace(Vector3.new(0, 0.2, k.PlaneZ))
	return CFrame.lookAt(eye, target)
end

return ArenaGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PropFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Builds every lobby prop from plain parts (no uploaded meshes or textures), so the same
-- models serve the server-built lobby and client-side ViewportFrame icons.
-- All models have their pivot at the base centre and face local +Z.
local Lobby = require(script.Parent.Parent.Config.Lobby)
local Rng = require(script.Parent.Parent.Util.Rng)

local PropFactory = {}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

type PartProps = {
	Name: string?,
	Shape: Enum.PartType?,
	Size: Vector3,
	CFrame: CFrame,
	Color: string | Color3,
	Material: Enum.Material?,
	Transparency: number?,
	Reflectance: number?,
	CanCollide: boolean?,
	CastShadow: boolean?,
	Class: string?,
}

function PropFactory.Part(parent: Instance, p: PartProps): BasePart
	local part: BasePart
	if p.Class == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif p.Class == "CornerWedgePart" then
		part = Instance.new("CornerWedgePart")
	else
		local basic = Instance.new("Part")
		basic.Shape = p.Shape or Enum.PartType.Block
		part = basic
	end
	part.Name = p.Name or "Part"
	part.Size = p.Size
	part.CFrame = p.CFrame
	part.Color = if typeof(p.Color) == "Color3" then p.Color :: Color3 else hex(p.Color :: string)
	part.Material = p.Material or Enum.Material.SmoothPlastic
	part.Transparency = p.Transparency or 0
	part.Reflectance = p.Reflectance or 0
	part.Anchored = true
	part.CanCollide = if p.CanCollide == nil then true else p.CanCollide
	part.CastShadow = if p.CastShadow == nil then true else p.CastShadow
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end
local P = PropFactory.Part

-- Cylinder whose axis points along world/local Y.
local function upright(cf: CFrame): CFrame
	return cf * CFrame.Angles(0, 0, math.rad(90))
end
PropFactory.Upright = upright

function PropFactory.Model(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	return model
end

local ORB_COLORS = { "#FF8A1F", "#5B6CFF", "#6EDB3A", "#FF7BD5", "#FFD23F", "#3BC6B5", "#D7263D", "#9D4DFF", "#7FE9FF", "#E9EBF0" }

local function finish(model: Model, base: BasePart): Model
	model.PrimaryPart = base
	return model
end

---------------------------------------------------------------------------- Gacha machine
function PropFactory.GachaMachine(advanced: boolean?): Model
	local m = PropFactory.Model(if advanced then "AdvancedMachine" else "GachaMachine")
	local body = if advanced then "#6A2BD6" else "#D8262E"
	local trim = "#FFC53D"
	local base = P(m, { Name = "Base", Size = Vector3.new(8, 6, 8), CFrame = CFrame.new(0, 3.3, 0), Color = body })
	P(m, { Name = "Foot", Size = Vector3.new(8.6, 0.6, 8.6), CFrame = CFrame.new(0, 0.3, 0), Color = "#24262C" })
	P(m, { Name = "TopTrim", Size = Vector3.new(8.6, 0.6, 8.6), CFrame = CFrame.new(0, 6.6, 0), Color = trim, Material = Enum.Material.Metal })
	P(m, { Name = "Stripe", Size = Vector3.new(8.05, 0.5, 8.05), CFrame = CFrame.new(0, 4.6, 0), Color = "#FFFFFF" })
	P(m, { Name = "Glow", Size = Vector3.new(8.1, 0.2, 8.1), CFrame = CFrame.new(0, 0.75, 0), Color = if advanced then "#D9B3FF" else "#FF6B7F", Material = Enum.Material.Neon })
	-- glass dome with orbs inside
	local dome = P(m, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(7.4, 7.4, 7.4), CFrame = CFrame.new(0, 10.4, 0), Color = "#DDEEFF", Material = Enum.Material.Glass, Transparency = 0.55, CanCollide = false })
	dome.CastShadow = false
	local rng = Rng.new(if advanced then 77 else 31)
	for i = 1, 18 do
		local a = rng:Range(0, 2 * math.pi)
		local rr = rng:Range(0, 2.4)
		local y = 8.6 + rng:Range(0, 2.6) + (if i > 12 then 0.8 else 0)
		local d = rng:Range(1.1, 1.5)
		P(m, {
			Name = "Capsule",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(d, d, d),
			CFrame = CFrame.new(math.cos(a) * rr, y, math.sin(a) * rr),
			Color = ORB_COLORS[(i - 1) % #ORB_COLORS + 1],
			Reflectance = 0.05,
			CanCollide = false,
		})
	end
	P(m, { Name = "Cap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 3.2, 3.2), CFrame = upright(CFrame.new(0, 14.1, 0)), Color = trim, Material = Enum.Material.Metal })
	P(m, { Name = "CapBall", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(0, 15, 0), Color = body })
	-- front controls (+Z)
	P(m, { Name = "Knob", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.7, 2.4, 2.4), CFrame = CFrame.new(0, 4, 4.3) * CFrame.Angles(0, math.rad(90), 0), Color = "#D9DCE1", Material = Enum.Material.Metal })
	P(m, { Name = "Handle", Size = Vector3.new(2.2, 0.45, 0.4), CFrame = CFrame.new(0, 4, 4.75), Color = "#9CA2AB", Material = Enum.Material.Metal })
	P(m, { Name = "Chute", Size = Vector3.new(2.6, 1.6, 0.4), CFrame = CFrame.new(0, 1.8, 4.1), Color = "#1A1B20" })
	P(m, { Name = "Slot", Size = Vector3.new(0.3, 0.9, 0.2), CFrame = CFrame.new(2.6, 4, 4.05), Color = "#1A1B20" })
	return finish(m, base)
end

---------------------------------------------------------------------------- Crates / boxes
function PropFactory.Crate(theme: string?): Model
	local m = PropFactory.Model("Crate")
	local cardboard = "#C8915A"
	local base = P(m, { Name = "Box", Size = Vector3.new(4, 3.4, 4), CFrame = CFrame.new(0, 1.7, 0), Color = cardboard, Material = Enum.Material.Cardboard })
	P(m, { Name = "Tape", Size = Vector3.new(4.05, 0.6, 0.6), CFrame = CFrame.new(0, 2.4, 2.0), Color = "#E9E2D0" })
	-- open flaps
	P(m, { Name = "FlapL", Size = Vector3.new(2, 0.15, 4), CFrame = CFrame.new(-2.6, 3.7, 0) * CFrame.Angles(0, 0, math.rad(35)), Color = "#B98250", Material = Enum.Material.Cardboard })
	P(m, { Name = "FlapR", Size = Vector3.new(2, 0.15, 4), CFrame = CFrame.new(2.6, 3.7, 0) * CFrame.Angles(0, 0, math.rad(-35)), Color = "#B98250", Material = Enum.Material.Cardboard })
	P(m, { Name = "FlapB", Size = Vector3.new(4, 0.15, 2), CFrame = CFrame.new(0, 3.7, -2.6) * CFrame.Angles(math.rad(-35), 0, 0), Color = "#B98250", Material = Enum.Material.Cardboard })
	local rng = Rng.new(5)
	for i = 1, 6 do
		local d = rng:Range(0.9, 1.4)
		P(m, {
			Name = "Prize",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(d, d, d),
			CFrame = CFrame.new(rng:Range(-1.2, 1.2), 3.4 + rng:Range(0, 0.8), rng:Range(-1.2, 1.2)),
			Color = ORB_COLORS[i],
			CanCollide = false,
		})
	end
	if theme == "Flyer" then
		PropFactory.SaucerInto(m, CFrame.new(0.6, 5.6, -0.4) * CFrame.Angles(math.rad(-12), 0, math.rad(8)), 0.45)
	elseif theme == "Explosion" then
		local star = PropFactory.Model("Burst")
		for k = 1, 6 do
			P(star, { Name = "Ray", Size = Vector3.new(0.5, 2.6, 0.5), CFrame = CFrame.new(0, 5.4, 0) * CFrame.Angles(0, 0, math.rad(k * 30)), Color = if k % 2 == 0 then "#FF8C1A" else "#FFE14D", Material = Enum.Material.Neon, CanCollide = false })
		end
		star.Parent = m
	elseif theme == "Event" then
		P(m, { Name = "Pumpkin", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 1.7, 2), CFrame = CFrame.new(0, 4.4, 0), Color = "#FF8C1A", CanCollide = false })
		P(m, { Name = "Stem", Size = Vector3.new(0.3, 0.6, 0.3), CFrame = CFrame.new(0, 5.4, 0), Color = "#3E8E1E", CanCollide = false })
	end
	return finish(m, base)
end

function PropFactory.InventoryBox(): Model
	local m = PropFactory.Model("InventoryBox")
	local base = P(m, { Name = "Box", Size = Vector3.new(4, 3, 4), CFrame = CFrame.new(0, 1.5, 0), Color = "#E8E8EE" })
	P(m, { Name = "Lid", Size = Vector3.new(4.3, 0.7, 4.3), CFrame = CFrame.new(0, 3.2, 0), Color = "#F5F6FA" })
	P(m, { Name = "Strap", Size = Vector3.new(0.7, 3.6, 4.35), CFrame = CFrame.new(0, 1.85, 0), Color = "#9CA2AB" })
	return finish(m, base)
end

---------------------------------------------------------------------------- Saucer (flyer)
function PropFactory.SaucerInto(parent: Instance, cf: CFrame, scale: number): BasePart
	local s = scale
	local hull = P(parent, { Name = "Hull", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8 * s, 7 * s, 7 * s), CFrame = cf * upright(CFrame.new()), Color = "#C9D0DA", Material = Enum.Material.Metal, CanCollide = false })
	P(parent, { Name = "Rim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3 * s, 7.4 * s, 7.4 * s), CFrame = cf * upright(CFrame.new()), Color = "#5FFFE0", Material = Enum.Material.Neon, CanCollide = false })
	P(parent, { Name = "Belly", Shape = Enum.PartType.Ball, Size = Vector3.new(4.4 * s, 1.6 * s, 4.4 * s), CFrame = cf * CFrame.new(0, -0.35 * s, 0), Color = "#8E97A6", Material = Enum.Material.Metal, CanCollide = false })
	P(parent, { Name = "Canopy", Shape = Enum.PartType.Ball, Size = Vector3.new(3 * s, 3 * s, 3 * s), CFrame = cf * CFrame.new(0, 0.6 * s, 0), Color = "#7FE9FF", Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false })
	return hull
end

---------------------------------------------------------------------------- Pedestals
function PropFactory.Pedestal(glow: string?): Model
	local m = PropFactory.Model("Pedestal")
	local base = P(m, { Name = "Base", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 9, 9), CFrame = upright(CFrame.new(0, 0.8, 0)), Color = "#1A2134" })
	P(m, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 9.4, 9.4), CFrame = upright(CFrame.new(0, 1.45, 0)), Color = glow or Lobby.Colors.TrimGlow, Material = Enum.Material.Neon, CanCollide = false })
	P(m, { Name = "Top", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 8, 8), CFrame = upright(CFrame.new(0, 1.8, 0)), Color = "#24304D" })
	return finish(m, base)
end

function PropFactory.FlyerDisplay(): Model
	local m = PropFactory.Pedestal("#FFE14D")
	m.Name = "FlyerDisplay"
	local saucer = PropFactory.Model("Saucer")
	PropFactory.SaucerInto(saucer, CFrame.new(0, 10, 0), 1)
	saucer.Parent = m
	local beam = P(m, { Name = "LightCone", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 4.6, 4.6), CFrame = upright(CFrame.new(0, 5.6, 0)), Color = "#FFE97A", Material = Enum.Material.Neon, Transparency = 0.72, CanCollide = false })
	beam.CastShadow = false
	saucer:SetAttribute("Bob", 0.6)
	return m
end

function PropFactory.CrateDisplay(): Model
	local m = PropFactory.Pedestal("#B24DFF")
	m.Name = "CrateDisplay"
	local crate = PropFactory.Crate("Explosion")
	crate:PivotTo(CFrame.new(0, 2, 0) * CFrame.Angles(0, math.rad(20), 0))
	crate.Parent = m
	local light = Instance.new("PointLight")
	light.Color = Color3.fromHex("#B24DFF")
	light.Range = 14
	light.Brightness = 2
	light.Parent = m.PrimaryPart
	return m
end

function PropFactory.EventDisplay(): Model
	local m = PropFactory.Pedestal("#FF8C1A")
	m.Name = "EventDisplay"
	local crate = PropFactory.Crate("Event")
	crate:PivotTo(CFrame.new(0, 2, 0) * CFrame.Angles(0, math.rad(-15), 0))
	crate.Parent = m
	-- glowing wings (event flair)
	for side = -1, 1, 2 do
		for k = 1, 3 do
			P(m, {
				Name = "Wing",
				Size = Vector3.new(0.25, 0.8, 4 - k * 0.7),
				CFrame = CFrame.new(side * (2.6 + k * 0.5), 6 + k * 0.6, 0) * CFrame.Angles(math.rad(side * -20 * k), 0, math.rad(side * (30 + k * 12))),
				Color = if k == 2 then "#FF7BD5" else "#B24DFF",
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
		end
	end
	return m
end

function PropFactory.GroupPedestal(): Model
	local m = PropFactory.Model("GroupPedestal")
	local base = P(m, { Name = "Block", Size = Vector3.new(7, 3.2, 4.5), CFrame = CFrame.new(0, 1.6, 0), Color = "#0D0F14" })
	P(m, { Name = "Edge", Size = Vector3.new(7.2, 0.25, 4.7), CFrame = CFrame.new(0, 3.25, 0), Color = "#FFA000", Material = Enum.Material.Neon, CanCollide = false })
	P(m, { Name = "Thumb", Size = Vector3.new(1.2, 1.8, 0.8), CFrame = CFrame.new(-1.2, 4.3, 0), Color = "#FFFFFF", CanCollide = false })
	P(m, { Name = "ThumbTip", Size = Vector3.new(0.6, 1, 0.8), CFrame = CFrame.new(-1.0, 5.6, 0), Color = "#FFFFFF", CanCollide = false })
	P(m, { Name = "Star", Size = Vector3.new(1.4, 1.4, 0.6), CFrame = CFrame.new(1.4, 4.6, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = "#FFE14D", Material = Enum.Material.Neon, CanCollide = false })
	return finish(m, base)
end

---------------------------------------------------------------------------- Leaderboard board
function PropFactory.Leaderboard(): Model
	local m = PropFactory.Model("Leaderboard")
	local legL = P(m, { Name = "LegL", Size = Vector3.new(1.2, 6, 1.2), CFrame = CFrame.new(-13, 3, -0.4), Color = "#1A2134" })
	P(m, { Name = "LegR", Size = Vector3.new(1.2, 6, 1.2), CFrame = CFrame.new(13, 3, -0.4), Color = "#1A2134" })
	P(m, { Name = "Frame", Size = Vector3.new(36, 21, 1.2), CFrame = CFrame.new(0, 16.5, -0.5), Color = "#2F74E8" })
	local screen = P(m, { Name = "Screen", Size = Vector3.new(35, 20, 0.4), CFrame = CFrame.new(0, 16.5, 0.2), Color = "#141A2B" })
	screen:SetAttribute("BoardScreen", true)
	return finish(m, legL)
end

---------------------------------------------------------------------------- Giant decor orb
function PropFactory.DecorOrb(): Model
	local m = PropFactory.Model("DecorOrb")
	local core = P(m, { Name = "Core", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), CFrame = CFrame.new(0, 7, 0), Color = "#FF8A1F", Reflectance = 0.04, CanCollide = false })
	P(m, { Name = "Visor", Size = Vector3.new(11.5, 3.2, 3), CFrame = CFrame.new(0, 8, 5.6), Color = "#14141C", CanCollide = false })
	P(m, { Name = "VisorGlow", Size = Vector3.new(9.5, 0.6, 0.3), CFrame = CFrame.new(0, 8, 7.15), Color = "#5FFFE0", Material = Enum.Material.Neon, CanCollide = false })
	P(m, { Name = "Antenna", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 0.5, 0.5), CFrame = upright(CFrame.new(2, 15.5, 0)), Color = "#C9CCD3", CanCollide = false })
	P(m, { Name = "AntennaTip", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(2, 17.6, 0), Color = "#FF3D6E", Material = Enum.Material.Neon, CanCollide = false })
	m:SetAttribute("Bob", 1.5)
	return finish(m, core)
end

return PropFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WorldLabel</string>
            <string name="Source"><![CDATA[--!strict
-- Floating world text in the reference style (wide display font, thick dark stroke).
local WorldLabel = {}

WorldLabel.DisplayFont = Font.new("rbxasset://fonts/families/Michroma.json", Enum.FontWeight.Regular)
WorldLabel.BodyFont = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Bold)

export type LabelSpec = {
	Name: string?,
	Size: Vector2, -- studs
	Offset: Vector3?,
	MaxDistance: number?,
	AlwaysOnTop: boolean?,
	Lines: { { Text: string, Color: string?, Height: number, Font: Font?, Name: string? } },
}

function WorldLabel.Create(adornee: Instance, spec: LabelSpec): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = spec.Name or "Label"
	gui.Size = UDim2.new(spec.Size.X, 0, spec.Size.Y, 0) -- Scale components of a BillboardGui are studs
	gui.StudsOffsetWorldSpace = spec.Offset or Vector3.zero
	gui.MaxDistance = spec.MaxDistance or 220
	gui.AlwaysOnTop = spec.AlwaysOnTop == true
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Active = false

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = gui

	local total = 0
	for _, line in spec.Lines do
		total += line.Height
	end
	for i, line in spec.Lines do
		local label = Instance.new("TextLabel")
		label.Name = line.Name or ("Line" .. i)
		label.LayoutOrder = i
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, line.Height / total)
		label.FontFace = line.Font or WorldLabel.DisplayFont
		label.Text = line.Text
		label.TextScaled = true
		label.TextColor3 = Color3.fromHex(line.Color or "#FFFFFF")
		label.RichText = true
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(10, 12, 20)
		stroke.Thickness = 3
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		stroke.Parent = label
		label.Parent = gui
	end
	gui.Parent = adornee
	return gui
end

return WorldLabel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
