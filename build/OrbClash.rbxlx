        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- Sound library. Defaults use sound files that ship with every Roblox client
-- (rbxasset://sounds/...), so nothing is borrowed from the reference game. Replace any
-- entry with your own uploaded "rbxassetid://<id>" to upgrade the mix.
export type SoundSpec = {
	Id: string,
	Volume: number,
	Pitch: { number }, -- {min, max} random playback speed
}

local function s(id: string, volume: number, pmin: number, pmax: number): SoundSpec
	return { Id = id, Volume = volume, Pitch = { pmin, pmax } }
end

local Audio = {}

Audio.Sounds = {
	-- UI
	Hover = s("rbxasset://sounds/clickfast.wav", 0.15, 1.3, 1.4),
	Click = s("rbxasset://sounds/clickfast.wav", 0.45, 0.95, 1.05),
	Select = s("rbxasset://sounds/electronicpingshort.wav", 0.35, 1.15, 1.2),
	Countdown = s("rbxasset://sounds/electronicpingshort.wav", 0.6, 0.9, 0.9),
	CountdownGo = s("rbxasset://sounds/electronicpingshort.wav", 0.7, 1.35, 1.35),
	Error = s("rbxasset://sounds/clickfast.wav", 0.5, 0.55, 0.6),
	Purchase = s("rbxasset://sounds/electronicpingshort.wav", 0.5, 1.5, 1.5),
	Reward = s("rbxasset://sounds/victory.wav", 0.45, 1.1, 1.1),
	Open = s("rbxasset://sounds/swoosh.wav", 0.35, 1.2, 1.3),
	Close = s("rbxasset://sounds/swoosh.wav", 0.25, 0.9, 1.0),

	-- Battle
	Launch = s("rbxasset://sounds/swoosh.wav", 0.7, 0.8, 0.9),
	Bounce = s("rbxasset://sounds/collide.wav", 0.25, 1.1, 1.4),
	HitLight = s("rbxasset://sounds/collide.wav", 0.55, 0.8, 0.95),
	HitHeavy = s("rbxasset://sounds/bass.wav", 0.8, 0.9, 1.05),
	Ability = s("rbxasset://sounds/electronicpingshort.wav", 0.3, 0.7, 0.8),
	Laser = s("rbxasset://sounds/electronicpingshort.wav", 0.35, 0.45, 0.5),
	Shoot = s("rbxasset://sounds/Rocket shot.wav", 0.35, 1.4, 1.6),
	Explosion = s("rbxasset://sounds/Rocket shot.wav", 0.6, 0.6, 0.7),
	Zap = s("rbxasset://sounds/HalloweenThunder.wav", 0.35, 1.6, 1.8),
	Freeze = s("rbxasset://sounds/glassbreak.wav", 0.35, 1.5, 1.7),
	Shatter = s("rbxasset://sounds/glassbreak.wav", 0.45, 1.0, 1.2),
	Splat = s("rbxasset://sounds/splat.wav", 0.4, 0.9, 1.1),
	Death = s("rbxasset://sounds/Rocket shot.wav", 0.8, 0.45, 0.5),
	HeartBreak = s("rbxasset://sounds/glassbreak.wav", 0.7, 0.75, 0.8),
	Whoosh = s("rbxasset://sounds/swoosh.wav", 0.6, 0.7, 0.75),
	Train = s("rbxasset://sounds/Launching rocket.wav", 0.4, 1.3, 1.4),

	-- Meta
	GachaShake = s("rbxasset://sounds/swoosh.wav", 0.4, 1.6, 1.7),
	GachaReveal = s("rbxasset://sounds/electronicpingshort.wav", 0.6, 1.0, 1.0),
	RarePull = s("rbxasset://sounds/victory.wav", 0.5, 1.25, 1.25),
	LegendaryPull = s("rbxasset://sounds/victory.wav", 0.7, 0.9, 0.9),
	Victory = s("rbxasset://sounds/victory.wav", 0.7, 1.0, 1.0),
	Defeat = s("rbxasset://sounds/uuhhh.mp3", 0.5, 0.9, 0.9),
	LevelUp = s("rbxasset://sounds/victory.wav", 0.6, 1.4, 1.4),
} :: { [string]: SoundSpec }

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Branding</string>
            <string name="Source"><![CDATA[--!strict
-- Display strings that brand the experience. Collectible fighters are "Orbs":
-- original designs inspired by the Ball VS Ball format (see docs/RESEARCH.md).
return {
	GameName = "Orb Clash",
	FighterNoun = "Orb",
	FighterNounPlural = "Orbs",
	CoinName = "Coins",
	GemName = "Gems",
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Every economy number lives here. Values from the reference screenshots are marked
-- CONFIRMED; everything else is (TUNABLE). Crate prices/odds live in Definitions/GachaDefinitions.
local Economy = {}

Economy.Starting = {
	Coins = 100,
	Gems = 0,
	Balls = { "bumper", "thorn" }, -- starter collection
	Explosions = { "classic" },
	Flyers = { "basic" },
}

Economy.MatchRewards = {
	Win = { Coins = 100, XP = 15 }, -- Coins CONFIRMED ("Win 100" on pads)
	Loss = { Coins = 20, XP = 10 }, -- Coins LIKELY (guides)
	ForfeitWin = { Coins = 100, XP = 15 },
}

-- XP needed to go from `level` to `level + 1`. Reference shows "Lv 2 ... 10 / 40" → 20 * level.
function Economy.XPToNext(level: number): number
	return 20 * level
end

Economy.MaxLevel = 200

-- First completed battle grants a ticket (CONFIRMED: "You got a Ball Gacha for finishing your first battle").
Economy.FirstBattleTicket = "OrbGacha"

-- Like + Join Group reward (CONFIRMED: "Advanced Ball Gacha +1" sign in the lobby).
Economy.Group = {
	Id = 0, -- set to your Roblox group id. 0 = no group configured (claimable in Studio only).
	RewardTicket = "AdvancedOrbGacha",
}

-- Gem packs sold through the "+" button. Set ProductId to your developer product ids.
-- ProductId = 0 → the pack is only purchasable as a free test grant inside Studio.
Economy.GemProducts = {
	{ Key = "Gems100", ProductId = 0, Gems = 100, Robux = 99, Badge = nil :: string? },
	{ Key = "Gems550", ProductId = 0, Gems = 550, Robux = 449, Badge = "+10%" :: string? },
	{ Key = "Gems1200", ProductId = 0, Gems = 1200, Robux = 899, Badge = "+20%" :: string? },
	{ Key = "Gems3000", ProductId = 0, Gems = 3000, Robux = 1999, Badge = "BEST" :: string? },
}

Economy.Limits = {
	MaxCoins = 1e12,
	MaxGems = 1e9,
	MaxItemCount = 9999,
	MaxBulkOpen = 10,
}

-- Weekly leaderboard reward for top 3 of the previous week (paid on next join).
Economy.WeeklyRewards = {
	[1] = { Ticket = "AdvancedOrbGacha", Count = 3 },
	[2] = { Ticket = "AdvancedOrbGacha", Count = 2 },
	[3] = { Ticket = "AdvancedOrbGacha", Count = 1 },
}

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[--!strict
-- Match rules and timings. Values marked (TUNABLE) are not publicly documented for the
-- reference game; see docs/RESEARCH.md section F.
return {
	Hearts = 3, -- CONFIRMED: three hearts per side

	Timings = {
		MatchFoundCountdown = 3,
		MatchIntro = 2.6,
		SelectionTime = 15, -- (TUNABLE)
		SelectionGrace = 0.6, -- pause after everyone picked
		AimTime = 12, -- (TUNABLE)
		Countdown = 3,
		RoundResolution = 3.6, -- explosion + flyer + heart break
		DrawResolution = 2.2,
		MatchVictory = 3.8,
		ReleaseDelay = 0.4,
	},

	Selection = {
		OfferCount = 3, -- CONFIRMED
		OfferSource = "Global", -- "Global" (default, see research) or "Owned"
		RerollCost = 10, -- gems (TUNABLE)
		MaxRerollsPerRound = 3,
		FreeCollectionPicksPerMatch = 1, -- CONFIRMED: free once per match
		ExtraCollectionPickCost = 25, -- gems for further collection picks (TUNABLE)
	},

	Modes = {
		["1v1"] = { TeamSize = 1, ArenaKind = "Duel", Label = "1V1" },
		["2v2"] = { TeamSize = 2, ArenaKind = "Team", Label = "2V2" },
	},

	-- Ball spawn points (arena-plane coordinates, studs from the arena centre).
	SpawnLayout = {
		["1v1"] = {
			[1] = { { x = -4.5, y = 0 } },
			[2] = { { x = 4.5, y = 0 } },
		},
		["2v2"] = {
			[1] = { { x = -5.5, y = 3.5 }, { x = -5.5, y = -3.5 } },
			[2] = { { x = 5.5, y = 3.5 }, { x = 5.5, y = -3.5 } },
		},
	},

	FriendlyFire = false,

	-- Practice bot: OUR ADDITION (not part of the reference). Lets solo players test and
	-- fills quiet servers. Rewards are reduced.
	Bots = {
		Enabled = true,
		RewardMultiplier = 0.2,
		Name = "Practice Bot",
	},

	-- Characters are held on their pad while waiting/battling.
	LockCharactersOnPads = true,
	SpectatorRange = 150, -- studs; players inside receive live battle snapshots
	InviteTimeout = 20,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby layout (studs). +X east, +Z south, floor top at Y = 0.
-- See docs/RESEARCH.md section D for the top-down plan this mirrors.
export type StationConfig = {
	Id: string,
	Mode: "1v1" | "2v2",
	Position: { number }, -- floor point directly under the arena centre
	Yaw: number, -- degrees; 0 = station front faces world +Z
}

export type PropConfig = {
	Id: string,
	Kind: string,
	Position: { number },
	Yaw: number,
	Label: string?,
	OpenUI: string?, -- client UI route opened by the prompt, e.g. "Store:Balls"
}

local Lobby = {}

Lobby.Colors = {
	Floor = "#1E2A45",
	FloorDark = "#172036",
	Trim = "#3D7BE0",
	TrimGlow = "#59A8FF",
	Void = "#C7C8CE",
	ArenaFrame = "#2B2E36",
	ArenaInterior = "#050608",
	ArenaInnerWall = "#16181D",
	Ledge = "#22304F",
	LedgeBand = "#2F74E8",
	Pad = "#5FD3FF",
	Chevron = "#F4F6FA",
	TeamRed = "#FF2B2B",
	TeamBlue = "#19B6FF",
}

Lobby.Plaza = { Center = { 0, 0, 0 }, Size = { 200, 150 }, Height = 6 }
Lobby.Hall = { Center = { 230, 0, 40 }, Size = { 200, 90 }, Height = 6 }
Lobby.Bridge = { From = { 100, 0, 40 }, To = { 130, 0, 40 }, Width = 30 }
Lobby.Spawn = { Position = { 0, 0, 52 }, Yaw = 160 }

Lobby.Stations = {
	{ Id = "D1", Mode = "1v1", Position = { 160, 0, -1 }, Yaw = 0 },
	{ Id = "D2", Mode = "1v1", Position = { 206, 0, -1 }, Yaw = 0 },
	{ Id = "D3", Mode = "1v1", Position = { 252, 0, -1 }, Yaw = 0 },
	{ Id = "D4", Mode = "1v1", Position = { 298, 0, -1 }, Yaw = 0 },
	{ Id = "D5", Mode = "1v1", Position = { 160, 0, 81 }, Yaw = 180 },
	{ Id = "D6", Mode = "1v1", Position = { 206, 0, 81 }, Yaw = 180 },
	{ Id = "D7", Mode = "1v1", Position = { 252, 0, 81 }, Yaw = 180 },
	{ Id = "D8", Mode = "1v1", Position = { 298, 0, 81 }, Yaw = 180 },
	{ Id = "T1", Mode = "2v2", Position = { 0, 0, -60 }, Yaw = 0 },
} :: { StationConfig }

Lobby.Props = {
	{ Id = "OrbMachine", Kind = "GachaMachine", Position = { 66, 0, -22 }, Yaw = -70, Label = "Orbs", OpenUI = "Store:Balls" },
	{ Id = "ExplosionMachine", Kind = "CrateDisplay", Position = { 72, 0, 12 }, Yaw = -90, Label = "Explosions", OpenUI = "Store:Explosions" },
	{ Id = "FlyerDisplay", Kind = "FlyerDisplay", Position = { -66, 0, -22 }, Yaw = 70, Label = "Flyers", OpenUI = "Store:Flyers" },
	{ Id = "EventDisplay", Kind = "EventDisplay", Position = { -62, 0, 18 }, Yaw = 90, Label = "Event", OpenUI = "Store:Events" },
	{ Id = "GroupPedestal", Kind = "GroupPedestal", Position = { 0, 0, 24 }, Yaw = 0, Label = "Like + Join Group" },
	{ Id = "BoardAllTime", Kind = "Leaderboard", Position = { -60, 0, -66 }, Yaw = 15, Label = "AllTime" },
	{ Id = "BoardWeekly", Kind = "Leaderboard", Position = { 60, 0, -66 }, Yaw = -15, Label = "Weekly" },
	{ Id = "DecorOrb", Kind = "DecorOrb", Position = { -48, 34, -50 }, Yaw = 30 },
} :: { PropConfig }

Lobby.Chevrons = {
	Path = { { 8, 0, 46 }, { 60, 0, 42 }, { 100, 0, 40 }, { 140, 0, 40 }, { 150, 0, 40 } },
	Spacing = 7,
}

Lobby.Leaderboards = {
	Stat = "Wins", -- "Wins" (default) or "RobuxSpent" to mirror the reference's spender boards
	AllTimeTitle = "Top Winners",
	WeeklyTitle = "Weekly Top Winners",
	Size = 10,
	RefreshSeconds = 60,
	WeekEpochOffset = 345600, -- shifts week boundaries to Monday 00:00 UTC
}

return Lobby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Physics</string>
            <string name="Source"><![CDATA[--!strict
-- Battle simulation tuning. The simulation is a deterministic 2D fixed-step model that
-- runs on the server (see ServerScriptService/Server/Battle/World.luau). Units are studs and seconds.
--
-- UNKNOWN in research: whether the original arena has gravity. Default ON (energy conserving
-- arcs). Set Gravity = 0 for pure billiard motion; everything else keeps working.
return {
	TickRate = 60, -- simulation steps per second
	SnapshotRate = 20, -- network snapshots per second
	InterpolationDelay = 0.1, -- client render delay (seconds)

	Gravity = 14, -- studs/s^2 pulling toward -Y of the arena plane
	CruiseSpeed = 16, -- launch speed and the speed the energy governor restores
	GovernorRate = 2.2, -- how fast (1/s) total energy is restored toward the cruise energy
	MinSpeed = 5,
	MaxSpeed = 46,

	WallRestitution = 1.0,
	WallJitterDegrees = 2.5, -- tiny deterministic deflection prevents perfectly periodic loops
	BallRestitution = 1.0,
	ContactCooldown = 0.22, -- seconds before the same pair can deal contact damage again
	SpawnImmunity = 0.35,

	-- Overtime (our own rule: round duration is not documented publicly)
	OvertimeStart = 40,
	OvertimeStep = 5,
	OvertimeDamageBonus = 0.25, -- +25% damage per step
	OvertimeAttrition = 1.0, -- HP per second lost by every ball during overtime
	RoundHardCap = 120, -- seconds; lowest HP % loses

	MaxEntities = 140,
	MaxSnapshotEntities = 88, -- keeps snapshots under ~780 bytes
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Rarity</string>
            <string name="Source"><![CDATA[--!strict
-- Rarity tiers. Colours were sampled from the reference store screenshot (odds labels);
-- Mythic is an additional tier reported by current guides for the rarest fighters.
export type RarityId = "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic"

export type RarityInfo = {
	Id: RarityId,
	Order: number,
	Color: string, -- hex, converted with Color3.fromHex on the client
	Dark: string,
	Light: string,
	OfferWeight: number, -- weight used when rolling the 3 random battle offers
}

local Rarity = {}

Rarity.Order = { "Uncommon", "Rare", "Epic", "Legendary", "Mythic" } :: { RarityId }

Rarity.Info = {
	Uncommon = { Id = "Uncommon", Order = 1, Color = "#5CCF1A", Dark = "#2F7A06", Light = "#B8F58A", OfferWeight = 40 },
	Rare = { Id = "Rare", Order = 2, Color = "#5AAAF0", Dark = "#1F5FA8", Light = "#BFE0FF", OfferWeight = 30 },
	Epic = { Id = "Epic", Order = 3, Color = "#B24DFF", Dark = "#5E1A9C", Light = "#E3BFFF", OfferWeight = 18 },
	Legendary = { Id = "Legendary", Order = 4, Color = "#FFA000", Dark = "#A35A00", Light = "#FFE1A3", OfferWeight = 9 },
	Mythic = { Id = "Mythic", Order = 5, Color = "#FF3D6E", Dark = "#9C0F35", Light = "#FFC2D2", OfferWeight = 3 },
} :: { [string]: RarityInfo }

function Rarity.Get(id: string): RarityInfo
	return Rarity.Info[id] or Rarity.Info.Uncommon
end

function Rarity.Compare(a: string, b: string): boolean
	return Rarity.Get(a).Order < Rarity.Get(b).Order
end

return Rarity
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="13">
