        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict
-- Redeemable codes (server only, so they cannot be data-mined from the client).
-- Expires is unix seconds or nil. Codes are case-insensitive.
export type Code = {
	Code: string,
	Coins: number?,
	Gems: number?,
	Ticket: string?,
	Expires: number?,
}

return {
	{ Code = "LAUNCH", Coins = 150 },
	{ Code = "ORBCLASH", Coins = 100 },
	{ Code = "FIRSTORB", Ticket = "OrbGacha" },
	{ Code = "HARVEST", Gems = 15, Expires = 1793491200 },
} :: { Code }
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--!strict
-- Session-locked DataStore profiles (ProfileService-style) with retries and a Studio mock.
--
-- Record layout in the DataStore: { Data = <profile>, Lock = { JobId, Time }?, Meta = 1 }
-- * Load claims the lock with UpdateAsync. A lock held by another live server is respected
--   until it is older than LOCK_TIMEOUT (crashed server), then it is stolen.
-- * Every save refreshes the lock and verifies we still own it; if another server took over,
--   the session is marked lost and the player is kicked to prevent duplication.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local ProfileStore = {}
ProfileStore.__index = ProfileStore

local LOCK_TIMEOUT = 150 -- seconds; autosave refreshes every 60
local LOAD_ATTEMPTS = 6
local RETRY_BASE = 1.5

type Record = { Data: any, Lock: { JobId: string, Time: number }?, Meta: number }

export type Session = {
	Key: string,
	Data: any,
	Lost: boolean,
	Released: boolean,
}

type Backend = {
	UpdateAsync: (self: Backend, key: string, transform: (any) -> any) -> any,
}

export type ProfileStore = typeof(setmetatable({} :: { _backend: Backend, _jobId: string, IsMock: boolean }, ProfileStore))

-- In-memory fallback used when Studio has no API access.
local MockBackend = {}
MockBackend.__index = MockBackend
function MockBackend.new()
	return setmetatable({ _store = {} :: { [string]: any } }, MockBackend)
end
function MockBackend:UpdateAsync(key: string, transform: (any) -> any): any
	local old = self._store[key]
	local copy = if old then HttpService:JSONDecode(HttpService:JSONEncode(old)) else nil
	local new = transform(copy)
	if new ~= nil then
		self._store[key] = HttpService:JSONDecode(HttpService:JSONEncode(new))
	end
	return new
end

local function jobId(): string
	if game.JobId ~= "" then
		return game.JobId
	end
	return "studio-" .. HttpService:GenerateGUID(false)
end

function ProfileStore.new(name: string): ProfileStore
	local backend: any = nil
	local isMock = false
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok and store then
		backend = store
		if RunService:IsStudio() then
			local probeOk = pcall(function()
				store:GetAsync("__probe")
			end)
			if not probeOk then
				backend = nil
			end
		end
	end
	if backend == nil then
		warn("[ProfileStore] DataStores unavailable (enable Studio API access to persist). Using in-memory mock.")
		backend = MockBackend.new()
		isMock = true
	end
	return setmetatable({ _backend = backend :: Backend, _jobId = jobId(), IsMock = isMock }, ProfileStore)
end

local function retry<T>(attempts: number, fn: () -> T): (boolean, T | string)
	local lastErr: any = nil
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(RETRY_BASE * 2 ^ (attempt - 1))
	end
	return false, tostring(lastErr)
end

-- Loads and locks a profile. Returns nil when the profile could not be claimed.
-- `isActive` lets the caller abort (e.g. the player left during loading).
function ProfileStore.Load(self: ProfileStore, key: string, isActive: () -> boolean): Session?
	for attempt = 1, LOAD_ATTEMPTS do
		if not isActive() then
			return nil
		end
		local lockedElsewhere = false
		local ok, result = pcall(function()
			return self._backend:UpdateAsync(key, function(old: any)
				lockedElsewhere = false -- UpdateAsync may call the transform more than once
				local record: Record = if type(old) == "table" then old else { Data = nil, Lock = nil, Meta = 1 }
				local lock = record.Lock
				local now = os.time()
				if lock and lock.JobId ~= self._jobId and now - lock.Time < LOCK_TIMEOUT then
					lockedElsewhere = true
					return nil -- cancel write
				end
				record.Lock = { JobId = self._jobId, Time = now }
				record.Meta = 1
				return record
			end)
		end)
		if ok and result ~= nil and not lockedElsewhere then
			local record = result :: Record
			return { Key = key, Data = record.Data, Lost = false, Released = false }
		end
		if not ok then
			warn(string.format("[ProfileStore] load %s failed (attempt %d): %s", key, attempt, tostring(result)))
		end
		task.wait(if lockedElsewhere then 5 else RETRY_BASE * 2 ^ (attempt - 1))
	end
	return nil
end

-- Writes data and refreshes (or releases) the lock. Returns false if the session was lost.
function ProfileStore.Save(self: ProfileStore, session: Session, release: boolean): boolean
	if session.Released or session.Lost then
		return false
	end
	local lost = false
	local ok, err = retry(3, function()
		return self._backend:UpdateAsync(session.Key, function(old: any)
			lost = false
			local record: Record = if type(old) == "table" then old else { Data = nil, Lock = nil, Meta = 1 }
			local lock = record.Lock
			if lock and lock.JobId ~= self._jobId then
				lost = true
				return nil
			end
			record.Data = session.Data
			record.Lock = if release then nil else { JobId = self._jobId, Time = os.time() }
			record.Meta = 1
			return record
		end)
	end)
	if lost then
		session.Lost = true
		return false
	end
	if not ok then
		warn(string.format("[ProfileStore] save %s failed: %s", session.Key, tostring(err)))
		return false
	end
	if release then
		session.Released = true
	end
	return true
end

return ProfileStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Schema</string>
            <string name="Source"><![CDATA[--!strict
-- Player profile schema: defaults, migrations and sanitisation of loaded data.
-- Bump CURRENT_VERSION and add a migration step whenever the shape changes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)

export type Profile = {
	Version: number,
	Coins: number,
	Gems: number,
	XP: number,
	Level: number,
	Balls: { [string]: number },
	Explosions: { [string]: number },
	Flyers: { [string]: number },
	Equipped: { Explosion: string, Flyer: string },
	Tickets: { [string]: number },
	Stats: {
		Wins: number,
		Losses: number,
		Matches: number,
		RobuxSpent: number,
		Streak: number,
		BestStreak: number,
	},
	Weekly: { Week: number, Wins: number, RobuxSpent: number },
	Quests: { Day: number, Progress: { [string]: number }, Done: { [string]: boolean } },
	Codes: { [string]: boolean },
	Flags: { FirstBattle: boolean, GroupClaimed: boolean, WeeklyPaid: { [string]: boolean } },
	Receipts: { string },
	Created: number,
	LastLogin: number,
}

local Schema = {}

Schema.CURRENT_VERSION = 1

local function countMap(ids: { string }): { [string]: number }
	local map = {}
	for _, id in ids do
		map[id] = (map[id] or 0) + 1
	end
	return map
end

function Schema.Default(): Profile
	local now = os.time()
	return {
		Version = Schema.CURRENT_VERSION,
		Coins = Economy.Starting.Coins,
		Gems = Economy.Starting.Gems,
		XP = 0,
		Level = 1,
		Balls = countMap(Economy.Starting.Balls),
		Explosions = countMap(Economy.Starting.Explosions),
		Flyers = countMap(Economy.Starting.Flyers),
		Equipped = { Explosion = Economy.Starting.Explosions[1], Flyer = Economy.Starting.Flyers[1] },
		Tickets = {},
		Stats = { Wins = 0, Losses = 0, Matches = 0, RobuxSpent = 0, Streak = 0, BestStreak = 0 },
		Weekly = { Week = 0, Wins = 0, RobuxSpent = 0 },
		Quests = { Day = 0, Progress = {}, Done = {} },
		Codes = {},
		Flags = { FirstBattle = false, GroupClaimed = false, WeeklyPaid = {} },
		Receipts = {},
		Created = now,
		LastLogin = now,
	}
end

-- Migrations: index = version being upgraded FROM.
local Migrations: { [number]: (any) -> any } = {
	-- [1] = function(data) data.NewField = ...; return data end,
}

local function num(v: any, default: number, min: number, max: number): number
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return math.clamp(math.floor(v), min, max)
end

local function sanitizeCounts(v: any, isValid: (string) -> boolean): { [string]: number }
	local out = {}
	if type(v) ~= "table" then
		return out
	end
	for id, count in v do
		if type(id) == "string" and isValid(id) then
			local n = num(count, 0, 0, Economy.Limits.MaxItemCount)
			if n > 0 then
				out[id] = n
			end
		end
	end
	return out
end

-- Repairs a loaded record so the rest of the server can trust its shape.
function Schema.Sanitize(raw: any): Profile
	local data = if type(raw) == "table" then raw else {}
	local version = num(data.Version, 0, 0, 1000)
	while version < Schema.CURRENT_VERSION and Migrations[version] do
		data = Migrations[version](data)
		version += 1
	end

	local p = Schema.Default()
	if version == 0 and data.Coins == nil then
		return p -- brand new player
	end

	p.Coins = num(data.Coins, p.Coins, 0, Economy.Limits.MaxCoins)
	p.Gems = num(data.Gems, p.Gems, 0, Economy.Limits.MaxGems)
	p.XP = num(data.XP, 0, 0, 1e12)
	p.Level = num(data.Level, 1, 1, Economy.MaxLevel)
	p.Balls = sanitizeCounts(data.Balls, BallDefinitions.Exists)
	p.Explosions = sanitizeCounts(data.Explosions, function(id)
		return CosmeticDefinitions.Exists("Explosion", id)
	end)
	p.Flyers = sanitizeCounts(data.Flyers, function(id)
		return CosmeticDefinitions.Exists("Flyer", id)
	end)
	-- defaults are always owned
	for _, def in CosmeticDefinitions.All() do
		if def.Default then
			local bag = if def.Kind == "Explosion" then p.Explosions else p.Flyers
			bag[def.Id] = math.max(bag[def.Id] or 0, 1)
		end
	end
	p.Tickets = sanitizeCounts(data.Tickets, function(id)
		return GachaDefinitions.Get(id) ~= nil
	end)

	local equipped = if type(data.Equipped) == "table" then data.Equipped else {}
	if type(equipped.Explosion) == "string" and (p.Explosions[equipped.Explosion] or 0) > 0 then
		p.Equipped.Explosion = equipped.Explosion
	end
	if type(equipped.Flyer) == "string" and (p.Flyers[equipped.Flyer] or 0) > 0 then
		p.Equipped.Flyer = equipped.Flyer
	end

	local stats = if type(data.Stats) == "table" then data.Stats else {}
	for key, default in p.Stats :: any do
		(p.Stats :: any)[key] = num(stats[key], default, 0, 1e12)
	end
	local weekly = if type(data.Weekly) == "table" then data.Weekly else {}
	p.Weekly.Week = num(weekly.Week, 0, 0, 1e9)
	p.Weekly.Wins = num(weekly.Wins, 0, 0, 1e12)
	p.Weekly.RobuxSpent = num(weekly.RobuxSpent, 0, 0, 1e12)

	local quests = if type(data.Quests) == "table" then data.Quests else {}
	p.Quests.Day = num(quests.Day, 0, 0, 1e9)
	if type(quests.Progress) == "table" then
		for id, v in quests.Progress do
			if type(id) == "string" and #id <= 32 then
				p.Quests.Progress[id] = num(v, 0, 0, 1e6)
			end
		end
	end
	if type(quests.Done) == "table" then
		for id, v in quests.Done do
			if type(id) == "string" and #id <= 32 and v == true then
				p.Quests.Done[id] = true
			end
		end
	end

	if type(data.Codes) == "table" then
		for code, v in data.Codes do
			if type(code) == "string" and #code <= 32 and v == true then
				p.Codes[code] = true
			end
		end
	end

	local flags = if type(data.Flags) == "table" then data.Flags else {}
	p.Flags.FirstBattle = flags.FirstBattle == true
	p.Flags.GroupClaimed = flags.GroupClaimed == true
	if type(flags.WeeklyPaid) == "table" then
		for week, v in flags.WeeklyPaid do
			if type(week) == "string" and v == true then
				p.Flags.WeeklyPaid[week] = true
			end
		end
	end

	if type(data.Receipts) == "table" then
		for _, id in data.Receipts do
			if type(id) == "string" and #id <= 64 then
				table.insert(p.Receipts, id)
			end
		end
		while #p.Receipts > 50 do
			table.remove(p.Receipts, 1)
		end
	end

	p.Created = num(data.Created, os.time(), 0, 1e11)
	p.LastLogin = os.time()
	return p
end

-- What the owning client is allowed to see.
function Schema.PublicView(p: Profile): { [string]: any }
	return {
		Coins = p.Coins,
		Gems = p.Gems,
		XP = p.XP,
		Level = p.Level,
		Balls = table.clone(p.Balls),
		Explosions = table.clone(p.Explosions),
		Flyers = table.clone(p.Flyers),
		Equipped = table.clone(p.Equipped),
		Tickets = table.clone(p.Tickets),
		Stats = table.clone(p.Stats),
		Quests = { Day = p.Quests.Day, Progress = table.clone(p.Quests.Progress), Done = table.clone(p.Quests.Done) },
		Flags = { FirstBattle = p.Flags.FirstBattle, GroupClaimed = p.Flags.GroupClaimed },
	}
end

return Schema
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="72">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server bootstrap: creates remotes, then initialises and starts every service in order.
-- Services expose optional Init(registry) (wire-up, no yielding) and Start() (runtime).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)

Remotes.Init()

local Services = script.Parent.Services

local ORDER = {
	"DataService",
	"EconomyService",
	"LevelService",
	"QuestService",
	"RewardService",
	"GachaService",
	"CodeService",
	"MonetizationService",
	"LeaderboardService",
	"BallService",
	"AbilityService",
	"LobbyService",
	"ArenaService",
	"BattleReplicator",
	"MatchService",
	"QueueService",
	"TradingService",
	"StoreService",
}

local registry: { [string]: any } = {}
for _, name in ORDER do
	registry[name] = (require :: any)(Services:WaitForChild(name))
end

for _, name in ORDER do
	local service = registry[name]
	if type(service.Init) == "function" then
		local ok, err = pcall(service.Init, registry)
		if not ok then
			warn(string.format("[Main] %s.Init failed: %s", name, tostring(err)))
		end
	end
end

for _, name in ORDER do
	local service = registry[name]
	if type(service.Start) == "function" then
		task.spawn(function()
			local ok, err = pcall(service.Start)
			if not ok then
				warn(string.format("[Main] %s.Start failed: %s", name, tostring(err)))
			end
		end)
	end
end

print("[Orb Clash] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="73">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">AbilityService</string>
            <string name="Source"><![CDATA[--!strict
-- Registry of server ability modules (Battle/Abilities/<AbilityId>). The battle World resolves
-- abilities through here, so new abilities are picked up without touching the match loop.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)

local Server = script.Parent.Parent
local Types = require(Server.Battle.Types)

local AbilityService = {}

local registry: { [string]: Types.Ability } = {}

function AbilityService.Init()
	for _, module in Server.Battle.Abilities:GetChildren() do
		if module:IsA("ModuleScript") then
			local ok, ability = pcall(require, module)
			if ok and type(ability) == "table" then
				registry[module.Name] = ability :: Types.Ability
			else
				warn(string.format("[AbilityService] failed to load ability %s: %s", module.Name, tostring(ability)))
			end
		end
	end
	for _, def in BallDefinitions.All() do
		if def.AbilityId and registry[def.AbilityId] == nil then
			warn(string.format("[AbilityService] %s references missing ability %s", def.Id, def.AbilityId))
		end
	end
end

function AbilityService.Get(id: string): Types.Ability?
	return registry[id]
end

return AbilityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">ArenaService</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the duel stations (arena box, ledges, pads, VS screen, status label) from
-- Config/Lobby + Visual/ArenaGeometry and owns character placement on the pads.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lobby = require(Shared.Config.Lobby)
local GameConfig = require(Shared.Config.Game)
local Economy = require(Shared.Config.Economy)
local ArenaGeometry = require(Shared.Visual.ArenaGeometry)
local PropFactory = require(Shared.Visual.PropFactory)
local WorldLabel = require(Shared.Visual.WorldLabel)
local Signal = require(Shared.Util.Signal)

local P = PropFactory.Part

export type Pad = {
	Index: number,
	Team: number,
	Part: BasePart,
	Prompt: ProximityPrompt,
	Occupant: Player?,
	Bot: { [string]: any }?,
}

export type Station = {
	Id: string,
	Index: number,
	Mode: "1v1" | "2v2",
	Kind: string,
	CFrame: CFrame,
	Model: Model,
	Pads: { Pad },
	Label: BillboardGui,
	VsScreen: SurfaceGui,
	State: string,
	Match: any,
	FoundAt: number?,
}

local ArenaService = {}

ArenaService.Stations = {} :: { Station }
ArenaService.ById = {} :: { [string]: Station }
ArenaService.PadTriggered = Signal.new() -- (player, station, padIndex)

local locked: { [Player]: CFrame } = {}

local function teamColor(team: number): string
	return if team == 1 then Lobby.Colors.TeamRed else Lobby.Colors.TeamBlue
end

local function buildStation(config: Lobby.StationConfig, index: number, parent: Instance): Station
	local kindName = ArenaGeometry.KindForMode(config.Mode)
	local k = ArenaGeometry.Get(kindName)
	local cf = ArenaGeometry.StationCFrame(config.Position, config.Yaw, kindName)
	local model = PropFactory.Model("Station_" .. config.Id)
	model:SetAttribute("StationId", config.Id)
	model:SetAttribute("StationIndex", index)
	model:SetAttribute("Mode", config.Mode)
	model:SetAttribute("Kind", kindName)
	model:SetAttribute("Yaw", config.Yaw)
	model:SetAttribute("Floor", Vector3.new(config.Position[1], config.Position[2], config.Position[3]))
	CollectionService:AddTag(model, "Station")

	local h, f = k.Half, k.Frame
	local depth = k.FrontZ - (k.BackZ - 0.5)
	local midZ = (k.FrontZ + (k.BackZ - 0.5)) / 2
	local frameColor = Lobby.Colors.ArenaFrame
	-- frame: left, right, top, bottom
	P(model, { Name = "FrameL", Size = Vector3.new(f, 2 * (h + f), depth), CFrame = cf * CFrame.new(-(h + f / 2), 0, midZ), Color = frameColor })
	P(model, { Name = "FrameR", Size = Vector3.new(f, 2 * (h + f), depth), CFrame = cf * CFrame.new(h + f / 2, 0, midZ), Color = frameColor })
	P(model, { Name = "FrameT", Size = Vector3.new(2 * h, f, depth), CFrame = cf * CFrame.new(0, h + f / 2, midZ), Color = frameColor })
	P(model, { Name = "FrameB", Size = Vector3.new(2 * h, f, depth), CFrame = cf * CFrame.new(0, -(h + f / 2), midZ), Color = frameColor })
	-- front lip highlight
	local lipColor = "#454955"
	for _, spec in {
		{ Vector3.new(f, 2 * (h + f), 0.2), Vector3.new(-(h + f / 2), 0, k.FrontZ + 0.1) },
		{ Vector3.new(f, 2 * (h + f), 0.2), Vector3.new(h + f / 2, 0, k.FrontZ + 0.1) },
		{ Vector3.new(2 * h, f, 0.2), Vector3.new(0, h + f / 2, k.FrontZ + 0.1) },
		{ Vector3.new(2 * h, f, 0.2), Vector3.new(0, -(h + f / 2), k.FrontZ + 0.1) },
	} do
		P(model, { Name = "Lip", Size = spec[1], CFrame = cf * CFrame.new(spec[2]), Color = lipColor, CanCollide = false })
	end
	-- invisible barrier over the open front so nobody can walk into a fight
	P(model, { Name = "FrontBarrier", Size = Vector3.new(2 * h, 2 * h, 0.2), CFrame = cf * CFrame.new(0, 0, k.FrontZ + 0.1), Color = "#000000", Transparency = 1, CastShadow = false })
	-- back wall (black interior) with the idle "VS" screen
	local back = P(model, { Name = "BackWall", Size = Vector3.new(2 * h, 2 * h, 0.5), CFrame = cf * CFrame.new(0, 0, k.BackZ - 0.25), Color = Lobby.Colors.ArenaInterior })
	local vs = Instance.new("SurfaceGui")
	vs.Name = "VsScreen"
	vs.PixelsPerStud = 40
	vs.LightInfluence = 0
	vs.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	vs.ResetOnSpawn = false
	-- BackWall's Front face points along its LookVector (-Z local of the station) = away from the
	-- viewer, so use the Back face.
	vs.Face = Enum.NormalId.Back
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromHex("#141C33")
	bg.BorderSizePixel = 0
	bg.Parent = vs
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromHex("#1B2747"), Color3.fromHex("#0D1224"))
	grad.Rotation = 90
	grad.Parent = bg
	for s = 0, 7 do
		local stripe = Instance.new("Frame")
		stripe.AnchorPoint = Vector2.new(0.5, 0.5)
		stripe.Position = UDim2.fromScale(-0.1 + s * 0.17, 0.5)
		stripe.Size = UDim2.fromScale(0.05, 1.6)
		stripe.Rotation = 25
		stripe.BackgroundColor3 = Color3.fromHex("#22305A")
		stripe.BackgroundTransparency = 0.35
		stripe.BorderSizePixel = 0
		stripe.Parent = bg
	end
	bg.ClipsDescendants = true
	local vsText = Instance.new("TextLabel")
	vsText.Size = UDim2.fromScale(0.8, 0.45)
	vsText.Position = UDim2.fromScale(0.1, 0.27)
	vsText.BackgroundTransparency = 1
	vsText.FontFace = WorldLabel.DisplayFont
	vsText.Text = "VS"
	vsText.TextScaled = true
	vsText.TextColor3 = Color3.fromHex("#E8ECF5")
	local vsStroke = Instance.new("UIStroke")
	vsStroke.Thickness = 6
	vsStroke.Color = Color3.fromHex("#0A0E1A")
	vsStroke.Parent = vsText
	vsText.Parent = bg
	local modeText = Instance.new("TextLabel")
	modeText.Size = UDim2.fromScale(0.6, 0.12)
	modeText.Position = UDim2.fromScale(0.2, 0.74)
	modeText.BackgroundTransparency = 1
	modeText.FontFace = WorldLabel.DisplayFont
	modeText.Text = GameConfig.Modes[config.Mode].Label
	modeText.TextScaled = true
	modeText.TextColor3 = Color3.fromHex("#59A8FF")
	modeText.Parent = bg
	vs.Parent = back

	-- ledges, steps and pads
	local floorY = -k.BaseHeight
	local ledgeTop = -k.LedgeDrop
	local ledgeH = ledgeTop - floorY
	local zBack, zFront = k.LedgeDepth[1], k.LedgeDepth[2]
	local pads: { Pad } = {}
	for side = -1, 1, 2 do
		local inner, outer = k.LedgeInner, k.LedgeOuter
		local width = outer - inner
		local cx = side * (inner + width / 2)
		P(model, { Name = "Ledge", Size = Vector3.new(width, ledgeH, zFront - zBack), CFrame = cf * CFrame.new(cx, floorY + ledgeH / 2, (zBack + zFront) / 2), Color = Lobby.Colors.Ledge })
		P(model, { Name = "LedgeBand", Size = Vector3.new(width, 0.7, 0.2), CFrame = cf * CFrame.new(cx, ledgeTop - 0.35, zFront + 0.1), Color = Lobby.Colors.LedgeBand, Material = Enum.Material.Neon, CanCollide = false })
		P(model, { Name = "LedgeTop", Size = Vector3.new(width, 0.12, zFront - zBack), CFrame = cf * CFrame.new(cx, ledgeTop + 0.06, (zBack + zFront) / 2), Color = "#2A3A60" })
		local steps = math.ceil(ledgeH)
		for s = 1, steps do
			local stepH = ledgeH * (steps - s + 1) / (steps + 1)
			P(model, {
				Name = "Step",
				Size = Vector3.new(1.3, stepH, 5),
				CFrame = cf * CFrame.new(side * (outer + 0.65 + (s - 1) * 1.3), floorY + stepH / 2, 1.5),
				Color = Lobby.Colors.Ledge,
			})
		end
	end
	for padIndex, padSpec in k.Pads do
		local padCf = cf * CFrame.new(padSpec.X, ledgeTop + 0.2, 0.6)
		local ring = P(model, { Name = "Pad" .. padIndex, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 4.6, 4.6), CFrame = PropFactory.Upright(padCf), Color = teamColor(padSpec.Team), Material = Enum.Material.Neon, CanCollide = false })
		P(model, { Name = "PadInner", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 3.8, 3.8), CFrame = PropFactory.Upright(padCf), Color = "#121829", CanCollide = false })
		local attachment = Instance.new("Attachment")
		attachment.Position = Vector3.new(0, 2.5, 0)
		attachment.Parent = ring
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Join Battle"
		prompt.ObjectText = GameConfig.Modes[config.Mode].Label
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = attachment
		table.insert(pads, { Index = padIndex, Team = padSpec.Team, Part = ring, Prompt = prompt, Occupant = nil, Bot = nil })
	end

	-- status label above the arena ("0/2 PLAYERS", "Win 100")
	local anchor = P(model, { Name = "LabelAnchor", Size = Vector3.new(1, 1, 1), CFrame = cf * CFrame.new(0, h + f + 4.5, 0), Color = "#000000", Transparency = 1, CanCollide = false })
	local capacity = #pads
	local label = WorldLabel.Create(anchor, {
		Name = "Status",
		Size = Vector2.new(22, 6),
		MaxDistance = 260,
		Lines = {
			{ Name = "Count", Text = string.format("0/%d PLAYERS", capacity), Height = 1.1 },
			{ Name = "Reward", Text = string.format('<font color="#FFC72C">Win %d</font>', Economy.MatchRewards.Win.Coins), Height = 1 },
		},
	})

	model.Parent = parent
	return {
		Id = config.Id,
		Index = index,
		Mode = config.Mode,
		Kind = kindName,
		CFrame = cf,
		Model = model,
		Pads = pads,
		Label = label,
		VsScreen = vs,
		State = "Idle",
		Match = nil,
		FoundAt = nil,
	}
end

function ArenaService.SetLabel(station: Station, text: string, color: string?)
	local count = station.Label:FindFirstChild("Count") :: TextLabel?
	if count then
		count.Text = text
		count.TextColor3 = Color3.fromHex(color or "#FFFFFF")
	end
end

function ArenaService.SetIdleVisuals(station: Station, idle: boolean)
	station.VsScreen.Enabled = idle
	station.Label.Enabled = idle
	station.Model:SetAttribute("InMatch", not idle)
end

function ArenaService.Occupants(station: Station): number
	local n = 0
	for _, pad in station.Pads do
		if pad.Occupant or pad.Bot then
			n += 1
		end
	end
	return n
end

-- Character placement ----------------------------------------------------------------------
local function rootOf(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function ArenaService.LockCharacter(player: Player, cf: CFrame)
	locked[player] = cf
	local root = rootOf(player)
	local character = player.Character
	if root and character then
		root.Anchored = true
		character:PivotTo(cf)
	end
end

function ArenaService.UnlockCharacter(player: Player, release: CFrame?)
	locked[player] = nil
	local root = rootOf(player)
	local character = player.Character
	if root and character then
		if release then
			character:PivotTo(release)
		end
		root.Anchored = false
	end
end

function ArenaService.IsLocked(player: Player): boolean
	return if locked[player] then true else false
end

function ArenaService.PadCFrame(station: Station, padIndex: number): CFrame
	return ArenaGeometry.PadCFrame(station.CFrame, station.Kind, padIndex)
end

function ArenaService.ReleaseCFrame(station: Station, padIndex: number): CFrame
	return ArenaGeometry.ReleaseCFrame(station.CFrame, station.Kind, padIndex)
end

function ArenaService.Init()
	local lobbyFolder = Workspace:FindFirstChild("Lobby") or Instance.new("Folder")
	lobbyFolder.Name = "Lobby"
	lobbyFolder.Parent = Workspace
	local folder = Instance.new("Folder")
	folder.Name = "Stations"
	folder.Parent = lobbyFolder
	for index, config in Lobby.Stations do
		local station = buildStation(config, index, folder)
		table.insert(ArenaService.Stations, station)
		ArenaService.ById[station.Id] = station
	end
end

function ArenaService.Start()
	for _, station in ArenaService.Stations do
		for _, pad in station.Pads do
			pad.Prompt.Triggered:Connect(function(player: Player)
				ArenaService.PadTriggered:Fire(player, station, pad.Index)
			end)
		end
	end
	-- keep locked characters on their pads across respawns
	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			local cf = locked[player]
			if cf then
				local root = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
				if root and locked[player] then
					root.Anchored = true
					character:PivotTo(locked[player] :: CFrame)
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		locked[player] = nil
	end)
end

return ArenaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">BallService</string>
            <string name="Source"><![CDATA[--!strict
-- Orb definitions lookup, ownership checks and the 3 random battle offers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local Rarity = require(Shared.Config.Rarity)
local GameConfig = require(Shared.Config.Game)

local DataService = require(script.Parent.DataService)

local BallService = {}

local rng = Random.new()

function BallService.Get(id: string): BallDefinitions.BallDefinition?
	return BallDefinitions.Get(id)
end

function BallService.Owns(player: Player, id: string): boolean
	local profile = DataService.Get(player)
	return profile ~= nil and (profile.Balls[id] or 0) > 0
end

-- Rolls `count` distinct orb ids. Source "Global" uses the whole roster weighted by rarity
-- (default, see research notes); "Owned" draws from the player's collection.
function BallService.RollOffers(player: Player?, count: number, exclude: { string }?): { string }
	local pool: { BallDefinitions.BallDefinition } = {}
	local source = GameConfig.Selection.OfferSource
	if source == "Owned" and player then
		local profile = DataService.Get(player)
		if profile then
			for id, n in profile.Balls do
				local def = BallDefinitions.Get(id)
				if def and n > 0 then
					table.insert(pool, def)
				end
			end
		end
	end
	if #pool < count then
		pool = table.clone(BallDefinitions.OfferPool())
	end
	local excluded: { [string]: boolean } = {}
	if exclude then
		for _, id in exclude do
			excluded[id] = true
		end
	end
	local result: { string } = {}
	for _ = 1, count do
		local total = 0
		for _, def in pool do
			if not excluded[def.Id] then
				total += Rarity.Get(def.Rarity).OfferWeight
			end
		end
		if total <= 0 then
			-- everything excluded: allow repeats from the full pool
			table.clear(excluded)
			continue
		end
		local pick = rng:NextNumber() * total
		for _, def in pool do
			if not excluded[def.Id] then
				pick -= Rarity.Get(def.Rarity).OfferWeight
				if pick < 0 then
					table.insert(result, def.Id)
					excluded[def.Id] = true
					break
				end
			end
		end
	end
	return result
end

return BallService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">BattleReplicator</string>
            <string name="Source"><![CDATA[--!strict
-- Interest-managed battle replication. Participants and nearby spectators receive:
--   * BattleEvent (reliable): batched simulation events (spawns, hits, deaths, FX)
--   * BattleSnapshot (unreliable): 20 Hz binary snapshots for interpolation
-- Late spectators get a full-state event first so they can render mid-round.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local SnapshotCodec = require(Shared.Net.SnapshotCodec)
local GameConfig = require(Shared.Config.Game)

local BattleReplicator = {}

type Feed = {
	station: any, -- ArenaService.Station
	viewers: { [Player]: boolean },
	participants: () -> { Player },
	fullState: () -> { [string]: any }?,
	publicState: () -> { [string]: any }?,
}

local feeds: { [number]: Feed } = {}
local eventRemote: RemoteEvent
local snapshotRemote: UnreliableRemoteEvent
local publicRemote: RemoteEvent

local function inRange(player: Player, station: any): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root == nil then
		return false
	end
	return (root.Position - station.CFrame.Position).Magnitude <= GameConfig.SpectatorRange
end

local function addViewer(feed: Feed, player: Player)
	feed.viewers[player] = true
	local full = feed.fullState()
	if full then
		eventRemote:FireClient(player, feed.station.Index, { { t = "Full", state = full } })
	end
	local public = feed.publicState()
	if public then
		publicRemote:FireClient(player, public)
	end
end

local function refresh(feed: Feed)
	local wanted: { [Player]: boolean } = {}
	for _, player in feed.participants() do
		if player.Parent then
			wanted[player] = true
		end
	end
	for _, player in Players:GetPlayers() do
		if not wanted[player] and inRange(player, feed.station) then
			wanted[player] = true
		end
	end
	for player in feed.viewers do
		if not wanted[player] then
			feed.viewers[player] = nil
			if player.Parent then
				eventRemote:FireClient(player, feed.station.Index, { { t = "Clear" } })
			end
		end
	end
	for player in wanted do
		if not feed.viewers[player] then
			addViewer(feed, player)
		end
	end
end

function BattleReplicator.Attach(
	station: any,
	participants: () -> { Player },
	fullState: () -> { [string]: any }?,
	publicState: () -> { [string]: any }?
)
	local feed: Feed = {
		station = station,
		viewers = {},
		participants = participants,
		fullState = fullState,
		publicState = publicState,
	}
	feeds[station.Index] = feed
	refresh(feed)
end

function BattleReplicator.Detach(station: any)
	local feed = feeds[station.Index]
	if feed == nil then
		return
	end
	feeds[station.Index] = nil
	for player in feed.viewers do
		if player.Parent then
			eventRemote:FireClient(player, station.Index, { { t = "Clear" } })
		end
	end
end

function BattleReplicator.SendEvents(station: any, events: { { [string]: any } })
	if #events == 0 then
		return
	end
	local feed = feeds[station.Index]
	if feed == nil then
		return
	end
	for player in feed.viewers do
		eventRemote:FireClient(player, station.Index, events)
	end
end

function BattleReplicator.SendSnapshot(station: any, snapshot: SnapshotCodec.Snapshot)
	local feed = feeds[station.Index]
	if feed == nil or next(feed.viewers) == nil then
		return
	end
	local payload = SnapshotCodec.Encode(snapshot)
	for player in feed.viewers do
		snapshotRemote:FireClient(player, payload)
	end
end

function BattleReplicator.SendPublic(station: any, payload: { [string]: any })
	local feed = feeds[station.Index]
	if feed == nil then
		return
	end
	for player in feed.viewers do
		publicRemote:FireClient(player, payload)
	end
end

function BattleReplicator.Init()
	eventRemote = Remotes.Event("BattleEvent")
	snapshotRemote = Remotes.Unreliable("BattleSnapshot")
	publicRemote = Remotes.Event("MatchPublic")
end

function BattleReplicator.Start()
	Players.PlayerRemoving:Connect(function(player)
		for _, feed in feeds do
			feed.viewers[player] = nil
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, feed in feeds do
				refresh(feed)
			end
		end
	end)
end

return BattleReplicator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[--!strict
-- Code redemption (Gift -> Codes menu in the reference). One use per player per code.
local Server = script.Parent.Parent
local Codes = require(Server.Data.Codes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local CodeService = {}

local byCode: { [string]: Codes.Code } = {}
for _, code in Codes do
	byCode[string.upper(code.Code)] = code
end

function CodeService.Redeem(player: Player, raw: any): { [string]: any }
	if type(raw) ~= "string" or #raw > 32 then
		return { ok = false, error = "Invalid code." }
	end
	local key = string.upper((string.gsub(raw, "%s", "")))
	local code = byCode[key]
	if code == nil then
		return { ok = false, error = "That code doesn't exist." }
	end
	if code.Expires and os.time() >= code.Expires then
		return { ok = false, error = "That code has expired." }
	end
	local claimed = DataService.Update(player, function(profile)
		if profile.Codes[key] then
			return false
		end
		profile.Codes[key] = true
		return true
	end)
	if claimed == nil then
		return { ok = false, error = "Your data is still loading." }
	elseif claimed == false then
		return { ok = false, error = "You already redeemed this code." }
	end
	local parts = {}
	if code.Coins then
		EconomyService.AddCurrency(player, "Coins", code.Coins)
		table.insert(parts, string.format("+%d Coins", code.Coins))
	end
	if code.Gems then
		EconomyService.AddCurrency(player, "Gems", code.Gems)
		table.insert(parts, string.format("+%d Gems", code.Gems))
	end
	if code.Ticket then
		EconomyService.GrantItem(player, "Ticket", code.Ticket, 1)
		table.insert(parts, "+1 Gacha")
	end
	return { ok = true, message = "Redeemed! " .. table.concat(parts, ", ") }
end

return CodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Owns every player's profile: load (session locked), sanitise, mutate, replicate, autosave,
-- release on leave and on shutdown. Other services never touch DataStores directly.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Signal = require(Shared.Util.Signal)

local Server = script.Parent.Parent
local ProfileStore = require(Server.Data.ProfileStore)
local Schema = require(Server.Data.Schema)

export type Profile = Schema.Profile

local DataService = {}

DataService.Loaded = Signal.new() -- (player, profile)
DataService.Changed = Signal.new() -- (player, profile)
DataService.Releasing = Signal.new() -- (player, profile) fired before the final save

local STORE_NAME = "OrbClash_PlayerData_v1"
local AUTOSAVE_SECONDS = 60

local store: ProfileStore.ProfileStore
local sessions: { [Player]: ProfileStore.Session } = {}
local dirtySync: { [Player]: boolean } = {}
local loadWaiters: { [Player]: { thread } } = {}
local loading: { [Player]: boolean } = {}

local playerDataRemote: RemoteEvent

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

function DataService.Get(player: Player): Profile?
	local session = sessions[player]
	if session == nil or session.Lost or session.Released then
		return nil
	end
	return session.Data :: Profile
end

-- Yields until the profile is loaded (or the player leaves / timeout).
function DataService.WaitFor(player: Player, timeout: number?): Profile?
	local existing = DataService.Get(player)
	if existing then
		return existing
	end
	local thread = coroutine.running()
	local waiters = loadWaiters[player] or {}
	loadWaiters[player] = waiters
	table.insert(waiters, thread)
	task.delay(timeout or 30, function()
		local i = table.find(waiters, thread)
		if i then
			table.remove(waiters, i)
			task.spawn(thread)
		end
	end)
	coroutine.yield()
	return DataService.Get(player)
end

-- The only way to mutate a profile. `mutator` runs synchronously and must not yield.
-- Returns whatever the mutator returns (nil if the profile is not loaded).
function DataService.Update<T>(player: Player, mutator: (Profile) -> T): T?
	local profile = DataService.Get(player)
	if profile == nil then
		return nil
	end
	local result = mutator(profile)
	DataService.MarkChanged(player)
	return result
end

function DataService.MarkChanged(player: Player)
	dirtySync[player] = true
	local profile = DataService.Get(player)
	if profile then
		DataService.Changed:Fire(player, profile)
	end
end

function DataService.SyncNow(player: Player)
	local profile = DataService.Get(player)
	if profile and player.Parent then
		dirtySync[player] = nil
		playerDataRemote:FireClient(player, Schema.PublicView(profile))
	end
end

-- Forces an immediate save (used after purchases and trades).
function DataService.SaveNow(player: Player): boolean
	local session = sessions[player]
	if session == nil then
		return false
	end
	local ok = store:Save(session, false)
	if session.Lost then
		player:Kick("Your data was opened in another server. Please rejoin.")
	end
	return ok
end

function DataService.IsMock(): boolean
	return store.IsMock
end

local function onPlayerAdded(player: Player)
	if loading[player] or sessions[player] then
		return
	end
	loading[player] = true
	local session = store:Load(keyFor(player), function()
		return player.Parent == Players
	end)
	loading[player] = nil
	if player.Parent ~= Players then
		if session then
			store:Save(session, true)
		end
		return
	end
	if session == nil then
		player:Kick("Could not load your data. Please rejoin in a moment.")
		return
	end
	session.Data = Schema.Sanitize(session.Data)
	sessions[player] = session

	local waiters = loadWaiters[player]
	loadWaiters[player] = nil
	if waiters then
		for _, thread in waiters do
			task.spawn(thread)
		end
	end

	DataService.Loaded:Fire(player, session.Data)
	DataService.SyncNow(player)
end

local function release(player: Player)
	local session = sessions[player]
	if session == nil then
		return
	end
	DataService.Releasing:Fire(player, session.Data)
	sessions[player] = nil
	dirtySync[player] = nil
	store:Save(session, true)
end

function DataService.Init()
	store = ProfileStore.new(STORE_NAME)
	playerDataRemote = Remotes.Event("PlayerData")
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	-- deferred so every other service's Start() has connected to Loaded first
	task.defer(function()
		for _, player in Players:GetPlayers() do
			task.spawn(onPlayerAdded, player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		-- let other services finish their PlayerRemoving work (forfeits, trades) first
		task.defer(release, player)
	end)

	-- batched client sync (at most ~6/s per player)
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player in dirtySync do
				DataService.SyncNow(player)
			end
		end
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player, session in sessions do
				task.spawn(function()
					store:Save(session, false)
					if session.Lost and player.Parent then
						player:Kick("Your data was opened in another server. Please rejoin.")
					end
				end)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in sessions do
			pending += 1
			task.spawn(function()
				release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + (if RunService:IsStudio() then 5 else 25)
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- Currency and inventory primitives. Every grant/spend in the game goes through here, inside
-- DataService.Update, so values stay clamped and replicated.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)

local DataService = require(script.Parent.DataService)

type Profile = DataService.Profile

export type ItemKind = "Ball" | "Explosion" | "Flyer" | "Ticket"

local EconomyService = {}

local function bagFor(profile: Profile, kind: string): { [string]: number }?
	if kind == "Ball" then
		return profile.Balls
	elseif kind == "Explosion" then
		return profile.Explosions
	elseif kind == "Flyer" then
		return profile.Flyers
	elseif kind == "Ticket" then
		return profile.Tickets
	end
	return nil
end
EconomyService.BagFor = bagFor

function EconomyService.IsValidItem(kind: string, id: string): boolean
	if kind == "Ball" then
		return BallDefinitions.Exists(id)
	elseif kind == "Explosion" or kind == "Flyer" then
		return CosmeticDefinitions.Exists(kind, id)
	elseif kind == "Ticket" then
		return GachaDefinitions.Get(id) ~= nil
	end
	return false
end

function EconomyService.IsTradable(kind: string, id: string): boolean
	if kind == "Ball" then
		local def = BallDefinitions.Get(id)
		return def ~= nil and def.Tradable
	elseif kind == "Explosion" or kind == "Flyer" then
		local def = CosmeticDefinitions.Get(kind, id)
		return def ~= nil and def.Tradable
	end
	return false
end

function EconomyService.Count(player: Player, kind: string, id: string): number
	local profile = DataService.Get(player)
	if profile == nil then
		return 0
	end
	local bag = bagFor(profile, kind)
	return if bag then bag[id] or 0 else 0
end

-- Low-level mutation on an already-held profile (use inside DataService.Update).
function EconomyService.AddToProfile(profile: Profile, kind: string, id: string, count: number): boolean
	local bag = bagFor(profile, kind)
	if bag == nil or not EconomyService.IsValidItem(kind, id) then
		return false
	end
	local next = (bag[id] or 0) + count
	if next < 0 then
		return false
	end
	next = math.min(next, Economy.Limits.MaxItemCount)
	if next > 0 then
		bag[id] = next
	else
		bag[id] = nil
	end
	-- never leave an unowned cosmetic equipped
	if kind == "Explosion" and profile.Equipped.Explosion == id and next == 0 then
		profile.Equipped.Explosion = "classic"
	elseif kind == "Flyer" and profile.Equipped.Flyer == id and next == 0 then
		profile.Equipped.Flyer = "basic"
	end
	return true
end

function EconomyService.GrantItem(player: Player, kind: string, id: string, count: number?): boolean
	local result = DataService.Update(player, function(profile)
		return EconomyService.AddToProfile(profile, kind, id, count or 1)
	end)
	return result == true
end

function EconomyService.AddCurrency(player: Player, currency: "Coins" | "Gems", amount: number): boolean
	if amount ~= amount or amount <= 0 then
		return false
	end
	local result = DataService.Update(player, function(profile)
		if currency == "Coins" then
			profile.Coins = math.min(profile.Coins + math.floor(amount), Economy.Limits.MaxCoins)
		else
			profile.Gems = math.min(profile.Gems + math.floor(amount), Economy.Limits.MaxGems)
		end
		return true
	end)
	return result == true
end

-- Atomically checks and deducts. Returns false (and changes nothing) if unaffordable.
function EconomyService.TrySpend(player: Player, currency: "Coins" | "Gems", amount: number): boolean
	if amount ~= amount or amount < 0 then
		return false
	end
	local result = DataService.Update(player, function(profile)
		local balance = if currency == "Coins" then profile.Coins else profile.Gems
		if balance < amount then
			return false
		end
		if currency == "Coins" then
			profile.Coins -= amount
		else
			profile.Gems -= amount
		end
		return true
	end)
	return result == true
end

function EconomyService.Equip(player: Player, kind: string, id: string): boolean
	if kind ~= "Explosion" and kind ~= "Flyer" then
		return false
	end
	local result = DataService.Update(player, function(profile)
		local bag = bagFor(profile, kind)
		if bag == nil or (bag[id] or 0) <= 0 then
			return false
		end
		if kind == "Explosion" then
			profile.Equipped.Explosion = id
		else
			profile.Equipped.Flyer = id
		end
		return true
	end)
	return result == true
end

-- Generic reward table: { Kind = "Ball"|"Ticket"|"Coins"|"Gems"|"Explosion"|"Flyer", Id?, Amount? }
function EconomyService.GrantReward(player: Player, reward: { Kind: string, Id: string?, Amount: number? }): boolean
	if reward.Kind == "Coins" then
		return EconomyService.AddCurrency(player, "Coins", reward.Amount or 0)
	elseif reward.Kind == "Gems" then
		return EconomyService.AddCurrency(player, "Gems", reward.Amount or 0)
	elseif reward.Id then
		return EconomyService.GrantItem(player, reward.Kind, reward.Id, reward.Amount or 1)
	end
	return false
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">GachaService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-side weighted gacha rolls. The client only names a crate; price, pool and result are
-- decided here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local Economy = require(Shared.Config.Economy)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

export type Pull = { Kind: string, Id: string, Rarity: string, New: boolean }

local GachaService = {}

local rng = Random.new()

local function roll(crate: GachaDefinitions.Crate): GachaDefinitions.PoolItem?
	local pool = GachaDefinitions.Pool(crate)
	if #pool == 0 then
		return nil
	end
	if crate.Items then
		local total = 0
		for _, item in crate.Items do
			total += item.Weight
		end
		local pick = rng:NextNumber() * total
		for i, item in crate.Items do
			pick -= item.Weight
			if pick < 0 then
				return pool[i]
			end
		end
		return pool[#pool]
	end
	-- rarity first (published odds), then uniform within that rarity
	local odds: { [string]: number } = crate.Odds or {}
	local total = 0
	for _, pct in odds do
		total += pct
	end
	local pick = rng:NextNumber() * total
	local rarity: string? = nil
	for _, r in { "Uncommon", "Rare", "Epic", "Legendary", "Mythic" } do
		local pct = odds[r]
		if pct then
			pick -= pct
			if pick < 0 then
				rarity = r
				break
			end
		end
	end
	local candidates = {}
	for _, item in pool do
		if item.Rarity == rarity then
			table.insert(candidates, item)
		end
	end
	if #candidates == 0 then
		candidates = pool
	end
	return candidates[rng:NextInteger(1, #candidates)]
end
GachaService.Roll = roll

local function grantPulls(player: Player, crate: GachaDefinitions.Crate, count: number): { Pull }
	local pulls: { Pull } = {}
	DataService.Update(player, function(profile)
		for _ = 1, count do
			local item = roll(crate)
			if item then
				local bag = EconomyService.BagFor(profile, item.Kind)
				local isNew = bag ~= nil and (bag[item.Id] or 0) == 0
				EconomyService.AddToProfile(profile, item.Kind, item.Id, 1)
				table.insert(pulls, { Kind = item.Kind, Id = item.Id, Rarity = item.Rarity, New = isNew })
			end
		end
		return true
	end)
	return pulls
end

function GachaService.Open(player: Player, crateId: any, count: any): { [string]: any }
	local crate = if type(crateId) == "string" then GachaDefinitions.Get(crateId) else nil
	if crate == nil or crate.TicketOnly then
		return { ok = false, error = "That crate doesn't exist." }
	end
	if count ~= 1 and count ~= Economy.Limits.MaxBulkOpen then
		return { ok = false, error = "Invalid amount." }
	end
	if not GachaDefinitions.IsActive(crate, os.time()) then
		return { ok = false, error = "This event has ended." }
	end
	local price = crate.Price * (count :: number)
	if not EconomyService.TrySpend(player, crate.Currency :: any, price) then
		return { ok = false, error = if crate.Currency == "Coins" then "Not enough coins!" else "Not enough gems!" }
	end
	local pulls = grantPulls(player, crate, count :: number)
	return { ok = true, crate = crate.Id, pulls = pulls }
end

function GachaService.OpenTicket(player: Player, crateId: any): { [string]: any }
	local crate = if type(crateId) == "string" then GachaDefinitions.Get(crateId) else nil
	if crate == nil then
		return { ok = false, error = "Unknown gacha." }
	end
	local spent = DataService.Update(player, function(profile)
		local have = profile.Tickets[crate.Id] or 0
		if have <= 0 then
			return false
		end
		if have > 1 then
			profile.Tickets[crate.Id] = have - 1
		else
			profile.Tickets[crate.Id] = nil
		end
		return true
	end)
	if spent ~= true then
		return { ok = false, error = "You don't have that gacha." }
	end
	local pulls = grantPulls(player, crate, 1)
	return { ok = true, crate = crate.Id, pulls = pulls }
end

return GachaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- leaderstats + all-time and weekly OrderedDataStore boards (reference: "Top Spenders" and
-- "Weekly Top Spenders" boards with a rewards column). The ranked stat is configurable.
-- Also pays last week's top 3 when they next join.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lobby = require(Shared.Config.Lobby)
local Economy = require(Shared.Config.Economy)
local Remotes = require(Shared.Net.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

type Profile = DataService.Profile
type Entry = { Rank: number, UserId: number, Name: string, Value: number }

local LeaderboardService = {}

local Config = Lobby.Leaderboards
local WEEK = 604800

local boardRemote: RemoteEvent
local rewardRemote: RemoteEvent
local storesOk = true
local nameCache: { [number]: string } = {}
local dirty: { [Player]: boolean } = {}
local latest: { [string]: any } = { AllTime = {}, Weekly = {}, Ranks = {} }

local function weekIndex(t: number?): number
	return ((t or os.time()) - Config.WeekEpochOffset) // WEEK
end

local function weekEndsAt(): number
	return (weekIndex() + 1) * WEEK + Config.WeekEpochOffset
end

local function statValue(profile: Profile, weekly: boolean): number
	if weekly then
		if profile.Weekly.Week ~= weekIndex() then
			return 0
		end
		return if Config.Stat == "RobuxSpent" then profile.Weekly.RobuxSpent else profile.Weekly.Wins
	end
	return if Config.Stat == "RobuxSpent" then profile.Stats.RobuxSpent else profile.Stats.Wins
end

local function storeFor(week: number?): OrderedDataStore?
	if not storesOk then
		return nil
	end
	local name = if week then string.format("OrbClash_Lb_%s_W%d", Config.Stat, week) else "OrbClash_Lb_" .. Config.Stat
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	return if ok then store else nil
end

local function nameOf(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and type(name) == "string" then name else ("Player" .. userId)
	nameCache[userId] = result
	return result
end

local function fetch(store: OrderedDataStore?, size: number): { Entry }?
	if store == nil then
		return nil
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, size)
	end)
	if not ok then
		return nil
	end
	local entries: { Entry } = {}
	for rank, item in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { Rank = rank, UserId = userId, Name = "", Value = item.value })
		end
	end
	return entries
end

-- Board built from the players in this server (Studio / DataStore outage fallback).
local function localBoard(weekly: boolean): { Entry }
	local entries: { Entry } = {}
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		if profile then
			table.insert(entries, { Rank = 0, UserId = player.UserId, Name = player.Name, Value = statValue(profile, weekly) })
		end
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	for i, e in entries do
		e.Rank = i
	end
	return entries
end

local function refresh()
	local allTime = fetch(storeFor(nil), 100) or localBoard(false)
	local weekly = fetch(storeFor(weekIndex()), 100) or localBoard(true)
	local ranks: { [string]: { AllTime: number?, Weekly: number? } } = {}
	for _, player in Players:GetPlayers() do
		ranks[tostring(player.UserId)] = {}
	end
	for _, e in allTime do
		local r = ranks[tostring(e.UserId)]
		if r then
			r.AllTime = e.Rank
		end
	end
	for _, e in weekly do
		local r = ranks[tostring(e.UserId)]
		if r then
			r.Weekly = e.Rank
		end
	end
	local function top(list: { Entry }): { Entry }
		local out = {}
		for i = 1, math.min(Config.Size, #list) do
			local e = list[i]
			e.Name = if e.Name ~= "" then e.Name else nameOf(e.UserId)
			table.insert(out, e)
		end
		return out
	end
	latest = {
		Stat = Config.Stat,
		AllTime = top(allTime),
		Weekly = top(weekly),
		Ranks = ranks,
		WeekEndsAt = weekEndsAt(),
		Rewards = Economy.WeeklyRewards,
	}
	boardRemote:FireAllClients(latest)
end

local function updateLeaderstats(player: Player, profile: Profile)
	local stats = player:FindFirstChild("leaderstats")
	if stats == nil then
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
		stats = folder
	end
	local container = stats :: Instance
	local wins = container:FindFirstChild("Wins") :: IntValue?
	if wins == nil then
		local value = Instance.new("IntValue")
		value.Name = "Wins"
		value.Parent = container
		wins = value
	end
	(wins :: IntValue).Value = profile.Stats.Wins
end

local function flush(player: Player)
	local profile = DataService.Get(player)
	if profile == nil then
		return
	end
	dirty[player] = nil
	local key = tostring(player.UserId)
	local allTime = storeFor(nil)
	local weekly = storeFor(weekIndex())
	if allTime then
		pcall(function()
			allTime:SetAsync(key, statValue(profile, false))
		end)
	end
	if weekly then
		local value = statValue(profile, true)
		if value > 0 then
			pcall(function()
				weekly:SetAsync(key, value)
			end)
		end
	end
end

-- Pays last week's top 3 (once per week, on join).
local function payWeekly(player: Player, profile: Profile)
	local lastWeek = weekIndex() - 1
	local key = tostring(lastWeek)
	if profile.Flags.WeeklyPaid[key] then
		return
	end
	local entries = fetch(storeFor(lastWeek), 3)
	if entries == nil then
		return -- try again next join
	end
	local rank: number? = nil
	for _, e in entries do
		if e.UserId == player.UserId then
			rank = e.Rank
		end
	end
	DataService.Update(player, function(p)
		p.Flags.WeeklyPaid[key] = true
		return true
	end)
	local reward = if rank then Economy.WeeklyRewards[rank] else nil
	if reward then
		EconomyService.GrantItem(player, "Ticket", reward.Ticket, reward.Count)
		rewardRemote:FireClient(player, { Kind = "Weekly", Rank = rank, Ticket = reward.Ticket, Count = reward.Count })
	end
end

function LeaderboardService.Init()
	boardRemote = Remotes.Event("LeaderboardData")
	rewardRemote = Remotes.Event("RewardPopup")
	if DataService.IsMock() then
		storesOk = false
	end
end

function LeaderboardService.Start()
	DataService.Loaded:Connect(function(player: Player, profile: Profile)
		updateLeaderstats(player, profile)
		boardRemote:FireClient(player, latest)
		task.spawn(payWeekly, player, profile)
	end)
	DataService.Changed:Connect(function(player: Player, profile: Profile)
		updateLeaderstats(player, profile)
		dirty[player] = true
	end)
	DataService.Releasing:Connect(function(player: Player, _profile: Profile)
		if dirty[player] then
			flush(player)
		end
		dirty[player] = nil
	end)
	task.spawn(function()
		while true do
			for player in dirty do
				if player.Parent then
					flush(player)
				end
			end
			task.wait(Config.RefreshSeconds / 2)
		end
	end)
	task.spawn(function()
		task.wait(3)
		while true do
			pcall(refresh)
			task.wait(Config.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">LevelService</string>
            <string name="Source"><![CDATA[--!strict
-- XP and levels. Every level-up grants the reward from LevelRewards (reference: "Lv 3 Reward").
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local LevelRewards = require(Shared.Definitions.LevelRewards)
local Remotes = require(Shared.Net.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local LevelService = {}

local rewardRemote: RemoteEvent

function LevelService.Init()
	rewardRemote = Remotes.Event("RewardPopup")
end

-- Returns { Levels = {gained levels}, XP = amount }
function LevelService.AddXP(player: Player, amount: number): { [string]: any }
	local gained: { number } = {}
	DataService.Update(player, function(profile)
		profile.XP += math.max(0, math.floor(amount))
		while profile.Level < Economy.MaxLevel and profile.XP >= Economy.XPToNext(profile.Level) do
			profile.XP -= Economy.XPToNext(profile.Level)
			profile.Level += 1
			table.insert(gained, profile.Level)
		end
		return true
	end)
	for _, level in gained do
		local reward = LevelRewards.For(level)
		EconomyService.GrantReward(player, reward :: any)
		rewardRemote:FireClient(player, { Kind = "LevelUp", Level = level, Reward = reward })
	end
	return { Levels = gained, XP = amount }
end

return LevelService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the compact lobby from Config/Lobby: navy plaza, duel hall, bridge, chevron path,
-- props (gacha machine, displays, group pedestal, leaderboards, decor orb), spawn and lighting.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lobby = require(Shared.Config.Lobby)
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local PropFactory = require(Shared.Visual.PropFactory)
local WorldLabel = require(Shared.Visual.WorldLabel)

local P = PropFactory.Part
local C = Lobby.Colors

local LobbyService = {}

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function yawCFrame(pos: Vector3, yaw: number): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw), 0)
end

-- A raised platform with a trimmed edge.
local function platform(parent: Instance, name: string, center: Vector3, sizeX: number, sizeZ: number, height: number)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	P(folder, { Name = "Slab", Size = Vector3.new(sizeX, height, sizeZ), CFrame = CFrame.new(center + Vector3.new(0, -height / 2, 0)), Color = C.Floor })
	local t = 1.4
	-- top border trim
	P(folder, { Name = "TrimN", Size = Vector3.new(sizeX, 0.1, t), CFrame = CFrame.new(center + Vector3.new(0, 0.05, -sizeZ / 2 + t / 2)), Color = C.Trim, CanCollide = false })
	P(folder, { Name = "TrimS", Size = Vector3.new(sizeX, 0.1, t), CFrame = CFrame.new(center + Vector3.new(0, 0.05, sizeZ / 2 - t / 2)), Color = C.Trim, CanCollide = false })
	P(folder, { Name = "TrimW", Size = Vector3.new(t, 0.1, sizeZ), CFrame = CFrame.new(center + Vector3.new(-sizeX / 2 + t / 2, 0.05, 0)), Color = C.Trim, CanCollide = false })
	P(folder, { Name = "TrimE", Size = Vector3.new(t, 0.1, sizeZ), CFrame = CFrame.new(center + Vector3.new(sizeX / 2 - t / 2, 0.05, 0)), Color = C.Trim, CanCollide = false })
	-- glowing side band
	for _, spec in {
		{ Vector3.new(sizeX + 0.2, 0.5, 0.2), Vector3.new(0, -0.6, -sizeZ / 2) },
		{ Vector3.new(sizeX + 0.2, 0.5, 0.2), Vector3.new(0, -0.6, sizeZ / 2) },
		{ Vector3.new(0.2, 0.5, sizeZ + 0.2), Vector3.new(-sizeX / 2, -0.6, 0) },
		{ Vector3.new(0.2, 0.5, sizeZ + 0.2), Vector3.new(sizeX / 2, -0.6, 0) },
	} do
		P(folder, { Name = "Band", Size = spec[1], CFrame = CFrame.new(center + spec[2]), Color = C.TrimGlow, Material = Enum.Material.Neon, CanCollide = false })
	end
	-- subtle floor grid lines
	local step = 20
	for x = -sizeX / 2 + step, sizeX / 2 - step, step do
		P(folder, { Name = "Grid", Size = Vector3.new(0.25, 0.04, sizeZ - 3), CFrame = CFrame.new(center + Vector3.new(x, 0.02, 0)), Color = C.FloorDark, CanCollide = false, CastShadow = false })
	end
	for z = -sizeZ / 2 + step, sizeZ / 2 - step, step do
		P(folder, { Name = "Grid", Size = Vector3.new(sizeX - 3, 0.04, 0.25), CFrame = CFrame.new(center + Vector3.new(0, 0.02, z)), Color = C.FloorDark, CanCollide = false, CastShadow = false })
	end
	return folder
end

-- Invisible boundary walls with an optional gap (so players can't fall off).
local function boundary(parent: Instance, a: Vector3, b: Vector3, gapFrom: number?, gapTo: number?)
	local alongX = math.abs(b.X - a.X) > math.abs(b.Z - a.Z)
	local function wall(from: number, to: number)
		if to - from < 0.5 then
			return
		end
		local mid = (from + to) / 2
		local size = if alongX then Vector3.new(to - from, 14, 1) else Vector3.new(1, 14, to - from)
		local pos = if alongX then Vector3.new(mid, 7, a.Z) else Vector3.new(a.X, 7, mid)
		P(parent, { Name = "Boundary", Size = size, CFrame = CFrame.new(pos), Color = "#000000", Transparency = 1, CastShadow = false })
	end
	local lo = if alongX then math.min(a.X, b.X) else math.min(a.Z, b.Z)
	local hi = if alongX then math.max(a.X, b.X) else math.max(a.Z, b.Z)
	if gapFrom and gapTo then
		wall(lo, gapFrom)
		wall(gapTo, hi)
	else
		wall(lo, hi)
	end
end

local function chevrons(parent: Instance)
	local path = Lobby.Chevrons.Path
	local spacing = Lobby.Chevrons.Spacing
	local carry = 0
	for i = 1, #path - 1 do
		local a, b = v3(path[i]), v3(path[i + 1])
		local seg = b - a
		local len = seg.Magnitude
		local dir = seg.Unit
		local d = carry
		while d < len do
			local pos = a + dir * d + Vector3.new(0, 0.06, 0)
			local base = CFrame.lookAt(pos, pos + dir)
			for side = -1, 1, 2 do
				-- each arm angles back from the tip
				local arm = base * CFrame.Angles(0, math.rad(side * 40), 0) * CFrame.new(0, 0, 1.4)
				P(parent, { Name = "Chevron", Size = Vector3.new(0.9, 0.08, 3.2), CFrame = arm, Color = C.Chevron, CanCollide = false, CastShadow = false })
			end
			d += spacing
		end
		carry = d - len
	end
end

local function labelAbove(part: BasePart, height: number, text: string, color: string, size: number?)
	local s = size or 1
	WorldLabel.Create(part, {
		Name = "Title",
		Size = Vector2.new(12 * s, 3 * s),
		Offset = Vector3.new(0, height, 0),
		Lines = { { Text = text, Color = color, Height = 1 } },
	})
end

local function addPrompt(part: BasePart, action: string, object: string, attributes: { [string]: any })
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 3, 0)
	attachment.Parent = part
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	for k, v in attributes do
		prompt:SetAttribute(k, v)
	end
	prompt.Parent = attachment
	CollectionService:AddTag(prompt, "UIPrompt")
end

local function buildProp(parent: Instance, prop: Lobby.PropConfig)
	local cf = yawCFrame(v3(prop.Position), prop.Yaw)
	local model: Model
	if prop.Kind == "GachaMachine" then
		model = PropFactory.GachaMachine(false)
		model:PivotTo(cf)
		labelAbove(model.PrimaryPart :: BasePart, 14.5, prop.Label or "", "#9FD8FF", 1.1)
		addPrompt(model.PrimaryPart :: BasePart, "Open Store", prop.Label or "", { OpenUI = prop.OpenUI })
		-- a second, advanced machine beside it
		local adv = PropFactory.GachaMachine(true)
		adv:PivotTo(cf * CFrame.new(-11, 0, -3) * CFrame.Angles(0, math.rad(12), 0))
		labelAbove(adv.PrimaryPart :: BasePart, 14.5, "Advanced", "#D9B3FF", 1.0)
		addPrompt(adv.PrimaryPart :: BasePart, "Open Store", "Advanced Orbs", { OpenUI = "Store:Balls" })
		adv.Parent = parent
	elseif prop.Kind == "CrateDisplay" then
		model = PropFactory.CrateDisplay()
		model:PivotTo(cf)
		labelAbove(model.PrimaryPart :: BasePart, 9, prop.Label or "", "#E3BFFF")
		addPrompt(model.PrimaryPart :: BasePart, "Open Store", prop.Label or "", { OpenUI = prop.OpenUI })
	elseif prop.Kind == "FlyerDisplay" then
		model = PropFactory.FlyerDisplay()
		model:PivotTo(cf)
		labelAbove(model.PrimaryPart :: BasePart, 14, prop.Label or "", "#9FD8FF")
		addPrompt(model.PrimaryPart :: BasePart, "Open Store", prop.Label or "", { OpenUI = prop.OpenUI })
	elseif prop.Kind == "EventDisplay" then
		model = PropFactory.EventDisplay()
		model:PivotTo(cf)
		local event = GachaDefinitions.Get("HarvestCrate")
		local anchor = model.PrimaryPart :: BasePart
		local gui = WorldLabel.Create(anchor, {
			Name = "EventLabel",
			Size = Vector2.new(14, 5),
			Offset = Vector3.new(0, 11, 0),
			Lines = {
				{ Name = "Title", Text = "Harvest Moon", Color = "#FFB347", Height = 1.1 },
				{ Name = "Timer", Text = "", Color = "#E3BFFF", Height = 0.8 },
			},
		})
		gui:SetAttribute("EndsAt", if event then event.EndsAt else 0)
		CollectionService:AddTag(gui, "EventTimer")
		addPrompt(anchor, "Open Store", "Event", { OpenUI = prop.OpenUI })
	elseif prop.Kind == "GroupPedestal" then
		model = PropFactory.GroupPedestal()
		model:PivotTo(cf)
		local anchor = model.PrimaryPart :: BasePart
		WorldLabel.Create(anchor, {
			Name = "GroupLabel",
			Size = Vector2.new(16, 5),
			Offset = Vector3.new(0, 8.5, 0),
			Lines = {
				{ Text = "Like + Join Group", Color = "#FFA000", Height = 1 },
				{ Text = "Advanced Orb Gacha +1", Color = "#FFE14D", Height = 0.9 },
			},
		})
		addPrompt(anchor, "Claim Reward", "Group Reward", { Action = "ClaimGroup" })
	elseif prop.Kind == "Leaderboard" then
		model = PropFactory.Leaderboard()
		model:PivotTo(cf)
		model:SetAttribute("BoardKind", prop.Label)
		CollectionService:AddTag(model, "Leaderboard")
	elseif prop.Kind == "DecorOrb" then
		model = PropFactory.DecorOrb()
		model:PivotTo(cf)
		CollectionService:AddTag(model, "Bob")
	else
		return
	end
	model.Name = prop.Id
	model.Parent = parent
	for _, child in model:GetDescendants() do
		if child:IsA("Model") and child:GetAttribute("Bob") then
			CollectionService:AddTag(child, "Bob")
		end
	end
end

local function setupLighting()
	Lighting.Ambient = Color3.fromRGB(118, 122, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 152, 165)
	Lighting.Brightness = 2.2
	Lighting.ClockTime = 14.2
	Lighting.GeographicLatitude = 30
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.7
	Lighting.GlobalShadows = true
	Lighting.FogColor = Color3.fromHex(C.Void)
	Lighting.FogStart = 400
	Lighting.FogEnd = 2000
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.42
	atmosphere.Offset = 0
	atmosphere.Color = Color3.fromRGB(199, 200, 206)
	atmosphere.Decay = Color3.fromRGB(160, 162, 172)
	atmosphere.Glare = 0
	atmosphere.Haze = 2.2
	atmosphere.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = false
	sky.StarCount = 0
	sky.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 22
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Contrast = 0.06
	cc.Saturation = 0.12
	cc.Parent = Lighting
end

function LobbyService.Init()
	local lobby = Workspace:FindFirstChild("Lobby") or Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = Workspace

	-- remove a default baseplate / spawn if the place has one
	for _, child in Workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	local plaza = Lobby.Plaza
	local hall = Lobby.Hall
	local bridge = Lobby.Bridge
	platform(lobby, "Plaza", v3(plaza.Center), plaza.Size[1], plaza.Size[2], plaza.Height)
	platform(lobby, "Hall", v3(hall.Center), hall.Size[1], hall.Size[2], hall.Height)
	local bFrom, bTo = v3(bridge.From), v3(bridge.To)
	local bridgeLen = (bTo - bFrom).Magnitude
	platform(lobby, "Bridge", (bFrom + bTo) / 2, bridgeLen + 4, bridge.Width, plaza.Height)

	-- boundaries (with gaps where the bridge joins)
	local walls = Instance.new("Folder")
	walls.Name = "Boundaries"
	walls.Parent = lobby
	local px, pz = plaza.Size[1] / 2, plaza.Size[2] / 2
	local pc = v3(plaza.Center)
	local gapLo, gapHi = bFrom.Z - bridge.Width / 2, bFrom.Z + bridge.Width / 2
	boundary(walls, pc + Vector3.new(-px, 0, -pz), pc + Vector3.new(px, 0, -pz))
	boundary(walls, pc + Vector3.new(-px, 0, pz), pc + Vector3.new(px, 0, pz))
	boundary(walls, pc + Vector3.new(-px, 0, -pz), pc + Vector3.new(-px, 0, pz))
	boundary(walls, pc + Vector3.new(px, 0, -pz), pc + Vector3.new(px, 0, pz), gapLo, gapHi)
	local hc = v3(hall.Center)
	local hx, hz = hall.Size[1] / 2, hall.Size[2] / 2
	boundary(walls, hc + Vector3.new(-hx, 0, -hz), hc + Vector3.new(hx, 0, -hz))
	boundary(walls, hc + Vector3.new(-hx, 0, hz), hc + Vector3.new(hx, 0, hz))
	boundary(walls, hc + Vector3.new(-hx, 0, -hz), hc + Vector3.new(-hx, 0, hz), gapLo, gapHi)
	boundary(walls, hc + Vector3.new(hx, 0, -hz), hc + Vector3.new(hx, 0, hz))
	boundary(walls, bFrom + Vector3.new(0, 0, -bridge.Width / 2), bTo + Vector3.new(0, 0, -bridge.Width / 2))
	boundary(walls, bFrom + Vector3.new(0, 0, bridge.Width / 2), bTo + Vector3.new(0, 0, bridge.Width / 2))

	-- hall back walls with light strips behind the stations
	for _, z in { hc.Z - hz - 0.5, hc.Z + hz + 0.5 } do
		P(lobby, { Name = "HallWall", Size = Vector3.new(hall.Size[1], 30, 1), CFrame = CFrame.new(hc.X, 15, z), Color = "#141C33" })
		for y = 6, 26, 10 do
			P(lobby, { Name = "WallStrip", Size = Vector3.new(hall.Size[1] - 6, 0.4, 0.2), CFrame = CFrame.new(hc.X, y, z + (if z < hc.Z then 0.6 else -0.6)), Color = C.Trim, Material = Enum.Material.Neon, CanCollide = false })
		end
	end
	local signAnchor = P(lobby, { Name = "HallSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(hc.X - hx + 6, 16, hc.Z), Color = "#000000", Transparency = 1, CanCollide = false })
	WorldLabel.Create(signAnchor, {
		Name = "Sign",
		Size = Vector2.new(30, 6),
		MaxDistance = 400,
		Lines = { { Text = "BATTLE ARENAS", Color = "#FFFFFF", Height = 1 }, { Text = "1V1", Color = "#59A8FF", Height = 0.7 } },
	})

	local chevronFolder = Instance.new("Folder")
	chevronFolder.Name = "Chevrons"
	chevronFolder.Parent = lobby
	chevrons(chevronFolder)

	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = lobby
	for _, prop in Lobby.Props do
		buildProp(props, prop)
	end

	-- 2v2 sign over the team station
	for _, station in Lobby.Stations do
		if station.Mode == "2v2" then
			local anchor = P(lobby, { Name = "TeamSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(v3(station.Position) + Vector3.new(0, 30, 0)), Color = "#000000", Transparency = 1, CanCollide = false })
			WorldLabel.Create(anchor, { Name = "Sign", Size = Vector2.new(16, 6), MaxDistance = 400, Lines = { { Text = "2V2", Color = "#FFFFFF", Height = 1 } } })
		end
	end

	-- spawn
	local spawnCfg = Lobby.Spawn
	local spawnPos = v3(spawnCfg.Position) + Vector3.new(0, 0.5, 0)
	local facing = Vector3.new(math.sin(math.rad(spawnCfg.Yaw)), 0, math.cos(math.rad(spawnCfg.Yaw)))
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.lookAt(spawnPos, spawnPos + facing)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = lobby
	P(lobby, { Name = "SpawnRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 12, 12), CFrame = PropFactory.Upright(CFrame.new(spawnPos - Vector3.new(0, 0.42, 0))), Color = C.TrimGlow, Material = Enum.Material.Neon, CanCollide = false })
	P(lobby, { Name = "SpawnDisc", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.14, 10.6, 10.6), CFrame = PropFactory.Upright(CFrame.new(spawnPos - Vector3.new(0, 0.4, 0))), Color = C.FloorDark, CanCollide = false })

	setupLighting()
	Workspace.FallenPartsDestroyHeight = -60
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
-- Runs every live match (many arenas per server), routes validated player input to the
-- right match, and hands stations back to the queue when matches close.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)

local Server = script.Parent.Parent
local Match = require(Server.Battle.Match)
local Guard = require(Server.Util.Guard)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local BallService = require(script.Parent.BallService)
local AbilityService = require(script.Parent.AbilityService)
local RewardService = require(script.Parent.RewardService)
local ArenaService = require(script.Parent.ArenaService)
local BattleReplicator = require(script.Parent.BattleReplicator)

local MatchService = {}

local matches: { Match.Match } = {}
local byPlayer: { [Player]: Match.Match } = {}
local deps: Match.Deps
local queue: any -- QueueService (late-bound to avoid a require cycle)

function MatchService.InMatch(player: Player): boolean
	return if byPlayer[player] then true else false
end

function MatchService.Get(player: Player): Match.Match?
	return byPlayer[player]
end

function MatchService.Create(station: any, specs: { Match.ParticipantSpec }, practice: boolean): Match.Match
	local match = Match.new(deps, station, specs, practice)
	station.Match = match
	station.State = "InMatch"
	ArenaService.SetIdleVisuals(station, false)
	for _, p in match.Participants do
		if p.Player then
			byPlayer[p.Player] = match
		end
	end
	table.insert(matches, match)
	BattleReplicator.Attach(station, function()
		return match:Players()
	end, function()
		return match:FullState()
	end, function()
		return match:PublicState()
	end)
	match:Start()
	return match
end

local function onClosed(match: Match.Match)
	local i = table.find(matches, match)
	if i then
		table.remove(matches, i)
	end
	local station = match.Station
	for _, p in match.Participants do
		local player = p.Player
		if player and byPlayer[player] == match then
			byPlayer[player] = nil
		end
	end
	BattleReplicator.Detach(station)
	station.Match = nil
	task.delay(0.1, function()
		queue.ReleaseStation(station, match)
	end)
end

function MatchService.Init(registry: { [string]: any })
	queue = registry.QueueService
	local notify = Remotes.Event("Notify")
	deps = {
		BallService = BallService,
		AbilityService = AbilityService,
		EconomyService = EconomyService,
		DataService = DataService,
		RewardService = RewardService,
		ArenaService = ArenaService,
		Replicator = BattleReplicator,
		PrivateRemote = Remotes.Event("MatchPrivate"),
		Notify = function(player: Player, text: string)
			notify:FireClient(player, { Text = text, Kind = "Error" })
		end,
		OnPublicChanged = function(match: any)
			queue.BroadcastStation(match.Station)
		end,
		OnClosed = onClosed,
	}
end

function MatchService.Start()
	Guard.OnEvent(Remotes.Event("SelectionRequest"), 6, 10, function(player: Player, action: any, arg: any)
		if not Validate.OneOf(action, { "Pick", "Reroll", "Collection" }) then
			return
		end
		local match = byPlayer[player]
		if match then
			match:HandleSelection(player, action, arg)
		end
	end)
	Guard.OnUnreliable(Remotes.Unreliable("AimUpdate"), 15, 20, function(player: Player, angle: any)
		local match = byPlayer[player]
		if match then
			match:HandleAim(player, angle, false)
		end
	end)
	Guard.OnEvent(Remotes.Event("AimLock"), 4, 6, function(player: Player, angle: any)
		local match = byPlayer[player]
		if match then
			match:HandleAim(player, angle, true)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local match = byPlayer[player]
		byPlayer[player] = nil
		if match then
			match:OnPlayerLeft(player)
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		for _, match: any in table.clone(matches) do
			local ok, err = pcall(function()
				match:Update(dt)
			end)
			if not ok then
				warn("[MatchService] match update failed: " .. tostring(err))
				pcall(function()
					match:Abort(tostring(err))
				end)
				if not match.Closed then
					onClosed(match)
				end
			end
		end
	end)
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Gem developer products. Purchases are granted exactly once per receipt (idempotent via the
-- profile's receipt log) and only confirmed to Roblox after the profile has been saved.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Lobby = require(Shared.Config.Lobby)

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

local byProductId: { [number]: typeof(Economy.GemProducts[1]) } = {}
local byKey: { [string]: typeof(Economy.GemProducts[1]) } = {}

local function weekIndex(): number
	return (os.time() - Lobby.Leaderboards.WeekEpochOffset) // 604800
end

local function grantGems(profile: DataService.Profile, gems: number, robux: number)
	profile.Gems = math.min(profile.Gems + gems, Economy.Limits.MaxGems)
	profile.Stats.RobuxSpent += robux
	local week = weekIndex()
	if profile.Weekly.Week ~= week then
		profile.Weekly.Week = week
		profile.Weekly.Wins = 0
		profile.Weekly.RobuxSpent = 0
	end
	profile.Weekly.RobuxSpent += robux
end

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local product = byProductId[receipt.ProductId]
	if product == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.WaitFor(player, 15)
	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	local already = table.find(profile.Receipts, purchaseId) ~= nil
	if not already then
		DataService.Update(player, function(p)
			grantGems(p, product.Gems, receipt.CurrencySpent or product.Robux)
			table.insert(p.Receipts, purchaseId)
			while #p.Receipts > 50 do
				table.remove(p.Receipts, 1)
			end
			return true
		end)
	end
	if not DataService.SaveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Client asked to buy a gem pack (by key). Real products prompt Roblox's purchase dialog; packs
-- without a configured ProductId are free test grants inside Studio only.
function MonetizationService.RequestGemPack(player: Player, key: any): { [string]: any }
	local product = if type(key) == "string" then byKey[key] else nil
	if product == nil then
		return { ok = false, error = "Unknown pack." }
	end
	if product.ProductId == 0 then
		if RunService:IsStudio() then
			DataService.Update(player, function(p)
				grantGems(p, product.Gems, 0)
				return true
			end)
			return { ok = true, message = string.format("Studio test: +%d Gems", product.Gems) }
		end
		return { ok = false, error = "This pack is not available yet." }
	end
	MarketplaceService:PromptProductPurchase(player, product.ProductId)
	return { ok = true, prompted = true }
end

function MonetizationService.Init()
	for _, product in Economy.GemProducts do
		byKey[product.Key] = product
		if product.ProductId ~= 0 then
			byProductId[product.ProductId] = product
		end
	end
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Daily quests (reset at 00:00 UTC). Progress is driven by server-side match results only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestDefinitions = require(Shared.Definitions.QuestDefinitions)
local Remotes = require(Shared.Net.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

type Profile = DataService.Profile

local QuestService = {}

local notify: RemoteEvent

local function ensureToday(profile: Profile)
	local today = QuestDefinitions.DayIndex(os.time())
	if profile.Quests.Day ~= today then
		profile.Quests.Day = today
		profile.Quests.Progress = {}
		profile.Quests.Done = {}
	end
end

function QuestService.Init()
	notify = Remotes.Event("Notify")
	DataService.Loaded:Connect(function(player: Player, _profile: Profile)
		DataService.Update(player, function(p)
			ensureToday(p)
			return true
		end)
	end)
end

function QuestService.Start()
	-- roll quests over for players who stay online across midnight
	task.spawn(function()
		while true do
			task.wait(30)
			for _, player in game:GetService("Players"):GetPlayers() do
				local profile = DataService.Get(player)
				if profile and profile.Quests.Day ~= QuestDefinitions.DayIndex(os.time()) then
					DataService.Update(player, function(p)
						ensureToday(p)
						return true
					end)
				end
			end
		end
	end)
end

function QuestService.Progress(player: Player, event: string, amount: number?)
	local completed: { QuestDefinitions.Quest } = {}
	DataService.Update(player, function(profile)
		ensureToday(profile)
		for _, quest in QuestDefinitions.Daily do
			if quest.Event == event and not profile.Quests.Done[quest.Id] then
				local value = math.min(quest.Goal, (profile.Quests.Progress[quest.Id] or 0) + (amount or 1))
				profile.Quests.Progress[quest.Id] = value
				if value >= quest.Goal then
					profile.Quests.Done[quest.Id] = true
					table.insert(completed, quest)
				end
			end
		end
		return true
	end)
	for _, quest in completed do
		EconomyService.AddCurrency(player, "Coins", quest.Reward.Coins)
		notify:FireClient(player, { Text = string.format("Quest complete: %s  +%d", quest.Title, quest.Reward.Coins), Kind = "Quest" })
	end
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">QueueService</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby matchmaking through the battle pads (reference: walk onto a pad, press E, "1/2 PLAYERS",
-- Invite / Leave panel) plus the green Play button (quick-join) and practice bots.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.Game)
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)

local DataService = require(script.Parent.DataService)
local ArenaService = require(script.Parent.ArenaService)
local MatchService = require(script.Parent.MatchService)

type Station = ArenaService.Station
type Pad = ArenaService.Pad

local QueueService = {}

local padOf: { [Player]: { Station: Station, Pad: Pad } } = {}
type Invite = { From: Player, To: Player, Station: Station, Expires: number }
local invites: { [string]: Invite } = {}
local foundTokens: { [Station]: number } = {}
local tradingService: any

local stationRemote: RemoteEvent
local notifyRemote: RemoteEvent
local inviteRemote: RemoteEvent

local function notify(player: Player, text: string, kind: string?)
	notifyRemote:FireClient(player, { Text = text, Kind = kind or "Error" })
end

local function busyReason(player: Player): string?
	if MatchService.InMatch(player) then
		return "You're already in a battle."
	end
	if tradingService and tradingService.IsTrading(player) then
		return "Finish your trade first."
	end
	return nil
end

function QueueService.IsQueued(player: Player): boolean
	return padOf[player] ~= nil
end

local function stationPayload(station: Station): { [string]: any }
	local pads = {}
	for _, pad in station.Pads do
		local occupant = pad.Occupant
		local bot = pad.Bot
		table.insert(pads, {
			Team = pad.Team,
			UserId = if occupant then occupant.UserId elseif bot then bot.Id else 0,
			Name = if occupant then occupant.DisplayName elseif bot then bot.Name else "",
		})
	end
	return {
		Id = station.Id,
		Index = station.Index,
		Mode = station.Mode,
		State = station.State,
		Capacity = #station.Pads,
		Pads = pads,
		Match = if station.Match then station.Match:Summary() else nil,
	}
end

function QueueService.BroadcastStation(station: Station)
	stationRemote:FireAllClients(stationPayload(station))
end

local function destroyBot(pad: Pad)
	local bot = pad.Bot
	if bot and bot.Model then
		bot.Model:Destroy()
	end
	pad.Bot = nil
end

local function spawnBot(station: Station, pad: Pad, n: number)
	local bot: { [string]: any } = { Name = GameConfig.Bots.Name, Id = -n, Model = nil }
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if ok and model then
		model.Name = GameConfig.Bots.Name
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayName = GameConfig.Bots.Name
		end
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = true
		end
		model:PivotTo(ArenaService.PadCFrame(station, pad.Index))
		model.Parent = station.Model
		bot.Model = model
	end
	pad.Bot = bot
end

local function updatePrompts(station: Station)
	for _, pad in station.Pads do
		pad.Prompt.Enabled = station.State ~= "InMatch" and station.State ~= "MatchFound" and pad.Occupant == nil and pad.Bot == nil
	end
end

local function startMatch(station: Station)
	local specs: { any } = {}
	local practice = false
	for _, pad in station.Pads do
		local bot = pad.Bot
		if pad.Occupant then
			table.insert(specs, { Player = pad.Occupant, Team = pad.Team, Pad = pad.Index })
		elseif bot then
			practice = true
			table.insert(specs, { BotName = bot.Name, BotId = bot.Id, Team = pad.Team, Pad = pad.Index })
		end
	end
	MatchService.Create(station, specs, practice)
	updatePrompts(station)
	QueueService.BroadcastStation(station)
end

local function refreshStation(station: Station)
	if station.State == "InMatch" then
		updatePrompts(station)
		return
	end
	local count = ArenaService.Occupants(station)
	local capacity = #station.Pads
	local humans = 0
	for _, pad in station.Pads do
		if pad.Occupant then
			humans += 1
		end
	end
	if humans == 0 then
		-- no humans left: clear any practice bots
		for _, pad in station.Pads do
			destroyBot(pad)
		end
		count = 0
	end
	if count >= capacity then
		station.State = "MatchFound"
		local token = (foundTokens[station] or 0) + 1
		foundTokens[station] = token
		task.spawn(function()
			for remaining = GameConfig.Timings.MatchFoundCountdown, 1, -1 do
				if foundTokens[station] ~= token or station.State ~= "MatchFound" then
					return
				end
				ArenaService.SetLabel(station, string.format("STARTING IN %d", remaining), "#7CFF6B")
				task.wait(1)
			end
			if foundTokens[station] == token and station.State == "MatchFound" and ArenaService.Occupants(station) >= capacity then
				startMatch(station)
			end
		end)
	else
		foundTokens[station] = (foundTokens[station] or 0) + 1
		station.State = if count == 0 then "Idle" else "Waiting"
		ArenaService.SetLabel(station, string.format("%d/%d PLAYERS", count, capacity))
	end
	updatePrompts(station)
	QueueService.BroadcastStation(station)
end

function QueueService.JoinPad(player: Player, station: Station, padIndex: number): boolean
	if DataService.Get(player) == nil then
		notify(player, "Still loading your data...")
		return false
	end
	local reason = busyReason(player)
	if reason then
		notify(player, reason)
		return false
	end
	if station.State == "InMatch" or station.State == "MatchFound" then
		notify(player, "This arena is busy. Try another one!")
		return false
	end
	local pad = station.Pads[padIndex]
	if pad == nil or pad.Occupant ~= nil or pad.Bot ~= nil then
		notify(player, "That spot is taken.")
		return false
	end
	if padOf[player] then
		QueueService.Leave(player, true)
	end
	pad.Occupant = player
	padOf[player] = { Station = station, Pad = pad }
	if GameConfig.LockCharactersOnPads then
		ArenaService.LockCharacter(player, ArenaService.PadCFrame(station, padIndex))
	end
	refreshStation(station)
	return true
end

function QueueService.Leave(player: Player, switching: boolean?): boolean
	local entry = padOf[player]
	if entry == nil then
		return false
	end
	local station = entry.Station
	if station.State == "InMatch" then
		return false
	end
	entry.Pad.Occupant = nil
	padOf[player] = nil
	if player.Parent then
		ArenaService.UnlockCharacter(player, if switching then nil else ArenaService.ReleaseCFrame(station, entry.Pad.Index))
	end
	refreshStation(station)
	return true
end

local function freePadFor(station: Station, preferTeam: number?): Pad?
	local counts = { 0, 0 }
	for _, pad in station.Pads do
		if pad.Occupant or pad.Bot then
			counts[pad.Team] += 1
		end
	end
	local best: Pad? = nil
	for _, pad in station.Pads do
		if pad.Occupant == nil and pad.Bot == nil then
			if preferTeam and pad.Team == preferTeam then
				return pad
			end
			if best == nil or counts[pad.Team] < counts[best.Team] then
				best = pad
			end
		end
	end
	return best
end

function QueueService.QuickPlay(player: Player, mode: string)
	local entry = padOf[player]
	if entry and entry.Station.Mode == mode then
		notify(player, "You're already waiting for a battle.", "Info")
		return
	end
	local best: Station? = nil
	local bestCount = -1
	for _, station in ArenaService.Stations do
		if station.Mode == mode and (station.State == "Idle" or station.State == "Waiting") and station ~= (entry and entry.Station) then
			local count = ArenaService.Occupants(station)
			if count < #station.Pads and count > bestCount then
				best = station
				bestCount = count
			end
		end
	end
	if best == nil then
		notify(player, "All arenas are busy right now. Try again in a moment!")
		return
	end
	local pad = freePadFor(best, nil)
	if pad then
		QueueService.JoinPad(player, best, pad.Index)
	end
end

function QueueService.Practice(player: Player)
	if not GameConfig.Bots.Enabled then
		return
	end
	local entry = padOf[player]
	if entry == nil or entry.Station.State ~= "Waiting" then
		notify(player, "Stand on a battle pad first.")
		return
	end
	local station = entry.Station
	local n = 0
	for _, pad in station.Pads do
		if pad.Occupant == nil and pad.Bot == nil then
			n += 1
			spawnBot(station, pad, n)
		end
	end
	refreshStation(station)
end

function QueueService.Invite(player: Player, targetUserId: any)
	if not Validate.Integer(targetUserId, 1, 2 ^ 53) then
		return
	end
	local entry = padOf[player]
	if entry == nil or entry.Station.State ~= "Waiting" or freePadFor(entry.Station, nil) == nil then
		notify(player, "Stand on a battle pad with a free spot to invite someone.")
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if target == nil or target == player then
		notify(player, "That player isn't in this server.")
		return
	end
	if busyReason(target) or padOf[target] then
		notify(player, target.DisplayName .. " is busy right now.")
		return
	end
	for id, inv in invites do
		if inv.From == player and inv.To == target and os.clock() < inv.Expires then
			notify(player, "Invite already sent.", "Info")
			return
		end
		if os.clock() >= inv.Expires then
			invites[id] = nil
		end
	end
	local id = HttpService:GenerateGUID(false)
	invites[id] = { From = player, To = target, Station = entry.Station, Expires = os.clock() + GameConfig.InviteTimeout }
	inviteRemote:FireClient(target, {
		InviteId = id,
		FromName = player.DisplayName,
		FromUserId = player.UserId,
		Mode = entry.Station.Mode,
		Timeout = GameConfig.InviteTimeout,
	})
	notify(player, "Invite sent to " .. target.DisplayName, "Info")
end

function QueueService.RespondInvite(player: Player, inviteId: any, accept: any)
	if type(inviteId) ~= "string" or #inviteId > 64 then
		return
	end
	local inv = invites[inviteId]
	invites[inviteId] = nil
	if inv == nil or inv.To ~= player or os.clock() >= inv.Expires then
		notify(player, "That invite has expired.")
		return
	end
	local from = inv.From
	if accept ~= true then
		if from.Parent then
			notify(from, player.DisplayName .. " declined your invite.", "Info")
		end
		return
	end
	local entry = padOf[from]
	if entry == nil or entry.Station ~= inv.Station or inv.Station.State ~= "Waiting" then
		notify(player, "That battle is no longer available.")
		return
	end
	local opposite = if entry.Pad.Team == 1 then 2 else 1
	local pad = freePadFor(inv.Station, if inv.Station.Mode == "1v1" then opposite else nil)
	if pad == nil then
		notify(player, "That battle is already full.")
		return
	end
	QueueService.JoinPad(player, inv.Station, pad.Index)
end

-- Called by MatchService after a match closes.
function QueueService.ReleaseStation(station: Station, _match: any)
	for _, pad in station.Pads do
		local occupant = pad.Occupant
		if occupant then
			padOf[occupant] = nil
			if occupant.Parent then
				ArenaService.UnlockCharacter(occupant, ArenaService.ReleaseCFrame(station, pad.Index))
			end
		end
		pad.Occupant = nil
		destroyBot(pad)
	end
	station.State = "Idle"
	station.Match = nil
	ArenaService.SetIdleVisuals(station, true)
	refreshStation(station)
end

function QueueService.Init(registry: { [string]: any })
	tradingService = registry.TradingService
	stationRemote = Remotes.Event("StationState")
	notifyRemote = Remotes.Event("Notify")
	inviteRemote = Remotes.Event("InviteReceived")
end

function QueueService.Start()
	ArenaService.PadTriggered:Connect(function(player: Player, station: Station, padIndex: number)
		local entry = padOf[player]
		if entry and entry.Station == station and entry.Pad.Index == padIndex then
			return
		end
		QueueService.JoinPad(player, station, padIndex)
	end)

	Guard.OnEvent(Remotes.Event("QueueRequest"), 4, 6, function(player: Player, action: any, arg: any)
		if action == "Play" then
			local mode = if arg == "2v2" then "2v2" else "1v1"
			QueueService.QuickPlay(player, mode)
		elseif action == "Leave" then
			QueueService.Leave(player)
		elseif action == "Practice" then
			QueueService.Practice(player)
		end
	end)
	Guard.OnEvent(Remotes.Event("InviteRequest"), 1, 3, function(player: Player, targetUserId: any)
		QueueService.Invite(player, targetUserId)
	end)
	Guard.OnEvent(Remotes.Event("InviteResponse"), 3, 5, function(player: Player, inviteId: any, accept: any)
		QueueService.RespondInvite(player, inviteId, accept)
	end)

	DataService.Loaded:Connect(function(player: Player)
		for _, station in ArenaService.Stations do
			stationRemote:FireClient(player, stationPayload(station))
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if padOf[player] and not MatchService.InMatch(player) then
			QueueService.Leave(player)
		end
		padOf[player] = nil
		for id, inv in invites do
			if inv.From == player or inv.To == player then
				invites[id] = nil
			end
		end
	end)
end

return QueueService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
-- Match rewards, first-battle gacha, and the Like + Join Group reward.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local GameConfig = require(Shared.Config.Game)
local Lobby = require(Shared.Config.Lobby)
local Remotes = require(Shared.Net.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LevelService = require(script.Parent.LevelService)
local QuestService = require(script.Parent.QuestService)

local RewardService = {}

local rewardRemote: RemoteEvent

function RewardService.Init()
	rewardRemote = Remotes.Event("RewardPopup")
end

export type MatchOutcome = {
	Won: boolean,
	Forfeit: boolean,
	Practice: boolean,
	VsFriend: boolean,
}

-- Grants and returns the reward summary shown on the results screen.
function RewardService.GrantMatch(player: Player, outcome: MatchOutcome): { [string]: any }
	local tier = if outcome.Won then (if outcome.Forfeit then Economy.MatchRewards.ForfeitWin else Economy.MatchRewards.Win) else Economy.MatchRewards.Loss
	local coins, xp = tier.Coins, tier.XP
	if outcome.Practice then
		coins = math.max(1, math.floor(coins * GameConfig.Bots.RewardMultiplier))
		xp = math.max(1, math.floor(xp * GameConfig.Bots.RewardMultiplier))
	end

	local firstBattle = false
	DataService.Update(player, function(profile)
		local stats = profile.Stats
		stats.Matches += 1
		if outcome.Won then
			stats.Wins += 1
			stats.Streak += 1
			stats.BestStreak = math.max(stats.BestStreak, stats.Streak)
		else
			stats.Losses += 1
			stats.Streak = 0
		end
		if not outcome.Practice then
			local week = (os.time() - Lobby.Leaderboards.WeekEpochOffset) // 604800
			if profile.Weekly.Week ~= week then
				profile.Weekly.Week = week
				profile.Weekly.Wins = 0
				profile.Weekly.RobuxSpent = 0
			end
			if outcome.Won then
				profile.Weekly.Wins += 1
			end
		end
		if not profile.Flags.FirstBattle then
			profile.Flags.FirstBattle = true
			firstBattle = true
		end
		return true
	end)

	EconomyService.AddCurrency(player, "Coins", coins)
	local levelInfo = LevelService.AddXP(player, xp)

	if not outcome.Practice then
		QuestService.Progress(player, "Play", 1)
		if outcome.Won then
			QuestService.Progress(player, "Win", 1)
		end
		if outcome.VsFriend then
			QuestService.Progress(player, "FriendDuel", 1)
		end
	end

	if firstBattle then
		EconomyService.GrantItem(player, "Ticket", Economy.FirstBattleTicket, 1)
	end

	local profile = DataService.Get(player)
	local summary = {
		Coins = coins,
		XP = xp,
		Level = if profile then profile.Level else 1,
		XPNow = if profile then profile.XP else 0,
		XPNeed = if profile then Economy.XPToNext(profile.Level) else 20,
		LevelsGained = levelInfo.Levels,
		Streak = if profile then profile.Stats.Streak else 0,
		Practice = outcome.Practice,
	}
	if firstBattle then
		-- shown after the results screen closes (CONFIRMED modal in the reference)
		task.delay(0.2, function()
			if player.Parent then
				rewardRemote:FireClient(player, { Kind = "FirstBattle", Ticket = Economy.FirstBattleTicket })
			end
		end)
	end
	return summary
end

function RewardService.ClaimGroup(player: Player): { [string]: any }
	local profile = DataService.Get(player)
	if profile == nil then
		return { ok = false, error = "Your data is still loading." }
	end
	if profile.Flags.GroupClaimed then
		return { ok = false, error = "You already claimed this reward." }
	end
	local groupId = Economy.Group.Id
	if groupId == 0 then
		if not RunService:IsStudio() then
			return { ok = false, error = "Group rewards are not set up yet." }
		end
	else
		local ok, inGroup = pcall(function()
			return player:IsInGroup(groupId)
		end)
		if not ok then
			return { ok = false, error = "Couldn't check the group. Try again." }
		end
		if not inGroup then
			return { ok = false, error = "Like the game and join the group first!" }
		end
	end
	local claimed = DataService.Update(player, function(p)
		if p.Flags.GroupClaimed then
			return false
		end
		p.Flags.GroupClaimed = true
		return EconomyService.AddToProfile(p, "Ticket", Economy.Group.RewardTicket, 1)
	end)
	if claimed ~= true then
		return { ok = false, error = "You already claimed this reward." }
	end
	rewardRemote:FireClient(player, { Kind = "Group", Ticket = Economy.Group.RewardTicket })
	return { ok = true, message = "Advanced Orb Gacha +1!" }
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">StoreService</string>
            <string name="Source"><![CDATA[--!strict
-- Single request endpoint (RemoteFunction) for store / inventory / rewards actions.
-- Every action is validated by the owning service; the client never states prices or results.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GachaService = require(script.Parent.GachaService)
local CodeService = require(script.Parent.CodeService)
local RewardService = require(script.Parent.RewardService)
local MonetizationService = require(script.Parent.MonetizationService)

local StoreService = {}

local handlers: { [string]: (Player, any, any) -> { [string]: any } } = {
	OpenCrate = function(player, crateId, count)
		return GachaService.Open(player, crateId, count)
	end,
	OpenTicket = function(player, crateId)
		return GachaService.OpenTicket(player, crateId)
	end,
	Equip = function(player, kind, id)
		if not Validate.OneOf(kind, { "Explosion", "Flyer" }) or not Validate.Id(id) then
			return { ok = false, error = "Invalid item." }
		end
		local ok = EconomyService.Equip(player, kind, id)
		return if ok then { ok = true } else { ok = false, error = "You don't own that." }
	end,
	RedeemCode = function(player, code)
		return CodeService.Redeem(player, code)
	end,
	ClaimGroup = function(player)
		return RewardService.ClaimGroup(player)
	end,
	BuyGems = function(player, key)
		return MonetizationService.RequestGemPack(player, key)
	end,
}

function StoreService.Start()
	Guard.OnInvoke(Remotes.Function("StoreRequest"), 4, 8, function(player: Player, action: any, a1: any, a2: any)
		if type(action) ~= "string" then
			return { ok = false, error = "Invalid request." }
		end
		local handler = handlers[action]
		if handler == nil then
			return { ok = false, error = "Invalid request." }
		end
		if DataService.Get(player) == nil then
			return { ok = false, error = "Your data is still loading." }
		end
		return handler(player, a1, a2)
	end)
end

return StoreService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">TradingService</string>
            <string name="Source"><![CDATA[--!strict
-- Secure two-party trading (CONFIRMED feature: items are marked "Tradable").
--
-- Flow: Request -> Accept -> both edit offers -> both Ready -> short Confirming countdown ->
-- atomic exchange. Any change to either offer clears both Ready flags. Ownership is checked
-- when items are offered AND again at execution, inside one non-yielding block, against the
-- session-locked profiles held by this server (so items cannot be duplicated).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Validate = require(Shared.Util.Validate)

local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local MatchService = require(script.Parent.MatchService)

local TradingService = {}

local CONFIRM_SECONDS = 4
local REQUEST_TIMEOUT = 20
local MAX_ENTRIES = 12

type Offer = { [string]: number } -- "Kind:Id" -> count
type Side = { Player: Player, Offer: Offer, Ready: boolean }
type Trade = {
	Id: string,
	A: Side,
	B: Side,
	Phase: "Offer" | "Confirming" | "Done",
	ConfirmAt: number?,
	Token: number,
}
type Request = { From: Player, To: Player, Expires: number }

local tradeOf: { [Player]: Trade } = {}
local requests: { [string]: Request } = {}
local queueService: any

local stateRemote: RemoteEvent
local notifyRemote: RemoteEvent

local function notify(player: Player, text: string, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, { Text = text, Kind = kind or "Error" })
	end
end

function TradingService.IsTrading(player: Player): boolean
	return tradeOf[player] ~= nil
end

local function sides(trade: Trade, player: Player): (Side, Side)
	if trade.A.Player == player then
		return trade.A, trade.B
	end
	return trade.B, trade.A
end

local function offerList(offer: Offer): { { Kind: string, Id: string, Count: number } }
	local list = {}
	for key, count in offer do
		local kind, id = string.match(key, "^(%a+):(.+)$")
		if kind and id then
			table.insert(list, { Kind = kind, Id = id, Count = count })
		end
	end
	table.sort(list, function(a, b)
		return a.Kind .. a.Id < b.Kind .. b.Id
	end)
	return list
end

local function push(trade: Trade, warning: string?)
	for _, side in { trade.A, trade.B } do
		local mine, theirs = sides(trade, side.Player)
		if side.Player.Parent then
			stateRemote:FireClient(side.Player, {
				Type = "State",
				TradeId = trade.Id,
				Partner = { UserId = theirs.Player.UserId, Name = theirs.Player.DisplayName },
				Mine = offerList(mine.Offer),
				Theirs = offerList(theirs.Offer),
				MyReady = mine.Ready,
				TheirReady = theirs.Ready,
				Phase = trade.Phase,
				ConfirmAt = trade.ConfirmAt,
				Warning = warning,
			})
		end
	end
end

local function close(trade: Trade, reason: string)
	if trade.Phase == "Done" then
		return
	end
	trade.Phase = "Done"
	trade.Token += 1
	for _, side in { trade.A, trade.B } do
		if tradeOf[side.Player] == trade then
			tradeOf[side.Player] = nil
		end
		if side.Player.Parent then
			stateRemote:FireClient(side.Player, { Type = "Closed", Reason = reason })
		end
	end
end

local function eligible(player: Player): string?
	if DataService.Get(player) == nil then
		return "still loading"
	end
	if MatchService.InMatch(player) then
		return "in a battle"
	end
	if queueService and queueService.IsQueued(player) then
		return "waiting on a battle pad"
	end
	if tradeOf[player] then
		return "already trading"
	end
	return nil
end

local function resetReady(trade: Trade)
	trade.A.Ready = false
	trade.B.Ready = false
	trade.Phase = "Offer"
	trade.ConfirmAt = nil
	trade.Token += 1
end

-- Validates and performs the swap atomically. Returns error text or nil.
local function execute(trade: Trade): string?
	local a, b = trade.A.Player, trade.B.Player
	local pa, pb = DataService.Get(a), DataService.Get(b)
	if pa == nil or pb == nil then
		return "A player's data is unavailable."
	end
	-- verify (no yields from here until the mutation is complete)
	local function verify(side: Side, profile: DataService.Profile): string?
		for _, item in offerList(side.Offer) do
			local bag = EconomyService.BagFor(profile, item.Kind)
			if bag == nil or not EconomyService.IsTradable(item.Kind, item.Id) or (bag[item.Id] or 0) < item.Count then
				return side.Player.DisplayName .. " no longer has everything they offered."
			end
		end
		return nil
	end
	local problem = verify(trade.A, pa) or verify(trade.B, pb)
	if problem then
		return problem
	end
	if next(trade.A.Offer) == nil and next(trade.B.Offer) == nil then
		return "The trade is empty."
	end
	-- mutate
	for _, item in offerList(trade.A.Offer) do
		EconomyService.AddToProfile(pa, item.Kind, item.Id, -item.Count)
		EconomyService.AddToProfile(pb, item.Kind, item.Id, item.Count)
	end
	for _, item in offerList(trade.B.Offer) do
		EconomyService.AddToProfile(pb, item.Kind, item.Id, -item.Count)
		EconomyService.AddToProfile(pa, item.Kind, item.Id, item.Count)
	end
	DataService.MarkChanged(a)
	DataService.MarkChanged(b)
	print(string.format("[Trade] %s <-> %s: %s | %s", a.Name, b.Name, HttpService:JSONEncode(trade.A.Offer), HttpService:JSONEncode(trade.B.Offer)))
	task.spawn(DataService.SaveNow, a)
	task.spawn(DataService.SaveNow, b)
	return nil
end

local function beginConfirm(trade: Trade)
	trade.Phase = "Confirming"
	trade.ConfirmAt = Workspace:GetServerTimeNow() + CONFIRM_SECONDS
	trade.Token += 1
	local token = trade.Token
	push(trade)
	task.delay(CONFIRM_SECONDS, function()
		if trade.Token ~= token or trade.Phase ~= "Confirming" then
			return
		end
		local err = execute(trade)
		if err then
			resetReady(trade)
			push(trade, err)
			return
		end
		close(trade, "Completed")
		notify(trade.A.Player, "Trade complete!", "Success")
		notify(trade.B.Player, "Trade complete!", "Success")
	end)
end

local function handle(player: Player, action: any, a1: any, a2: any, a3: any)
	if action == "Request" then
		if not Validate.Integer(a1, 1, 2 ^ 53) then
			return
		end
		local target = Players:GetPlayerByUserId(a1)
		if target == nil or target == player then
			return
		end
		local mine = eligible(player)
		if mine then
			notify(player, "You can't trade while " .. mine .. ".")
			return
		end
		local theirs = eligible(target)
		if theirs then
			notify(player, target.DisplayName .. " can't trade right now (" .. theirs .. ").")
			return
		end
		local id = HttpService:GenerateGUID(false)
		requests[id] = { From = player, To = target, Expires = os.clock() + REQUEST_TIMEOUT }
		stateRemote:FireClient(target, { Type = "Request", RequestId = id, FromName = player.DisplayName, FromUserId = player.UserId, Timeout = REQUEST_TIMEOUT })
		notify(player, "Trade request sent to " .. target.DisplayName, "Info")
	elseif action == "Respond" then
		if type(a1) ~= "string" then
			return
		end
		local req = requests[a1]
		requests[a1] = nil
		if req == nil or req.To ~= player or os.clock() > req.Expires or req.From.Parent == nil then
			notify(player, "That trade request expired.")
			return
		end
		if a2 ~= true then
			notify(req.From, player.DisplayName .. " declined your trade.", "Info")
			return
		end
		if eligible(player) or eligible(req.From) then
			notify(player, "Trade can't start right now.")
			return
		end
		local trade: Trade = {
			Id = HttpService:GenerateGUID(false),
			A = { Player = req.From, Offer = {}, Ready = false },
			B = { Player = player, Offer = {}, Ready = false },
			Phase = "Offer",
			ConfirmAt = nil,
			Token = 0,
		}
		tradeOf[req.From] = trade
		tradeOf[player] = trade
		push(trade)
	else
		local trade = tradeOf[player]
		if trade == nil or trade.Phase == "Done" then
			return
		end
		local me, other = sides(trade, player)
		if action == "SetItem" then
			-- a1 = kind, a2 = id, a3 = count
			if not Validate.OneOf(a1, { "Ball", "Explosion", "Flyer" }) or not Validate.Id(a2) or not Validate.Integer(a3, 0, 9999) then
				return
			end
			if not EconomyService.IsTradable(a1, a2) then
				notify(player, "That item can't be traded.")
				return
			end
			local owned = EconomyService.Count(player, a1, a2)
			local key = a1 .. ":" .. a2
			local count = math.min(a3, owned)
			local entries = 0
			for _ in me.Offer do
				entries += 1
			end
			if count > 0 and me.Offer[key] == nil and entries >= MAX_ENTRIES then
				notify(player, "Offer is full.")
				return
			end
			if count > 0 then
				me.Offer[key] = count
			else
				me.Offer[key] = nil
			end
			local wasReady = me.Ready or other.Ready
			resetReady(trade)
			push(trade, nil)
			if wasReady and other.Player.Parent then
				-- anti-scam: tell the other side the offer changed
				stateRemote:FireClient(other.Player, { Type = "Changed" })
			end
		elseif action == "Ready" then
			me.Ready = a1 == true
			if not me.Ready then
				resetReady(trade)
				push(trade)
				return
			end
			if me.Ready and other.Ready then
				beginConfirm(trade)
			else
				push(trade)
			end
		elseif action == "Cancel" then
			notify(other.Player, player.DisplayName .. " cancelled the trade.", "Info")
			close(trade, "Cancelled")
		end
	end
end

function TradingService.Init(registry: { [string]: any })
	queueService = registry.QueueService
	stateRemote = Remotes.Event("TradeState")
	notifyRemote = Remotes.Event("Notify")
end

function TradingService.Start()
	Guard.OnEvent(Remotes.Event("TradeRequest"), 6, 12, function(player: Player, action: any, a1: any, a2: any, a3: any)
		if action == "Request" and not Guard.Allow(player, "TradeRequestSend", 0.34, 2) then
			notify(player, "Please wait before sending another request.")
			return
		end
		handle(player, action, a1, a2, a3)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local trade = tradeOf[player]
		if trade then
			local _, other = sides(trade, player)
			notify(other.Player, "Trade cancelled: " .. player.DisplayName .. " left.")
			close(trade, "Disconnected")
		end
		for id, req in requests do
			if req.From == player or req.To == player then
				requests[id] = nil
			end
		end
	end)
end

return TradingService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="92">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
-- Remote hardening: per-player token-bucket rate limits around every client->server endpoint.
-- Handlers still validate every argument (see Shared/Util/Validate) and check server state.
local Players = game:GetService("Players")

local Guard = {}

type Bucket = { tokens: number, updated: number, strikes: number }

local buckets: { [Player]: { [string]: Bucket } } = {}

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

-- Returns true if the player may perform `key` now. `rate` = tokens per second, `burst` = bucket size.
function Guard.Allow(player: Player, key: string, rate: number, burst: number): boolean
	local perPlayer = buckets[player]
	if perPlayer == nil then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[key]
	if bucket == nil then
		bucket = { tokens = burst, updated = now, strikes = 0 }
		perPlayer[key] = bucket
	end
	bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.updated) * rate)
	bucket.updated = now
	if bucket.tokens >= 1 then
		bucket.tokens -= 1
		return true
	end
	bucket.strikes += 1
	if bucket.strikes % 50 == 0 then
		warn(string.format("[Guard] %s is spamming %s (%d rejected)", player.Name, key, bucket.strikes))
	end
	return false
end

-- Connects a RemoteEvent with rate limiting; handler errors are contained and logged.
function Guard.OnEvent(remote: RemoteEvent, rate: number, burst: number, handler: (Player, ...any) -> ...any)
	remote.OnServerEvent:Connect(function(player: Player, ...)
		if not Guard.Allow(player, remote.Name, rate, burst) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Guard] %s handler error for %s: %s", remote.Name, player.Name, tostring(err)))
		end
	end)
end

function Guard.OnUnreliable(remote: UnreliableRemoteEvent, rate: number, burst: number, handler: (Player, ...any) -> ...any)
	remote.OnServerEvent:Connect(function(player: Player, ...)
		if not Guard.Allow(player, remote.Name, rate, burst) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Guard] %s handler error for %s: %s", remote.Name, player.Name, tostring(err)))
		end
	end)
end

-- RemoteFunction with rate limiting; always returns a result table to the client.
function Guard.OnInvoke(remote: RemoteFunction, rate: number, burst: number, handler: (Player, ...any) -> { [string]: any })
	remote.OnServerInvoke = function(player: Player, ...)
		if not Guard.Allow(player, remote.Name, rate, burst) then
			return { ok = false, error = "Slow down!" }
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Guard] %s handler error for %s: %s", remote.Name, player.Name, tostring(result)))
			return { ok = false, error = "Something went wrong. Try again." }
		end
		return result
	end
end

return Guard
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
