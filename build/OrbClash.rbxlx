      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="96">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="97">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="98">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="99">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">AimController</string>
              <string name="Source"><![CDATA[--!strict
-- Aim phase: drag to aim (reference guides: "Drag your trajectory with the mouse and hit Lock
-- Aim"). Desktop: click-drag anywhere; touch: drag; keyboard A/D or arrows; gamepad thumbstick,
-- A to lock. The preview is a dotted trajectory simulated with the same physics constants as
-- the server (gravity + wall bounces) plus an arrow head. Only the angle is sent to the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Physics = require(Shared.Config.Physics)
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local ArenaGeometry = require(Shared.Visual.ArenaGeometry)
local Remotes = require(Shared.Net.Remotes)

local AimController = {}

local DOTS = 16
local active = false
local locked = false
local angle = 0
local dragging = false
local station: CFrame
local kind = "Duel"
local half = 8
local originX, originY, radius = 0, 0, 1.5
local speed = Physics.CruiseSpeed
local folder: Folder
local dots: { BasePart } = {}
local arrow: { BasePart } = {}
local conns: { RBXScriptConnection } = {}
local lastSent = 0
local onLocked: (() -> ())?

local function makeDot(size: number): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(size, size, size)
	p.Material = Enum.Material.Neon
	p.Color = Color3.new(1, 1, 1)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = folder
	return p
end

local function ensureParts()
	if folder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "AimPreview"
	f.Parent = Workspace
	folder = f
	for i = 1, DOTS do
		table.insert(dots, makeDot(0.38 - i * 0.012))
	end
	for side = -1, 1, 2 do
		local wedge = Instance.new("Part")
		wedge.Size = Vector3.new(0.18, 0.18, 1.1)
		wedge.Material = Enum.Material.Neon
		wedge.Color = Color3.new(1, 1, 1)
		wedge.Anchored = true
		wedge.CanCollide = false
		wedge.CanQuery = false
		wedge.CanTouch = false
		wedge.Parent = folder
		wedge:SetAttribute("Side", side)
		table.insert(arrow, wedge)
	end
end

local function setVisible(visible: boolean)
	for _, p in dots do
		p.Transparency = if visible then 0 else 1
	end
	for _, p in arrow do
		p.Transparency = if visible then 0 else 1
	end
end

-- Simulates the opening of the flight (same rules as World._moveBall, without collisions).
local function trajectory(): { Vector2 }
	local points = {}
	local x, y = originX, originY
	local vx, vy = math.cos(angle) * speed, math.sin(angle) * speed
	local g = Physics.Gravity
	local dt = 1 / 60
	local step = 0
	local h = half
	while #points < DOTS and step < 600 do
		step += 1
		vy -= g * dt
		x += vx * dt
		y += vy * dt
		if x - radius < -h then
			x = -h + radius
			vx = math.abs(vx)
		elseif x + radius > h then
			x = h - radius
			vx = -math.abs(vx)
		end
		if y - radius < -h then
			y = -h + radius
			vy = math.abs(vy)
		elseif y + radius > h then
			y = h - radius
			vy = -math.abs(vy)
		end
		if step % 4 == 0 then
			table.insert(points, Vector2.new(x, y))
		end
	end
	return points
end

local function render()
	local points = trajectory()
	local color = if locked then Color3.fromHex("#7CFF6B") else Color3.new(1, 1, 1)
	for i, p in dots do
		local pt = points[i]
		if pt then
			p.CFrame = CFrame.new(ArenaGeometry.SimToWorld(station, kind, pt.X, pt.Y, 0.4))
			p.Color = color
			p.Transparency = 0.05 + i * 0.035
		end
	end
	-- arrow head just in front of the orb
	local dir = Vector2.new(math.cos(angle), math.sin(angle))
	local tip = Vector2.new(originX, originY) + dir * (radius + 1.6)
	local tipWorld = ArenaGeometry.SimToWorld(station, kind, tip.X, tip.Y, 0.5)
	local planeNormal = station.LookVector * -1
	for _, wedge in arrow do
		local side = wedge:GetAttribute("Side") :: number
		local back = Vector2.new(math.cos(angle + side * 2.5), math.sin(angle + side * 2.5))
		local tail = tip + back * 1.0
		local tailWorld = ArenaGeometry.SimToWorld(station, kind, tail.X, tail.Y, 0.5)
		local mid = (tipWorld + tailWorld) / 2
		wedge.CFrame = CFrame.lookAt(mid, tipWorld, planeNormal)
		wedge.Color = color
	end
end

local function sendLive()
	local now = os.clock()
	if now - lastSent > 0.12 then
		lastSent = now
		Remotes.Unreliable("AimUpdate"):FireServer(angle)
	end
end

local function aimAtScreen(pos: Vector2)
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return
	end
	local orbWorld = ArenaGeometry.SimToWorld(station, kind, originX, originY, 0)
	local screen = camera:WorldToViewportPoint(orbWorld)
	-- the viewport point of the cursor; screen y grows downward, arena y grows upward
	local dx = pos.X - screen.X
	local dy = -(pos.Y - screen.Y)
	if dx * dx + dy * dy < 16 then
		return
	end
	-- convert screen direction into arena space (camera right ~ station +X)
	local right = camera.CFrame.RightVector
	local up = camera.CFrame.UpVector
	local world = right * dx + up * dy
	local lx = world:Dot(station.RightVector)
	local ly = world:Dot(station.UpVector)
	angle = math.atan2(ly, lx)
	sendLive()
end

function AimController.Lock()
	if not active or locked then
		return
	end
	locked = true
	Remotes.Event("AimLock"):FireServer(angle)
	render()
	if onLocked then
		onLocked()
	end
end

function AimController.Enable(args: {
	Station: CFrame,
	Kind: string,
	X: number,
	Y: number,
	Radius: number,
	DefaultAngle: number,
	Half: number,
	DefId: string?,
	OnLocked: (() -> ())?,
})
	ensureParts()
	AimController.Disable()
	active = true
	locked = false
	station = args.Station
	kind = args.Kind
	half = args.Half
	originX, originY, radius = args.X, args.Y, args.Radius
	angle = args.DefaultAngle
	onLocked = args.OnLocked
	local def = if args.DefId then BallDefinitions.Get(args.DefId) else nil
	speed = Physics.CruiseSpeed * (if def then def.Speed else 1)
	setVisible(true)

	table.insert(conns, UserInputService.InputBegan:Connect(function(input, processed)
		if not active or locked then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			AimController.Lock()
			return
		end
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			aimAtScreen(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if not active or locked then
			return
		end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			aimAtScreen(Vector2.new(input.Position.X, input.Position.Y))
		elseif input.KeyCode == Enum.KeyCode.Thumbstick1 or input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local v: Vector3 = input.Position
			if v.Magnitude > 0.35 then
				angle = math.atan2(v.Y, v.X)
				sendLive()
			end
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		if not active then
			return
		end
		if not locked then
			local turn = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
				turn += 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
				turn -= 1
			end
			if turn ~= 0 then
				angle += turn * dt * 2.2
				sendLive()
			end
		end
		render()
	end))
	render()
end

function AimController.Disable()
	active = false
	dragging = false
	for _, c in conns do
		c:Disconnect()
	end
	table.clear(conns)
	if folder then
		setVisible(false)
	end
end

function AimController.IsActive(): boolean
	return active
end

return AimController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
-- Plays sounds from Config/Audio. 2D for UI, 3D (positioned) for battle events so spectators
-- hear fights from where they happen. Sound instances are pooled per spec.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local AudioConfig = require(ReplicatedStorage:WaitForChild("Shared").Config.Audio)

local AudioController = {}

local rng = Random.new()
local pools: { [string]: { Sound } } = {}
local lastPlayed: { [string]: number } = {}
local group: SoundGroup
local emitterFolder: Folder

local function ensure()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "OrbClashSFX"
	g.Volume = 0.9
	g.Parent = SoundService
	group = g
	local f = Instance.new("Folder")
	f.Name = "SoundEmitters"
	f.Parent = Workspace
	emitterFolder = f
end

local function acquire(name: string, parent: Instance): Sound?
	local spec = AudioConfig.Sounds[name]
	if spec == nil then
		return nil
	end
	local pool = pools[name]
	if pool == nil then
		pool = {}
		pools[name] = pool
	end
	for _, s in pool do
		if not s.IsPlaying and s.Parent == parent then
			return s
		end
	end
	if #pool >= 8 then
		local oldest = table.remove(pool, 1) :: Sound
		oldest:Destroy()
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = spec.Id
	sound.Volume = spec.Volume
	sound.SoundGroup = group
	sound.RollOffMaxDistance = 160
	sound.RollOffMinDistance = 18
	sound.Parent = parent
	table.insert(pool, sound)
	return sound
end

-- Plays a named sound. `position` makes it 3D. `throttle` (seconds) skips spammy repeats.
function AudioController.Play(name: string, position: Vector3?, throttle: number?, volumeScale: number?)
	ensure()
	local now = os.clock()
	if throttle and lastPlayed[name] and now - lastPlayed[name] < throttle then
		return
	end
	lastPlayed[name] = now
	local spec = AudioConfig.Sounds[name]
	if spec == nil then
		return
	end
	local parent: Instance = SoundService
	if position then
		local emitter = Instance.new("Part")
		emitter.Anchored = true
		emitter.CanCollide = false
		emitter.CanQuery = false
		emitter.CanTouch = false
		emitter.Transparency = 1
		emitter.Size = Vector3.one
		emitter.Position = position
		emitter.Parent = emitterFolder
		parent = emitter
		task.delay(3, function()
			emitter:Destroy()
		end)
	end
	local sound = acquire(name, parent)
	if sound == nil then
		return
	end
	sound.PlaybackSpeed = rng:NextNumber(spec.Pitch[1], spec.Pitch[2])
	sound.Volume = spec.Volume * (volumeScale or 1)
	sound.TimePosition = 0
	sound:Play()
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">BattleRenderer</string>
              <string name="Source"><![CDATA[--!strict
-- Renders every battle this client can see (own match + nearby arenas).
--
-- * Snapshots (20 Hz, binary) are buffered and interpolated with a 100 ms render delay.
-- * Events carry the simulation time (`tm`) they happened at and are replayed exactly when the
--   interpolated timeline reaches them, so hit sparks line up with the visible collision.
-- * Orbs are camera-facing 2D art (OrbArt) on BillboardGuis anchored in the arena plane: they
--   read as perfect spheres from any angle and support squash/stretch, flashes and overlays.
-- * Heavy hits get a few frames of hit-stop, camera shake and an FOV punch (participants only).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Physics = require(Shared.Config.Physics)
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local SnapshotCodec = require(Shared.Net.SnapshotCodec)
local Remotes = require(Shared.Net.Remotes)
local ArenaGeometry = require(Shared.Visual.ArenaGeometry)
local Signal = require(Shared.Util.Signal)

local Client = script.Parent.Parent
local OrbArt = require(Client.UI.Components.OrbArt)
local Effects = require(Client.VFX.Effects)
local EntityVisuals = require(Client.VFX.EntityVisuals)
local Explosions = require(Client.VFX.Explosions)
local AudioController = require(script.Parent.AudioController)
local CameraController = require(script.Parent.CameraController)

local BattleRenderer = {}

BattleRenderer.Overtime = Signal.new() -- (stationIndex, level)
BattleRenderer.BallSpawned = Signal.new() -- (stationIndex, ballId, defId, owner)

local Flags = SnapshotCodec.Flags
local hex = Color3.fromHex

type BallView = {
	id: number,
	def: string,
	team: number,
	owner: number,
	minion: boolean,
	r: number,
	hp: number,
	maxHp: number,
	anchor: Part,
	gui: BillboardGui,
	group: CanvasGroup,
	art: OrbArt.Handle,
	hpLabel: TextLabel,
	overlays: { [string]: Frame },
	x: number,
	y: number,
	roll: number,
	flags: number,
	squash: number,
	squashAxis: number,
	detached: boolean,
	tail: { Vector3 }?,
	tailParts: { BasePart }?,
}

type EntityView = {
	vis: EntityVisuals.Visual,
	dynamic: boolean,
	armAt: number?,
}

type StationView = {
	index: number,
	cf: CFrame,
	kind: string,
	folder: Folder,
	balls: { [number]: BallView },
	entities: { [number]: EntityView },
	snaps: { SnapshotCodec.Snapshot },
	events: { { [string]: any } },
	offsetSamples: { number },
	offset: number?,
	frozenRT: number?,
	freezeUntil: number,
	extraDelay: number,
	lastRT: number,
	cosmetics: { [number]: { Explosion: string, Flyer: string } },
	participant: boolean,
}

local views: { [number]: StationView } = {}
local root: Folder

---------------------------------------------------------------------------------------------
-- Station lookup

local function stationModel(index: number): Model?
	for _, model in Workspace:WaitForChild("Lobby"):WaitForChild("Stations"):GetChildren() do
		if model:GetAttribute("StationIndex") == index then
			return model :: Model
		end
	end
	return nil
end

local function getView(index: number): StationView?
	local view = views[index]
	if view then
		return view
	end
	local model = stationModel(index)
	if model == nil then
		return nil
	end
	local kind = model:GetAttribute("Kind") :: string
	local floor = model:GetAttribute("Floor") :: Vector3
	local yaw = model:GetAttribute("Yaw") :: number
	local folder = Instance.new("Folder")
	folder.Name = "Station" .. index
	folder.Parent = root
	local v: StationView = {
		index = index,
		cf = ArenaGeometry.StationCFrame({ floor.X, floor.Y, floor.Z }, yaw, kind),
		kind = kind,
		folder = folder,
		balls = {},
		entities = {},
		snaps = {},
		events = {},
		offsetSamples = {},
		offset = nil,
		frozenRT = nil,
		freezeUntil = 0,
		extraDelay = 0,
		lastRT = 0,
		cosmetics = {},
		participant = false,
	}
	views[index] = v
	return v
end

function BattleRenderer.StationCFrame(index: number): (CFrame?, string?)
	local v = getView(index)
	if v then
		return v.cf, v.kind
	end
	return nil, nil
end

function BattleRenderer.SetSummary(index: number, summary: { [string]: any }, isParticipant: boolean)
	local v = getView(index)
	if v == nil then
		return
	end
	v.participant = isParticipant
	for _, p in summary.Participants do
		v.cosmetics[p.UserId] = { Explosion = p.Explosion, Flyer = p.Flyer }
	end
end

local function toWorld(v: StationView, x: number, y: number, z: number?): Vector3
	return ArenaGeometry.SimToWorld(v.cf, v.kind, x, y, z)
end

---------------------------------------------------------------------------------------------
-- Ball views

local function overlayCircle(parent: GuiObject, name: string, color: Color3, transparency: number, z: number, strokeOnly: boolean?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.fromScale(1 / OrbArt.Padding * 1.04, 1 / OrbArt.Padding * 1.04)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = if strokeOnly then 1 else transparency
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = f
	if strokeOnly then
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = 4
		stroke.Transparency = transparency
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = f
	end
	f.Parent = parent
	return f
end

local function destroyBall(v: StationView, id: number)
	local ball = v.balls[id]
	if ball == nil then
		return
	end
	v.balls[id] = nil
	ball.anchor:Destroy()
	if ball.tailParts then
		for _, p in ball.tailParts do
			p:Destroy()
		end
	end
end

local function createBall(v: StationView, e: { [string]: any }): BallView
	destroyBall(v, e.id)
	local r = e.r or 1.5
	local anchor = Effects.Part()
	anchor.Name = "Orb" .. e.id
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(toWorld(v, e.x, e.y))
	anchor.Parent = v.folder

	local gui = Instance.new("BillboardGui")
	gui.Name = "OrbGui"
	gui.Adornee = anchor
	gui.Size = UDim2.new(2 * r * OrbArt.Padding, 0, 2 * r * OrbArt.Padding, 0)
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.MaxDistance = 260
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = anchor

	local group = Instance.new("CanvasGroup")
	group.BackgroundTransparency = 1
	group.Size = UDim2.fromScale(1, 1)
	group.Parent = gui
	local art = OrbArt.Draw(group, e.def, 1, true)

	local hp = Instance.new("TextLabel")
	hp.Name = "HP"
	hp.BackgroundTransparency = 1
	hp.AnchorPoint = Vector2.new(0.5, 0.5)
	hp.Position = UDim2.fromScale(0.5, 0.52)
	hp.Size = UDim2.fromScale(0.5, 0.3)
	hp.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Heavy)
	hp.TextScaled = true
	hp.TextColor3 = Color3.new(1, 1, 1)
	hp.Text = tostring(math.ceil(e.hp or 100))
	hp.ZIndex = 40
	hp.Visible = not e.minion
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = hp
	hp:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		stroke.Thickness = math.clamp(hp.AbsoluteSize.Y * 0.08, 1, 5)
	end)
	hp.Parent = gui

	local overlays = {
		Frozen = overlayCircle(group, "Frozen", hex("#BDF3FF"), 0.35, 30),
		Slowed = overlayCircle(group, "Slowed", hex("#6EDB3A"), 0.7, 31),
		Snared = overlayCircle(group, "Snared", hex("#C9CCD3"), 0, 32, true),
		Latched = overlayCircle(group, "Latched", hex("#FF3D4F"), 0.1, 33, true),
		Charging = overlayCircle(group, "Charging", Color3.new(1, 1, 1), 0.2, 34, true),
	}

	-- motion streak
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, r * 0.55, 0)
	a0.Parent = anchor
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -r * 0.55, 0)
	a1.Parent = anchor
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	local def = BallDefinitions.Get(e.def)
	local base = if def then hex(def.Visual.Base) else Color3.new(1, 1, 1)
	trail.Color = ColorSequence.new(base)
	trail.Transparency = NumberSequence.new(0.55, 1)
	trail.Lifetime = 0.12
	trail.LightEmission = 0.3
	trail.FaceCamera = true
	trail.Parent = anchor

	local ball: BallView = {
		id = e.id,
		def = e.def,
		team = e.team,
		owner = e.owner,
		minion = e.minion == true,
		r = r,
		hp = e.hp or 100,
		maxHp = e.maxHp or 100,
		anchor = anchor,
		gui = gui,
		group = group,
		art = art,
		hpLabel = hp,
		overlays = overlays,
		x = e.x,
		y = e.y,
		roll = 0,
		flags = 0,
		squash = 0,
		squashAxis = 0,
		detached = false,
		tail = nil,
		tailParts = nil,
	}
	if def and def.AbilityId == "serpent" then
		ball.tail = {}
		ball.tailParts = {}
		for i = 1, 16 do
			local p = Effects.Part(Enum.PartType.Ball)
			p.Color = hex(def.Visual.Accent)
			p.Size = Vector3.one * (1.0 - i * 0.03)
			p.Transparency = 1
			p.Parent = v.folder
			table.insert(ball.tailParts :: { BasePart }, p)
		end
	end
	v.balls[e.id] = ball
	-- spawn pop
	local s = Instance.new("UIScale")
	s.Scale = 0.2
	s.Parent = group
	TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	BattleRenderer.BallSpawned:Fire(v.index, e.id, e.def, e.owner)
	return ball
end

local function flashBall(ball: BallView, color: Color3?)
	local flash = ball.art.Flash
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0.15
	TweenService:Create(flash, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
end

local function squashBall(ball: BallView, nx: number, ny: number, amount: number)
	ball.squash = amount
	ball.squashAxis = if math.abs(nx) >= math.abs(ny) then 0 else 1
end

---------------------------------------------------------------------------------------------
-- Event playback

local function ballPos(v: StationView, id: number?): Vector3?
	if id == nil then
		return nil
	end
	local ball = v.balls[id]
	if ball then
		return toWorld(v, ball.x, ball.y, 0.6)
	end
	return nil
end

local function shakeIfMine(v: StationView, magnitude: number, punch: number?)
	if v.participant then
		CameraController.Shake(magnitude)
		if punch then
			CameraController.Punch(punch)
		end
	end
end

local fx: { [string]: (StationView, { [string]: any }) -> () } = {
	bump = function(v, e)
		Effects.Sparks(toWorld(v, e.x, e.y, 0.6), hex("#FFB347"), 12, 14, 0.5)
	end,
	boost = function(v, e)
		Effects.Sparks(toWorld(v, e.x, e.y, 0.6), hex("#9BE15D"), 10, 10, 0.5)
	end,
	sunburst = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Flash(pos, 5, hex("#FFE14D"), 0.35)
		Effects.Ring(pos, -v.cf.LookVector, e.r or 6, hex("#FFD23F"), 0.45)
		AudioController.Play("Ability", pos)
	end,
	throw = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			AudioController.Play("Whoosh", pos, 0.1, 0.5)
		end
	end,
	muzzle = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Flash(pos, 1.6, hex("#FFE14D"), 0.12)
		Effects.Smoke(pos, hex("#9CA2AB"), 4)
		AudioController.Play("Shoot", pos)
	end,
	moonAdded = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			Effects.Sparks(pos, hex("#C9D0FF"), 10, 8, 0.4)
		end
	end,
	tether = function(v, e)
		local a, b = v.balls[e.a], v.balls[e.b]
		if a and b then
			Effects.Tether(a.anchor, b.anchor, hex("#FF3D4F"), e.duration or 1)
			AudioController.Play("Ability", a.anchor.Position)
		end
	end,
	splat = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Sparks(pos, hex("#6EDB3A"), 10, 8, 0.6)
		AudioController.Play("Splat", pos, 0.1)
	end,
	magnet = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Ring(pos, -v.cf.LookVector, 7, hex("#D7263D"), 0.4)
		AudioController.Play("Ability", pos)
	end,
	freeze = function(v, e)
		local pos = ballPos(v, e.id) or toWorld(v, e.x, e.y)
		Effects.Sparks(pos, hex("#BDF3FF"), 18, 10, 0.5)
		AudioController.Play("Freeze", pos)
	end,
	explosion = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		local c = if e.color then hex(e.color) else hex("#FF5E1A")
		Effects.Flash(pos, (e.r or 3) * 2, c, 0.3)
		Effects.Ring(pos, -v.cf.LookVector, e.r or 3, c, 0.35)
		Effects.Sparks(pos, c, 30, 18, 0.7)
		AudioController.Play("Explosion", pos)
		shakeIfMine(v, 0.25)
	end,
	beamCharge = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		AudioController.Play("Laser", pos, 0.1)
	end,
	dice = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			local six = e.roll == 6
			Effects.Popup(pos + Vector3.new(0, 2.2, 0), if six then "JACKPOT 6!" else tostring(e.roll), if six then hex("#FFE14D") else Color3.new(1, 1, 1), if six then 1.4 else 1)
		end
	end,
	phase = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			AudioController.Play("Ability", pos, nil, 0.6)
		end
	end,
	unphase = function(v, e)
		if e.spook then
			local pos = toWorld(v, e.x, e.y, 0.6)
			Effects.Ring(pos, -v.cf.LookVector, 4, hex("#B9A8FF"), 0.35)
			Effects.Popup(pos + Vector3.new(0, 2, 0), "BOO!", hex("#CFC8FF"), 1.3)
		end
	end,
	haunt = function(v, e)
		Effects.Sparks(toWorld(v, e.x, e.y, 0.6), hex("#B9A8FF"), 10, 8, 0.5)
	end,
	forgeCharge = function(v, e)
		local pos = ballPos(v, e.id)
		if pos and e.charge ~= 0 then
			Effects.Popup(pos + Vector3.new(0, 2, 0), string.format("%d/%d", e.charge, e.max), hex("#FFB000"), 0.8)
		end
	end,
	shockwave = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		local c = if e.color then hex(e.color) else hex("#FFB000")
		Effects.Ring(pos, -v.cf.LookVector, e.r or 4.5, c, 0.4, 0.4)
		Effects.Flash(pos, 4, c, 0.25)
		Effects.Popup(pos + Vector3.new(0, 2.4, 0), "SMASH!", c, 1.4)
		AudioController.Play("HitHeavy", pos)
		shakeIfMine(v, 0.4, 4)
	end,
	shatter = function(v, e)
		AudioController.Play("Shatter", toWorld(v, e.x, e.y), 0.15, 0.6)
	end,
	lightning = function(v, e)
		local from = ballPos(v, e.from)
		local to = ballPos(v, e.to) or toWorld(v, e.x, e.y, 0.6)
		if from and to then
			Effects.Lightning(from, to, hex("#FFE14D"), 0.25)
			AudioController.Play("Zap", to)
		end
	end,
	enrage = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			Effects.Popup(pos + Vector3.new(0, 2.4, 0), "SUPERCHARGED", hex("#FFE14D"), 1.2)
			Effects.Flash(pos, 4, hex("#8C8FFF"), 0.3)
		end
	end,
	grow = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			Effects.Sparks(pos, hex("#FF7BD5"), 8, 6, 0.4)
		end
	end,
	split = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Flash(pos, 5, hex("#FF7BD5"), 0.3)
		Effects.Popup(pos + Vector3.new(0, 2.4, 0), "SPLIT!", hex("#FF7BD5"), 1.2)
	end,
	windup = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			Effects.Ring(pos, -v.cf.LookVector, 3, Color3.new(1, 1, 1), 0.3)
		end
	end,
	charge = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			AudioController.Play("Whoosh", pos)
		end
	end,
	railLaid = function(v, e)
		AudioController.Play("Ability", toWorld(v, e.x, e.y), 0.2)
	end,
	train = function(v, e)
		local pos = ballPos(v, e.id) or v.cf.Position
		AudioController.Play("Train", pos)
	end,
	trainHit = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Flash(pos, 4, hex("#FFCC00"), 0.25)
		AudioController.Play("HitHeavy", pos)
		shakeIfMine(v, 0.45, 5)
	end,
	chained = function(v, e)
		local pos = toWorld(v, e.x, e.y, 0.6)
		Effects.Sparks(pos, hex("#C9CCD3"), 12, 8, 0.4)
		AudioController.Play("Freeze", pos, nil, 0.7)
	end,
	trapsDropped = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			AudioController.Play("Ability", pos, 0.2, 0.5)
		end
	end,
	lob = function(v, e)
		local pos = ballPos(v, e.id)
		if pos then
			AudioController.Play("Shoot", pos, nil, 0.6)
		end
	end,
}

local function clearView(v: StationView)
	for id in v.balls do
		destroyBall(v, id)
	end
	for _, ent in v.entities do
		ent.vis.Destroy()
	end
	table.clear(v.entities)
	table.clear(v.snaps)
	table.clear(v.events)
	table.clear(v.offsetSamples)
	v.offset = nil
	v.frozenRT = nil
	v.extraDelay = 0
end

local function spawnEntity(v: StationView, e: { [string]: any })
	local existing = v.entities[e.id]
	if existing then
		existing.vis.Destroy()
	end
	local vis = EntityVisuals.Create(v.cf, v.kind, e, v.folder)
	if vis == nil then
		return
	end
	local armAt: number? = nil
	if (e.armed or 0) > 0 then
		armAt = (e.tm or 0) + e.armed
		if v.offset == nil then
			-- no timeline yet (aim phase): arm on a wall-clock delay instead
			local armFn = vis.Arm
			if armFn then
				task.delay(e.armed, armFn)
			end
			armAt = nil
		end
	elseif vis.Arm then
		vis.Arm()
	end
	v.entities[e.id] = { vis = vis, dynamic = e.dynamic == true, armAt = armAt }
end

local function applyEvent(v: StationView, e: { [string]: any })
	local t = e.t
	if t == "BallSpawn" then
		createBall(v, e)
	elseif t == "Launch" then
		local ball = v.balls[e.id]
		if ball then
			AudioController.Play("Launch", ball.anchor.Position, 0.05)
			Effects.Sparks(ball.anchor.Position, Color3.new(1, 1, 1), 12, 12, 0.5)
		end
	elseif t == "Wall" then
		local ball = v.balls[e.id]
		if ball then
			local pos = toWorld(v, e.x, e.y, 0.4)
			AudioController.Play("Bounce", pos, 0.06)
			Effects.Sparks(pos, Color3.fromRGB(220, 225, 235), 4, 6, 0.3)
			squashBall(ball, e.nx, e.ny, 0.16)
		end
	elseif t == "Hit" then
		local a, b = v.balls[e.a], v.balls[e.b]
		local pos = toWorld(v, e.x, e.y, 0.7)
		if e.friendly then
			AudioController.Play("Bounce", pos, 0.05)
			return
		end
		local heavy = e.heavy == true
		Effects.Sparks(pos, if heavy then hex("#FFE14D") else Color3.new(1, 1, 1), if heavy then 28 else 14, if heavy then 22 else 14, if heavy then 0.8 else 0.5)
		if heavy then
			Effects.Flash(pos, 3, hex("#FFF2B3"), 0.18)
		end
		AudioController.Play(if heavy then "HitHeavy" else "HitLight", pos)
		for _, ball in { a, b } do
			if ball then
				flashBall(ball)
				squashBall(ball, e.nx or 1, e.ny or 0, if heavy then 0.28 else 0.18)
			end
		end
		if heavy then
			shakeIfMine(v, 0.35, 3)
			if v.participant and v.offset then
				v.freezeUntil = os.clock() + 0.07
			end
		end
	elseif t == "Damage" then
		local ball = v.balls[e.id]
		if ball then
			flashBall(ball, hex("#FF5A6A"))
			ball.hp = math.max(0, ball.hp - (e.amount or 0))
			ball.hpLabel.Text = tostring(math.ceil(ball.hp))
			if (e.amount or 0) >= 1 and not ball.minion then
				local pos = toWorld(v, ball.x, ball.y, 0.8) + Vector3.new(0, ball.r * 1.1, 0)
				Effects.Popup(pos, "-" .. math.floor(e.amount + 0.5), if e.amount >= 10 then hex("#FFB347") else hex("#FF6B7F"), if e.amount >= 10 then 1.2 else 0.8)
			end
		end
	elseif t == "Heal" then
		local ball = v.balls[e.id]
		if ball and (e.amount or 0) >= 1 then
			ball.hp = math.min(ball.maxHp, ball.hp + e.amount)
			ball.hpLabel.Text = tostring(math.ceil(ball.hp))
			Effects.Popup(toWorld(v, ball.x, ball.y, 0.8) + Vector3.new(0, ball.r * 1.1, 0), "+" .. math.floor(e.amount + 0.5), hex("#7CFF6B"), 0.8)
		end
	elseif t == "Death" then
		local ball = v.balls[e.id]
		local pos = toWorld(v, e.x, e.y, 0.6)
		local cosmetics = if ball then v.cosmetics[ball.owner] else nil
		if ball and not ball.minion then
			Explosions.Play(if cosmetics then cosmetics.Explosion else "classic", pos, v.cf, ball.r)
			AudioController.Play("Death", pos)
			shakeIfMine(v, 0.5, 6)
		else
			Effects.Flash(pos, 2, Color3.new(1, 1, 1), 0.2)
			Effects.Sparks(pos, Color3.new(1, 1, 1), 10, 10, 0.4)
		end
		destroyBall(v, e.id)
	elseif t == "EntitySpawn" then
		spawnEntity(v, e)
	elseif t == "EntityRemove" then
		local ent = v.entities[e.id]
		if ent then
			v.entities[e.id] = nil
			ent.vis.Destroy()
		end
	elseif t == "Status" then
		local ball = v.balls[e.id]
		if ball and e.status == "frozen" then
			flashBall(ball, hex("#BDF3FF"))
		end
	elseif t == "Overtime" then
		BattleRenderer.Overtime:Fire(v.index, e.level)
	elseif t == "Fx" then
		local handler = fx[e.kind]
		if handler then
			handler(v, e)
		end
	elseif t == "Full" then
		clearView(v)
		local state = e.state
		for _, b in state.balls do
			createBall(v, { id = b.id, def = b.def, team = b.team, owner = b.owner, x = b.x, y = b.y, r = b.r, hp = b.hp, maxHp = b.maxHp, minion = b.minion })
		end
		for _, ent in state.entities do
			spawnEntity(v, ent)
		end
	elseif t == "Clear" then
		clearView(v)
	end
end

local function onEvents(index: number, events: { { [string]: any } })
	local v = getView(index)
	if v == nil then
		return
	end
	for _, e in events do
		if e.t == "Full" or e.t == "Clear" or e.tm == nil or v.offset == nil then
			applyEvent(v, e)
		else
			table.insert(v.events, e)
		end
	end
end

local function onSnapshot(payload: buffer)
	local snap = SnapshotCodec.Decode(payload)
	if snap == nil then
		return
	end
	local v = getView(snap.station)
	if v == nil then
		return
	end
	local last = v.snaps[#v.snaps]
	if last and snap.time <= last.time then
		return -- out of order / duplicate
	end
	table.insert(v.snaps, snap)
	while #v.snaps > 30 do
		table.remove(v.snaps, 1)
	end
	-- local clock offset estimate: minimum over a sliding window (least delayed packet)
	table.insert(v.offsetSamples, os.clock() - snap.time)
	while #v.offsetSamples > 40 do
		table.remove(v.offsetSamples, 1)
	end
	local best = math.huge
	for _, s in v.offsetSamples do
		best = math.min(best, s)
	end
	v.offset = best
end

---------------------------------------------------------------------------------------------
-- Per-frame rendering

local function renderTime(v: StationView, dt: number): number
	local now = os.clock()
	local rt = now - (v.offset :: number) - Physics.InterpolationDelay
	if now < v.freezeUntil then
		if v.frozenRT == nil then
			v.frozenRT = v.lastRT
		end
		return v.frozenRT :: number
	elseif v.frozenRT then
		v.extraDelay = math.max(v.extraDelay, rt - (v.frozenRT :: number))
		v.frozenRT = nil
	end
	if v.extraDelay > 0 then
		v.extraDelay = math.max(0, v.extraDelay - dt * 0.35)
	end
	return rt - v.extraDelay
end

local function sample(v: StationView, rt: number): (SnapshotCodec.Snapshot?, SnapshotCodec.Snapshot?, number)
	local snaps = v.snaps
	local n = #snaps
	if n == 0 then
		return nil, nil, 0
	end
	if rt <= snaps[1].time then
		return snaps[1], snaps[1], 0
	end
	for i = n - 1, 1, -1 do
		local a, b = snaps[i], snaps[i + 1]
		if rt >= a.time then
			local span = b.time - a.time
			local alpha = if span > 0 then math.clamp((rt - a.time) / span, 0, 1) else 1
			return a, b, alpha
		end
	end
	return snaps[n], snaps[n], 0
end

local function updateView(v: StationView, dt: number, camPos: Vector3)
	local rt = v.lastRT
	if v.offset then
		rt = renderTime(v, dt)
		v.lastRT = rt
		-- replay events up to the render time
		while #v.events > 0 and (v.events[1].tm or 0) <= rt do
			applyEvent(v, table.remove(v.events, 1) :: { [string]: any })
		end
		local a, b, alpha = sample(v, rt)
		if a and b then
			local bBalls: { [number]: SnapshotCodec.BallState } = {}
			for _, s in b.balls do
				bBalls[s.id] = s
			end
			for _, s0 in a.balls do
				local ball = v.balls[s0.id]
				if ball and not ball.detached then
					local s1 = bBalls[s0.id] or s0
					local x = s0.x + (s1.x - s0.x) * alpha
					local y = s0.y + (s1.y - s0.y) * alpha
					local dx = x - ball.x
					ball.roll += math.deg(dx / math.max(ball.r, 0.3))
					ball.x, ball.y = x, y
					ball.flags = s1.flags
					if math.abs(s1.r - ball.r) > 0.01 then
						ball.r = s1.r
						ball.gui.Size = UDim2.new(2 * ball.r * OrbArt.Padding, 0, 2 * ball.r * OrbArt.Padding, 0)
					end
					local hp = s1.hp
					if math.abs(hp - ball.hp) >= 1 then
						ball.hp = hp
						ball.hpLabel.Text = tostring(math.ceil(hp))
					end
				end
			end
			local bEnts: { [number]: SnapshotCodec.EntityState } = {}
			for _, s in b.entities do
				bEnts[s.id] = s
			end
			for _, s0 in a.entities do
				local ent = v.entities[s0.id]
				if ent and ent.dynamic then
					local s1 = bEnts[s0.id] or s0
					local drot = math.atan2(math.sin(s1.rot - s0.rot), math.cos(s1.rot - s0.rot))
					ent.vis.Update(s0.x + (s1.x - s0.x) * alpha, s0.y + (s1.y - s0.y) * alpha, s0.rot + drot * alpha, s0.scale + (s1.scale - s0.scale) * alpha)
				end
			end
		end
		for _, ent in v.entities do
			if ent.armAt and rt >= ent.armAt then
				ent.armAt = nil
				if ent.vis.Arm then
					ent.vis.Arm()
				end
			end
		end
	end

	-- ball presentation
	for _, ball in v.balls do
		if ball.detached then
			continue
		end
		local center = toWorld(v, ball.x, ball.y, 0)
		local toCam = camPos - center
		local offset = if toCam.Magnitude > 0.01 then toCam.Unit * (ball.r * 0.9) else Vector3.zero
		ball.anchor.CFrame = CFrame.new(center + offset)
		ball.art:SetRotation(ball.roll % 360)
		-- squash & stretch (decays quickly)
		ball.squash = ball.squash * math.exp(-dt * 14)
		local sq = ball.squash
		local size = 2 * ball.r * OrbArt.Padding
		if ball.squashAxis == 0 then
			ball.gui.Size = UDim2.new(size * (1 - sq), 0, size * (1 + sq * 0.6), 0)
		else
			ball.gui.Size = UDim2.new(size * (1 + sq * 0.6), 0, size * (1 - sq), 0)
		end
		-- status overlays from snapshot flags
		local f = ball.flags
		ball.overlays.Frozen.Visible = bit32.band(f, Flags.Frozen) ~= 0
		ball.overlays.Slowed.Visible = bit32.band(f, Flags.Slowed) ~= 0
		ball.overlays.Snared.Visible = bit32.band(f, Flags.Snared) ~= 0
		ball.overlays.Latched.Visible = bit32.band(f, Flags.Latched) ~= 0
		ball.overlays.Charging.Visible = bit32.band(f, Flags.Charging) ~= 0
		ball.group.GroupTransparency = if bit32.band(f, Flags.Phased) ~= 0 then 0.6 else 0
		-- serpent tail
		local tail = ball.tail
		local parts = ball.tailParts
		if tail and parts then
			table.insert(tail, 1, toWorld(v, ball.x, ball.y, -0.3))
			while #tail > 60 do
				table.remove(tail)
			end
			for i, p in parts do
				local pt = tail[i * 3 + 3]
				if pt then
					p.Position = pt
					p.Transparency = 0.1 + i * 0.04
				else
					p.Transparency = 1
				end
			end
		end
	end
end

function BattleRenderer.GetBallAnchor(index: number, ballId: number): BasePart?
	local v = views[index]
	local ball = v and v.balls[ballId]
	return if ball then ball.anchor else nil
end

function BattleRenderer.DetachBall(index: number, ballId: number): BasePart?
	local v = views[index]
	local ball = v and v.balls[ballId]
	if ball then
		ball.detached = true
		return ball.anchor
	end
	return nil
end

function BattleRenderer.Start()
	root = Instance.new("Folder")
	root.Name = "ClientBattles"
	root.Parent = Workspace
	Remotes.Event("BattleEvent").OnClientEvent:Connect(onEvents)
	Remotes.Unreliable("BattleSnapshot").OnClientEvent:Connect(onSnapshot)
	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		if camera == nil then
			return
		end
		local camPos = camera.CFrame.Position
		for _, v in views do
			if next(v.balls) or next(v.entities) or #v.events > 0 then
				updateView(v, dt, camPos)
			end
		end
	end)
end

return BattleRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
-- Lobby: default character camera. Battle: front-on framing of the arena (reference
-- screenshot 4) that refits to the viewport aspect, eased transitions, restrained shake and
-- FOV punches for heavy hits only.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ArenaGeometry = require(Shared.Visual.ArenaGeometry)

local CameraController = {}

local BASE_FOV = 70
local TRANSITION = 0.9

local inBattle = false
local stationCF: CFrame? = nil
local kind = "Duel"
local fromCF: CFrame? = nil
local transitionStart = 0
local exiting = false
local shakeMag = 0
local shakeTime = 0
local fovPunch = 0
local rng = Random.new()

local function ease(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function targetCFrame(camera: Camera): CFrame
	local size = camera.ViewportSize
	local aspect = if size.Y > 0 then size.X / size.Y else 16 / 9
	return ArenaGeometry.CameraCFrame(stationCF :: CFrame, kind, aspect, BASE_FOV)
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return
	end
	if not inBattle and not exiting then
		return
	end
	local t = ease((os.clock() - transitionStart) / TRANSITION)
	local cf: CFrame
	if exiting then
		local character = Players.LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local back = if root then CFrame.lookAt(root.Position - root.CFrame.LookVector * 12 + Vector3.new(0, 5, 0), root.Position + Vector3.new(0, 1.5, 0)) else camera.CFrame
		cf = (fromCF :: CFrame):Lerp(back, t)
		if t >= 1 then
			exiting = false
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = BASE_FOV
			return
		end
	else
		local target = targetCFrame(camera)
		cf = if fromCF and t < 1 then fromCF:Lerp(target, t) else target
	end
	-- shake (decaying random offset) and fov punch
	if shakeTime > 0 then
		shakeTime -= dt
		local m = shakeMag * math.clamp(shakeTime / 0.25, 0, 1)
		cf *= CFrame.new(rng:NextNumber(-m, m), rng:NextNumber(-m, m), 0) * CFrame.Angles(0, 0, rng:NextNumber(-m, m) * 0.02)
	end
	fovPunch = fovPunch * math.exp(-dt * 10)
	camera.FieldOfView = BASE_FOV + fovPunch
	camera.CFrame = cf
end

function CameraController.EnterBattle(station: CFrame, arenaKind: string)
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return
	end
	stationCF = station
	kind = arenaKind
	if not inBattle then
		fromCF = camera.CFrame
		transitionStart = os.clock()
	end
	inBattle = true
	exiting = false
	camera.CameraType = Enum.CameraType.Scriptable
end

function CameraController.ExitBattle()
	local camera = Workspace.CurrentCamera
	if not inBattle or camera == nil then
		return
	end
	inBattle = false
	exiting = true
	fromCF = camera.CFrame
	transitionStart = os.clock()
end

function CameraController.InBattle(): boolean
	return inBattle
end

function CameraController.Shake(magnitude: number, duration: number?)
	if not inBattle then
		return
	end
	shakeMag = math.max(shakeMag * (if shakeTime > 0 then 1 else 0), magnitude)
	shakeTime = math.max(shakeTime, duration or 0.25)
end

function CameraController.Punch(fov: number)
	if inBattle then
		fovPunch = math.max(fovPunch, fov)
	end
end

function CameraController.Start()
	RunService:BindToRenderStep("OrbClashCamera", Enum.RenderPriority.Camera.Value + 1, step)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">LobbyController</string>
              <string name="Source"><![CDATA[--!strict
-- Lobby presentation: interactive props (prompts open store tabs / claim group reward),
-- floating decor, event countdowns, leaderboard boards (rendered locally so each player sees
-- their own rank row) and hearts above the heads of battling players.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lobby = require(Shared.Config.Lobby)
local Format = require(Shared.Util.Format)
local GameConfig = require(Shared.Config.Game)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Icons = require(Client.UI.Components.Icons)
local UIController = require(script.Parent.UIController)
local StateController = require(script.Parent.StateController)

local LobbyController = {}

local localPlayer = Players.LocalPlayer
local playerGui: PlayerGui
local bobbing: { [Model]: CFrame } = {}
local boardGuis: { [string]: SurfaceGui } = {}
local headHearts: { [number]: BillboardGui } = {}

---------------------------------------------------------------------------------------------
-- Prompts

local function onPrompt(prompt: ProximityPrompt)
	local route = prompt:GetAttribute("OpenUI")
	if type(route) == "string" then
		local screen, tab = string.match(route, "^(%w+):?(%w*)$")
		if screen then
			UIController.Open(screen, if tab ~= "" then tab else nil)
		end
		return
	end
	if prompt:GetAttribute("Action") == "ClaimGroup" then
		local result = Remotes.Function("StoreRequest"):InvokeServer("ClaimGroup")
		if type(result) == "table" then
			UIController.Toast(if result.ok then (result.message or "Claimed!") else (result.error or "Couldn't claim."), if result.ok then "Success" else "Error")
		end
	end
end

---------------------------------------------------------------------------------------------
-- Leaderboards

local function renderBoard(model: Model, data: { [string]: any })
	local kind = model:GetAttribute("BoardKind")
	local screen: BasePart? = nil
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("BoardScreen") then
			screen = d
		end
	end
	if screen == nil then
		return
	end
	local key = model:GetFullName()
	local gui = boardGuis[key]
	if not gui then
		local created = Instance.new("SurfaceGui")
		created.Name = "Board"
		created.Adornee = screen
		created.Face = Enum.NormalId.Back
		created.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		created.PixelsPerStud = 30
		created.LightInfluence = 0
		created.Parent = playerGui
		boardGuis[key] = created
		gui = created
	end
	local g = gui :: SurfaceGui
	g:ClearAllChildren()
	local weekly = kind == "Weekly"
	local entries = if weekly then data.Weekly else data.AllTime
	local bg: Frame = Create("Frame", { BackgroundColor3 = Color3.fromHex("#141A2B"), Size = UDim2.fromScale(1, 1), Parent = g })
	local title = if weekly then Lobby.Leaderboards.WeeklyTitle else Lobby.Leaderboards.AllTimeTitle
	if weekly and data.WeekEndsAt then
		title ..= string.format("  (%s)", Format.Duration(data.WeekEndsAt - Workspace:GetServerTimeNow()))
	end
	Create.Text({ Text = title, Size = UDim2.new(1, -20, 0.11, 0), Position = UDim2.fromScale(0.02, 0.02), Font = Theme.Fonts.Display, Scaled = true, Stroke = 2, Parent = bg })
	local header: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0.03, 0.14), Size = UDim2.fromScale(0.94, 0.06), Parent = bg })
	Create.Text({ Text = "Rank", Size = UDim2.fromScale(0.12, 1), Font = Theme.Fonts.Body, Scaled = true, Color = Theme.Colors.TextDim, Parent = header })
	Create.Text({ Text = "Name", Size = UDim2.fromScale(0.45, 1), Position = UDim2.fromScale(0.14, 0), Font = Theme.Fonts.Body, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Theme.Colors.TextDim, Parent = header })
	Create.Text({ Text = if data.Stat == "RobuxSpent" then "Spent" else "Wins", Size = UDim2.fromScale(0.2, 1), Position = UDim2.fromScale(if weekly then 0.6 else 0.78, 0), Font = Theme.Fonts.Body, Scaled = true, Color = Theme.Colors.TextDim, Parent = header })
	if weekly then
		Create.Text({ Text = "Rewards", Size = UDim2.fromScale(0.18, 1), Position = UDim2.fromScale(0.82, 0), Font = Theme.Fonts.Body, Scaled = true, Color = Theme.Colors.TextDim, Parent = header })
	end
	local rowColors = { Color3.fromHex("#C9A227"), Color3.fromHex("#8E949E"), Color3.fromHex("#9C5B2E") }
	local function row(entry: { [string]: any }, y: number, highlight: boolean): TextLabel
		local r: Frame = Create("Frame", {
			BackgroundColor3 = if highlight then Color3.fromHex("#2F74E8") else (rowColors[entry.Rank] or Color3.fromHex("#1E2740")),
			BackgroundTransparency = if entry.Rank <= 3 or highlight then 0.1 else 0.3,
			Position = UDim2.fromScale(0.03, y),
			Size = UDim2.fromScale(0.94, 0.062),
			Parent = bg,
		})
		local rankLabel = Create.Text({ Text = tostring(entry.Rank), Size = UDim2.fromScale(0.12, 0.8), Position = UDim2.fromScale(0, 0.1), Font = Theme.Fonts.Display, Scaled = true, Stroke = 1.5, Parent = r })
		Create.Text({ Text = entry.Name, Size = UDim2.fromScale(0.45, 0.8), Position = UDim2.fromScale(0.14, 0.1), Font = Theme.Fonts.Body, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 1.5, Parent = r })
		Create.Text({ Text = Format.Commas(entry.Value), Size = UDim2.fromScale(0.2, 0.8), Position = UDim2.fromScale(if weekly then 0.6 else 0.78, 0.1), Font = Theme.Fonts.Display, Scaled = true, Stroke = 1.5, Parent = r })
		if weekly and data.Rewards and data.Rewards[entry.Rank] then
			Create.Text({ Text = "x" .. data.Rewards[entry.Rank].Count .. " Adv.", Size = UDim2.fromScale(0.16, 0.8), Position = UDim2.fromScale(0.83, 0.1), Font = Theme.Fonts.Body, Scaled = true, Color = Theme.Colors.Gold, Stroke = 1.5, Parent = r })
		end
		return rankLabel
	end
	for i, entry in entries or {} do
		if i > 10 then
			break
		end
		row(entry, 0.21 + (i - 1) * 0.066, entry.UserId == localPlayer.UserId)
	end
	-- own rank pinned at the bottom
	local ranks = data.Ranks and data.Ranks[tostring(localPlayer.UserId)]
	local myRank = if ranks then (if weekly then ranks.Weekly else ranks.AllTime) else nil
	local profile = StateController.Data
	local myValue = 0
	if profile and profile.Stats then
		myValue = if data.Stat == "RobuxSpent" then profile.Stats.RobuxSpent or 0 else profile.Stats.Wins or 0
	end
	local myRankLabel = row({ Rank = myRank or 0, Name = localPlayer.Name, Value = myValue, UserId = localPlayer.UserId }, 0.9, true)
	if myRank == nil then
		myRankLabel.Text = "100+"
	end
end

local function renderBoards()
	local data = StateController.Leaderboards
	if data == nil then
		return
	end
	for _, model in CollectionService:GetTagged("Leaderboard") do
		if model:IsA("Model") then
			pcall(renderBoard, model, data)
		end
	end
end

---------------------------------------------------------------------------------------------
-- Hearts above battling players' heads

local function heartsFor(userId: number, hearts: number?)
	local existing = headHearts[userId]
	if hearts == nil then
		if existing then
			existing:Destroy()
			headHearts[userId] = nil
		end
		return
	end
	local player = Players:GetPlayerByUserId(userId)
	local head = player and player.Character and player.Character:FindFirstChild("Head")
	if head == nil then
		return
	end
	local gui = existing
	if not gui or gui.Adornee ~= head then
		if gui then
			gui:Destroy()
		end
		local g = Instance.new("BillboardGui")
		g.Name = "Hearts_" .. userId
		g.Adornee = head :: BasePart
		g.Size = UDim2.new(4.2, 0, 1.3, 0)
		g.StudsOffset = Vector3.new(0, 2.4, 0)
		g.LightInfluence = 0
		g.MaxDistance = 140
		g.Parent = playerGui
		local holder: Frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = g })
		Create.List(holder, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		for i = 1, GameConfig.Hearts do
			local heart = Icons.Heart(UDim2.fromScale(0.3, 1), holder)
			heart.LayoutOrder = i
			heart.Name = "H" .. i
		end
		headHearts[userId] = g
		gui = g
	end
	local holder = (gui :: BillboardGui):FindFirstChildOfClass("Frame")
	if holder then
		for i = 1, GameConfig.Hearts do
			local heart = holder:FindFirstChild("H" .. i) :: Frame?
			if heart then
				Icons.SetHeart(heart, i <= (hearts :: number))
			end
		end
	end
end

local function onStation(payload: { [string]: any })
	local match = payload.Match
	local seen: { [number]: boolean } = {}
	if match and match.State ~= "Closed" and match.State ~= "Created" then
		for _, p in match.Participants do
			if p.UserId > 0 then
				seen[p.UserId] = true
				heartsFor(p.UserId, match.Hearts[p.Team])
			end
		end
	end
	-- remove hearts of players who were in this station's previous match
	for _, pad in payload.Pads do
		if pad.UserId > 0 and not seen[pad.UserId] then
			heartsFor(pad.UserId, nil)
		end
	end
	if match == nil then
		for userId, gui in headHearts do
			local still = false
			for _, station in StateController.Stations do
				if station.Match then
					for _, p in station.Match.Participants do
						if p.UserId == userId then
							still = true
						end
					end
				end
			end
			if not still then
				gui:Destroy()
				headHearts[userId] = nil
			end
		end
	end
end

function LobbyController.Start()
	playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if CollectionService:HasTag(prompt, "UIPrompt") then
			onPrompt(prompt)
		end
	end)

	local function trackBob(model: Instance)
		if model:IsA("Model") then
			bobbing[model] = model:GetPivot()
		end
	end
	for _, m in CollectionService:GetTagged("Bob") do
		trackBob(m)
	end
	CollectionService:GetInstanceAddedSignal("Bob"):Connect(trackBob)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for model, base in bobbing do
			if model.Parent == nil then
				bobbing[model] = nil
			else
				local amp = (model:GetAttribute("Bob") :: number?) or 1
				model:PivotTo(base * CFrame.new(0, math.sin(t * 1.4) * amp, 0) * CFrame.Angles(0, t * 0.35, 0))
			end
		end
	end)

	-- event countdowns + leaderboard week timer
	task.spawn(function()
		while true do
			for _, gui in CollectionService:GetTagged("EventTimer") do
				local endsAt = gui:GetAttribute("EndsAt") :: number?
				local timer = gui:FindFirstChild("Timer") :: TextLabel?
				if endsAt and timer then
					local left = endsAt - Workspace:GetServerTimeNow()
					timer.Text = if left > 0 then "Ends in " .. Format.Duration(left) else "Event ended"
				end
			end
			task.wait(1)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			renderBoards()
		end
	end)

	StateController.LeaderboardChanged:Connect(renderBoards)
	StateController.StationChanged:Connect(onStation)
	renderBoards()
end

return LobbyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">MatchController</string>
              <string name="Source"><![CDATA[--!strict
-- Client side of the match flow. Reacts to MatchPublic (everyone watching) and MatchPrivate
-- (participants) and drives: camera, HUD swap, selection, aiming, countdown, round-end flyer
-- finisher + heart break, victory banner, results and requeue.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.Game)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent
local UIController = require(script.Parent.UIController)
local CameraController = require(script.Parent.CameraController)
local AimController = require(script.Parent.AimController)
local BattleRenderer = require(script.Parent.BattleRenderer)
local AudioController = require(script.Parent.AudioController)
local HUD = require(Client.UI.Screens.HUD)
local BattleHUD = require(Client.UI.Screens.BattleHUD)
local SelectionScreen = require(Client.UI.Screens.SelectionScreen)
local ResultsScreen = require(Client.UI.Screens.ResultsScreen)
local RevealScreen = require(Client.UI.Screens.RevealScreen)
local Flyers = require(Client.VFX.Flyers)
local Effects = require(Client.VFX.Effects)

local MatchController = {}

local localPlayer = Players.LocalPlayer

local active: { [string]: any }? = nil -- { MatchId, Station, Mode, Summary, Closed }
local lastRoundBanner = 0
local pendingRequeue: string? = nil

local function isParticipant(summary: { [string]: any }): ({ [string]: any }?)
	for _, p in summary.Participants do
		if p.UserId == localPlayer.UserId then
			return p
		end
	end
	return nil
end

local function begin(summary: { [string]: any })
	active = { MatchId = summary.MatchId, Station = summary.Station, Mode = summary.Mode, Summary = summary, Closed = false }
	lastRoundBanner = 0
	UIController.CloseMenus()
	RevealScreen.Hold(true)
	HUD.SetVisible(false)
	BattleHUD.Show(summary)
	local cf, kind = BattleRenderer.StationCFrame(summary.Station)
	if cf and kind then
		CameraController.EnterBattle(cf, kind)
	end
end

local function finish()
	local wasActive = active
	if wasActive == nil then
		return
	end
	wasActive.Closed = true
	active = nil
	AimController.Disable()
	SelectionScreen.Hide()
	BattleHUD.Hide()
	CameraController.ExitBattle()
	HUD.SetVisible(true)
	if not ResultsScreen.IsOpen() then
		RevealScreen.Hold(false)
	end
	local mode = pendingRequeue
	pendingRequeue = nil
	if mode then
		task.delay(0.6, function()
			Remotes.Event("QueueRequest"):FireServer("Play", mode)
		end)
	end
end

-- Where a participant (player or practice bot) is standing.
local function targetPosition(stationIndex: number, userId: number): Vector3?
	local player = Players:GetPlayerByUserId(userId)
	if player and player.Character then
		local root = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			return root.Position + Vector3.new(0, 1, 0)
		end
	end
	if userId < 0 then
		local stations = Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Stations")
		if stations then
			for _, model in stations:GetChildren() do
				if model:GetAttribute("StationIndex") == stationIndex then
					local bot = model:FindFirstChild(GameConfig.Bots.Name)
					if bot and bot:IsA("Model") then
						return bot:GetPivot().Position + Vector3.new(0, 1, 0)
					end
				end
			end
		end
	end
	return nil
end

local function playFinisher(payload: { [string]: any })
	local summary = payload.Summary
	local station = summary.Station
	local winners = payload.WinnerBalls or {}
	local losers = payload.LoserUserIds or {}
	if #winners == 0 or #losers == 0 then
		return
	end
	task.delay(0.75, function()
		for i, loserId in losers do
			local ballInfo = winners[((i - 1) % #winners) + 1]
			local anchor = if i <= #winners then BattleRenderer.DetachBall(station, ballInfo.Id) else nil
			local from = if anchor then anchor.Position else nil
			local to = targetPosition(station, loserId)
			if from == nil then
				local cf = BattleRenderer.StationCFrame(station)
				from = if cf then cf.Position else nil
			end
			if from and to then
				AudioController.Play("Whoosh", from)
				Flyers.Play(payload.Flyer, from, to, anchor, function()
					AudioController.Play("HeartBreak", to)
					Effects.Popup(to + Vector3.new(0, 2.5, 0), "-1", Color3.fromHex("#EF2B3C"), 1.6)
					if active and active.MatchId == summary.MatchId then
						BattleHUD.BreakHeart(payload.Loser, summary.Hearts[payload.Loser])
						CameraController.Shake(0.5, 0.3)
					end
				end)
			end
		end
	end)
end

local function onPublic(payload: { [string]: any })
	local summary = payload.Summary
	if summary == nil then
		return
	end
	local me = isParticipant(summary)
	BattleRenderer.SetSummary(summary.Station, summary, me ~= nil)
	local kind = payload.Type

	if kind == "RoundEnd" and not payload.Draw then
		playFinisher(payload)
	end
	if me == nil then
		return
	end
	if active == nil or active.MatchId ~= summary.MatchId then
		if kind == "Closed" then
			return
		end
		begin(summary)
	end
	local a = active :: { [string]: any }
	a.Summary = summary
	if kind ~= "RoundEnd" then
		BattleHUD.Update(summary)
	end

	if kind == "Intro" then
		BattleHUD.Banner(if summary.Practice then "PRACTICE" else "BATTLE!", Color3.new(1, 1, 1), 1.6)
	elseif kind == "Selection" then
		if lastRoundBanner ~= summary.Round then
			lastRoundBanner = summary.Round
			BattleHUD.Banner("ROUND " .. summary.Round, Color3.new(1, 1, 1), 1.2)
		end
		local waiting = 0
		for _, p in summary.Participants do
			if p.UserId ~= localPlayer.UserId and not p.Picked then
				waiting += 1
			end
		end
		SelectionScreen.SetOpponentStatus(if waiting == 0 then "Everyone is ready!" else (if summary.Mode == "2v2" then string.format("%d still choosing...", waiting) else "Opponent is choosing..."))
		BattleHUD.PhaseTimer(nil, nil)
	elseif kind == "Aim" then
		SelectionScreen.Hide()
		BattleHUD.PhaseTimer("AIM", summary.Deadline)
	elseif kind == "Countdown" then
		AimController.Disable()
		BattleHUD.HideAim()
		BattleHUD.PhaseTimer(nil, nil)
		BattleHUD.Countdown(summary.Deadline)
	elseif kind == "Battle" then
		BattleHUD.Overtime(nil)
	elseif kind == "RoundEnd" then
		BattleHUD.Overtime(nil)
		if payload.Draw then
			BattleHUD.Banner("DRAW!", Color3.fromHex("#C9CCD3"), 1.6)
		elseif payload.Winner == me.Team then
			BattleHUD.Banner("ROUND WON", Color3.fromHex("#7CFF6B"), 1.8)
		else
			BattleHUD.Banner("ROUND LOST", Color3.fromHex("#FF5A6A"), 1.8)
		end
	elseif kind == "Victory" then
		local won = payload.WinnerTeam == me.Team
		BattleHUD.Banner(if won then "VICTORY!" else "DEFEAT", if won then Color3.fromHex("#FFC72C") else Color3.fromHex("#FF5A6A"), 3)
	elseif kind == "Closed" then
		finish()
	end
end

local function onPrivate(payload: { [string]: any })
	if payload.Type == "Selection" then
		SelectionScreen.Show(payload)
	elseif payload.Type == "Aim" then
		local cf, kind = BattleRenderer.StationCFrame(payload.Station)
		if cf == nil or kind == nil then
			return
		end
		local defId: string? = nil
		if active then
			local me = isParticipant(active.Summary)
			defId = if me then me.Ball else nil
		end
		AimController.Enable({
			Station = cf,
			Kind = kind,
			X = payload.X,
			Y = payload.Y,
			Radius = payload.Radius,
			DefaultAngle = payload.DefaultAngle,
			Half = payload.Half,
			DefId = defId,
			OnLocked = function()
				BattleHUD.AimLocked()
			end,
		})
		BattleHUD.ShowAim(payload.Deadline, GameConfig.Timings.AimTime, function()
			AimController.Lock()
		end)
	elseif payload.Type == "Results" then
		local mode = if active then active.Mode else "1v1"
		ResultsScreen.Show(payload, mode, function()
			if active == nil then
				RevealScreen.Hold(false)
			end
		end, function(requeueMode: string)
			if active and not active.Closed then
				pendingRequeue = requeueMode
			else
				Remotes.Event("QueueRequest"):FireServer("Play", requeueMode)
			end
		end)
	end
end

function MatchController.InMatch(): boolean
	return active ~= nil
end

function MatchController.Start()
	Remotes.Event("MatchPublic").OnClientEvent:Connect(onPublic)
	Remotes.Event("MatchPrivate").OnClientEvent:Connect(onPrivate)
	BattleRenderer.Overtime:Connect(function(index: number, level: number)
		if active and active.Station == index then
			BattleHUD.Overtime(level)
			if level == 1 then
				BattleHUD.Banner("OVERTIME", Color3.fromHex("#FF5A6A"), 1.4)
			end
		end
	end)
end

return MatchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">StateController</string>
              <string name="Source"><![CDATA[--!strict
-- Client mirror of server-owned state: profile view, stations, leaderboards, notifications.
-- Read-only: every change comes from the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Signal = require(Shared.Util.Signal)

local StateController = {}

StateController.Data = nil :: { [string]: any }?
StateController.Stations = {} :: { [number]: { [string]: any } }
StateController.Leaderboards = nil :: { [string]: any }?

StateController.DataChanged = Signal.new() -- (data, previous)
StateController.StationChanged = Signal.new() -- (station payload)
StateController.LeaderboardChanged = Signal.new()
StateController.Notified = Signal.new() -- ({Text, Kind})

local localPlayer = Players.LocalPlayer

function StateController.Count(kind: string, id: string): number
	local data = StateController.Data
	if data == nil then
		return 0
	end
	local bag = if kind == "Ball" then data.Balls elseif kind == "Explosion" then data.Explosions elseif kind == "Flyer" then data.Flyers else data.Tickets
	return if bag then bag[id] or 0 else 0
end

-- Station the local player is standing on (queued or in a match), if any.
function StateController.MyStation(): ({ [string]: any }?, number?)
	for _, station in StateController.Stations do
		for padIndex, pad in station.Pads do
			if pad.UserId == localPlayer.UserId then
				return station, padIndex
			end
		end
	end
	return nil, nil
end

function StateController.Start()
	Remotes.Event("PlayerData").OnClientEvent:Connect(function(data)
		local previous = StateController.Data
		StateController.Data = data
		StateController.DataChanged:Fire(data, previous)
	end)
	Remotes.Event("StationState").OnClientEvent:Connect(function(payload)
		StateController.Stations[payload.Index] = payload
		StateController.StationChanged:Fire(payload)
	end)
	Remotes.Event("LeaderboardData").OnClientEvent:Connect(function(payload)
		StateController.Leaderboards = payload
		StateController.LeaderboardChanged:Fire(payload)
	end)
	Remotes.Event("Notify").OnClientEvent:Connect(function(payload)
		StateController.Notified:Fire(payload)
	end)
end

return StateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
-- Owns the ScreenGuis, responsive scaling, the screen router and toasts.
--
-- Layout model: every layer has one root Frame under a UIScale. Screens position with Scale +
-- AnchorPoint (so they stick to corners/centres on any aspect ratio) and size in design pixels
-- (1800 x 920 reference), which the UIScale converts for the actual viewport. Touch devices get
-- a size boost for comfortable tap targets. Safe areas come from ScreenInsets.CoreUISafeInsets.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local Client = script.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local AudioController = require(script.Parent.AudioController)

export type Screen = {
	Open: (any, ...any) -> (),
	Close: (any) -> (),
	IsOpen: (any) -> boolean,
}

local UIController = {}

UIController.Scale = 1
UIController.ScaleChanged = Signal.new()
UIController.ScreenOpened = Signal.new() -- (name)
UIController.ScreenClosed = Signal.new() -- (name)

local layers: { [string]: Frame } = {}
local layerScales: { UIScale } = {}
local screens: { [string]: Screen } = {}
local EXCLUSIVE = { Store = true, Inventory = true, Trade = true, Codes = true, Gems = true }
local toastHolder: Frame

local LAYERS = {
	{ Name = "HUD", Order = 1 },
	{ Name = "Battle", Order = 5 },
	{ Name = "Menus", Order = 10 },
	{ Name = "Overlay", Order = 20 },
	{ Name = "Toasts", Order = 30 },
}

local function computeScale(): number
	local camera = Workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1800, 920)
	local s = math.min(size.X / Theme.DesignSize.X, size.Y / Theme.DesignSize.Y)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		s *= 1.22 -- bigger tap targets on phones/tablets
	end
	if GuiService:IsTenFootInterface() then
		s *= 0.92 -- TV safe margin
	end
	return math.clamp(s, 0.42, 1.6)
end

local function applyScale()
	local s = computeScale()
	UIController.Scale = s
	for _, scale in layerScales do
		scale.Scale = s
	end
	for _, root in layers do
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	UIController.ScaleChanged:Fire(s)
end

function UIController.Layer(name: string): Frame
	return layers[name]
end

function UIController.Register(name: string, screen: Screen)
	screens[name] = screen
end

function UIController.Get(name: string): Screen?
	return screens[name]
end

function UIController.Open(name: string, ...: any)
	local screen = screens[name]
	if screen == nil then
		warn("[UI] unknown screen " .. name)
		return
	end
	if EXCLUSIVE[name] then
		for other, s in screens do
			if other ~= name and EXCLUSIVE[other] and s:IsOpen() then
				s:Close()
				UIController.ScreenClosed:Fire(other)
			end
		end
	end
	screen:Open(...)
	UIController.ScreenOpened:Fire(name)
end

function UIController.Close(name: string)
	local screen = screens[name]
	if screen and screen:IsOpen() then
		screen:Close()
		UIController.ScreenClosed:Fire(name)
	end
end

function UIController.Toggle(name: string, ...: any)
	local screen = screens[name]
	if screen and screen:IsOpen() then
		UIController.Close(name)
	else
		UIController.Open(name, ...)
	end
end

function UIController.AnyMenuOpen(): boolean
	for name, s in screens do
		if EXCLUSIVE[name] and s:IsOpen() then
			return true
		end
	end
	return false
end

function UIController.CloseMenus()
	for name, s in screens do
		if EXCLUSIVE[name] and s:IsOpen() then
			UIController.Close(name)
		end
	end
end

local TOAST_COLORS = {
	Error = Color3.fromHex("#FF5A6A"),
	Info = Color3.fromHex("#9FD8FF"),
	Success = Color3.fromHex("#7CFF6B"),
	Quest = Color3.fromHex("#FFC72C"),
}

function UIController.Toast(text: string, kind: string?)
	if not toastHolder then
		return
	end
	local k = kind or "Info"
	if k == "Error" then
		AudioController.Play("Error", nil, 0.3)
	elseif k == "Quest" or k == "Success" then
		AudioController.Play("Reward", nil, 0.5)
	end
	local pill: Frame = Create("Frame", {
		Name = "Toast",
		BackgroundColor3 = Theme.Colors.PanelDeep,
		BackgroundTransparency = 0.08,
		Size = UDim2.fromOffset(560, 50),
		Parent = toastHolder,
	})
	Create.Corner(10, pill)
	Create.Stroke(pill, TOAST_COLORS[k] or TOAST_COLORS.Info, 2, 0, true)
	Create.Text({
		Text = text,
		Size = UDim2.new(1, -24, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Body,
		TextSize = 28,
		Scaled = true,
		Color = TOAST_COLORS[k] or Color3.new(1, 1, 1),
		Stroke = 1.5,
		Parent = pill,
	})
	local scale = Instance.new("UIScale")
	scale.Scale = 0.6
	scale.Parent = pill
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(2.6, function()
		local t = TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 })
		t:Play()
		t.Completed:Wait()
		pill:Destroy()
	end)
end

function UIController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	for _, layer in LAYERS do
		local gui = Instance.new("ScreenGui")
		gui.Name = "OrbClash_" .. layer.Name
		gui.DisplayOrder = layer.Order
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = false
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = playerGui
		local root: Frame = Create("Frame", {
			Name = "Root",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = gui,
		})
		local scale = Instance.new("UIScale")
		scale.Parent = root
		table.insert(layerScales, scale)
		layers[layer.Name] = root
	end
	toastHolder = Create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(560, 400),
		Parent = layers.Toasts,
	})
	Create.List(toastHolder, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
	applyScale()
	local function watchCamera()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
		end
		applyScale()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	watchCamera()
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="108">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client bootstrap: state mirror, UI layers + screens, then runtime controllers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Remotes")

local Controllers = script.Parent.Controllers
local Screens = script.Parent.UI.Screens

local StateController = require(Controllers.StateController)
local UIController = require(Controllers.UIController)
local CameraController = require(Controllers.CameraController)
local BattleRenderer = require(Controllers.BattleRenderer)
local MatchController = require(Controllers.MatchController)
local LobbyController = require(Controllers.LobbyController)

StateController.Start()
UIController.Init()

for _, name in {
	"HUD",
	"StoreScreen",
	"InventoryScreen",
	"RevealScreen",
	"CodesScreen",
	"GemShop",
	"TradeScreen",
	"Notifications",
	"SelectionScreen",
	"BattleHUD",
	"ResultsScreen",
} do
	local screen = (require :: any)(Screens:WaitForChild(name))
	local ok, err = pcall(screen.Init)
	if not ok then
		warn(string.format("[Client] %s.Init failed: %s", name, tostring(err)))
	end
end

CameraController.Start()
BattleRenderer.Start()
MatchController.Start()
LobbyController.Start()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="109">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="Folder" referent="110">
            <Properties>
              <string name="Name">Components</string>
            </Properties>
            <Item class="ModuleScript" referent="111">
              <Properties>
                <string name="Name">Button</string>
                <string name="Source"><![CDATA[--!strict
-- Chunky reference-style button: vertical gradient, dark border, bottom shade, stroked label.
-- Feedback: hover grow, press squash, disabled grey, click/hover sounds.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local AudioController = require(UI.Parent.Controllers.AudioController)

export type ButtonProps = {
	Parent: Instance?,
	Name: string?,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Style: string?,
	Text: string?,
	TextSize: number?,
	Font: Font?,
	LayoutOrder: number?,
	ZIndex: number?,
	Corner: number?,
	OnClick: (() -> ())?,
	Silent: boolean?,
}

export type Button = {
	Instance: TextButton,
	Label: TextLabel,
	Content: Frame,
	SetText: (Button, string) -> (),
	SetStyle: (Button, string) -> (),
	SetEnabled: (Button, boolean) -> (),
	Enabled: boolean,
	Style: string,
	Destroy: (Button) -> (),
}

local Button = {}

local QUICK = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SPRING = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

function Button.new(props: ButtonProps): Button
	local styleName = props.Style or "Grey"
	local style = Theme.Buttons[styleName] or Theme.Buttons.Grey
	local corner = props.Corner or 8

	local root: TextButton = Create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Selectable = true,
	})
	Create.Corner(corner, root)
	local gradient = Create.Gradient(root, style.Top, style.Bottom, 90)
	local border = Create.Stroke(root, style.Border, 2.5, 0, true)
	local scale = Instance.new("UIScale")
	scale.Parent = root

	-- glossy top highlight
	local gloss = Create("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 3),
		ZIndex = root.ZIndex,
		Parent = root,
	})
	Create.Corner(corner - 2, gloss)
	-- bottom shade (3D lip)
	local shade = Create("Frame", {
		Name = "Shade",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.78,
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 1, -5),
		ZIndex = root.ZIndex,
		Parent = root,
	})
	Create.Corner(corner, shade)

	local content: Frame = Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = root.ZIndex + 1,
		Parent = root,
	})
	local label = Create.Text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = props.Font or Theme.Fonts.Display,
		TextSize = props.TextSize or 28,
		Scaled = true,
		Color = style.Text,
		Stroke = 2.2,
		ZIndex = root.ZIndex + 2,
		Parent = content,
	})

	local self = {
		Instance = root,
		Label = label,
		Content = content,
		Enabled = true,
		Style = styleName,
	} :: any

	local function setStyle(name: string)
		local s = Theme.Buttons[name] or Theme.Buttons.Grey
		gradient.Color = ColorSequence.new(s.Top, s.Bottom)
		border.Color = s.Border
		label.TextColor3 = s.Text
	end

	function self.SetText(_: any, text: string)
		label.Text = text
	end
	function self.SetStyle(this: any, name: string)
		this.Style = name
		if this.Enabled then
			setStyle(name)
		end
	end
	function self.SetEnabled(this: any, enabled: boolean)
		this.Enabled = enabled
		root.Active = enabled
		root.AutoButtonColor = false
		setStyle(if enabled then this.Style else "Disabled")
	end
	function self.Destroy(_: any)
		root:Destroy()
	end

	root.MouseEnter:Connect(function()
		if self.Enabled then
			TweenService:Create(scale, QUICK, { Scale = 1.05 }):Play()
			if not props.Silent then
				AudioController.Play("Hover", nil, 0.05)
			end
		end
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, QUICK, { Scale = 1 }):Play()
	end)
	root.MouseButton1Down:Connect(function()
		if self.Enabled then
			TweenService:Create(scale, QUICK, { Scale = 0.94 }):Play()
		end
	end)
	root.MouseButton1Up:Connect(function()
		TweenService:Create(scale, SPRING, { Scale = 1 }):Play()
	end)
	root.Activated:Connect(function()
		if not self.Enabled then
			AudioController.Play("Error", nil, 0.2)
			return
		end
		if not props.Silent then
			AudioController.Play("Click")
		end
		if props.OnClick then
			props.OnClick()
		end
	end)

	root.Parent = props.Parent
	return self :: Button
end

-- Square close button in the reference style (light grey block, heavy stroked X).
function Button.Close(parent: Instance, onClick: () -> (), position: UDim2?, size: number?): Button
	local s = size or 64
	local b = Button.new({
		Parent = parent,
		Name = "Close",
		Size = UDim2.fromOffset(s, s),
		Position = position or UDim2.new(1, -s * 0.35, 0, -s * 0.35),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Style = "Grey",
		Text = "X",
		Font = Theme.Fonts.Display,
		ZIndex = 20,
		OnClick = onClick,
	})
	b.Label.Size = UDim2.fromScale(0.62, 0.62)
	return b
end

return Button
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="112">
              <Properties>
                <string name="Name">Icons</string>
                <string name="Source"><![CDATA[--!strict
-- Vector-style icons built from frames (no image assets): coin, gem, heart, check, lock, swap.
-- Every icon fills its returned square Frame, so callers only set Size/Position.
local UI = script.Parent.Parent
local Create = require(UI.Create)

local Icons = {}

local hex = Color3.fromHex

local function box(name: string, size: UDim2?, parent: Instance?): Frame
	local f: Frame = Create("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = size or UDim2.fromOffset(40, 40),
		Parent = parent,
	})
	Create.Aspect(f, 1)
	return f
end

local function circle(parent: Instance, cx: number, cy: number, d: number, color: Color3, transparency: number?, z: number?): Frame
	local c: Frame = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromScale(d, d),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency or 0,
		ZIndex = z or 1,
		Parent = parent,
	})
	Create.Round(c)
	return c
end
Icons.Circle = circle

local function rect(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, rotation: number?, corner: number?, z: number?): Frame
	local r: Frame = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		Rotation = rotation or 0,
		ZIndex = z or 1,
		Parent = parent,
	})
	if corner then
		Create.Corner(UDim.new(corner, 0), r)
	end
	return r
end
Icons.Rect = rect

function Icons.Coin(size: UDim2?, parent: Instance?): Frame
	local f = box("Coin", size, parent)
	circle(f, 0.5, 0.53, 0.98, hex("#B86E00"))
	local face = circle(f, 0.5, 0.5, 0.94, hex("#FFC21A"), 0, 2)
	Create.Gradient(face, hex("#FFE27A"), hex("#FFA800"), 120)
	local inner = circle(f, 0.5, 0.5, 0.66, hex("#FFB300"), 0, 3)
	Create.Gradient(inner, hex("#FFB300"), hex("#FFD54A"), 120)
	circle(f, 0.36, 0.32, 0.18, Color3.new(1, 1, 1), 0.35, 4)
	return f
end

function Icons.Gem(size: UDim2?, parent: Instance?): Frame
	local f = box("Gem", size, parent)
	local shadow = rect(f, 0.5, 0.54, 0.66, 0.66, hex("#0D3C9E"), 45, 0.12, 1)
	shadow.BackgroundTransparency = 0.2
	local body = rect(f, 0.5, 0.5, 0.66, 0.66, hex("#3B8BFF"), 45, 0.12, 2)
	Create.Gradient(body, hex("#8FD0FF"), hex("#1C5FD6"), 0)
	local facet = rect(f, 0.5, 0.5, 0.36, 0.36, hex("#BDE6FF"), 45, 0.1, 3)
	facet.BackgroundTransparency = 0.25
	circle(f, 0.4, 0.33, 0.12, Color3.new(1, 1, 1), 0.1, 4)
	return f
end

-- Heart from a rotated square + two circles. `filled = false` renders the lost-heart state.
function Icons.Heart(size: UDim2?, parent: Instance?, filled: boolean?): Frame
	local f = box("Heart", size, parent)
	local color = if filled == false then hex("#3A3F52") else hex("#EF2B3C")
	local s = 1 / 1.707
	local cy = 0.854 * s * 1.0 + 0.04
	rect(f, 0.5, cy, s, s, color, 45, nil, 1)
	circle(f, 0.5 - 0.354 * s, cy - 0.354 * s, s, color, 0, 1)
	circle(f, 0.5 + 0.354 * s, cy - 0.354 * s, s, color, 0, 1)
	if filled ~= false then
		local gloss = circle(f, 0.3, 0.3, 0.2, Color3.new(1, 1, 1), 0.45, 2)
		gloss.Size = UDim2.fromScale(0.22, 0.16)
	end
	return f
end

function Icons.SetHeart(heart: Frame, filled: boolean)
	local color = if filled then hex("#EF2B3C") else hex("#3A3F52")
	for _, child in heart:GetChildren() do
		if child:IsA("Frame") and child.ZIndex == 1 then
			child.BackgroundColor3 = color
		elseif child:IsA("Frame") and child.ZIndex == 2 then
			child.Visible = filled
		end
	end
end

function Icons.Check(size: UDim2?, parent: Instance?, color: Color3?): Frame
	local f = box("Check", size, parent)
	local c = color or hex("#4CD420")
	rect(f, 0.36, 0.62, 0.16, 0.42, c, -45, 0.4, 1)
	rect(f, 0.6, 0.47, 0.16, 0.72, c, 40, 0.4, 1)
	return f
end

function Icons.Lock(size: UDim2?, parent: Instance?, color: Color3?): Frame
	local f = box("Lock", size, parent)
	local c = color or hex("#C9CCD3")
	local shackle = circle(f, 0.5, 0.36, 0.46, Color3.new(), 1, 1)
	Create.Stroke(shackle, c, 4, 0, true)
	rect(f, 0.5, 0.66, 0.64, 0.46, c, 0, 0.18, 2)
	rect(f, 0.5, 0.66, 0.1, 0.18, hex("#2A2F3D"), 0, 0.5, 3)
	return f
end

-- Two opposing arrows (used for the green "Tradable" badge).
function Icons.Swap(size: UDim2?, parent: Instance?, color: Color3?): Frame
	local f = box("Swap", size, parent)
	local c = color or hex("#4CD420")
	rect(f, 0.45, 0.32, 0.62, 0.14, c, 0, 0.5, 1)
	rect(f, 0.76, 0.32, 0.26, 0.26, c, 45, 0.15, 1)
	rect(f, 0.55, 0.68, 0.62, 0.14, c, 0, 0.5, 1)
	rect(f, 0.24, 0.68, 0.26, 0.26, c, 45, 0.15, 1)
	return f
end

function Icons.Plus(size: UDim2?, parent: Instance?, color: Color3?): Frame
	local f = box("Plus", size, parent)
	local c = color or Color3.new(1, 1, 1)
	rect(f, 0.5, 0.5, 0.64, 0.18, c, 0, 0.3, 1)
	rect(f, 0.5, 0.5, 0.18, 0.64, c, 0, 0.3, 1)
	return f
end

function Icons.Currency(currency: string, size: UDim2?, parent: Instance?): Frame
	if currency == "Gems" then
		return Icons.Gem(size, parent)
	end
	return Icons.Coin(size, parent)
end

return Icons
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="113">
              <Properties>
                <string name="Name">ItemCard</string>
                <string name="Source"><![CDATA[--!strict
-- Rarity-bordered item card (reference "Prize Preview" cards): art area + dark name bar.
-- Supports orbs (2D OrbArt), explosions (burst icon), flyers (3D viewport), tickets (machine).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local PropFactory = require(Shared.Visual.PropFactory)

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local OrbArt = require(script.Parent.OrbArt)
local Icons = require(script.Parent.Icons)
local Viewport = require(script.Parent.Viewport)
local CosmeticModels = require(UI.Parent.VFX.CosmeticModels)
local AudioController = require(UI.Parent.Controllers.AudioController)

local ItemCard = {}

export type CardProps = {
	Parent: Instance?,
	Kind: string, -- "Ball" | "Explosion" | "Flyer" | "Ticket"
	Id: string,
	Size: UDim2?,
	Count: number?,
	Locked: boolean?,
	Selected: boolean?,
	LayoutOrder: number?,
	OnClick: (() -> ())?,
	ShowName: boolean?,
	Spin: boolean?,
}

export type Card = {
	Instance: TextButton,
	SetCount: (Card, number?) -> (),
	SetSelected: (Card, boolean) -> (),
	SetLocked: (Card, boolean) -> (),
}

function ItemCard.Info(kind: string, id: string): (string, string)
	if kind == "Ball" then
		local def = BallDefinitions.Get(id)
		return if def then def.DisplayName else id, if def then def.Rarity else "Uncommon"
	elseif kind == "Ticket" then
		local crate = GachaDefinitions.Get(id)
		return if crate then crate.DisplayName else id, if id == "AdvancedOrbGacha" then "Epic" else "Rare"
	end
	local def = CosmeticDefinitions.Get(kind, id)
	return if def then def.DisplayName else id, if def then def.Rarity else "Uncommon"
end

-- Burst icon for explosion cosmetics (rays in the cosmetic's colours).
function ItemCard.ExplosionArt(parent: Instance, id: string, z: number): Frame
	local def = CosmeticDefinitions.Get("Explosion", id)
	local colors = if def then def.Colors else { "#FFB347", "#FF5E1A" }
	local f: Frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z, Parent = parent })
	Create.Aspect(f, 1)
	for k = 0, 7 do
		Icons.Rect(f, 0.5, 0.5, 0.12, 0.9, Color3.fromHex(colors[(k % #colors) + 1]), k * 22.5, 0.5, z)
	end
	Icons.Circle(f, 0.5, 0.5, 0.5, Color3.fromHex(colors[1]), 0, z + 1)
	Icons.Circle(f, 0.5, 0.5, 0.3, Color3.new(1, 1, 1), 0.2, z + 2)
	return f
end

function ItemCard.Art(parent: Instance, kind: string, id: string, z: number, spin: boolean?): GuiObject
	if kind == "Ball" then
		return OrbArt.Draw(parent, id, z).Root
	elseif kind == "Explosion" then
		return ItemCard.ExplosionArt(parent, id, z)
	elseif kind == "Flyer" then
		return Viewport.Model(parent, CosmeticModels.Flyer(id), { Spin = if spin then 0.8 else nil, Yaw = math.rad(-120), ZIndex = z, Zoom = 1.0 })
	else
		return Viewport.Model(parent, PropFactory.GachaMachine(id == "AdvancedOrbGacha"), { Spin = if spin then 0.6 else nil, Yaw = math.rad(-20), ZIndex = z, Zoom = 0.95 })
	end
end

function ItemCard.new(props: CardProps): Card
	local name, rarity = ItemCard.Info(props.Kind, props.Id)
	local rColor = Theme.Rarity(rarity)
	local root: TextButton = Create("TextButton", {
		Name = props.Kind .. "_" .. props.Id,
		Size = props.Size or UDim2.fromOffset(158, 155),
		BackgroundColor3 = Theme.Colors.CardInner,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		Selectable = true,
	})
	local border = Create.Stroke(root, rColor, 2.5, 0, true)
	local bg: Frame = Create("Frame", {
		Name = "Bg",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Size = UDim2.fromScale(1, 1),
		Parent = root,
	})
	Create.Gradient(bg, rColor, Theme.Colors.CardInner, 90)
	local artHolder: Frame = Create("Frame", {
		Name = "Art",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.04),
		Size = UDim2.fromScale(0.82, if props.ShowName == false then 0.92 else 0.7),
		Parent = root,
	})
	ItemCard.Art(artHolder, props.Kind, props.Id, 2, props.Spin)

	if props.ShowName ~= false then
		local bar: Frame = Create("Frame", {
			Name = "NameBar",
			BackgroundColor3 = Color3.fromHex("#0F1424"),
			BackgroundTransparency = 0.1,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0.2),
			ZIndex = 5,
			Parent = root,
		})
		Create.Text({
			Text = name,
			Size = UDim2.new(1, -8, 1, -2),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Font = Theme.Fonts.Body,
			TextSize = 24,
			Scaled = true,
			Stroke = 1.5,
			ZIndex = 6,
			Parent = bar,
		})
	end

	local countLabel = Create.Text({
		Name = "Count",
		Text = "",
		Size = UDim2.fromScale(0.4, 0.17),
		Position = UDim2.new(1, -6, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		Font = Theme.Fonts.Display,
		TextSize = 22,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Right,
		Stroke = 2,
		ZIndex = 7,
		Parent = root,
	})
	local lockShade: Frame = Create("Frame", {
		Name = "LockShade",
		BackgroundColor3 = Color3.fromHex("#05070D"),
		BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 8,
		Visible = false,
		Parent = root,
	})
	Icons.Lock(UDim2.fromScale(0.34, 0.34), lockShade).Position = UDim2.fromScale(0.33, 0.25)
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local self = { Instance = root } :: any
	function self.SetCount(_: any, n: number?)
		countLabel.Text = if n and n > 1 then ("x" .. n) else ""
	end
	function self.SetSelected(_: any, selected: boolean)
		border.Thickness = if selected then 4.5 else 2.5
		border.Color = if selected then Color3.new(1, 1, 1) else rColor
		TweenService:Create(scale, TweenInfo.new(0.15), { Scale = if selected then 1.05 else 1 }):Play()
	end
	function self.SetLocked(_: any, locked: boolean)
		lockShade.Visible = locked
	end
	self:SetCount(props.Count)
	self:SetLocked(props.Locked == true)
	if props.Selected then
		self:SetSelected(true)
	end

	root.MouseEnter:Connect(function()
		if props.OnClick then
			TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.04 }):Play()
		end
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	if props.OnClick then
		local onClick = props.OnClick
		root.Activated:Connect(function()
			AudioController.Play("Select")
			onClick()
		end)
	end
	root.Parent = props.Parent
	return self :: Card
end

return ItemCard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="114">
              <Properties>
                <string name="Name">OrbArt</string>
                <string name="Source"><![CDATA[--!strict
-- 2D orb renderer used everywhere an orb is shown: UI cards, HUD icons and the in-arena
-- billboards (a camera-facing 2D orb looks like a sphere from any angle and stays crisp).
-- Every orb = shaded base circle + rotating layer (spikes, band, emblem) + gloss + flash.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BallDefinitions = require(ReplicatedStorage:WaitForChild("Shared").Definitions.BallDefinitions)

local UI = script.Parent.Parent
local Create = require(UI.Create)
local Theme = require(UI.Theme)

local OrbArt = {}

-- Container size relative to the orb diameter (room for spikes and rim glow).
OrbArt.Padding = 1.36
local ORB = 1 / OrbArt.Padding

local hex = Color3.fromHex
local WHITE = Color3.new(1, 1, 1)
local INK = hex("#16181F")

export type Handle = {
	Root: Frame,
	Orb: Frame,
	Spin: Frame,
	Flash: Frame,
	Def: BallDefinitions.BallDefinition?,
	SetRotation: (Handle, number) -> (),
	Destroy: (Handle) -> (),
}

type Painter = (e: Frame, base: Color3, accent: Color3) -> ()

local function circle(parent: Instance, cx: number, cy: number, d: number, color: Color3, z: number, transparency: number?): Frame
	local c: Frame = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromScale(d, d),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency or 0,
		ZIndex = z,
		Parent = parent,
	})
	Create.Round(c)
	return c
end

local function oval(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, z: number, rot: number?): Frame
	local c = circle(parent, cx, cy, w, color, z)
	c.Size = UDim2.fromScale(w, h)
	c.Rotation = rot or 0
	return c
end

local function rect(parent: Instance, cx: number, cy: number, w: number, h: number, color: Color3, z: number, rot: number?, corner: number?): Frame
	local r: Frame = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		Rotation = rot or 0,
		ZIndex = z,
		Parent = parent,
	})
	if corner then
		Create.Corner(UDim.new(corner, 0), r)
	end
	return r
end

-- Ring whose stroke thickness follows the frame's pixel size.
local function ring(parent: Instance, cx: number, cy: number, d: number, frac: number, color: Color3, z: number): Frame
	local c = circle(parent, cx, cy, d, color, z, 1)
	local stroke = Create.Stroke(c, color, 2, 0, true)
	local function fit()
		stroke.Thickness = math.max(1, c.AbsoluteSize.X * frac)
	end
	c:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()
	return c
end

local function eyes(e: Frame, y: number?, color: Color3?)
	local ey = y or 0.42
	oval(e, 0.36, ey, 0.12, 0.19, color or INK, 6)
	oval(e, 0.64, ey, 0.12, 0.19, color or INK, 6)
	circle(e, 0.38, ey - 0.05, 0.045, WHITE, 7)
	circle(e, 0.66, ey - 0.05, 0.045, WHITE, 7)
end

local function arc(e: Frame, cx: number, cy: number, radius: number, from: number, to: number, dots: number, d: number, color: Color3, z: number)
	for i = 0, dots - 1 do
		local t = from + (to - from) * i / (dots - 1)
		circle(e, cx + math.cos(t) * radius, cy + math.sin(t) * radius, d, color, z)
	end
end

local Painters: { [string]: Painter } = {
	grin = function(e)
		eyes(e)
		rect(e, 0.5, 0.67, 0.44, 0.17, INK, 6, 0, 0.5)
		rect(e, 0.5, 0.635, 0.34, 0.06, WHITE, 7, 0, 0.3)
	end,
	angry = function(e)
		eyes(e, 0.46)
		rect(e, 0.34, 0.31, 0.22, 0.07, INK, 6, 22, 0.4)
		rect(e, 0.66, 0.31, 0.22, 0.07, INK, 6, -22, 0.4)
		arc(e, 0.5, 0.86, 0.17, math.rad(-150), math.rad(-30), 7, 0.06, INK, 6)
	end,
	smile = function(e)
		eyes(e)
		arc(e, 0.5, 0.5, 0.22, math.rad(25), math.rad(155), 9, 0.075, INK, 6)
	end,
	heavy = function(e)
		rect(e, 0.5, 0.33, 0.56, 0.1, INK, 6, 0, 0.3)
		oval(e, 0.37, 0.45, 0.1, 0.12, INK, 6)
		oval(e, 0.63, 0.45, 0.1, 0.12, INK, 6)
		rect(e, 0.5, 0.68, 0.3, 0.07, INK, 6, 0, 0.5)
	end,
	spring = function(e, _base, accent)
		for i = 0, 3 do
			rect(e, 0.32 + i * 0.12, 0.5, 0.06, 0.42, accent, 6, if i % 2 == 0 then 28 else -28, 0.5)
		end
		eyes(e, 0.28)
	end,
	boomerang = function(e, _base, accent)
		rect(e, 0.4, 0.46, 0.14, 0.5, accent, 6, -38, 0.5)
		rect(e, 0.6, 0.46, 0.14, 0.5, accent, 6, 38, 0.5)
		circle(e, 0.5, 0.64, 0.16, accent, 6)
	end,
	ring = function(e, _base, accent)
		ring(e, 0.5, 0.5, 0.56, 0.07, accent, 6)
		circle(e, 0.5, 0.5, 0.2, accent, 6)
		circle(e, 0.73, 0.27, 0.15, WHITE, 7)
	end,
	fangs = function(e, _base, accent)
		oval(e, 0.36, 0.4, 0.13, 0.13, accent, 6, 0)
		oval(e, 0.64, 0.4, 0.13, 0.13, accent, 6, 0)
		arc(e, 0.5, 0.48, 0.2, math.rad(30), math.rad(150), 8, 0.06, INK, 6)
		rect(e, 0.41, 0.69, 0.08, 0.08, WHITE, 7, 45)
		rect(e, 0.59, 0.69, 0.08, 0.08, WHITE, 7, 45)
	end,
	drip = function(e, _base, accent)
		eyes(e, 0.38)
		for i, x in { 0.32, 0.5, 0.68 } do
			local len = if i == 2 then 0.2 else 0.13
			rect(e, x, 0.68 + len / 2, 0.09, len, accent, 6, 0, 0.5)
			circle(e, x, 0.68 + len, 0.12, accent, 6)
		end
	end,
	magnet = function(e, _base, accent)
		rect(e, 0.34, 0.47, 0.14, 0.38, accent, 6, 0, 0.2)
		rect(e, 0.66, 0.47, 0.14, 0.38, accent, 6, 0, 0.2)
		rect(e, 0.5, 0.67, 0.46, 0.14, accent, 6, 0, 0.5)
		rect(e, 0.34, 0.28, 0.14, 0.1, hex("#9CA2AB"), 7)
		rect(e, 0.66, 0.28, 0.14, 0.1, hex("#9CA2AB"), 7)
	end,
	barrel = function(e, _base, accent)
		circle(e, 0.5, 0.5, 0.48, accent, 6)
		circle(e, 0.5, 0.5, 0.34, INK, 7)
		circle(e, 0.44, 0.44, 0.08, hex("#4A4F59"), 8)
	end,
	snowflake = function(e, _base, accent)
		for k = 0, 2 do
			rect(e, 0.5, 0.5, 0.08, 0.66, accent, 6, k * 60, 0.5)
		end
		for k = 0, 5 do
			local a = math.rad(k * 60 - 90)
			rect(e, 0.5 + math.cos(a) * 0.25, 0.5 + math.sin(a) * 0.25, 0.1, 0.1, accent, 6, 45)
		end
		circle(e, 0.5, 0.5, 0.14, WHITE, 7)
	end,
	mine = function(e, _base, accent)
		rect(e, 0.5, 0.5, 0.1, 0.62, INK, 6, 45, 0.4)
		rect(e, 0.5, 0.5, 0.1, 0.62, INK, 6, -45, 0.4)
		circle(e, 0.5, 0.5, 0.26, INK, 6)
		circle(e, 0.5, 0.5, 0.13, accent, 7)
	end,
	prism = function(e, _base, accent)
		rect(e, 0.5, 0.66, 0.46, 0.07, accent, 6, 0, 0.5)
		rect(e, 0.385, 0.47, 0.07, 0.44, accent, 6, 28, 0.5)
		rect(e, 0.615, 0.47, 0.07, 0.44, accent, 6, -28, 0.5)
		rect(e, 0.82, 0.42, 0.26, 0.035, hex("#FF4F7B"), 5, -12)
		rect(e, 0.82, 0.48, 0.26, 0.035, hex("#FFE14D"), 5, -4)
		rect(e, 0.82, 0.54, 0.26, 0.035, hex("#4FC3FF"), 5, 4)
	end,
	dice = function(e, _base, accent)
		local face = rect(e, 0.5, 0.5, 0.56, 0.56, WHITE, 6, 12, 0.18)
		Create.Stroke(face, accent, 2, 0, true)
		for _, p in { { 0.32, 0.32 }, { 0.68, 0.32 }, { 0.5, 0.5 }, { 0.32, 0.68 }, { 0.68, 0.68 } } do
			circle(face, p[1], p[2], 0.17, accent, 7)
		end
	end,
	ghost = function(e)
		oval(e, 0.37, 0.42, 0.15, 0.23, INK, 6)
		oval(e, 0.63, 0.42, 0.15, 0.23, INK, 6)
		oval(e, 0.5, 0.7, 0.11, 0.14, INK, 6)
	end,
	serpent = function(e, _base, accent)
		for i = 0, 10 do
			local t = i / 10
			circle(e, 0.22 + t * 0.56, 0.5 + math.sin(t * math.pi * 2) * 0.16, 0.12, accent, 6)
		end
		circle(e, 0.8, 0.5, 0.05, INK, 7)
		rect(e, 0.88, 0.5, 0.12, 0.03, hex("#FF3D4F"), 7)
	end,
	hammer = function(e, _base, accent)
		rect(e, 0.46, 0.56, 0.1, 0.56, hex("#8B5A2B"), 6, 40, 0.3)
		rect(e, 0.62, 0.38, 0.4, 0.2, accent, 7, 40, 0.15)
	end,
	gem = function(e, _base, accent)
		rect(e, 0.5, 0.5, 0.42, 0.42, accent, 6, 45, 0.08)
		rect(e, 0.5, 0.5, 0.24, 0.24, WHITE, 7, 45, 0.08).BackgroundTransparency = 0.35
		circle(e, 0.43, 0.4, 0.08, WHITE, 8)
	end,
	bolt = function(e, _base, accent)
		rect(e, 0.56, 0.34, 0.12, 0.36, accent, 6, 25)
		rect(e, 0.5, 0.5, 0.3, 0.1, accent, 6, -15)
		rect(e, 0.44, 0.66, 0.12, 0.36, accent, 6, 25)
	end,
	cell = function(e, _base, accent)
		circle(e, 0.47, 0.48, 0.38, accent, 6)
		circle(e, 0.42, 0.43, 0.12, WHITE, 7, 0.4)
		circle(e, 0.72, 0.7, 0.14, accent, 6)
		circle(e, 0.27, 0.72, 0.09, accent, 6)
	end,
	rook = function(e, _base, accent)
		rect(e, 0.5, 0.74, 0.48, 0.1, accent, 6, 0, 0.2)
		rect(e, 0.5, 0.52, 0.3, 0.36, accent, 6)
		rect(e, 0.5, 0.33, 0.42, 0.1, accent, 6)
		for _, x in { 0.33, 0.5, 0.67 } do
			rect(e, x, 0.25, 0.1, 0.1, accent, 6)
		end
	end,
	rail = function(e, _base, accent)
		rect(e, 0.5, 0.4, 0.74, 0.06, accent, 7)
		rect(e, 0.5, 0.6, 0.74, 0.06, accent, 7)
		for _, x in { 0.24, 0.41, 0.59, 0.76 } do
			rect(e, x, 0.5, 0.07, 0.34, hex("#8B5A2B"), 6)
		end
	end,
	chain = function(e, _base, accent)
		ring(e, 0.32, 0.62, 0.3, 0.09, accent, 6)
		ring(e, 0.5, 0.5, 0.3, 0.09, accent, 7)
		ring(e, 0.68, 0.38, 0.3, 0.09, accent, 6)
	end,
	eye = function(e, _base, accent)
		oval(e, 0.5, 0.5, 0.66, 0.42, WHITE, 6)
		circle(e, 0.5, 0.5, 0.3, accent, 7)
		circle(e, 0.5, 0.5, 0.15, INK, 8)
		circle(e, 0.45, 0.45, 0.06, WHITE, 9)
	end,
	pumpkin = function(e, _base, accent)
		rect(e, 0.36, 0.4, 0.15, 0.15, accent, 6, 45)
		rect(e, 0.64, 0.4, 0.15, 0.15, accent, 6, 45)
		rect(e, 0.5, 0.66, 0.5, 0.13, accent, 6, 0, 0.3)
		rect(e, 0.42, 0.61, 0.06, 0.06, hex("#FF8C1A"), 7)
		rect(e, 0.58, 0.71, 0.06, 0.06, hex("#FF8C1A"), 7)
		rect(e, 0.5, 0.04, 0.08, 0.12, hex("#3E8E1E"), 4)
	end,
}

function OrbArt.Exists(emblem: string): boolean
	return Painters[emblem] ~= nil
end

-- Draws an orb into `parent` (fills it, square). `defId` may be any BallDefinitions id.
-- `stretchable` skips the square constraint so the caller can squash/stretch the art.
function OrbArt.Draw(parent: Instance, defId: string, zBase: number?, stretchable: boolean?): Handle
	local def = BallDefinitions.Get(defId)
	local visual = if def then def.Visual else { Base = "#C9CCD3", Accent = "#3D4450", Emblem = "smile" }
	local base = hex(visual.Base)
	local accent = hex(visual.Accent)
	local z = zBase or 1

	local root: Frame = Create("Frame", {
		Name = "Orb_" .. defId,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = z,
		Parent = parent,
	})
	if not stretchable then
		Create.Aspect(root, 1)
	end

	-- rarity rim glow (legendary / mythic)
	local rim = (visual :: any).Rim
	if rim then
		circle(root, 0.5, 0.5, ORB * 1.22, hex(rim), z, 0.82)
		circle(root, 0.5, 0.5, ORB * 1.11, hex(rim), z, 0.6)
	end

	-- spin layer (rotates when the orb rolls)
	local spin: Frame = Create("Frame", {
		Name = "Spin",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = z + 1,
		Parent = root,
	})
	local spikes = (visual :: any).Spikes or 0
	for k = 1, spikes do
		local a = (k - 1) * (2 * math.pi / spikes)
		local d = ORB * 0.5
		rect(spin, 0.5 + math.cos(a) * d, 0.5 + math.sin(a) * d, ORB * 0.27, ORB * 0.27, base:Lerp(Color3.new(), 0.18), z + 1, math.deg(a) + 45)
	end

	-- outline + shaded body
	circle(root, 0.5, 0.5, ORB * 1.05, base:Lerp(Color3.new(), 0.55), z + 2)
	local body = circle(root, 0.5, 0.5, ORB, base, z + 3)
	local light = base:Lerp(WHITE, 0.38)
	local dark = base:Lerp(Color3.new(), 0.32)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, light),
		ColorSequenceKeypoint.new(0.45, base),
		ColorSequenceKeypoint.new(1, dark),
	})
	grad.Rotation = 50
	grad.Parent = body

	-- emblem layer (inside the spin so it rolls)
	local emblemLayer: Frame = Create("Frame", {
		Name = "EmblemLayer",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(ORB, ORB),
		ZIndex = z + 4,
		Parent = root,
	})
	local emblemSpin: Frame = Create("Frame", {
		Name = "Emblem",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z + 4,
		Parent = emblemLayer,
	})
	if (visual :: any).Band then
		rect(emblemSpin, 0.5, 0.5, 1.0, 0.26, accent, 1, 0, 0.5)
	end
	local painter = Painters[visual.Emblem] or Painters.smile
	painter(emblemSpin, base, accent)
	-- painters use small relative ZIndex values; lift them above the body
	for _, child in emblemSpin:GetDescendants() do
		if child:IsA("GuiObject") then
			child.ZIndex = z + 4 + child.ZIndex
		end
	end

	-- gloss (fixed light from top-left)
	local gloss = oval(root, 0.36, 0.3, ORB * 0.32, ORB * 0.18, WHITE, z + 16, -35)
	gloss.BackgroundTransparency = 0.55

	local flash = circle(root, 0.5, 0.5, ORB * 1.02, WHITE, z + 17, 1)
	flash.Name = "Flash"

	local handle = {
		Root = root,
		Orb = body,
		Spin = spin,
		Flash = flash,
		Def = def,
	} :: any
	function handle.SetRotation(_: any, degrees: number)
		spin.Rotation = degrees
		emblemLayer.Rotation = degrees
	end
	function handle.Destroy(_: any)
		root:Destroy()
	end
	return handle :: Handle
end

-- Small helper for rarity-tinted card backgrounds.
function OrbArt.RarityBackground(frame: GuiObject, rarity: string)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Theme.RarityLight(rarity):Lerp(Theme.Rarity(rarity), 0.55), Theme.RarityDark(rarity))
	g.Rotation = 90
	g.Parent = frame
end

return OrbArt
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="115">
              <Properties>
                <string name="Name">Panel</string>
                <string name="Source"><![CDATA[--!strict
-- Modal panel in the reference style: dark navy body, thin bright border, big display-font
-- title, close button breaking out of the top-right corner, pop-in animation.
local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Create = require(UI.Create)
local Button = require(script.Parent.Button)
local AudioController = require(UI.Parent.Controllers.AudioController)
local UIController = require(UI.Parent.Controllers.UIController)

export type PanelProps = {
	Parent: Instance,
	Name: string,
	Title: string?,
	Size: Vector2, -- design pixels
	OnClose: (() -> ())?,
	TitleSize: number?,
	Border: Color3?,
}

export type Panel = {
	Root: Frame, -- full-screen dimmer + holder
	Body: Frame,
	Content: Frame,
	Title: TextLabel?,
	Visible: boolean,
	Open: (Panel) -> (),
	Close: (Panel) -> (),
	SetTitle: (Panel, string) -> (),
}

local Panel = {}

local POP = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function Panel.new(props: PanelProps): Panel
	local root: Frame = Create("Frame", {
		Name = props.Name,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Active = true,
		Parent = props.Parent,
	})
	local holder: Frame = Create("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(props.Size.X, props.Size.Y),
		Parent = root,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = holder
	-- extra shrink so big menus always fit small screens (phones in landscape)
	local function fit(): number
		local screen = root.AbsoluteSize
		local s = math.max(UIController.Scale, 0.01)
		if screen.X <= 0 or screen.Y <= 0 then
			return 1
		end
		return math.min(1, screen.Y * 0.95 / (props.Size.Y * s), screen.X * 0.97 / (props.Size.X * s))
	end
	local body: Frame = Create("Frame", {
		Name = "Body",
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.04,
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	})
	Create.Corner(4, body)
	Create.Stroke(body, props.Border or Theme.Colors.PanelBorder, 2, 0, true)

	local title: TextLabel? = nil
	local contentTop = 16
	if props.Title then
		title = Create.Text({
			Name = "Title",
			Text = props.Title,
			Size = UDim2.new(0.45, 0, 0, props.TitleSize or 58),
			Position = UDim2.fromOffset(24, 10),
			Font = Theme.Fonts.Display,
			TextSize = props.TitleSize or 58,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2,
			Parent = body,
		})
		contentTop = (props.TitleSize or 58) + 22
	end
	local content: Frame = Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, contentTop),
		Size = UDim2.new(1, -36, 1, -contentTop - 16),
		Parent = body,
	})

	local self = {
		Root = root,
		Body = body,
		Content = content,
		Title = title,
		Visible = false,
	} :: any

	function self.Open(this: any)
		if this.Visible then
			return
		end
		this.Visible = true
		root.Visible = true
		local target = fit()
		scale.Scale = 0.86 * target
		root.BackgroundTransparency = 1
		TweenService:Create(scale, POP, { Scale = target }):Play()
		TweenService:Create(root, FADE, { BackgroundTransparency = 0.55 }):Play()
		AudioController.Play("Open")
	end
	function self.Close(this: any)
		if not this.Visible then
			return
		end
		this.Visible = false
		AudioController.Play("Close")
		local t = TweenService:Create(scale, FADE, { Scale = 0.9 * fit() })
		TweenService:Create(root, FADE, { BackgroundTransparency = 1 }):Play()
		t:Play()
		t.Completed:Once(function()
			if not this.Visible then
				root.Visible = false
			end
		end)
	end
	function self.SetTitle(_: any, text: string)
		if title then
			title.Text = text
		end
	end

	UIController.ScaleChanged:Connect(function()
		if self.Visible then
			scale.Scale = fit()
		end
	end)

	if props.OnClose then
		local onClose = props.OnClose
		Button.Close(holder, function()
			onClose()
		end, UDim2.new(1, -4, 0, 4), 62)
	end
	return self :: Panel
end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="116">
              <Properties>
                <string name="Name">Viewport</string>
                <string name="Source"><![CDATA[--!strict
-- ViewportFrame previews of part-built models (gacha machine, crates, flyers). Optional slow
-- spin driven by one shared RenderStepped loop that only touches visible viewports.
local RunService = game:GetService("RunService")

local UI = script.Parent.Parent
local Create = require(UI.Create)

local Viewport = {}

type Entry = { vp: ViewportFrame, model: Model, base: CFrame, speed: number, angle: number }
local spinning: { Entry } = {}
local running = false

local function ensureLoop()
	if running then
		return
	end
	running = true
	RunService.RenderStepped:Connect(function(dt: number)
		for i = #spinning, 1, -1 do
			local e = spinning[i]
			if e.vp.Parent == nil then
				table.remove(spinning, i)
			elseif e.vp.Visible and e.vp:FindFirstAncestorWhichIsA("LayerCollector") then
				e.angle += dt * e.speed
				e.model:PivotTo(e.base * CFrame.Angles(0, e.angle, 0))
			end
		end
	end)
end

export type Options = {
	Spin: number?, -- radians/second
	Yaw: number?, -- initial yaw (radians)
	Pitch: number?, -- camera pitch (radians)
	Fov: number?,
	Zoom: number?, -- >1 = further away
	ZIndex: number?,
	Name: string?,
	Ambient: Color3?,
}

function Viewport.Model(parent: Instance, model: Model, opts: Options?): ViewportFrame
	local o: Options = opts or {}
	local vp: ViewportFrame = Create("ViewportFrame", {
		Name = o.Name or "Viewport",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = o.Ambient or Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.6, -1, -0.8),
		ZIndex = o.ZIndex or 1,
		Parent = parent,
	})
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local cframe, size = model:GetBoundingBox()
	local base = CFrame.new(-cframe.Position) * model:GetPivot()
	model:PivotTo(base * CFrame.Angles(0, o.Yaw or 0, 0))
	model.Parent = world
	local camera = Instance.new("Camera")
	camera.FieldOfView = o.Fov or 30
	local radius = size.Magnitude / 2
	local dist = radius / math.tan(math.rad(camera.FieldOfView / 2)) * (o.Zoom or 1.05)
	local pitch = o.Pitch or math.rad(-12)
	local dir = (CFrame.Angles(0, 0, 0) * CFrame.Angles(pitch, 0, 0)).LookVector
	camera.CFrame = CFrame.lookAt(-dir * dist, Vector3.zero)
	camera.Parent = vp
	vp.CurrentCamera = camera
	if o.Spin and o.Spin ~= 0 then
		table.insert(spinning, { vp = vp, model = model, base = base, speed = o.Spin, angle = o.Yaw or 0 })
		ensureLoop()
	end
	return vp
end

return Viewport
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">Create</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny declarative instance builder used by every screen.
--   Create("Frame", { Size = ..., Parent = ... , [Create.Children] = {...} })
-- Function values are connected when the key names an event (e.g. Activated = fn).
local Theme = require(script.Parent.Theme)

local Create = {}
Create.Children = newproxy(false)

local function apply(inst: Instance, props: { [any]: any })
	local parent = nil
	for key, value in props do
		if key == Create.Children then
			for _, child in value do
				child.Parent = inst
			end
		elseif key == "Parent" then
			parent = value
		elseif type(value) == "function" then
			local ok, signal = pcall(function()
				return (inst :: any)[key]
			end)
			if ok and typeof(signal) == "RBXScriptSignal" then
				(signal :: RBXScriptSignal):Connect(value)
			else
				error("Create: " .. tostring(key) .. " is not an event of " .. inst.ClassName)
			end
		else
			(inst :: any)[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
end

local function new(className: string, props: { [any]: any }?): any
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: GuiObject).BorderSizePixel = 0
	end
	if props then
		apply(inst, props)
	end
	return inst
end

setmetatable(Create, {
	__call = function(_, className: string, props: { [any]: any }?): any
		return new(className, props)
	end,
})

Create.New = new
Create.Apply = apply

function Create.Corner(radius: number | UDim, parent: Instance?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = if typeof(radius) == "UDim" then radius :: UDim else UDim.new(0, radius :: number)
	c.Parent = parent
	return c
end

function Create.Round(parent: Instance?): UICorner
	return Create.Corner(UDim.new(0.5, 0), parent)
end

function Create.Stroke(parent: Instance?, color: Color3?, thickness: number?, transparency: number?, border: boolean?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.Stroke
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	if border then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	end
	s.Parent = parent
	return s
end

function Create.Gradient(parent: Instance?, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Create.Padding(parent: Instance?, px: number, py: number?): UIPadding
	local p = Instance.new("UIPadding")
	local y = py or px
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, y)
	p.PaddingBottom = UDim.new(0, y)
	p.Parent = parent
	return p
end

function Create.List(parent: Instance?, direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding or 0)
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = vAlign or Enum.VerticalAlignment.Top
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = parent
	return l
end

function Create.Aspect(parent: Instance?, ratio: number): UIAspectRatioConstraint
	local a = Instance.new("UIAspectRatioConstraint")
	a.AspectRatio = ratio
	a.Parent = parent
	return a
end

export type TextProps = {
	Text: string,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Font: Font?,
	TextSize: number?,
	Scaled: boolean?,
	Color: Color3?,
	Stroke: number?,
	StrokeColor: Color3?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Parent: Instance?,
	Name: string?,
	ZIndex: number?,
	LayoutOrder: number?,
	RichText: boolean?,
	Wrapped: boolean?,
}

-- Text in the reference style: bold face, white, dark rounded stroke.
function Create.Text(p: TextProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = p.Name or "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = p.Size
	label.Position = p.Position or UDim2.new()
	label.AnchorPoint = p.AnchorPoint or Vector2.zero
	label.FontFace = p.Font or Theme.Fonts.Body
	label.Text = p.Text
	label.TextColor3 = p.Color or Theme.Colors.Text
	label.TextXAlignment = p.XAlign or Enum.TextXAlignment.Center
	label.TextYAlignment = p.YAlign or Enum.TextYAlignment.Center
	label.RichText = p.RichText == true
	label.TextWrapped = p.Wrapped == true
	if p.Scaled then
		label.TextScaled = true
		if p.TextSize then
			local c = Instance.new("UITextSizeConstraint")
			c.MaxTextSize = p.TextSize
			c.Parent = label
		end
	else
		label.TextSize = p.TextSize or 24
	end
	if p.ZIndex then
		label.ZIndex = p.ZIndex
	end
	if p.LayoutOrder then
		label.LayoutOrder = p.LayoutOrder
	end
	if (p.Stroke or 0) > 0 then
		Create.Stroke(label, p.StrokeColor, p.Stroke)
	end
	label.Parent = p.Parent
	return label
end

return Create
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="118">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="119">
              <Properties>
                <string name="Name">BattleHUD</string>
                <string name="Source"><![CDATA[--!strict
-- In-match HUD reconstructed from the reference battle screenshot (4): mirrored player blocks
-- (avatar with team ring, team-coloured name, hearts, orb name, orb icon), plus banners,
-- 3-2-1 countdown, phase timer, aim prompt with Lock Aim, and the overtime indicator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Icons = require(Client.UI.Components.Icons)
local OrbArt = require(Client.UI.Components.OrbArt)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)

local BattleHUD = {}

type Block = {
	Root: Frame,
	Hearts: { Frame },
	BallName: TextLabel,
	BallIcon: Frame,
	BallId: string?,
	Lock: TextLabel,
	Team: number,
}

local root: Frame
local sides: { Frame } = {}
local blocks: { [number]: Block } = {} -- by userId
local banner: TextLabel
local countdownLabel: TextLabel
local phasePill: Frame
local phaseLabel: TextLabel
local overtimeLabel: TextLabel
local aimBar: Frame
local aimHint: TextLabel
local lockButton: Button.Button
local aimFill: Frame
local phaseConn: RBXScriptConnection?
local aimConn: RBXScriptConnection?
local onLock: (() -> ())?
local thumbCache: { [number]: string } = {}

local function teamColor(team: number): Color3
	return if team == 1 then Theme.Colors.TeamRed else Theme.Colors.TeamBlue
end

local function thumbnail(userId: number, image: ImageLabel)
	if userId <= 0 then
		return
	end
	if thumbCache[userId] then
		image.Image = thumbCache[userId]
		return
	end
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok and content then
			thumbCache[userId] = content
			image.Image = content
		end
	end)
end

local function buildBlock(parent: Frame, p: { [string]: any }, mirrored: boolean, order: number): Block
	local frame: Frame = Create("Frame", {
		Name = "Player_" .. p.UserId,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(320, 340),
		LayoutOrder = order,
		Parent = parent,
	})
	local ax = if mirrored then 1 else 0
	local function x(offset: number): UDim
		return if mirrored then UDim.new(1, -offset) else UDim.new(0, offset)
	end
	local color = teamColor(p.Team)
	-- avatar
	local avatar: Frame = Create("Frame", { BackgroundColor3 = Color3.fromHex("#C9CCD3"), AnchorPoint = Vector2.new(ax, 0), Position = UDim2.new(x(30), UDim.new(0, 0)), Size = UDim2.fromOffset(105, 105), Parent = frame })
	Create.Round(avatar)
	Create.Stroke(avatar, color, 3.5, 0, true)
	local image: ImageLabel = Create("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = avatar })
	Create.Round(image)
	if p.IsBot then
		OrbArt.Draw(avatar, "bumper", 3)
	else
		thumbnail(p.UserId, image)
	end
	-- name
	Create.Text({
		Text = p.Name,
		Size = UDim2.fromOffset(190, 34),
		AnchorPoint = Vector2.new(ax, 0),
		Position = UDim2.new(x(140), UDim.new(0, 8)),
		Font = Theme.Fonts.Display,
		TextSize = 30,
		Scaled = true,
		XAlign = if mirrored then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left,
		Color = color,
		Stroke = 2,
		Parent = frame,
	})
	-- hearts
	local hearts = {}
	for i = 1, 3 do
		local heart = Icons.Heart(UDim2.fromOffset(46, 46), frame)
		heart.AnchorPoint = Vector2.new(ax, 0)
		heart.Position = UDim2.new(x(140 + (i - 1) * 56), UDim.new(0, 50))
		table.insert(hearts, heart)
	end
	local lock = Create.Text({ Text = "LOCKED", Size = UDim2.fromOffset(120, 24), AnchorPoint = Vector2.new(ax, 0), Position = UDim2.new(x(146), UDim.new(0, 100)), Font = Theme.Fonts.Display, TextSize = 18, Scaled = true, XAlign = if mirrored then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left, Color = Color3.fromHex("#7CFF6B"), Stroke = 1.5, Visible = false, Parent = frame })
	-- orb name + icon
	local ballName = Create.Text({ Text = "", Size = UDim2.fromOffset(230, 30), AnchorPoint = Vector2.new(if mirrored then 1 else 0, 0), Position = UDim2.new(if mirrored then UDim.new(1, 0) else UDim.new(0, 0), UDim.new(0, 114)), Font = Theme.Fonts.Body, TextSize = 28, Scaled = true, XAlign = if mirrored then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left, Stroke = 2, Parent = frame })
	local icon: Frame = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(ax, 0), Position = UDim2.new(x(14), UDim.new(0, 150)), Size = UDim2.fromOffset(140, 140), Parent = frame })
	return { Root = frame, Hearts = hearts, BallName = ballName, BallIcon = icon, BallId = nil, Lock = lock, Team = p.Team }
end

function BattleHUD.Show(summary: { [string]: any })
	for _, side in sides do
		for _, child in side:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	table.clear(blocks)
	local counts = { 0, 0 }
	for _, p in summary.Participants do
		counts[p.Team] += 1
		local block = buildBlock(sides[p.Team], p, p.Team == 2, counts[p.Team])
		if summary.Mode == "2v2" then
			local s = Instance.new("UIScale")
			s.Scale = 0.68
			s.Parent = block.Root
			block.Root.Size = UDim2.fromOffset(320 * 0.68, 340 * 0.68)
		end
		blocks[p.UserId] = block
	end
	root.Visible = true
	BattleHUD.Update(summary)
end

function BattleHUD.Update(summary: { [string]: any })
	for _, p in summary.Participants do
		local block = blocks[p.UserId]
		if block then
			local hearts = summary.Hearts[p.Team]
			for i, heart in block.Hearts do
				Icons.SetHeart(heart, i <= hearts)
			end
			if p.Ball and p.Ball ~= block.BallId then
				block.BallId = p.Ball
				for _, child in block.BallIcon:GetChildren() do
					child:Destroy()
				end
				OrbArt.Draw(block.BallIcon, p.Ball)
				local def = BallDefinitions.Get(p.Ball)
				block.BallName.Text = if def then def.DisplayName else p.Ball
			elseif p.Ball == nil and summary.State == "BallSelection" then
				block.BallName.Text = if p.Picked then "Ready!" else "Choosing..."
				block.BallId = nil
				for _, child in block.BallIcon:GetChildren() do
					child:Destroy()
				end
			end
			block.Lock.Visible = summary.State == "AimPhase" and p.Locked
		end
	end
end

-- Animates a team's newest lost heart breaking.
function BattleHUD.BreakHeart(team: number, remaining: number)
	AudioController.Play("HeartBreak")
	for _, block in blocks do
		if block.Team == team then
			local heart = block.Hearts[remaining + 1]
			if heart then
				local s = heart:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
				s.Parent = heart
				s.Scale = 1.6
				TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
				Icons.SetHeart(heart, false)
			end
		end
	end
end

function BattleHUD.Banner(text: string, color: Color3?, duration: number?)
	banner.Text = text
	banner.TextColor3 = color or Color3.new(1, 1, 1)
	banner.Visible = true
	local s = banner:FindFirstChildOfClass("UIScale") :: UIScale
	s.Scale = 2.2
	banner.TextTransparency = 0
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local token = os.clock()
	banner:SetAttribute("Token", token)
	task.delay(duration or 1.6, function()
		if banner:GetAttribute("Token") == token then
			local t = TweenService:Create(banner, TweenInfo.new(0.25), { TextTransparency = 1 })
			t:Play()
			t.Completed:Wait()
			if banner:GetAttribute("Token") == token then
				banner.Visible = false
			end
		end
	end)
end

function BattleHUD.Countdown(deadline: number)
	task.spawn(function()
		local last = -1
		while true do
			local left = deadline - Workspace:GetServerTimeNow()
			local n = math.ceil(left)
			if n <= 0 then
				break
			end
			if n ~= last then
				last = n
				countdownLabel.Text = tostring(n)
				countdownLabel.Visible = true
				local s = countdownLabel:FindFirstChildOfClass("UIScale") :: UIScale
				s.Scale = 1.8
				TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
				AudioController.Play("Countdown")
			end
			RunService.Heartbeat:Wait()
		end
		countdownLabel.Text = "GO!"
		countdownLabel.TextColor3 = Color3.fromHex("#7CFF6B")
		AudioController.Play("CountdownGo")
		task.wait(0.6)
		countdownLabel.Visible = false
		countdownLabel.TextColor3 = Color3.new(1, 1, 1)
	end)
end

function BattleHUD.PhaseTimer(text: string?, deadline: number?)
	if phaseConn then
		phaseConn:Disconnect()
		phaseConn = nil
	end
	if text == nil or deadline == nil then
		phasePill.Visible = false
		return
	end
	phasePill.Visible = true
	phaseConn = RunService.Heartbeat:Connect(function()
		local left = math.max(0, (deadline :: number) - Workspace:GetServerTimeNow())
		phaseLabel.Text = string.format("%s  %d", text :: string, math.ceil(left))
	end)
end

function BattleHUD.ShowAim(deadline: number, total: number, lockCallback: () -> ())
	onLock = lockCallback
	aimBar.Visible = true
	lockButton:SetEnabled(true)
	lockButton:SetText("Lock Aim")
	aimHint.Text = "Drag to aim  ·  Space to lock"
	if aimConn then
		aimConn:Disconnect()
	end
	aimConn = RunService.Heartbeat:Connect(function()
		local left = math.max(0, deadline - Workspace:GetServerTimeNow())
		aimFill.Size = UDim2.fromScale(math.clamp(left / total, 0, 1), 1)
	end)
end

function BattleHUD.AimLocked()
	lockButton:SetEnabled(false)
	lockButton:SetText("Locked!")
	aimHint.Text = "Waiting for the others..."
end

function BattleHUD.HideAim()
	aimBar.Visible = false
	onLock = nil
	if aimConn then
		aimConn:Disconnect()
		aimConn = nil
	end
end

function BattleHUD.Overtime(level: number?)
	if level == nil then
		overtimeLabel.Visible = false
		return
	end
	overtimeLabel.Visible = true
	overtimeLabel.Text = string.format("OVERTIME  x%.2f", 1 + level * 0.25)
end

function BattleHUD.Hide()
	root.Visible = false
	BattleHUD.HideAim()
	BattleHUD.PhaseTimer(nil, nil)
	BattleHUD.Overtime(nil)
	countdownLabel.Visible = false
	banner.Visible = false
end

function BattleHUD.Init()
	root = Create("Frame", { Name = "BattleHUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = UIController.Layer("Battle") })
	for team = 1, 2 do
		local side: Frame = Create("Frame", {
			Name = "Team" .. team,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(if team == 1 then 0 else 1, 0),
			Position = UDim2.new(if team == 1 then 0 else 1, 0, 0, 56),
			Size = UDim2.fromOffset(330, 700),
			Parent = root,
		})
		Create.List(side, Enum.FillDirection.Vertical, 6, if team == 1 then Enum.HorizontalAlignment.Left else Enum.HorizontalAlignment.Right)
		sides[team] = side
	end
	banner = Create.Text({ Text = "", Size = UDim2.fromOffset(1100, 110), Position = UDim2.fromScale(0.5, 0.28), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.Display, TextSize = 90, Scaled = true, Stroke = 5, Visible = false, ZIndex = 20, Parent = root })
	Instance.new("UIScale").Parent = banner
	countdownLabel = Create.Text({ Text = "3", Size = UDim2.fromOffset(400, 200), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.Display, TextSize = 170, Scaled = true, Stroke = 6, Visible = false, ZIndex = 21, Parent = root })
	Instance.new("UIScale").Parent = countdownLabel
	phasePill = Create("Frame", { BackgroundColor3 = Theme.Colors.PanelDeep, BackgroundTransparency = 0.15, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(300, 56), Visible = false, Parent = root })
	Create.Corner(28, phasePill)
	Create.Stroke(phasePill, Theme.Colors.PanelBorder, 2, 0, true)
	phaseLabel = Create.Text({ Text = "", Size = UDim2.fromScale(0.86, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.Display, TextSize = 28, Scaled = true, Stroke = 2, Parent = phasePill })
	overtimeLabel = Create.Text({ Text = "", Size = UDim2.fromOffset(360, 36), Position = UDim2.new(0.5, 0, 0, 72), AnchorPoint = Vector2.new(0.5, 0), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, Color = Color3.fromHex("#FF5A6A"), Stroke = 2.5, Visible = false, Parent = root })

	aimBar = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -28), Size = UDim2.fromOffset(420, 150), Visible = false, Parent = root })
	aimHint = Create.Text({ Text = "", Size = UDim2.new(1, 0, 0, 34), Font = Theme.Fonts.Display, TextSize = 24, Scaled = true, Stroke = 2.5, Parent = aimBar })
	local track: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.LevelTrack, Position = UDim2.fromOffset(66, 44), Size = UDim2.fromOffset(288, 10), Parent = aimBar })
	Create.Corner(5, track)
	aimFill = Create("Frame", { BackgroundColor3 = Color3.fromHex("#7BE52A"), Size = UDim2.fromScale(1, 1), Parent = track })
	Create.Corner(5, aimFill)
	lockButton = Button.new({ Parent = aimBar, Size = UDim2.fromOffset(288, 70), Position = UDim2.new(0.5, 0, 1, 0), AnchorPoint = Vector2.new(0.5, 1), Style = "Green", Text = "Lock Aim", TextSize = 40, OnClick = function()
		if onLock then
			onLock()
		end
	end })
end

return BattleHUD
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="120">
              <Properties>
                <string name="Name">CodesScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Codes (reference guides: Gift -> Codes -> "Enter code here..." -> Redeem).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)
local UIController = require(Client.Controllers.UIController)

local CodesScreen = {}

function CodesScreen.Init()
	local panel = Panel.new({
		Parent = UIController.Layer("Menus"),
		Name = "Codes",
		Title = "Codes",
		Size = Vector2.new(640, 360),
		TitleSize = 48,
		OnClose = function()
			UIController.Close("Codes")
		end,
	})
	local content = panel.Content
	Create.Text({ Text = "Follow the group for new codes every update!", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 4), Font = Theme.Fonts.BodySemi, TextSize = 26, Color = Theme.Colors.TextDim, Parent = content })
	local box: TextBox = Create("TextBox", {
		PlaceholderText = "Enter code here...",
		Text = "",
		ClearTextOnFocus = false,
		FontFace = Theme.Fonts.Display,
		TextSize = 28,
		TextColor3 = Color3.new(1, 1, 1),
		PlaceholderColor3 = Theme.Colors.TextMuted,
		BackgroundColor3 = Theme.Colors.SubBar,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 62),
		Parent = content,
	})
	Create.Stroke(box, Theme.Colors.PanelBorder, 2, 0, true)
	local status = Create.Text({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 122), Font = Theme.Fonts.Body, TextSize = 26, Parent = content })
	local busy = false
	local function redeem()
		if busy or box.Text == "" then
			return
		end
		busy = true
		local result = Remotes.Function("StoreRequest"):InvokeServer("RedeemCode", box.Text)
		busy = false
		if type(result) == "table" and result.ok then
			status.Text = result.message or "Redeemed!"
			status.TextColor3 = Color3.fromHex("#7CFF6B")
			box.Text = ""
		else
			status.Text = if type(result) == "table" and result.error then result.error else "Invalid code."
			status.TextColor3 = Color3.fromHex("#FF5A6A")
		end
	end
	box.FocusLost:Connect(function(enter)
		if enter then
			redeem()
		end
	end)
	Button.new({ Parent = content, Size = UDim2.fromOffset(240, 62), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 1), Style = "Green", Text = "Redeem", TextSize = 34, OnClick = redeem })

	UIController.Register("Codes", {
		Open = function()
			status.Text = ""
			panel:Open()
		end,
		Close = function()
			panel:Close()
		end,
		IsOpen = function()
			return panel.Visible
		end,
	})
end

return CodesScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="121">
              <Properties>
                <string name="Name">GemShop</string>
                <string name="Source"><![CDATA[--!strict
-- Gem packs (the "+" next to the gem counter). Purchases go through Roblox developer products;
-- packs without a configured product id act as free test grants in Studio only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)
local Icons = require(Client.UI.Components.Icons)
local UIController = require(Client.Controllers.UIController)

local GemShop = {}

function GemShop.Init()
	local panel = Panel.new({
		Parent = UIController.Layer("Menus"),
		Name = "Gems",
		Title = "Gems",
		Size = Vector2.new(1000, 520),
		OnClose = function()
			UIController.Close("Gems")
		end,
	})
	local row: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 1, -50), Parent = panel.Content })
	Create.List(row, Enum.FillDirection.Horizontal, 18, Enum.HorizontalAlignment.Center)
	for i, product in Economy.GemProducts do
		local card: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.Card, Size = UDim2.fromOffset(222, 360), LayoutOrder = i, Parent = row })
		Create.Stroke(card, Theme.Colors.PanelBorder, 2, 0, true)
		local art: Frame = Create("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 170), BackgroundColor3 = Color3.new(1, 1, 1), Parent = card })
		Create.Gradient(art, Color3.fromHex("#5BA8FF"), Color3.fromHex("#1C3F99"), 90)
		for k = 1, math.min(i + 1, 4) do
			local gem = Icons.Gem(UDim2.fromOffset(90 - k * 8, 90 - k * 8), art)
			gem.AnchorPoint = Vector2.new(0.5, 0.5)
			gem.Position = UDim2.fromScale(0.5 + (k - 1) * 0.12 * (if k % 2 == 0 then -1 else 1), 0.5 + (k - 1) * 0.08)
		end
		if product.Badge then
			Create.Text({ Text = product.Badge, Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -6, 0, 6), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Display, TextSize = 22, Scaled = true, Color = Theme.Colors.Gold, Stroke = 2, Rotation = 8, Parent = art })
		end
		Create.Text({ Text = Format.Commas(product.Gems), Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 190), Font = Theme.Fonts.Display, TextSize = 40, Scaled = true, Color = Theme.Colors.GemText, Stroke = 2.5, Parent = card })
		Create.Text({ Text = "Gems", Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 234), Font = Theme.Fonts.Body, TextSize = 26, Color = Theme.Colors.TextDim, Parent = card })
		local label = if product.ProductId == 0 then (if RunService:IsStudio() then "Test" else "Soon") else ("R$ " .. product.Robux)
		Button.new({ Parent = card, Size = UDim2.new(1, -24, 0, 62), Position = UDim2.new(0.5, 0, 1, -12), AnchorPoint = Vector2.new(0.5, 1), Style = "Green", Text = label, TextSize = 32, OnClick = function()
			local result = Remotes.Function("StoreRequest"):InvokeServer("BuyGems", product.Key)
			if type(result) == "table" and result.ok then
				if result.message then
					UIController.Toast(result.message, "Success")
				end
			else
				UIController.Toast(if type(result) == "table" and result.error then result.error else "Purchase failed.", "Error")
			end
		end })
	end
	Create.Text({ Text = "Gems reroll your battle offers and buy extra collection picks.", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -30), Font = Theme.Fonts.BodySemi, TextSize = 24, Color = Theme.Colors.TextDim, Parent = panel.Content })

	UIController.Register("Gems", {
		Open = function()
			panel:Open()
		end,
		Close = function()
			panel:Close()
		end,
		IsOpen = function()
			return panel.Visible
		end,
	})
end

return GemShop
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="122">
              <Properties>
                <string name="Name">HUD</string>
                <string name="Source"><![CDATA[--!strict
-- Lobby HUD reconstructed from the reference (screenshot 3):
--   left rail: Store / Inventory tiles, Emotes [R], Trade [T], Codes
--   bottom-left: coin + gem counters (gem "+")       top-centre: level bar + next reward
--   top-right: daily quests                           bottom-centre: Play (+ mode) / queue panel
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local GameConfig = require(Shared.Config.Game)
local QuestDefinitions = require(Shared.Definitions.QuestDefinitions)
local LevelRewards = require(Shared.Definitions.LevelRewards)
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local PropFactory = require(Shared.Visual.PropFactory)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Icons = require(Client.UI.Components.Icons)
local Viewport = require(Client.UI.Components.Viewport)
local OrbArt = require(Client.UI.Components.OrbArt)
local UIController = require(Client.Controllers.UIController)
local StateController = require(Client.Controllers.StateController)
local AudioController = require(Client.Controllers.AudioController)

local HUD = {}

local root: Frame
local coinLabel: TextLabel
local gemLabel: TextLabel
local levelLeft: TextLabel
local levelRight: TextLabel
local levelFill: Frame
local levelText: TextLabel
local rewardIconHolder: Frame
local rewardName: TextLabel
local rewardTopLabel: TextLabel
local pillIconHolder: Frame
local pillLabel: TextLabel
local questRows: { [string]: { Title: TextLabel, Progress: TextLabel, Check: Frame } } = {}
local playButton: Button.Button
local modeButton: Button.Button
local playGroup: Frame
local queuePanel: Frame
local queueTitle: TextLabel
local queueSub: TextLabel
local practiceButton: Button.Button
local inviteButton: Button.Button
local emoteMenu: Frame
local invitePicker: Frame
local inviteList: ScrollingFrame
local mode = "1v1"
local visible = true
local lastCoins = -1

local function tile(name: string, label: string, y: number, iconModel: Model, onClick: () -> ())
	local button: TextButton = Create("TextButton", {
		Name = name,
		Size = UDim2.fromOffset(115, 115),
		Position = UDim2.fromOffset(20, y),
		BackgroundColor3 = Theme.Colors.Tile,
		BackgroundTransparency = 0.3,
		AutoButtonColor = false,
		Text = "",
		Parent = root,
	})
	Create.Stroke(button, Theme.Colors.TileBorder, 2, 0, true)
	local holder: Frame = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 1, -36),
		Position = UDim2.fromOffset(8, 4),
		Parent = button,
	})
	Viewport.Model(holder, iconModel, { Yaw = math.rad(-25), Zoom = 0.95, Fov = 28 })
	Create.Text({
		Text = label,
		Size = UDim2.new(1, -4, 0, 30),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 24,
		Scaled = true,
		Stroke = 2.5,
		ZIndex = 3,
		Parent = button,
	})
	local scale = Instance.new("UIScale")
	scale.Parent = button
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.06 }):Play()
		AudioController.Play("Hover", nil, 0.05)
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	button.Activated:Connect(function()
		AudioController.Play("Click")
		onClick()
	end)
end

local function pill(name: string, label: string, key: string?, y: number, onClick: () -> ())
	local button: TextButton = Create("TextButton", {
		Name = name,
		Size = UDim2.fromOffset(173, 58),
		Position = UDim2.fromOffset(20, y),
		BackgroundColor3 = Theme.Colors.Tile,
		BackgroundTransparency = 0.3,
		AutoButtonColor = false,
		Text = "",
		Parent = root,
	})
	Create.Stroke(button, Theme.Colors.TileBorder, 2, 0, true)
	Create.Text({
		Text = label,
		Size = UDim2.new(1, if key then -64 else -20, 0, 30),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 22,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2,
		Parent = button,
	})
	if key then
		local chip: Frame = Create("Frame", {
			Size = UDim2.fromOffset(32, 36),
			Position = UDim2.new(1, -40, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.fromHex("#2A3350"),
			Parent = button,
		})
		Create.Corner(5, chip)
		Create.Stroke(chip, Color3.fromHex("#7D869C"), 1.5, 0, true)
		Create.Text({ Text = key, Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.Body, TextSize = 24, Scaled = true, Parent = chip })
	end
	button.Activated:Connect(function()
		AudioController.Play("Click")
		onClick()
	end)
	return button
end

local function currencyRow(icon: "Coin" | "Gem", yFromBottom: number, color: Color3): TextLabel
	local row: Frame = Create("Frame", {
		Name = icon .. "Row",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 10, 1, -yFromBottom),
		Size = UDim2.fromOffset(420, 80),
		Parent = root,
	})
	local strip: Frame = Create("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.new(1, 0, 0, 54),
		Position = UDim2.new(0, 30, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = row,
	})
	local fade = Instance.new("UIGradient")
	fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.4), NumberSequenceKeypoint.new(1, 1) })
	fade.Parent = strip
	local iconFrame = if icon == "Coin" then Icons.Coin(UDim2.fromOffset(76, 76), row) else Icons.Gem(UDim2.fromOffset(84, 84), row)
	iconFrame.Position = UDim2.new(0, 0, 0.5, 0)
	iconFrame.AnchorPoint = Vector2.new(0, 0.5)
	iconFrame.ZIndex = 3
	local label = Create.Text({
		Name = "Value",
		Text = "0",
		Size = UDim2.fromOffset(300, 58),
		Position = UDim2.new(0, 96, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Theme.Fonts.Display,
		TextSize = 54,
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Color = color,
		Stroke = 3,
		Parent = row,
	})
	if icon == "Gem" then
		local plus: TextButton = Create("TextButton", {
			Name = "Plus",
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.new(0, 2, 1, -6),
			AnchorPoint = Vector2.new(0, 1),
			BackgroundColor3 = Color3.fromHex("#2F7BF5"),
			AutoButtonColor = true,
			Text = "",
			ZIndex = 5,
			Parent = row,
		})
		Create.Corner(6, plus)
		Create.Stroke(plus, Color3.fromHex("#0D2A66"), 2, 0, true)
		Icons.Plus(UDim2.fromScale(0.8, 0.8), plus).Position = UDim2.fromScale(0.1, 0.1)
		plus.Activated:Connect(function()
			AudioController.Play("Click")
			UIController.Open("Gems")
		end)
	end
	return label
end

local function buildLevelBar()
	local bar: Frame = Create("Frame", {
		Name = "Level",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(560, 60),
		Parent = root,
	})
	levelLeft = Create.Text({ Text = "Lv 1", Size = UDim2.fromOffset(80, 30), Position = UDim2.fromOffset(0, 0), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, Color = Color3.fromHex("#C9C9C9"), Stroke = 2, XAlign = Enum.TextXAlignment.Right, Parent = bar })
	local track: Frame = Create("Frame", {
		BackgroundColor3 = Theme.Colors.LevelTrack,
		Position = UDim2.fromOffset(92, 8),
		Size = UDim2.fromOffset(380, 16),
		Parent = bar,
	})
	Create.Stroke(track, Color3.fromHex("#8E949E"), 1.5, 0, true)
	levelFill = Create("Frame", { BackgroundColor3 = Theme.Colors.LevelFill, Size = UDim2.fromScale(0, 1), Parent = track })
	Create.Gradient(levelFill, Color3.fromHex("#D3D6DC"), Color3.fromHex("#8E949E"), 90)
	levelRight = Create.Text({ Text = "Lv 2", Size = UDim2.fromOffset(80, 30), Position = UDim2.fromOffset(484, 0), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, Color = Color3.fromHex("#C9C9C9"), Stroke = 2, XAlign = Enum.TextXAlignment.Left, Parent = bar })
	levelText = Create.Text({ Text = "0 / 20", Size = UDim2.fromOffset(200, 22), Position = UDim2.new(0.5, 0, 0, 34), AnchorPoint = Vector2.new(0.5, 0), Font = Theme.Fonts.Display, TextSize = 20, Scaled = true, Color = Color3.fromHex("#C9C9C9"), Stroke = 2, Parent = bar })

	-- next level reward (right of the bar)
	local reward: Frame = Create("Frame", { Name = "Reward", BackgroundTransparency = 1, Position = UDim2.fromOffset(575, -6), Size = UDim2.fromOffset(150, 90), Parent = bar })
	rewardTopLabel = Create.Text({ Text = "Lv2 Reward", Size = UDim2.new(1, 0, 0, 16), Font = Theme.Fonts.Display, TextSize = 14, Scaled = true, Color = Color3.fromHex("#9FD8FF"), Stroke = 1.5, Parent = reward })
	rewardIconHolder = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(58, 58), Parent = reward })
	rewardName = Create.Text({ Text = "", Size = UDim2.new(1, 20, 0, 22), Position = UDim2.new(0.5, 0, 0, 70), AnchorPoint = Vector2.new(0.5, 0), Font = Theme.Fonts.Display, TextSize = 18, Scaled = true, Stroke = 2, Parent = reward })
end

local function rewardArt(holder: Frame, reward: LevelRewards.Reward)
	holder:ClearAllChildren()
	if reward.Kind == "Ball" and reward.Id then
		OrbArt.Draw(holder, reward.Id)
	elseif reward.Kind == "Ticket" then
		Viewport.Model(holder, PropFactory.GachaMachine(reward.Id == "AdvancedOrbGacha"), { Yaw = math.rad(-20) })
	elseif reward.Kind == "Gems" then
		Icons.Gem(UDim2.fromScale(1, 1), holder)
	else
		Icons.Coin(UDim2.fromScale(1, 1), holder)
	end
end

local function rewardText(reward: LevelRewards.Reward): string
	if reward.Kind == "Ball" and reward.Id then
		local def = BallDefinitions.Get(reward.Id)
		return if def then def.DisplayName else reward.Id
	elseif reward.Kind == "Ticket" and reward.Id then
		local crate = GachaDefinitions.Get(reward.Id)
		return if crate then crate.DisplayName else "Gacha"
	elseif reward.Kind == "Gems" then
		return string.format("%d Gems", reward.Amount or 0)
	end
	return string.format("%d Coins", reward.Amount or 0)
end

local function buildQuests()
	local panel: Frame = Create("Frame", {
		Name = "Quests",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(300, 190),
		Parent = root,
	})
	local g = Instance.new("UIGradient")
	g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, 0.4), NumberSequenceKeypoint.new(1, 0.2) })
	g.Parent = panel
	Create.Padding(panel, 12, 6)
	Create.List(panel, Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Right)
	for i, quest in QuestDefinitions.Daily do
		local row: Frame = Create("Frame", { Name = quest.Id, BackgroundTransparency = 1, Size = UDim2.fromOffset(260, 58), LayoutOrder = i, Parent = panel })
		local title = Create.Text({ Text = quest.Title, Size = UDim2.fromOffset(260, 28), Font = Theme.Fonts.Body, TextSize = 26, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 1.5, Parent = row })
		local progress = Create.Text({ Text = "0/" .. quest.Goal, Size = UDim2.fromOffset(120, 22), Position = UDim2.fromOffset(0, 30), Font = Theme.Fonts.Display, TextSize = 18, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Color3.fromHex("#B8BCC6"), Stroke = 1.5, Parent = row })
		local coin = Icons.Coin(UDim2.fromOffset(22, 22), row)
		coin.Position = UDim2.fromOffset(176, 31)
		Create.Text({ Text = "X" .. quest.Reward.Coins, Size = UDim2.fromOffset(62, 22), Position = UDim2.fromOffset(200, 30), Font = Theme.Fonts.Display, TextSize = 18, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Theme.Colors.Gold, Stroke = 1.5, Parent = row })
		local check = Icons.Check(UDim2.fromOffset(26, 26), row)
		check.Position = UDim2.fromOffset(140, 28)
		check.Visible = false
		questRows[quest.Id] = { Title = title, Progress = progress, Check = check }
	end
end

local function buildPlay()
	playGroup = Create("Frame", {
		Name = "PlayGroup",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(420, 150),
		Parent = root,
	})
	-- next reward pill above Play (reference: "Lv 3 Reward 😊")
	local rewardPill: Frame = Create("Frame", {
		Name = "RewardPill",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(270, 60),
		Parent = playGroup,
	})
	pillLabel = Create.Text({ Text = "Lv 2 Reward", Size = UDim2.fromOffset(190, 32), Position = UDim2.fromOffset(10, 14), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, Color = Color3.fromHex("#C9C9C9"), Stroke = 2, XAlign = Enum.TextXAlignment.Left, Parent = rewardPill })
	pillIconHolder = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(204, 2), Size = UDim2.fromOffset(56, 56), Parent = rewardPill })

	playButton = Button.new({
		Parent = playGroup,
		Name = "Play",
		Size = UDim2.fromOffset(288, 63),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		Style = "Green",
		Text = "Play",
		TextSize = 44,
		OnClick = function()
			Remotes.Event("QueueRequest"):FireServer("Play", mode)
		end,
	})
	modeButton = Button.new({
		Parent = playGroup,
		Name = "Mode",
		Size = UDim2.fromOffset(86, 63),
		Position = UDim2.new(0.5, 154, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Blue",
		Text = "1V1",
		TextSize = 24,
		OnClick = function()
			mode = if mode == "1v1" then "2v2" else "1v1"
			modeButton:SetText(GameConfig.Modes[mode].Label)
			modeButton:SetStyle(if mode == "1v1" then "Blue" else "Purple")
		end,
	})
end

local function buildQueuePanel()
	queuePanel = Create("Frame", {
		Name = "QueuePanel",
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.06,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(560, 150),
		Visible = false,
		Parent = root,
	})
	Create.Stroke(queuePanel, Theme.Colors.ModalBorder, 2, 0, true)
	queueTitle = Create.Text({ Text = "Waiting for opponent...", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 8), Font = Theme.Fonts.Display, TextSize = 30, Scaled = true, Stroke = 2, Parent = queuePanel })
	queueSub = Create.Text({ Text = "1/2 PLAYERS", Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 46), Font = Theme.Fonts.Body, TextSize = 24, Scaled = true, Color = Theme.Colors.TextDim, Stroke = 1.5, Parent = queuePanel })
	local row: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 10, 1, -66), Size = UDim2.new(1, -20, 0, 56), Parent = queuePanel })
	Create.List(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	inviteButton = Button.new({ Parent = row, Size = UDim2.fromOffset(160, 54), Style = "Blue", Text = "Invite", TextSize = 26, LayoutOrder = 1, OnClick = function()
		invitePicker.Visible = not invitePicker.Visible
		if invitePicker.Visible then
			HUD.RefreshInvites()
		end
	end })
	practiceButton = Button.new({ Parent = row, Size = UDim2.fromOffset(190, 54), Style = "Purple", Text = "Practice Bot", TextSize = 24, LayoutOrder = 2, OnClick = function()
		Remotes.Event("QueueRequest"):FireServer("Practice")
	end })
	Button.new({ Parent = row, Size = UDim2.fromOffset(150, 54), Style = "Red", Text = "Leave", TextSize = 26, LayoutOrder = 3, OnClick = function()
		Remotes.Event("QueueRequest"):FireServer("Leave")
		invitePicker.Visible = false
	end })
	practiceButton.Instance.Visible = GameConfig.Bots.Enabled

	invitePicker = Create("Frame", {
		Name = "InvitePicker",
		BackgroundColor3 = Theme.Colors.Panel,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -10),
		Size = UDim2.fromOffset(420, 300),
		Visible = false,
		Parent = queuePanel,
	})
	Create.Stroke(invitePicker, Theme.Colors.ModalBorder, 2, 0, true)
	Create.Text({ Text = "Invite a player", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 6), Font = Theme.Fonts.Display, TextSize = 22, Scaled = true, Stroke = 2, Parent = invitePicker })
	inviteList = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 44),
		Size = UDim2.new(1, -20, 1, -54),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = invitePicker,
	})
	Create.List(inviteList, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
end

function HUD.RefreshInvites()
	for _, child in inviteList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local any = false
	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then
			any = true
			Button.new({
				Parent = inviteList,
				Size = UDim2.fromOffset(380, 48),
				Style = "Dark",
				Text = player.DisplayName,
				Font = Theme.Fonts.Body,
				TextSize = 26,
				OnClick = function()
					Remotes.Event("InviteRequest"):FireServer(player.UserId)
					invitePicker.Visible = false
				end,
			})
		end
	end
	if not any then
		Create.Text({ Text = "Nobody else is here yet.", Size = UDim2.fromOffset(380, 40), Font = Theme.Fonts.Body, TextSize = 24, Color = Theme.Colors.TextDim, Parent = inviteList })
	end
end

local function buildEmotes()
	emoteMenu = Create("Frame", {
		Name = "EmoteMenu",
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.05,
		Position = UDim2.fromOffset(205, 437),
		Size = UDim2.fromOffset(330, 200),
		Visible = false,
		Parent = root,
	})
	Create.Stroke(emoteMenu, Theme.Colors.TileBorder, 2, 0, true)
	Create.Padding(emoteMenu, 10)
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(150, 50)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.Parent = emoteMenu
	for _, emote in { "wave", "point", "cheer", "laugh", "dance", "dance2" } do
		Button.new({
			Parent = emoteMenu,
			Size = UDim2.fromOffset(150, 50),
			Style = "Dark",
			Text = string.upper(string.sub(emote, 1, 1)) .. string.sub(emote, 2),
			Font = Theme.Fonts.Body,
			TextSize = 24,
			OnClick = function()
				emoteMenu.Visible = false
				local character = Players.LocalPlayer.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					local ok, played = pcall(function()
						return humanoid:PlayEmote(emote)
					end)
					if not ok or not played then
						UIController.Toast("That emote isn't available for your avatar.", "Error")
					end
				end
			end,
		})
	end
end

local function refreshData(data: { [string]: any })
	if data.Coins ~= lastCoins and lastCoins >= 0 then
		local scale = coinLabel:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		scale.Parent = coinLabel
		scale.Scale = 1.15
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	lastCoins = data.Coins
	coinLabel.Text = Format.Commas(data.Coins)
	gemLabel.Text = Format.Commas(data.Gems)
	local need = Economy.XPToNext(data.Level)
	levelLeft.Text = "Lv " .. data.Level
	levelRight.Text = "Lv " .. (data.Level + 1)
	levelText.Text = string.format("%d / %d", data.XP, need)
	TweenService:Create(levelFill, TweenInfo.new(0.4), { Size = UDim2.fromScale(math.clamp(data.XP / need, 0, 1), 1) }):Play()
	local nextReward = LevelRewards.For(data.Level + 1)
	rewardTopLabel.Text = string.format("Lv%d Reward", data.Level + 1)
	rewardName.Text = rewardText(nextReward)
	pillLabel.Text = string.format("Lv %d Reward", data.Level + 1)
	rewardArt(rewardIconHolder, nextReward)
	rewardArt(pillIconHolder, nextReward)

	local quests = data.Quests or { Progress = {}, Done = {} }
	for _, quest in QuestDefinitions.Daily do
		local row = questRows[quest.Id]
		local value = quests.Progress[quest.Id] or 0
		local done = quests.Done[quest.Id] == true
		row.Progress.Text = string.format("%d/%d", math.min(value, quest.Goal), quest.Goal)
		row.Check.Visible = done
		row.Title.TextColor3 = if done then Color3.fromHex("#7CFF6B") else Color3.new(1, 1, 1)
	end
end

local function refreshQueue()
	local station, _ = StateController.MyStation()
	local inQueue = station ~= nil and station.State ~= "InMatch"
	queuePanel.Visible = inQueue and visible
	playGroup.Visible = (not inQueue) and visible
	if not inQueue then
		invitePicker.Visible = false
		return
	end
	local s = station :: { [string]: any }
	local count = 0
	for _, pad in s.Pads do
		if pad.UserId ~= 0 then
			count += 1
		end
	end
	if s.State == "MatchFound" then
		queueTitle.Text = "Match found!"
		queueSub.Text = "Get ready..."
	else
		queueTitle.Text = if s.Mode == "2v2" then "Waiting for players..." else "Waiting for opponent..."
		queueSub.Text = string.format("%d/%d PLAYERS  ·  Win %d", count, s.Capacity, Economy.MatchRewards.Win.Coins)
	end
	practiceButton:SetEnabled(s.State == "Waiting")
	inviteButton:SetEnabled(s.State == "Waiting")
end

function HUD.SetVisible(show: boolean)
	visible = show
	root.Visible = show
	refreshQueue()
end

function HUD.Init()
	root = Create("Frame", {
		Name = "HUD",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = UIController.Layer("HUD"),
	})
	tile("Store", "Store", 140, PropFactory.GachaMachine(false), function()
		UIController.Toggle("Store", "Balls")
	end)
	tile("Inventory", "Inventory", 288, PropFactory.InventoryBox(), function()
		UIController.Toggle("Inventory")
	end)
	pill("Emotes", "Emotes", "R", 437, function()
		emoteMenu.Visible = not emoteMenu.Visible
	end)
	pill("Trade", "Trade", "T", 505, function()
		UIController.Toggle("Trade")
	end)
	pill("Codes", "Codes", nil, 573, function()
		UIController.Toggle("Codes")
	end)
	buildEmotes()
	coinLabel = currencyRow("Coin", 110, Theme.Colors.Gold)
	gemLabel = currencyRow("Gem", 22, Theme.Colors.GemText)
	buildLevelBar()
	buildQuests()
	buildPlay()
	buildQueuePanel()

	StateController.DataChanged:Connect(refreshData)
	if StateController.Data then
		refreshData(StateController.Data)
	end
	StateController.StationChanged:Connect(refreshQueue)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			emoteMenu.Visible = not emoteMenu.Visible
		elseif input.KeyCode == Enum.KeyCode.T then
			UIController.Toggle("Trade")
		end
	end)
end

return HUD
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="123">
              <Properties>
                <string name="Name">InventoryScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Inventory / collection: Orbs, Explosions, Flyers and unopened Gachas. Grid with rarity filter,
-- search, sort, owned/locked states, duplicate counts; detail panel with ability text, stats,
-- Equip (cosmetics) and Open (gacha tickets).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local Rarity = require(Shared.Config.Rarity)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)
local ItemCard = require(Client.UI.Components.ItemCard)
local UIController = require(Client.Controllers.UIController)
local StateController = require(Client.Controllers.StateController)

local InventoryScreen = {}

type Entry = { Kind: string, Id: string, Name: string, Rarity: string, Count: number, Description: string }

local TABS = { { Key = "Ball", Label = "Orbs" }, { Key = "Explosion", Label = "Explosions" }, { Key = "Flyer", Label = "Flyers" }, { Key = "Ticket", Label = "Gachas" } }

local panel: Panel.Panel
local grid: ScrollingFrame
local progressLabel: TextLabel
local detail: Frame
local detailArt: Frame
local detailName: TextLabel
local detailRarity: TextLabel
local detailDesc: TextLabel
local detailStats: TextLabel
local actionButton: Button.Button
local searchBox: TextBox
local sortButton: Button.Button
local tabButtons: { [string]: Button.Button } = {}
local filterButtons: { [string]: Button.Button } = {}
local currentTab = "Ball"
local rarityFilter: string? = nil
local sortMode = "Rarity"
local selected: Entry? = nil

local function entries(): { Entry }
	local list: { Entry } = {}
	if currentTab == "Ball" then
		for _, def in BallDefinitions.All() do
			table.insert(list, { Kind = "Ball", Id = def.Id, Name = def.DisplayName, Rarity = def.Rarity, Count = StateController.Count("Ball", def.Id), Description = def.Description })
		end
	elseif currentTab == "Ticket" then
		for _, crate in GachaDefinitions.All() do
			local count = StateController.Count("Ticket", crate.Id)
			if count > 0 then
				local _, rarity = ItemCard.Info("Ticket", crate.Id)
				table.insert(list, { Kind = "Ticket", Id = crate.Id, Name = crate.DisplayName, Rarity = rarity, Count = count, Description = "An unopened gacha. Open it to get a random prize!" })
			end
		end
	else
		for _, def in CosmeticDefinitions.All(currentTab :: any) do
			table.insert(list, { Kind = def.Kind :: string, Id = def.Id, Name = def.DisplayName, Rarity = def.Rarity, Count = StateController.Count(def.Kind, def.Id), Description = def.Description })
		end
	end
	return list
end

local function showDetail(entry: Entry?)
	selected = entry
	for _, child in detailArt:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if entry == nil then
		detailName.Text = "Select an item"
		detailRarity.Text = ""
		detailDesc.Text = ""
		detailStats.Text = ""
		actionButton.Instance.Visible = false
		return
	end
	ItemCard.Art(detailArt, entry.Kind, entry.Id, 2, true)
	detailName.Text = entry.Name
	detailRarity.Text = entry.Rarity
	detailRarity.TextColor3 = Theme.Rarity(entry.Rarity)
	detailDesc.Text = entry.Description
	detailStats.Text = ""
	if entry.Kind == "Ball" then
		local def = BallDefinitions.Get(entry.Id)
		if def then
			detailStats.Text = string.format("HP %d   ·   Bump %d   ·   Speed %d%%   ·   Size %.1f", def.BaseHP, def.ContactDamage, math.floor(def.Speed * 100), def.Radius * 2)
		end
	end
	if entry.Count > 1 then
		detailStats.Text ..= string.format("\nOwned: x%d", entry.Count)
	end
	actionButton.Instance.Visible = true
	local data = StateController.Data
	if entry.Kind == "Ticket" then
		actionButton:SetText("Open")
		actionButton:SetStyle("Green")
		actionButton:SetEnabled(entry.Count > 0)
	elseif entry.Kind == "Ball" then
		actionButton:SetText(if entry.Count > 0 then "Owned" else "Locked")
		actionButton:SetEnabled(false)
	else
		local equipped = data and data.Equipped and data.Equipped[entry.Kind] == entry.Id
		actionButton:SetText(if equipped then "Equipped" elseif entry.Count > 0 then "Equip" else "Locked")
		actionButton:SetStyle("Blue")
		actionButton:SetEnabled(entry.Count > 0 and not equipped)
	end
end

local function render()
	for _, child in grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for key, b in tabButtons do
		b:SetStyle(if key == currentTab then "Orange" else "Dark")
	end
	for key, b in filterButtons do
		b:SetStyle(if key == (rarityFilter or "All") then "Blue" else "Dark")
	end
	local list = entries()
	local owned, total = 0, 0
	for _, e in list do
		total += 1
		if e.Count > 0 then
			owned += 1
		end
	end
	progressLabel.Text = if currentTab == "Ticket" then string.format("%d unopened", total) else string.format("Collected %d / %d", owned, total)
	local query = string.lower(searchBox.Text)
	local filtered = {}
	for _, e in list do
		if (rarityFilter == nil or e.Rarity == rarityFilter) and (query == "" or string.find(string.lower(e.Name), query, 1, true)) then
			table.insert(filtered, e)
		end
	end
	table.sort(filtered, function(a, b)
		if sortMode == "Name" then
			return a.Name < b.Name
		elseif sortMode == "Owned" and (a.Count > 0) ~= (b.Count > 0) then
			return a.Count > 0
		end
		local ra, rb = Rarity.Get(a.Rarity).Order, Rarity.Get(b.Rarity).Order
		if ra ~= rb then
			return ra > rb
		end
		return a.Name < b.Name
	end)
	local data = StateController.Data
	for i, e in filtered do
		local card = ItemCard.new({
			Parent = grid,
			Kind = e.Kind,
			Id = e.Id,
			Size = UDim2.fromOffset(150, 150),
			Count = e.Count,
			Locked = e.Count <= 0,
			LayoutOrder = i,
			OnClick = function()
				showDetail(e)
			end,
		})
		if data and e.Kind ~= "Ball" and e.Kind ~= "Ticket" and data.Equipped and data.Equipped[e.Kind] == e.Id then
			card:SetSelected(true)
		end
	end
	if #filtered == 0 then
		Create.Text({ Text = if currentTab == "Ticket" then "No unopened gachas. Win battles and level up to earn more!" else "Nothing matches.", Size = UDim2.fromOffset(600, 60), Font = Theme.Fonts.Body, TextSize = 28, Color = Theme.Colors.TextDim, Wrapped = true, Parent = grid })
	end
	if selected then
		for _, e in list do
			if e.Id == selected.Id and e.Kind == selected.Kind then
				showDetail(e)
				return
			end
		end
	end
	showDetail(nil)
end

local function onAction()
	local entry = selected
	if entry == nil then
		return
	end
	if entry.Kind == "Ticket" then
		local result = Remotes.Function("StoreRequest"):InvokeServer("OpenTicket", entry.Id)
		if type(result) == "table" and result.ok then
			UIController.Close("Inventory")
			UIController.Open("Reveal", { Crate = entry.Id, Pulls = result.pulls })
		else
			UIController.Toast(if type(result) == "table" and result.error then result.error else "Couldn't open.", "Error")
		end
	elseif entry.Kind == "Explosion" or entry.Kind == "Flyer" then
		local result = Remotes.Function("StoreRequest"):InvokeServer("Equip", entry.Kind, entry.Id)
		if type(result) == "table" and result.ok then
			UIController.Toast(entry.Name .. " equipped!", "Success")
		else
			UIController.Toast(if type(result) == "table" and result.error then result.error else "Couldn't equip.", "Error")
		end
	end
end

function InventoryScreen.Init()
	panel = Panel.new({
		Parent = UIController.Layer("Menus"),
		Name = "Inventory",
		Title = "Inventory",
		Size = Vector2.new(1180, 800),
		OnClose = function()
			UIController.Close("Inventory")
		end,
	})
	local body = panel.Body
	progressLabel = Create.Text({ Text = "", Size = UDim2.fromOffset(300, 34), Position = UDim2.new(1, -330, 0, 26), Font = Theme.Fonts.Display, TextSize = 24, Scaled = true, XAlign = Enum.TextXAlignment.Right, Color = Theme.Colors.Gold, Stroke = 2, Parent = body })

	local tabs: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 90), Size = UDim2.new(1, -40, 0, 56), Parent = body })
	Create.List(tabs, Enum.FillDirection.Horizontal, 12)
	for i, tab in TABS do
		tabButtons[tab.Key] = Button.new({ Parent = tabs, Size = UDim2.fromOffset(190, 54), Style = "Dark", Text = tab.Label, Font = Theme.Fonts.BodyHeavy, TextSize = 30, LayoutOrder = i, OnClick = function()
			currentTab = tab.Key
			selected = nil
			render()
		end })
	end

	local filters: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 156), Size = UDim2.new(0, 760, 0, 44), Parent = body })
	Create.List(filters, Enum.FillDirection.Horizontal, 8)
	for i, key in { "All", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" } do
		local b = Button.new({ Parent = filters, Size = UDim2.fromOffset(if key == "All" then 70 else 120, 42), Style = "Dark", Text = key, Font = Theme.Fonts.Body, TextSize = 22, LayoutOrder = i, OnClick = function()
			rarityFilter = if key == "All" then nil else key
			render()
		end })
		if key ~= "All" then
			b.Label.TextColor3 = Theme.Rarity(key)
		end
		filterButtons[key] = b
	end
	searchBox = Create("TextBox", {
		Name = "Search",
		PlaceholderText = "Search...",
		Text = "",
		ClearTextOnFocus = false,
		FontFace = Theme.Fonts.Body,
		TextSize = 24,
		TextColor3 = Color3.new(1, 1, 1),
		PlaceholderColor3 = Theme.Colors.TextMuted,
		BackgroundColor3 = Theme.Colors.SubBar,
		Position = UDim2.fromOffset(20, 208),
		Size = UDim2.fromOffset(500, 42),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = body,
	})
	Create.Padding(searchBox, 12, 0)
	Create.Stroke(searchBox, Theme.Colors.PanelBorder, 1.5, 0, true)
	searchBox:GetPropertyChangedSignal("Text"):Connect(render)
	sortButton = Button.new({ Parent = body, Size = UDim2.fromOffset(240, 42), Position = UDim2.fromOffset(540, 208), Style = "Dark", Text = "Sort: Rarity", Font = Theme.Fonts.Body, TextSize = 22, OnClick = function()
		sortMode = if sortMode == "Rarity" then "Name" elseif sortMode == "Name" then "Owned" else "Rarity"
		sortButton:SetText("Sort: " .. sortMode)
		render()
	end })

	grid = Create("ScrollingFrame", { Name = "Grid", BackgroundColor3 = Theme.Colors.Card, BackgroundTransparency = 0.2, Position = UDim2.fromOffset(20, 262), Size = UDim2.fromOffset(760, 520), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, Parent = body })
	Create.Padding(grid, 12)
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(150, 150)
	layout.CellPadding = UDim2.fromOffset(12, 12)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	detail = Create("Frame", { Name = "Detail", BackgroundColor3 = Theme.Colors.Card, Position = UDim2.fromOffset(800, 156), Size = UDim2.fromOffset(360, 626), Parent = body })
	Create.Stroke(detail, Theme.Colors.PanelBorder, 2, 0, true)
	detailArt = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 16), Size = UDim2.fromOffset(220, 220), Parent = detail })
	detailName = Create.Text({ Text = "", Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 246), Font = Theme.Fonts.Body, TextSize = 36, Scaled = true, Stroke = 2, Parent = detail })
	detailRarity = Create.Text({ Text = "", Size = UDim2.new(1, -24, 0, 28), Position = UDim2.fromOffset(12, 288), Font = Theme.Fonts.Display, TextSize = 22, Scaled = true, Stroke = 1.5, Parent = detail })
	detailDesc = Create.Text({ Text = "", Size = UDim2.new(1, -28, 0, 130), Position = UDim2.fromOffset(14, 326), Font = Theme.Fonts.BodySemi, TextSize = 25, Wrapped = true, YAlign = Enum.TextYAlignment.Top, Color = Theme.Colors.TextDim, Parent = detail })
	detailStats = Create.Text({ Text = "", Size = UDim2.new(1, -28, 0, 60), Position = UDim2.fromOffset(14, 460), Font = Theme.Fonts.Body, TextSize = 22, Wrapped = true, YAlign = Enum.TextYAlignment.Top, Color = Color3.fromHex("#9FD8FF"), Parent = detail })
	actionButton = Button.new({ Parent = detail, Size = UDim2.new(1, -40, 0, 62), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1), Style = "Blue", Text = "Equip", TextSize = 32, OnClick = onAction })

	StateController.DataChanged:Connect(function()
		if panel.Visible then
			render()
		end
	end)

	UIController.Register("Inventory", {
		Open = function(_, tab: string?)
			if tab then
				currentTab = tab
			end
			render()
			panel:Open()
		end,
		Close = function()
			panel:Close()
		end,
		IsOpen = function()
			return panel.Visible
		end,
	})
end

return InventoryScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="124">
              <Properties>
                <string name="Name">Notifications</string>
                <string name="Source"><![CDATA[--!strict
-- Toast routing plus actionable popups: battle invites and trade requests (Accept / Decline).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local UIController = require(Client.Controllers.UIController)
local StateController = require(Client.Controllers.StateController)
local AudioController = require(Client.Controllers.AudioController)

local Notifications = {}

local holder: Frame

local function popup(title: string, body: string, timeout: number, onAnswer: (boolean) -> ())
	AudioController.Play("Select")
	local card: Frame = Create("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		Size = UDim2.fromOffset(460, 170),
		Parent = holder,
	})
	Create.Stroke(card, Theme.Colors.ModalBorder, 2, 0, true)
	Create.Text({ Text = title, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Font = Theme.Fonts.Display, TextSize = 24, Scaled = true, Stroke = 2, Parent = card })
	Create.Text({ Text = body, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 44), Font = Theme.Fonts.BodySemi, TextSize = 26, Wrapped = true, Color = Theme.Colors.TextDim, Parent = card })
	local bar: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.PanelBorder, Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4), Parent = card })
	TweenService:Create(bar, TweenInfo.new(timeout, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 4) }):Play()
	local answered = false
	local function answer(value: boolean)
		if answered then
			return
		end
		answered = true
		card:Destroy()
		onAnswer(value)
	end
	Button.new({ Parent = card, Size = UDim2.fromOffset(190, 52), Position = UDim2.new(0, 20, 1, -14), AnchorPoint = Vector2.new(0, 1), Style = "Green", Text = "Accept", TextSize = 28, OnClick = function()
		answer(true)
	end })
	Button.new({ Parent = card, Size = UDim2.fromOffset(190, 52), Position = UDim2.new(1, -20, 1, -14), AnchorPoint = Vector2.new(1, 1), Style = "Red", Text = "Decline", TextSize = 28, OnClick = function()
		answer(false)
	end })
	task.delay(timeout, function()
		answer(false)
	end)
end

function Notifications.Init()
	holder = Create("Frame", {
		Name = "Popups",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -110),
		Size = UDim2.fromOffset(460, 400),
		Parent = UIController.Layer("Overlay"),
	})
	Create.List(holder, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

	StateController.Notified:Connect(function(payload)
		UIController.Toast(payload.Text, payload.Kind)
	end)
	Remotes.Event("InviteReceived").OnClientEvent:Connect(function(invite)
		popup("Battle invite", string.format("%s wants to battle you (%s)!", invite.FromName, string.upper(invite.Mode)), invite.Timeout or 20, function(accept)
			Remotes.Event("InviteResponse"):FireServer(invite.InviteId, accept)
		end)
	end)
	Remotes.Event("TradeState").OnClientEvent:Connect(function(payload)
		if payload.Type == "Request" then
			popup("Trade request", payload.FromName .. " wants to trade with you.", payload.Timeout or 20, function(accept)
				Remotes.Event("TradeRequest"):FireServer("Respond", payload.RequestId, accept)
			end)
		end
	end)
end

return Notifications
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="125">
              <Properties>
                <string name="Name">ResultsScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Match results: VICTORY / DEFEAT, coin + XP rewards with level progress, streak, and
-- Play Again (requeue) / Lobby.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Icons = require(Client.UI.Components.Icons)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)

local ResultsScreen = {}

local root: Frame
local card: Frame
local title: TextLabel
local subtitle: TextLabel
local coinsLabel: TextLabel
local xpLabel: TextLabel
local levelLabel: TextLabel
local levelFill: Frame
local streakLabel: TextLabel
local lastMode = "1v1"
local onDismiss: (() -> ())?
local onRequeue: ((string) -> ())?

function ResultsScreen.Show(payload: { [string]: any }, mode: string, dismissed: () -> (), requeue: ((string) -> ())?)
	lastMode = mode
	onDismiss = dismissed
	onRequeue = requeue
	local won = payload.Won
	title.Text = if won then "VICTORY" else "DEFEAT"
	title.TextColor3 = if won then Theme.Colors.Gold else Color3.fromHex("#FF4F5E")
	subtitle.Text = if payload.Practice then "Practice match (reduced rewards)" elseif payload.Forfeit and won then "Your opponent left the battle" else (if won then "You won the battle!" else "Better luck next time!")
	local rewards = payload.Rewards or {}
	coinsLabel.Text = "+" .. tostring(rewards.Coins or 0)
	xpLabel.Text = "+" .. tostring(rewards.XP or 0) .. " XP"
	levelLabel.Text = string.format("Lv %d   %d / %d", rewards.Level or 1, rewards.XPNow or 0, rewards.XPNeed or 20)
	levelFill.Size = UDim2.fromScale(0, 1)
	TweenService:Create(levelFill, TweenInfo.new(0.8, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp((rewards.XPNow or 0) / math.max(1, rewards.XPNeed or 1), 0, 1), 1) }):Play()
	streakLabel.Text = if (rewards.Streak or 0) >= 2 then string.format("Win streak: %d", rewards.Streak) else ""
	root.Visible = true
	local s = card:FindFirstChildOfClass("UIScale") :: UIScale
	s.Scale = 0.7
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	AudioController.Play(if won then "Victory" else "Defeat")
end

function ResultsScreen.Hide()
	if not root.Visible then
		return
	end
	root.Visible = false
	local cb = onDismiss
	onDismiss = nil
	if cb then
		cb()
	end
end

function ResultsScreen.IsOpen(): boolean
	return root.Visible
end

function ResultsScreen.Init()
	root = Create("Frame", { Name = "Results", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Size = UDim2.fromScale(1, 1), Visible = false, Active = true, Parent = UIController.Layer("Overlay") })
	card = Create("Frame", { BackgroundColor3 = Color3.fromHex("#121729"), BackgroundTransparency = 0.04, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(808, 500), Parent = root })
	Create.Stroke(card, Theme.Colors.ModalBorder, 2, 0, true)
	Instance.new("UIScale").Parent = card
	title = Create.Text({ Text = "VICTORY", Size = UDim2.new(1, -40, 0, 90), Position = UDim2.fromOffset(20, 18), Font = Theme.Fonts.Display, TextSize = 80, Scaled = true, Stroke = 4, Parent = card })
	subtitle = Create.Text({ Text = "", Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 110), Font = Theme.Fonts.Body, TextSize = 30, Color = Theme.Colors.TextDim, Parent = card })

	local rewards: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.Card, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 160), Size = UDim2.fromOffset(600, 180), Parent = card })
	Create.Stroke(rewards, Theme.Colors.PanelBorder, 2, 0, true)
	local coin = Icons.Coin(UDim2.fromOffset(64, 64), rewards)
	coin.Position = UDim2.fromOffset(40, 18)
	coinsLabel = Create.Text({ Text = "+0", Size = UDim2.fromOffset(180, 60), Position = UDim2.fromOffset(116, 20), Font = Theme.Fonts.Display, TextSize = 50, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Theme.Colors.Gold, Stroke = 3, Parent = rewards })
	xpLabel = Create.Text({ Text = "+0 XP", Size = UDim2.fromOffset(230, 60), Position = UDim2.new(1, -30, 0, 20), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Display, TextSize = 44, Scaled = true, XAlign = Enum.TextXAlignment.Right, Color = Color3.fromHex("#9FD8FF"), Stroke = 3, Parent = rewards })
	local track: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.LevelTrack, Position = UDim2.fromOffset(40, 112), Size = UDim2.new(1, -80, 0, 18), Parent = rewards })
	Create.Stroke(track, Color3.fromHex("#8E949E"), 1.5, 0, true)
	levelFill = Create("Frame", { BackgroundColor3 = Color3.fromHex("#7BE52A"), Size = UDim2.fromScale(0, 1), Parent = track })
	levelLabel = Create.Text({ Text = "", Size = UDim2.new(1, -80, 0, 28), Position = UDim2.fromOffset(40, 138), Font = Theme.Fonts.Display, TextSize = 20, Scaled = true, Color = Color3.fromHex("#C9C9C9"), Stroke = 2, Parent = rewards })
	streakLabel = Create.Text({ Text = "", Size = UDim2.new(1, -40, 0, 30), Position = UDim2.fromOffset(20, 348), Font = Theme.Fonts.Display, TextSize = 24, Color = Color3.fromHex("#FFB347"), Stroke = 2, Parent = card })

	Button.new({ Parent = card, Size = UDim2.fromOffset(300, 70), Position = UDim2.new(0.5, -12, 1, -24), AnchorPoint = Vector2.new(1, 1), Style = "Green", Text = "Play Again", TextSize = 36, OnClick = function()
		local requeue = onRequeue
		ResultsScreen.Hide()
		if requeue then
			requeue(lastMode)
		else
			Remotes.Event("QueueRequest"):FireServer("Play", lastMode)
		end
	end })
	Button.new({ Parent = card, Size = UDim2.fromOffset(300, 70), Position = UDim2.new(0.5, 12, 1, -24), AnchorPoint = Vector2.new(0, 1), Style = "Blue", Text = "Lobby", TextSize = 36, OnClick = function()
		ResultsScreen.Hide()
	end })
end

return ResultsScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="126">
              <Properties>
                <string name="Name">RevealScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Gacha reveal (reference screenshot 2: square panel, sunburst rays, item art, green "Receive")
-- and the reward modal (screenshot 3: "You got a Ball Gacha for finishing your first battle",
-- art card, blue "Claim"). Reward modals queue while a match UI is active.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local Rarity = require(Shared.Config.Rarity)
local PropFactory = require(Shared.Visual.PropFactory)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local ItemCard = require(Client.UI.Components.ItemCard)
local Viewport = require(Client.UI.Components.Viewport)
local Icons = require(Client.UI.Components.Icons)
local OrbArt = require(Client.UI.Components.OrbArt)
local UIController = require(Client.Controllers.UIController)
local AudioController = require(Client.Controllers.AudioController)

local RevealScreen = {}

local overlay: Frame
local stage: Frame
local raysFrame: Frame
local single: Frame
local singleTitle: TextLabel
local singleArt: Frame
local singleRarity: TextLabel
local singleNew: TextLabel
local multi: Frame
local multiGrid: Frame
local receive: Button.Button
local shaker: Frame
local isOpen = false
local spinConn: RBXScriptConnection?

-- reward modal
local modal: Frame
local modalTitle: TextLabel
local modalArt: Frame
local modalClaim: Button.Button
local modalQueue: { { [string]: any } } = {}
local modalBusy = false
local held = false

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function buildRays(parent: Frame)
	-- GuiObjects rotate around their own centre, so each bar spans the whole burst
	-- (two opposite rays per bar), fading out toward both ends.
	for k = 0, 6 do
		local ray: Frame = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.1, 1.24),
			BackgroundColor3 = Color3.fromHex("#BDF3FF"),
			Rotation = k * (180 / 7),
			Parent = parent,
		})
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Rotation = 90
		g.Parent = ray
	end
	local glow: Frame = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.62), BackgroundColor3 = Color3.fromHex("#59E1FF"), BackgroundTransparency = 0.55, Parent = parent })
	Create.Round(glow)
end

local function setRayColor(color: Color3)
	for _, child in raysFrame:GetChildren() do
		if child:IsA("Frame") then
			child.BackgroundColor3 = color
		end
	end
end

local function close()
	isOpen = false
	overlay.Visible = false
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	clear(singleArt)
	clear(multiGrid)
	clear(shaker)
	RevealScreen.Pump()
end

local function bestRarity(pulls: { { [string]: any } }): string
	local best = "Uncommon"
	for _, p in pulls do
		if Rarity.Get(p.Rarity).Order > Rarity.Get(best).Order then
			best = p.Rarity
		end
	end
	return best
end

local function open(args: { Crate: string?, Pulls: { { [string]: any } } })
	isOpen = true
	overlay.Visible = true
	single.Visible = false
	multi.Visible = false
	raysFrame.Visible = false
	receive.Instance.Visible = false
	clear(shaker)
	shaker.Visible = true
	local crate = if args.Crate then GachaDefinitions.Get(args.Crate) else nil
	local model = if crate and (crate.Art == "Machine" or crate.Art == "MachineAdvanced") then PropFactory.GachaMachine(crate.Art == "MachineAdvanced") elseif crate then PropFactory.Crate(if crate.Art == "CrateFlyer" then "Flyer" elseif crate.Art == "CrateExplosion" then "Explosion" else "Event") else PropFactory.GachaMachine(false)
	Viewport.Model(shaker, model, { Yaw = math.rad(-20), Zoom = 0.9 })

	-- anticipation shake
	AudioController.Play("GachaShake")
	local t0 = os.clock()
	if spinConn then
		spinConn:Disconnect()
	end
	spinConn = RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock() - t0
		if shaker.Visible then
			shaker.Rotation = math.sin(t * 38) * (6 + t * 10)
		end
		raysFrame.Rotation += dt * 25
	end)
	task.wait(0.9)
	if not isOpen then
		return
	end
	shaker.Visible = false
	raysFrame.Visible = true
	local best = bestRarity(args.Pulls)
	setRayColor(Theme.RarityLight(best))
	local order = Rarity.Get(best).Order
	if order >= 4 then
		AudioController.Play("LegendaryPull")
	elseif order >= 2 then
		AudioController.Play("RarePull")
	else
		AudioController.Play("GachaReveal")
	end

	if #args.Pulls == 1 then
		local pull = args.Pulls[1]
		local name, rarity = ItemCard.Info(pull.Kind, pull.Id)
		single.Visible = true
		singleTitle.Text = name
		singleRarity.Text = rarity
		singleRarity.TextColor3 = Theme.Rarity(rarity)
		singleNew.Visible = pull.New == true
		ItemCard.Art(singleArt, pull.Kind, pull.Id, 3, true)
		local scale = singleArt:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		scale.Parent = singleArt
		scale.Scale = 0.2
		TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	else
		multi.Visible = true
		for i, pull in args.Pulls do
			local card = ItemCard.new({ Parent = multiGrid, Kind = pull.Kind, Id = pull.Id, Size = UDim2.fromOffset(150, 150), LayoutOrder = i })
			card.Instance.Visible = false
			task.delay(0.08 * i, function()
				card.Instance.Visible = true
				local scale = card.Instance:FindFirstChildOfClass("UIScale") :: UIScale?
				if scale then
					scale.Scale = 0.3
					TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
				end
				AudioController.Play("Select", nil, nil, 0.6)
			end)
		end
	end
	task.wait(0.4)
	receive.Instance.Visible = isOpen
end

---------------------------------------------------------------------------------------------
-- Reward modal

local MODAL_TEXT = {
	FirstBattle = "You got an Orb Gacha for finishing your first battle",
	Group = "Thanks for joining the group! Here's an Advanced Orb Gacha",
	Weekly = "You placed #%d on last week's board!",
	LevelUp = "Level %d reached!",
}

local function showModal(info: { [string]: any })
	modalBusy = true
	modal.Visible = true
	clear(modalArt)
	local text = MODAL_TEXT[info.Kind] or "Reward!"
	if info.Kind == "Weekly" then
		text = string.format(text, info.Rank or 1)
	elseif info.Kind == "LevelUp" then
		text = string.format(text, info.Level or 1)
		AudioController.Play("LevelUp")
	else
		AudioController.Play("Reward")
	end
	modalTitle.Text = text
	local ticket = info.Ticket
	local reward = info.Reward
	if reward and reward.Kind == "Ball" then
		OrbArt.Draw(modalArt, reward.Id)
	elseif reward and (reward.Kind == "Coins" or reward.Kind == "Gems") then
		Icons.Currency(reward.Kind, UDim2.fromScale(0.8, 0.8), modalArt).Position = UDim2.fromScale(0.1, 0.1)
	else
		local id = ticket or (reward and reward.Id) or "OrbGacha"
		Viewport.Model(modalArt, PropFactory.GachaMachine(id == "AdvancedOrbGacha"), { Yaw = math.rad(-20), Zoom = 0.9, Spin = 0.5 })
	end
	local openTicket = ticket or (if reward and reward.Kind == "Ticket" then reward.Id else nil)
	modalClaim:SetText(if openTicket then "Claim" else "Nice!")
	local conn: RBXScriptConnection
	conn = modalClaim.Instance.Activated:Connect(function()
		conn:Disconnect()
		modal.Visible = false
		modalBusy = false
		if openTicket then
			local result = Remotes.Function("StoreRequest"):InvokeServer("OpenTicket", openTicket)
			if type(result) == "table" and result.ok then
				UIController.Open("Reveal", { Crate = openTicket, Pulls = result.pulls })
				return
			end
		end
		RevealScreen.Pump()
	end)
end

function RevealScreen.Pump()
	if modalBusy or held or isOpen or #modalQueue == 0 then
		return
	end
	showModal(table.remove(modalQueue, 1) :: { [string]: any })
end

function RevealScreen.Hold(hold: boolean)
	held = hold
	if not hold then
		RevealScreen.Pump()
	end
end

function RevealScreen.QueueReward(info: { [string]: any })
	table.insert(modalQueue, info)
	RevealScreen.Pump()
end

function RevealScreen.Init()
	local layer = UIController.Layer("Overlay")
	overlay = Create("Frame", { Name = "Reveal", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), Visible = false, Active = true, Parent = layer })
	stage = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(900, 620), Parent = overlay })
	raysFrame = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.44), Size = UDim2.fromOffset(620, 620), Parent = stage })
	buildRays(raysFrame)
	shaker = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(300, 300), Parent = stage })

	single = Create("Frame", { Name = "Single", BackgroundColor3 = Theme.Colors.Panel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.44), Size = UDim2.fromOffset(300, 300), Visible = false, Parent = stage })
	Create.Stroke(single, Color3.fromHex("#2A3A66"), 2, 0, true)
	singleTitle = Create.Text({ Text = "", Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 10), Font = Theme.Fonts.Body, TextSize = 36, Scaled = true, Stroke = 2.5, ZIndex = 4, Parent = single })
	singleArt = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.56), Size = UDim2.fromOffset(200, 200), ZIndex = 3, Parent = single })
	singleRarity = Create.Text({ Text = "", Size = UDim2.new(1, -20, 0, 32), Position = UDim2.new(0, 10, 1, -38), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, Stroke = 2, ZIndex = 4, Parent = single })
	singleNew = Create.Text({ Text = "NEW!", Size = UDim2.fromOffset(90, 34), Position = UDim2.new(1, -10, 0, 50), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, Color = Color3.fromHex("#FFE14D"), Stroke = 2.5, Rotation = 12, ZIndex = 6, Parent = single })

	multi = Create("Frame", { Name = "Multi", BackgroundColor3 = Theme.Colors.Panel, BackgroundTransparency = 0.05, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.44), Size = UDim2.fromOffset(880, 400), Visible = false, Parent = stage })
	Create.Stroke(multi, Theme.Colors.PanelBorder, 2, 0, true)
	multiGrid = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 30), Size = UDim2.new(1, -40, 1, -50), Parent = multi })
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(150, 150)
	grid.CellPadding = UDim2.fromOffset(16, 26)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = multiGrid

	receive = Button.new({ Parent = stage, Size = UDim2.fromOffset(240, 64), Position = UDim2.new(0.5, 0, 1, -10), AnchorPoint = Vector2.new(0.5, 1), Style = "Green", Text = "Receive", TextSize = 40, OnClick = function()
		AudioController.Play("Purchase")
		close()
	end })

	-- reward modal (first battle / group / weekly / level up)
	modal = Create("Frame", { Name = "RewardModal", BackgroundColor3 = Color3.fromHex("#121729"), BackgroundTransparency = 0.06, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(808, 454), Visible = false, Active = true, Parent = layer })
	Create.Stroke(modal, Theme.Colors.ModalBorder, 2, 0, true)
	modalTitle = Create.Text({ Text = "", Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 34), Font = Theme.Fonts.Body, TextSize = 34, Scaled = true, Stroke = 1.5, Parent = modal })
	local card: Frame = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(180, 232), BackgroundColor3 = Color3.new(1, 1, 1), Parent = modal })
	Create.Gradient(card, Color3.fromHex("#FF4BE0"), Color3.fromHex("#7A1FA8"), 90)
	Create.Stroke(card, Color3.fromHex("#FF7BEA"), 2, 0, true)
	modalArt = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(160, 200), Parent = card })
	modalClaim = Button.new({ Parent = modal, Size = UDim2.fromOffset(272, 68), Position = UDim2.new(0.5, 0, 1, -24), AnchorPoint = Vector2.new(0.5, 1), Style = "Blue", Text = "Claim", TextSize = 40 })

	UIController.Register("Reveal", {
		Open = function(_, args)
			task.spawn(open, args)
		end,
		Close = function()
			close()
		end,
		IsOpen = function()
			return isOpen
		end,
	})

	Remotes.Event("RewardPopup").OnClientEvent:Connect(function(info)
		RevealScreen.QueueReward(info)
	end)
end

return RevealScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="127">
              <Properties>
                <string name="Name">SelectionScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Orb selection each round: three random offers (CONFIRMED), reroll for gems (LIKELY), and the
-- once-per-match free collection pick (CONFIRMED). Timer, opponent status, locked-in state.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local Rarity = require(Shared.Config.Rarity)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local OrbArt = require(Client.UI.Components.OrbArt)
local ItemCard = require(Client.UI.Components.ItemCard)
local Icons = require(Client.UI.Components.Icons)
local UIController = require(Client.Controllers.UIController)
local StateController = require(Client.Controllers.StateController)
local AudioController = require(Client.Controllers.AudioController)

local SelectionScreen = {}

local root: Frame
local holder: Frame
local title: TextLabel
local timerLabel: TextLabel
local cardsRow: Frame
local rerollButton: Button.Button
local collectionButton: Button.Button
local opponentLabel: TextLabel
local collectionView: Frame
local collectionGrid: ScrollingFrame
local current: { [string]: any }? = nil
local cards: { TextButton } = {}
local timerConn: RBXScriptConnection?
local lastTick = -1

local function send(action: string, arg: any)
	Remotes.Event("SelectionRequest"):FireServer(action, arg)
end

local function offerCard(index: number, defId: string, picked: boolean, isSelected: boolean): TextButton
	local def = BallDefinitions.Get(defId)
	local rarity = if def then def.Rarity else "Uncommon"
	local rColor = Theme.Rarity(rarity)
	local card: TextButton = Create("TextButton", {
		Name = "Offer" .. index,
		Size = UDim2.fromOffset(320, 440),
		BackgroundColor3 = Theme.Colors.Card,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = index,
		Selectable = true,
	})
	local stroke = Create.Stroke(card, rColor, if isSelected then 5 else 2.5, 0, true)
	if isSelected then
		stroke.Color = Color3.new(1, 1, 1)
	end
	local top: Frame = Create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 0, 0, 220), Parent = card })
	OrbArt.RarityBackground(top, rarity)
	local artHolder: Frame = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(190, 190), Parent = top })
	local art = OrbArt.Draw(artHolder, defId, 2)
	local tag: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.PanelDeep, BackgroundTransparency = 0.2, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(130, 30), ZIndex = 10, Parent = top })
	Create.Corner(15, tag)
	Create.Text({ Text = rarity, Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), Font = Theme.Fonts.Display, TextSize = 18, Scaled = true, Color = rColor, Stroke = 1, ZIndex = 11, Parent = tag })
	Create.Text({ Text = if def then def.DisplayName else defId, Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 228), Font = Theme.Fonts.BodyHeavy, TextSize = 36, Scaled = true, Stroke = 2, Parent = card })
	Create.Text({ Text = if def then def.Description else "", Size = UDim2.new(1, -24, 0, 112), Position = UDim2.fromOffset(12, 272), Font = Theme.Fonts.BodySemi, TextSize = 23, Wrapped = true, YAlign = Enum.TextYAlignment.Top, Color = Theme.Colors.TextDim, Parent = card })
	if def then
		local stats: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.PanelDeep, Position = UDim2.new(0, 10, 1, -48), Size = UDim2.new(1, -20, 0, 38), Parent = card })
		Create.Corner(8, stats)
		local heart = Icons.Heart(UDim2.fromOffset(26, 26), stats)
		heart.Position = UDim2.fromOffset(10, 6)
		Create.Text({ Text = tostring(def.BaseHP), Size = UDim2.fromOffset(60, 30), Position = UDim2.fromOffset(40, 4), Font = Theme.Fonts.Display, TextSize = 20, XAlign = Enum.TextXAlignment.Left, Stroke = 1.5, Parent = stats })
		Create.Text({ Text = string.format("Bump %d  ·  Size %.1f", def.ContactDamage, def.Radius * 2), Size = UDim2.fromOffset(190, 30), Position = UDim2.new(1, -10, 0, 4), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Body, TextSize = 22, XAlign = Enum.TextXAlignment.Right, Color = Color3.fromHex("#9FD8FF"), Parent = stats })
	end
	if picked then
		if isSelected then
			local stamp = Create.Text({ Text = "LOCKED IN", Size = UDim2.fromOffset(260, 50), Position = UDim2.fromScale(0.5, 0.25), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.Display, TextSize = 36, Scaled = true, Color = Color3.fromHex("#7CFF6B"), Stroke = 3, Rotation = -8, ZIndex = 30, Parent = card })
			local s = Instance.new("UIScale")
			s.Scale = 1.8
			s.Parent = stamp
			TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		else
			Create("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 25, Parent = card })
		end
	end
	local scale = Instance.new("UIScale")
	scale.Parent = card
	card.MouseEnter:Connect(function()
		if not picked then
			TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.04 }):Play()
			AudioController.Play("Hover", nil, 0.05)
		end
	end)
	card.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	card.Activated:Connect(function()
		if picked then
			return
		end
		AudioController.Play("Select")
		send("Pick", index)
	end)
	-- idle wobble of the art
	task.spawn(function()
		local t = index
		while card.Parent do
			t += RunService.Heartbeat:Wait()
			art:SetRotation(math.sin(t * 1.5) * 8)
		end
	end)
	return card
end

local function renderCollection()
	for _, child in collectionGrid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local data = StateController.Data
	if data == nil then
		return
	end
	local list = {}
	for id, count in data.Balls do
		local def = BallDefinitions.Get(id)
		if def and count > 0 then
			table.insert(list, def)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Rarity.Get(a.Rarity).Order, Rarity.Get(b.Rarity).Order
		if ra ~= rb then
			return ra > rb
		end
		return a.DisplayName < b.DisplayName
	end)
	for i, def in list do
		ItemCard.new({ Parent = collectionGrid, Kind = "Ball", Id = def.Id, Size = UDim2.fromOffset(140, 140), LayoutOrder = i, OnClick = function()
			send("Collection", def.Id)
			collectionView.Visible = false
		end })
	end
end

local function render(payload: { [string]: any })
	for _, card in cards do
		card:Destroy()
	end
	table.clear(cards)
	for i, id in payload.Offers do
		local card = offerCard(i, id, payload.Picked, payload.Selected == id)
		card.Parent = cardsRow
		table.insert(cards, card)
	end
	-- picked from collection (not one of the offers)
	if payload.Picked and payload.Selected and not table.find(payload.Offers, payload.Selected) then
		for _, card in cards do
			card:Destroy()
		end
		table.clear(cards)
		local card = offerCard(1, payload.Selected, true, true)
		card.Parent = cardsRow
		table.insert(cards, card)
	end
	title.Text = if payload.Picked then "Waiting for opponent..." else string.format("Round %d · Choose your Orb", payload.Round or 1)
	rerollButton:SetText(string.format("Reroll  %d", payload.RerollCost))
	rerollButton:SetEnabled(not payload.Picked and (payload.RerollsLeft or 0) > 0)
	collectionButton:SetText(if (payload.FreePicksLeft or 0) > 0 then "Collection · FREE" else string.format("Collection · %d", payload.CollectionCost))
	collectionButton:SetEnabled(not payload.Picked)
end

function SelectionScreen.SetOpponentStatus(text: string)
	opponentLabel.Text = text
end

function SelectionScreen.Show(payload: { [string]: any })
	local first = current == nil or current.Round ~= payload.Round
	current = payload
	root.Visible = true
	render(payload)
	if first then
		collectionView.Visible = false
		local s = holder:FindFirstChildOfClass("UIScale") :: UIScale
		s.Scale = 0.85
		TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		AudioController.Play("Open")
	end
	if timerConn then
		timerConn:Disconnect()
	end
	timerConn = RunService.Heartbeat:Connect(function()
		local left = math.max(0, (payload.Deadline or 0) - Workspace:GetServerTimeNow())
		local whole = math.ceil(left)
		timerLabel.Text = tostring(whole)
		timerLabel.TextColor3 = if left <= 5 then Color3.fromHex("#FF5A6A") else Color3.new(1, 1, 1)
		if whole ~= lastTick and whole <= 5 and whole > 0 and not payload.Picked then
			AudioController.Play("Countdown", nil, nil, 0.5)
		end
		lastTick = whole
	end)
end

function SelectionScreen.Hide()
	if timerConn then
		timerConn:Disconnect()
		timerConn = nil
	end
	current = nil
	root.Visible = false
	collectionView.Visible = false
end

function SelectionScreen.Init()
	root = Create("Frame", { Name = "Selection", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.6, Size = UDim2.fromScale(1, 1), Visible = false, Active = true, Parent = UIController.Layer("Battle") })
	holder = Create("Frame", { BackgroundColor3 = Theme.Colors.Panel, BackgroundTransparency = 0.04, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(1110, 640), Parent = root })
	Create.Stroke(holder, Theme.Colors.ModalBorder, 2, 0, true)
	Instance.new("UIScale").Parent = holder
	title = Create.Text({ Text = "Choose your Orb", Size = UDim2.new(1, -200, 0, 50), Position = UDim2.fromOffset(24, 14), Font = Theme.Fonts.Display, TextSize = 40, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 2.5, Parent = holder })
	local timerPill: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.PanelDeep, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 14), Size = UDim2.fromOffset(110, 54), Parent = holder })
	Create.Corner(27, timerPill)
	Create.Stroke(timerPill, Theme.Colors.PanelBorder, 2, 0, true)
	timerLabel = Create.Text({ Text = "15", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.Display, TextSize = 36, Scaled = true, Stroke = 2, Parent = timerPill })
	cardsRow = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 80), Size = UDim2.new(1, -40, 0, 450), Parent = holder })
	Create.List(cardsRow, Enum.FillDirection.Horizontal, 28, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local bottom: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 24, 1, -88), Size = UDim2.new(1, -48, 0, 70), Parent = holder })
	rerollButton = Button.new({ Parent = bottom, Size = UDim2.fromOffset(250, 64), Position = UDim2.fromOffset(0, 3), Style = "Blue", Text = "Reroll 10", TextSize = 28, OnClick = function()
		send("Reroll", nil)
	end })
	local gem = Icons.Gem(UDim2.fromOffset(36, 36), rerollButton.Content)
	gem.Position = UDim2.new(1, -46, 0.5, -18)
	gem.ZIndex = 6
	collectionButton = Button.new({ Parent = bottom, Size = UDim2.fromOffset(330, 64), Position = UDim2.fromOffset(268, 3), Style = "Purple", Text = "Collection · FREE", TextSize = 26, OnClick = function()
		renderCollection()
		collectionView.Visible = true
	end })
	opponentLabel = Create.Text({ Text = "", Size = UDim2.fromOffset(420, 64), Position = UDim2.new(1, 0, 0, 3), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Body, TextSize = 28, Scaled = true, XAlign = Enum.TextXAlignment.Right, Color = Theme.Colors.TextDim, Stroke = 1.5, Parent = bottom })

	collectionView = Create("Frame", { BackgroundColor3 = Theme.Colors.PanelDeep, BackgroundTransparency = 0.02, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 40, Active = true, Parent = holder })
	Create.Text({ Text = "Pick any Orb from your collection", Size = UDim2.new(1, -220, 0, 44), Position = UDim2.fromOffset(24, 16), Font = Theme.Fonts.Display, TextSize = 30, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 2, ZIndex = 41, Parent = collectionView })
	Button.new({ Parent = collectionView, Size = UDim2.fromOffset(150, 52), Position = UDim2.new(1, -20, 0, 14), AnchorPoint = Vector2.new(1, 0), Style = "Blue", Text = "Back", TextSize = 26, ZIndex = 42, OnClick = function()
		collectionView.Visible = false
	end })
	collectionGrid = Create("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 80), Size = UDim2.new(1, -48, 1, -100), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ZIndex = 41, Parent = collectionView })
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(140, 140)
	grid.CellPadding = UDim2.fromOffset(12, 12)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = collectionGrid
end

return SelectionScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="128">
              <Properties>
                <string name="Name">StoreScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Store reconstructed from the reference (screenshot 1): title, currency bars, four coloured tabs
-- (Events / Orbs / Explosions / Flyers), paged crate cards with odds, prize preview strip,
-- "View All", Open 1 / Open 10 with prices, and a "Tradable" badge.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GachaDefinitions = require(Shared.Definitions.GachaDefinitions)
local Rarity = require(Shared.Config.Rarity)
local PropFactory = require(Shared.Visual.PropFactory)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Icons = require(Client.UI.Components.Icons)
local Panel = require(Client.UI.Components.Panel)
local ItemCard = require(Client.UI.Components.ItemCard)
local Viewport = require(Client.UI.Components.Viewport)
local OrbArt = require(Client.UI.Components.OrbArt)
local CosmeticModels = require(Client.VFX.CosmeticModels)
local UIController = require(Client.Controllers.UIController)
local StateController = require(Client.Controllers.StateController)

local StoreScreen = {}

local TAB_LABEL = { Events = "Events", Balls = "Orbs", Explosions = "Explosions", Flyers = "Flyers" }
local TAB_WIDTH = { Events = 125, Balls = 260, Explosions = 260, Flyers = 260 }

local panel: Panel.Panel
local pager: Frame
local subLabel: TextLabel
local coinValue: TextLabel
local gemValue: TextLabel
local prevButton: Button.Button
local nextButton: Button.Button
local viewAll: Frame
local viewAllGrid: ScrollingFrame
local viewAllTitle: TextLabel
local currentTab = "Balls"
local page = 1
local opening = false
local tabButtons: { [string]: TextButton } = {}

local function currencyBar(parent: Instance, x: number, isGem: boolean): TextLabel
	local bar: Frame = Create("Frame", {
		Name = if isGem then "GemBar" else "CoinBar",
		Position = UDim2.fromOffset(x, 18),
		Size = UDim2.fromOffset(250, 46),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	})
	Create.Corner(4, bar)
	if isGem then
		Create.Gradient(bar, Color3.fromHex("#5BA8FF"), Color3.fromHex("#2C6FE0"), 90)
	else
		Create.Gradient(bar, Color3.fromHex("#FFC14D"), Color3.fromHex("#F08C00"), 90)
	end
	Create.Stroke(bar, Color3.fromHex("#1A1D26"), 2.5, 0, true)
	local icon = if isGem then Icons.Gem(UDim2.fromOffset(80, 80), bar) else Icons.Coin(UDim2.fromOffset(76, 76), bar)
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.new(0, 0, 0.5, 0)
	icon.ZIndex = 4
	local value = Create.Text({ Text = "0", Size = UDim2.new(1, -60, 1, -8), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Font = Theme.Fonts.Display, TextSize = 34, Scaled = true, XAlign = Enum.TextXAlignment.Right, Stroke = 2.5, Parent = bar })
	if isGem then
		Button.new({ Parent = parent, Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(x + 262, 17), Style = "Blue", Text = "+", TextSize = 34, OnClick = function()
			UIController.Open("Gems")
		end })
	end
	return value
end

local function tabIcon(tab: string, holder: Frame)
	if tab == "Balls" then
		OrbArt.Draw(holder, "thorn")
	elseif tab == "Explosions" then
		ItemCard.ExplosionArt(holder, "confetti", 2)
	elseif tab == "Flyers" then
		Viewport.Model(holder, CosmeticModels.Flyer("saucer"), { Yaw = math.rad(-30), Pitch = math.rad(-25) })
	else
		for i = 0, 3 do
			local sq = Icons.Rect(holder, 0.32 + (i % 2) * 0.36, 0.32 + (i // 2) * 0.36, 0.3, 0.3, Color3.new(1, 1, 1), 0, 0.18, 2)
			sq.BackgroundTransparency = 0.05
		end
	end
end

local function priceButton(parent: Instance, crate: GachaDefinitions.Crate, count: number, x: number)
	local b = Button.new({
		Parent = parent,
		Size = UDim2.fromOffset(241, 68),
		Position = UDim2.new(0, x, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		Style = "Grey",
		Text = "",
		OnClick = function()
			StoreScreen.OpenCrate(crate.Id, count)
		end,
	})
	Create.Text({ Text = "Open " .. count, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 4), Font = Theme.Fonts.Body, TextSize = 28, Scaled = true, Stroke = 2, ZIndex = 4, Parent = b.Content })
	Create.Text({ Text = Format.Commas(crate.Price * count), Size = UDim2.new(0.62, 0, 0, 34), Position = UDim2.new(0.62, 0, 0, 30), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Display, TextSize = 34, Scaled = true, XAlign = Enum.TextXAlignment.Right, Stroke = 2.5, ZIndex = 4, Parent = b.Content })
	local icon = Icons.Currency(crate.Currency, UDim2.fromOffset(38, 38), b.Content)
	icon.Position = UDim2.new(0.66, 0, 0, 28)
	icon.ZIndex = 5
end

local function crateCard(crate: GachaDefinitions.Crate, index: number): Frame
	local card: Frame = Create("Frame", {
		Name = crate.Id,
		BackgroundColor3 = Theme.Colors.Card,
		Size = UDim2.fromOffset(530, 535),
		LayoutOrder = index,
	})
	Create.Stroke(card, Theme.Colors.PanelBorder, 2, 0, true)
	-- header
	local cur = Icons.Currency(crate.Currency, UDim2.fromOffset(34, 34), card)
	cur.Position = UDim2.fromOffset(12, 8)
	Create.Text({ Text = crate.DisplayName, Size = UDim2.fromOffset(330, 30), Position = UDim2.fromOffset(52, 10), Font = Theme.Fonts.Display, TextSize = 22, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 1.5, Parent = card })
	local swap = Icons.Swap(UDim2.fromOffset(34, 34), card)
	swap.Position = UDim2.new(1, -170, 0, 8)
	Create.Text({ Text = "Tradable", Size = UDim2.fromOffset(120, 30), Position = UDim2.new(1, -130, 0, 10), Font = Theme.Fonts.Body, TextSize = 28, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Theme.Colors.Success, Stroke = 1.5, Parent = card })

	-- crate art
	local art: Frame = Create("Frame", { Name = "Art", Position = UDim2.fromOffset(14, 48), Size = UDim2.fromOffset(250, 195), BackgroundColor3 = Color3.new(1, 1, 1), Parent = card })
	if crate.Theme == "Gems" then
		Create.Gradient(art, Color3.fromHex("#FF4BE0"), Color3.fromHex("#9B1FD6"), 90)
		Create.Stroke(art, Color3.fromHex("#FF7BEA"), 2, 0, true)
	elseif crate.Theme == "Event" then
		Create.Gradient(art, Color3.fromHex("#FFB347"), Color3.fromHex("#B03A00"), 90)
		Create.Stroke(art, Color3.fromHex("#FFD08A"), 2, 0, true)
	else
		Create.Gradient(art, Color3.fromHex("#2A3A66"), Color3.fromHex("#131A30"), 90)
		Create.Stroke(art, Theme.Colors.PanelBorder, 2, 0, true)
	end
	local model = if crate.Art == "Machine" or crate.Art == "MachineAdvanced" then PropFactory.GachaMachine(crate.Art == "MachineAdvanced") else PropFactory.Crate(if crate.Art == "CrateFlyer" then "Flyer" elseif crate.Art == "CrateExplosion" then "Explosion" else "Event")
	Viewport.Model(art, model, { Yaw = math.rad(-25), Zoom = 0.9, Spin = 0.25 })

	-- odds / event info
	local odds: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(280, 70), Size = UDim2.fromOffset(236, 150), Parent = card })
	Create.List(odds, Enum.FillDirection.Vertical, 3)
	if crate.Odds then
		for i, rarityId in Rarity.Order do
			local pct = crate.Odds[rarityId]
			if pct then
				local row: Frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(236, 30), LayoutOrder = i, Parent = odds })
				Create.Text({ Text = rarityId .. ":", Size = UDim2.fromScale(0.6, 1), Font = Theme.Fonts.Body, TextSize = 28, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Theme.Rarity(rarityId), Stroke = 1.5, Parent = row })
				Create.Text({ Text = string.format("%.2f%%", pct), Size = UDim2.fromScale(0.4, 1), Position = UDim2.fromScale(0.6, 0), Font = Theme.Fonts.Body, TextSize = 28, Scaled = true, XAlign = Enum.TextXAlignment.Right, Stroke = 1.5, Parent = row })
			end
		end
	elseif crate.Items then
		local total = 0
		for _, item in crate.Items do
			total += item.Weight
		end
		for i, item in crate.Items do
			local name, rarityId = ItemCard.Info(item.Kind, item.Id)
			local row: Frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(236, 30), LayoutOrder = i, Parent = odds })
			Create.Text({ Text = name, Size = UDim2.fromScale(0.68, 1), Font = Theme.Fonts.Body, TextSize = 24, Scaled = true, XAlign = Enum.TextXAlignment.Left, Color = Theme.Rarity(rarityId), Stroke = 1.5, Parent = row })
			Create.Text({ Text = string.format("%.2f%%", item.Weight / total * 100), Size = UDim2.fromScale(0.32, 1), Position = UDim2.fromScale(0.68, 0), Font = Theme.Fonts.Body, TextSize = 24, Scaled = true, XAlign = Enum.TextXAlignment.Right, Stroke = 1.5, Parent = row })
		end
	end

	-- prize preview
	Create.Text({ Text = "Prize Preview", Size = UDim2.fromOffset(240, 32), Position = UDim2.fromOffset(14, 254), Font = Theme.Fonts.Body, TextSize = 32, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 1.5, Parent = card })
	local viewAllButton: TextButton = Create("TextButton", { BackgroundTransparency = 1, Text = "View All >", FontFace = Theme.Fonts.Body, TextSize = 26, TextColor3 = Theme.Colors.TextDim, Position = UDim2.new(1, -140, 0, 256), Size = UDim2.fromOffset(126, 30), TextXAlignment = Enum.TextXAlignment.Right, Parent = card })
	Create.Stroke(viewAllButton, Theme.Colors.Stroke, 1.5)
	viewAllButton.Activated:Connect(function()
		StoreScreen.ShowAll(crate)
	end)
	local strip: ScrollingFrame = Create("ScrollingFrame", {
		Name = "Prizes",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 290),
		Size = UDim2.new(1, -28, 0, 150),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 4,
		Parent = card,
	})
	Create.List(strip, Enum.FillDirection.Horizontal, 8)
	local pool = GachaDefinitions.Pool(crate)
	table.sort(pool, function(a, b)
		return Rarity.Get(a.Rarity).Order > Rarity.Get(b.Rarity).Order
	end)
	for i, item in pool do
		if i > 8 then
			break
		end
		ItemCard.new({ Parent = strip, Kind = item.Kind, Id = item.Id, Size = UDim2.fromOffset(140, 140), LayoutOrder = i })
	end

	priceButton(card, crate, 1, 14)
	priceButton(card, crate, 10, 275)
	return card
end

local function renderTab()
	for _, child in pager:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for name, button in tabButtons do
		local stroke = button:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if name == currentTab then Color3.new(1, 1, 1) else Color3.fromHex("#0B0F1A")
			stroke.Thickness = if name == currentTab then 3 else 2
		end
	end
	local crates = {}
	for _, crate in GachaDefinitions.ForTab(currentTab) do
		if GachaDefinitions.IsActive(crate, Workspace:GetServerTimeNow()) then
			table.insert(crates, crate)
		end
	end
	local pages = math.max(1, math.ceil(#crates / 2))
	page = math.clamp(page, 1, pages)
	for i = (page - 1) * 2 + 1, math.min(#crates, page * 2) do
		crateCard(crates[i], i).Parent = pager
	end
	prevButton.Instance.Visible = page > 1
	nextButton.Instance.Visible = page < pages
	if #crates == 0 then
		Create.Text({ Text = "No events right now. Check back soon!", Size = UDim2.fromOffset(700, 60), Font = Theme.Fonts.Body, TextSize = 34, Color = Theme.Colors.TextDim, Parent = pager })
	end
	if currentTab == "Events" then
		local event = GachaDefinitions.Get("HarvestCrate")
		local left = if event and event.EndsAt then event.EndsAt - Workspace:GetServerTimeNow() else 0
		subLabel.Text = if left > 0 then "Harvest Moon event · ends in " .. Format.Duration(left) else "Events"
	else
		subLabel.Text = "Every pull is decided by the server. Duplicates can be traded."
	end
end

function StoreScreen.ShowAll(crate: GachaDefinitions.Crate)
	for _, child in viewAllGrid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	viewAllTitle.Text = crate.DisplayName .. " — all prizes"
	local pool = GachaDefinitions.Pool(crate)
	local perRarity: { [string]: number } = {}
	for _, item in pool do
		perRarity[item.Rarity] = (perRarity[item.Rarity] or 0) + 1
	end
	local totalWeight = 0
	if crate.Items then
		for _, it in crate.Items do
			totalWeight += it.Weight
		end
	end
	for i, item in pool do
		local holder: Frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(150, 186), LayoutOrder = i, Parent = viewAllGrid })
		ItemCard.new({ Parent = holder, Kind = item.Kind, Id = item.Id, Size = UDim2.fromOffset(150, 150) })
		local chance = 0
		if crate.Odds then
			chance = (crate.Odds[item.Rarity] or 0) / math.max(1, perRarity[item.Rarity] or 1)
		elseif crate.Items then
			for _, it in crate.Items do
				if it.Id == item.Id then
					chance = it.Weight / totalWeight * 100
				end
			end
		end
		Create.Text({ Text = string.format("%.2f%%", chance), Size = UDim2.fromOffset(150, 30), Position = UDim2.fromOffset(0, 154), Font = Theme.Fonts.Body, TextSize = 26, Color = Theme.Rarity(item.Rarity), Stroke = 1.5, Parent = holder })
	end
	viewAll.Visible = true
end

function StoreScreen.OpenCrate(crateId: string, count: number)
	if opening then
		return
	end
	local crate = GachaDefinitions.Get(crateId)
	local data = StateController.Data
	if crate and data then
		local balance = if crate.Currency == "Coins" then data.Coins else data.Gems
		if balance < crate.Price * count then
			UIController.Toast(if crate.Currency == "Coins" then "Not enough coins!" else "Not enough gems!", "Error")
			if crate.Currency == "Gems" then
				UIController.Open("Gems")
			end
			return
		end
	end
	opening = true
	local result = Remotes.Function("StoreRequest"):InvokeServer("OpenCrate", crateId, count)
	opening = false
	if type(result) ~= "table" or not result.ok then
		UIController.Toast(if type(result) == "table" and result.error then result.error else "Purchase failed.", "Error")
		return
	end
	UIController.Open("Reveal", { Crate = crateId, Pulls = result.pulls })
end

local function refreshCurrency(data: { [string]: any })
	coinValue.Text = Format.Commas(data.Coins)
	gemValue.Text = Format.Commas(data.Gems)
end

function StoreScreen.Init()
	panel = Panel.new({
		Parent = UIController.Layer("Menus"),
		Name = "Store",
		Title = "Store",
		Size = Vector2.new(1140, 810),
		OnClose = function()
			UIController.Close("Store")
		end,
	})
	local body = panel.Body
	coinValue = currencyBar(body, 520, false)
	gemValue = currencyBar(body, 800, true)

	-- tabs
	local tabs: Frame = Create("Frame", { Name = "Tabs", BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 92), Size = UDim2.new(1, -40, 0, 96), Parent = body })
	Create.List(tabs, Enum.FillDirection.Horizontal, 18)
	for i, tab in GachaDefinitions.Tabs do
		local colors = Theme.Tabs[tab]
		local button: TextButton = Create("TextButton", { Name = tab, Size = UDim2.fromOffset(TAB_WIDTH[tab], 92), BackgroundColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, Text = "", LayoutOrder = i, Parent = tabs })
		Create.Corner(6, button)
		Create.Gradient(button, colors.Top, colors.Bottom, 90)
		Create.Stroke(button, Color3.fromHex("#0B0F1A"), 2, 0, true)
		local icon: Frame = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -18), Size = UDim2.fromOffset(92, 92), ZIndex = 2, Parent = button })
		tabIcon(tab, icon)
		Create.Text({ Text = TAB_LABEL[tab], Size = UDim2.new(1, -10, 0, 40), Position = UDim2.new(0.5, 0, 1, -24), AnchorPoint = Vector2.new(0.5, 0.5), Font = Theme.Fonts.BodyHeavy, TextSize = 40, Scaled = true, Stroke = 2.5, ZIndex = 10, Parent = button })
		button.Activated:Connect(function()
			currentTab = tab
			page = 1
			renderTab()
		end)
		tabButtons[tab] = button
	end

	local sub: Frame = Create("Frame", { Name = "SubBar", BackgroundColor3 = Theme.Colors.SubBar, Position = UDim2.fromOffset(20, 198), Size = UDim2.new(1, -40, 0, 44), Parent = body })
	subLabel = Create.Text({ Text = "", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Font = Theme.Fonts.BodySemi, TextSize = 24, Scaled = true, Color = Theme.Colors.TextDim, XAlign = Enum.TextXAlignment.Left, Parent = sub })

	pager = Create("Frame", { Name = "Pager", BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 252), Size = UDim2.new(1, -40, 0, 540), Parent = body })
	Create.List(pager, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center)
	nextButton = Button.new({ Parent = body, Size = UDim2.fromOffset(42, 68), Position = UDim2.new(1, -6, 1, -26), AnchorPoint = Vector2.new(1, 1), Style = "Blue", Text = ">", TextSize = 30, ZIndex = 5, OnClick = function()
		page += 1
		renderTab()
	end })
	prevButton = Button.new({ Parent = body, Size = UDim2.fromOffset(42, 68), Position = UDim2.new(0, 6, 1, -26), AnchorPoint = Vector2.new(0, 1), Style = "Blue", Text = "<", TextSize = 30, ZIndex = 5, OnClick = function()
		page -= 1
		renderTab()
	end })

	-- "View All" overlay
	viewAll = Create("Frame", { Name = "ViewAll", BackgroundColor3 = Theme.Colors.PanelDeep, BackgroundTransparency = 0.02, Size = UDim2.fromScale(1, 1), ZIndex = 30, Visible = false, Active = true, Parent = body })
	viewAllTitle = Create.Text({ Text = "", Size = UDim2.new(1, -120, 0, 50), Position = UDim2.fromOffset(24, 16), Font = Theme.Fonts.Display, TextSize = 34, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 2, ZIndex = 31, Parent = viewAll })
	viewAllGrid = Create("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 80), Size = UDim2.new(1, -48, 1, -100), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ZIndex = 31, Parent = viewAll })
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(150, 190)
	grid.CellPadding = UDim2.fromOffset(16, 12)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = viewAllGrid
	Button.new({ Parent = viewAll, Size = UDim2.fromOffset(150, 54), Position = UDim2.new(1, -20, 0, 16), AnchorPoint = Vector2.new(1, 0), Style = "Blue", Text = "Back", TextSize = 26, ZIndex = 32, OnClick = function()
		viewAll.Visible = false
	end })

	StateController.DataChanged:Connect(refreshCurrency)
	if StateController.Data then
		refreshCurrency(StateController.Data)
	end

	UIController.Register("Store", {
		Open = function(_, tab: string?)
			if tab and TAB_LABEL[tab] then
				currentTab = tab
			end
			page = 1
			viewAll.Visible = false
			renderTab()
			panel:Open()
		end,
		Close = function()
			panel:Close()
		end,
		IsOpen = function()
			return panel.Visible
		end,
	})
end

return StoreScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="129">
              <Properties>
                <string name="Name">TradeScreen</string>
                <string name="Source"><![CDATA[--!strict
-- Trading UI: pick a player -> request -> two-sided offer window -> both Ready -> short
-- confirmation countdown (cancellable). Any change resets both Ready flags and flashes an
-- anti-scam warning. All validation happens on the server (TradingService).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)
local Rarity = require(Shared.Config.Rarity)
local Remotes = require(Shared.Net.Remotes)

local Client = script.Parent.Parent.Parent
local Theme = require(Client.UI.Theme)
local Create = require(Client.UI.Create)
local Button = require(Client.UI.Components.Button)
local Panel = require(Client.UI.Components.Panel)
local ItemCard = require(Client.UI.Components.ItemCard)
local Icons = require(Client.UI.Components.Icons)
local UIController = require(Client.Controllers.UIController)
local StateController = require(Client.Controllers.StateController)

local TradeScreen = {}

local panel: Panel.Panel
local pickView: Frame
local pickList: ScrollingFrame
local tradeView: Frame
local mineGrid: Frame
local theirsGrid: Frame
local theirsTitle: TextLabel
local myReadyMark: Frame
local theirReadyMark: Frame
local readyButton: Button.Button
local statusLabel: TextLabel
local warning: TextLabel
local invGrid: ScrollingFrame
local invTabs: { [string]: Button.Button } = {}
local invKind = "Ball"
local state: { [string]: any }? = nil
local countdownConn: RBXScriptConnection?

local remote = function(...: any)
	Remotes.Event("TradeRequest"):FireServer(...)
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function offeredCount(kind: string, id: string): number
	if state == nil then
		return 0
	end
	for _, item in state.Mine do
		if item.Kind == kind and item.Id == id then
			return item.Count
		end
	end
	return 0
end

local function renderPick()
	clear(pickList)
	local any = false
	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then
			any = true
			Button.new({ Parent = pickList, Size = UDim2.fromOffset(560, 56), Style = "Dark", Text = player.DisplayName, Font = Theme.Fonts.Body, TextSize = 28, OnClick = function()
				remote("Request", player.UserId)
			end })
		end
	end
	if not any then
		Create.Text({ Text = "No other players in this server yet.", Size = UDim2.fromOffset(560, 50), Font = Theme.Fonts.Body, TextSize = 28, Color = Theme.Colors.TextDim, Parent = pickList })
	end
end

local function renderOffer(grid: Frame, items: { { [string]: any } }, removable: boolean)
	clear(grid)
	for i, item in items do
		local card = ItemCard.new({
			Parent = grid,
			Kind = item.Kind,
			Id = item.Id,
			Size = UDim2.fromOffset(110, 110),
			Count = item.Count,
			LayoutOrder = i,
			OnClick = if removable then function()
				remote("SetItem", item.Kind, item.Id, item.Count - 1)
			end else nil,
		})
		if item.Count == 1 then
			card:SetCount(nil)
		end
	end
end

local function renderInventory()
	clear(invGrid)
	for kind, b in invTabs do
		b:SetStyle(if kind == invKind then "Orange" else "Dark")
	end
	local data = StateController.Data
	if data == nil then
		return
	end
	local bag = if invKind == "Ball" then data.Balls elseif invKind == "Explosion" then data.Explosions else data.Flyers
	local list = {}
	for id, count in bag do
		local tradable = true
		if invKind ~= "Ball" then
			local def = CosmeticDefinitions.Get(invKind, id)
			tradable = def ~= nil and def.Tradable
		else
			tradable = BallDefinitions.Get(id) ~= nil
		end
		local available = count - offeredCount(invKind, id)
		if tradable and available > 0 then
			local _, rarity = ItemCard.Info(invKind, id)
			table.insert(list, { Id = id, Count = available, Rarity = rarity })
		end
	end
	table.sort(list, function(a, b)
		return Rarity.Get(a.Rarity).Order > Rarity.Get(b.Rarity).Order
	end)
	for i, entry in list do
		ItemCard.new({
			Parent = invGrid,
			Kind = invKind,
			Id = entry.Id,
			Size = UDim2.fromOffset(110, 110),
			Count = entry.Count,
			LayoutOrder = i,
			OnClick = function()
				remote("SetItem", invKind, entry.Id, offeredCount(invKind, entry.Id) + 1)
			end,
		})
	end
end

local function renderTrade()
	local s = state
	if s == nil then
		return
	end
	theirsTitle.Text = s.Partner.Name .. "'s offer"
	renderOffer(mineGrid, s.Mine, s.Phase == "Offer")
	renderOffer(theirsGrid, s.Theirs, false)
	myReadyMark.Visible = s.MyReady
	theirReadyMark.Visible = s.TheirReady
	if s.Phase == "Confirming" then
		readyButton:SetText("Cancel")
		readyButton:SetStyle("Red")
	else
		readyButton:SetText(if s.MyReady then "Not Ready" else "Ready")
		readyButton:SetStyle(if s.MyReady then "Grey" else "Green")
	end
	if countdownConn then
		countdownConn:Disconnect()
		countdownConn = nil
	end
	if s.Phase == "Confirming" and s.ConfirmAt then
		countdownConn = RunService.Heartbeat:Connect(function()
			local left = math.max(0, (s.ConfirmAt :: number) - Workspace:GetServerTimeNow())
			statusLabel.Text = string.format("Both ready! Trading in %.1f...", left)
			statusLabel.TextColor3 = Color3.fromHex("#7CFF6B")
		end)
	else
		statusLabel.Text = if s.MyReady and not s.TheirReady then "Waiting for " .. s.Partner.Name .. " to ready up..." else "Add items, then press Ready."
		statusLabel.TextColor3 = Theme.Colors.TextDim
	end
	if s.Warning then
		warning.Text = "Warning: " .. s.Warning
		warning.Visible = true
	end
	renderInventory()
end

local function flashWarning(text: string)
	warning.Text = text
	warning.Visible = true
	warning.TextTransparency = 0
	local t = TweenService:Create(warning, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, 4, true), { TextTransparency = 0.6 })
	t:Play()
end

function TradeScreen.Init()
	panel = Panel.new({
		Parent = UIController.Layer("Menus"),
		Name = "Trade",
		Title = "Trade",
		Size = Vector2.new(1160, 800),
		OnClose = function()
			if state then
				remote("Cancel")
			end
			UIController.Close("Trade")
		end,
	})
	local content = panel.Content

	-- player picker
	pickView = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	Create.Text({ Text = "Choose a player to trade with", Size = UDim2.new(1, 0, 0, 40), Font = Theme.Fonts.Body, TextSize = 34, Stroke = 1.5, Parent = pickView })
	pickList = Create("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 1, -130), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, Parent = pickView })
	Create.List(pickList, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
	Create.Text({ Text = "Trades are checked by the server. Both players must press Ready, and any change resets it.", Size = UDim2.new(1, 0, 0, 56), Position = UDim2.new(0, 0, 1, -60), Font = Theme.Fonts.BodySemi, TextSize = 24, Wrapped = true, Color = Theme.Colors.TextDim, Parent = pickView })

	-- trade window
	tradeView = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	local function side(x: number, title: string): (Frame, TextLabel, Frame)
		local box: Frame = Create("Frame", { BackgroundColor3 = Theme.Colors.Card, Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(548, 300), Parent = tradeView })
		Create.Stroke(box, Theme.Colors.PanelBorder, 2, 0, true)
		local label = Create.Text({ Text = title, Size = UDim2.new(1, -80, 0, 36), Position = UDim2.fromOffset(14, 6), Font = Theme.Fonts.Display, TextSize = 26, Scaled = true, XAlign = Enum.TextXAlignment.Left, Stroke = 2, Parent = box })
		local mark = Icons.Check(UDim2.fromOffset(40, 40), box)
		mark.Position = UDim2.new(1, -52, 0, 4)
		local grid: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 50), Size = UDim2.new(1, -28, 1, -60), Parent = box })
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.fromOffset(110, 110)
		layout.CellPadding = UDim2.fromOffset(10, 10)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = grid
		return grid, label, mark
	end
	local _myTitle: TextLabel
	mineGrid, _myTitle, myReadyMark = side(0, "Your offer")
	theirsGrid, theirsTitle, theirReadyMark = side(568, "Their offer")

	warning = Create.Text({ Text = "", Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 306), Font = Theme.Fonts.Body, TextSize = 28, Color = Color3.fromHex("#FFB347"), Stroke = 1.5, Visible = false, Parent = tradeView })
	statusLabel = Create.Text({ Text = "", Size = UDim2.new(0.6, 0, 0, 30), Position = UDim2.fromOffset(0, 342), Font = Theme.Fonts.Body, TextSize = 26, XAlign = Enum.TextXAlignment.Left, Color = Theme.Colors.TextDim, Parent = tradeView })
	readyButton = Button.new({ Parent = tradeView, Size = UDim2.fromOffset(220, 58), Position = UDim2.new(1, 0, 0, 334), AnchorPoint = Vector2.new(1, 0), Style = "Green", Text = "Ready", TextSize = 32, OnClick = function()
		if state == nil then
			return
		end
		if state.Phase == "Confirming" then
			remote("Ready", false)
		else
			remote("Ready", not state.MyReady)
		end
	end })

	local tabs: Frame = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 400), Size = UDim2.new(1, 0, 0, 46), Parent = tradeView })
	Create.List(tabs, Enum.FillDirection.Horizontal, 10)
	for i, entry in { { "Ball", "Orbs" }, { "Explosion", "Explosions" }, { "Flyer", "Flyers" } } do
		invTabs[entry[1]] = Button.new({ Parent = tabs, Size = UDim2.fromOffset(170, 44), Style = "Dark", Text = entry[2], Font = Theme.Fonts.BodyHeavy, TextSize = 26, LayoutOrder = i, OnClick = function()
			invKind = entry[1]
			renderInventory()
		end })
	end
	Create.Text({ Text = "Click your items to offer them. Click an offered item to take it back.", Size = UDim2.fromOffset(560, 40), Position = UDim2.new(1, 0, 0, 402), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.BodySemi, TextSize = 22, Wrapped = true, XAlign = Enum.TextXAlignment.Right, Color = Theme.Colors.TextDim, Parent = tradeView })
	invGrid = Create("ScrollingFrame", { BackgroundColor3 = Theme.Colors.Card, BackgroundTransparency = 0.3, Position = UDim2.fromOffset(0, 456), Size = UDim2.new(1, 0, 1, -456), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, Parent = tradeView })
	Create.Padding(invGrid, 10)
	local invLayout = Instance.new("UIGridLayout")
	invLayout.CellSize = UDim2.fromOffset(110, 110)
	invLayout.CellPadding = UDim2.fromOffset(10, 10)
	invLayout.SortOrder = Enum.SortOrder.LayoutOrder
	invLayout.Parent = invGrid

	Remotes.Event("TradeState").OnClientEvent:Connect(function(payload)
		if payload.Type == "State" then
			state = payload
			pickView.Visible = false
			tradeView.Visible = true
			if not panel.Visible then
				UIController.Open("Trade")
			end
			renderTrade()
		elseif payload.Type == "Changed" then
			flashWarning("Careful! The other player changed their offer. Check it again.")
		elseif payload.Type == "Closed" then
			state = nil
			if countdownConn then
				countdownConn:Disconnect()
				countdownConn = nil
			end
			if payload.Reason ~= "Completed" then
				UIController.Toast("Trade " .. string.lower(payload.Reason or "closed") .. ".", "Info")
			end
			UIController.Close("Trade")
		end
	end)
	StateController.DataChanged:Connect(function()
		if state and panel.Visible then
			renderInventory()
		end
	end)

	UIController.Register("Trade", {
		Open = function()
			if state then
				pickView.Visible = false
				tradeView.Visible = true
				renderTrade()
			else
				warning.Visible = false
				pickView.Visible = true
				tradeView.Visible = false
				renderPick()
			end
			panel:Open()
		end,
		Close = function()
			panel:Close()
		end,
		IsOpen = function()
			return panel.Visible
		end,
	})
end

return TradeScreen
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Design tokens reverse-engineered from the reference screenshots (see docs/RESEARCH.md §C).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rarity = require(ReplicatedStorage:WaitForChild("Shared").Config.Rarity)

local Theme = {}

local hex = Color3.fromHex

Theme.Colors = {
	Panel = hex("#151B2C"),
	PanelDeep = hex("#0E1220"),
	PanelBorder = hex("#3A6FD6"),
	ModalBorder = hex("#3366CC"),
	Card = hex("#1B2236"),
	CardInner = hex("#222B44"),
	SubBar = hex("#1A2134"),
	Tile = hex("#0E1220"),
	TileBorder = hex("#3D7BE0"),
	Text = hex("#FFFFFF"),
	TextDim = hex("#AEB6C8"),
	TextMuted = hex("#7D869C"),
	Stroke = hex("#0A0C14"),
	Gold = hex("#FFC72C"),
	GoldDark = hex("#B86E00"),
	GemText = hex("#D8ECFF"),
	Heart = hex("#EF2B3C"),
	HeartEmpty = hex("#3A3F52"),
	TeamRed = hex("#FF2B2B"),
	TeamBlue = hex("#19B6FF"),
	Success = hex("#4CD420"),
	Danger = hex("#FF3D4F"),
	LevelTrack = hex("#2B2B2B"),
	LevelFill = hex("#A9ADB5"),
}

Theme.Fonts = {
	Display = Font.new("rbxasset://fonts/families/Michroma.json", Enum.FontWeight.Regular),
	Body = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Bold),
	BodyHeavy = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Heavy),
	BodySemi = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.SemiBold),
}

export type ButtonStyle = { Top: Color3, Bottom: Color3, Border: Color3, Text: Color3 }

Theme.Buttons = {
	Green = { Top = hex("#7BE52A"), Bottom = hex("#3A9A06"), Border = hex("#1F4D05"), Text = hex("#FFFFFF") },
	Blue = { Top = hex("#4F8BFF"), Bottom = hex("#2457E0"), Border = hex("#13307A"), Text = hex("#FFFFFF") },
	Grey = { Top = hex("#E6E9EE"), Bottom = hex("#9CA2AB"), Border = hex("#3A3F4A"), Text = hex("#FFFFFF") },
	Red = { Top = hex("#FF6170"), Bottom = hex("#D21E33"), Border = hex("#6B0A15"), Text = hex("#FFFFFF") },
	Purple = { Top = hex("#C27BFF"), Bottom = hex("#7A2BD6"), Border = hex("#3A0F70"), Text = hex("#FFFFFF") },
	Orange = { Top = hex("#FFC14D"), Bottom = hex("#F08C00"), Border = hex("#7A4300"), Text = hex("#FFFFFF") },
	Pink = { Top = hex("#FF7A9C"), Bottom = hex("#E83563"), Border = hex("#7A1031"), Text = hex("#FFFFFF") },
	Dark = { Top = hex("#2A3350"), Bottom = hex("#161C2E"), Border = hex("#3A6FD6"), Text = hex("#FFFFFF") },
	Disabled = { Top = hex("#6B707A"), Bottom = hex("#474B53"), Border = hex("#24262B"), Text = hex("#C7CAD1") },
} :: { [string]: ButtonStyle }

-- Store tab colours (screenshot 1)
Theme.Tabs = {
	Events = { Top = hex("#5AA6FF"), Bottom = hex("#2F78E0") },
	Balls = { Top = hex("#FFB627"), Bottom = hex("#E08A00") },
	Explosions = { Top = hex("#B967FF"), Bottom = hex("#8A33E0") },
	Flyers = { Top = hex("#FF6B8E"), Bottom = hex("#E83563") },
}

function Theme.Rarity(id: string): Color3
	return hex(Rarity.Get(id).Color)
end

function Theme.RarityDark(id: string): Color3
	return hex(Rarity.Get(id).Dark)
end

function Theme.RarityLight(id: string): Color3
	return hex(Rarity.Get(id).Light)
end

-- Base design resolution (the reference HUD screenshot is 1795 x 914).
Theme.DesignSize = Vector2.new(1800, 920)

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="131">
          <Properties>
            <string name="Name">VFX</string>
          </Properties>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">CosmeticModels</string>
              <string name="Source"><![CDATA[--!strict
-- Part-built models for Flyer cosmetics (used by the finisher VFX and UI previews).
-- Each model is centred on its pivot and faces local -Z (its LookVector = direction of flight).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PropFactory = require(Shared.Visual.PropFactory)
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)

local P = PropFactory.Part

local CosmeticModels = {}

local function noCollide(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		end
	end
end

local builders: { [string]: (m: Model, c: { string }) -> () } = {
	Toss = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(), Color = c[1], Material = Enum.Material.Neon, Transparency = 0.4 })
	end,
	PaperPlane = function(m, c)
		P(m, { Name = "Core", Class = "WedgePart", Size = Vector3.new(0.1, 0.8, 3.2), CFrame = CFrame.new(-0.6, 0, 0) * CFrame.Angles(0, 0, math.rad(-80)), Color = c[1] })
		P(m, { Name = "WingR", Class = "WedgePart", Size = Vector3.new(0.1, 0.8, 3.2), CFrame = CFrame.new(0.6, 0, 0) * CFrame.Angles(0, 0, math.rad(80)), Color = c[1] })
		P(m, { Name = "Keel", Class = "WedgePart", Size = Vector3.new(0.1, 0.6, 3.2), CFrame = CFrame.new(0, -0.35, 0), Color = c[2] })
	end,
	Kite = function(m, c)
		P(m, { Name = "Core", Size = Vector3.new(2.2, 2.2, 0.1), CFrame = CFrame.Angles(math.rad(-70), 0, math.rad(45)), Color = c[1] })
		P(m, { Name = "Cross", Size = Vector3.new(3, 0.12, 0.12), CFrame = CFrame.Angles(math.rad(-70), 0, 0), Color = c[2] })
		for i = 1, 4 do
			P(m, { Name = "Tail", Size = Vector3.new(0.5, 0.1, 0.5), CFrame = CFrame.new(0, -0.3 - i * 0.2, 1.4 + i * 0.7) * CFrame.Angles(0, math.rad(i * 25), 0), Color = c[(i % 3) + 1] })
		end
	end,
	Balloon = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.8, 2.4), CFrame = CFrame.new(0, 2.2, 0), Color = c[1], Reflectance = 0.1 })
		P(m, { Name = "Knot", Size = Vector3.new(0.3, 0.3, 0.3), CFrame = CFrame.new(0, 0.75, 0), Color = c[1] })
		P(m, { Name = "String", Size = Vector3.new(0.05, 1.2, 0.05), CFrame = CFrame.new(0, 0.1, 0), Color = c[2] })
	end,
	Rocket = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 1.1, 1.1), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = c[1], Material = Enum.Material.Metal })
		P(m, { Name = "Nose", Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), CFrame = CFrame.new(0, 0, -1.5), Color = c[2] })
		for k = 0, 2 do
			P(m, { Name = "Fin", Class = "WedgePart", Size = Vector3.new(0.12, 0.8, 0.9), CFrame = CFrame.Angles(0, 0, math.rad(k * 120)) * CFrame.new(0, 0.75, 1.1), Color = c[2] })
		end
		P(m, { Name = "Flame", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 1.4), CFrame = CFrame.new(0, 0, 1.9), Color = c[3], Material = Enum.Material.Neon })
	end,
	Comet = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(), Color = c[2], Material = Enum.Material.Neon })
		for i = 1, 4 do
			local s = 1.3 - i * 0.22
			P(m, { Name = "Tail", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(0, 0, i * 0.7), Color = c[if i % 2 == 0 then 1 else 3], Material = Enum.Material.Neon, Transparency = 0.15 * i })
		end
	end,
	Saucer = function(m, _c)
		PropFactory.SaucerInto(m, CFrame.new(0, 0.6, 0), 0.42)
		local core = m:FindFirstChild("Hull") :: BasePart
		core.Name = "Core"
	end,
	Dragonfly = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.8, 0.5, 0.5), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = c[1] })
		P(m, { Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), CFrame = CFrame.new(0, 0, -1.5), Color = c[2] })
		for side = -1, 1, 2 do
			for k = 0, 1 do
				P(m, { Name = "Wing", Size = Vector3.new(2, 0.05, 0.6), CFrame = CFrame.new(side * 1.1, 0.2, -0.4 + k * 0.7) * CFrame.Angles(0, math.rad(side * (10 - k * 20)), 0), Color = c[3], Material = Enum.Material.Glass, Transparency = 0.4 })
			end
		end
	end,
	Cruiser = function(m, c)
		P(m, { Name = "Core", Class = "WedgePart", Size = Vector3.new(2, 0.6, 3.6), CFrame = CFrame.Angles(0, math.rad(180), 0), Color = c[1], Material = Enum.Material.Metal })
		P(m, { Name = "Cockpit", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.5, 1.2), CFrame = CFrame.new(0, 0.35, -0.2), Color = c[2], Material = Enum.Material.Glass, Transparency = 0.2 })
		for side = -1, 1, 2 do
			P(m, { Name = "Engine", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 0.45, 0.45), CFrame = CFrame.new(side * 1.05, -0.1, 1.2) * CFrame.Angles(0, math.rad(90), 0), Color = c[1], Material = Enum.Material.Metal })
			P(m, { Name = "Glow", Shape = Enum.PartType.Ball, Size = Vector3.new(0.4, 0.4, 0.4), CFrame = CFrame.new(side * 1.05, -0.1, 1.95), Color = c[3], Material = Enum.Material.Neon })
		end
	end,
	CyberEye = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(), Color = c[1], Material = Enum.Material.Metal })
		P(m, { Name = "Iris", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1.1, 1.1), CFrame = CFrame.new(0, 0, -0.93) * CFrame.Angles(0, math.rad(90), 0), Color = c[2], Material = Enum.Material.Neon })
		P(m, { Name = "Pupil", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.22, 0.45, 0.45), CFrame = CFrame.new(0, 0, -1.0) * CFrame.Angles(0, math.rad(90), 0), Color = c[3] })
		P(m, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2.4, 2.4), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = c[3], Material = Enum.Material.Metal })
	end,
	Broom = function(m, c)
		P(m, { Name = "Core", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.6, 0.22, 0.22), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = c[1] })
		P(m, { Name = "Bristles", Class = "WedgePart", Size = Vector3.new(1.0, 0.9, 1.4), CFrame = CFrame.new(0, 0, 2.2), Color = c[2] })
		P(m, { Name = "Spark", Shape = Enum.PartType.Ball, Size = Vector3.new(0.4, 0.4, 0.4), CFrame = CFrame.new(0, 0.2, 3), Color = c[3], Material = Enum.Material.Neon })
	end,
}

function CosmeticModels.Flyer(id: string): Model
	local def = CosmeticDefinitions.Get("Flyer", id)
	local style = if def then def.Style else "Toss"
	local colors = if def then def.Colors else { "#FFFFFF", "#BFD9FF", "#FFFFFF" }
	while #colors < 3 do
		table.insert(colors, colors[#colors])
	end
	local m = PropFactory.Model("Flyer_" .. id)
	local builder = builders[style] or builders.Toss
	builder(m, colors)
	local core = m:FindFirstChild("Core") :: BasePart?
	if core then
		m.PrimaryPart = core
	end
	noCollide(m)
	return m
end

return CosmeticModels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Reusable, pooled visual effects (client-only). Everything is cosmetic: the server never waits
-- on these. Particle textures use Roblox built-in content, so no uploaded assets are needed.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Effects = {}

local folder: Folder
local emitterPool: { BasePart } = {}
local rng = Random.new()

local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local function ensureFolder(): Folder
	if not folder or folder.Parent == nil then
		local f = Instance.new("Folder")
		f.Name = "ClientVFX"
		f.Parent = Workspace
		folder = f
	end
	return folder
end

local function basicPart(shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end
Effects.Part = basicPart

local function emitter(): BasePart
	local p = table.remove(emitterPool)
	if p then
		return p
	end
	local part = basicPart()
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	local pe = Instance.new("ParticleEmitter")
	pe.Enabled = false
	pe.Texture = SPARK_TEXTURE
	pe.LightEmission = 0.8
	pe.LightInfluence = 0
	pe.Drag = 4
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = part
	part.Parent = ensureFolder()
	return part
end

-- Burst of sparks.
function Effects.Sparks(pos: Vector3, color: Color3, count: number, speed: number?, size: number?, texture: string?)
	local part = emitter()
	part.Position = pos
	local pe = part:FindFirstChildOfClass("ParticleEmitter") :: ParticleEmitter
	pe.Texture = texture or SPARK_TEXTURE
	pe.Color = ColorSequence.new(color)
	local s = size or 0.6
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	pe.Speed = NumberRange.new((speed or 14) * 0.5, speed or 14)
	pe.Lifetime = NumberRange.new(0.25, 0.5)
	pe:Emit(count)
	task.delay(0.8, function()
		table.insert(emitterPool, part)
	end)
end

function Effects.Smoke(pos: Vector3, color: Color3, count: number)
	Effects.Sparks(pos, color, count, 4, 1.4, SMOKE_TEXTURE)
end

-- Neon ball that expands and fades (impact flash).
function Effects.Flash(pos: Vector3, diameter: number, color: Color3, duration: number?)
	local p = basicPart(Enum.PartType.Ball)
	p.Color = color
	p.Size = Vector3.one * diameter * 0.3
	p.Position = pos
	p.Transparency = 0.15
	p.Parent = ensureFolder()
	local d = duration or 0.25
	TweenService:Create(p, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * diameter, Transparency = 1 }):Play()
	Debris:AddItem(p, d + 0.05)
end

-- Expanding flat ring facing `normal`.
function Effects.Ring(pos: Vector3, normal: Vector3, radius: number, color: Color3, duration: number?, thickness: number?)
	local p = basicPart(Enum.PartType.Cylinder)
	p.Color = color
	p.Transparency = 0.2
	local cf = CFrame.lookAt(pos, pos + normal) * CFrame.Angles(0, math.rad(90), 0)
	p.CFrame = cf
	p.Size = Vector3.new(thickness or 0.15, radius * 0.4, radius * 0.4)
	p.Parent = ensureFolder()
	local d = duration or 0.35
	TweenService:Create(p, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(thickness or 0.15, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(p, d + 0.05)
end

-- Small parts flung outward that fall and fade.
function Effects.Debris(pos: Vector3, colors: { Color3 }, count: number, size: number, speed: number, life: number, planeRight: Vector3?, planeUp: Vector3?, shape: Enum.PartType?)
	local right = planeRight or Vector3.xAxis
	local up = planeUp or Vector3.yAxis
	for i = 1, count do
		local p = basicPart(shape)
		p.Material = Enum.Material.SmoothPlastic
		p.Color = colors[(i - 1) % #colors + 1]
		p.Size = Vector3.one * size * rng:NextNumber(0.6, 1.2)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6))
		p.Parent = ensureFolder()
		local a = rng:NextNumber(0, 2 * math.pi)
		local v = speed * rng:NextNumber(0.5, 1)
		local dir = right * math.cos(a) + up * math.sin(a)
		local mid = pos + dir * v * life * 0.5 + up * v * 0.12
		local finish = pos + dir * v * life - up * 4
		TweenService:Create(p, TweenInfo.new(life * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = mid }):Play()
		task.delay(life * 0.5, function()
			TweenService:Create(p, TweenInfo.new(life * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = finish, Transparency = 1 }):Play()
		end)
		Debris:AddItem(p, life + 0.1)
	end
end

-- Jagged lightning between two points.
function Effects.Lightning(a: Vector3, b: Vector3, color: Color3, duration: number?)
	local segments = 7
	local dir = b - a
	local len = dir.Magnitude
	if len < 0.01 then
		return
	end
	local side = dir:Cross(Vector3.zAxis)
	if side.Magnitude < 0.01 then
		side = Vector3.xAxis
	end
	side = side.Unit
	local prev = a
	for i = 1, segments do
		local t = i / segments
		local point = a + dir * t
		if i < segments then
			point += side * rng:NextNumber(-1, 1) * len * 0.08
		end
		local seg = basicPart()
		seg.Color = color
		seg.Size = Vector3.new(0.22, 0.22, (point - prev).Magnitude)
		seg.CFrame = CFrame.lookAt((prev + point) / 2, point)
		seg.Parent = ensureFolder()
		TweenService:Create(seg, TweenInfo.new(duration or 0.25), { Transparency = 1 }):Play()
		Debris:AddItem(seg, (duration or 0.25) + 0.05)
		prev = point
	end
	Effects.Flash(b, 2.2, color, 0.2)
end

-- Beam connecting two parts for a while (leech tether etc.).
function Effects.Tether(a: BasePart, b: BasePart, color: Color3, duration: number)
	local a0 = Instance.new("Attachment")
	a0.Parent = a
	local a1 = Instance.new("Attachment")
	a1.Parent = b
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = 0.5
	beam.Width1 = 0.25
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Segments = 6
	beam.CurveSize0 = 1
	beam.Parent = a
	task.delay(duration, function()
		beam:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)
end

-- Floating text (damage numbers, dice rolls). Pooled BillboardGuis.
local popupPool: { BillboardGui } = {}
local popupAnchor: Part

function Effects.Popup(pos: Vector3, text: string, color: Color3, scale: number?)
	ensureFolder()
	if not popupAnchor then
		local anchor = basicPart()
		anchor.Transparency = 1
		anchor.Size = Vector3.one * 0.1
		anchor.Position = Vector3.zero
		anchor.Parent = folder
		popupAnchor = anchor
	end
	local gui = table.remove(popupPool)
	if gui == nil then
		local g = Instance.new("BillboardGui")
		g.Size = UDim2.new(3, 0, 1.4, 0)
		g.AlwaysOnTop = true
		g.LightInfluence = 0
		g.MaxDistance = 120
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.TextScaled = true
		label.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Heavy)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = label
		label.Parent = g
		gui = g
	end
	local g = gui :: BillboardGui
	local s = scale or 1
	g.Size = UDim2.new(3 * s, 0, 1.4 * s, 0)
	g.Adornee = popupAnchor
	g.StudsOffsetWorldSpace = pos
	local label = g:FindFirstChild("Text") :: TextLabel
	label.Text = text
	label.TextColor3 = color
	label.TextTransparency = 0
	local stroke = label:FindFirstChildOfClass("UIStroke") :: UIStroke
	stroke.Transparency = 0
	g.Parent = folder
	TweenService:Create(g, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = pos + Vector3.new(0, 1.6, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.35), { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.35), { Transparency = 1 }):Play()
	task.delay(0.75, function()
		g.Parent = nil
		table.insert(popupPool, g)
	end)
end

function Effects.Folder(): Folder
	return ensureFolder()
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">EntityVisuals</string>
              <string name="Source"><![CDATA[--!strict
-- Client visuals for battle entities (hazards, projectiles, beams, trains...). The server sends
-- an EntitySpawn event with geometry + a `visual` table; dynamic entities are then moved by
-- snapshots. Each visual is plain parts in the arena plane (station local space).
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ArenaGeometry = require(Shared.Visual.ArenaGeometry)

local Effects = require(script.Parent.Effects)

export type Visual = {
	Model: Model,
	Update: (x: number, y: number, rot: number, scale: number) -> (),
	Arm: (() -> ())?,
	Destroy: () -> (),
}

local EntityVisuals = {}

local hex = Color3.fromHex

local function color(v: any, fallback: string): Color3
	if type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, v)
		if ok then
			return c
		end
	end
	return hex(fallback)
end

local function part(model: Model, shape: Enum.PartType?, size: Vector3, c: Color3, material: Enum.Material?, transparency: number?): Part
	local p = Effects.Part(shape)
	p.Size = size
	p.Color = c
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Parent = model
	return p
end

-- Places a set of parts (given in entity-local 2D space) into the world every update.
type Piece = { Part: BasePart, Offset: CFrame }

local function make(station: CFrame, kind: string, pieces: { Piece }, model: Model, zOffset: number): Visual
	local k = ArenaGeometry.Get(kind)
	local self = {} :: any
	self.Model = model
	function self.Update(x: number, y: number, rot: number, scale: number)
		local base = station * CFrame.new(x, y, k.PlaneZ + zOffset) * CFrame.Angles(0, 0, rot)
		for _, piece in pieces do
			local off = piece.Offset
			if scale ~= 1 then
				off = CFrame.new(off.Position * scale) * off.Rotation
			end
			piece.Part.CFrame = base * off
		end
	end
	function self.Destroy()
		model:Destroy()
	end
	return self :: Visual
end

local builders: { [string]: (station: CFrame, kind: string, e: { [string]: any }, model: Model) -> Visual } = {}

-- Flat isosceles triangle from two wedges: base centred at the origin, tip at +X (length).
local function triangle(model: Model, length: number, width: number, c: Color3, thickness: number?): { Piece }
	local pieces: { Piece } = {}
	for side = -1, 1, 2 do
		local wedge = Instance.new("WedgePart")
		wedge.Anchored = true
		wedge.CanCollide = false
		wedge.CanQuery = false
		wedge.CanTouch = false
		wedge.CastShadow = false
		wedge.Size = Vector3.new(thickness or 0.6, width / 2, length)
		wedge.Color = if side > 0 then c:Lerp(Color3.new(1, 1, 1), 0.18) else c
		wedge.Material = Enum.Material.SmoothPlastic
		wedge.Parent = model
		local offset = if side > 0
			then CFrame.new(length / 2, width / 4, 0) * CFrame.Angles(0, -math.pi / 2, 0)
			else CFrame.new(length / 2, -width / 4, 0) * CFrame.Angles(math.pi, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0)
		table.insert(pieces, { Part = wedge :: BasePart, Offset = offset })
	end
	return pieces
end

builders.thorn = function(station, kind, e, model)
	local v = e.visual or {}
	local len, width = v.length or 2.2, v.width or 1.5
	local c = color(v.color, "#C9CCD3"):Lerp(Color3.new(), 0.25)
	local vis = make(station, kind, triangle(model, len, width, c), model, 0)
	vis.Update(e.x, e.y, e.rot or 0, 1)
	return vis
end

builders.goo = function(station, kind, e, model)
	local v = e.visual or {}
	local r = e.r or 1.5
	local disc = part(model, Enum.PartType.Cylinder, Vector3.new(0.3, r * 2, r * 2), color(v.color, "#6EDB3A"), Enum.Material.Neon, 0.35)
	local inner = part(model, Enum.PartType.Cylinder, Vector3.new(0.32, r * 1.3, r * 1.3), color(v.accent, "#2C7A12"), Enum.Material.SmoothPlastic, 0.25)
	local face = CFrame.Angles(0, math.rad(90), 0)
	local gooPieces: { Piece } = { { Part = disc, Offset = face }, { Part = inner, Offset = face } }
	local vis = make(station, kind, gooPieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	disc.Size = Vector3.new(0.3, 0.2, 0.2)
	TweenService:Create(disc, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Size = Vector3.new(0.3, r * 2, r * 2) }):Play()
	return vis
end

builders.fire = function(station, kind, e, model)
	local r = e.r or 1.5
	local disc = part(model, Enum.PartType.Cylinder, Vector3.new(0.3, r * 2, r * 2), hex("#FF8C1A"), Enum.Material.Neon, 0.45)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/fire_main.dds"
	pe.Color = ColorSequence.new(hex("#FFB347"), hex("#FF3B1A"))
	pe.Size = NumberSequence.new(0.8, 0)
	pe.Rate = 25
	pe.Lifetime = NumberRange.new(0.3, 0.6)
	pe.Speed = NumberRange.new(2, 4)
	pe.LightEmission = 0.8
	pe.Parent = disc
	local firePieces: { Piece } = { { Part = disc, Offset = CFrame.Angles(0, math.rad(90), 0) } }
	local vis = make(station, kind, firePieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	return vis
end

builders.mine = function(station, kind, e, model)
	local v = e.visual or {}
	local body = part(model, Enum.PartType.Ball, Vector3.one * 1.1, color(v.color, "#4A4F59"), Enum.Material.Metal)
	local light = part(model, Enum.PartType.Ball, Vector3.one * 0.45, color(v.light, "#FF3B3B"), Enum.Material.Neon)
	local spikes = {}
	for k = 0, 3 do
		local s = part(model, nil, Vector3.new(0.2, 1.6, 0.2), hex("#2A2D35"))
		table.insert(spikes, { Part = s :: BasePart, Offset = CFrame.Angles(0, 0, math.rad(k * 45)) })
	end
	local pieces: { Piece } = { { Part = body, Offset = CFrame.new() }, { Part = light, Offset = CFrame.new(0, 0, 0.45) } }
	for _, s in spikes do
		table.insert(pieces, s)
	end
	local vis = make(station, kind, pieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	light.Transparency = 0.7
	vis.Arm = function()
		TweenService:Create(light, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0 }):Play()
	end
	return vis
end

builders.beam = function(station, kind, e, model)
	local v = e.visual or {}
	local k = ArenaGeometry.Get(kind)
	local a = Vector3.new(e.x, e.y, 0)
	local b = Vector3.new(e.x2, e.y2, 0)
	local len = (b - a).Magnitude
	local c = color(v.color, "#7A5CFF")
	local core = part(model, nil, Vector3.new(len, 0.12, 0.12), Color3.new(1, 1, 1), Enum.Material.Neon, 0.6)
	local glow = part(model, nil, Vector3.new(len, (e.r or 0.3) * 2, 0.3), c, Enum.Material.Neon, 0.85)
	local mid = (a + b) / 2
	local angle = math.atan2(b.Y - a.Y, b.X - a.X)
	local cf = station * CFrame.new(mid.X, mid.Y, k.PlaneZ) * CFrame.Angles(0, 0, angle)
	core.CFrame = cf
	glow.CFrame = cf
	local self = {} :: any
	self.Model = model
	self.Update = function() end
	self.Arm = function()
		core.Transparency = 0
		glow.Transparency = 0.25
		Effects.Flash(station:PointToWorldSpace(Vector3.new(e.x, e.y, k.PlaneZ)), 2, c, 0.2)
	end
	self.Destroy = function()
		TweenService:Create(glow, TweenInfo.new(0.15), { Transparency = 1 }):Play()
		TweenService:Create(core, TweenInfo.new(0.15), { Transparency = 1 }):Play()
		task.delay(0.16, function()
			model:Destroy()
		end)
	end
	return self :: Visual
end

builders.rail = function(station, kind, e, model)
	local v = e.visual or {}
	local k = ArenaGeometry.Get(kind)
	local horizontal = math.abs(e.y2 - e.y) < 0.01
	local len = if horizontal then math.abs(e.x2 - e.x) else math.abs(e.y2 - e.y)
	local line = if horizontal then e.y else e.x
	local rot = if horizontal then 0 else math.pi / 2
	local base = station * CFrame.new(if horizontal then 0 else line, if horizontal then line else 0, k.PlaneZ - 0.3) * CFrame.Angles(0, 0, rot)
	local warn = color(v.color, "#FFCC00")
	local rails = {}
	for side = -1, 1, 2 do
		local r = part(model, nil, Vector3.new(len, 0.12, 0.2), warn, Enum.Material.Neon, 0.2)
		r.CFrame = base * CFrame.new(0, side * 0.55, 0)
		table.insert(rails, r)
	end
	local ties = {}
	local count = math.floor(len / 1.4)
	for i = 0, count do
		local t = part(model, nil, Vector3.new(0.28, 1.5, 0.15), hex("#5A3A1C"), Enum.Material.Wood, 0.5)
		t.CFrame = base * CFrame.new(-len / 2 + i * (len / count), 0, -0.05)
		table.insert(ties, t)
	end
	for _, r in rails do
		TweenService:Create(r, TweenInfo.new(0.15, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.8 }):Play()
	end
	local self = {} :: any
	self.Model = model
	self.Update = function() end
	self.Destroy = function()
		model:Destroy()
	end
	return self :: Visual
end

builders.train = function(station, kind, e, model)
	local v = e.visual or {}
	local len, width = v.length or 4.5, v.width or 1.6
	local bodyColor = color(v.color, "#3C3F46")
	local accent = color(v.accent, "#FFCC00")
	local body = part(model, nil, Vector3.new(len * 0.8, width, 1.2), bodyColor, Enum.Material.Metal)
	local stripe = part(model, nil, Vector3.new(len * 0.8, width * 0.25, 1.25), accent, Enum.Material.Neon)
	local windows = part(model, nil, Vector3.new(len * 0.5, width * 0.3, 1.3), hex("#BDF3FF"), Enum.Material.Neon)
	local pieces: { Piece } = {
		{ Part = body, Offset = CFrame.new(-len * 0.1, 0, 0) },
		{ Part = stripe, Offset = CFrame.new(-len * 0.1, -width * 0.25, 0) },
		{ Part = windows, Offset = CFrame.new(-len * 0.12, width * 0.18, 0) },
	}
	for _, piece in triangle(model, len * 0.2, width, accent, 1.2) do
		table.insert(pieces, { Part = piece.Part :: BasePart, Offset = CFrame.new(len * 0.3, 0, 0) * piece.Offset })
	end
	local vis = make(station, kind, pieces, model, 0)
	vis.Update(e.x, e.y, e.rot or 0, 1)
	return vis
end

builders.shackle = function(station, kind, e, model)
	local v = e.visual or {}
	local r = e.r or 1.2
	local c = color(v.color, "#C9CCD3")
	local pieces: { Piece } = {}
	for k = 0, 7 do
		local a = k * math.pi / 4
		local link = part(model, nil, Vector3.new(0.5, 0.25, 0.3), c, Enum.Material.Metal)
		table.insert(pieces, { Part = link :: BasePart, Offset = CFrame.new(math.cos(a) * r, math.sin(a) * r, 0) * CFrame.Angles(0, 0, a + math.pi / 2) })
	end
	local core = part(model, Enum.PartType.Ball, Vector3.one * 0.6, color(v.rim, "#E04040"), Enum.Material.Neon, 0.7)
	table.insert(pieces, { Part = core :: BasePart, Offset = CFrame.new() })
	local vis = make(station, kind, pieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	vis.Arm = function()
		core.Transparency = 0
		TweenService:Create(core, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = Vector3.one * 0.9 }):Play()
	end
	return vis
end

builders.aura = function(station, kind, e, model)
	local v = e.visual or {}
	local r = e.r or 2.5
	local disc = part(model, Enum.PartType.Cylinder, Vector3.new(0.2, r * 2, r * 2), color(v.color, "#9D4DFF"), Enum.Material.Neon, 0.82)
	local rim = part(model, Enum.PartType.Cylinder, Vector3.new(0.18, r * 2.04, r * 2.04), color(v.rim, "#D9B3FF"), Enum.Material.Neon, 0.6)
	local k = ArenaGeometry.Get(kind)
	local self = {} :: any
	self.Model = model
	self.Update = function(x: number, y: number, _rot: number, scale: number)
		local cf = station * CFrame.new(x, y, k.PlaneZ - 0.6) * CFrame.Angles(0, math.rad(90), 0)
		disc.CFrame = cf
		rim.CFrame = cf * CFrame.new(-0.02, 0, 0)
		disc.Size = Vector3.new(0.2, r * 2 * scale, r * 2 * scale)
		rim.Size = Vector3.new(0.18, r * 2.06 * scale, r * 2.06 * scale)
	end
	self.Destroy = function()
		model:Destroy()
	end
	self.Update(e.x, e.y, 0, e.scale or 1)
	return self :: Visual
end

local function simpleBall(diameter: number, c: Color3, material: Enum.Material?): (station: CFrame, kind: string, e: { [string]: any }, model: Model) -> Visual
	return function(station, kind, e, model)
		local b = part(model, Enum.PartType.Ball, Vector3.one * diameter, c, material)
		local single: { Piece } = { { Part = b, Offset = CFrame.new() } }
		local vis = make(station, kind, single, model, 0)
		vis.Update(e.x, e.y, 0, 1)
		return vis
	end
end

builders.cannonball = function(station, kind, e, model)
	local b = part(model, Enum.PartType.Ball, Vector3.one * (e.r or 0.55) * 2, hex("#1C1E22"), Enum.Material.Metal)
	local glint = part(model, Enum.PartType.Ball, Vector3.one * 0.3, Color3.new(1, 1, 1), Enum.Material.Neon, 0.3)
	local trail = Instance.new("Trail")
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 0)
	a0.Parent = b
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 0)
	a1.Parent = b
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.18
	trail.Color = ColorSequence.new(hex("#9CA2AB"))
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.Parent = b
	local cannonPieces: { Piece } = { { Part = b, Offset = CFrame.new() }, { Part = glint, Offset = CFrame.new(-0.15, 0.15, 0.4) } }
	local vis = make(station, kind, cannonPieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	return vis
end

builders.moon = function(station, kind, e, model)
	local v = e.visual or {}
	return simpleBall((e.r or 0.45) * 2, color(v.color, "#C9D0FF"), Enum.Material.SmoothPlastic)(station, kind, e, model)
end

builders.pumpkin = function(station, kind, e, model)
	local b = part(model, Enum.PartType.Ball, Vector3.new(1.3, 1.1, 1.2), hex("#FF8C1A"))
	local stem = part(model, nil, Vector3.new(0.2, 0.4, 0.2), hex("#3E8E1E"))
	local face = part(model, nil, Vector3.new(0.6, 0.15, 0.1), hex("#2B1400"))
	local pumpkinPieces: { Piece } = { { Part = b, Offset = CFrame.new() }, { Part = stem, Offset = CFrame.new(0, 0.6, 0) }, { Part = face, Offset = CFrame.new(0, -0.15, 0.6) } }
	local vis = make(station, kind, pumpkinPieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	return vis
end

builders.boomerang = function(station, kind, e, model)
	local v = e.visual or {}
	local c = color(v.color, "#0E6E62")
	local armA = part(model, nil, Vector3.new(1.4, 0.35, 0.3), c)
	local armB = part(model, nil, Vector3.new(1.4, 0.35, 0.3), c)
	local boomerangPieces: { Piece } = {
		{ Part = armA, Offset = CFrame.Angles(0, 0, math.rad(35)) * CFrame.new(0.55, 0, 0) },
		{ Part = armB, Offset = CFrame.Angles(0, 0, math.rad(-35)) * CFrame.new(0.55, 0, 0) },
	}
	local vis = make(station, kind, boomerangPieces, model, 0)
	vis.Update(e.x, e.y, 0, 1)
	return vis
end

local function shardBuilder(defaultColor: string, size: number)
	return function(station: CFrame, kind: string, e: { [string]: any }, model: Model): Visual
		local v = e.visual or {}
		local s = part(model, nil, Vector3.new(size * 1.6, size, 0.25), color(v.color, defaultColor), Enum.Material.Glass, 0.15)
		local shardPieces: { Piece } = { { Part = s, Offset = CFrame.Angles(0, 0, math.rad(45)) } }
		local vis = make(station, kind, shardPieces, model, 0)
		vis.Update(e.x, e.y, e.rot or 0, 1)
		return vis
	end
end
builders.shard = shardBuilder("#7FE9FF", 0.5)
builders.chip = shardBuilder("#FFD23F", 0.45)

function EntityVisuals.Create(station: CFrame, kind: string, e: { [string]: any }, parent: Instance): Visual?
	local builder = builders[e.kind]
	if builder == nil then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = e.kind .. "_" .. tostring(e.id)
	local ok, vis = pcall(builder, station, kind, e, model)
	if not ok then
		warn("[EntityVisuals] " .. tostring(e.kind) .. ": " .. tostring(vis))
		model:Destroy()
		return nil
	end
	model.Parent = parent
	return vis
end

return EntityVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">Explosions</string>
              <string name="Source"><![CDATA[--!strict
-- Death explosions (cosmetic, owner's equipped Explosion). Each style is a short composition of
-- pooled primitives from Effects, kept readable and brief so it never hides the next phase.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)

local Effects = require(script.Parent.Effects)

local Explosions = {}

local hex = Color3.fromHex

type Ctx = { pos: Vector3, right: Vector3, up: Vector3, normal: Vector3, colors: { Color3 }, size: number }

local styles: { [string]: (Ctx) -> () } = {
	Burst = function(c)
		Effects.Flash(c.pos, c.size * 2.6, c.colors[1], 0.3)
		Effects.Ring(c.pos, c.normal, c.size * 2.2, c.colors[2] or c.colors[1], 0.4)
		Effects.Sparks(c.pos, c.colors[2] or c.colors[1], 40, 22, 0.9)
		Effects.Smoke(c.pos, c.colors[3] or hex("#3A3A3A"), 8)
		Effects.Debris(c.pos, c.colors, 10, 0.45, 12, 0.8, c.right, c.up)
	end,
	Confetti = function(c)
		Effects.Flash(c.pos, c.size * 1.8, Color3.new(1, 1, 1), 0.2)
		Effects.Debris(c.pos, c.colors, 34, 0.32, 16, 1.4, c.right, c.up)
		Effects.Sparks(c.pos, c.colors[1], 20, 16, 0.5)
	end,
	Bubbles = function(c)
		for i = 1, 9 do
			local p = Effects.Part(Enum.PartType.Ball)
			p.Material = Enum.Material.Glass
			p.Transparency = 0.45
			p.Color = c.colors[(i % #c.colors) + 1]
			p.Size = Vector3.one * 0.3
			local a = i * 0.7
			p.Position = c.pos
			p.Parent = Effects.Folder()
			local target = c.pos + (c.right * math.cos(a) + c.up * math.sin(a)) * (1.5 + (i % 3)) + c.up * 1.2
			local tween = game:GetService("TweenService"):Create(p, TweenInfo.new(0.7 + i * 0.05, Enum.EasingStyle.Quad), { Position = target, Size = Vector3.one * (0.8 + (i % 3) * 0.3) })
			tween:Play()
			task.delay(0.75 + i * 0.05, function()
				Effects.Flash(p.Position, 1.2, Color3.new(1, 1, 1), 0.12)
				p:Destroy()
			end)
		end
	end,
	Pixels = function(c)
		Effects.Flash(c.pos, c.size * 2, c.colors[1], 0.15)
		Effects.Debris(c.pos, c.colors, 24, 0.5, 14, 0.9, c.right, c.up, Enum.PartType.Block)
	end,
	Splash = function(c)
		Effects.Debris(c.pos, c.colors, 18, 0.7, 10, 1.0, c.right, c.up, Enum.PartType.Ball)
		Effects.Ring(c.pos, c.normal, c.size * 2.4, c.colors[1], 0.5, 0.4)
	end,
	Shards = function(c)
		Effects.Flash(c.pos, c.size * 2.2, c.colors[1], 0.2)
		Effects.Debris(c.pos, c.colors, 16, 0.6, 18, 0.7, c.right, c.up, Enum.PartType.Block)
		Effects.Sparks(c.pos, Color3.new(1, 1, 1), 24, 18, 0.4)
	end,
	Nova = function(c)
		Effects.Flash(c.pos, c.size * 5, Color3.new(1, 1, 1), 0.35)
		Effects.Ring(c.pos, c.normal, c.size * 4, c.colors[2] or c.colors[1], 0.5, 0.3)
		Effects.Ring(c.pos, c.normal, c.size * 2.5, c.colors[3] or c.colors[1], 0.35, 0.3)
		Effects.Sparks(c.pos, c.colors[2] or c.colors[1], 50, 26, 0.8)
	end,
	Thunder = function(c)
		Effects.Lightning(c.pos + c.up * 14, c.pos, c.colors[1], 0.35)
		Effects.Lightning(c.pos + c.up * 14 + c.right * 2, c.pos, c.colors[2] or c.colors[1], 0.3)
		Effects.Flash(c.pos, c.size * 3.2, Color3.new(1, 1, 1), 0.25)
		Effects.Sparks(c.pos, c.colors[1], 30, 20, 0.6)
	end,
	Implode = function(c)
		local p = Effects.Part(Enum.PartType.Ball)
		p.Color = c.colors[1]
		p.Material = Enum.Material.Neon
		p.Size = Vector3.one * c.size * 3
		p.Position = c.pos
		p.Transparency = 0.2
		p.Parent = Effects.Folder()
		local tween = game:GetService("TweenService"):Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = Vector3.one * 0.1 })
		tween:Play()
		Effects.Ring(c.pos, c.normal, c.size * 3, c.colors[2] or c.colors[1], 0.45)
		task.delay(0.45, function()
			p:Destroy()
			Effects.Flash(c.pos, c.size * 3, c.colors[3] or c.colors[1], 0.25)
			Effects.Sparks(c.pos, c.colors[2] or c.colors[1], 30, 20, 0.6)
		end)
	end,
}

function Explosions.Play(explosionId: string?, pos: Vector3, station: CFrame, size: number?)
	local def = CosmeticDefinitions.Get("Explosion", explosionId or "classic") or CosmeticDefinitions.Get("Explosion", "classic")
	local colors: { Color3 } = {}
	local hexes: { string } = if def then def.Colors else { "#FFB347", "#FF5E1A" }
	for _, h in hexes do
		table.insert(colors, hex(h))
	end
	local style = styles[if def then def.Style else "Burst"] or styles.Burst
	style({
		pos = pos,
		right = station.RightVector,
		up = station.UpVector,
		normal = -station.LookVector,
		colors = colors,
		size = size or 1.5,
	})
end

return Explosions
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">Flyers</string>
              <string name="Source"><![CDATA[--!strict
-- Round finisher: the winning orb flies out of the arena at the losing player (LIKELY per
-- research), carried by the winner's equipped Flyer cosmetic, and breaks a heart on impact.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CosmeticDefinitions = require(Shared.Definitions.CosmeticDefinitions)

local Effects = require(script.Parent.Effects)
local CosmeticModels = require(script.Parent.CosmeticModels)

local Flyers = {}

local hex = Color3.fromHex

-- `orb` is the BillboardGui-carrying anchor of the winning orb (moved along with the flyer).
function Flyers.Play(flyerId: string?, from: Vector3, to: Vector3, orbAnchor: BasePart?, onImpact: () -> ())
	local id = flyerId or "basic"
	local def = CosmeticDefinitions.Get("Flyer", id)
	local model = CosmeticModels.Flyer(id)
	model.Parent = Effects.Folder()
	local trailColor = if def then hex(def.Colors[2] or def.Colors[1]) else Color3.new(1, 1, 1)

	-- trail on the model
	local core = model.PrimaryPart
	if core then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.4, 0)
		a0.Parent = core
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.4, 0)
		a1.Parent = core
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(trailColor)
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Lifetime = 0.35
		trail.LightEmission = 0.7
		trail.Parent = core
	end

	local duration = 1.05
	local apex = (from + to) / 2 + Vector3.new(0, math.max(6, (to - from).Magnitude * 0.35), 0)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.clamp((os.clock() - start) / duration, 0, 1)
		local e = t * t * (3 - 2 * t)
		-- quadratic bezier
		local p = from:Lerp(apex, e):Lerp(apex:Lerp(to, e), e)
		local ahead = from:Lerp(apex, math.min(1, e + 0.02)):Lerp(apex:Lerp(to, math.min(1, e + 0.02)), math.min(1, e + 0.02))
		local look = if (ahead - p).Magnitude > 1e-3 then CFrame.lookAt(p, ahead) else CFrame.new(p)
		model:PivotTo(look)
		if orbAnchor then
			orbAnchor.CFrame = CFrame.new(p + look.UpVector * 0.9)
		end
		if t >= 1 then
			conn:Disconnect()
			model:Destroy()
			Effects.Flash(to, 4, Color3.new(1, 1, 1), 0.3)
			Effects.Sparks(to, trailColor, 30, 18, 0.7)
			onImpact()
		end
	end)
end

return Flyers
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="137">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>