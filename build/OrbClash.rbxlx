  <Item class="ServerScriptService" referent="32">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="33">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Battle</string>
        </Properties>
        <Item class="Folder" referent="35">
          <Properties>
            <string name="Name">Abilities</string>
          </Properties>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">aura</string>
              <string name="Source"><![CDATA[--!strict
-- Aura Orb: a harmful aura surrounds it and grows over the round.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(ctx: any, ball: Ball, p: Params)
	local base = ball.r + p.StartRadius
	ctx:Spawn({
		kind = "aura",
		shape = "circle",
		owner = ball,
		x = ball.x,
		y = ball.y,
		r = base,
		dynamic = true,
		pierce = true,
		damage = p.Damage,
		damageKind = "hazard",
		hitCooldown = p.TickEvery,
		data = { base = base },
		onUpdate = function(c: any, e: Entity, _dt: number)
			local owner = e.owner
			if owner == nil or not owner.alive then
				c:Remove(e, "owner")
				return
			end
			e.x, e.y = owner.x, owner.y
			local t = math.clamp(c:BattleTime() / p.GrowTime, 0, 1)
			local radius = owner.r + p.StartRadius + (p.EndRadius - p.StartRadius) * t
			e.scale = radius / e.data.base
			e.rot += 0.02
		end,
		visual = { color = ball.def.Visual.Base, rim = ball.def.Visual.Rim },
	})
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">boomerang</string>
              <string name="Source"><![CDATA[--!strict
-- Boomerang Orb: throws a boomerang at the nearest enemy; it flies out, turns, and homes back.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

local function update(ctx: any, e: Entity, dt: number)
	local owner = e.owner
	if owner == nil or not owner.alive then
		ctx:Remove(e, "owner")
		return
	end
	local d = e.data
	local h = ctx:Half() - e.r
	e.rot += 16 * dt
	if d.phase == "out" then
		e.x += e.vx * dt
		e.y += e.vy * dt
		d.travelled += d.speed * dt
		if d.travelled >= d.range or math.abs(e.x) >= h or math.abs(e.y) >= h then
			d.phase = "back"
			e.hits = {} -- allow a second hit on the way back
		end
		e.x, e.y = math.clamp(e.x, -h, h), math.clamp(e.y, -h, h)
	else
		local nx, ny, dist = U.Normalize(owner.x - e.x, owner.y - e.y)
		local speed = d.speed * 1.15
		e.vx, e.vy = nx * speed, ny * speed
		e.x += e.vx * dt
		e.y += e.vy * dt
		if dist < owner.r + 0.4 or e.age > 4 then
			ctx:Remove(e, "caught")
		end
	end
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if not U.Every(ball.state, "throw", dt, p.Interval, 1.0) then
		return
	end
	if #ctx:EntitiesOf(ball, "boomerang") > 0 then
		return
	end
	local target = ctx:Nearest(ball)
	if target == nil then
		return
	end
	local nx, ny = U.Normalize(target.x - ball.x, target.y - ball.y)
	ctx:Spawn({
		kind = "boomerang",
		shape = "circle",
		owner = ball,
		x = ball.x + nx * ball.r,
		y = ball.y + ny * ball.r,
		r = p.Radius,
		vx = nx * p.Speed,
		vy = ny * p.Speed,
		dynamic = true,
		pierce = true,
		damage = p.Damage,
		damageKind = "ability",
		hitCooldown = 0.6,
		data = { phase = "out", travelled = 0, range = p.Range, speed = p.Speed },
		onUpdate = update,
		visual = { color = ball.def.Visual.Accent },
	})
	ctx:Fx("throw", { id = ball.id })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">bumper</string>
              <string name="Source"><![CDATA[--!strict
-- Bumper Orb: plain contact fighter. Knocks enemies away harder on every bump.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnBallHit = function(ctx: any, ball: Ball, p: Params, other: Ball, cx: number, cy: number)
	if other.team == ball.team or other.status.frozen > 0 or other.status.snared > 0 then
		return
	end
	other.vx *= p.KnockbackBoost
	other.vy *= p.KnockbackBoost
	ctx:Fx("bump", { id = ball.id, x = cx, y = cy })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">cannon</string>
              <string name="Source"><![CDATA[--!strict
-- Cannon Orb: fires a heavy cannonball at the enemy's predicted position, with recoil.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if not U.Every(ball.state, "fire", dt, p.Interval, 1.4) then
		return
	end
	local target = ctx:Nearest(ball)
	if target == nil then
		return
	end
	-- lead the target by the projectile travel time
	local _, _, dist = U.Normalize(target.x - ball.x, target.y - ball.y)
	local t = dist / p.Speed
	local px, py = U.ClampInside(ctx, target.x + target.vx * t, target.y + target.vy * t, target.r)
	local nx, ny = U.Normalize(px - ball.x, py - ball.y)
	ctx:Spawn({
		kind = "cannonball",
		shape = "circle",
		owner = ball,
		x = ball.x + nx * (ball.r + p.Radius),
		y = ball.y + ny * (ball.r + p.Radius),
		r = p.Radius,
		vx = nx * p.Speed,
		vy = ny * p.Speed,
		dynamic = true,
		dieOnWall = true,
		damage = p.Damage,
		damageKind = "ability",
		life = 2,
		visual = { color = "#1C1E22" },
	})
	ball.vx -= nx * p.Recoil
	ball.vy -= ny * p.Recoil
	ctx:Fx("muzzle", { id = ball.id, x = ball.x + nx * ball.r, y = ball.y + ny * ball.r, angle = math.atan2(ny, nx) })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">crystal</string>
              <string name="Source"><![CDATA[--!strict
-- Crystal Orb: impacts (walls or orbs) may shatter shards outward.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

local function scatter(ctx: any, ball: Ball, p: Params, baseAngle: number, spread: number)
	local now = ctx:Now()
	if ball.state.readyAt and now < ball.state.readyAt then
		return
	end
	if not ctx:Random():Chance(p.Chance) then
		return
	end
	ball.state.readyAt = now + p.Cooldown
	for i = 1, p.Shards do
		local t = if p.Shards == 1 then 0.5 else (i - 1) / (p.Shards - 1)
		local a = baseAngle - spread / 2 + spread * t + ctx:Random():Range(-0.15, 0.15)
		ctx:Spawn({
			kind = "shard",
			shape = "circle",
			owner = ball,
			x = ball.x + math.cos(a) * ball.r,
			y = ball.y + math.sin(a) * ball.r,
			r = 0.3,
			vx = math.cos(a) * p.Speed,
			vy = math.sin(a) * p.Speed,
			dynamic = true,
			dieOnWall = true,
			life = p.Life,
			damage = p.Damage,
			damageKind = "ability",
			visual = { color = ball.def.Visual.Base },
		})
	end
	ctx:Fx("shatter", { id = ball.id, x = ball.x, y = ball.y })
end

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, nx: number, ny: number, _px: number, _py: number)
	scatter(ctx, ball, p, math.atan2(ny, nx), math.pi * 0.85)
end

Ability.OnBallHit = function(ctx: any, ball: Ball, p: Params, other: Ball, _cx: number, _cy: number)
	if other.team == ball.team then
		return
	end
	scatter(ctx, ball, p, math.atan2(ball.y - other.y, ball.x - other.x), math.pi * 1.6)
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">forge</string>
              <string name="Source"><![CDATA[--!strict
-- Forge Orb: every Nth enemy hit is a SMASH (multiplied damage + shockwave around it).
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.hits = 0
end

Ability.ModifyContact = function(ctx: any, ball: Ball, p: Params, other: Ball, damage: number): number
	if other.team == ball.team then
		return damage
	end
	ball.state.hits += 1
	local charge = ball.state.hits % p.HitsPerSmash
	ctx:Fx("forgeCharge", { id = ball.id, charge = charge, max = p.HitsPerSmash })
	if charge ~= 0 then
		return damage
	end
	U.Blast(ctx, ball, ball.x, ball.y, p.WaveRadius, p.WaveDamage, "ability", other)
	ctx:Fx("shockwave", { id = ball.id, x = ball.x, y = ball.y, r = p.WaveRadius, color = "#FFB000" })
	return damage * p.SmashMultiplier
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">frost</string>
              <string name="Source"><![CDATA[--!strict
-- Frost Orb: contact freezes the enemy briefly (with frostbite damage); frozen orbs take extra damage.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.cooldowns = {}
end

Ability.OnBallHit = function(ctx: any, ball: Ball, p: Params, other: Ball, cx: number, cy: number)
	if other.team == ball.team then
		return
	end
	local cooldowns = ball.state.cooldowns
	local now = ctx:Now()
	if cooldowns[other.id] and now < cooldowns[other.id] then
		return
	end
	cooldowns[other.id] = now + p.Cooldown
	other.frozenVuln = math.max(other.frozenVuln, p.FrozenVulnerability)
	ctx:SetStatus(other, "frozen", p.FreezeTime)
	ctx:Fx("freeze", { id = other.id, x = cx, y = cy, duration = p.FreezeTime })
	ctx:Damage(other, p.Frostbite, { source = ball, kind = "ability", x = other.x, y = other.y })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">ghost</string>
              <string name="Source"><![CDATA[--!strict
-- Ghost Orb: periodically phases out (untouchable + faster). Passing through enemies while
-- ethereal chills them; rematerialising near an enemy spooks it.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	local s = ball.state
	if s.phasing then
		if ball.status.phased <= 0 then
			s.phasing = false
			ball.speedMult = 1
			local spooked = false
			for _, other in ctx:Enemies(ball) do
				local reach = ball.r + other.r + p.SpookRadius
				if (other.x - ball.x) ^ 2 + (other.y - ball.y) ^ 2 < reach * reach then
					ctx:Damage(other, p.SpookDamage, { source = ball, kind = "ability", ignorePhase = true, x = other.x, y = other.y })
					spooked = true
				end
			end
			ctx:Fx("unphase", { id = ball.id, x = ball.x, y = ball.y, spook = spooked })
			return
		end
		-- haunting: passing through an enemy while ethereal chills it
		s.passedAt = s.passedAt or {}
		local now = ctx:Now()
		for _, other in ctx:Enemies(ball) do
			local reach = ball.r + other.r
			local ready = s.passedAt[other.id] == nil or now >= s.passedAt[other.id]
			if ready and (other.x - ball.x) ^ 2 + (other.y - ball.y) ^ 2 < reach * reach then
				s.passedAt[other.id] = now + p.PassCooldown
				ctx:Damage(other, p.PassDamage, { source = ball, kind = "ability", x = other.x, y = other.y })
				ctx:Fx("haunt", { id = other.id, x = other.x, y = other.y })
			end
		end
		return
	end
	if U.Every(s, "phase", dt, p.Interval, 2.5) then
		s.phasing = true
		ball.speedMult = 1 + p.SpeedBoost
		ctx:SetStatus(ball, "phased", p.Duration)
		ctx:Fx("phase", { id = ball.id, duration = p.Duration })
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">goo</string>
              <string name="Source"><![CDATA[--!strict
-- Goo Orb: wall bounces leave goo puddles that slow and damage enemies inside them.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, nx: number, ny: number, px: number, py: number)
	U.MakeRoom(ctx, ball, "goo", p.MaxPuddles)
	local x, y = U.ClampInside(ctx, px + nx * p.Radius * 0.55, py + ny * p.Radius * 0.55, p.Radius * 0.55)
	ctx:Spawn({
		kind = "goo",
		shape = "circle",
		owner = ball,
		x = x,
		y = y,
		r = p.Radius,
		rot = math.atan2(ny, nx),
		life = p.Life,
		armed = 0.1,
		pierce = true,
		hitCooldown = p.TickEvery,
		onHit = function(c: any, e: Entity, victim: Ball)
			c:SetStatus(victim, "slowed", p.SlowTime, { factor = 1 - p.Slow })
			c:Damage(victim, p.Damage, { source = e.owner, kind = "hazard", entity = e, x = victim.x, y = victim.y })
		end,
		visual = { color = ball.def.Visual.Base, accent = ball.def.Visual.Accent },
	})
	ctx:Fx("splat", { id = ball.id, x = px, y = py })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">jack</string>
              <string name="Source"><![CDATA[--!strict
-- Jack Orb (Harvest Moon event): lobs pumpkin bombs on an arc; they explode on impact and
-- leave a short-lived fire patch.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

local LOB_GRAVITY = 20

local function explode(ctx: any, e: Entity, p: Params)
	local owner = e.owner
	if owner == nil then
		return
	end
	local x, y = U.ClampInside(ctx, e.x, e.y, p.FireRadius * 0.6)
	U.Blast(ctx, owner, x, y, p.BlastRadius, p.Damage, "ability")
	ctx:Fx("explosion", { x = x, y = y, r = p.BlastRadius, color = "#FF8C1A" })
	ctx:Spawn({
		kind = "fire",
		shape = "circle",
		owner = owner,
		x = x,
		y = y,
		r = p.FireRadius,
		life = p.FireLife,
		pierce = true,
		damage = p.FireDamage,
		hitCooldown = p.FireTick,
		visual = { color = "#FF8C1A" },
	})
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if not U.Every(ball.state, "lob", dt, p.Interval, 1.5) then
		return
	end
	local target = ctx:Nearest(ball)
	if target == nil then
		return
	end
	local dx, dy = target.x - ball.x, target.y - ball.y
	local dist = math.sqrt(dx * dx + dy * dy)
	local flight = math.clamp(dist / p.LobSpeed, 0.45, 1.1)
	local vx = dx / flight
	local vy = dy / flight + 0.5 * LOB_GRAVITY * flight
	ctx:Spawn({
		kind = "pumpkin",
		shape = "circle",
		owner = ball,
		x = ball.x,
		y = ball.y + ball.r * 0.5,
		r = 0.6,
		vx = vx,
		vy = vy,
		gravity = LOB_GRAVITY,
		dynamic = true,
		dieOnWall = true,
		life = 2.5,
		onHit = function(c: any, e: Entity, _victim: Ball)
			explode(c, e, p)
		end,
		onWall = function(c: any, e: Entity)
			explode(c, e, p)
		end,
		visual = { color = ball.def.Visual.Base },
	})
	ctx:Fx("lob", { id = ball.id })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">leech</string>
              <string name="Source"><![CDATA[--!strict
-- Leech Orb: bumping an enemy latches on; drains HP over time and heals itself.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.readyAt = 0
end

Ability.OnBallHit = function(ctx: any, ball: Ball, p: Params, other: Ball, _cx: number, _cy: number)
	if other.team == ball.team or ctx:Now() < ball.state.readyAt then
		return
	end
	ball.state.readyAt = ctx:Now() + p.Cooldown
	ball.state.target = other
	ball.state.latchUntil = ctx:Now() + p.Duration
	ball.state.nextTick = ctx:Now() + p.TickEvery
	ctx:SetStatus(other, "latched", p.Duration)
	ctx:Fx("tether", { a = ball.id, b = other.id, duration = p.Duration })
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, _dt: number)
	local target: Ball? = ball.state.target
	if target == nil then
		return
	end
	local now = ctx:Now()
	if not target.alive or now > ball.state.latchUntil then
		ball.state.target = nil
		return
	end
	if now >= ball.state.nextTick then
		ball.state.nextTick += p.TickEvery
		local dealt = ctx:Damage(target, p.DrainPerTick, { source = ball, kind = "drain", x = target.x, y = target.y })
		if dealt > 0 then
			ctx:Heal(ball, dealt)
		end
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">lucky</string>
              <string name="Source"><![CDATA[--!strict
-- Lucky Orb: every bump rolls a die. Damage = roll; a six bursts into a jackpot of shards.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.ModifyContact = function(ctx: any, ball: Ball, p: Params, _other: Ball, _damage: number): number
	local roll = ctx:Random():Int(1, 6)
	ctx:Fx("dice", { id = ball.id, roll = roll })
	if roll == 6 then
		local base = ctx:Random():Range(0, 2 * math.pi)
		for i = 1, p.JackpotShards do
			local a = base + (i - 1) * (2 * math.pi / p.JackpotShards)
			ctx:Spawn({
				kind = "chip",
				shape = "circle",
				owner = ball,
				x = ball.x + math.cos(a) * ball.r,
				y = ball.y + math.sin(a) * ball.r,
				r = 0.32,
				vx = math.cos(a) * p.ShardSpeed,
				vy = math.sin(a) * p.ShardSpeed,
				dynamic = true,
				dieOnWall = true,
				life = 1,
				damage = p.ShardDamage,
				damageKind = "ability",
				visual = { color = "#FFD23F" },
			})
		end
	end
	return roll * p.DamagePerPip
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">magnet</string>
              <string name="Source"><![CDATA[--!strict
-- Magnet Orb: periodically yanks enemies toward itself; the next bump after a pull hits harder.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if not U.Every(ball.state, "pulse", dt, p.Interval, 2) then
		return
	end
	for _, other in ctx:Enemies(ball) do
		if other.launched and other.status.phased <= 0 then
			local tx, ty = U.Normalize(ball.x - other.x, ball.y - other.y)
			local speed = math.max(U.Speed(other), 10)
			local cx, cy = U.Normalize(other.vx, other.vy)
			local bx, by = U.Normalize(cx + (tx - cx) * p.PullBlend * 1.0, cy + (ty - cy) * p.PullBlend)
			ctx:SetVelocity(other, bx * speed, by * speed)
		end
	end
	ball.state.bonusUntil = ctx:Now() + p.BonusWindow
	ctx:Fx("magnet", { id = ball.id, x = ball.x, y = ball.y })
end

Ability.ModifyContact = function(ctx: any, ball: Ball, p: Params, _other: Ball, damage: number): number
	if ball.state.bonusUntil and ctx:Now() <= ball.state.bonusUntil then
		ball.state.bonusUntil = nil
		return damage + p.BonusDamage
	end
	return damage
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">mine</string>
              <string name="Source"><![CDATA[--!strict
-- Mine Orb: drops proximity mines on wall bounces; they explode when an enemy rolls close.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.readyAt = 0
end

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, nx: number, ny: number, px: number, py: number)
	if ctx:Now() < ball.state.readyAt then
		return
	end
	ball.state.readyAt = ctx:Now() + p.Cooldown
	U.MakeRoom(ctx, ball, "mine", p.MaxMines)
	local x, y = U.ClampInside(ctx, px + nx * 0.8, py + ny * 0.8, 0.8)
	ctx:Spawn({
		kind = "mine",
		shape = "none",
		owner = ball,
		x = x,
		y = y,
		r = 0.55,
		life = p.Life,
		armed = p.ArmTime,
		data = { trigger = p.Trigger },
		onUpdate = function(c: any, e: Entity, _dt: number)
			local owner = e.owner
			if e.armed > 0 or owner == nil then
				return
			end
			for _, other in c:Enemies(owner) do
				local reach = p.Trigger + other.r
				if other.launched and other.status.phased <= 0 and (other.x - e.x) ^ 2 + (other.y - e.y) ^ 2 < reach * reach then
					U.Blast(c, owner, e.x, e.y, p.BlastRadius, p.Damage, "ability")
					c:Fx("explosion", { x = e.x, y = e.y, r = p.BlastRadius, color = "#FF5E1A" })
					c:Remove(e, "detonated")
					return
				end
			end
		end,
		visual = { color = ball.def.Visual.Base, light = ball.def.Visual.Accent, armTime = p.ArmTime },
	})
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">mitosis</string>
              <string name="Source"><![CDATA[--!strict
-- Mitosis Orb: grows over time; on death it splits into mini orbs that keep the team alive (OnDeath).
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.growth = 0
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if ball.state.growth >= p.MaxGrowth then
		return
	end
	if U.Every(ball.state, "grow", dt, p.GrowEvery) then
		ball.state.growth = math.min(p.MaxGrowth, ball.state.growth + p.GrowAmount)
		local scale = 1 + ball.state.growth
		ball.r = ball.baseR * scale
		ball.mass = ball.def.Mass * scale * scale
		ball.contact = ball.def.ContactDamage * (1 + ball.state.growth * p.ContactPerGrowth)
		ctx:Fx("grow", { id = ball.id, r = ball.r })
	end
end

Ability.OnDeath = function(ctx: any, ball: Ball, p: Params, _killer: Ball?): boolean?
	local base = ctx:Random():Range(0, 2 * math.pi)
	local speed = ctx.physics.CruiseSpeed
	for i = 1, p.Minis do
		local a = base + (i - 1) * (2 * math.pi / p.Minis)
		ctx:SpawnMinion(
			ball,
			ball.x + math.cos(a) * ball.r * 0.6,
			ball.y + math.sin(a) * ball.r * 0.6,
			math.cos(a) * speed,
			math.sin(a) * speed,
			p.MiniRadius,
			p.MiniHP,
			p.MiniContact
		)
	end
	ctx:Fx("split", { id = ball.id, x = ball.x, y = ball.y })
	return false
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">prism</string>
              <string name="Source"><![CDATA[--!strict
-- Prism Orb: a wall bounce projects a beam straight across the arena from the impact point.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, nx: number, ny: number, px: number, py: number)
	local now = ctx:Now()
	if ball.state.readyAt and now < ball.state.readyAt then
		return
	end
	ball.state.readyAt = now + p.Cooldown
	U.MakeRoom(ctx, ball, "beam", p.MaxBeams)
	local h = ctx:Half()
	local x2, y2 = px + nx * 2 * h, py + ny * 2 * h
	ctx:Spawn({
		kind = "beam",
		shape = "segment",
		owner = ball,
		x = px,
		y = py,
		x2 = math.clamp(x2, -h, h),
		y2 = math.clamp(y2, -h, h),
		r = p.Width,
		rot = math.atan2(ny, nx),
		life = p.ChargeTime + p.Life,
		armed = p.ChargeTime,
		damage = p.Damage,
		damageKind = "ability",
		hitCooldown = p.HitCooldown,
		pierce = true,
		visual = { color = ball.def.Visual.Accent, charge = p.ChargeTime },
	})
	ctx:Fx("beamCharge", { id = ball.id, x = px, y = py })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">rail</string>
              <string name="Source"><![CDATA[--!strict
-- Rail Orb: a wall bounce lays a rail straight across the arena through the impact point.
-- After a warning, a train sweeps along the rail and rams every enemy on it.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

local function trainUpdate(ctx: any, e: Entity, dt: number)
	local d = e.data
	local owner = e.owner
	d.progress += d.speed * dt
	local along = d.start + d.dir * d.progress
	if d.horizontal then
		e.x, e.y = along, d.line
	else
		e.x, e.y = d.line, along
	end
	if d.progress > d.travel then
		ctx:Remove(e, "done")
		if d.rail and not d.rail.removed then
			ctx:Remove(d.rail, "done")
		end
		return
	end
	if owner == nil then
		return
	end
	local halfL, halfW = d.length / 2, d.width / 2
	for _, other in ctx:Enemies(owner) do
		if other.launched and other.status.phased <= 0 and not e.hits[other.id] then
			local ax = if d.horizontal then math.abs(other.x - e.x) else math.abs(other.y - e.y)
			local ay = if d.horizontal then math.abs(other.y - e.y) else math.abs(other.x - e.x)
			if ax < halfL + other.r and ay < halfW + other.r then
				e.hits[other.id] = ctx:Now()
				ctx:Damage(other, d.damage, { source = owner, kind = "ability", entity = e, x = other.x, y = other.y })
				-- the train shoves the victim along its direction
				local push = d.speed * 0.6
				if d.horizontal then
					ctx:SetVelocity(other, d.dir * push, other.vy + (if other.y >= e.y then 6 else -6))
				else
					ctx:SetVelocity(other, other.vx + (if other.x >= e.x then 6 else -6), d.dir * push)
				end
				ctx:Fx("trainHit", { id = other.id, x = other.x, y = other.y })
			end
		end
	end
end

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.readyAt = 0
end

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, nx: number, ny: number, px: number, py: number)
	local now = ctx:Now()
	if now < ball.state.readyAt then
		return
	end
	ball.state.readyAt = now + p.Cooldown
	local h = ctx:Half()
	local horizontal = nx ~= 0 -- hit a side wall -> rail runs horizontally at that height
	local line = if horizontal then math.clamp(py, -h + 0.8, h - 0.8) else math.clamp(px, -h + 0.8, h - 0.8)
	-- the train enters from the wall that was hit and crosses the whole arena
	local dir = if horizontal then nx else ny
	local startEdge = -dir * (h + p.TrainLength / 2)
	local travel = 2 * h + p.TrainLength
	local rail = ctx:Spawn({
		kind = "rail",
		shape = "none",
		owner = ball,
		x = if horizontal then -h else line,
		y = if horizontal then line else -h,
		x2 = if horizontal then h else line,
		y2 = if horizontal then line else h,
		r = 0.25,
		rot = if horizontal then 0 else math.pi / 2,
		life = p.Warning + travel / p.TrainSpeed + 0.5,
		persist = false,
		visual = { warning = p.Warning, color = ball.def.Visual.Accent },
		onUpdate = function(c: any, e: Entity, _dt: number)
			if e.data.spawned or e.age < p.Warning then
				return
			end
			e.data.spawned = true
			c:Spawn({
				kind = "train",
				shape = "none",
				owner = e.owner,
				x = if horizontal then startEdge else line,
				y = if horizontal then line else startEdge,
				r = p.TrainWidth / 2,
				rot = if horizontal then (if dir > 0 then 0 else math.pi) else (if dir > 0 then math.pi / 2 else -math.pi / 2),
				dynamic = true,
				life = travel / p.TrainSpeed + 0.4,
				data = {
					horizontal = horizontal,
					line = line,
					start = startEdge,
					dir = dir,
					progress = 0,
					travel = travel,
					speed = p.TrainSpeed,
					length = p.TrainLength,
					width = p.TrainWidth,
					damage = p.Damage,
					rail = e,
				},
				onUpdate = trainUpdate,
				visual = { length = p.TrainLength, width = p.TrainWidth, color = ball.def.Visual.Base, accent = ball.def.Visual.Accent },
			})
			c:Fx("train", { id = e.owner and e.owner.id or 0 })
		end,
	})
	if rail then
		rail.data.spawned = false
		ctx:Fx("railLaid", { id = ball.id, x = px, y = py })
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">rook</string>
              <string name="Source"><![CDATA[--!strict
-- Rook Orb: pauses, lines up on the enemy's axis, then charges in a straight line.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.phase = "roam"
	ball.state.timer = 2.5
	ball.state.struck = {}
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	local s = ball.state
	s.timer -= dt
	if s.phase == "roam" then
		if s.timer <= 0 then
			local target = ctx:Nearest(ball)
			if target == nil then
				s.timer = 0.5
				return
			end
			s.phase = "windup"
			s.timer = p.Windup
			s.target = target
			ball.vx, ball.vy = 0, 0
			ball.status.charging = p.Windup + 0.05
			ctx:Fx("windup", { id = ball.id, duration = p.Windup })
		end
	elseif s.phase == "windup" then
		ball.vx, ball.vy = 0, 0
		if s.timer <= 0 then
			local target: Ball? = s.target
			local dx, dy = 1, 0
			if target and target.alive then
				local ox, oy = target.x - ball.x, target.y - ball.y
				if math.abs(ox) >= math.abs(oy) then
					dx, dy = if ox >= 0 then 1 else -1, 0
				else
					dx, dy = 0, if oy >= 0 then 1 else -1
				end
			end
			local speed = ctx.physics.CruiseSpeed * p.ChargeSpeed
			ball.vx, ball.vy = dx * speed, dy * speed
			ball.status.charging = p.ChargeTime
			s.phase = "charge"
			s.timer = p.ChargeTime
			s.struck = {}
			ctx:Fx("charge", { id = ball.id, dx = dx, dy = dy })
		end
	elseif s.phase == "charge" then
		if s.timer <= 0 or ball.status.charging <= 0 then
			s.phase = "roam"
			s.timer = p.Interval
			ball.status.charging = 0
		end
	end
end

Ability.ModifyContact = function(_ctx: any, ball: Ball, p: Params, other: Ball, damage: number): number
	local s = ball.state
	if s.phase == "charge" and other.team ~= ball.team and not s.struck[other.id] then
		s.struck[other.id] = true
		return damage + p.ChargeDamage
	end
	return damage
end

Ability.OnWallHit = function(_ctx: any, ball: Ball, _p: Params, _nx: number, _ny: number, _px: number, _py: number)
	-- a charge ends when it slams into a wall
	if ball.state.phase == "charge" then
		ball.status.charging = 0
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">satellite</string>
              <string name="Source"><![CDATA[--!strict
-- Satellite Orb: moons orbit the orb and hit anything they touch; one more joins on a timer.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

local function orbit(ctx: any, e: Entity, _dt: number)
	local owner = e.owner
	if owner == nil or not owner.alive then
		ctx:Remove(e, "owner")
		return
	end
	local s = owner.state
	local count = math.max(1, s.moonCount)
	local angle = ctx:Now() * e.data.angularSpeed + (e.data.index - 1) * (2 * math.pi / count)
	local radius = owner.r + e.data.gap
	e.x = owner.x + math.cos(angle) * radius
	e.y = owner.y + math.sin(angle) * radius
	e.rot = angle
end

local function addMoon(ctx: any, ball: Ball, p: Params)
	ball.state.moonCount += 1
	ctx:Spawn({
		kind = "moon",
		shape = "circle",
		owner = ball,
		x = ball.x,
		y = ball.y,
		r = p.MoonRadius,
		dynamic = true,
		pierce = true,
		damage = p.Damage,
		damageKind = "ability",
		hitCooldown = p.HitCooldown,
		data = { index = ball.state.moonCount, angularSpeed = p.AngularSpeed, gap = p.OrbitRadius - 1.5 },
		onUpdate = orbit,
		visual = { color = ball.def.Visual.Accent },
	})
end

Ability.Init = function(ctx: any, ball: Ball, p: Params)
	ball.state.moonCount = 0
	for _ = 1, p.StartMoons do
		addMoon(ctx, ball, p)
	end
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if ball.state.moonCount < p.MaxMoons and U.Every(ball.state, "add", dt, p.AddEvery) then
		addMoon(ctx, ball, p)
		ctx:Fx("moonAdded", { id = ball.id, count = ball.state.moonCount })
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">serpent</string>
              <string name="Source"><![CDATA[--!strict
-- Serpent Orb: leaves a venomous tail (its recent path). Enemies crossing the tail take damage.
-- Clients draw the tail from the interpolated path, so no entities are replicated for it.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local World = require(Battle.World)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.trail = {}
	ball.state.sample = 0
	ball.state.hitAt = {}
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	local s = ball.state
	local now = ctx:Now()
	s.sample -= dt
	if s.sample <= 0 then
		s.sample = p.SampleEvery
		table.insert(s.trail, { x = ball.x, y = ball.y, t = now })
	end
	while #s.trail > 0 and now - s.trail[1].t > p.TrailTime do
		table.remove(s.trail, 1)
	end
	local trail = s.trail
	-- skip the newest samples: those overlap the head itself
	local last = #trail - 3
	if last < 2 then
		return
	end
	for _, other in ctx:Enemies(ball) do
		if other.launched and other.status.phased <= 0 then
			local readyAt = s.hitAt[other.id]
			if readyAt == nil or now >= readyAt then
				for i = 1, last - 1 do
					local a, b = trail[i], trail[i + 1]
					if World.PointSegmentDistance(other.x, other.y, a.x, a.y, b.x, b.y) < p.Width + other.r then
						s.hitAt[other.id] = now + p.HitCooldown
						ctx:Damage(other, p.Damage, { source = ball, kind = "hazard", x = other.x, y = other.y })
						break
					end
				end
			end
		end
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">shackle</string>
              <string name="Source"><![CDATA[--!strict
-- Shackle Orb: scatters traps around the enemy. Anything caught is chained in place and hurt.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Entity = Types.Entity
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if not U.Every(ball.state, "drop", dt, p.Interval, 1.6) then
		return
	end
	local target = ctx:Nearest(ball)
	if target == nil then
		return
	end
	local rng = ctx:Random()
	for _ = 1, p.Traps do
		local a = rng:Range(0, 2 * math.pi)
		local dist = rng:Range(0.8, p.Spread)
		-- lead slightly along the target's travel direction
		local lx, ly = target.x + target.vx * 0.25, target.y + target.vy * 0.25
		local x, y = U.ClampInside(ctx, lx + math.cos(a) * dist, ly + math.sin(a) * dist, p.Radius)
		ctx:Spawn({
			kind = "shackle",
			shape = "circle",
			owner = ball,
			x = x,
			y = y,
			r = p.Radius,
			life = p.Life,
			armed = p.ArmTime,
			onHit = function(c: any, e: Entity, victim: Ball)
				c:SetStatus(victim, "snared", p.SnareTime)
				c:Damage(victim, p.Damage, { source = e.owner, kind = "ability", entity = e, x = victim.x, y = victim.y })
				c:Fx("chained", { id = victim.id, x = e.x, y = e.y, duration = p.SnareTime })
			end,
			visual = { color = ball.def.Visual.Accent, rim = ball.def.Visual.Rim, armTime = p.ArmTime },
		})
	end
	ctx:Fx("trapsDropped", { id = ball.id })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">spring</string>
              <string name="Source"><![CDATA[--!strict
-- Spring Orb: speeds up with every wall bounce; contact damage scales with the boost.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.boost = 0
end

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, _nx: number, _ny: number, px: number, py: number)
	local boost = math.min(p.MaxBoost, ball.state.boost + p.BoostPerBounce)
	if boost > ball.state.boost then
		ball.state.boost = boost
		ball.speedMult = 1 + boost
		ctx:Fx("boost", { id = ball.id, x = px, y = py, level = boost / p.MaxBoost })
	end
end

Ability.ModifyContact = function(_ctx: any, ball: Ball, p: Params, _other: Ball, damage: number): number
	return damage * (1 + ball.state.boost * p.DamagePerBoost)
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">storm</string>
              <string name="Source"><![CDATA[--!strict
-- Storm Orb: lightning strikes the nearest enemy on a timer (cannot miss). Below the HP
-- threshold it strikes faster and chains to a second enemy.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.timer = 1.2
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	local enraged = ball.hp <= ball.maxHp * p.Threshold
	if enraged and not ball.state.enraged then
		ball.state.enraged = true
		ctx:Fx("enrage", { id = ball.id })
	end
	ball.state.timer -= dt
	if ball.state.timer > 0 then
		return
	end
	ball.state.timer = if enraged then p.EnragedInterval else p.Interval
	local first = ctx:Nearest(ball)
	if first == nil then
		return
	end
	ctx:Damage(first, p.Damage, { source = ball, kind = "ability", x = first.x, y = first.y })
	ctx:Fx("lightning", { from = ball.id, to = first.id, x = first.x, y = first.y })
	if enraged then
		local second: Ball? = nil
		local bestDist = math.huge
		for _, other in ctx:Enemies(ball) do
			if other ~= first and other.status.phased <= 0 then
				local d = (other.x - first.x) ^ 2 + (other.y - first.y) ^ 2
				if d < bestDist then
					bestDist = d
					second = other
				end
			end
		end
		if second then
			ctx:Damage(second, p.ChainDamage, { source = ball, kind = "ability", x = second.x, y = second.y })
			ctx:Fx("lightning", { from = first.id, to = second.id, x = second.x, y = second.y, chain = true })
		end
	end
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">sunny</string>
              <string name="Source"><![CDATA[--!strict
-- Sunny Orb: passive regeneration plus a once-per-round sunburst at low HP (OnHPThreshold).
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.Init = function(_ctx: any, ball: Ball, _p: Params)
	ball.state.regen = 0
	ball.state.burstUsed = false
end

Ability.OnTick = function(ctx: any, ball: Ball, p: Params, dt: number)
	if ball.hp >= ball.maxHp then
		ball.state.regen = 0
		return
	end
	ball.state.regen += p.RegenPerSecond * dt
	if ball.state.regen >= 1 then
		local chunk = math.floor(ball.state.regen)
		ball.state.regen -= chunk
		ctx:Heal(ball, chunk)
	end
end

Ability.OnHealthChanged = function(ctx: any, ball: Ball, p: Params, _old: number, new: number)
	if ball.state.burstUsed or new <= 0 or new > ball.maxHp * p.Threshold then
		return
	end
	ball.state.burstUsed = true
	ctx:Heal(ball, p.BurstHeal)
	for _, other in ctx:Enemies(ball) do
		local nx, ny, dist = U.Normalize(other.x - ball.x, other.y - ball.y)
		if dist < p.BurstRadius + other.r then
			ctx:SetVelocity(other, nx * p.BurstPush, ny * p.BurstPush)
		end
	end
	ctx:Fx("sunburst", { id = ball.id, x = ball.x, y = ball.y, r = p.BurstRadius })
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">thorn</string>
              <string name="Source"><![CDATA[--!strict
-- Thorn Orb: every wall bounce grows a thorn sticking out of that wall.
local Battle = script.Parent.Parent
local Types = require(Battle.Types)
local U = require(Battle.AbilityUtil)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnWallHit = function(ctx: any, ball: Ball, p: Params, nx: number, ny: number, px: number, py: number)
	U.MakeRoom(ctx, ball, "thorn", p.MaxThorns)
	-- slide the base along the wall slightly so thorns never sit exactly on the corner
	local h = ctx:Half() - p.Width * 0.5
	local bx = if nx ~= 0 then px else math.clamp(px, -h, h)
	local by = if ny ~= 0 then py else math.clamp(py, -h, h)
	ctx:Spawn({
		kind = "thorn",
		shape = "segment",
		owner = ball,
		x = bx,
		y = by,
		x2 = bx + nx * p.Length,
		y2 = by + ny * p.Length,
		r = p.Width * 0.3,
		rot = math.atan2(ny, nx),
		life = p.Life,
		armed = 0.15,
		damage = p.Damage,
		hitCooldown = p.HitCooldown,
		pierce = true,
		visual = { length = p.Length, width = p.Width, color = ball.def.Visual.Base },
	})
end

return Ability
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">titan</string>
              <string name="Source"><![CDATA[--!strict
-- Titan Orb: big, heavy, takes reduced contact damage (OnDamageTaken modifier).
local Battle = script.Parent.Parent
local Types = require(Battle.Types)

type Ball = Types.Ball
type Params = { [string]: any }

local Ability: Types.Ability = {}

Ability.OnDamageTaken = function(_ctx: any, _ball: Ball, p: Params, amount: number, info: Types.DamageInfo): number
	if info.kind == "contact" then
		return amount * (1 - p.ContactReduction)
	end
	return amount
end

return Ability
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">AbilityUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Small helpers shared by ability modules (kept out of Abilities/ so the registry only sees abilities).
local Types = require(script.Parent.Types)

type Ball = Types.Ball

local AbilityUtil = {}

function AbilityUtil.Normalize(dx: number, dy: number): (number, number, number)
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 1e-6 then
		return 1, 0, 0
	end
	return dx / len, dy / len, len
end

-- Counts state[key] down by dt; returns true (and resets to interval) when it elapses.
function AbilityUtil.Every(state: { [string]: any }, key: string, dt: number, interval: number, initial: number?): boolean
	local remaining = state[key]
	if remaining == nil then
		remaining = initial or interval
	end
	remaining -= dt
	if remaining <= 0 then
		state[key] = remaining + interval
		return true
	end
	state[key] = remaining
	return false
end

function AbilityUtil.ClampInside(ctx: any, x: number, y: number, margin: number): (number, number)
	local h = ctx:Half() - margin
	return math.clamp(x, -h, h), math.clamp(y, -h, h)
end

-- Removes the oldest entities of `kind` owned by `ball` so at most `max - 1` remain.
function AbilityUtil.MakeRoom(ctx: any, ball: Ball, kind: string, max: number)
	local list = ctx:EntitiesOf(ball, kind)
	table.sort(list, function(a, b)
		return a.age > b.age
	end)
	local excess = #list - (max - 1)
	for i = 1, excess do
		ctx:Remove(list[i], "replaced")
	end
end

-- Damages every enemy of `ball` within `radius` of (x, y). Returns number of victims.
function AbilityUtil.Blast(ctx: any, ball: Ball, x: number, y: number, radius: number, damage: number, kind: string?, except: Ball?): number
	local victims = 0
	for _, other in ctx:Enemies(ball) do
		if other ~= except and other.launched then
			local reach = radius + other.r
			if (other.x - x) ^ 2 + (other.y - y) ^ 2 < reach * reach then
				ctx:Damage(other, damage, { source = ball, kind = kind or "ability", x = other.x, y = other.y })
				victims += 1
			end
		end
	end
	return victims
end

function AbilityUtil.Speed(ball: Ball): number
	return math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy)
end

return AbilityUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">BotBrain</string>
            <string name="Source"><![CDATA[--!strict
-- Decisions for practice bots and for disconnected teammates in 2v2 (auto-play).
local BotBrain = {}

local rng = Random.new()

-- Called every frame while a match is in selection/aim. Returns actions to apply.
function BotBrain.Selection(participant: { [string]: any }, now: number): number?
	if participant.Picked then
		return nil
	end
	participant.ThinkAt = participant.ThinkAt or (now + rng:NextNumber(1.2, 3.2))
	if now >= participant.ThinkAt then
		participant.ThinkAt = nil
		return rng:NextInteger(1, #participant.Offers)
	end
	return nil
end

-- Aims roughly at the arena centre/opponents with some spread.
function BotBrain.Aim(participant: { [string]: any }, now: number, fromX: number, fromY: number, targetX: number, targetY: number): number?
	if participant.Locked then
		return nil
	end
	participant.ThinkAt = participant.ThinkAt or (now + rng:NextNumber(1.0, 2.8))
	if now >= participant.ThinkAt then
		participant.ThinkAt = nil
		local base = math.atan2(targetY - fromY, targetX - fromX)
		return base + rng:NextNumber(-0.9, 0.9)
	end
	return nil
end

return BotBrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Damage</string>
            <string name="Source"><![CDATA[--!strict
-- The single damage pipeline. Every point of damage in a battle goes through Damage.Apply so
-- modifiers, immunity, ability hooks, events and deaths behave the same everywhere.
local Types = require(script.Parent.Types)

type Ball = Types.Ball
type DamageInfo = Types.DamageInfo

local Damage = {}

function Damage.Apply(world: any, target: Ball, amount: number, info: DamageInfo): number
	if not target.alive or amount <= 0 or amount ~= amount then
		return 0
	end
	local st = target.status
	if st.phased > 0 and not info.ignorePhase then
		return 0
	end
	if st.invuln > 0 and info.kind ~= "overtime" then
		return 0
	end
	local source = info.source
	if source ~= nil and source ~= target and source.team == target.team and not world.friendlyFire then
		return 0
	end

	if info.kind ~= "overtime" then
		amount *= world.damageMult
		if source ~= nil then
			amount *= source.dmgDealtMult
		end
	end
	amount *= target.dmgTakenMult
	if st.frozen > 0 then
		amount *= 1 + target.frozenVuln
	end

	local ok, modified = world:_call(target, "OnDamageTaken", amount, info)
	if ok and type(modified) == "number" then
		amount = modified
	end
	if amount <= 0 then
		return 0
	end

	local old = target.hp
	target.hp = math.max(0, old - amount)
	local dealt = old - target.hp
	if source ~= nil then
		source.damageDealt += dealt
		target.lastAttacker = source.id
	end

	world:Emit({
		t = "Damage",
		id = target.id,
		amount = dealt,
		kind = info.kind,
		src = if source then source.id else nil,
		x = info.x,
		y = info.y,
	})

	if source ~= nil and source.alive then
		world:_call(source, "OnDamageDealt", target, dealt, info)
	end
	world:_call(target, "OnHealthChanged", old, target.hp)

	if target.hp <= 0 then
		world:Kill(target, source)
	end
	return dealt
end

return Damage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[--!strict
-- Server-authoritative match state machine shared by 1v1 and 2v2.
--
--   MatchIntro -> RoundStart -> BallSelection -> AimPhase -> Countdown -> Battling
--      -> RoundResolution -> (RoundStart | MatchVictory) -> Closed
--
-- Every transition is driven by server time (workspace:GetServerTimeNow) so clients can show
-- exact countdowns. Player input only *requests* actions; this module validates them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.Game)
local PhysicsConfig = require(Shared.Config.Physics)
local BallDefinitions = require(Shared.Definitions.BallDefinitions)
local ArenaGeometry = require(Shared.Visual.ArenaGeometry)
local Validate = require(Shared.Util.Validate)

local World = require(script.Parent.World)
local BotBrain = require(script.Parent.BotBrain)

export type Participant = {
	UserId: number,
	Name: string,
	Player: Player?,
	IsBot: boolean,
	Team: number,
	Pad: number,
	Slot: number,
	Connected: boolean,
	Offers: { string },
	Rerolls: number,
	Picked: boolean,
	Selected: string?,
	FreePicksUsed: number,
	Aim: number,
	Locked: boolean,
	BallId: number?,
	Explosion: string,
	Flyer: string,
	VsFriend: boolean,
	ThinkAt: number?,
}

export type ParticipantSpec = {
	Player: Player?,
	BotName: string?,
	BotId: number?,
	Team: number,
	Pad: number,
}

-- Services injected by MatchService (avoids require cycles).
export type Deps = {
	BallService: any,
	AbilityService: any,
	EconomyService: any,
	DataService: any,
	RewardService: any,
	ArenaService: any,
	Replicator: any,
	PrivateRemote: RemoteEvent,
	Notify: (Player, string) -> (),
	OnPublicChanged: (match: any) -> (),
	OnClosed: (match: any) -> (),
}

local Match = {}
Match.__index = Match

local T = GameConfig.Timings
local SEL = GameConfig.Selection

local nextMatchId = 0

export type Match = typeof(setmetatable(
	{} :: {
		Id: number,
		Station: any,
		Mode: string,
		Kind: string,
		Half: number,
		Practice: boolean,
		Participants: { Participant },
		Teams: { { Hearts: number } },
		Round: number,
		State: string,
		Deadline: number,
		World: World.World?,
		Seq: number,
		SnapshotClock: number,
		PendingEvents: { { [string]: any } },
		RoundResult: { [string]: any }?,
		WinnerTeam: number?,
		Forfeit: boolean,
		LastPublic: { [string]: any }?,
		Deps: Deps,
		Rng: Random,
		Closed: boolean,
	},
	Match
))

local function now(): number
	return Workspace:GetServerTimeNow()
end

function Match.new(deps: Deps, station: any, specs: { ParticipantSpec }, practice: boolean): Match
	nextMatchId += 1
	local kind = ArenaGeometry.KindForMode(station.Mode)
	local participants: { Participant } = {}
	local slots: { [number]: number } = {}
	for _, spec in specs do
		slots[spec.Team] = (slots[spec.Team] or 0) + 1
		local player = spec.Player
		local explosion, flyer = "classic", "basic"
		if player then
			local profile = deps.DataService.Get(player)
			if profile then
				explosion = profile.Equipped.Explosion
				flyer = profile.Equipped.Flyer
			end
		end
		table.insert(participants, {
			UserId = if player then player.UserId else (spec.BotId or -1),
			Name = if player then player.DisplayName else (spec.BotName or GameConfig.Bots.Name),
			Player = player,
			IsBot = player == nil,
			Team = spec.Team,
			Pad = spec.Pad,
			Slot = slots[spec.Team],
			Connected = player ~= nil,
			Offers = {},
			Rerolls = 0,
			Picked = false,
			Selected = nil,
			FreePicksUsed = 0,
			Aim = 0,
			Locked = false,
			BallId = nil,
			Explosion = explosion,
			Flyer = flyer,
			VsFriend = false,
			ThinkAt = nil,
		})
	end
	local self = setmetatable({
		Id = nextMatchId,
		Station = station,
		Mode = station.Mode,
		Kind = kind,
		Half = ArenaGeometry.Get(kind).Half,
		Practice = practice,
		Participants = participants,
		Teams = { { Hearts = GameConfig.Hearts }, { Hearts = GameConfig.Hearts } },
		Round = 0,
		State = "Created",
		Deadline = 0,
		World = nil,
		Seq = 0,
		SnapshotClock = 0,
		PendingEvents = {},
		RoundResult = nil,
		WinnerTeam = nil,
		Forfeit = false,
		LastPublic = nil,
		Deps = deps,
		Rng = Random.new(),
		Closed = false,
	}, Match)
	return self
end

---------------------------------------------------------------------------------------------
-- Queries

function Match.Players(self: Match): { Player }
	local out = {}
	for _, p in self.Participants do
		if p.Player and p.Connected then
			table.insert(out, p.Player)
		end
	end
	return out
end

function Match.ParticipantOf(self: Match, player: Player): Participant?
	for _, p in self.Participants do
		if p.Player == player then
			return p
		end
	end
	return nil
end

local function autoControlled(p: Participant): boolean
	return p.IsBot or not p.Connected
end

function Match.Summary(self: Match): { [string]: any }
	local list = {}
	for _, p in self.Participants do
		table.insert(list, {
			UserId = p.UserId,
			Name = p.Name,
			Team = p.Team,
			Pad = p.Pad,
			Slot = p.Slot,
			IsBot = p.IsBot,
			Connected = p.Connected,
			Ball = if self.State == "BallSelection" then nil else p.Selected,
			Picked = p.Picked,
			Locked = p.Locked,
			BallId = p.BallId,
			Explosion = p.Explosion,
			Flyer = p.Flyer,
		})
	end
	return {
		MatchId = self.Id,
		Station = self.Station.Index,
		StationId = self.Station.Id,
		Mode = self.Mode,
		Kind = self.Kind,
		Practice = self.Practice,
		Round = self.Round,
		State = self.State,
		Deadline = self.Deadline,
		Hearts = { self.Teams[1].Hearts, self.Teams[2].Hearts },
		MaxHearts = GameConfig.Hearts,
		Participants = list,
	}
end

function Match.PublicState(self: Match): { [string]: any }?
	return self.LastPublic
end

function Match.FullState(self: Match): { [string]: any }?
	if self.World == nil then
		return nil
	end
	return (self.World :: World.World):FullState()
end

---------------------------------------------------------------------------------------------
-- Networking helpers

function Match._public(self: Match, kind: string, extra: { [string]: any }?)
	local payload: { [string]: any } = { Type = kind, Summary = self:Summary() }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	-- remember the latest state snapshot for late spectators (without one-shot extras)
	self.LastPublic = { Type = "State", Summary = payload.Summary }
	self.Deps.Replicator.SendPublic(self.Station, payload)
	self.Deps.OnPublicChanged(self)
end

function Match._private(self: Match, p: Participant, payload: { [string]: any })
	local player = p.Player
	if player and p.Connected and player.Parent then
		payload.MatchId = self.Id
		payload.Station = self.Station.Index
		self.Deps.PrivateRemote:FireClient(player, payload)
	end
end

function Match._sendSelection(self: Match, p: Participant)
	self:_private(p, {
		Type = "Selection",
		Round = self.Round,
		Offers = p.Offers,
		Picked = p.Picked,
		Selected = p.Selected,
		RerollsLeft = SEL.MaxRerollsPerRound - p.Rerolls,
		RerollCost = SEL.RerollCost,
		FreePicksLeft = math.max(0, SEL.FreeCollectionPicksPerMatch - p.FreePicksUsed),
		CollectionCost = SEL.ExtraCollectionPickCost,
		Deadline = self.Deadline,
	})
end

function Match._flushEvents(self: Match)
	local world = self.World
	if world then
		local tm = world.time
		for _, e in world:DrainEvents() do
			e.tm = tm
			table.insert(self.PendingEvents, e)
		end
	end
	if #self.PendingEvents > 0 then
		self.Deps.Replicator.SendEvents(self.Station, self.PendingEvents)
		self.PendingEvents = {}
	end
end

---------------------------------------------------------------------------------------------
-- State machine

function Match.Start(self: Match)
	-- friend check for the "Duel with a friend" quest (async, non-blocking)
	task.spawn(function()
		for _, a in self.Participants do
			for _, b in self.Participants do
				local pa = a.Player
				if pa and b.Player and a ~= b and a.Team ~= b.Team then
					local ok, friends = pcall(function()
						return pa:IsFriendsWith(b.UserId)
					end)
					if ok and friends then
						a.VsFriend = true
					end
				end
			end
		end
	end)
	self:_enter("MatchIntro")
end

function Match._enter(self: Match, state: string)
	if self.Closed then
		return
	end
	self.State = state
	local t = now()
	if state == "MatchIntro" then
		self.Deadline = t + T.MatchIntro
		self:_public("Intro")
	elseif state == "RoundStart" then
		self.Round += 1
		for _, p in self.Participants do
			p.Offers = self.Deps.BallService.RollOffers(p.Player, SEL.OfferCount)
			p.Rerolls = 0
			p.Picked = false
			p.Selected = nil
			p.Locked = false
			p.BallId = nil
			p.ThinkAt = nil
		end
		self:_enter("BallSelection")
	elseif state == "BallSelection" then
		self.Deadline = t + T.SelectionTime
		for _, p in self.Participants do
			self:_sendSelection(p)
		end
		self:_public("Selection")
	elseif state == "AimPhase" then
		self:_buildWorld()
		self.Deadline = t + T.AimTime
		self:_public("Aim")
		self:_flushEvents()
		local world = self.World :: World.World
		for _, p in self.Participants do
			local ball = if p.BallId then world.ballsById[p.BallId] else nil
			if ball then
				self:_private(p, {
					Type = "Aim",
					BallId = ball.id,
					X = ball.x,
					Y = ball.y,
					Radius = ball.r,
					DefaultAngle = p.Aim,
					Deadline = self.Deadline,
					Half = self.Half,
				})
			end
		end
	elseif state == "Countdown" then
		self.Deadline = t + T.Countdown
		self:_public("Countdown")
	elseif state == "Battling" then
		local world = self.World :: World.World
		for _, p in self.Participants do
			if p.BallId then
				world:Launch(p.BallId, p.Aim)
			end
		end
		self.SnapshotClock = 0
		self.Deadline = t + PhysicsConfig.RoundHardCap + 5
		self:_public("Battle")
		self:_flushEvents()
	elseif state == "RoundResolution" then
		self:_resolveRound()
	elseif state == "MatchVictory" then
		self:_victory()
	elseif state == "Closed" then
		self:_close()
	end
end

function Match._buildWorld(self: Match)
	local deps = self.Deps
	local world = World.new({
		seed = self.Rng:NextInteger(1, 2 ^ 30),
		half = self.Half,
		resolveAbility = deps.AbilityService.Get,
		resolveDefinition = BallDefinitions.Get,
		friendlyFire = GameConfig.FriendlyFire,
	})
	self.World = world
	local layout = GameConfig.SpawnLayout[self.Mode]
	for _, p in self.Participants do
		if p.Selected == nil then
			p.Selected = p.Offers[1] or "bumper"
		end
		local spot = layout[p.Team][p.Slot] or layout[p.Team][1]
		local ball = world:SpawnBall({ defId = p.Selected :: string, owner = p.UserId, team = p.Team, x = spot.x, y = spot.y })
		p.BallId = ball.id
		p.Aim = if p.Team == 1 then math.rad(30) else math.rad(150)
		p.Locked = false
		p.ThinkAt = nil
	end
end

function Match._resolveRound(self: Match)
	local world = self.World :: World.World
	local result = world:GetResult()
	world:Finish()
	self:_flushEvents()
	local t = now()
	if result.state == "win" then
		local winner = (result :: any).team :: number
		local loser = if winner == 1 then 2 else 1
		self.Teams[loser].Hearts = math.max(0, self.Teams[loser].Hearts - 1)
		local winnerBalls = {}
		local flyerOwner: Participant? = nil
		for _, ball in world.balls do
			if ball.alive and ball.team == winner then
				table.insert(winnerBalls, { Id = ball.id, X = ball.x, Y = ball.y, Def = ball.defId, R = ball.r })
			end
		end
		local losers = {}
		for _, p in self.Participants do
			if p.Team == loser then
				table.insert(losers, p.UserId)
			elseif flyerOwner == nil then
				local ball = if p.BallId then world.ballsById[p.BallId] else nil
				if ball and ball.alive then
					flyerOwner = p
				end
			end
		end
		if flyerOwner == nil then
			for _, p in self.Participants do
				if p.Team == winner then
					flyerOwner = p
					break
				end
			end
		end
		self.RoundResult = { Winner = winner, Loser = loser }
		self.Deadline = t + T.RoundResolution
		self:_public("RoundEnd", {
			Winner = winner,
			Loser = loser,
			Draw = false,
			WinnerBalls = winnerBalls,
			LoserUserIds = losers,
			Flyer = if flyerOwner then flyerOwner.Flyer else "basic",
		})
	else
		self.RoundResult = { Draw = true }
		self.Deadline = t + T.DrawResolution
		self:_public("RoundEnd", { Draw = true })
	end
end

function Match._victory(self: Match)
	local winner = self.WinnerTeam
	if winner == nil then
		winner = if self.Teams[1].Hearts > self.Teams[2].Hearts then 1 else 2
		self.WinnerTeam = winner
	end
	self.Deadline = now() + T.MatchVictory
	self:_public("Victory", { WinnerTeam = winner, Forfeit = self.Forfeit })
	for _, p in self.Participants do
		local player = p.Player
		if player and p.Connected and player.Parent then
			local won = p.Team == winner
			local ok, summary = pcall(self.Deps.RewardService.GrantMatch, player, {
				Won = won,
				Forfeit = self.Forfeit,
				Practice = self.Practice,
				VsFriend = p.VsFriend,
			})
			self:_private(p, {
				Type = "Results",
				Won = won,
				Forfeit = self.Forfeit,
				Practice = self.Practice,
				Rewards = if ok then summary else nil,
				Hearts = { self.Teams[1].Hearts, self.Teams[2].Hearts },
				Team = p.Team,
			})
		end
	end
end

function Match._close(self: Match)
	if self.Closed then
		return
	end
	self.Closed = true
	self.World = nil
	self.Deps.Replicator.SendEvents(self.Station, { { t = "Clear" } })
	self:_public("Closed")
	self.Deps.OnClosed(self)
end

function Match.Abort(self: Match, reason: string)
	warn(string.format("[Match %d] aborted: %s", self.Id, reason))
	self:_enter("Closed")
end

---------------------------------------------------------------------------------------------
-- Per-frame update

local function allPicked(self: Match): boolean
	for _, p in self.Participants do
		if not p.Picked then
			return false
		end
	end
	return true
end

local function allLocked(self: Match): boolean
	for _, p in self.Participants do
		if not p.Locked then
			return false
		end
	end
	return true
end

function Match._autoPick(self: Match, p: Participant, index: number)
	if p.Picked then
		return
	end
	p.Selected = p.Offers[math.clamp(index, 1, math.max(1, #p.Offers))]
	p.Picked = true
	self:_sendSelection(p)
	self:_public("Selection")
	if allPicked(self) then
		self.Deadline = math.min(self.Deadline, now() + T.SelectionGrace)
	end
end

function Match.Update(self: Match, dt: number)
	if self.Closed then
		return
	end
	local t = now()
	local state = self.State

	if state == "BallSelection" then
		for _, p in self.Participants do
			if autoControlled(p) and not p.Picked then
				local index = BotBrain.Selection(p :: any, t)
				if index then
					self:_autoPick(p, index)
				end
			end
		end
		if t >= self.Deadline then
			for _, p in self.Participants do
				if not p.Picked then
					p.Selected = p.Offers[self.Rng:NextInteger(1, math.max(1, #p.Offers))]
					p.Picked = true
				end
			end
			self:_enter("AimPhase")
		end
	elseif state == "AimPhase" then
		local world = self.World :: World.World
		for _, p in self.Participants do
			if autoControlled(p) and not p.Locked and p.BallId then
				local ball = world.ballsById[p.BallId]
				-- aim at the first enemy ball
				local tx, ty = 0, 0
				for _, other in world.balls do
					if other.team ~= p.Team then
						tx, ty = other.x, other.y
						break
					end
				end
				local angle = BotBrain.Aim(p :: any, t, ball.x, ball.y, tx, ty)
				if angle then
					p.Aim = angle
					p.Locked = true
					self:_public("AimLock", { UserId = p.UserId })
					if allLocked(self) then
						self.Deadline = math.min(self.Deadline, t + 0.6)
					end
				end
			end
		end
		if t >= self.Deadline then
			self:_enter("Countdown")
		end
	elseif state == "Battling" then
		local world = self.World :: World.World
		world:Advance(dt)
		self.SnapshotClock += dt
		if self.SnapshotClock >= 1 / PhysicsConfig.SnapshotRate then
			self.SnapshotClock = 0
			self.Seq += 1
			self:_flushEvents()
			self.Deps.Replicator.SendSnapshot(self.Station, world:Snapshot(self.Station.Index, self.Seq))
		end
		if world:GetResult().state ~= "ongoing" or t >= self.Deadline then
			self.Seq += 1
			self.Deps.Replicator.SendSnapshot(self.Station, world:Snapshot(self.Station.Index, self.Seq))
			self:_enter("RoundResolution")
		end
	elseif t >= self.Deadline then
		if state == "MatchIntro" then
			self:_enter("RoundStart")
		elseif state == "Countdown" then
			self:_enter("Battling")
		elseif state == "RoundResolution" then
			self.Deps.Replicator.SendEvents(self.Station, { { t = "Clear" } })
			self.World = nil
			if self.Teams[1].Hearts <= 0 or self.Teams[2].Hearts <= 0 then
				self.WinnerTeam = if self.Teams[1].Hearts > 0 then 1 else 2
				self:_enter("MatchVictory")
			else
				self:_enter("RoundStart")
			end
		elseif state == "MatchVictory" then
			self:_enter("Closed")
		end
	end
end

---------------------------------------------------------------------------------------------
-- Player requests (validated)

function Match.HandleSelection(self: Match, player: Player, action: any, arg: any)
	if self.State ~= "BallSelection" then
		return
	end
	local p = self:ParticipantOf(player)
	if p == nil or p.Picked then
		return
	end
	local deps = self.Deps
	if action == "Pick" then
		if not Validate.Integer(arg, 1, #p.Offers) then
			return
		end
		self:_autoPick(p, arg)
		return
	elseif action == "Reroll" then
		if p.Rerolls >= SEL.MaxRerollsPerRound then
			deps.Notify(player, "No rerolls left this round.")
			return
		end
		if not deps.EconomyService.TrySpend(player, "Gems", SEL.RerollCost) then
			deps.Notify(player, string.format("You need %d Gems to reroll.", SEL.RerollCost))
			return
		end
		p.Rerolls += 1
		p.Offers = deps.BallService.RollOffers(player, SEL.OfferCount, p.Offers)
		self:_sendSelection(p)
		return
	elseif action == "Collection" then
		if not BallDefinitions.Exists(arg) or not deps.BallService.Owns(player, arg) then
			deps.Notify(player, "You don't own that Orb.")
			return
		end
		local free = p.FreePicksUsed < SEL.FreeCollectionPicksPerMatch
		if not free and not deps.EconomyService.TrySpend(player, "Gems", SEL.ExtraCollectionPickCost) then
			deps.Notify(player, string.format("Collection picks cost %d Gems after your free one.", SEL.ExtraCollectionPickCost))
			return
		end
		p.FreePicksUsed += 1
		p.Selected = arg
		p.Picked = true
		self:_sendSelection(p)
		self:_public("Selection")
		if allPicked(self) then
			self.Deadline = math.min(self.Deadline, now() + T.SelectionGrace)
		end
	end
end

local function wrapAngle(a: number): number
	return math.atan2(math.sin(a), math.cos(a))
end

function Match.HandleAim(self: Match, player: Player, angle: any, lock: boolean)
	if self.State ~= "AimPhase" then
		return
	end
	local p = self:ParticipantOf(player)
	if p == nil or p.Locked or not Validate.Number(angle, -100, 100) then
		return
	end
	p.Aim = wrapAngle(angle)
	if lock then
		p.Locked = true
		self:_public("AimLock", { UserId = p.UserId })
		if allLocked(self) then
			self.Deadline = math.min(self.Deadline, now() + 0.6)
		end
	end
end

function Match.OnPlayerLeft(self: Match, player: Player)
	local p = self:ParticipantOf(player)
	if p == nil then
		return
	end
	p.Connected = false
	p.Player = nil
	if self.Closed or self.State == "MatchVictory" then
		return
	end
	local humansLeft = { 0, 0 }
	for _, other in self.Participants do
		if other.Connected and not other.IsBot then
			humansLeft[other.Team] += 1
		end
	end
	if humansLeft[1] + humansLeft[2] == 0 then
		self:_enter("Closed")
		return
	end
	if humansLeft[p.Team] == 0 then
		-- whole team gone: the other side wins by forfeit
		if self.World then
			(self.World :: World.World):Finish()
			self.Deps.Replicator.SendEvents(self.Station, { { t = "Clear" } })
			self.World = nil
		end
		self.Forfeit = true
		self.WinnerTeam = if p.Team == 1 then 2 else 1
		self:_enter("MatchVictory")
	else
		self:_public("Update")
	end
end

return Match
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[--!strict
-- Types shared by the battle simulation, the ability modules and the match controller.
export type Status = {
	frozen: number,
	snared: number,
	slowed: number,
	slowFactor: number,
	phased: number,
	charging: number,
	latched: number,
	invuln: number,
}

export type Ball = {
	id: number,
	defId: string,
	def: any, -- BallDefinition (kept loose so headless tests can stub definitions)
	owner: number, -- userId (negative for bots)
	team: number,
	isMinion: boolean,
	x: number,
	y: number,
	vx: number,
	vy: number,
	r: number,
	baseR: number,
	mass: number,
	hp: number,
	maxHp: number,
	contact: number,
	speedMult: number,
	gravityScale: number,
	alive: boolean,
	launched: boolean,
	status: Status,
	frozenVuln: number,
	dmgTakenMult: number,
	dmgDealtMult: number,
	ability: Ability?,
	params: { [string]: any },
	state: { [string]: any },
	attrition: number,
	damageDealt: number,
	lastAttacker: number?,
}

export type Entity = {
	id: number,
	kind: string,
	shape: "circle" | "segment" | "none",
	x: number,
	y: number,
	x2: number,
	y2: number,
	r: number,
	vx: number,
	vy: number,
	rot: number,
	scale: number,
	owner: Ball?,
	team: number,
	life: number,
	age: number,
	armed: number,
	dynamic: boolean,
	gravity: number,
	dieOnWall: boolean,
	pierce: boolean,
	damage: number,
	damageKind: string,
	hitCooldown: number,
	hits: { [number]: number },
	persist: boolean,
	removed: boolean,
	data: { [string]: any },
	visual: { [string]: any },
	onHit: ((ctx: any, e: Entity, ball: Ball) -> ())?,
	onUpdate: ((ctx: any, e: Entity, dt: number) -> ())?,
	onExpire: ((ctx: any, e: Entity) -> ())?,
	onWall: ((ctx: any, e: Entity) -> ())?,
}

export type EntitySpec = {
	kind: string,
	shape: ("circle" | "segment" | "none")?,
	x: number,
	y: number,
	x2: number?,
	y2: number?,
	r: number?,
	vx: number?,
	vy: number?,
	rot: number?,
	scale: number?,
	owner: Ball?,
	team: number?,
	life: number?,
	armed: number?,
	dynamic: boolean?,
	gravity: number?,
	dieOnWall: boolean?,
	pierce: boolean?,
	damage: number?,
	damageKind: string?,
	hitCooldown: number?,
	persist: boolean?,
	data: { [string]: any }?,
	visual: { [string]: any }?,
	onHit: ((ctx: any, e: Entity, ball: Ball) -> ())?,
	onUpdate: ((ctx: any, e: Entity, dt: number) -> ())?,
	onExpire: ((ctx: any, e: Entity) -> ())?,
	onWall: ((ctx: any, e: Entity) -> ())?,
}

export type DamageInfo = {
	source: Ball?,
	kind: string, -- "contact" | "hazard" | "ability" | "overtime" | "drain"
	entity: Entity?,
	ignorePhase: boolean?,
	x: number?,
	y: number?,
}

-- Ability hooks. Every hook is optional. `ctx` is the World (see World.luau public helpers).
export type Ability = {
	Init: ((ctx: any, ball: Ball, params: { [string]: any }) -> ())?,
	OnLaunch: ((ctx: any, ball: Ball, params: { [string]: any }) -> ())?,
	OnTick: ((ctx: any, ball: Ball, params: { [string]: any }, dt: number) -> ())?,
	OnWallHit: ((ctx: any, ball: Ball, params: { [string]: any }, nx: number, ny: number, px: number, py: number) -> ())?,
	OnBallHit: ((ctx: any, ball: Ball, params: { [string]: any }, other: Ball, cx: number, cy: number) -> ())?,
	ModifyContact: ((ctx: any, ball: Ball, params: { [string]: any }, other: Ball, damage: number) -> number)?,
	OnDamageTaken: ((ctx: any, ball: Ball, params: { [string]: any }, amount: number, info: DamageInfo) -> number)?,
	OnDamageDealt: ((ctx: any, ball: Ball, params: { [string]: any }, target: Ball, amount: number, info: DamageInfo) -> ())?,
	OnHealthChanged: ((ctx: any, ball: Ball, params: { [string]: any }, old: number, new: number) -> ())?,
	OnDeath: ((ctx: any, ball: Ball, params: { [string]: any }, killer: Ball?) -> boolean?)?,
	OnKill: ((ctx: any, ball: Ball, params: { [string]: any }, victim: Ball) -> ())?,
}

export type BattleEvent = { [string]: any }

export type Result = { state: "ongoing" } | { state: "win", team: number } | { state: "draw" }

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic 2D battle simulation (server authoritative).
--
-- * Fixed time step (Physics.TickRate). Same seed + same inputs = same battle.
-- * No Roblox physics: results do not depend on ping or network ownership.
-- * Pure Luau apart from module lookups: runs headlessly in tests/ with the Luau CLI.
--
-- The World doubles as the AbilityContext: ability modules receive it as `ctx` and must only
-- use the helpers in the "Ability API" section.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PhysicsConfig = require(Shared.Config.Physics)
local Rng = require(Shared.Util.Rng)
local SnapshotCodec = require(Shared.Net.SnapshotCodec)

local Types = require(script.Parent.Types)
local Damage = require(script.Parent.Damage)

type Ball = Types.Ball
type Entity = Types.Entity
type EntitySpec = Types.EntitySpec
type DamageInfo = Types.DamageInfo
type Ability = Types.Ability
type BattleEvent = Types.BattleEvent
type Result = Types.Result

export type WorldOptions = {
	seed: number,
	half: number,
	resolveAbility: (abilityId: string) -> Ability?,
	resolveDefinition: (defId: string) -> any,
	friendlyFire: boolean?,
	physics: { [string]: any }?,
	onError: ((message: string) -> ())?,
}

local World = {}
World.__index = World

export type World = typeof(setmetatable(
	{} :: {
		time: number,
		launchTime: number?,
		half: number,
		rng: Rng.Rng,
		physics: { [string]: any },
		balls: { Ball },
		ballsById: { [number]: Ball },
		entities: { Entity },
		entitiesById: { [number]: Entity },
		events: { BattleEvent },
		nextBallId: number,
		nextEntityId: number,
		pairCooldown: { [number]: number },
		friendlyFire: boolean,
		damageMult: number,
		overtimeLevel: number,
		resolveAbility: (string) -> Ability?,
		resolveDefinition: (string) -> any,
		onError: (string) -> (),
		accumulator: number,
		finished: boolean,
		_erroredHooks: { [string]: boolean },
	},
	World
))

local function newStatus(): Types.Status
	return {
		frozen = 0,
		snared = 0,
		slowed = 0,
		slowFactor = 1,
		phased = 0,
		charging = 0,
		latched = 0,
		invuln = 0,
	}
end

function World.new(opts: WorldOptions): World
	local physics = table.clone(PhysicsConfig) :: { [string]: any }
	if opts.physics then
		for k, v in opts.physics do
			physics[k] = v
		end
	end
	local self = setmetatable({
		time = 0,
		launchTime = nil,
		half = opts.half,
		rng = Rng.new(opts.seed),
		physics = physics,
		balls = {},
		ballsById = {},
		entities = {},
		entitiesById = {},
		events = {},
		nextBallId = 1,
		nextEntityId = 1,
		pairCooldown = {},
		friendlyFire = opts.friendlyFire == true,
		damageMult = 1,
		overtimeLevel = 0,
		resolveAbility = opts.resolveAbility,
		resolveDefinition = opts.resolveDefinition,
		onError = opts.onError or function(message: string)
			warn(message)
		end,
		accumulator = 0,
		finished = false,
		_erroredHooks = {},
	}, World)
	return self
end

---------------------------------------------------------------------------------------------
-- Hooks

function World._call(self: World, ball: Ball, hook: string, ...: any): (boolean, any)
	local ability = ball.ability
	if ability == nil then
		return false, nil
	end
	local fn = (ability :: any)[hook]
	if fn == nil then
		return false, nil
	end
	local ok, result = pcall(fn, self, ball, ball.params, ...)
	if not ok then
		local key = ball.defId .. ":" .. hook
		if not self._erroredHooks[key] then
			self._erroredHooks[key] = true
			self.onError(string.format("[Battle] ability %s.%s failed: %s", ball.defId, hook, tostring(result)))
		end
		return false, nil
	end
	return true, result
end

---------------------------------------------------------------------------------------------
-- Balls

export type BallSpec = {
	defId: string,
	owner: number,
	team: number,
	x: number,
	y: number,
	isMinion: boolean?,
	radius: number?,
	hp: number?,
	contact: number?,
	noAbility: boolean?,
}

function World.SpawnBall(self: World, spec: BallSpec): Ball
	local def = self.resolveDefinition(spec.defId)
	assert(def ~= nil, "unknown ball definition " .. tostring(spec.defId))
	local id = self.nextBallId
	self.nextBallId += 1
	local radius = spec.radius or def.Radius
	local hp = spec.hp or def.BaseHP
	local ability: Ability? = nil
	if not spec.noAbility and def.AbilityId then
		ability = self.resolveAbility(def.AbilityId)
	end
	local ball: Ball = {
		id = id,
		defId = def.Id,
		def = def,
		owner = spec.owner,
		team = spec.team,
		isMinion = spec.isMinion == true,
		x = spec.x,
		y = spec.y,
		vx = 0,
		vy = 0,
		r = radius,
		baseR = radius,
		mass = def.Mass * (radius / def.Radius) ^ 2,
		hp = hp,
		maxHp = hp,
		contact = spec.contact or def.ContactDamage,
		speedMult = 1,
		gravityScale = 1,
		alive = true,
		launched = false,
		status = newStatus(),
		frozenVuln = 0,
		dmgTakenMult = 1,
		dmgDealtMult = 1,
		ability = ability,
		params = def.AbilityParams or {},
		state = {},
		attrition = 0,
		damageDealt = 0,
		lastAttacker = nil,
	}
	table.insert(self.balls, ball)
	self.ballsById[id] = ball
	self:Emit({
		t = "BallSpawn",
		id = id,
		def = def.Id,
		team = ball.team,
		owner = ball.owner,
		x = ball.x,
		y = ball.y,
		r = ball.r,
		hp = ball.hp,
		maxHp = ball.maxHp,
		minion = ball.isMinion,
	})
	self:_call(ball, "Init")
	return ball
end

function World.Launch(self: World, ballId: number, angle: number, speedOverride: number?)
	local ball = self.ballsById[ballId]
	if ball == nil or not ball.alive or ball.launched then
		return
	end
	local speed = speedOverride or self.physics.CruiseSpeed * ball.def.Speed
	ball.vx = math.cos(angle) * speed
	ball.vy = math.sin(angle) * speed
	ball.launched = true
	ball.status.invuln = self.physics.SpawnImmunity
	if self.launchTime == nil then
		self.launchTime = self.time
	end
	self:Emit({ t = "Launch", id = ballId, angle = angle })
	self:_call(ball, "OnLaunch")
end

---------------------------------------------------------------------------------------------
-- Ability API (ctx helpers)

function World.Emit(self: World, event: BattleEvent)
	table.insert(self.events, event)
end

function World.Fx(self: World, kind: string, data: { [string]: any })
	local event = table.clone(data)
	event.t = "Fx"
	event.kind = kind
	self:Emit(event)
end

function World.Now(self: World): number
	return self.time
end

function World.BattleTime(self: World): number
	return if self.launchTime then self.time - self.launchTime else 0
end

function World.Half(self: World): number
	return self.half
end

function World.Random(self: World): Rng.Rng
	return self.rng
end

function World.IsEnemy(self: World, a: Ball, b: Ball): boolean
	return a.team ~= b.team
end

function World.Enemies(self: World, ball: Ball): { Ball }
	local out = {}
	for _, other in self.balls do
		if other.alive and other.team ~= ball.team then
			table.insert(out, other)
		end
	end
	return out
end

function World.Nearest(self: World, ball: Ball, includePhased: boolean?): Ball?
	local best: Ball? = nil
	local bestDist = math.huge
	for _, other in self.balls do
		if other.alive and other.team ~= ball.team and (includePhased or other.status.phased <= 0) then
			local d = (other.x - ball.x) ^ 2 + (other.y - ball.y) ^ 2
			if d < bestDist then
				bestDist = d
				best = other
			end
		end
	end
	return best
end

function World.Damage(self: World, target: Ball, amount: number, info: DamageInfo): number
	return Damage.Apply(self, target, amount, info)
end

function World.Heal(self: World, ball: Ball, amount: number)
	if not ball.alive or amount <= 0 then
		return
	end
	local old = ball.hp
	ball.hp = math.min(ball.maxHp, ball.hp + amount)
	local healed = ball.hp - old
	if healed > 0 then
		self:Emit({ t = "Heal", id = ball.id, amount = healed })
		self:_call(ball, "OnHealthChanged", old, ball.hp)
	end
end

function World.SetStatus(self: World, ball: Ball, status: string, duration: number, extra: { [string]: any }?)
	local st = ball.status :: any
	if st[status] == nil then
		return
	end
	st[status] = math.max(st[status], duration)
	if status == "slowed" and extra and extra.factor then
		ball.status.slowFactor = math.min(ball.status.slowFactor, extra.factor)
	end
	self:Emit({ t = "Status", id = ball.id, status = status, duration = duration })
end

function World.SetVelocity(self: World, ball: Ball, vx: number, vy: number)
	ball.vx = vx
	ball.vy = vy
end

function World.Spawn(self: World, spec: EntitySpec): Entity?
	local live = 0
	for _, e in self.entities do
		if not e.removed then
			live += 1
		end
	end
	if live >= self.physics.MaxEntities then
		return nil
	end
	local id = self.nextEntityId
	self.nextEntityId = (self.nextEntityId % 65000) + 1
	local owner = spec.owner
	local e: Entity = {
		id = id,
		kind = spec.kind,
		shape = spec.shape or "circle",
		x = spec.x,
		y = spec.y,
		x2 = spec.x2 or spec.x,
		y2 = spec.y2 or spec.y,
		r = spec.r or 0.5,
		vx = spec.vx or 0,
		vy = spec.vy or 0,
		rot = spec.rot or 0,
		scale = spec.scale or 1,
		owner = owner,
		team = spec.team or (if owner then owner.team else 0),
		life = spec.life or math.huge,
		age = 0,
		armed = spec.armed or 0,
		dynamic = spec.dynamic == true,
		gravity = spec.gravity or 0,
		dieOnWall = spec.dieOnWall == true,
		pierce = spec.pierce == true,
		damage = spec.damage or 0,
		damageKind = spec.damageKind or "hazard",
		hitCooldown = spec.hitCooldown or 0.5,
		hits = {},
		persist = spec.persist == true,
		removed = false,
		data = spec.data or {},
		visual = spec.visual or {},
		onHit = spec.onHit,
		onUpdate = spec.onUpdate,
		onExpire = spec.onExpire,
		onWall = spec.onWall,
	}
	table.insert(self.entities, e)
	self.entitiesById[id] = e
	self:Emit({
		t = "EntitySpawn",
		id = id,
		kind = e.kind,
		shape = e.shape,
		x = e.x,
		y = e.y,
		x2 = e.x2,
		y2 = e.y2,
		r = e.r,
		rot = e.rot,
		scale = e.scale,
		team = e.team,
		owner = if owner then owner.id else nil,
		life = if e.life == math.huge then -1 else e.life,
		armed = e.armed,
		dynamic = e.dynamic,
		visual = e.visual,
	})
	return e
end

function World.Remove(self: World, e: Entity, reason: string?)
	if e.removed then
		return
	end
	e.removed = true
	self.entitiesById[e.id] = nil
	self:Emit({ t = "EntityRemove", id = e.id, reason = reason or "expire" })
end

-- Notify clients that a static entity moved/changed (rare; e.g. a rail train starting).
function World.UpdateEntity(self: World, e: Entity, fields: { [string]: any })
	local event = table.clone(fields)
	event.t = "EntityUpdate"
	event.id = e.id
	self:Emit(event)
end

function World.EntitiesOf(self: World, owner: Ball, kind: string?): { Entity }
	local out = {}
	for _, e in self.entities do
		if not e.removed and e.owner == owner and (kind == nil or e.kind == kind) then
			table.insert(out, e)
		end
	end
	return out
end

-- Distance from a point to a segment (used for beams, rails, trails, thorns).
function World.PointSegmentDistance(px: number, py: number, ax: number, ay: number, bx: number, by: number): number
	local dx, dy = bx - ax, by - ay
	local lenSq = dx * dx + dy * dy
	local t = 0
	if lenSq > 1e-9 then
		t = math.clamp(((px - ax) * dx + (py - ay) * dy) / lenSq, 0, 1)
	end
	local cx, cy = ax + dx * t, ay + dy * t
	return math.sqrt((px - cx) ^ 2 + (py - cy) ^ 2)
end

function World.EntityTouches(self: World, e: Entity, ball: Ball): boolean
	if e.shape == "circle" then
		local reach = e.r * e.scale + ball.r
		return (ball.x - e.x) ^ 2 + (ball.y - e.y) ^ 2 < reach * reach
	elseif e.shape == "segment" then
		return World.PointSegmentDistance(ball.x, ball.y, e.x, e.y, e.x2, e.y2) < e.r + ball.r
	end
	return false
end

function World.SpawnMinion(self: World, parent: Ball, x: number, y: number, vx: number, vy: number, radius: number, hp: number, contact: number): Ball
	local h = self.half
	local minion = self:SpawnBall({
		defId = parent.defId,
		owner = parent.owner,
		team = parent.team,
		x = math.clamp(x, -h + radius, h - radius),
		y = math.clamp(y, -h + radius, h - radius),
		isMinion = true,
		radius = radius,
		hp = hp,
		contact = contact,
		noAbility = true,
	})
	minion.launched = true
	minion.vx = vx
	minion.vy = vy
	minion.status.invuln = 0.3
	return minion
end

---------------------------------------------------------------------------------------------
-- Death

function World.Kill(self: World, ball: Ball, killer: Ball?)
	if not ball.alive then
		return
	end
	local handled, prevent = self:_call(ball, "OnDeath", killer)
	if handled and prevent == true and ball.hp > 0 then
		return
	end
	ball.alive = false
	ball.hp = 0
	self:Emit({
		t = "Death",
		id = ball.id,
		killer = if killer then killer.id else nil,
		x = ball.x,
		y = ball.y,
		minion = ball.isMinion,
	})
	for _, e in self.entities do
		if not e.removed and e.owner == ball and not e.persist then
			self:Remove(e, "owner")
		end
	end
	if killer and killer.alive then
		self:_call(killer, "OnKill", ball)
	end
end

---------------------------------------------------------------------------------------------
-- Simulation step

local function rotate(vx: number, vy: number, angle: number): (number, number)
	local c, s = math.cos(angle), math.sin(angle)
	return vx * c - vy * s, vx * s + vy * c
end

function World._wallHit(self: World, ball: Ball, nx: number, ny: number, px: number, py: number)
	local jitter = math.rad(self.physics.WallJitterDegrees)
	if jitter > 0 then
		local vx, vy = rotate(ball.vx, ball.vy, self.rng:Range(-jitter, jitter))
		-- never jitter back into the wall
		if vx * nx + vy * ny > 0 then
			ball.vx, ball.vy = vx, vy
		end
	end
	self:Emit({ t = "Wall", id = ball.id, x = px, y = py, nx = nx, ny = ny })
	self:_call(ball, "OnWallHit", nx, ny, px, py)
end

function World._moveBall(self: World, ball: Ball, dt: number)
	local st = ball.status
	if st.frozen > 0 or st.snared > 0 then
		return
	end
	local P = self.physics
	local g = P.Gravity * ball.gravityScale
	if st.charging > 0 then
		g = 0
	end
	ball.vy -= g * dt
	local slow = if st.slowed > 0 then st.slowFactor else 1
	ball.x += ball.vx * dt * slow
	ball.y += ball.vy * dt * slow

	local h = self.half
	local r = ball.r
	local e = P.WallRestitution
	if ball.x - r < -h then
		ball.x = -h + r
		if ball.vx < 0 then
			ball.vx = -ball.vx * e
			self:_wallHit(ball, 1, 0, -h, ball.y)
		end
	elseif ball.x + r > h then
		ball.x = h - r
		if ball.vx > 0 then
			ball.vx = -ball.vx * e
			self:_wallHit(ball, -1, 0, h, ball.y)
		end
	end
	if ball.y - r < -h then
		ball.y = -h + r
		if ball.vy < 0 then
			ball.vy = -ball.vy * e
			self:_wallHit(ball, 0, 1, ball.x, -h)
		end
	elseif ball.y + r > h then
		ball.y = h - r
		if ball.vy > 0 then
			ball.vy = -ball.vy * e
			self:_wallHit(ball, 0, -1, ball.x, h)
		end
	end
end

-- Restores each ball's mechanical energy toward its cruise energy so fights stay lively
-- without ever looking like constant-speed billiards.
function World._govern(self: World, ball: Ball, dt: number)
	local st = ball.status
	if st.frozen > 0 or st.snared > 0 or st.charging > 0 then
		return
	end
	local P = self.physics
	local g = P.Gravity * ball.gravityScale
	local h = self.half
	local target = P.CruiseSpeed * ball.def.Speed * ball.speedMult
	local height = ball.y + h
	local energy = 0.5 * (ball.vx * ball.vx + ball.vy * ball.vy) + g * height
	local targetEnergy = 0.5 * target * target + g * h
	local newEnergy = energy + (targetEnergy - energy) * math.min(1, P.GovernorRate * dt)
	local kinetic = math.max(newEnergy - g * height, 0.5 * P.MinSpeed * P.MinSpeed)
	local speed = math.min(math.sqrt(2 * kinetic), P.MaxSpeed)
	local current = math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy)
	if current < 1e-4 then
		local angle = self.rng:Range(0, 2 * math.pi)
		ball.vx, ball.vy = math.cos(angle) * speed, math.sin(angle) * speed
	else
		local k = speed / current
		ball.vx *= k
		ball.vy *= k
	end
end

local function immobile(ball: Ball): boolean
	return ball.status.frozen > 0 or ball.status.snared > 0
end

function World._collidePair(self: World, a: Ball, b: Ball)
	local dx, dy = b.x - a.x, b.y - a.y
	local distSq = dx * dx + dy * dy
	local minDist = a.r + b.r
	if distSq >= minDist * minDist then
		return
	end
	local dist = math.sqrt(distSq)
	local nx, ny = 1, 0
	if dist > 1e-6 then
		nx, ny = dx / dist, dy / dist
	end
	local overlap = minDist - dist
	local aFixed, bFixed = immobile(a), immobile(b)

	-- positional correction
	if aFixed and not bFixed then
		b.x += nx * overlap
		b.y += ny * overlap
	elseif bFixed and not aFixed then
		a.x -= nx * overlap
		a.y -= ny * overlap
	else
		local total = a.mass + b.mass
		a.x -= nx * overlap * (b.mass / total)
		a.y -= ny * overlap * (b.mass / total)
		b.x += nx * overlap * (a.mass / total)
		b.y += ny * overlap * (a.mass / total)
	end

	-- velocity response
	local e = self.physics.BallRestitution
	local rel = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny
	if rel < 0 then
		if aFixed and not bFixed then
			local vn = b.vx * nx + b.vy * ny
			b.vx -= (1 + e) * vn * nx
			b.vy -= (1 + e) * vn * ny
		elseif bFixed and not aFixed then
			local vn = a.vx * nx + a.vy * ny
			a.vx -= (1 + e) * vn * nx
			a.vy -= (1 + e) * vn * ny
		elseif not aFixed and not bFixed then
			local j = -(1 + e) * rel / (1 / a.mass + 1 / b.mass)
			a.vx -= (j / a.mass) * nx
			a.vy -= (j / a.mass) * ny
			b.vx += (j / b.mass) * nx
			b.vy += (j / b.mass) * ny
		end
	end

	-- contact damage (pair cooldown)
	local key = math.min(a.id, b.id) * 1024 + math.max(a.id, b.id)
	local last = self.pairCooldown[key]
	if last ~= nil and self.time - last < self.physics.ContactCooldown then
		return
	end
	self.pairCooldown[key] = self.time
	local cx, cy = a.x + nx * a.r, a.y + ny * a.r
	local enemies = a.team ~= b.team or self.friendlyFire
	if not enemies then
		self:Emit({ t = "Hit", a = a.id, b = b.id, x = cx, y = cy, friendly = true })
		return
	end

	local dmgAB = a.contact
	local okA, modA = self:_call(a, "ModifyContact", b, dmgAB)
	if okA and type(modA) == "number" then
		dmgAB = modA
	end
	local dmgBA = b.contact
	local okB, modB = self:_call(b, "ModifyContact", a, dmgBA)
	if okB and type(modB) == "number" then
		dmgBA = modB
	end

	self:_call(a, "OnBallHit", b, cx, cy)
	self:_call(b, "OnBallHit", a, cx, cy)

	local dealtAB = if a.alive and b.alive then Damage.Apply(self, b, dmgAB, { source = a, kind = "contact", x = cx, y = cy }) else 0
	local dealtBA = if a.alive and b.alive then Damage.Apply(self, a, dmgBA, { source = b, kind = "contact", x = cx, y = cy }) else 0
	self:Emit({
		t = "Hit",
		a = a.id,
		b = b.id,
		x = cx,
		y = cy,
		nx = nx,
		ny = ny,
		dab = dealtAB,
		dba = dealtBA,
		heavy = math.max(dealtAB, dealtBA) >= 10,
	})
end

function World._updateEntities(self: World, dt: number)
	local h = self.half
	local count = #self.entities
	for i = 1, count do
		local e = self.entities[i]
		if e.removed then
			continue
		end
		e.age += dt
		e.life -= dt
		e.armed -= dt
		if e.onUpdate then
			local ok, err = pcall(e.onUpdate :: any, self, e, dt)
			if not ok then
				self.onError("[Battle] entity update failed: " .. tostring(err))
				self:Remove(e, "error")
				continue
			end
		elseif e.dynamic then
			e.vy -= e.gravity * dt
			e.x += e.vx * dt
			e.y += e.vy * dt
			if e.vx ~= 0 or e.vy ~= 0 then
				e.rot = math.atan2(e.vy, e.vx)
			end
		end
		if e.removed then
			continue
		end
		if e.dieOnWall and (math.abs(e.x) > h - e.r * 0.5 or math.abs(e.y) > h - e.r * 0.5) then
			if e.onWall then
				pcall(e.onWall, self, e)
			end
			self:Remove(e, "wall")
			continue
		end
		if e.life <= 0 then
			if e.onExpire then
				pcall(e.onExpire, self, e)
			end
			self:Remove(e, "expire")
			continue
		end
		if e.armed > 0 or (e.damage <= 0 and e.onHit == nil) or e.shape == "none" then
			continue
		end
		for _, ball in self.balls do
			if not ball.alive or not ball.launched or ball.team == e.team then
				continue
			end
			if ball.status.phased > 0 then
				continue
			end
			if not self:EntityTouches(e, ball) then
				continue
			end
			local last = e.hits[ball.id]
			if last ~= nil and self.time - last < e.hitCooldown then
				continue
			end
			e.hits[ball.id] = self.time
			if e.onHit then
				local ok, err = pcall(e.onHit :: any, self, e, ball)
				if not ok then
					self.onError("[Battle] entity hit failed: " .. tostring(err))
				end
			else
				Damage.Apply(self, ball, e.damage, { source = e.owner, kind = e.damageKind, entity = e, x = ball.x, y = ball.y })
			end
			if not e.pierce then
				self:Remove(e, "hit")
				break
			end
			if e.removed then
				break
			end
		end
	end
	-- compact removed entities
	if count > 0 then
		local kept = {}
		for _, e in self.entities do
			if not e.removed then
				table.insert(kept, e)
			end
		end
		self.entities = kept
	end
end

function World._overtime(self: World, dt: number)
	local P = self.physics
	local t = self:BattleTime()
	if t < P.OvertimeStart then
		return
	end
	local level = 1 + math.floor((t - P.OvertimeStart) / P.OvertimeStep)
	if level ~= self.overtimeLevel then
		self.overtimeLevel = level
		self.damageMult = 1 + level * P.OvertimeDamageBonus
		self:Emit({ t = "Overtime", level = level, mult = self.damageMult })
	end
	for _, ball in self.balls do
		if ball.alive and ball.launched then
			ball.attrition += P.OvertimeAttrition * dt
			if ball.attrition >= 1 then
				local chunk = math.floor(ball.attrition)
				ball.attrition -= chunk
				Damage.Apply(self, ball, chunk, { kind = "overtime", ignorePhase = true })
			end
		end
	end
end

function World.Step(self: World, dt: number)
	if self.finished then
		return
	end
	self.time += dt

	-- statuses + ability ticks
	for _, ball in self.balls do
		if not ball.alive then
			continue
		end
		local st = ball.status
		st.frozen = math.max(0, st.frozen - dt)
		st.snared = math.max(0, st.snared - dt)
		st.phased = math.max(0, st.phased - dt)
		st.charging = math.max(0, st.charging - dt)
		st.latched = math.max(0, st.latched - dt)
		st.invuln = math.max(0, st.invuln - dt)
		if st.slowed > 0 then
			st.slowed = math.max(0, st.slowed - dt)
			if st.slowed <= 0 then
				st.slowFactor = 1
			end
		end
		if ball.launched then
			self:_call(ball, "OnTick", dt)
		end
	end

	-- movement + walls
	for _, ball in self.balls do
		if ball.alive and ball.launched then
			self:_moveBall(ball, dt)
		end
	end

	-- ball vs ball
	local n = #self.balls
	for i = 1, n - 1 do
		local a = self.balls[i]
		if not a.alive or not a.launched or a.status.phased > 0 then
			continue
		end
		for j = i + 1, n do
			local b = self.balls[j]
			if b.alive and b.launched and b.status.phased <= 0 and a.alive then
				self:_collidePair(a, b)
			end
		end
	end

	-- keep everything inside after pushes
	local h = self.half
	for _, ball in self.balls do
		if ball.alive then
			ball.x = math.clamp(ball.x, -h + ball.r, h - ball.r)
			ball.y = math.clamp(ball.y, -h + ball.r, h - ball.r)
		end
	end

	-- governor
	for _, ball in self.balls do
		if ball.alive and ball.launched then
			self:_govern(ball, dt)
		end
	end

	self:_updateEntities(dt)
	if self.launchTime ~= nil then
		self:_overtime(dt)
	end
end

-- Advance by real time using the fixed step. Returns number of steps taken.
function World.Advance(self: World, dt: number): number
	local step = 1 / self.physics.TickRate
	self.accumulator = math.min(self.accumulator + dt, step * 8)
	local steps = 0
	while self.accumulator >= step do
		self.accumulator -= step
		self:Step(step)
		steps += 1
		if self:GetResult().state ~= "ongoing" then
			self.accumulator = 0
			break
		end
	end
	return steps
end

function World.GetResult(self: World): Result
	if self.launchTime == nil then
		return { state = "ongoing" }
	end
	local teamsAlive: { [number]: boolean } = {}
	local aliveCount = 0
	for _, ball in self.balls do
		if ball.alive and not teamsAlive[ball.team] then
			teamsAlive[ball.team] = true
			aliveCount += 1
		end
	end
	if aliveCount == 0 then
		return { state = "draw" }
	elseif aliveCount == 1 then
		local team = next(teamsAlive)
		return { state = "win", team = team :: number }
	end
	if self:BattleTime() >= self.physics.RoundHardCap then
		-- hard cap: highest remaining HP fraction wins
		local hp: { [number]: number } = {}
		local maxHp: { [number]: number } = {}
		for _, ball in self.balls do
			if not ball.isMinion then
				maxHp[ball.team] = (maxHp[ball.team] or 0) + ball.maxHp
			end
			if ball.alive then
				hp[ball.team] = (hp[ball.team] or 0) + ball.hp
			end
		end
		local bestTeam, bestFrac, tie = nil, -1, false
		for team, total in maxHp do
			local frac = (hp[team] or 0) / math.max(total, 1)
			if frac > bestFrac + 1e-6 then
				bestTeam, bestFrac, tie = team, frac, false
			elseif math.abs(frac - bestFrac) <= 1e-6 then
				tie = true
			end
		end
		if tie or bestTeam == nil then
			return { state = "draw" }
		end
		return { state = "win", team = bestTeam }
	end
	return { state = "ongoing" }
end

function World.Finish(self: World)
	self.finished = true
end

function World.DrainEvents(self: World): { BattleEvent }
	local events = self.events
	self.events = {}
	return events
end

---------------------------------------------------------------------------------------------
-- Replication helpers

local Flags = SnapshotCodec.Flags

function World.BallFlags(ball: Ball): number
	local st = ball.status
	local f = 0
	if st.frozen > 0 then
		f += Flags.Frozen
	end
	if st.snared > 0 then
		f += Flags.Snared
	end
	if st.phased > 0 then
		f += Flags.Phased
	end
	if st.slowed > 0 then
		f += Flags.Slowed
	end
	if st.charging > 0 then
		f += Flags.Charging
	end
	if st.latched > 0 then
		f += Flags.Latched
	end
	if st.invuln > 0 then
		f += Flags.Invulnerable
	end
	if not ball.alive then
		f += Flags.Dead
	end
	return f
end

function World.Snapshot(self: World, station: number, seq: number): SnapshotCodec.Snapshot
	local balls = {}
	for _, ball in self.balls do
		if ball.alive then
			table.insert(balls, {
				id = ball.id,
				x = ball.x,
				y = ball.y,
				hp = ball.hp,
				r = ball.r,
				flags = World.BallFlags(ball),
			})
		end
	end
	local entities = {}
	local limit = self.physics.MaxSnapshotEntities
	for _, e in self.entities do
		if e.dynamic and not e.removed then
			table.insert(entities, { id = e.id, x = e.x, y = e.y, rot = e.rot, scale = e.scale })
			if #entities >= limit then
				break
			end
		end
	end
	return { station = station, seq = seq, time = self.time, balls = balls, entities = entities }
end

-- Full state for spectators who arrive mid-round.
function World.FullState(self: World): { [string]: any }
	local balls = {}
	for _, ball in self.balls do
		if ball.alive then
			table.insert(balls, {
				id = ball.id,
				def = ball.defId,
				team = ball.team,
				owner = ball.owner,
				x = ball.x,
				y = ball.y,
				r = ball.r,
				hp = ball.hp,
				maxHp = ball.maxHp,
				minion = ball.isMinion,
				launched = ball.launched,
			})
		end
	end
	local entities = {}
	for _, e in self.entities do
		if not e.removed then
			table.insert(entities, {
				id = e.id,
				kind = e.kind,
				shape = e.shape,
				x = e.x,
				y = e.y,
				x2 = e.x2,
				y2 = e.y2,
				r = e.r,
				rot = e.rot,
				scale = e.scale,
				team = e.team,
				owner = if e.owner then e.owner.id else nil,
				life = if e.life == math.huge then -1 else e.life,
				armed = e.armed,
				dynamic = e.dynamic,
				visual = e.visual,
			})
		end
	end
	return { time = self.time, balls = balls, entities = entities }
end

return World
]]></string>
