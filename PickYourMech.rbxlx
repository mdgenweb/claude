  <Item class="SoundService" referent="31">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="32">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">140</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="33">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="35">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">AutoFarm</string>
              <string name="Source"><![CDATA[-- Auto Farm pass: walks the mech to the next junk inside the player's own lane and
-- unlocked yard (via the shared corridor), then lets the free auto-hit do the work.
-- Moving the stick / WASD pauses it briefly so the player is always in control.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Signal = require(Shared.Signal)

local Net = require(script.Parent.Parent.Net)

local AutoFarm = {}

AutoFarm.enabled = false
AutoFarm.Changed = Signal.new()

local player = Players.LocalPlayer
local controls = nil
local pausedUntil = 0
local menuOpen = false

local function getControls()
	if controls == nil then
		local ok, module = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
		end)
		controls = if ok then module else false
	end
	return controls or nil
end

local function manualInput(): boolean
	local c = getControls()
	if not c then
		return false
	end
	local ok, vector = pcall(function()
		return c:GetMoveVector()
	end)
	return ok and vector.Magnitude > 0.1
end

local function stop(humanoid: Humanoid?)
	if humanoid then
		humanoid:Move(Vector3.zero)
	end
end

function AutoFarm.toggle(force: boolean?)
	local on = if force ~= nil then force else not AutoFarm.enabled
	if on and not player:GetAttribute("HasAutoFarm") then
		on = false
	end
	if on == AutoFarm.enabled then
		return
	end
	AutoFarm.enabled = on
	if not on then
		local character = player.Character
		stop(character and character:FindFirstChildOfClass("Humanoid"))
	end
	AutoFarm.Changed:Fire(on)
end

local function laneTargets(lane: number, area: number): { Model }
	local world = Workspace:FindFirstChild("World")
	local folder = world and world:FindFirstChild("Targets")
	local laneFolder = folder and folder:FindFirstChild("Lane" .. lane)
	local out = {}
	if laneFolder then
		for _, model in laneFolder:GetChildren() do
			if
				model:IsA("Model")
				and model:GetAttribute("Area") == area
				and not model:GetAttribute("Dead")
				and model.PrimaryPart
			then
				table.insert(out, model)
			end
		end
	end
	return out
end

local function chooseArea(position: Vector3): number
	local here = Layout.areaAt(position)
	if here and Net.unlocked(here) then
		return here
	end
	local best = 1
	for area = 2, 3 do
		if Net.unlocked(area) then
			best = area
		end
	end
	return best
end

local lastPos: Vector3? = nil
local stuckSince = 0

local function step()
	if not AutoFarm.enabled or menuOpen or os.clock() < pausedUntil then
		return
	end
	local state = Net.State
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not state or not state.Lane or not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if manualInput() then
		pausedUntil = os.clock() + 1.5
		return
	end
	local position = root.Position
	local area = chooseArea(position)
	local targets = laneTargets(state.Lane, area)
	local best, bestDistance = nil, math.huge
	for _, model in targets do
		local d = Layout.reachDistance(position, model.PrimaryPart :: BasePart)
		if d < bestDistance then
			best, bestDistance = model, d
		end
	end
	if not best then
		stop(humanoid)
		return
	end
	if bestDistance <= Config.Combat.Reach - 1 then
		stop(humanoid) -- in reach: the free auto-hit takes over
		return
	end
	-- Walk to the closest point just outside the target's box (never through it).
	local hitbox = best.PrimaryPart :: BasePart
	local half = hitbox.Size / 2 + Vector3.new(2, 0, 2)
	local centre = hitbox.Position
	local approach = Vector3.new(
		math.clamp(position.X, centre.X - half.X, centre.X + half.X),
		position.Y,
		math.clamp(position.Z, centre.Z - half.Z, centre.Z + half.Z)
	)
	local route = Layout.route(position, area, state.Lane, approach)
	for _, waypoint in route do
		local flat = Vector3.new(waypoint.X - position.X, 0, waypoint.Z - position.Z)
		if flat.Magnitude > 2.5 then
			humanoid:MoveTo(Vector3.new(waypoint.X, position.Y, waypoint.Z))
			break
		end
	end
	-- Unstick: hop if we haven't moved in a while.
	if lastPos and (lastPos - position).Magnitude < 0.6 then
		if os.clock() - stuckSince > 1.5 then
			humanoid.Jump = true
			stuckSince = os.clock()
		end
	else
		stuckSince = os.clock()
	end
	lastPos = position
end

function AutoFarm.init()
	Net.MenuChanged:Connect(function(name)
		menuOpen = name ~= nil
	end)
	player:GetAttributeChangedSignal("HasAutoFarm"):Connect(function()
		if not player:GetAttribute("HasAutoFarm") then
			AutoFarm.toggle(false)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(step)
			if not ok then
				warn("[AutoFarm] " .. tostring(err))
			end
		end
	end)
end

return AutoFarm
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[-- Foundry VIP chat tag. The server sets the IsVIP attribute ahead of time because
-- chat callbacks must never yield.

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local ChatTags = {}

function ChatTags.init()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local source = message.TextSource
		if not source then
			return nil
		end
		local sender = Players:GetPlayerByUserId(source.UserId)
		if sender and sender:GetAttribute("IsVIP") then
			local props = Instance.new("TextChatMessageProperties")
			props.PrefixText = "<font color='#FFD12E'>[VIP]</font> " .. message.PrefixText
			return props
		end
		return nil
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Juice for the core loop: arm swing, impact sparks, target shake/flash, damage
-- numbers, chunky debris when junk breaks, and Scrap flying into the counter.
-- Everything here is local and cosmetic; the server owns damage and rewards.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)
local Economy = require(Shared.Economy)

local Net = require(script.Parent.Parent.Net)
local Sound = require(script.Parent.Sound)
local UIKit = require(script.Parent.Parent.UI.UIKit)

local Effects = {}

local player = Players.LocalPlayer
local fxFolder: Folder
local onReward: ((Vector3, number) -> ())? = nil

local TOOL_SPARK = {
	Hammer = Color3.fromHex("#FFE14D"),
	Saw = Color3.fromHex("#FF9E2C"),
	Drill = Color3.fromHex("#B8C4DA"),
}

-- Arm swing ----------------------------------------------------------------------------
-- Rotates the right shoulder joint locally: wind up, slam, recover (0.32 s).

type Swing = { motor: Motor6D, base: CFrame, last: CFrame, t: number }
local swings: { [Motor6D]: Swing } = {}

local function swingAngle(t: number): number
	if t < 0.12 then
		return 140 * (t / 0.12)
	elseif t < 0.2 then
		return 140 - 110 * ((t - 0.12) / 0.08)
	elseif t < 0.32 then
		return 30 * (1 - (t - 0.2) / 0.12)
	end
	return 0
end

RunService.RenderStepped:Connect(function(dt)
	for motor, swing in swings do
		if not motor.Parent then
			swings[motor] = nil
			continue
		end
		if not motor.C0:FuzzyEq(swing.last, 1e-3) then
			swing.base = motor.C0 -- the server rebuilt / rescaled the rig meanwhile
		end
		swing.t += dt
		local angle = swingAngle(swing.t)
		local cf = swing.base * CFrame.Angles(math.rad(angle), 0, 0)
		motor.C0 = cf
		swing.last = cf
		if swing.t >= 0.32 then
			motor.C0 = swing.base
			swings[motor] = nil
		end
	end
end)

local function swingArm(character: Model)
	local arm = character:FindFirstChild("RightUpperArm")
	local motor = arm and arm:FindFirstChild("RightShoulder")
	if not motor or not motor:IsA("Motor6D") then
		return
	end
	local existing = swings[motor]
	if existing then
		existing.t = 0
		return
	end
	swings[motor] = { motor = motor, base = motor.C0, last = motor.C0, t = 0 }
end

-- Little helpers -------------------------------------------------------------------

local function chip(position: Vector3, color: Color3, size: number, velocity: Vector3, life: number, neon: boolean?)
	local p = Instance.new("Part")
	p.Size = Vector3.new(size, size, size)
	p.CFrame = CFrame.new(position) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.CanCollide = not neon
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.CollisionGroup = "Debris"
	p.AssemblyLinearVelocity = velocity
	p.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
	p.Parent = fxFolder
	task.delay(life * 0.6, function()
		if p.Parent then
			TweenService:Create(p, TweenInfo.new(life * 0.4), { Transparency = 1, Size = p.Size * 0.4 }):Play()
		end
	end)
	task.delay(life, function()
		p:Destroy()
	end)
	return p
end

local function ring(position: Vector3, color: Color3, radius: number, time: number)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Size = Vector3.new(0.2, 1, 1)
	r.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Material = Enum.Material.Neon
	r.Color = color
	r.Transparency = 0.2
	r.Parent = fxFolder
	TweenService:Create(
		r,
		TweenInfo.new(time, Enum.EasingStyle.Quad),
		{ Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 1 }
	):Play()
	task.delay(time, function()
		r:Destroy()
	end)
end

local function dust(position: Vector3, size: number)
	for _ = 1, 3 do
		local puff = Instance.new("Part")
		puff.Shape = Enum.PartType.Ball
		puff.Size = Vector3.one * size * 0.5
		puff.CFrame = CFrame.new(
			position + Vector3.new(math.random(-10, 10) / 10 * size * 0.4, 0, math.random(-10, 10) / 10 * size * 0.4)
		)
		puff.Anchored = true
		puff.CanCollide = false
		puff.CanQuery = false
		puff.CanTouch = false
		puff.CastShadow = false
		puff.Color = Color3.fromHex("#C9BBA8")
		puff.Material = Enum.Material.SmoothPlastic
		puff.Transparency = 0.35
		puff.Parent = fxFolder
		TweenService:Create(puff, TweenInfo.new(0.7, Enum.EasingStyle.Quad), {
			Size = Vector3.one * size * 1.6,
			Transparency = 1,
			CFrame = puff.CFrame + Vector3.new(0, size * 0.6, 0),
		}):Play()
		task.delay(0.7, function()
			puff:Destroy()
		end)
	end
end

local shaking: { [Model]: CFrame } = {}

local function shakeTarget(model: Model)
	if shaking[model] or not model.Parent then
		return
	end
	local base = model:GetPivot()
	shaking[model] = base
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.45
	highlight.OutlineTransparency = 1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	task.spawn(function()
		for _, offset in { Vector3.new(0.25, 0, 0), Vector3.new(-0.2, 0, 0.1), Vector3.new(0.1, 0, -0.15) } do
			if not model.Parent then
				break
			end
			model:PivotTo(base + offset)
			task.wait(0.03)
		end
		if model.Parent then
			model:PivotTo(base)
		end
		highlight:Destroy()
		shaking[model] = nil
	end)
end

local function floatingText(position: Vector3, text: string, color: Color3, size: number)
	local anchor = Instance.new("Attachment")
	anchor.WorldPosition = position
	anchor.Parent = Workspace.Terrain
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = anchor
	gui.Parent = anchor
	local label = UIKit.text(gui, { Text = text, TextSize = size, Color = color, Rotation = math.random(-8, 8) })
	local stroke = label:FindFirstChildOfClass("UIStroke")
	gui.StudsOffsetWorldSpace = Vector3.new(math.random(-10, 10) / 10, 0, 0)
	UIKit.pop(label, 0.5)
	TweenService:Create(
		gui,
		TweenInfo.new(0.9, Enum.EasingStyle.Quad),
		{ StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + Vector3.new(0, 3, 0) }
	):Play()
	task.delay(0.45, function()
		TweenService:Create(label, TweenInfo.new(0.45), { TextTransparency = 1 }):Play()
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.45), { Transparency = 1 }):Play()
		end
	end)
	task.delay(0.95, function()
		anchor:Destroy()
	end)
end

local function cameraKick(strength: number)
	if UIKit.reducedMotion then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	task.spawn(function()
		for i = 1, 4 do
			local s = strength * (1 - i / 5)
			camera.CFrame *= CFrame.Angles(
				math.rad(math.random(-10, 10) / 10 * s),
				math.rad(math.random(-10, 10) / 10 * s),
				0
			)
			RunService.RenderStepped:Wait()
		end
	end)
end

-- Event handlers ---------------------------------------------------------------------------

local function onHit(userId: number, model: Model, damage: number)
	local attacker = Players:GetPlayerByUserId(userId)
	local character = attacker and attacker.Character
	if character then
		swingArm(character)
	end
	if not model or not model.Parent or not model.PrimaryPart then
		return
	end
	local hitbox = model.PrimaryPart
	local top = hitbox.Position + Vector3.new(0, hitbox.Size.Y / 2, 0)
	local toolId = attacker and attacker:GetAttribute("Tool") or "Hammer"
	local level = (attacker and attacker:GetAttribute("MechLevel")) or 0
	local spark = TOOL_SPARK[toolId] or TOOL_SPARK.Hammer
	local strong = level >= 1
	local mine = attacker == player
	local distance = Workspace.CurrentCamera and (Workspace.CurrentCamera.CFrame.Position - top).Magnitude or 0
	if distance > 160 then
		return
	end
	shakeTarget(model)
	local impact = top + Vector3.new(0, -hitbox.Size.Y * 0.25, 0)
	for _ = 1, if strong then 6 else 3 do
		chip(
			impact,
			spark,
			0.25,
			Vector3.new(math.random(-14, 14), math.random(10, 22), math.random(-14, 14)),
			0.45,
			true
		)
	end
	ring(impact, spark, if strong then 3 + level * 0.4 else 2, 0.25)
	if mine then
		floatingText(
			top + Vector3.new(0, 1, 0),
			"-" .. Economy.format(damage),
			if strong then Color3.fromHex("#FFE14D") else Theme.White,
			30
		)
		Sound.play("Hit", impact, 0.9 + math.random() * 0.25)
		if level >= 4 then
			cameraKick(0.6)
		end
	end
end

local function onBreak(userId: number, position: Vector3, size: Vector3, colors: { Color3 }, area: number)
	local camera = Workspace.CurrentCamera
	if camera and (camera.CFrame.Position - position).Magnitude > 220 then
		return
	end
	local count = 6 + area * 3
	local base = position - Vector3.new(0, size.Y * 0.2, 0)
	for i = 1, count do
		local color = colors[(i % math.max(#colors, 1)) + 1] or Color3.fromHex("#8A6A4A")
		local s = math.clamp(size.Magnitude / 10, 0.4, 1.4) * (0.6 + math.random() * 0.6)
		chip(
			base
				+ Vector3.new(
					math.random(-10, 10) / 10 * size.X * 0.3,
					math.random() * size.Y * 0.5,
					math.random(-10, 10) / 10 * size.Z * 0.3
				),
			color,
			s,
			Vector3.new(math.random(-22, 22), math.random(18, 38), math.random(-22, 22)),
			1.6
		)
	end
	dust(Vector3.new(position.X, position.Y - size.Y / 2 + 0.5, position.Z), math.max(size.X, size.Z))
	if userId == player.UserId then
		Sound.play("Break", position)
		cameraKick(1.2)
	end
end

function Effects.init(rewardHandler: (Vector3, number) -> ())
	onReward = rewardHandler
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFx"
	fxFolder.Parent = Workspace
	Net.Fx:Connect(function(name, ...)
		if name == "Hit" then
			onHit(...)
		elseif name == "Break" then
			onBreak(...)
		elseif name == "Reward" then
			local amount, position = ...
			floatingText(
				position + Vector3.new(0, 1.5, 0),
				"+" .. Economy.format(amount) .. " ⚙️",
				Theme.ScrapGold,
				38
			)
			if onReward then
				onReward(position, amount)
			end
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[-- Plays the configurable sounds from Config.Sounds (skips any left blank).

local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local Sound = {}

local VOLUME = { Swing = 0.25, Hit = 0.35, Break = 0.5, Coin = 0.3, Click = 0.25, Upgrade = 0.6 }

function Sound.play(name: string, position: Vector3?, pitch: number?)
	local id = Config.Sounds[name]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = VOLUME[name] or 0.4
	s.PlaybackSpeed = pitch or 1
	if position then
		local holder = Instance.new("Attachment")
		holder.WorldPosition = position
		holder.Parent = Workspace.Terrain
		s.RollOffMaxDistance = 90
		s.Parent = holder
		s.Ended:Once(function()
			holder:Destroy()
		end)
		s:Play()
		task.delay(6, function()
			if holder.Parent then
				holder:Destroy()
			end
		end)
	else
		s.Parent = SoundService
		SoundService:PlayLocalSound(s)
		task.delay(4, function()
			s:Destroy()
		end)
	end
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">WorldUI</string>
              <string name="Source"><![CDATA[-- Client-side world UI:
--  * HP bars over your own lane's junk (neighbours' junk stays uncluttered)
--  * a bouncing "SMASH!" pointer until the first smash
--  * hub pads that open their panel when you step on them, with live info lines
--  * gate barriers that open locally once you own the gate, and the unlock prompt

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)
local Theme = require(Shared.Theme)

local Net = require(script.Parent.Parent.Net)
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Panels = require(script.Parent.Parent.UI.Panels)

local WorldUI = {}

local player = Players.LocalPlayer
local world: Folder
local bars: { [Model]: { gui: BillboardGui, conn: RBXScriptConnection, update: () -> () } } = {}
local watchedLane: number? = nil
local laneConns: { RBXScriptConnection } = {}

-- HP bars ------------------------------------------------------------------------------

local function removeBar(model: Model)
	local bar = bars[model]
	if bar then
		bar.conn:Disconnect()
		bar.gui:Destroy()
		bars[model] = nil
	end
end

local function addBar(model: Model)
	if bars[model] or not model:IsA("Model") then
		return
	end
	local hitbox = model.PrimaryPart or model:WaitForChild("Hitbox", 2)
	if not hitbox then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "HPBar"
	gui.Size = UDim2.fromOffset(150, 46)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (hitbox :: BasePart).Size.Y / 2 + 1.8, 0)
	gui.MaxDistance = 55
	gui.LightInfluence = 0
	gui.Adornee = hitbox
	local name = UIKit.text(gui, { Text = model.Name, TextSize = 18, Size = UDim2.new(1, 0, 0, 20) })
	local bar = UIKit.progress(gui, {
		Size = UDim2.new(1, -10, 0, 20),
		Position = UDim2.fromOffset(5, 22),
		TextSize = 13,
		Swatch = Theme.Swatch.Green,
	})
	local function update()
		local hp = model:GetAttribute("HP") or 0
		local maxHp = model:GetAttribute("MaxHP") or 1
		local area = model:GetAttribute("Area") or 1
		local locked = not Net.unlocked(area)
		local ratio = hp / maxHp
		local swatch = if locked
			then Theme.Swatch.Steel
			elseif ratio > 0.5 then Theme.Swatch.Green
			elseif ratio > 0.25 then Theme.Swatch.Yellow
			else Theme.Swatch.Red
		bar:Set(ratio, (if locked then "🔒 " else "") .. Economy.format(hp) .. " HP", swatch)
		name.Text = model.Name .. "  ⚙️" .. tostring(model:GetAttribute("Reward") or "")
	end
	update()
	gui.Parent = player:WaitForChild("PlayerGui")
	bars[model] = { gui = gui, conn = model:GetAttributeChangedSignal("HP"):Connect(update), update = update }
	model.Destroying:Connect(function()
		removeBar(model)
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			removeBar(model)
		end
	end)
end

local function watchLane(lane: number?)
	if lane == watchedLane then
		return
	end
	watchedLane = lane
	for _, c in laneConns do
		c:Disconnect()
	end
	table.clear(laneConns)
	for model in bars do
		removeBar(model)
	end
	if not lane then
		return
	end
	local folder = world:WaitForChild("Targets"):WaitForChild("Lane" .. lane)
	for _, model in folder:GetChildren() do
		task.spawn(addBar, model)
	end
	table.insert(
		laneConns,
		folder.ChildAdded:Connect(function(model)
			task.spawn(addBar, model)
		end)
	)
end

-- Gate ownership changes the lock icons, so redraw every bar.
local function refreshBars()
	for model, bar in bars do
		if model.Parent then
			bar.update()
		end
	end
end

-- Smash pointer ---------------------------------------------------------------------------

local pointer: BillboardGui? = nil

local function updatePointer()
	local s = Net.State
	local show = s and (s.Destroys or 0) == 0 and watchedLane ~= nil and not Panels.isOpen("ToolPicker")
	if not show then
		if pointer then
			pointer:Destroy()
			pointer = nil
		end
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local best, bestD = nil, math.huge
	for model in bars do
		if model.Parent and model.PrimaryPart and model:GetAttribute("Area") == 1 then
			local d = (model.PrimaryPart.Position - root.Position).Magnitude
			if d < bestD then
				best, bestD = model, d
			end
		end
	end
	if not best then
		return
	end
	if not pointer then
		local gui = Instance.new("BillboardGui")
		gui.Name = "SmashPointer"
		gui.Size = UDim2.fromOffset(180, 110)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		UIKit.text(gui, {
			Text = "SMASH!",
			TextSize = 40,
			Size = UDim2.new(1, 0, 0, 46),
			Color = Color3.fromHex("#FFB24A"),
			StrokeThickness = 4,
		})
		local arrow = UIKit.text(gui, {
			Text = "▼",
			TextSize = 50,
			Size = UDim2.new(1, 0, 0, 56),
			Position = UDim2.fromOffset(0, 46),
			Color = Color3.fromHex("#FFE14D"),
			StrokeThickness = 4,
		})
		UIKit.bob(arrow, 8, 0.8)
		gui.Parent = player:WaitForChild("PlayerGui")
		pointer = gui
	end
	local p = pointer :: BillboardGui
	p.Adornee = best.PrimaryPart
	p.StudsOffsetWorldSpace = Vector3.new(0, (best.PrimaryPart :: BasePart).Size.Y / 2 + 5, 0)
end

-- Pads ---------------------------------------------------------------------------------------

local currentPad: string? = nil
local openedByPad: string? = nil

local function padLiveText(id: string): string
	local s = Net.State
	if not s then
		return ""
	end
	if id == "Upgrade" then
		local nextUp = Economy.nextUpgrade(s.Level)
		if not nextUp then
			return "MAX POWER!"
		end
		return string.format("Next: ⚡%s for %s Scrap", Economy.format(nextUp.Power), Economy.format(nextUp.Cost))
	elseif id == "Daily" then
		return string.format(
			"Workshop %d/%d · Contract %d/%d",
			math.floor(Net.workshopStored()),
			Config.Workshop.Cap,
			math.min(s.Daily.Progress, Config.Daily.Goal),
			Config.Daily.Goal
		)
	elseif id == "Rebirth" then
		if s.Rebirths >= Economy.MaxRebirths then
			return "All rebirths done!"
		end
		return string.format(
			"Scrap x%.2f → x%.2f",
			Economy.rebirthFactor(s.Rebirths),
			Economy.rebirthFactor(s.Rebirths + 1)
		)
	elseif id == "Shop" then
		return if s.BoostCharges > 0
			then string.format("%d boost charge%s ready", s.BoostCharges, if s.BoostCharges == 1 then "" else "s")
			else "7 offers"
	elseif id == "Garage" then
		return string.format("%d/%d finishes", #s.Finishes, #Config.Finishes)
	end
	return ""
end

local function updatePads(root: BasePart?)
	local pads = world:FindFirstChild("Hub") and world.Hub:FindFirstChild("Pads")
	if not pads then
		return
	end
	local inside: string? = nil
	for _, pad in pads:GetChildren() do
		local id = pad:GetAttribute("PadId")
		if id then
			local label = pad:FindFirstChild("Label")
			local live = label and label:FindFirstChild("Live")
			if live then
				live.Text = padLiveText(id)
			end
			if root then
				local flat = Vector3.new(pad.Position.X - root.Position.X, 0, pad.Position.Z - root.Position.Z)
				if flat.Magnitude <= Layout.PadRadius and math.abs(pad.Position.Y - root.Position.Y) < 10 then
					inside = id
				end
			end
		end
	end
	if inside ~= currentPad then
		if currentPad and openedByPad == currentPad and Panels.isOpen(currentPad) then
			Panels.close()
		end
		currentPad = inside
		openedByPad = nil
		if inside then
			Panels.open(inside)
			openedByPad = inside
		end
	end
end

-- Gates -----------------------------------------------------------------------------------------

local promptedGate: number? = nil

local function updateGates(root: BasePart?)
	for gate = 1, 2 do
		local folder = world:FindFirstChild("Gate" .. gate)
		local barrier = folder and folder:FindFirstChild("Barrier") :: BasePart?
		if barrier then
			local area = barrier:GetAttribute("GateArea")
			local open = Net.unlocked(area)
			barrier.CanCollide = not open
			barrier.Transparency = if open then 1 else 0.2
			local label = barrier:FindFirstChild("Label") :: BillboardGui?
			if label then
				label.Enabled = not open
			end
			if root and not open then
				local d =
					Vector3.new(barrier.Position.X - root.Position.X, 0, barrier.Position.Z - root.Position.Z).Magnitude
				if d < 12 and promptedGate ~= area and not Panels.isOpen() then
					promptedGate = area
					Panels.open("Gate", area)
				elseif d > 20 and promptedGate == area then
					promptedGate = nil
				end
			end
		end
	end
end

function WorldUI.init()
	world = Workspace:WaitForChild("World")
	Net.Changed:Connect(function(s)
		watchLane(s.Lane)
		refreshBars()
		updateGates(nil)
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local ok, err = pcall(function()
				updatePads(root)
				updateGates(root)
				updatePointer()
			end)
			if not ok then
				warn("[WorldUI] " .. tostring(err))
			end
		end
	end)
end

return WorldUI
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="41">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Pick Your Mech! client entry point.

local Client = script.Parent
local UI = Client:WaitForChild("UI")
local Controllers = Client:WaitForChild("Controllers")
local Screens = UI:WaitForChild("Screens")

local Net = require(Client:WaitForChild("Net"))
local Gui = require(UI:WaitForChild("Gui"))
local Panels = require(UI:WaitForChild("Panels"))
local Hud = require(UI:WaitForChild("Hud"))
local Toasts = require(UI:WaitForChild("Toasts"))
local Effects = require(Controllers:WaitForChild("Effects"))
local AutoFarm = require(Controllers:WaitForChild("AutoFarm"))
local WorldUI = require(Controllers:WaitForChild("WorldUI"))
local ChatTags = require(Controllers:WaitForChild("ChatTags"))

Net.init()
Gui.init()
Panels.init()
Hud.init()
for _, name in { "Upgrade", "Shop", "Rebirth", "Garage", "Daily", "Gate", "ToolPicker" } do
	require(Screens:WaitForChild(name)).init()
end
Effects.init(Hud.flyScrap)
AutoFarm.init()
WorldUI.init()
ChatTags.init()

Net.Changed:Connect(Hud.update)

local CELEBRATE = { Form = true, Gate = true, Rebirth = true }
Net.Notified:Connect(function(kind, title, body)
	if CELEBRATE[kind] then
		Toasts.celebrate(kind, title, body)
	elseif kind == "Error" then
		Toasts.error(title .. (if body ~= "" then " " .. body else ""))
	else
		Toasts.show(kind, title, body)
	end
end)

-- If the server pushed state before we connected, ask for a fresh snapshot.
if not Net.State then
	task.delay(3, function()
		if not Net.State then
			Net.request("Sync")
		end
	end)
end
]]></string>
          </Properties>
