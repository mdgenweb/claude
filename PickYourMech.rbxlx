  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Builders</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">TargetModels</string>
            <string name="Source"><![CDATA[-- Smashable targets, built from parts to match the concept prop sheet:
-- Starter Yard junk, Appliance Row washers/fridges, Crusher Yard cars and ore nodes.
-- Ore types are looks only (no rarity, no separate currency). Every target gets an
-- invisible "Hitbox" PrimaryPart that carries collision; the visuals never collide.

local TargetModels = {}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

type Builder = { model: Model, origin: CFrame, rng: Random }

local function part(
	b: Builder,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = b.origin * offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Parent = b.model
	return p
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder's X axis upright
local FLAT = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis along Z (facing front)

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

-- Starter Yard ----------------------------------------------------------------

local RUST = { hex("#9C5B35"), hex("#7A4A2E"), hex("#6E737A"), hex("#8A6A4A"), hex("#B36B3A") }

local function scrapPile(b: Builder)
	for i = 1, 7 do
		local w = b.rng:NextNumber(0.8, 1.8)
		local h = b.rng:NextNumber(0.4, 1.2)
		local d = b.rng:NextNumber(0.8, 1.8)
		local x = b.rng:NextNumber(-1, 1)
		local z = b.rng:NextNumber(-1, 1)
		local y = 0.3 + (i % 3) * 0.55
		part(
			b,
			"Scrap",
			Vector3.new(w, h, d),
			at(x, y + h / 2, z)
				* CFrame.Angles(b.rng:NextNumber(-0.5, 0.5), b.rng:NextNumber(0, 6.28), b.rng:NextNumber(-0.5, 0.5)),
			RUST[(i % #RUST) + 1],
			Enum.Material.CorrodedMetal
		)
	end
	part(
		b,
		"Tire",
		Vector3.new(0.6, 1.8, 1.8),
		at(1.2, 0.9, 0.6) * CFrame.Angles(0, 0.4, 0.3),
		hex("#1E1E22"),
		nil,
		Enum.PartType.Cylinder
	)
	part(
		b,
		"Plank",
		Vector3.new(3, 0.2, 0.5),
		at(-0.5, 1.6, -0.3) * CFrame.Angles(0, 0.7, 0.35),
		hex("#A0703C"),
		Enum.Material.WoodPlanks
	)
end

local function tireStack(b: Builder)
	for i = 0, 2 do
		local yaw = b.rng:NextNumber(-0.3, 0.3)
		part(
			b,
			"Tire",
			Vector3.new(0.75, 2.2, 2.2),
			at(b.rng:NextNumber(-0.15, 0.15), 0.38 + i * 0.75, 0) * CFrame.Angles(0, yaw, 0) * UP,
			hex("#1C1C20"),
			nil,
			Enum.PartType.Cylinder
		)
		part(
			b,
			"Hub",
			Vector3.new(0.78, 1.0, 1.0),
			at(0, 0.38 + i * 0.75, 0) * UP,
			hex("#8D939C"),
			Enum.Material.Metal,
			Enum.PartType.Cylinder
		)
	end
end

local function crate(b: Builder)
	local wood = hex("#B07A40")
	local edge = hex("#7A5228")
	part(b, "Crate", Vector3.new(2.8, 2.8, 2.8), at(0, 1.4, 0), wood, Enum.Material.WoodPlanks)
	for _, y in { 0.15, 2.65 } do
		part(b, "Edge", Vector3.new(2.9, 0.3, 2.9), at(0, y, 0), edge, Enum.Material.Wood)
	end
	part(
		b,
		"Brace",
		Vector3.new(0.3, 3.6, 0.1),
		at(0, 1.4, -1.42) * CFrame.Angles(0, 0, math.rad(45)),
		edge,
		Enum.Material.Wood
	)
	part(
		b,
		"SmallCrate",
		Vector3.new(1.6, 1.6, 1.6),
		at(0.4, 3.6, 0.2) * CFrame.Angles(0, 0.5, 0),
		wood,
		Enum.Material.WoodPlanks
	)
end

local function oilBarrel(b: Builder)
	local colors = { hex("#2F6FD6"), hex("#D63A2F"), hex("#2FA35A") }
	for i, x in { -0.75, 0.85 } do
		local c = colors[((i + b.rng:NextInteger(0, 2)) % 3) + 1]
		part(
			b,
			"Barrel",
			Vector3.new(2.8, 1.5, 1.5),
			at(x, 1.4, 0) * UP,
			c,
			Enum.Material.Metal,
			Enum.PartType.Cylinder
		)
		for _, y in { 0.6, 2.2 } do
			part(
				b,
				"Ring",
				Vector3.new(0.14, 1.56, 1.56),
				at(x, y, 0) * UP,
				hex("#2A2E35"),
				Enum.Material.Metal,
				Enum.PartType.Cylinder
			)
		end
		part(b, "Label", Vector3.new(0.7, 0.7, 0.05), at(x, 1.4, -0.76), hex("#FFC61A"))
	end
end

local function oldTv(b: Builder)
	part(b, "Stand", Vector3.new(2.4, 1.2, 1.8), at(0, 0.6, 0), hex("#6B4A2E"), Enum.Material.Wood)
	part(b, "TV", Vector3.new(2.6, 2.1, 2.1), at(0, 2.25, 0), hex("#5A5F6A"), Enum.Material.SmoothPlastic)
	part(b, "Screen", Vector3.new(1.8, 1.4, 0.05), at(-0.2, 2.3, -1.06), hex("#1B3A4A"), Enum.Material.Glass)
	part(
		b,
		"Knob",
		Vector3.new(0.2, 0.3, 0.3),
		at(0.95, 2.6, -1.08) * FLAT,
		hex("#C9CED6"),
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	for side = -1, 1, 2 do
		part(
			b,
			"Antenna",
			Vector3.new(0.08, 1.6, 0.08),
			at(side * 0.4, 3.9, 0) * CFrame.Angles(0, 0, math.rad(side * -25)),
			hex("#C9CED6"),
			Enum.Material.Metal
		)
	end
end

-- Appliance Row -----------------------------------------------------------------

local APPLIANCE_WHITE = { hex("#F2F4F6"), hex("#E6EEF0"), hex("#A8E6CF"), hex("#FFD8A8"), hex("#CFE3FF") }

local function washer(b: Builder)
	local body = APPLIANCE_WHITE[b.rng:NextInteger(1, #APPLIANCE_WHITE)]
	part(b, "Body", Vector3.new(3.6, 4.0, 3.6), at(0, 2.0, 0), body)
	part(b, "Panel", Vector3.new(3.6, 0.7, 0.2), at(0, 3.65, -1.85), hex("#C9CFD6"))
	for i = 0, 2 do
		part(
			b,
			"Knob",
			Vector3.new(0.2, 0.35, 0.35),
			at(-1.1 + i * 0.6, 3.65, -1.98) * FLAT,
			hex("#4A4F57"),
			nil,
			Enum.PartType.Cylinder
		)
	end
	part(
		b,
		"DoorRing",
		Vector3.new(0.2, 2.5, 2.5),
		at(0, 1.75, -1.85) * FLAT,
		hex("#8D939C"),
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	local glass = part(
		b,
		"Glass",
		Vector3.new(0.22, 1.9, 1.9),
		at(0, 1.75, -1.87) * FLAT,
		hex("#7FC8F0"),
		Enum.Material.Glass,
		Enum.PartType.Cylinder
	)
	glass.Transparency = 0.25
	part(
		b,
		"Dent",
		Vector3.new(0.9, 0.6, 0.05),
		at(1.3, 0.6, -1.81) * CFrame.Angles(0, 0, 0.3),
		body:Lerp(Color3.new(0, 0, 0), 0.15)
	)
end

local function fridge(b: Builder)
	local body = APPLIANCE_WHITE[b.rng:NextInteger(1, #APPLIANCE_WHITE)]
	part(b, "Body", Vector3.new(3.6, 6.6, 3.2), at(0, 3.3, 0), body)
	part(b, "Split", Vector3.new(3.62, 0.12, 3.22), at(0, 4.6, 0), body:Lerp(Color3.new(0, 0, 0), 0.25))
	part(b, "HandleTop", Vector3.new(0.18, 1.2, 0.25), at(1.4, 5.5, -1.72), hex("#C9CED6"), Enum.Material.Metal)
	part(b, "HandleBottom", Vector3.new(0.18, 2.2, 0.25), at(1.4, 3.3, -1.72), hex("#C9CED6"), Enum.Material.Metal)
	part(b, "Magnet", Vector3.new(0.5, 0.5, 0.05), at(-0.8, 3.6, -1.62) * CFrame.Angles(0, 0, 0.2), hex("#FF5A5A"))
	part(b, "Magnet", Vector3.new(0.4, 0.4, 0.05), at(-0.2, 2.9, -1.62), hex("#45D4FF"))
end

local function microwave(b: Builder)
	part(b, "Cabinet", Vector3.new(3.4, 2.4, 2.6), at(0, 1.2, 0), hex("#8A6A4A"), Enum.Material.Wood)
	part(b, "Body", Vector3.new(3.0, 1.9, 2.2), at(0, 3.35, 0), hex("#F2F4F6"))
	part(b, "Window", Vector3.new(1.9, 1.3, 0.05), at(-0.4, 3.35, -1.11), hex("#1E2228"), Enum.Material.Glass)
	part(b, "Keypad", Vector3.new(0.6, 1.3, 0.05), at(1.05, 3.35, -1.11), hex("#4A4F57"))
	part(b, "Glow", Vector3.new(0.4, 0.15, 0.05), at(1.05, 3.85, -1.13), hex("#6CFF5C"), Enum.Material.Neon)
end

local function oven(b: Builder)
	local body = APPLIANCE_WHITE[b.rng:NextInteger(1, #APPLIANCE_WHITE)]
	part(b, "Body", Vector3.new(3.6, 3.8, 3.4), at(0, 1.9, 0), body)
	part(b, "Door", Vector3.new(3.0, 2.0, 0.1), at(0, 1.5, -1.72), hex("#1E2228"), Enum.Material.Glass)
	part(b, "Handle", Vector3.new(2.6, 0.18, 0.25), at(0, 2.75, -1.82), hex("#C9CED6"), Enum.Material.Metal)
	part(b, "Back", Vector3.new(3.6, 0.9, 0.3), at(0, 4.25, 1.55), body)
	for x = -1, 1, 2 do
		for z = -1, 1, 2 do
			part(
				b,
				"Burner",
				Vector3.new(0.12, 1.0, 1.0),
				at(x * 0.85, 3.86, z * 0.75) * UP,
				hex("#2A2E35"),
				Enum.Material.Metal,
				Enum.PartType.Cylinder
			)
		end
	end
end

local function waterHeater(b: Builder)
	part(b, "Tank", Vector3.new(5.2, 2.6, 2.6), at(0, 2.6, 0) * UP, hex("#E6EEF0"), nil, Enum.PartType.Cylinder)
	part(
		b,
		"Cap",
		Vector3.new(0.3, 2.7, 2.7),
		at(0, 5.2, 0) * UP,
		hex("#8D939C"),
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	for side = -1, 1, 2 do
		part(
			b,
			"Pipe",
			Vector3.new(1.2, 0.3, 0.3),
			at(side * 0.5, 5.8, 0) * UP,
			hex("#D9783A"),
			Enum.Material.Metal,
			Enum.PartType.Cylinder
		)
	end
	part(b, "Label", Vector3.new(0.9, 0.6, 0.05), at(0, 3.2, -1.3), hex("#FFC61A"))
end

-- Crusher Yard --------------------------------------------------------------------

local CAR_COLORS = { hex("#D63A2F"), hex("#2F6FD6"), hex("#2FA3A0"), hex("#E0A82E"), hex("#7A4AC8") }

local function wreckedCar(b: Builder)
	local c = CAR_COLORS[b.rng:NextInteger(1, #CAR_COLORS)]
	local tilt = CFrame.Angles(b.rng:NextNumber(-0.06, 0.06), 0, b.rng:NextNumber(-0.08, 0.08))
	local function cp(name, size, offset, color, material, shape)
		return part(b, name, size, tilt * offset, color, material, shape)
	end
	cp("Body", Vector3.new(4.6, 1.8, 9.0), at(0, 1.5, 0), c, Enum.Material.Metal)
	cp("Cabin", Vector3.new(4.2, 1.6, 4.6), at(0, 3.1, 0.4), c:Lerp(Color3.new(0, 0, 0), 0.1), Enum.Material.Metal)
	local glass = cp("Windows", Vector3.new(4.3, 1.1, 4.0), at(0, 3.2, 0.4), hex("#2A3A48"), Enum.Material.Glass)
	glass.Transparency = 0.2
	cp("Bumper", Vector3.new(4.8, 0.5, 0.4), at(0, 0.95, -4.6), hex("#8D939C"), Enum.Material.Metal)
	cp("Rust", Vector3.new(1.6, 1.0, 0.05), at(2.31, 1.6, 1.5), hex("#7A4A2E"), Enum.Material.CorrodedMetal)
	for _, x in { -2.2, 2.2 } do
		for _, z in { -2.9, 2.9 } do
			cp("Wheel", Vector3.new(0.7, 1.9, 1.9), at(x, 0.95, z), hex("#1C1C20"), nil, Enum.PartType.Cylinder)
		end
	end
	for side = -1, 1, 2 do
		cp("Headlight", Vector3.new(0.8, 0.4, 0.05), at(side * 1.5, 1.7, -4.52), hex("#FFF2B3"), Enum.Material.Neon)
	end
end

local ORES = {
	Iron = { rock = hex("#5B5E66"), vein = hex("#C9CED6"), material = Enum.Material.Metal, glow = false },
	Copper = { rock = hex("#6B5A4E"), vein = hex("#E07A3A"), material = Enum.Material.Metal, glow = false },
	Cobalt = { rock = hex("#3A3F4A"), vein = hex("#2F6BFF"), material = Enum.Material.Neon, glow = true },
}

local function oreNode(kind: string)
	return function(b: Builder)
		local ore = ORES[kind]
		-- A cluster of chunky rocks around a central boulder...
		local rocks = {}
		for i = 1, 5 do
			local s = if i == 1 then b.rng:NextNumber(2.6, 3.0) else b.rng:NextNumber(1.4, 2.1)
			local a = i * 1.26 + b.rng:NextNumber(-0.3, 0.3)
			local r = if i == 1 then 0 else 1.7
			local pos = Vector3.new(math.cos(a) * r, s * 0.42, math.sin(a) * r)
			part(
				b,
				"Rock",
				Vector3.new(s, s * b.rng:NextNumber(0.8, 1.05), s),
				CFrame.new(pos)
					* CFrame.Angles(b.rng:NextNumber(-0.3, 0.3), b.rng:NextNumber(0, 6.28), b.rng:NextNumber(-0.3, 0.3)),
				ore.rock,
				Enum.Material.Slate
			)
			table.insert(rocks, { pos = pos, size = s })
		end
		-- ...with ore chunks poking out of each rock's surface so the type reads at a glance.
		for i, rock in rocks do
			for k = 1, if i == 1 then 3 else 1 do
				local a = b.rng:NextNumber(0, 6.28)
				local out = Vector3.new(math.cos(a), 0, math.sin(a)) * rock.size * 0.45
				local size = b.rng:NextNumber(0.55, 0.9) * (if k == 1 then 1.2 else 1)
				local vein = part(
					b,
					"Vein",
					Vector3.new(size, size * 1.3, size),
					CFrame.new(rock.pos + out + Vector3.new(0, rock.size * b.rng:NextNumber(0.05, 0.35), 0))
						* CFrame.Angles(b.rng:NextNumber(0, 6.28), b.rng:NextNumber(0, 6.28), b.rng:NextNumber(0, 6.28)),
					ore.vein,
					ore.material
				)
				if ore.glow then
					vein.Transparency = 0.1
				end
			end
		end
	end
end

local function crystalOre(b: Builder)
	for i = 1, 4 do
		local s = b.rng:NextNumber(1.6, 2.6)
		part(
			b,
			"Rock",
			Vector3.new(s, s * 0.7, s),
			at(b.rng:NextNumber(-1.4, 1.4), s * 0.3, b.rng:NextNumber(-1.4, 1.4))
				* CFrame.Angles(0, b.rng:NextNumber(0, 6.28), b.rng:NextNumber(-0.3, 0.3)),
			hex("#4A4E58"),
			Enum.Material.Slate
		)
		local h = b.rng:NextNumber(2.6, 5.0) * (if i == 1 then 1.3 else 1)
		local crystal = part(
			b,
			"Crystal",
			Vector3.new(0.9, h, 0.9),
			at(b.rng:NextNumber(-1.2, 1.2), h / 2 + 0.6, b.rng:NextNumber(-1.2, 1.2))
				* CFrame.Angles(b.rng:NextNumber(-0.35, 0.35), b.rng:NextNumber(0, 6.28), b.rng:NextNumber(-0.35, 0.35)),
			hex("#9FF3FF"),
			Enum.Material.Glass
		)
		crystal.Transparency = 0.15
		part(
			b,
			"CrystalCore",
			Vector3.new(0.35, h * 0.7, 0.35),
			b.origin:ToObjectSpace(crystal.CFrame),
			hex("#5BE7FF"),
			Enum.Material.Neon
		)
	end
end

local function bigScrapHeap(b: Builder)
	for i = 1, 12 do
		local w = b.rng:NextNumber(1.2, 3.0)
		local h = b.rng:NextNumber(0.6, 1.6)
		local d = b.rng:NextNumber(1.2, 3.0)
		local r = 3.2 - (i / 12) * 2.4
		local a = b.rng:NextNumber(0, 6.28)
		part(
			b,
			"Scrap",
			Vector3.new(w, h, d),
			at(math.cos(a) * r * 0.6, 0.4 + (i / 12) * 3.6, math.sin(a) * r * 0.6)
				* CFrame.Angles(b.rng:NextNumber(-0.6, 0.6), b.rng:NextNumber(0, 6.28), b.rng:NextNumber(-0.6, 0.6)),
			RUST[(i % #RUST) + 1],
			Enum.Material.CorrodedMetal
		)
	end
	part(
		b,
		"Tire",
		Vector3.new(0.7, 2.0, 2.0),
		at(-1.5, 1.2, 1.0) * CFrame.Angles(0.5, 0.4, 0.3),
		hex("#1E1E22"),
		nil,
		Enum.PartType.Cylinder
	)
	part(
		b,
		"Door",
		Vector3.new(0.2, 2.2, 3.0),
		at(1.8, 1.6, -0.5) * CFrame.Angles(0.3, 0.2, 0.4),
		hex("#2F6FD6"),
		Enum.Material.Metal
	)
end

TargetModels.Kinds = {
	{
		{ Name = "Scrap Pile", Build = scrapPile },
		{ Name = "Tire Stack", Build = tireStack },
		{ Name = "Crate", Build = crate },
		{ Name = "Oil Barrels", Build = oilBarrel },
		{ Name = "Old TV", Build = oldTv },
	},
	{
		{ Name = "Washer", Build = washer },
		{ Name = "Fridge", Build = fridge },
		{ Name = "Microwave", Build = microwave },
		{ Name = "Oven", Build = oven },
		{ Name = "Water Heater", Build = waterHeater },
	},
	{
		{ Name = "Wrecked Car", Build = wreckedCar },
		{ Name = "Iron Ore", Build = oreNode("Iron") },
		{ Name = "Copper Ore", Build = oreNode("Copper") },
		{ Name = "Cobalt Ore", Build = oreNode("Cobalt") },
		{ Name = "Crystal Ore", Build = crystalOre },
		{ Name = "Scrap Heap", Build = bigScrapHeap },
	},
}

-- Builds a target at `position` (ground level). `seed` keeps layouts deterministic.
function TargetModels.build(area: number, kindIndex: number, position: Vector3, seed: number): Model
	local kinds = TargetModels.Kinds[area]
	local kind = kinds[((kindIndex - 1) % #kinds) + 1]
	local rng = Random.new(seed)
	local model = Instance.new("Model")
	model.Name = kind.Name
	local origin = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(-0.35, 0.35), 0)
	kind.Build({ model = model, origin = origin, rng = rng })

	local cf, size = model:GetBoundingBox()
	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Anchored = true
	hitbox.Transparency = 1
	hitbox.CanCollide = true
	hitbox.CanQuery = true
	hitbox.CanTouch = false
	-- Axis-aligned box on the ground so reach checks are simple and fair.
	local footprint = Vector3.new(math.max(size.X, 2), math.max(size.Y, 2), math.max(size.Z, 2))
	hitbox.Size = footprint
	hitbox.CFrame = CFrame.new(cf.Position.X, position.Y + footprint.Y / 2, cf.Position.Z)
	hitbox.Parent = model
	model.PrimaryPart = hitbox
	return model
end

-- A few representative colors, for debris effects when the target breaks.
function TargetModels.colors(model: Model): { Color3 }
	local colors = {}
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name ~= "Hitbox" and d.Material ~= Enum.Material.Neon then
			table.insert(colors, d.Color)
			if #colors >= 4 then
				break
			end
		end
	end
	return colors
end

return TargetModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Builds the whole map at server start, following the concept's world map sheet:
-- a floating scrapyard island; a compact hub (spawn, upgrade bench, rebirth pad, shop,
-- daily/workshop, garage); and three yards (Starter Yard -> Appliance Row -> Crusher Yard)
-- of six lanes each, joined by a corridor with two gates.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Theme = require(Shared.Theme)
local MechBuilder = require(Shared.MechBuilder)

local WorldBuilder = {}

local rng = Random.new(1337)

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

local C = {
	Grass = hex("#6DBE45"),
	Dirt = hex("#8A6A4A"),
	Rock = hex("#6E6A66"),
	RockDark = hex("#4E4A47"),
	Concrete = hex("#C8CDD3"),
	ConcreteDark = hex("#9AA1AA"),
	Road = hex("#3B4048"),
	Steel = hex("#7D8794"),
	SteelDark = hex("#454C57"),
	Wall = hex("#5F6B7A"),
	WallAlt = hex("#4F5A68"),
	Hazard = Theme.Hazard,
	Ink = Theme.Ink,
	Wood = hex("#A0703C"),
	HubFloor = hex("#E9EEF4"),
	HubTrim = hex("#2F7BEA"),
}

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function invisibleWall(parent: Instance, size: Vector3, cframe: CFrame)
	local p = block(parent, "Boundary", size, cframe, C.Ink)
	p.Transparency = 1
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Text helpers ------------------------------------------------------------------

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = props.Font or Theme.Font.Display
	t.TextColor3 = props.Color or Theme.White
	t.TextScaled = true
	t.Text = props.Text or ""
	t.Size = props.Size or UDim2.fromScale(1, 1)
	t.Position = props.Position or UDim2.new()
	t.AnchorPoint = props.AnchorPoint or Vector2.zero
	t.Name = props.Name or "Text"
	t.RichText = props.RichText or false
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Ink
	stroke.Thickness = props.Stroke or 3
	stroke.Parent = t
	t.Parent = parent
	return t
end

-- Floating label in the style of simulator pads: yellow title, white subtitle, info line.
local function padBillboard(
	adornee: BasePart,
	title: string,
	subtitle: string,
	info: string,
	titleColor: Color3?,
	height: number?
)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(300, 120)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height or 6, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = adornee
	text(gui, {
		Name = "Title",
		Text = title,
		Size = UDim2.fromScale(1, 0.42),
		Color = titleColor or hex("#FFE14D"),
		Stroke = 3.5,
	})
	text(gui, {
		Name = "Subtitle",
		Text = subtitle,
		Size = UDim2.fromScale(1, 0.26),
		Position = UDim2.fromScale(0, 0.42),
		Font = Theme.Font.Body,
		Stroke = 2.5,
	})
	text(gui, {
		Name = "Live",
		Text = info,
		Size = UDim2.fromScale(1, 0.3),
		Position = UDim2.fromScale(0, 0.68),
		Color = Theme.Good,
		Stroke = 2.5,
	})
	gui.Parent = adornee
	return gui
end

local function surfaceSign(part: BasePart, face: Enum.NormalId, build: (SurfaceGui) -> ())
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	build(gui)
	gui.Parent = part
	return gui
end

-- Lighting -----------------------------------------------------------------------

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(96, 98, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 152, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("PostEffect") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(205, 225, 255)
	atmosphere.Decay = Color3.fromRGB(120, 140, 175)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 1.1
	atmosphere.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.18
	cc.Contrast = 0.08
	cc.Brightness = 0.02
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 0.92
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.04
	rays.Spread = 0.6
	rays.Parent = Lighting
end

-- Island ---------------------------------------------------------------------------

local X0, X1 = -24, Layout.TotalWidth + 24
local Z0, Z1 = -Layout.LaneDepth - 22, Layout.HubZ1 + 16

local function buildIsland(world: Instance)
	local island = folder(world, "Island")
	local w, d = X1 - X0, Z1 - Z0
	local cx, cz = (X0 + X1) / 2, (Z0 + Z1) / 2
	block(island, "Ground", Vector3.new(w, 6, d), CFrame.new(cx, -3, cz), C.Grass, Enum.Material.Grass)
	block(island, "Soil", Vector3.new(w - 4, 10, d - 4), CFrame.new(cx, -11, cz), C.Dirt, Enum.Material.Ground)
	-- Cliff skirt: chunky rock blocks around the rim stepping down into the void.
	local function rimRock(x: number, z: number)
		local s = rng:NextNumber(8, 16)
		local h = rng:NextNumber(14, 34)
		block(
			island,
			"Cliff",
			Vector3.new(s, h, s),
			CFrame.new(x, -4 - h / 2 + rng:NextNumber(0, 4), z) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0),
			if rng:NextNumber() > 0.5 then C.Rock else C.RockDark,
			Enum.Material.Slate
		)
	end
	for x = X0, X1, 12 do
		rimRock(x, Z0 + rng:NextNumber(-2, 3))
		rimRock(x, Z1 + rng:NextNumber(-3, 2))
	end
	for z = Z0, Z1, 12 do
		rimRock(X0 + rng:NextNumber(-2, 3), z)
		rimRock(X1 + rng:NextNumber(-3, 2), z)
	end
	-- Underside: tapering rock mass so the island reads as floating.
	for i = 1, 4 do
		local inset = i * 26
		block(
			island,
			"Underside",
			Vector3.new(math.max(w - inset * 2, 40), 14, math.max(d - inset * 1.4, 30)),
			CFrame.new(cx + rng:NextNumber(-10, 10), -16 - i * 12, cz),
			if i % 2 == 0 then C.Rock else C.RockDark,
			Enum.Material.Slate
		)
	end
	-- Small floating rocks around the island.
	for _ = 1, 22 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(0.62, 0.8)
		local x = cx + math.cos(a) * w * r
		local z = cz + math.sin(a) * d * r
		local s = rng:NextNumber(4, 12)
		local rock = block(
			island,
			"FloatingRock",
			Vector3.new(s, s * 0.8, s),
			CFrame.new(x, rng:NextNumber(-30, 10), z) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 3), 0),
			C.Rock,
			Enum.Material.Slate
		)
		block(
			island,
			"RockGrass",
			Vector3.new(s * 0.9, 0.8, s * 0.9),
			rock.CFrame * CFrame.new(0, s * 0.4 + 0.3, 0),
			C.Grass,
			Enum.Material.Grass
		)
	end
	-- Boundary: keep players on the island.
	invisibleWall(island, Vector3.new(w, 60, 2), CFrame.new(cx, 30, Z0 + 1))
	invisibleWall(island, Vector3.new(w, 60, 2), CFrame.new(cx, 30, Z1 - 1))
	invisibleWall(island, Vector3.new(2, 60, d), CFrame.new(X0 + 1, 30, cz))
	invisibleWall(island, Vector3.new(2, 60, d), CFrame.new(X1 - 1, 30, cz))
end

-- Hub -------------------------------------------------------------------------------

local PAD_STYLE = {
	Upgrade = { Color = hex("#FF8A1F"), Title = "UPGRADE BENCH", Sub = "Buy Power. Grow your mech!", Info = "" },
	Rebirth = {
		Color = hex("#B57BFF"),
		Title = "REBIRTH PAD",
		Sub = "Start small. Earn more forever.",
		Info = "+25% Scrap each time",
	},
	Shop = { Color = hex("#5DEB5A"), Title = "SHOP", Sub = "Boosts, passes & paint", Info = "" },
	Daily = { Color = hex("#FFE14D"), Title = "DAILY & WORKSHOP", Sub = "Free Scrap every day", Info = "" },
	Garage = { Color = hex("#4FB8FF"), Title = "GARAGE", Sub = "Tools & finishes", Info = "Hammer · Saw · Drill" },
}

local function buildPad(parent: Instance, id: string, position: Vector3): BasePart
	local style = PAD_STYLE[id]
	local ring = block(
		parent,
		id .. "Ring",
		Vector3.new(0.5, 13, 13),
		CFrame.new(position + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		C.Ink,
		Enum.Material.SmoothPlastic,
		Enum.PartType.Cylinder
	)
	ring.CanCollide = false
	local pad = block(
		parent,
		id,
		Vector3.new(0.6, 11.5, 11.5),
		CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		style.Color,
		Enum.Material.Neon,
		Enum.PartType.Cylinder
	)
	pad.CanCollide = false
	pad.CanTouch = false
	pad:SetAttribute("PadId", id)
	local light = Instance.new("PointLight")
	light.Color = style.Color
	light.Range = 14
	light.Brightness = 1.5
	light.Parent = pad
	padBillboard(pad, style.Title, style.Sub, style.Info, nil, 7)
	return pad
end

local function buildHubProps(hub: Instance)
	-- Upgrade bench: a workbench with a vice and tools.
	local bench = folder(hub, "UpgradeBench")
	local bx, bz = 28, 28
	block(bench, "Top", Vector3.new(12, 1, 4), CFrame.new(bx, 3.5, bz), C.Wood, Enum.Material.WoodPlanks)
	for _, x in { -5.5, 5.5 } do
		block(bench, "Leg", Vector3.new(0.8, 3, 3.4), CFrame.new(bx + x, 1.5, bz), C.SteelDark, Enum.Material.Metal)
	end
	block(bench, "Vice", Vector3.new(1.4, 1.4, 1.6), CFrame.new(bx - 3.5, 4.7, bz), hex("#2F7BEA"), Enum.Material.Metal)
	block(
		bench,
		"Wrench",
		Vector3.new(2.6, 0.2, 0.5),
		CFrame.new(bx + 1, 4.1, bz - 0.6) * CFrame.Angles(0, 0.4, 0),
		C.Steel,
		Enum.Material.Metal
	)
	block(bench, "Board", Vector3.new(12, 6, 0.4), CFrame.new(bx, 7, bz + 2.2), C.SteelDark, Enum.Material.DiamondPlate)
	MechBuilder.buildStatue(
		0,
		"Hammer",
		nil,
		0.9,
		CFrame.new(bx + 3.5, 3.5 + 0.9 * MechBuilder.RootHeight + 0.5, bz) * CFrame.Angles(0, math.rad(180), 0)
	).Parent =
		bench

	-- Rebirth pad: glowing pillars around the pad.
	local rebirth = folder(hub, "RebirthPillars")
	local rp = Layout.Pads[2].Position
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local pos = rp + Vector3.new(math.cos(a) * 8.5, 0, math.sin(a) * 8.5)
		deco(
			block(
				rebirth,
				"Pillar",
				Vector3.new(1.2, 5, 1.2),
				CFrame.new(pos + Vector3.new(0, 2.5, 0)),
				hex("#2B1B4A"),
				Enum.Material.Metal
			)
		)
		deco(
			block(
				rebirth,
				"Crystal",
				Vector3.new(0.9, 1.6, 0.9),
				CFrame.new(pos + Vector3.new(0, 5.8, 0)) * CFrame.Angles(0, a, math.rad(45)),
				hex("#C99BFF"),
				Enum.Material.Neon
			)
		)
	end

	-- Shop stall with a striped awning.
	local shop = folder(hub, "ShopStall")
	local sp = Layout.Pads[3].Position + Vector3.new(-12, 0, 0)
	block(shop, "Counter", Vector3.new(4, 3.4, 12), CFrame.new(sp + Vector3.new(0, 1.7, 0)), hex("#2DBE2A"))
	block(shop, "CounterTop", Vector3.new(4.6, 0.5, 12.6), CFrame.new(sp + Vector3.new(0, 3.65, 0)), C.HubFloor)
	for i = 0, 5 do
		local stripe = block(
			shop,
			"Awning",
			Vector3.new(6, 0.4, 2.1),
			CFrame.new(sp + Vector3.new(0.5, 9, -5.25 + i * 2.1)) * CFrame.Angles(0, 0, math.rad(-15)),
			if i % 2 == 0 then hex("#2DBE2A") else C.HubFloor
		)
		deco(stripe)
	end
	for _, z in { -5.6, 5.6 } do
		block(
			shop,
			"Post",
			Vector3.new(0.6, 9, 0.6),
			CFrame.new(sp + Vector3.new(-1.8, 4.5, z)),
			C.SteelDark,
			Enum.Material.Metal
		)
	end

	-- Workshop shed beside the daily pad.
	local shed = folder(hub, "Workshop")
	local wp = Layout.Pads[4].Position + Vector3.new(14, 0, 0)
	block(
		shed,
		"Shed",
		Vector3.new(10, 10, 14),
		CFrame.new(wp + Vector3.new(0, 5, 0)),
		hex("#E07A3A"),
		Enum.Material.Metal
	)
	block(
		shed,
		"Roof",
		Vector3.new(11, 1, 15),
		CFrame.new(wp + Vector3.new(0, 10.5, 0)),
		C.SteelDark,
		Enum.Material.CorrodedMetal
	)
	local door = block(
		shed,
		"Door",
		Vector3.new(0.4, 7, 9),
		CFrame.new(wp + Vector3.new(-5.1, 3.5, 0)),
		C.Steel,
		Enum.Material.DiamondPlate
	)
	surfaceSign(door, Enum.NormalId.Left, function(gui)
		text(gui, {
			Text = "WORKSHOP",
			Size = UDim2.fromScale(0.9, 0.22),
			Position = UDim2.fromScale(0.05, 0.05),
			Color = hex("#FFE14D"),
		})
		text(gui, {
			Text = "40 Scrap / hour · even offline",
			Size = UDim2.fromScale(0.9, 0.12),
			Position = UDim2.fromScale(0.05, 0.28),
			Font = Theme.Font.Body,
			Stroke = 2,
		})
	end)

	-- Garage paint booth.
	local garage = folder(hub, "PaintBooth")
	local gp = Layout.Pads[5].Position + Vector3.new(0, 0, 9)
	block(garage, "BoothBack", Vector3.new(16, 9, 1), CFrame.new(gp + Vector3.new(0, 4.5, 0)), C.HubTrim)
	local swatches = { hex("#FF8A1F"), hex("#7BEA2E"), hex("#FFC61A"), hex("#D7DEE8"), hex("#2A2A30"), hex("#45D4FF") }
	for i, color in swatches do
		deco(
			block(
				garage,
				"Swatch",
				Vector3.new(1.8, 1.8, 0.3),
				CFrame.new(gp + Vector3.new(-5.5 + (i - 1) * 2.2, 6.5, -0.6)),
				color
			)
		)
	end
end

local function buildHub(world: Instance): { [string]: BasePart }
	local hub = folder(world, "Hub")
	local x0, x1 = 0, Layout.AreaWidth
	local z0, z1 = Layout.HubZ0, Layout.HubZ1
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	block(hub, "Floor", Vector3.new(x1 - x0, 1, z1 - z0), CFrame.new(cx, -0.45, cz), C.HubFloor, Enum.Material.Plastic).TopSurface =
		Enum.SurfaceType.Studs
	-- Blue studded trim around the hub, like a toy baseplate.
	for _, z in { z0 + 1, z1 - 1 } do
		block(hub, "Trim", Vector3.new(x1 - x0, 1.2, 2), CFrame.new(cx, -0.3, z), C.HubTrim).TopSurface =
			Enum.SurfaceType.Studs
	end
	for _, x in { x0 + 1, x1 - 1 } do
		block(hub, "Trim", Vector3.new(2, 1.2, z1 - z0), CFrame.new(x, -0.3, cz), C.HubTrim).TopSurface =
			Enum.SurfaceType.Studs
	end
	-- Railings on the hub's outer edges (west and south); east blocks the shortcut past Gate 1.
	block(hub, "RailSouth", Vector3.new(x1 - x0, 3, 1), CFrame.new(cx, 1.5, z1 + 0.5), C.HubTrim)
	block(hub, "RailWest", Vector3.new(1, 3, z1 - z0), CFrame.new(x0 - 0.5, 1.5, cz), C.HubTrim)
	block(hub, "RailEast", Vector3.new(1, 3, z1 - z0), CFrame.new(x1 + 0.5, 1.5, cz), C.HubTrim)
	invisibleWall(hub, Vector3.new(4, 40, z1 - z0 + 8), CFrame.new(x1 + 2, 20, cz + 4))

	-- Flat invisible spawn (players are moved to their own lane right after spawning)
	-- with a glowing ring on top for looks.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = CFrame.new(Layout.SpawnPosition + Vector3.new(0, 0.2, 0))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = hub
	for _, child in spawn:GetChildren() do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
	deco(
		block(
			hub,
			"SpawnRing",
			Vector3.new(0.5, 11, 11),
			CFrame.new(Layout.SpawnPosition + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Theme.ScreenBlue,
			Enum.Material.Neon,
			Enum.PartType.Cylinder
		)
	)

	local pads = folder(hub, "Pads")
	local padParts = {}
	for _, pad in Layout.Pads do
		padParts[pad.Id] = buildPad(pads, pad.Id, pad.Position)
	end
	buildHubProps(hub)

	-- Big title wall facing the yard (like the sign walls in popular simulators).
	local wall = block(
		hub,
		"TitleWall",
		Vector3.new(60, 22, 3),
		CFrame.new(cx, 11, z1 - 4),
		hex("#FFFFFF"),
		Enum.Material.Plastic
	)
	wall.TopSurface = Enum.SurfaceType.Studs
	local frame = block(hub, "TitleFrame", Vector3.new(64, 26, 2), CFrame.new(cx, 12, z1 - 3), C.HubTrim)
	frame.TopSurface = Enum.SurfaceType.Studs
	surfaceSign(wall, Enum.NormalId.Front, function(gui)
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(0.92, 0.84)
		bg.Position = UDim2.fromScale(0.04, 0.08)
		bg.BackgroundColor3 = Theme.Swatch.Navy.Bottom
		bg.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 40)
		corner.Parent = bg
		text(bg, {
			Text = "PICK YOUR MECH!",
			Size = UDim2.fromScale(0.9, 0.34),
			Position = UDim2.fromScale(0.05, 0.06),
			Color = hex("#FFB24A"),
			Stroke = 8,
		})
		text(bg, {
			Text = Config.Tagline,
			Size = UDim2.fromScale(0.86, 0.15),
			Position = UDim2.fromScale(0.07, 0.42),
			Font = Theme.Font.Body,
			Stroke = 5,
		})
		text(bg, {
			Text = "👍 LIKE THE GAME FOR NEW YARDS!",
			Size = UDim2.fromScale(0.8, 0.13),
			Position = UDim2.fromScale(0.1, 0.64),
			Color = Theme.Good,
			Stroke = 5,
		})
		text(bg, {
			Text = "⭐ FAVORITE TO KEEP YOUR MECH CLOSE",
			Size = UDim2.fromScale(0.8, 0.11),
			Position = UDim2.fromScale(0.1, 0.8),
			Color = hex("#FFE14D"),
			Stroke = 4,
		})
	end)
	frame.Parent = hub

	-- Next-form preview: a Crusher statue in the hub shows the first big goal.
	local statue = MechBuilder.buildStatue(
		4,
		"Hammer",
		nil,
		2.2,
		CFrame.new(10, 2.2 * MechBuilder.RootHeight + 1.2, z1 - 36) * CFrame.Angles(0, math.rad(200), 0),
		120
	)
	statue.Name = "CrusherPreview"
	statue.Parent = hub
	block(
		hub,
		"Pedestal",
		Vector3.new(9, 1.2, 9),
		CFrame.new(10, 0.6, z1 - 36),
		C.SteelDark,
		Enum.Material.DiamondPlate
	)
	local tag = deco(block(hub, "PreviewTag", Vector3.new(1, 1, 1), CFrame.new(10, 16, z1 - 36), C.Ink))
	tag.Transparency = 1
	padBillboard(tag, "CRUSHER FORM", "Reach Power 25", "4 upgrades away!", hex("#FFB24A"), 0)
	return padParts
end

-- Corridor, yards, lanes ------------------------------------------------------------

local function buildCorridor(world: Instance)
	local corridor = folder(world, "Corridor")
	local w = Layout.TotalWidth
	block(
		corridor,
		"Road",
		Vector3.new(w, 1, Layout.CorridorWidth),
		CFrame.new(w / 2, -0.4, Layout.CorridorZ),
		C.Road,
		Enum.Material.Asphalt
	)
	for x = 4, w - 4, 10 do
		deco(
			block(
				corridor,
				"Dash",
				Vector3.new(5, 0.12, 0.6),
				CFrame.new(x, 0.12, Layout.CorridorZ),
				C.Hazard,
				Enum.Material.SmoothPlastic
			)
		)
	end
	-- Fence south of the corridor east of the hub (the Mega Mech plaza stays view-only).
	block(
		corridor,
		"SouthRail",
		Vector3.new(w - Layout.AreaWidth, 3, 1),
		CFrame.new((w + Layout.AreaWidth) / 2, 1.5, Layout.CorridorWidth + 0.5),
		C.Hazard
	)
	invisibleWall(
		corridor,
		Vector3.new(w - Layout.AreaWidth, 40, 2),
		CFrame.new((w + Layout.AreaWidth) / 2, 20, Layout.CorridorWidth + 1)
	)
end

local function laneSign(parent: Instance, area: number, lane: number): TextLabel
	local x = Layout.laneX(area, lane)
	local color = Theme.LaneColors[lane]
	local half = Layout.LaneWidth / 2 - 0.6
	for side = -1, 1, 2 do
		block(
			parent,
			"SignPost",
			Vector3.new(0.8, 9, 0.8),
			CFrame.new(x + side * half, 4.5, -1),
			C.SteelDark,
			Enum.Material.Metal
		)
	end
	local beam = block(parent, "Sign", Vector3.new(Layout.LaneWidth - 1, 2.6, 0.6), CFrame.new(x, 9.5, -1), C.Ink)
	beam.Name = string.format("Lane%d_Area%d", lane, area)
	deco(
		block(
			parent,
			"SignGlow",
			Vector3.new(Layout.LaneWidth - 1, 0.3, 0.7),
			CFrame.new(x, 8.1, -1),
			color,
			Enum.Material.Neon
		)
	)
	local nameLabel
	surfaceSign(beam, Enum.NormalId.Back, function(gui)
		text(gui, {
			Name = "Lane",
			Text = "LANE " .. lane,
			Size = UDim2.fromScale(0.3, 0.8),
			Position = UDim2.fromScale(0.02, 0.1),
			Color = color,
			Stroke = 4,
		})
		nameLabel = text(gui, {
			Name = "Owner",
			Text = "OPEN LANE",
			Size = UDim2.fromScale(0.64, 0.7),
			Position = UDim2.fromScale(0.34, 0.15),
			Stroke = 4,
		})
	end)
	surfaceSign(beam, Enum.NormalId.Front, function(gui)
		text(gui, {
			Name = "Lane",
			Text = "LANE " .. lane,
			Size = UDim2.fromScale(0.96, 0.8),
			Position = UDim2.fromScale(0.02, 0.1),
			Color = color,
			Stroke = 4,
		})
	end)
	return nameLabel
end

local function buildArea(world: Instance, area: number, laneLabels: { [number]: { TextLabel } })
	local def = Config.Areas[area]
	local f = folder(world, "Area" .. area)
	local x0, x1 = Layout.areaX0(area), Layout.areaX1(area)
	local depth = Layout.LaneDepth
	local cx = (x0 + x1) / 2
	local floorColor = ({ hex("#B9A27E"), hex("#A7B0B9"), hex("#8C7F72") })[area]
	block(
		f,
		"Floor",
		Vector3.new(x1 - x0, 1, depth),
		CFrame.new(cx, -0.45, -depth / 2),
		floorColor,
		Enum.Material.Ground
	)

	for lane = 1, Layout.Lanes do
		local lx = Layout.laneX(area, lane)
		local color = Theme.LaneColors[lane]
		local shade = if lane % 2 == 0 then C.Concrete else C.ConcreteDark
		block(
			f,
			"LaneFloor",
			Vector3.new(Layout.LaneWidth - 2, 0.2, depth - 6),
			CFrame.new(lx, 0.02, -depth / 2 - 2),
			shade,
			Enum.Material.Concrete
		)
		for side = -1, 1, 2 do
			deco(
				block(
					f,
					"LaneEdge",
					Vector3.new(0.35, 0.22, depth - 6),
					CFrame.new(lx + side * (Layout.LaneWidth / 2 - 1.2), 0.05, -depth / 2 - 2),
					color,
					Enum.Material.Neon
				)
			)
		end
		-- Lane number painted near the mouth.
		local marker = block(f, "LaneNumber", Vector3.new(8, 0.1, 8), CFrame.new(lx, 0.13, -5), shade)
		deco(marker)
		marker.Transparency = 1
		surfaceSign(marker, Enum.NormalId.Top, function(gui)
			text(gui, { Text = tostring(lane), Color = color, Stroke = 5 })
		end)
		laneLabels[lane] = laneLabels[lane] or {}
		table.insert(laneLabels[lane], laneSign(f, area, lane))
	end

	-- Dividers between lanes: low rails so neighbours stay visible.
	for k = 1, Layout.Lanes - 1 do
		local x = x0 + k * Layout.LaneWidth
		for z = -depth + 2, -4, 13 do
			block(f, "FencePost", Vector3.new(0.5, 4, 0.5), CFrame.new(x, 2, z), C.Steel, Enum.Material.Metal)
		end
		for _, y in { 1.6, 3.6 } do
			block(
				f,
				"FenceRail",
				Vector3.new(0.3, 0.3, depth - 6),
				CFrame.new(x, y, -depth / 2 - 1),
				C.Steel,
				Enum.Material.Metal
			)
		end
		invisibleWall(f, Vector3.new(0.6, 30, depth - 6), CFrame.new(x, 15, -depth / 2 - 1))
	end

	-- Perimeter: corrugated north wall + outer side walls.
	local h = Layout.WallHeight
	local panel = 0
	for x = x0, x1 - 6, 6 do
		panel += 1
		block(
			f,
			"WallPanel",
			Vector3.new(6, h, 1.5),
			CFrame.new(x + 3, h / 2, -depth - 0.75),
			if panel % 2 == 0 then C.Wall else C.WallAlt,
			Enum.Material.CorrodedMetal
		)
	end
	deco(block(f, "WallStripe", Vector3.new(x1 - x0, 1, 1.7), CFrame.new(cx, h - 0.5, -depth - 0.75), C.Hazard))
	if area == 1 then
		block(
			f,
			"WestWall",
			Vector3.new(1.5, h, depth + 2),
			CFrame.new(x0 - 0.75, h / 2, -depth / 2 + 1),
			C.Wall,
			Enum.Material.CorrodedMetal
		)
	end
	if area == 3 then
		block(
			f,
			"EastWall",
			Vector3.new(1.5, h, depth + Layout.CorridorWidth + 2),
			CFrame.new(x1 + 0.75, h / 2, (-depth + Layout.CorridorWidth) / 2),
			C.Wall,
			Enum.Material.CorrodedMetal
		)
	end

	-- Area title floating over the corridor.
	local anchor = deco(block(f, "TitleAnchor", Vector3.new(1, 1, 1), CFrame.new(x0 + 26, 18, -2), C.Ink))
	anchor.Transparency = 1
	local gui = padBillboard(
		anchor,
		string.upper(def.Name),
		def.Blurb,
		string.format("%s HP · %d Scrap each", tostring(def.HP), def.Scrap),
		hex("#FFB24A"),
		0
	)
	gui.Size = UDim2.fromOffset(420, 160)
	gui.MaxDistance = 400

	-- Floodlights on the north wall.
	for _, x in { x0 + 20, cx, x1 - 20 } do
		local post = block(
			f,
			"LightPost",
			Vector3.new(1, 22, 1),
			CFrame.new(x, 11, -depth - 3),
			C.SteelDark,
			Enum.Material.Metal
		)
		local lamp = block(
			f,
			"Lamp",
			Vector3.new(4, 1.4, 2),
			CFrame.new(x, 22.5, -depth - 2) * CFrame.Angles(math.rad(-25), 0, 0),
			hex("#FFF4C9"),
			Enum.Material.Neon
		)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 70
		spot.Range = 40
		spot.Brightness = 1.2
		spot.Color = hex("#FFF4C9")
		spot.Parent = lamp
		post.CastShadow = false
	end
end

-- Gates ----------------------------------------------------------------------------

local function buildGate(world: Instance, gate: number): BasePart
	local area = gate + 1
	local def = Config.Areas[area]
	local f = folder(world, "Gate" .. gate)
	local gx = Layout.gateX(gate)
	local h = Layout.WallHeight
	local zMid = Layout.CorridorZ
	-- Wall between the two areas, north of the corridor.
	block(
		f,
		"DividerWall",
		Vector3.new(Layout.AreaGap, h, Layout.LaneDepth + 1.5),
		CFrame.new(gx, h / 2, -Layout.LaneDepth / 2 - 0.75),
		C.WallAlt,
		Enum.Material.CorrodedMetal
	)
	deco(
		block(
			f,
			"DividerStripe",
			Vector3.new(Layout.AreaGap + 0.2, 1, Layout.LaneDepth + 1.7),
			CFrame.new(gx, h - 0.5, -Layout.LaneDepth / 2 - 0.75),
			C.Hazard
		)
	)
	-- Gate frame over the corridor.
	for _, z in { -1, Layout.CorridorWidth + 1 } do
		block(f, "GatePost", Vector3.new(4, h + 4, 2), CFrame.new(gx, (h + 4) / 2, z), C.SteelDark, Enum.Material.Metal)
		for i = 0, 4 do
			deco(
				block(
					f,
					"PostStripe",
					Vector3.new(4.1, 1.2, 2.1),
					CFrame.new(gx, 2 + i * 3.4, z) * CFrame.Angles(math.rad(25), 0, 0),
					C.Hazard
				)
			)
		end
	end
	local beam = block(
		f,
		"GateBeam",
		Vector3.new(4, 4, Layout.CorridorWidth + 4),
		CFrame.new(gx, h + 2, zMid),
		C.Ink,
		Enum.Material.Metal
	)
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		surfaceSign(beam, face, function(gui)
			text(gui, {
				Text = string.upper(def.Name),
				Size = UDim2.fromScale(0.9, 0.5),
				Position = UDim2.fromScale(0.05, 0.05),
				Color = hex("#FFB24A"),
				Stroke = 4,
			})
			text(gui, {
				Text = string.format("⚡ Power %d  +  %s Scrap", def.GatePower, tostring(def.GateScrap)),
				Size = UDim2.fromScale(0.9, 0.34),
				Position = UDim2.fromScale(0.05, 0.58),
				Font = Theme.Font.Body,
				Stroke = 3,
			})
		end)
	end
	-- The barrier itself. Clients turn it off locally once they own the gate.
	local barrier = block(
		f,
		"Barrier",
		Vector3.new(1.2, h, Layout.CorridorWidth),
		CFrame.new(gx, h / 2, zMid),
		hex("#FF4D4D"),
		Enum.Material.ForceField
	)
	barrier.Transparency = 0.2
	barrier.CanTouch = false
	barrier:SetAttribute("GateArea", area)
	padBillboard(
		barrier,
		"🔒 " .. string.upper(def.Name),
		string.format("Needs ⚡%d Power + %s Scrap", def.GatePower, tostring(def.GateScrap)),
		"Walk up to unlock",
		hex("#FF6B6B"),
		2
	)
	return barrier
end

-- Showcase plaza: the Mega Mech statue beyond Gate 1 shows the long-term goal.
local function buildShowcase(world: Instance)
	local f = folder(world, "Showcase")
	local cx, cz = Layout.areaX0(2) + 66, Layout.CorridorWidth + 26
	block(f, "Plaza", Vector3.new(110, 1, 40), CFrame.new(cx, -0.4, cz), C.ConcreteDark, Enum.Material.Concrete)
	block(f, "Pedestal", Vector3.new(16, 2, 16), CFrame.new(cx, 1, cz + 4), C.SteelDark, Enum.Material.DiamondPlate)
	deco(
		block(
			f,
			"PedestalGlow",
			Vector3.new(16.4, 0.4, 16.4),
			CFrame.new(cx, 2.1, cz + 4),
			hex("#FF7A00"),
			Enum.Material.Neon
		)
	)
	local scale = 3.4
	local statue = MechBuilder.buildStatue(
		9,
		"Hammer",
		nil,
		scale,
		CFrame.new(cx, 2 + scale * MechBuilder.RootHeight, cz + 4) * CFrame.Angles(0, math.rad(160), 0),
		150
	)
	statue.Name = "MegaMechStatue"
	statue.Parent = f
	local tag = deco(block(f, "Tag", Vector3.new(1, 1, 1), CFrame.new(cx, 2 + scale * 6.5, cz + 4), C.Ink))
	tag.Transparency = 1
	local gui = padBillboard(tag, "MEGA MECH", "Final form at Power 1,000", "Keep upgrading!", hex("#FFB24A"), 0)
	gui.MaxDistance = 400
	gui.Size = UDim2.fromOffset(360, 140)
	-- Decorative crane behind the Crusher Yard.
	local crane = folder(world, "Crane")
	local kx, kz = Layout.areaX0(3) + 100, -Layout.LaneDepth - 12
	for i = 0, 9 do
		block(
			crane,
			"Mast",
			Vector3.new(3, 4, 3),
			CFrame.new(kx, 2 + i * 4, kz),
			if i % 2 == 0 then C.Hazard else C.Ink,
			Enum.Material.Metal
		)
	end
	block(crane, "Jib", Vector3.new(44, 2.4, 2.4), CFrame.new(kx - 16, 41, kz), C.Hazard, Enum.Material.Metal)
	block(crane, "Cab", Vector3.new(4, 3.4, 4), CFrame.new(kx, 39, kz + 3), C.SteelDark, Enum.Material.Metal)
	block(crane, "Cable", Vector3.new(0.2, 14, 0.2), CFrame.new(kx - 32, 33, kz), C.Ink)
	block(
		crane,
		"Magnet",
		Vector3.new(1.6, 4.4, 4.4),
		CFrame.new(kx - 32, 25.4, kz) * CFrame.Angles(0, 0, math.rad(90)),
		C.SteelDark,
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
end

-- Static junk heaps outside the lanes for atmosphere (not smashable).
local function buildDecorHeaps(world: Instance)
	local f = folder(world, "DecorHeaps")
	local spots = {
		Vector3.new(-14, 0, -40),
		Vector3.new(-14, 0, -90),
		Vector3.new(Layout.TotalWidth + 14, 0, -30),
		Vector3.new(Layout.TotalWidth + 14, 0, -80),
		Vector3.new(Layout.areaX0(3) + 40, 0, Layout.CorridorWidth + 20),
		Vector3.new(Layout.areaX0(3) + 90, 0, Layout.CorridorWidth + 30),
	}
	local colors = { hex("#9C5B35"), hex("#7A4A2E"), hex("#6E737A"), hex("#8A6A4A") }
	for _, spot in spots do
		for i = 1, 14 do
			local s = rng:NextNumber(1.5, 4)
			local r = (1 - i / 14) * 6
			local a = rng:NextNumber(0, math.pi * 2)
			deco(
				block(
					f,
					"Junk",
					Vector3.new(s, s * 0.6, s * 1.2),
					CFrame.new(spot + Vector3.new(math.cos(a) * r, i * 0.5, math.sin(a) * r))
						* CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6), rng:NextNumber(-0.6, 0.6)),
					colors[(i % #colors) + 1],
					Enum.Material.CorrodedMetal
				)
			)
		end
	end
end

-- Blocky trees on the open grass so the island doesn't feel bare.
local function buildTrees(world: Instance)
	local f = folder(world, "Trees")
	local spots = {}
	for x = Layout.areaX0(2) - 4, Layout.TotalWidth + 14, 19 do
		table.insert(spots, Vector3.new(x + rng:NextNumber(-4, 4), 0, Layout.HubZ1 + rng:NextNumber(-12, 6)))
	end
	for x = Layout.areaX0(3) + 10, Layout.TotalWidth - 10, 24 do
		table.insert(spots, Vector3.new(x + rng:NextNumber(-4, 4), 0, Layout.CorridorWidth + rng:NextNumber(52, 62)))
	end
	for z = -Layout.LaneDepth + 6, Layout.HubZ1, 22 do
		table.insert(spots, Vector3.new(-12 + rng:NextNumber(-3, 3), 0, z))
	end
	local leaves = { hex("#4CAF3A"), hex("#5CC447"), hex("#3E9A33") }
	for _, spot in spots do
		local h = rng:NextNumber(5, 8)
		deco(
			block(
				f,
				"Trunk",
				Vector3.new(1.4, h, 1.4),
				CFrame.new(spot + Vector3.new(0, h / 2, 0)),
				hex("#7A5228"),
				Enum.Material.Wood
			)
		)
		local size = rng:NextNumber(5, 7)
		local color = leaves[rng:NextInteger(1, #leaves)]
		block(
			f,
			"Leaves",
			Vector3.new(size, size * 0.8, size),
			CFrame.new(spot + Vector3.new(0, h + size * 0.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0),
			color,
			Enum.Material.Grass
		)
		block(
			f,
			"LeavesTop",
			Vector3.new(size * 0.6, size * 0.5, size * 0.6),
			CFrame.new(spot + Vector3.new(0, h + size * 0.85, 0)),
			color,
			Enum.Material.Grass
		)
	end
end

export type World = {
	Root: Folder,
	Pads: { [string]: BasePart },
	Barriers: { [number]: BasePart },
	LaneLabels: { [number]: { TextLabel } },
	Targets: Folder,
}

function WorldBuilder.build(): World
	local existing = Workspace:FindFirstChild("World")
	if existing then
		existing:Destroy()
	end
	setupLighting()
	local world = Instance.new("Folder")
	world.Name = "World"
	buildIsland(world)
	local pads = buildHub(world)
	buildCorridor(world)
	local laneLabels = {}
	for area = 1, 3 do
		buildArea(world, area, laneLabels)
	end
	local barriers = {}
	for gate = 1, 2 do
		barriers[gate + 1] = buildGate(world, gate)
	end
	buildShowcase(world)
	buildDecorHeaps(world)
	buildTrees(world)
	local targets = folder(world, "Targets")
	world.Parent = Workspace
	return { Root = world, Pads = pads, Barriers = barriers, LaneLabels = laneLabels, Targets = targets }
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Pick Your Mech! server entry point. Services start in dependency order.

local Services = script.Parent.Services

local order = {
	"DataService",
	"WorldService",
	"StateService",
	"LaneService",
	"MechService",
	"TargetService",
	"CombatService",
	"ShopService",
	"NetService",
}

for _, name in order do
	local service = require(Services:WaitForChild(name))
	if service.init then
		local started = os.clock()
		service.init()
		if os.clock() - started > 0.5 then
			print(string.format("[PickYourMech] %s took %.2fs", name, os.clock() - started))
		end
	end
end

require(Services.StateService).start()
print("[PickYourMech] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[-- Thin, failure-proof wrappers around AnalyticsService and BadgeService.
-- Tracks the concept's funnel: first smash, first upgrade, first form, each gate, rebirth.

local AnalyticsService = game:GetService("AnalyticsService")
local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")

local Analytics = {}

-- In the order a free player reaches them (Gate 1 needs Power 10, the Crusher form
-- Power 25; the Mega Mech form is Power 250, which is also Gate 2's requirement).
local FUNNEL = {
	Joined = 1,
	PickedTool = 2,
	FirstSmash = 3,
	FirstUpgrade = 4,
	ApplianceRow = 5,
	CrusherForm = 6,
	MegaMech = 7,
	CrusherYard = 8,
	FirstRebirth = 9,
}

-- Logs a funnel step once per player (remembered in saved data).
function Analytics.funnel(player: Player, data, step: string)
	if data.Funnel[step] then
		return
	end
	data.Funnel[step] = true
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, FUNNEL[step], step)
	end)
end

function Analytics.economy(
	player: Player,
	isSource: boolean,
	amount: number,
	balance: number,
	transactionType: Enum.AnalyticsEconomyTransactionType,
	sku: string
)
	if amount <= 0 then
		return
	end
	pcall(function()
		AnalyticsService:LogEconomyEvent(
			player,
			if isSource then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink,
			"Scrap",
			amount,
			balance,
			transactionType.Name,
			sku
		)
	end)
end

function Analytics.progression(player: Player, path: string, level: number, name: string)
	pcall(function()
		AnalyticsService:LogProgressionCompleteEvent(player, path, level, name)
	end)
end

function Analytics.badge(player: Player, badgeId: number)
	if badgeId == 0 then
		return
	end
	task.spawn(function()
		local ok, has = pcall(function()
			return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
		end)
		if ok and not has then
			pcall(function()
				BadgeService:AwardBadge(player.UserId, badgeId)
			end)
		end
	end)
end

-- Smash income is frequent, so it is summed and logged once a minute per player.
local pendingSmash: { [Player]: number } = {}

function Analytics.smashIncome(player: Player, amount: number)
	pendingSmash[player] = (pendingSmash[player] or 0) + amount
end

function Analytics.flush(getBalance: (Player) -> number?)
	for player, amount in pendingSmash do
		pendingSmash[player] = nil
		local balance = getBalance(player)
		if balance and player.Parent then
			Analytics.economy(player, true, amount, balance, Enum.AnalyticsEconomyTransactionType.Gameplay, "Smash")
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	pendingSmash[player] = nil
end)

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[-- Free auto-hit: while a player stands within reach of their own junk, they hit it
-- every 0.5 s for their current Power. The first hit lands one interval after a target
-- comes into reach. Open blocking menus pause salvage.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local StateService = require(script.Parent.StateService)
local TargetService = require(script.Parent.TargetService)

local CombatService = {}

type HitState = { target: Model?, nextHit: number? }
local states: { [Player]: HitState } = {}

local function step(now: number)
	local interval = Config.Combat.HitInterval
	for player, session in StateService.all() do
		local st = states[player]
		if not st then
			st = { target = nil, nextHit = nil }
			states[player] = st
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 or not session.Lane or session.InMenu then
			st.target, st.nextHit = nil, nil
			continue
		end
		local position = root.Position
		local target = st.target
		if target and not TargetService.inReach(session, target, position) then
			target = nil
		end
		if not target then
			target = TargetService.nearestInReach(session, position)
		end
		if target ~= st.target then
			st.target = target
			st.nextHit = if target then now + interval else nil
		end
		if target and st.nextHit and now >= st.nextHit then
			TargetService.damage(player, session, target, StateService.power(session))
			local nextHit = st.nextHit + interval
			st.nextHit = if nextHit < now then now + interval else nextHit
		end
	end
end

function CombatService.init()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < Config.Combat.TickRate then
			return
		end
		accumulator = 0
		step(os.clock())
	end)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Session-locked saves. One server owns a player's data at a time: loading writes a
-- lock (JobId + time), autosaves refresh it every minute, leaving releases it.
-- A live lock is never taken: the new server waits for the old one to release. Only a
-- lock that hasn't been refreshed for LOCK_EXPIRE (a crashed server) is taken over.
-- In Studio without API access the service falls back to in-memory data (with a warning).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local LOCK_EXPIRE = Config.AutosaveSeconds * 3 -- live servers refresh their lock every autosave
local LOAD_ATTEMPTS = 16 -- x 4 s: plenty of time for another server's release save
local MAX_RECEIPTS = 60

local TEMPLATE = {
	Version = 1, -- schema version, for future migrations
	Scrap = 0,
	Level = 0,
	Rebirths = 0,
	Gates = { Appliance = false, Crusher = false },
	CrusherDestroys = 0,
	Tool = "Hammer",
	ToolChosen = false,
	Finish = "Default",
	Finishes = { Default = true },
	BoostCharges = 0,
	BoostRemaining = 0,
	Workshop = { Stored = 0, Updated = 0 },
	Daily = { Day = 0, Progress = 0, Claimed = false },
	Stamps = 0,
	StarterGranted = false,
	Receipts = {},
	Stats = { Destroys = 0, ScrapEarned = 0, Upgrades = 0, PlaySeconds = 0 },
	Funnel = {},
}

type Profile = { Data: any, Saving: boolean, Dirty: boolean, Released: boolean }

local profiles: { [Player]: Profile } = {}
local releasing: { [number]: boolean } = {} -- userId -> release save in flight on this server
local store: DataStore? = nil
local useMemory = false

local function deepCopy(t)
	local out = {}
	for k, v in t do
		out[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return out
end

-- Fill in fields added after a player's data was first saved.
local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = if type(v) == "table" then deepCopy(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function update(key: string, transform: (any) -> any, attempts: number): (boolean, any)
	if useMemory or not store then
		return true, nil
	end
	for attempt = 1, attempts do
		local ok, result = pcall(function()
			return (store :: DataStore):UpdateAsync(key, transform)
		end)
		if ok then
			return true, result
		end
		warn(string.format("[DataService] UpdateAsync failed for %s (attempt %d): %s", key, attempt, tostring(result)))
		task.wait(math.min(2 ^ attempt, 10))
	end
	return false, nil
end

function DataService.init()
	local ok, result = pcall(function()
		local ds = DataStoreService:GetDataStore(Config.DataStoreName)
		ds:GetAsync("__probe")
		return ds
	end)
	if ok then
		store = result
	else
		useMemory = true
		warn(
			"[DataService] DataStores unavailable (" .. tostring(result) .. "). Using in-memory data for this session."
		)
		if RunService:IsStudio() then
			warn("[DataService] Publish the place and enable 'Studio Access to API Services' to test saving.")
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in profiles do
				task.spawn(DataService.save, player, false)
			end
		end
	end)
end

function DataService.load(player: Player): any?
	local key = keyFor(player)
	local data = nil
	-- Rejoined this same server before the previous session finished saving: wait for it.
	local waited = 0
	while releasing[player.UserId] and waited < 30 do
		waited += task.wait(0.2)
	end
	if useMemory then
		data = reconcile({}, TEMPLATE)
	else
		for _ = 1, LOAD_ATTEMPTS do
			local locked = false
			local ok = update(key, function(record)
				record = record or {}
				local lock = record.Lock
				local fresh = lock and lock.JobId ~= game.JobId and (os.time() - (lock.Time or 0)) < LOCK_EXPIRE
				if fresh then
					locked = true
					return nil -- leave the record untouched and try again shortly
				end
				locked = false
				record.Data = reconcile(record.Data or {}, TEMPLATE)
				record.Lock = { JobId = game.JobId, Time = os.time() }
				data = record.Data
				return record
			end, 3)
			if not ok then
				break
			end
			if not locked then
				break
			end
			data = nil
			task.wait(4)
			if not player.Parent then
				return nil
			end
		end
	end
	if not data then
		return nil
	end
	if not player.Parent then
		-- They left while we were loading: release the lock we just took.
		update(key, function(record)
			if record and record.Lock and record.Lock.JobId == game.JobId then
				record.Lock = nil
				return record
			end
			return nil
		end, 2)
		return nil
	end
	if data.Workshop.Updated == 0 then
		data.Workshop.Updated = os.time()
	end
	profiles[player] = { Data = data, Saving = false, Dirty = false, Released = false }
	return data
end

function DataService.get(player: Player): any?
	local profile = profiles[player]
	return profile and profile.Data
end

-- Saves the player's data. `release` drops the session lock (on leave / shutdown).
function DataService.save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or profile.Released then
		return false
	end
	if profile.Saving then
		-- Coalesce: wait for the in-flight save, then save again with the latest data.
		profile.Dirty = true
		while profile.Saving do
			task.wait(0.1)
		end
		if profile.Released then
			return false
		end
	end
	profile.Saving = true
	profile.Dirty = false
	if release then
		profile.Released = true
		releasing[player.UserId] = true
	end
	local stolen = false
	local ok = update(keyFor(player), function(record)
		record = record or {}
		if record.Lock and record.Lock.JobId ~= game.JobId then
			stolen = true
			return nil -- another server owns this session now; never overwrite it
		end
		record.Data = profile.Data
		record.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return record
	end, if release then 5 else 3)
	profile.Saving = false
	if release then
		profiles[player] = nil
		releasing[player.UserId] = nil
	end
	if stolen then
		warn("[DataService] Session for " .. player.Name .. " was taken over by another server.")
		profiles[player] = nil
		if player.Parent then
			player:Kick("Your progress was opened on another server. Please rejoin.")
		end
		return false
	end
	return ok
end

function DataService.release(player: Player)
	DataService.save(player, true)
end

-- Receipt bookkeeping for developer products: each PurchaseId is granted once.
function DataService.hasReceipt(data, purchaseId: string): boolean
	return table.find(data.Receipts, purchaseId) ~= nil
end

function DataService.addReceipt(data, purchaseId: string)
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
end

function DataService.usingMemory(): boolean
	return useMemory
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">LaneService</string>
            <string name="Source"><![CDATA[-- Six lanes, one per player. Lanes are handed out on join and freed on leave.
-- The lane signs in every yard show the owner (gold with a crown for Foundry VIP).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Layout = require(Shared.Layout)
local Signal = require(Shared.Signal)

local StateService = require(script.Parent.StateService)
local WorldService = require(script.Parent.WorldService)

local LaneService = {}

LaneService.Assigned = Signal.new() -- (player, lane)
LaneService.Freed = Signal.new() -- (lane)

local owners: { [number]: Player } = {}

local GOLD = Color3.fromHex("#FFD12E")

function LaneService.refreshSign(lane: number)
	local labels = WorldService.get().LaneLabels[lane]
	if not labels then
		return
	end
	local owner = owners[lane]
	local session = owner and StateService.get(owner)
	local vip = session ~= nil and session.Passes.FoundryVIP == true
	for _, label in labels do
		if owner then
			label.Text = (if vip then "👑 " else "") .. owner.DisplayName
			label.TextColor3 = if vip then GOLD else Color3.new(1, 1, 1)
		else
			label.Text = "OPEN LANE"
			label.TextColor3 = Color3.fromHex("#B8C4DA")
		end
	end
end

function LaneService.ownerOf(lane: number): Player?
	return owners[lane]
end

function LaneService.laneOf(player: Player): number?
	for lane, owner in owners do
		if owner == player then
			return lane
		end
	end
	return nil
end

local function tryAssign(player: Player, session): boolean
	if session.Lane then
		return true
	end
	for lane = 1, Layout.Lanes do
		if not owners[lane] then
			owners[lane] = player
			session.Lane = lane
			LaneService.refreshSign(lane)
			StateService.push(player)
			LaneService.Assigned:Fire(player, lane)
			return true
		end
	end
	return false
end

function LaneService.init()
	StateService.Started:Connect(function(player, session)
		if not tryAssign(player, session) then
			StateService.notify(player, "Error", "Yard full", "You'll get the next free lane.")
		end
	end)
	StateService.Ended:Connect(function(player)
		local lane = LaneService.laneOf(player)
		if not lane then
			return
		end
		owners[lane] = nil
		LaneService.refreshSign(lane)
		LaneService.Freed:Fire(lane)
		-- Anyone who joined while the yard was full gets this lane.
		for waiting, session in StateService.all() do
			if not session.Lane and tryAssign(waiting, session) then
				StateService.notify(
					waiting,
					"Info",
					"Lane " .. lane .. " is yours!",
					"Head to your lane and start smashing."
				)
				break
			end
		end
	end)
end

return LaneService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">MechService</string>
            <string name="Source"><![CDATA[-- Turns each player's character into their mech: hides the avatar, scales the body to
-- the current form, welds the armor/tool on, and adds a nameplate. Rebuilt whenever the
-- player upgrades, rebirths or changes tool/finish. Players spawn in their own lane,
-- facing their junk.

local PhysicsService = game:GetService("PhysicsService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)
local MechBuilder = require(Shared.MechBuilder)
local Theme = require(Shared.Theme)

local StateService = require(script.Parent.StateService)
local LaneService = require(script.Parent.LaneService)

local MechService = {}

local GROUP = "Mechs"

local function setGroup(part: Instance)
	if part:IsA("BasePart") then
		part.CollisionGroup = GROUP
	end
end

local function nameplate(character: Model, player: Player, session)
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local old = head:FindFirstChild("Nameplate")
	if old then
		old:Destroy()
	end
	local data = session.Data
	local vip = session.Passes.FoundryVIP == true
	local scale = character:GetScale()
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate"
	gui.Size = UDim2.fromOffset(220, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.4 * scale + 0.6, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.Adornee = head
	local function line(textValue: string, y: number, h: number, color: Color3, font: Enum.Font)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, h)
		t.Position = UDim2.fromScale(0, y)
		t.Font = font
		t.TextScaled = true
		t.TextColor3 = color
		t.Text = textValue
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Ink
		stroke.Thickness = 2.5
		stroke.Parent = t
		t.Parent = gui
	end
	line(
		(if vip then "👑 " else "") .. player.DisplayName,
		0,
		0.55,
		if vip then Theme.ScrapGold else Theme.White,
		Theme.Font.Display
	)
	line(
		string.format(
			"%s · ⚡%s",
			string.upper(Economy.formFor(data.Level).Name),
			Economy.format(Economy.powerForLevel(data.Level))
		),
		0.55,
		0.42,
		Color3.fromHex("#FFB24A"),
		Theme.Font.Body
	)
	gui.Parent = head
end

-- Rebuilds the mech on the player's current character.
function MechService.refresh(player: Player)
	local session = StateService.get(player)
	local character = player.Character
	if not session or not character or not character.Parent then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local data = session.Data
	local old = character:FindFirstChild("Mech")
	if old then
		old:Destroy()
	end
	local scale = Economy.bodyScale(data.Level)
	if math.abs(character:GetScale() - scale) > 0.001 then
		local ok, err = pcall(function()
			character:ScaleTo(scale)
		end)
		if not ok then
			warn("[MechService] ScaleTo failed: " .. tostring(err))
		end
		local baseHip = humanoid:GetAttribute("BaseHipHeight")
		if baseHip and humanoid.RigType == Enum.HumanoidRigType.R15 then
			humanoid.HipHeight = baseHip * character:GetScale()
		end
	end
	local folder = MechBuilder.apply(character, data.Level, data.Tool, data.Finish)
	for _, part in folder:GetDescendants() do
		setGroup(part)
	end
	MechBuilder.hideAvatar(character)
	nameplate(character, player, session)
	character:SetAttribute("MechLevel", data.Level)
end

local function placeInLane(player: Player, character: Model)
	local session = StateService.get(player)
	local lane = session and session.Lane
	if not lane then
		return
	end
	local entrance = Layout.laneEntrance(1, lane)
	local height = MechBuilder.RootHeight * character:GetScale() + 0.5
	character:PivotTo(CFrame.new(entrance + Vector3.new(0, height, 0)))
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	-- Give the engine a moment to finish assembling the rig.
	character:WaitForChild("RightHand", 3)
	task.wait()
	if not StateService.get(player) or player.Character ~= character then
		return
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	if humanoid:GetAttribute("BaseHipHeight") == nil then
		humanoid:SetAttribute("BaseHipHeight", humanoid.HipHeight / math.max(character:GetScale(), 0.01))
	end
	for _, d in character:GetDescendants() do
		setGroup(d)
	end
	character.DescendantAdded:Connect(function(d)
		setGroup(d)
		if d:IsA("Accessory") then
			task.defer(d.Destroy, d)
		end
	end)
	MechService.refresh(player)
	placeInLane(player, character)
end

function MechService.init()
	for _, name in { GROUP, "Debris" } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	-- Mechs walk through each other; client-side debris never shoves anyone around.
	PhysicsService:CollisionGroupSetCollidable(GROUP, GROUP, false)
	PhysicsService:CollisionGroupSetCollidable("Debris", GROUP, false)
	PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)

	StateService.Started:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end)
	LaneService.Assigned:Connect(function(player)
		MechService.sendToLane(player)
	end)
	StateService.LevelChanged:Connect(MechService.refresh)
	StateService.LookChanged:Connect(MechService.refresh)
end

function MechService.sendToLane(player: Player)
	if player.Character then
		placeInLane(player, player.Character)
	end
end

return MechService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">NetService</string>
            <string name="Source"><![CDATA[-- The only client -> server entry point. Every action is whitelisted, type-checked
-- and rate-limited; handlers re-validate all game rules themselves.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local StateService = require(script.Parent.StateService)
local ProgressService = require(script.Parent.ProgressService)
local ShopService = require(script.Parent.ShopService)

local Request = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Request") :: RemoteFunction

local NetService = {}

local MIN_INTERVAL = 0.15

local handlers: { [string]: { arg: string?, fn: (Player, any) -> (boolean, string?) } } = {
	Upgrade = { fn = ProgressService.upgrade },
	UnlockGate = { arg = "number", fn = ProgressService.unlockGate },
	Rebirth = { fn = ProgressService.rebirth },
	ClaimWorkshop = { fn = ProgressService.claimWorkshop },
	ClaimDaily = { fn = ProgressService.claimDaily },
	SelectTool = { arg = "string", fn = ProgressService.selectTool },
	SelectFinish = { arg = "string", fn = ProgressService.selectFinish },
	CraftWorker = { fn = ProgressService.craftWorker },
	Buy = { arg = "string", fn = ShopService.buy },
	ActivateBoost = { fn = ShopService.activateBoost },
	Sync = {
		fn = function(player)
			StateService.push(player)
			return true
		end,
	},
	Menu = {
		arg = "boolean",
		fn = function(player, open)
			local session = StateService.get(player)
			if session then
				session.InMenu = open
			end
			return true
		end,
	},
}

local lastCall: { [Player]: { [string]: number } } = {}

function NetService.init()
	Request.OnServerInvoke = function(player: Player, action: any, arg: any)
		if type(action) ~= "string" then
			return false
		end
		local handler = handlers[action]
		if not handler then
			return false
		end
		if handler.arg and type(arg) ~= handler.arg then
			return false
		end
		if type(arg) == "string" and #arg > 40 then
			return false
		end
		local calls = lastCall[player]
		if not calls then
			calls = {}
			lastCall[player] = calls
		end
		local now = os.clock()
		if action ~= "Menu" and calls[action] and now - calls[action] < MIN_INTERVAL then
			return false, "Slow down!"
		end
		calls[action] = now
		if not StateService.get(player) then
			return false, "Still loading your mech..."
		end
		local ok, result, message = pcall(handler.fn, player, arg)
		if not ok then
			warn("[NetService] " .. action .. " failed: " .. tostring(result))
			return false, "Something went wrong. Try again."
		end
		return result, message
	end
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

return NetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[-- Everything the player spends Scrap on or claims: Power upgrades, gates, rebirth,
-- workshop, daily contract and the garage. Every rule is checked here on the server.
-- Handlers return (ok, message) for the client to show.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local StateService = require(script.Parent.StateService)
local MechService = require(script.Parent.MechService)
local Analytics = require(script.Parent.Analytics)

local ProgressService = {}

local TX = Enum.AnalyticsEconomyTransactionType

local function session(player: Player)
	return StateService.get(player)
end

function ProgressService.upgrade(player: Player): (boolean, string?)
	local s = session(player)
	if not s then
		return false, "Loading..."
	end
	local data = s.Data
	local nextUp = Economy.nextUpgrade(data.Level)
	if not nextUp then
		return false, "Max Power! Time to rebirth."
	end
	local formBefore = Economy.formIndex(data.Level)
	if not StateService.spend(player, nextUp.Cost) then
		return false, string.format("Need %s more Scrap", Economy.format(nextUp.Cost - data.Scrap))
	end
	data.Level += 1
	data.Stats.Upgrades += 1
	Analytics.economy(player, false, nextUp.Cost, data.Scrap, TX.Shop, "Upgrade" .. data.Level)
	Analytics.progression(player, "Power", data.Level, "Power " .. nextUp.Power)
	Analytics.funnel(player, data, "FirstUpgrade")
	local formAfter = Economy.formIndex(data.Level)
	if formAfter ~= formBefore then
		local form = Config.Forms[formAfter]
		StateService.notify(player, "Form", form.Name, "NEW FORM!")
		if form.Id == "Crusher" then
			Analytics.funnel(player, data, "CrusherForm")
			Analytics.badge(player, Config.Badges.CrusherForm)
		elseif form.Id == "MegaMech" then
			Analytics.funnel(player, data, "MegaMech")
			Analytics.badge(player, Config.Badges.MegaMech)
		end
	else
		StateService.notify(player, "Upgrade", "Power " .. Economy.format(nextUp.Power) .. "!", nextUp.Milestone)
	end
	StateService.LevelChanged:Fire(player, s)
	StateService.push(player)
	return true
end

function ProgressService.unlockGate(player: Player, area: number): (boolean, string?)
	local s = session(player)
	if not s or (area ~= 2 and area ~= 3) then
		return false
	end
	local data = s.Data
	if StateService.areaUnlocked(s, area) then
		return true
	end
	local check = Economy.checkGate(area, data.Level, data.Scrap, { [2] = data.Gates.Appliance })
	local def = Config.Areas[area]
	if check.needPrevious then
		return false, "Open Appliance Row first"
	elseif check.needPower then
		return false, string.format("Need Power %d (you have %s)", def.GatePower, Economy.format(StateService.power(s)))
	elseif not StateService.spend(player, def.GateScrap) then
		return false, string.format("Need %s more Scrap", Economy.format(def.GateScrap - data.Scrap))
	end
	if area == 2 then
		data.Gates.Appliance = true
		Analytics.funnel(player, data, "ApplianceRow")
	else
		data.Gates.Crusher = true
		Analytics.funnel(player, data, "CrusherYard")
	end
	Analytics.economy(player, false, def.GateScrap, data.Scrap, TX.Shop, "Gate" .. area)
	Analytics.progression(player, "Yards", area, def.Name)
	StateService.notify(
		player,
		"Gate",
		def.Name .. " unlocked!",
		string.format("%d HP junk · %d Scrap each", def.HP, def.Scrap)
	)
	StateService.push(player)
	return true
end

function ProgressService.rebirth(player: Player): (boolean, string?)
	local s = session(player)
	if not s then
		return false
	end
	local data = s.Data
	local check = Economy.checkRebirth(data.Level, data.CrusherDestroys, data.Scrap, data.Rebirths)
	if check.maxed then
		return false, "All five rebirths done!"
	elseif not check.powerOk then
		return false, "Reach Power " .. Economy.format(Economy.powerForLevel(Config.Rebirth.RequiredLevel)) .. " first"
	elseif not check.destroysOk then
		return false,
			string.format(
				"Smash %d more in Crusher Yard",
				Config.Rebirth.RequiredCrusherDestroys - data.CrusherDestroys
			)
	elseif not StateService.spend(player, check.fee) then
		return false, string.format("Need %s more Scrap", Economy.format(check.fee - data.Scrap))
	end
	-- Resets Power and gate access; keeps leftover Scrap, tools, finishes, passes and boosts.
	data.Rebirths += 1
	data.Level = 0
	data.Gates.Appliance = false
	data.Gates.Crusher = false
	data.CrusherDestroys = 0
	Analytics.economy(player, false, check.fee, data.Scrap, TX.Shop, "Rebirth" .. data.Rebirths)
	Analytics.progression(player, "Rebirth", data.Rebirths, "Rebirth " .. data.Rebirths)
	Analytics.funnel(player, data, "FirstRebirth")
	Analytics.badge(player, Config.Badges.Rebirth[data.Rebirths] or 0)
	StateService.notify(
		player,
		"Rebirth",
		"REBIRTH " .. data.Rebirths .. "!",
		string.format("+%d%% Scrap forever", math.floor(Config.Rebirth.BonusPerRebirth * data.Rebirths * 100 + 0.5))
	)
	StateService.LevelChanged:Fire(player, s)
	StateService.push(player)
	task.delay(0.2, MechService.sendToLane, player)
	return true
end

function ProgressService.claimWorkshop(player: Player): (boolean, string?)
	local s = session(player)
	if not s then
		return false
	end
	local w = s.Data.Workshop
	local now = os.time()
	local stored = Economy.workshopStored(w.Stored, w.Updated, now)
	local amount = math.floor(stored)
	if amount < 1 then
		return false, "The workshop is still working. Check back soon!"
	end
	w.Stored = stored - amount
	w.Updated = now
	StateService.addScrap(player, amount, "Workshop")
	Analytics.economy(player, true, amount, s.Data.Scrap, TX.TimedReward, "Workshop")
	StateService.notify(player, "Reward", "+" .. amount .. " Scrap", "Workshop delivery")
	return true
end

function ProgressService.claimDaily(player: Player): (boolean, string?)
	local s = session(player)
	if not s then
		return false
	end
	local data = s.Data
	StateService.rollDaily(data)
	if data.Daily.Claimed then
		return false, "Already claimed today. New contract tomorrow!"
	elseif data.Daily.Progress < Config.Daily.Goal then
		return false, string.format("Smash %d more junk first", Config.Daily.Goal - data.Daily.Progress)
	end
	data.Daily.Claimed = true
	data.Stamps += 1
	StateService.addScrap(player, Config.Daily.RewardScrap, "Daily")
	Analytics.economy(player, true, Config.Daily.RewardScrap, data.Scrap, TX.TimedReward, "Daily")
	if data.Stamps >= Config.Daily.StampsForFinish and not data.Finishes.Chrome then
		data.Finishes.Chrome = true
		StateService.notify(player, "Unlock", "Stamped Chrome unlocked!", "Equip it in the Garage.")
	else
		StateService.notify(
			player,
			"Reward",
			"+" .. Config.Daily.RewardScrap .. " Scrap",
			string.format(
				"Stamp %d/%d",
				math.min(data.Stamps, Config.Daily.StampsForFinish),
				Config.Daily.StampsForFinish
			)
		)
	end
	StateService.push(player)
	return true
end

local VALID_TOOLS = {}
for _, tool in Config.Tools do
	VALID_TOOLS[tool.Id] = true
end

function ProgressService.selectTool(player: Player, toolId: string): (boolean, string?)
	local s = session(player)
	if not s or not VALID_TOOLS[toolId] then
		return false
	end
	s.Data.Tool = toolId
	s.Data.ToolChosen = true
	Analytics.funnel(player, s.Data, "PickedTool")
	StateService.LookChanged:Fire(player, s)
	StateService.push(player)
	return true
end

local VALID_FINISHES = {}
for _, finish in Config.Finishes do
	VALID_FINISHES[finish.Id] = true
end

function ProgressService.selectFinish(player: Player, finishId: string): (boolean, string?)
	local s = session(player)
	if not s or not VALID_FINISHES[finishId] then
		return false
	end
	if not s.Data.Finishes[finishId] then
		return false, "You don't own that finish yet"
	end
	s.Data.Finish = finishId
	StateService.LookChanged:Fire(player, s)
	StateService.push(player)
	return true
end

function ProgressService.craftWorker(player: Player): (boolean, string?)
	local s = session(player)
	if not s then
		return false
	end
	if s.Data.Finishes.Worker then
		return false, "You already own the Worker Shell"
	end
	if not StateService.spend(player, Config.WorkerShellCraftCost) then
		return false, string.format("Need %s more Scrap", Economy.format(Config.WorkerShellCraftCost - s.Data.Scrap))
	end
	s.Data.Finishes.Worker = true
	Analytics.economy(player, false, Config.WorkerShellCraftCost, s.Data.Scrap, TX.Shop, "WorkerShell")
	StateService.notify(player, "Unlock", "Worker Shell crafted!", "Equip it in the Garage.")
	StateService.push(player)
	return true
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Seven exact offers: five passes (Lime Paint, Worker Starter Pack, Double Scrap,
-- Auto Farm, Foundry VIP) and two repeatable products (Scrap Boost, 600 Scrap).
-- Pass perks are re-applied every join; product receipts are granted once per PurchaseId
-- and saved before the purchase is confirmed. Boost time only ticks during salvage play.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)

local DataService = require(script.Parent.DataService)
local StateService = require(script.Parent.StateService)
local LaneService = require(script.Parent.LaneService)
local Analytics = require(script.Parent.Analytics)

local ShopService = {}

local offersByKey: { [string]: Config.Offer } = {}
local passByid: { [number]: Config.Offer } = {}
local productById: { [number]: Config.Offer } = {}
for _, offer in Config.Offers do
	offersByKey[offer.Key] = offer
	if offer.Id ~= 0 then
		if offer.Kind == "Pass" then
			passByid[offer.Id] = offer
		else
			productById[offer.Id] = offer
		end
	end
end

local function studioFree(offer: Config.Offer): boolean
	return offer.Id == 0 and Config.StudioTestPurchases and RunService:IsStudio()
end

-- Perks that follow from owning a pass. Safe to call repeatedly.
local function applyPassPerks(player: Player)
	local session = StateService.get(player)
	if not session then
		return
	end
	local data = session.Data
	local passes = session.Passes
	if passes.LimePaint then
		data.Finishes.Lime = true
	end
	if passes.FoundryVIP then
		data.Finishes.Foundry = true
	end
	if passes.WorkerStarter then
		data.Finishes.Worker = true
		if not data.StarterGranted then
			-- The 250 Scrap is granted exactly once, across reconnects (saved flag).
			data.StarterGranted = true
			StateService.addScrap(player, Config.StarterPackScrap, "Purchase")
			Analytics.economy(
				player,
				true,
				Config.StarterPackScrap,
				data.Scrap,
				Enum.AnalyticsEconomyTransactionType.IAP,
				"WorkerStarter"
			)
		end
	end
	if session.Lane then
		LaneService.refreshSign(session.Lane)
	end
	StateService.LookChanged:Fire(player, session)
	StateService.push(player)
end

local function grantPass(player: Player, offer: Config.Offer, announce: boolean)
	local session = StateService.get(player)
	if not session then
		return
	end
	session.Passes[offer.Key] = true
	applyPassPerks(player)
	if announce then
		StateService.notify(player, "Purchase", offer.Name .. "!", offer.Benefit)
	end
end

local function grantProduct(player: Player, offer: Config.Offer)
	local session = StateService.get(player)
	if not session then
		return
	end
	local data = session.Data
	if offer.Key == "ScrapBoost" then
		data.BoostCharges += 1
		StateService.notify(player, "Purchase", "Scrap Boost stored!", "Tap BOOST to start 10 minutes of 2x Scrap.")
	elseif offer.Key == "Scrap600" then
		-- Purchased Scrap is never multiplied.
		StateService.addScrap(player, Config.ScrapPackAmount, "Purchase")
		Analytics.economy(
			player,
			true,
			Config.ScrapPackAmount,
			data.Scrap,
			Enum.AnalyticsEconomyTransactionType.IAP,
			"Scrap600"
		)
		StateService.notify(player, "Purchase", "+600 Scrap", "Thanks for supporting the game!")
	end
	StateService.push(player)
end

local function checkOwnedPasses(player: Player)
	for _, offer in Config.Offers do
		if offer.Kind == "Pass" and offer.Id ~= 0 then
			for _ = 1, 3 do
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id)
				end)
				if ok then
					if owns then
						local session = StateService.get(player)
						if session then
							session.Passes[offer.Key] = true
						end
					end
					break
				end
				task.wait(1)
			end
		end
	end
	applyPassPerks(player)
end

-- Called from the client's BUY buttons.
function ShopService.buy(player: Player, key: string): (boolean, string?)
	local offer = offersByKey[key]
	local session = StateService.get(player)
	if not offer or not session then
		return false
	end
	if offer.Kind == "Pass" and session.Passes[key] then
		return false, "You already own " .. offer.Name
	end
	if studioFree(offer) then
		-- Studio test mode: grant directly so every flow can be played without real IDs.
		if offer.Kind == "Pass" then
			grantPass(player, offer, true)
		else
			grantProduct(player, offer)
		end
		return true, "Studio test purchase"
	end
	if offer.Id == 0 then
		return false, "This offer isn't set up yet"
	end
	if offer.Kind == "Pass" then
		MarketplaceService:PromptGamePassPurchase(player, offer.Id)
	else
		MarketplaceService:PromptProductPurchase(player, offer.Id)
	end
	return true
end

function ShopService.activateBoost(player: Player): (boolean, string?)
	local session = StateService.get(player)
	if not session then
		return false
	end
	local data = session.Data
	if data.BoostCharges <= 0 then
		return false, "No boost charges. Get one in the Shop!"
	end
	data.BoostCharges -= 1
	-- Each activation adds ten minutes; it extends duration, never strength.
	data.BoostRemaining += Config.Boost.SecondsPerCharge
	StateService.notify(player, "Boost", "2x SCRAP!", "Boost time: " .. Economy.formatTime(data.BoostRemaining))
	StateService.push(player)
	return true
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local offer = productById[receipt.ProductId]
	if not offer then
		warn("[ShopService] Unknown product " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Need a live session (not just data that is still being released), or the grant
	-- below would do nothing while the receipt is recorded as used.
	local session = StateService.get(player)
	local data = DataService.get(player)
	if not session or not data or session.Data ~= data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if not DataService.hasReceipt(data, purchaseId) then
		DataService.addReceipt(data, purchaseId)
		grantProduct(player, offer)
	end
	-- Only confirm once the grant (and the receipt id) is safely saved.
	if DataService.usingMemory() or DataService.save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function ShopService.init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local offer = passByid[passId]
		if purchased and offer then
			grantPass(player, offer, true)
		end
	end)
	StateService.Started:Connect(checkOwnedPasses)

	-- Boost clock: only counts down while the player is out salvaging in the yards
	-- and not sitting in a blocking menu. Offline time never counts.
	task.spawn(function()
		local last = os.clock()
		local flushAt = os.clock() + 60
		while true do
			task.wait(1)
			local now = os.clock()
			local dt = now - last
			last = now
			for player, session in StateService.all() do
				local data = session.Data
				data.Stats.PlaySeconds += dt
				local ticking = false
				if data.BoostRemaining > 0 then
					local character = player.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					ticking = root ~= nil
						and humanoid ~= nil
						and humanoid.Health > 0
						and not session.InMenu
						and Layout.isInYard(root.Position)
					if ticking then
						data.BoostRemaining = math.max(0, data.BoostRemaining - dt)
						if data.BoostRemaining == 0 then
							ticking = false
							StateService.notify(
								player,
								"Boost",
								"Boost finished",
								if data.BoostCharges > 0 then "You have more charges ready." else ""
							)
						end
					end
				end
				-- The client counts down locally while ticking; push only when the state flips.
				if ticking ~= session.BoostTicking then
					session.BoostTicking = ticking
					StateService.push(player)
				end
			end
			if now >= flushAt then
				flushAt = now + 60
				Analytics.flush(function(player)
					local s = StateService.get(player)
					return s and s.Data.Scrap
				end)
			end
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">StateService</string>
            <string name="Source"><![CDATA[-- Live session per player: wraps saved data with session-only state (passes, lane,
-- menu state), owns all Scrap changes, and replicates a compact snapshot to the client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Signal = require(Shared.Signal)

local DataService = require(script.Parent.DataService)
local Analytics = require(script.Parent.Analytics)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local StateService = {}

export type Session = {
	Player: Player,
	Data: any,
	Passes: { [string]: boolean },
	Lane: number?,
	InMenu: boolean,
	BoostTicking: boolean,
	PushQueued: boolean,
	Leaderstats: Folder?,
}

local sessions: { [Player]: Session } = {}

StateService.Started = Signal.new() -- (player, session)
StateService.Ended = Signal.new() -- (player)
StateService.LevelChanged = Signal.new() -- (player, session)
StateService.LookChanged = Signal.new() -- (player, session) tool / finish

function StateService.get(player: Player): Session?
	return sessions[player]
end

function StateService.all(): { [Player]: Session }
	return sessions
end

function StateService.power(session: Session): number
	return Economy.powerForLevel(session.Data.Level)
end

function StateService.boostActive(session: Session): boolean
	return session.Data.BoostRemaining > 0
end

function StateService.areaUnlocked(session: Session, area: number): boolean
	if area == 1 then
		return true
	elseif area == 2 then
		return session.Data.Gates.Appliance
	elseif area == 3 then
		return session.Data.Gates.Crusher
	end
	return false
end

function StateService.rollDaily(data)
	local today = Economy.dayIndex(os.time())
	if data.Daily.Day ~= today then
		data.Daily = { Day = today, Progress = 0, Claimed = false }
	end
end

local function snapshot(session: Session)
	local data = session.Data
	StateService.rollDaily(data)
	local finishes = {}
	for id, owned in data.Finishes do
		if owned then
			table.insert(finishes, id)
		end
	end
	return {
		Scrap = data.Scrap,
		Level = data.Level,
		Power = Economy.powerForLevel(data.Level),
		Rebirths = data.Rebirths,
		Gates = { Appliance = data.Gates.Appliance, Crusher = data.Gates.Crusher }, -- string keys survive remotes
		CrusherDestroys = data.CrusherDestroys,
		Tool = data.Tool,
		ToolChosen = data.ToolChosen,
		Finish = data.Finish,
		Finishes = finishes,
		BoostCharges = data.BoostCharges,
		BoostRemaining = data.BoostRemaining,
		BoostTicking = session.BoostTicking,
		Workshop = { Stored = data.Workshop.Stored, Updated = data.Workshop.Updated },
		Daily = { Day = data.Daily.Day, Progress = data.Daily.Progress, Claimed = data.Daily.Claimed },
		Stamps = data.Stamps,
		StarterGranted = data.StarterGranted,
		Passes = table.clone(session.Passes),
		Lane = session.Lane,
		Funnel = table.clone(data.Funnel),
		Destroys = data.Stats.Destroys,
		ServerTime = os.time(),
		StudioTest = RunService:IsStudio() and Config.StudioTestPurchases,
		Multiplier = Economy.totalMultiplier(
			data.Rebirths,
			session.Passes.DoubleScrap == true,
			data.BoostRemaining > 0
		),
		MemoryData = DataService.usingMemory(),
	}
end

local function refreshPublic(session: Session)
	local player = session.Player
	local data = session.Data
	player:SetAttribute("Power", Economy.powerForLevel(data.Level))
	player:SetAttribute("MechLevel", data.Level)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("Lane", session.Lane)
	player:SetAttribute("IsVIP", session.Passes.FoundryVIP == true)
	player:SetAttribute("HasAutoFarm", session.Passes.AutoFarm == true)
	player:SetAttribute("Tool", data.Tool)
	local stats = session.Leaderstats
	if stats then
		local values = { Scrap = data.Scrap, Power = Economy.powerForLevel(data.Level), Rebirths = data.Rebirths }
		for name, value in values do
			local stat = stats:FindFirstChild(name)
			if stat and stat:IsA("IntValue") then
				stat.Value = value
			end
		end
	end
end

-- Queue a state push; multiple changes in one frame send one snapshot.
function StateService.push(player: Player)
	local session = sessions[player]
	if not session or session.PushQueued then
		return
	end
	session.PushQueued = true
	task.defer(function()
		session.PushQueued = false
		if sessions[player] ~= session then
			return
		end
		refreshPublic(session)
		Remotes.State:FireClient(player, snapshot(session))
	end)
end

-- Scrap in. `kind` is for analytics ("Smash", "Workshop", "Daily", "Purchase"...).
function StateService.addScrap(player: Player, amount: number, kind: string)
	local session = sessions[player]
	if not session or amount <= 0 then
		return
	end
	session.Data.Scrap += amount
	if kind == "Smash" then
		session.Data.Stats.ScrapEarned += amount
	end
	StateService.push(player)
end

-- Scrap out. Returns false (and changes nothing) if the player can't afford it.
function StateService.spend(player: Player, amount: number): boolean
	local session = sessions[player]
	if not session or amount < 0 or session.Data.Scrap < amount then
		return false
	end
	session.Data.Scrap -= amount
	StateService.push(player)
	return true
end

function StateService.notify(player: Player, kind: string, title: string, body: string?)
	Remotes.Notify:FireClient(player, kind, title, body or "")
end

local function makeLeaderstats(player: Player): Folder
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in { "Scrap", "Power", "Rebirths" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = folder
	end
	folder.Parent = player
	return folder
end

local function onPlayerAdded(player: Player)
	local data = DataService.load(player)
	if not data then
		if player.Parent then
			player:Kick("We couldn't load your mech. Please rejoin in a moment.")
		end
		return
	end
	StateService.rollDaily(data)
	local session: Session = {
		Player = player,
		Data = data,
		Passes = {},
		Lane = nil,
		InMenu = false,
		BoostTicking = false,
		PushQueued = false,
		Leaderstats = makeLeaderstats(player),
	}
	sessions[player] = session
	Analytics.funnel(player, data, "Joined")
	refreshPublic(session)
	StateService.Started:Fire(player, session)
	StateService.push(player)
end

function StateService.init()
	Players.PlayerRemoving:Connect(function(player)
		if sessions[player] then
			sessions[player] = nil
			StateService.Ended:Fire(player)
		end
	end)
end

-- Called once every service has subscribed to Started, so nobody misses a player.
function StateService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return StateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TargetService</string>
            <string name="Source"><![CDATA[-- Spawns every lane's targets, applies server-owned damage and grants each target's
-- fixed Scrap exactly once. Targets in a lane only ever pay that lane's owner.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)

local TargetModels = require(script.Parent.Parent.Builders.TargetModels)
local StateService = require(script.Parent.StateService)
local LaneService = require(script.Parent.LaneService)
local WorldService = require(script.Parent.WorldService)
local Analytics = require(script.Parent.Analytics)

local Fx = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Fx")

local TargetService = {}

-- registry[lane][area][slot] = Model (nil while respawning)
local registry: { [number]: { [number]: { [number]: Model? } } } = {}
local spawnCount: { [string]: number } = {}
local laneFolders: { [number]: Folder } = {}

local function ownerId(lane: number): number
	local owner = LaneService.ownerOf(lane)
	return if owner then owner.UserId else 0
end

local function spawnTarget(lane: number, area: number, slot: number)
	local key = string.format("%d:%d:%d", lane, area, slot)
	spawnCount[key] = (spawnCount[key] or 0) + 1
	local count = spawnCount[key]
	local def = Config.Areas[area]
	local kindIndex = lane * 2 + slot * 3 + count
	local model = TargetModels.build(
		area,
		kindIndex,
		Layout.slotPosition(area, lane, slot),
		lane * 100000 + area * 1000 + slot * 37 + count
	)
	model:SetAttribute("Lane", lane)
	model:SetAttribute("Area", area)
	model:SetAttribute("Slot", slot)
	model:SetAttribute("HP", def.HP)
	model:SetAttribute("MaxHP", def.HP)
	model:SetAttribute("Reward", def.Scrap)
	model:SetAttribute("OwnerId", ownerId(lane))
	model.Parent = laneFolders[lane]
	registry[lane][area][slot] = model
end

function TargetService.init()
	local world = WorldService.get()
	for lane = 1, Layout.Lanes do
		local f = Instance.new("Folder")
		f.Name = "Lane" .. lane
		f.Parent = world.Targets
		laneFolders[lane] = f
		registry[lane] = {}
		for area = 1, 3 do
			registry[lane][area] = {}
			for slot = 1, Layout.slotCount(area) do
				spawnTarget(lane, area, slot)
			end
		end
	end
	local function setOwner(lane: number)
		local id = ownerId(lane)
		for _, areaSlots in registry[lane] do
			for _, model in areaSlots do
				if model then
					model:SetAttribute("OwnerId", id)
				end
			end
		end
	end
	LaneService.Assigned:Connect(function(_, lane)
		setOwner(lane)
	end)
	LaneService.Freed:Connect(setOwner)
end

-- Nearest living target within reach in the player's own lane and unlocked areas.
function TargetService.nearestInReach(session: StateService.Session, position: Vector3): Model?
	local lane = session.Lane
	if not lane then
		return nil
	end
	local best, bestDistance = nil, Config.Combat.Reach
	for area = 1, 3 do
		if StateService.areaUnlocked(session, area) then
			for _, model in registry[lane][area] do
				if model and model.PrimaryPart and not model:GetAttribute("Dead") then
					local d = Layout.reachDistance(position, model.PrimaryPart)
					if d <= bestDistance then
						best, bestDistance = model, d
					end
				end
			end
		end
	end
	return best
end

function TargetService.inReach(session: StateService.Session, model: Model, position: Vector3): boolean
	if not model.Parent or model:GetAttribute("Dead") or not model.PrimaryPart then
		return false
	end
	if
		model:GetAttribute("Lane") ~= session.Lane or not StateService.areaUnlocked(session, model:GetAttribute("Area"))
	then
		return false
	end
	return Layout.reachDistance(position, model.PrimaryPart) <= Config.Combat.Reach
end

local function grantReward(player: Player, session: StateService.Session, area: number)
	local data = session.Data
	local def = Config.Areas[area]
	local payout =
		Economy.payout(def.Scrap, data.Rebirths, session.Passes.DoubleScrap == true, StateService.boostActive(session))
	StateService.addScrap(player, payout, "Smash")
	Analytics.smashIncome(player, payout)
	data.Stats.Destroys += 1
	if area == 3 then
		data.CrusherDestroys += 1
	end
	StateService.rollDaily(data)
	if not data.Daily.Claimed and data.Daily.Progress < Config.Daily.Goal then
		data.Daily.Progress += 1
		if data.Daily.Progress == Config.Daily.Goal then
			StateService.notify(
				player,
				"Daily",
				"Daily contract done!",
				string.format("Claim %d Scrap + a stamp in Daily.", Config.Daily.RewardScrap)
			)
		end
	end
	if not data.Funnel.FirstSmash then
		Analytics.funnel(player, data, "FirstSmash")
		Analytics.badge(player, Config.Badges.FirstSmash)
	end
	return payout
end

-- Applies one hit. The target's lane must belong to the attacker (checked by caller).
function TargetService.damage(player: Player, session: StateService.Session, model: Model, power: number)
	if model:GetAttribute("Dead") or not model.Parent then
		return
	end
	local hp = (model:GetAttribute("HP") :: number) - power
	Fx:FireAllClients("Hit", player.UserId, model, power)
	if hp > 0 then
		model:SetAttribute("HP", hp)
		return
	end
	model:SetAttribute("HP", 0)
	model:SetAttribute("Dead", true)
	local lane, area, slot = model:GetAttribute("Lane"), model:GetAttribute("Area"), model:GetAttribute("Slot")
	local hitbox = model.PrimaryPart :: BasePart
	local payout = grantReward(player, session, area)
	Fx:FireAllClients("Break", player.UserId, hitbox.Position, hitbox.Size, TargetModels.colors(model), area)
	Fx:FireClient(player, "Reward", payout, hitbox.Position + Vector3.new(0, hitbox.Size.Y / 2, 0))
	registry[lane][area][slot] = nil
	model:Destroy()
	task.delay(Config.Areas[area].Respawn, function()
		if registry[lane][area][slot] == nil then
			spawnTarget(lane, area, slot)
		end
	end)
end

return TargetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[-- Builds the map once at startup and hands out references to its key parts.

local WorldBuilder = require(script.Parent.Parent.Builders.WorldBuilder)

local WorldService = {}

WorldService.world = nil :: WorldBuilder.World?

function WorldService.init()
	WorldService.world = WorldBuilder.build()
end

function WorldService.get(): WorldBuilder.World
	return WorldService.world :: WorldBuilder.World
end

return WorldService
]]></string>
          </Properties>
        </Item>
