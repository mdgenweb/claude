          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Gui</string>
              <string name="Source"><![CDATA[-- Root ScreenGui. Everything is laid out on a 1280x720 reference canvas and scaled
-- to the device with one UIScale, so phones, tablets and monitors keep the same layout.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local UIKit = require(script.Parent.UIKit)

local Gui = {}

Gui.Screen = nil :: ScreenGui?
Gui.Root = nil :: Frame?
Gui.Layers = {} :: { [string]: Frame }
Gui.scale = 1

local REF_W, REF_H = 1280, 720

function Gui.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local screen = UIKit.new("ScreenGui", {
		Name = "MechUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local root = UIKit.new("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = screen })
	local scale = UIKit.new("UIScale", { Parent = root })
	local function fit()
		local size = screen.AbsoluteSize
		if size.X < 1 or size.Y < 1 then
			return
		end
		local s = math.min(size.X / REF_W, size.Y / REF_H)
		local minScale = if UserInputService.TouchEnabled then 0.62 else 0.5 -- 78px buttons stay >= 48px on phones
		s = math.clamp(s, minScale, 1.35)
		Gui.scale = s
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()
	for i, name in { "Hud", "Panels", "Toasts", "Fly" } do
		Gui.Layers[name] = UIKit.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = i * 10,
			Parent = root,
		})
	end
	Gui.Screen = screen
	Gui.Root = root
end

-- Converts a screen-space pixel position into the scaled root's coordinates.
function Gui.toRoot(screenPos: Vector2): UDim2
	local root = Gui.Root :: Frame
	local rel = (screenPos - root.AbsolutePosition) / Gui.scale
	return UDim2.fromOffset(rel.X, rel.Y)
end

return Gui
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-on HUD: Scrap & Power counters, left menu stack, Boost / Auto buttons,
-- the "next upgrade" widget (the concept's nearby next goal) and the next-gate chip.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Theme = require(Shared.Theme)

local UIKit = require(script.Parent.UIKit)
local Gui = require(script.Parent.Gui)
local Copy = require(script.Parent.Copy)
local Panels = require(script.Parent.Panels)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Sound = require(script.Parent.Parent.Controllers.Sound)
local AutoFarm = require(script.Parent.Parent.Controllers.AutoFarm)

local Hud = {}

local refs: { [string]: any } = {}
local shownScrap = 0
local scrapValue: NumberValue

local function milestoneIcon(level: number): string
	local icons = { "💥", "💪", "🔨", "🤖", "🛡️", "🦾", "🚀", "☢️", "👑" }
	return icons[level] or "⚡"
end

-- Top bar -------------------------------------------------------------------------

local function buildTopBar(layer: Frame)
	local top = UIKit.new("Frame", {
		Name = "TopBar",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(540, 100),
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = layer,
	})
	local scrap = UIKit.surface(top, {
		Name = "Scrap",
		Size = UDim2.fromOffset(290, 58),
		Position = UDim2.fromOffset(30, 10),
		Swatch = Theme.Swatch.Navy,
		Radius = 999,
	})
	local coin = UIKit.surface(top, {
		Name = "Coin",
		Size = UDim2.fromOffset(74, 74),
		Position = UDim2.fromOffset(0, 2),
		Swatch = Theme.Swatch.Yellow,
		Radius = 999,
		ZIndex = 3,
	})
	UIKit.icon(coin.Face, "⚙️", UDim2.fromScale(0.7, 0.7), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local amount = UIKit.text(scrap.Face, {
		Name = "Amount",
		Text = "0",
		TextSize = 40,
		Size = UDim2.new(1, -66, 0.9, 0),
		Position = UDim2.new(0, 56, 0.05, 0),
		XAlign = Enum.TextXAlignment.Left,
		Color = Theme.ScrapGold,
	})
	local power = UIKit.surface(top, {
		Name = "Power",
		Size = UDim2.fromOffset(196, 50),
		Position = UDim2.fromOffset(340, 14),
		Swatch = Theme.Swatch.Navy,
		Radius = 999,
	})
	local bolt = UIKit.surface(top, {
		Name = "Bolt",
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.fromOffset(318, 9),
		Swatch = Theme.Swatch.Blue,
		Radius = 999,
		ZIndex = 3,
	})
	UIKit.icon(bolt.Face, "⚡", UDim2.fromScale(0.7, 0.7), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local powerText = UIKit.text(power.Face, {
		Text = "1",
		TextSize = 32,
		Size = UDim2.fromScale(0.55, 0.9),
		Position = UDim2.new(0, 46, 0.05, 0),
		XAlign = Enum.TextXAlignment.Left,
		Color = Theme.PowerCyan,
	})
	UIKit.text(power.Face, {
		Text = Copy.Hud.Power,
		TextSize = 16,
		Size = UDim2.fromScale(0.34, 0.6),
		Position = UDim2.fromScale(0.62, 0.2),
		Font = Theme.Font.Body,
		Color = Theme.Muted,
	})
	local multi = UIKit.chip(top, {
		Name = "Multiplier",
		Text = "x2 SCRAP",
		Size = UDim2.fromOffset(150, 30),
		Position = UDim2.fromOffset(100, 70),
		Swatch = Theme.Swatch.Green,
	})
	multi.Holder.Visible = false
	refs.Coin = coin.Holder
	refs.ScrapAmount = amount
	refs.ScrapPill = scrap.Holder
	refs.PowerText = powerText
	refs.Multiplier = multi

	scrapValue = Instance.new("NumberValue")
	scrapValue.Changed:Connect(function(v)
		amount.Text = Economy.format(v)
	end)
end

-- Left menu stack ---------------------------------------------------------------------

local function buildNav(layer: Frame)
	local nav = UIKit.new("Frame", {
		Name = "Nav",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(96, 500),
		Position = UDim2.new(0, 18, 0.5, 10),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = layer,
	})
	UIKit.list(nav, true, 22, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local items = {
		{ "Shop", Copy.Nav.Shop, "🛒", Theme.Swatch.Green },
		{ "Upgrade", Copy.Nav.Upgrade, "⚡", Theme.Swatch.Orange },
		{ "Rebirth", Copy.Nav.Rebirth, "♻️", Theme.Swatch.Purple },
		{ "Garage", Copy.Nav.Garage, "🎨", Theme.Swatch.Blue },
		{ "Daily", Copy.Nav.Daily, "📋", Theme.Swatch.Yellow },
	}
	refs.Nav = {}
	for i, item in items do
		local button = UIKit.iconButton(nav, {
			Name = item[1],
			Text = item[2],
			Icon = item[3],
			Swatch = item[4],
			LayoutOrder = i,
			OnClick = function()
				Panels.toggle(item[1])
			end,
		})
		refs.Nav[item[1]] = button
	end
end

-- Right side: Boost & Auto -------------------------------------------------------------

local function buildRight(layer: Frame)
	local right = UIKit.new("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(110, 300),
		Position = UDim2.new(1, -18, 0.5, 10),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = layer,
	})
	UIKit.list(right, true, 40, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local boost = UIKit.iconButton(right, {
		Name = "Boost",
		Text = Copy.Hud.Boost,
		Icon = "🚀",
		Swatch = Theme.Swatch.Orange,
		SizePx = 88,
		LayoutOrder = 1,
		OnClick = function()
			local s = Net.State
			if s and s.BoostCharges > 0 then
				local ok, msg = Net.request("ActivateBoost")
				if not ok then
					Toasts.error(msg)
				end
			else
				Panels.open("Shop", "ScrapBoost")
			end
		end,
	})
	local boostChip = UIKit.chip(boost.Holder, {
		Text = "",
		Size = UDim2.fromOffset(96, 28),
		Position = UDim2.new(0.5, 0, 1, 20),
		AnchorPoint = Vector2.new(0.5, 0),
		Swatch = Theme.Swatch.Navy,
		TextSize = 18,
	})

	local auto = UIKit.iconButton(right, {
		Name = "Auto",
		Text = Copy.Hud.Auto,
		Icon = "🤖",
		Swatch = Theme.Swatch.Blue,
		SizePx = 88,
		LayoutOrder = 2,
		OnClick = function()
			if Players.LocalPlayer:GetAttribute("HasAutoFarm") then
				AutoFarm.toggle()
			else
				Panels.open("Shop", "AutoFarm")
			end
		end,
	})
	local autoChip = UIKit.chip(auto.Holder, {
		Text = Copy.Hud.Off,
		Size = UDim2.fromOffset(86, 28),
		Position = UDim2.new(0.5, 0, 1, 20),
		AnchorPoint = Vector2.new(0.5, 0),
		Swatch = Theme.Swatch.Steel,
		TextSize = 18,
	})
	refs.BoostChip = boostChip
	refs.AutoChip = autoChip
	refs.Boost = boost
end

-- Bottom: next upgrade + goal ---------------------------------------------------------

local function buildBottom(layer: Frame)
	local widget = UIKit.surface(layer, {
		Name = "NextUpgrade",
		Size = UDim2.fromOffset(580, 104),
		Position = UDim2.new(0.5, 0, 1, -22),
		AnchorPoint = Vector2.new(0.5, 1),
		Swatch = Theme.Swatch.Navy,
		Radius = Theme.Radius.L,
	})
	local iconBox = UIKit.surface(widget.Face, {
		Size = UDim2.fromOffset(78, 78),
		Position = UDim2.new(0, 12, 0.5, -3),
		AnchorPoint = Vector2.new(0, 0.5),
		Swatch = Theme.Swatch.Orange,
		Radius = Theme.Radius.M,
	})
	local icon =
		UIKit.icon(iconBox.Face, "⚡", UDim2.fromScale(0.7, 0.7), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local title = UIKit.text(widget.Face, {
		Text = "",
		TextSize = 26,
		Size = UDim2.fromOffset(290, 30),
		Position = UDim2.fromOffset(104, 8),
		XAlign = Enum.TextXAlignment.Left,
	})
	local sub = UIKit.text(widget.Face, {
		Text = "",
		TextSize = 17,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.fromOffset(290, 22),
		Position = UDim2.fromOffset(104, 38),
		XAlign = Enum.TextXAlignment.Left,
	})
	local bar = UIKit.progress(
		widget.Face,
		{ Size = UDim2.fromOffset(290, 26), Position = UDim2.fromOffset(104, 66), Swatch = Theme.Swatch.Yellow }
	)
	local button = UIKit.button(widget.Face, {
		Name = "UpgradeButton",
		Text = Copy.Hud.UpgradeButton,
		TextSize = 28,
		Size = UDim2.fromOffset(158, 70),
		Position = UDim2.new(1, -14, 0.5, -3),
		AnchorPoint = Vector2.new(1, 0.5),
		Swatch = Theme.Swatch.Green,
		OnClick = function()
			local s = Net.State
			if s and not Economy.nextUpgrade(s.Level) then
				Panels.open("Rebirth")
				return
			end
			local ok, msg = Net.request("Upgrade")
			if not ok then
				Toasts.error(msg)
			end
		end,
		OnDisabledClick = function()
			local s = Net.State
			local nextUp = s and Economy.nextUpgrade(s.Level)
			if nextUp then
				Toasts.error(string.format("Need %s more Scrap. Keep smashing!", Economy.format(nextUp.Cost - s.Scrap)))
			end
		end,
	})
	local goal = UIKit.chip(layer, {
		Name = "Goal",
		Text = "",
		Size = UDim2.fromOffset(470, 34),
		Position = UDim2.new(0.5, 0, 1, -138),
		AnchorPoint = Vector2.new(0.5, 1),
		Swatch = Theme.Swatch.Navy,
		TextSize = 19,
	})
	refs.Next = { Title = title, Sub = sub, Bar = bar, Button = button, Icon = icon }
	refs.Goal = goal

	-- First-session hint: "SMASH THE JUNK!"
	local hint = UIKit.new("Frame", {
		Name = "SmashHint",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(620, 110),
		Position = UDim2.new(0.5, 0, 1, -200),
		AnchorPoint = Vector2.new(0.5, 1),
		Visible = false,
		Parent = layer,
	})
	UIKit.text(hint, {
		Text = Copy.Hud.SmashTitle,
		TextSize = 58,
		Size = UDim2.new(1, 0, 0, 64),
		Color = Color3.fromHex("#FFB24A"),
		StrokeThickness = 5,
		Rotation = -2,
	})
	UIKit.text(hint, {
		Text = Copy.Hud.SmashSub,
		TextSize = 22,
		Font = Theme.Font.Body,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 70),
	})
	UIKit.bob(hint, 6, 1.2)
	refs.Hint = hint
	refs.Layer = layer
end

-- Updates ----------------------------------------------------------------------------

local function goalText(s): string
	for area = 2, 3 do
		if not Net.unlocked(area) then
			local def = Config.Areas[area]
			return string.format(Copy.Goal.Gate, def.Name, Economy.format(def.GatePower), Economy.format(def.GateScrap))
		end
	end
	local check = Economy.checkRebirth(s.Level, s.CrusherDestroys, s.Scrap, s.Rebirths)
	if check.maxed then
		return Copy.Goal.AllDone
	elseif check.ok then
		return Copy.Goal.RebirthReady
	elseif not check.destroysOk then
		return string.format(Copy.Goal.Rebirth, s.CrusherDestroys, Config.Rebirth.RequiredCrusherDestroys)
	end
	return string.format(Copy.Goal.RebirthFee, Economy.format(check.fee))
end

function Hud.update(s, prev)
	-- Scrap counter: count up and bump when it grows.
	if not prev then
		shownScrap = s.Scrap
		scrapValue.Value = s.Scrap
	elseif s.Scrap ~= shownScrap then
		local grew = s.Scrap > shownScrap
		shownScrap = s.Scrap
		UIKit.tween(scrapValue, 0.35, { Value = s.Scrap })
		if grew then
			UIKit.pop(refs.ScrapPill, 0.08)
		end
	end
	refs.PowerText.Text = Economy.format(s.Power)
	if prev and s.Power ~= prev.Power then
		UIKit.pop(refs.PowerText, 0.3)
	end
	local multiplier = s.Multiplier or 1
	refs.Multiplier.Holder.Visible = multiplier > 1.001
	refs.Multiplier.Label.Text =
		string.format("x%s SCRAP", (string.format("%.2f", multiplier):gsub("0+$", ""):gsub("%.$", "")))

	-- Next upgrade widget
	local nextUp = Economy.nextUpgrade(s.Level)
	local n = refs.Next
	if nextUp then
		n.Title.Text = "NEXT: ⚡" .. Economy.format(nextUp.Power) .. " POWER"
		n.Sub.Text = nextUp.Milestone
		n.Icon.Text = milestoneIcon(s.Level + 1)
		local affordable = s.Scrap >= nextUp.Cost
		n.Bar:Set(
			s.Scrap / nextUp.Cost,
			Economy.format(math.min(s.Scrap, nextUp.Cost)) .. " / " .. Economy.format(nextUp.Cost) .. " Scrap",
			if affordable then Theme.Swatch.Green else Theme.Swatch.Yellow
		)
		n.Button:SetText(Copy.Hud.UpgradeButton)
		n.Button:SetSwatch(Theme.Swatch.Green)
		n.Button:SetEnabled(affordable)
		if affordable and (not prev or prev.Scrap < nextUp.Cost or prev.Level ~= s.Level) then
			UIKit.pop(n.Button.Holder, 0.15)
		end
	else
		n.Title.Text = Copy.Hud.MaxPower
		n.Sub.Text = Copy.Hud.MaxPowerSub
		n.Icon.Text = "👑"
		n.Bar:Set(1, "⚡ " .. Economy.format(s.Power) .. " POWER", Theme.Swatch.Purple)
		n.Button:SetText(Copy.Rebirth.Button)
		n.Button:SetSwatch(Theme.Swatch.Purple)
		n.Button:SetEnabled(true)
	end
	refs.Goal.Label.Text = goalText(s)

	-- Badges: only for things the player can act on right now.
	local nav = refs.Nav
	nav.Upgrade.Badge:Set(nextUp ~= nil and s.Scrap >= nextUp.Cost)
	nav.Rebirth.Badge:Set(Economy.checkRebirth(s.Level, s.CrusherDestroys, s.Scrap, s.Rebirths).ok)
	local dailyReady = not s.Daily.Claimed and s.Daily.Progress >= Config.Daily.Goal
	nav.Daily.Badge:Set(dailyReady or Net.workshopStored() >= Config.Workshop.Cap)
	if prev and #s.Finishes > #prev.Finishes then
		nav.Garage.Badge:Set(true, "NEW")
	end

	Hud.updateBoost()
	Hud.updateAuto()

	refs.Hint.Visible = (s.Destroys or 0) == 0 and not Panels.isOpen("ToolPicker")

	if s.MemoryData and not refs.MemoryChip then
		refs.MemoryChip = UIKit.chip(refs.Layer, {
			Text = Copy.Hud.MemoryWarning,
			Size = UDim2.fromOffset(360, 26),
			Position = UDim2.new(0, 16, 1, -12),
			AnchorPoint = Vector2.new(0, 1),
			Swatch = Theme.Swatch.Red,
			TextSize = 14,
		})
	end
end

function Hud.updateBoost()
	local s = Net.State
	if not s or not refs.BoostChip then
		return
	end
	local remaining = Net.boostRemaining()
	if remaining > 0 then
		refs.BoostChip.Label.Text = Economy.formatTime(remaining)
		UIKit.setSwatch(refs.BoostChip.Gradient, if s.BoostTicking then Theme.Swatch.Green else Theme.Swatch.Steel)
	elseif s.BoostCharges > 0 then
		refs.BoostChip.Label.Text = "x" .. s.BoostCharges
		UIKit.setSwatch(refs.BoostChip.Gradient, Theme.Swatch.Orange)
	else
		refs.BoostChip.Label.Text = Copy.Hud.BoostNone
		UIKit.setSwatch(refs.BoostChip.Gradient, Theme.Swatch.Navy)
	end
end

function Hud.updateAuto()
	local owned = Players.LocalPlayer:GetAttribute("HasAutoFarm") == true
	local chip = refs.AutoChip
	if not owned then
		chip.Label.Text = "🔒"
		UIKit.setSwatch(chip.Gradient, Theme.Swatch.Navy)
	elseif AutoFarm.enabled then
		chip.Label.Text = Copy.Hud.On
		UIKit.setSwatch(chip.Gradient, Theme.Swatch.Green)
	else
		chip.Label.Text = Copy.Hud.Off
		UIKit.setSwatch(chip.Gradient, Theme.Swatch.Steel)
	end
end

function Hud.clearBadge(name: string)
	local item = refs.Nav and refs.Nav[name]
	if item and name == "Garage" then
		item.Badge:Set(false)
	end
end

-- Scrap chips fly from the smashed junk into the counter.
function Hud.flyScrap(worldPos: Vector3, amount: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local point, onScreen = camera:WorldToScreenPoint(worldPos)
	local coin = refs.Coin :: Frame
	local target = coin.AbsolutePosition + coin.AbsoluteSize / 2
	local count = math.clamp(math.floor(math.log(amount + 1, 2)), 2, 7)
	local start = if onScreen then Vector2.new(point.X, point.Y) else target + Vector2.new(0, 220)
	local layer = Gui.Layers.Fly
	for i = 1, count do
		local chip = UIKit.icon(layer, "⚙️", UDim2.fromOffset(30, 30), Gui.toRoot(start), Vector2.new(0.5, 0.5))
		local burst = Vector2.new(math.random(-70, 70), math.random(-80, -20)) / Gui.scale
		local mid = Gui.toRoot(start) + UDim2.fromOffset(burst.X, burst.Y)
		task.delay((i - 1) * 0.035, function()
			UIKit.tween(chip, 0.16, { Position = mid }, Enum.EasingStyle.Quad)
			task.wait(0.16)
			UIKit.tween(
				chip,
				0.42,
				{ Position = Gui.toRoot(target), Size = UDim2.fromOffset(18, 18) },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
			task.wait(0.42)
			chip:Destroy()
			if i == 1 then
				Sound.play("Coin", nil, 1 + math.random() * 0.2)
				UIKit.pop(coin, 0.2)
			end
		end)
	end
	-- "+40" floater beside the counter.
	local pill = refs.ScrapPill :: Frame
	local floater = UIKit.text(layer, {
		Text = "+" .. Economy.format(amount),
		TextSize = 30,
		Color = Theme.Good,
		Size = UDim2.fromOffset(140, 36),
		Position = Gui.toRoot(pill.AbsolutePosition + Vector2.new(pill.AbsoluteSize.X + 10, 10)),
	})
	task.delay(0.5, function()
		UIKit.tween(floater, 0.8, { Position = floater.Position + UDim2.fromOffset(0, -30), TextTransparency = 1 })
		local stroke = floater:FindFirstChildOfClass("UIStroke")
		if stroke then
			UIKit.tween(stroke, 0.8, { Transparency = 1 })
		end
		task.wait(0.8)
		floater:Destroy()
	end)
end

function Hud.init()
	local layer = Gui.Layers.Hud
	buildTopBar(layer)
	buildNav(layer)
	buildRight(layer)
	buildBottom(layer)
	Players.LocalPlayer:GetAttributeChangedSignal("HasAutoFarm"):Connect(Hud.updateAuto)
	AutoFarm.Changed:Connect(Hud.updateAuto)
	Net.MenuChanged:Connect(function(name)
		if name then
			Hud.clearBadge(name)
		end
		if Net.State then
			Hud.update(Net.State, Net.State)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			Hud.updateBoost()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[-- Panel manager: one panel at a time, springy open/close, dimmed backdrop.
-- "Blocking" panels tell the server, which pauses salvage and boost time meanwhile.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UIKit = require(script.Parent.UIKit)
local Gui = require(script.Parent.Gui)
local Net = require(script.Parent.Parent.Net)

local Panels = {}

export type Panel = {
	Name: string,
	Blocking: boolean,
	Window: Frame,
	Body: Frame,
	OnOpen: ((any?) -> ())?,
	OnClose: (() -> ())?,
}

local registry: { [string]: Panel } = {}
local current: string? = nil
local backdrop: TextButton? = nil
local menuSent = false

local function setMenu(open: boolean)
	if open ~= menuSent then
		menuSent = open
		task.spawn(Net.request, "Menu", open)
	end
end

local function ensureBackdrop(): TextButton
	if backdrop then
		return backdrop
	end
	local b = UIKit.new("TextButton", {
		Name = "Backdrop",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(3, 3),
		Position = UDim2.fromScale(-1, -1),
		Visible = false,
		Parent = Gui.Layers.Panels,
	})
	b.Activated:Connect(function()
		Panels.close()
	end)
	backdrop = b
	return b
end

-- Creates a panel window: navy body, colored title tab, red close button.
function Panels.create(props: { [string]: any }): Panel
	local width, height = props.Width or 760, props.Height or 470
	local window = UIKit.new("Frame", {
		Name = props.Name,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, height),
		Position = props.Position or UDim2.new(0.5, 0, 0.5, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 2,
		Parent = Gui.Layers.Panels,
	})
	local body = UIKit.surface(window, {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		Swatch = Theme.Swatch.Navy,
		Radius = Theme.Radius.L,
		StrokeThickness = Theme.Stroke.Heavy,
		Shine = false,
		ShadowOffset = 7,
	})
	-- Title tab overlapping the top-left edge, like popular simulator shops.
	local swatch = props.Swatch or Theme.Swatch.Green
	local tab = UIKit.surface(window, {
		Name = "Tab",
		Size = UDim2.fromOffset(props.TabWidth or 250, 60),
		Position = UDim2.fromOffset(22, -30),
		Swatch = swatch,
		Radius = Theme.Radius.L,
		ZIndex = 3,
	})
	if props.Icon then
		UIKit.icon(tab.Face, props.Icon, UDim2.fromOffset(48, 48), UDim2.new(0, 8, 0.5, 0), Vector2.new(0, 0.5))
	end
	UIKit.text(tab.Face, {
		Text = props.Title,
		TextSize = Theme.Text.H1 + 4,
		Size = UDim2.new(1, if props.Icon then -66 else -20, 0.86, 0),
		Position = UDim2.new(0, if props.Icon then 58 else 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
	})
	local close = UIKit.button(window, {
		Name = "Close",
		Text = "X",
		TextSize = 30,
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, -18, 0, -20),
		AnchorPoint = Vector2.new(0.5, 0),
		Swatch = Theme.Swatch.Red,
		ZIndex = 4,
		OnClick = function()
			Panels.close()
		end,
	})
	close.Holder.ZIndex = 4
	local content = UIKit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -40, 1, -64),
		Position = UDim2.fromOffset(20, 44),
		ZIndex = 2,
		Parent = body.Face,
	})
	local panel: Panel = {
		Name = props.Name,
		Blocking = props.Blocking ~= false,
		Window = window,
		Body = content,
		OnOpen = nil,
		OnClose = nil,
	}
	registry[props.Name] = panel
	return panel
end

function Panels.isOpen(name: string?): boolean
	if name then
		return current == name
	end
	return current ~= nil
end

function Panels.current(): string?
	return current
end

function Panels.open(name: string, arg: any?)
	local panel = registry[name]
	if not panel then
		return
	end
	if current == name then
		if panel.OnOpen then
			panel.OnOpen(arg)
		end
		return
	end
	if current then
		Panels.close(true)
	end
	current = name
	local b = ensureBackdrop()
	b.Visible = true
	UIKit.tween(b, 0.2, { BackgroundTransparency = 0.55 })
	local window = panel.Window
	window.Visible = true
	local scale = UIKit.scaleOf(window)
	if UIKit.reducedMotion then
		scale.Scale = 1
	else
		scale.Scale = 0.7
		UIKit.tween(scale, Theme.Motion.PanelIn, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if panel.OnOpen then
		panel.OnOpen(arg)
	end
	setMenu(panel.Blocking)
	Net.MenuChanged:Fire(name)
end

function Panels.close(switching: boolean?)
	local name = current
	if not name then
		return
	end
	local panel = registry[name]
	current = nil
	if panel.OnClose then
		panel.OnClose()
	end
	local window = panel.Window
	local scale = UIKit.scaleOf(window)
	UIKit.tween(scale, Theme.Motion.PanelOut, { Scale = 0.85 })
	task.delay(Theme.Motion.PanelOut, function()
		if current ~= name then
			window.Visible = false
		end
	end)
	if not switching then
		local b = ensureBackdrop()
		UIKit.tween(b, 0.15, { BackgroundTransparency = 1 })
		task.delay(0.15, function()
			if not current then
				b.Visible = false
			end
		end)
		setMenu(false)
		Net.MenuChanged:Fire(nil)
	end
end

function Panels.toggle(name: string, arg: any?)
	if current == name then
		Panels.close()
	else
		Panels.open(name, arg)
	end
end

function Panels.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if current and not processed then
				Panels.close()
			end
		end
	end)
	-- Close panels when the Roblox menu opens so nothing stays "blocking" in the background.
	GuiService.MenuOpened:Connect(function()
		Panels.close()
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="48">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="49">
              <Properties>
                <string name="Name">Daily</string>
                <string name="Source"><![CDATA[-- Rewards: the daily contract (30 smashes -> 100 Scrap + a stamp; five stamps unlock
-- Stamped Chrome) and the workshop (40 Scrap an hour, capped at 240, even offline).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Toasts = require(UI.Toasts)
local Net = require(UI.Parent.Net)

local Daily = {}

local refs: { [string]: any } = {}

local function card(parent: Instance, title: string, swatch: Theme.Swatch, position: UDim2)
	local c = UIKit.surface(parent, {
		Size = UDim2.fromOffset(350, 360),
		Position = position,
		Swatch = Theme.Swatch.Navy,
		Radius = Theme.Radius.L,
		Shine = false,
	})
	local header = UIKit.surface(c.Face, {
		Size = UDim2.new(1, -24, 0, 48),
		Position = UDim2.fromOffset(12, 12),
		Swatch = swatch,
		Radius = Theme.Radius.M,
		ShadowOffset = 3,
	})
	UIKit.text(header.Face, { Text = title, TextSize = 28 })
	return c.Face
end

local function claim(action: string)
	local ok, msg = Net.request(action)
	if not ok then
		Toasts.error(msg)
	end
end

function Daily.refresh()
	local s = Net.State
	if not s then
		return
	end
	local goal = Config.Daily.Goal
	local progress = math.min(s.Daily.Progress, goal)
	refs.ContractBar:Set(
		progress / goal,
		string.format("%d / %d", progress, goal),
		if progress >= goal then Theme.Swatch.Green else Theme.Swatch.Yellow
	)
	for i, stamp in refs.Stamps do
		local filled = i <= math.min(s.Stamps, Config.Daily.StampsForFinish)
		UIKit.setSwatch(stamp.Gradient, if filled then Theme.Swatch.Yellow else Theme.Swatch.Steel)
		stamp.Label.Text = if filled then "✓" else ""
	end
	refs.StampText.Text =
		string.format(Copy.Daily.Stamps, math.min(s.Stamps, Config.Daily.StampsForFinish), Config.Daily.StampsForFinish)
	if s.Daily.Claimed then
		refs.ContractButton:SetText(Copy.Daily.Claimed)
		refs.ContractButton:SetEnabled(false)
	else
		refs.ContractButton:SetText(Copy.Daily.Claim)
		refs.ContractButton:SetEnabled(progress >= goal)
	end
	Daily.refreshWorkshop()
end

function Daily.refreshWorkshop()
	local stored = Net.workshopStored()
	local cap = Config.Workshop.Cap
	refs.WorkshopAmount.Text = string.format("⚙️ %d / %d", math.floor(stored), cap)
	refs.WorkshopBar:Set(stored / cap, nil, if stored >= cap then Theme.Swatch.Green else Theme.Swatch.Yellow)
	if stored >= cap then
		refs.WorkshopTime.Text = Copy.Daily.WorkshopFull
	else
		local seconds = (cap - stored) / Config.Workshop.RatePerHour * 3600
		refs.WorkshopTime.Text = string.format(Copy.Daily.WorkshopTime, Economy.formatTime(seconds))
	end
	refs.WorkshopButton:SetText(string.format("%s %d", Copy.Daily.Claim, math.floor(stored)))
	refs.WorkshopButton:SetEnabled(stored >= 1)
end

function Daily.init()
	local panel = Panels.create({
		Name = "Daily",
		Title = Copy.Daily.Title,
		Icon = "📋",
		Swatch = Theme.Swatch.Yellow,
		Width = 780,
		Height = 470,
		TabWidth = 280,
	})
	local body = panel.Body

	local contract = card(body, Copy.Daily.Contract, Theme.Swatch.Orange, UDim2.fromOffset(6, 10))
	UIKit.text(contract, {
		Text = string.format(Copy.Daily.ContractTask, Config.Daily.Goal),
		TextSize = 24,
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.fromOffset(12, 72),
	})
	refs.ContractBar = UIKit.progress(
		contract,
		{ Size = UDim2.new(1, -40, 0, 30), Position = UDim2.fromOffset(20, 112), TextSize = 18 }
	)
	UIKit.text(contract, {
		Text = Copy.Daily.ContractReward,
		TextSize = 20,
		Font = Theme.Font.Body,
		Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.fromOffset(12, 152),
	})
	local stamps = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -24, 0, 50),
		Position = UDim2.fromOffset(12, 186),
		Parent = contract,
	})
	UIKit.list(stamps, false, 10)
	refs.Stamps = {}
	for i = 1, Config.Daily.StampsForFinish do
		local stamp = UIKit.surface(stamps, {
			Size = UDim2.fromOffset(44, 44),
			Swatch = Theme.Swatch.Steel,
			Radius = 999,
			ShadowOffset = 3,
			LayoutOrder = i,
		})
		refs.Stamps[i] = { Gradient = stamp.Gradient, Label = UIKit.text(stamp.Face, { Text = "", TextSize = 22 }) }
	end
	refs.StampText = UIKit.text(contract, {
		Text = "",
		TextSize = 15,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.new(1, -24, 0, 22),
		Position = UDim2.fromOffset(12, 242),
	})
	refs.ContractButton = UIKit.button(contract, {
		Text = Copy.Daily.Claim,
		TextSize = 28,
		Size = UDim2.new(1, -60, 0, 60),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			claim("ClaimDaily")
		end,
		OnDisabledClick = function()
			local s = Net.State
			if s and not s.Daily.Claimed then
				Toasts.error(string.format("Smash %d more junk first", Config.Daily.Goal - s.Daily.Progress))
			end
		end,
	})

	local workshop = card(body, Copy.Daily.Workshop, Theme.Swatch.Blue, UDim2.new(1, -356, 0, 10))
	refs.WorkshopAmount = UIKit.text(workshop, {
		Text = "",
		TextSize = 40,
		Color = Theme.ScrapGold,
		Size = UDim2.new(1, -24, 0, 46),
		Position = UDim2.fromOffset(12, 72),
	})
	UIKit.text(workshop, {
		Text = Copy.Daily.WorkshopRate,
		TextSize = 17,
		Font = Theme.Font.Body,
		Size = UDim2.new(1, -24, 0, 44),
		Position = UDim2.fromOffset(12, 122),
	})
	refs.WorkshopBar =
		UIKit.progress(workshop, { Size = UDim2.new(1, -40, 0, 26), Position = UDim2.fromOffset(20, 176) })
	refs.WorkshopTime = UIKit.text(workshop, {
		Text = "",
		TextSize = 16,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.new(1, -24, 0, 24),
		Position = UDim2.fromOffset(12, 212),
	})
	refs.WorkshopButton = UIKit.button(workshop, {
		Text = Copy.Daily.Claim,
		TextSize = 28,
		Size = UDim2.new(1, -60, 0, 60),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			claim("ClaimWorkshop")
		end,
	})

	panel.OnOpen = Daily.refresh
	Net.Changed:Connect(function()
		if Panels.isOpen("Daily") then
			Daily.refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Panels.isOpen("Daily") then
				Daily.refreshWorkshop()
			end
		end
	end)
end

return Daily
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="50">
              <Properties>
                <string name="Name">Garage</string>
                <string name="Source"><![CDATA[-- Garage: pick a tool style (Hammer / Saw / Drill - identical stats) and a finish.
-- Finishes are looks only: craft the Worker Shell, earn Stamped Chrome, or buy paint.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local MechBuilder = require(Shared.MechBuilder)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Toasts = require(UI.Toasts)
local Viewport = require(UI.Viewport)
local Net = require(UI.Parent.Net)

local Garage = {}

local preview: ViewportFrame
local shownKey = ""
local toolCards = {}
local finishCards = {}

local FINISH_OFFER = { Lime = "LimePaint", Foundry = "FoundryVIP" }

local function request(action: string, arg: any?)
	local ok, msg = Net.request(action, arg)
	if not ok then
		Toasts.error(msg)
	end
end

local function owns(s, finishId: string): boolean
	return table.find(s.Finishes, finishId) ~= nil
end

function Garage.refresh()
	local s = Net.State
	if not s then
		return
	end
	local key = string.format("%d:%s:%s", s.Level, s.Tool, s.Finish)
	if key ~= shownKey then
		shownKey = key
		Viewport.showMech(preview, s.Level, s.Tool, s.Finish, 60)
		for id, c in toolCards do
			Viewport.showTool(c.View, id, s.Finish, s.Level)
		end
	end
	for id, c in toolCards do
		local equipped = s.Tool == id
		c.Button:SetText(if equipped then Copy.Garage.Equipped else Copy.Garage.Equip)
		c.Button:SetEnabled(not equipped)
	end
	for id, c in finishCards do
		local owned = owns(s, id)
		local equipped = s.Finish == id
		local button = c.Button
		if equipped then
			button:SetText(Copy.Garage.Equipped)
			button:SetSwatch(Theme.Swatch.Green)
			button:SetEnabled(false)
		elseif owned then
			button:SetText(Copy.Garage.Equip)
			button:SetSwatch(Theme.Swatch.Green)
			button:SetEnabled(true)
		elseif id == "Worker" then
			button:SetText(string.format("%s ⚙️%s", Copy.Garage.Craft, Economy.format(Config.WorkerShellCraftCost)))
			button:SetSwatch(Theme.Swatch.Orange)
			button:SetEnabled(true)
		elseif FINISH_OFFER[id] then
			local price = 0
			for _, o in Config.Offers do
				if o.Key == FINISH_OFFER[id] then
					price = o.Price
				end
			end
			button:SetText(string.format("%s R$%d", Copy.Garage.Get, price))
			button:SetSwatch(Theme.Swatch.Blue)
			button:SetEnabled(true)
		else
			button:SetText(
				string.format(
					"%d/%d 📋",
					math.min(s.Stamps, Config.Daily.StampsForFinish),
					Config.Daily.StampsForFinish
				)
			)
			button:SetEnabled(false)
		end
	end
end

local function onFinishClick(id: string)
	local s = Net.State
	if not s then
		return
	end
	if owns(s, id) then
		request("SelectFinish", id)
	elseif id == "Worker" then
		request("CraftWorker")
	elseif FINISH_OFFER[id] then
		Panels.open("Shop", FINISH_OFFER[id])
	end
end

function Garage.init()
	local panel = Panels.create({
		Name = "Garage",
		Title = Copy.Garage.Title,
		Icon = "🎨",
		Swatch = Theme.Swatch.Blue,
		Width = 900,
		Height = 560,
		TabWidth = 270,
	})
	local body = panel.Body

	local card = UIKit.surface(
		body,
		{ Size = UDim2.fromOffset(250, 476), Swatch = Theme.Swatch.Navy, Radius = Theme.Radius.L, Shine = false }
	)
	card.Face.ClipsDescendants = true
	UIKit.sunburst(card.Face, Color3.fromHex("#62CCFF"), 10, 2)
	preview =
		Viewport.create(card.Face, { Size = UDim2.new(1, 0, 1, -10), Position = UDim2.fromOffset(0, 5), ZIndex = 3 })

	local right = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -270, 1, 0),
		Position = UDim2.fromOffset(270, 0),
		Parent = body,
	})
	UIKit.text(
		right,
		{ Text = Copy.Garage.Tools, TextSize = 28, Size = UDim2.fromOffset(200, 32), XAlign = Enum.TextXAlignment.Left }
	)
	UIKit.text(right, {
		Text = Copy.Garage.ToolsSub,
		TextSize = 17,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.new(1, -210, 0, 32),
		Position = UDim2.fromOffset(150, 0),
		XAlign = Enum.TextXAlignment.Left,
	})
	local tools = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 200),
		Position = UDim2.fromOffset(0, 38),
		Parent = right,
	})
	UIKit.list(tools, false, 16, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	for i, tool in Config.Tools do
		local c = UIKit.surface(
			tools,
			{ Size = UDim2.fromOffset(180, 196), Swatch = Theme.Swatch.Steel, Radius = Theme.Radius.L, LayoutOrder = i }
		)
		local view =
			Viewport.create(c.Face, { Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 4), ZIndex = 3 })
		UIKit.text(c.Face, {
			Text = string.upper(tool.Name),
			TextSize = 24,
			Size = UDim2.new(1, -12, 0, 28),
			Position = UDim2.fromOffset(6, 100),
		})
		UIKit.text(c.Face, {
			Text = tool.Blurb,
			TextSize = 14,
			Font = Theme.Font.Body,
			Size = UDim2.new(1, -12, 0, 20),
			Position = UDim2.fromOffset(6, 126),
		})
		local button = UIKit.button(c.Face, {
			Text = Copy.Garage.Equip,
			TextSize = 20,
			Size = UDim2.new(1, -24, 0, 40),
			Position = UDim2.new(0.5, 0, 1, -10),
			AnchorPoint = Vector2.new(0.5, 1),
			OnClick = function()
				request("SelectTool", tool.Id)
			end,
		})
		toolCards[tool.Id] = { View = view, Button = button }
	end

	UIKit.text(right, {
		Text = Copy.Garage.Finishes,
		TextSize = 28,
		Size = UDim2.fromOffset(200, 32),
		Position = UDim2.fromOffset(0, 250),
		XAlign = Enum.TextXAlignment.Left,
	})
	local finishes = UIKit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 196),
		Position = UDim2.fromOffset(0, 284),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		Parent = right,
	})
	UIKit.list(finishes, false, 14, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	UIKit.padding(finishes, 4)
	for i, finish in Config.Finishes do
		local palette = MechBuilder.palette(4, if finish.Id == "Default" then nil else finish.Id)
		local c = UIKit.surface(
			finishes,
			{ Size = UDim2.fromOffset(150, 176), Swatch = Theme.Swatch.Navy, Radius = Theme.Radius.L, LayoutOrder = i }
		)
		local swatches = UIKit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -16, 0, 44),
			Position = UDim2.fromOffset(8, 10),
			Parent = c.Face,
		})
		UIKit.list(swatches, false, 6)
		for j, color in { palette.Primary, palette.Secondary, palette.Eyes } do
			local dot = UIKit.new(
				"Frame",
				{ Size = UDim2.fromOffset(38, 38), BackgroundColor3 = color, LayoutOrder = j, Parent = swatches }
			)
			UIKit.corner(dot, 19)
			UIKit.stroke(dot, 2.5, Theme.Ink, true)
		end
		UIKit.text(c.Face, {
			Text = string.upper(finish.Name),
			TextSize = 19,
			Size = UDim2.new(1, -12, 0, 26),
			Position = UDim2.fromOffset(6, 60),
		})
		UIKit.text(c.Face, {
			Text = finish.HowToGet,
			TextSize = 13,
			Font = Theme.Font.Body,
			Color = Theme.Muted,
			Size = UDim2.new(1, -12, 0, 34),
			Position = UDim2.fromOffset(6, 86),
		})
		local button = UIKit.button(c.Face, {
			Text = Copy.Garage.Equip,
			TextSize = 17,
			Size = UDim2.new(1, -18, 0, 38),
			Position = UDim2.new(0.5, 0, 1, -10),
			AnchorPoint = Vector2.new(0.5, 1),
			OnClick = function()
				onFinishClick(finish.Id)
			end,
			OnDisabledClick = function()
				if finish.Id == "Chrome" then
					Toasts.error("Collect 5 daily stamps to unlock Stamped Chrome")
				end
			end,
		})
		finishCards[finish.Id] = { Button = button }
	end

	panel.OnOpen = Garage.refresh
	Net.Changed:Connect(function()
		if Panels.isOpen("Garage") then
			Garage.refresh()
		end
	end)
end

return Garage
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="51">
              <Properties>
                <string name="Name">Gate</string>
                <string name="Source"><![CDATA[-- Gate prompt: appears when you walk up to a locked gate and shows exactly what is
-- missing (Power and Scrap) with one UNLOCK button.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Toasts = require(UI.Toasts)
local Net = require(UI.Parent.Net)

local Gate = {}

local area = 2
local title: TextLabel
local blurb: TextLabel
local rows = {}
local button

local function refresh()
	local s = Net.State
	if not s then
		return
	end
	local def = Config.Areas[area]
	title.Text = string.upper(def.Name)
	blurb.Text = string.format("%s · %s HP · %d Scrap each", def.Blurb, Economy.format(def.HP), def.Scrap)
	local check = Economy.checkGate(area, s.Level, s.Scrap, { [2] = Net.unlocked(2) })
	local function set(row, ok: boolean, text: string)
		row.Mark.Text = if ok then "✅" else "❌"
		row.Label.Text = text
		row.Label.TextColor3 = if ok then Theme.Good else Theme.White
	end
	if check.needPrevious then
		set(rows[1], false, Copy.Gate.NeedPrevious)
		rows[2].Mark.Text = ""
		rows[2].Label.Text = ""
	else
		set(
			rows[1],
			not check.needPower,
			string.format(Copy.Gate.NeedPower, Economy.format(def.GatePower))
				.. string.format("  (you: %s)", Economy.format(s.Power))
		)
		set(rows[2], not check.needScrap, string.format(Copy.Gate.NeedScrap, Economy.format(def.GateScrap)))
	end
	button:SetText(string.format("%s · ⚙️ %s", Copy.Gate.Button, Economy.format(def.GateScrap)))
	button:SetEnabled(check.ok)
	if Net.unlocked(area) then
		Panels.close()
	end
end

function Gate.init()
	local panel = Panels.create({
		Name = "Gate",
		Title = "UNLOCK",
		Icon = "🔓",
		Swatch = Theme.Swatch.Blue,
		Width = 560,
		Height = 330,
		TabWidth = 230,
		Blocking = false,
	})
	local body = panel.Body
	title = UIKit.text(body, {
		Text = "",
		TextSize = 40,
		Color = Color3.fromHex("#FFB24A"),
		Size = UDim2.new(1, 0, 0, 46),
		StrokeThickness = 4,
	})
	blurb = UIKit.text(body, {
		Text = "",
		TextSize = 18,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 48),
	})
	for i = 1, 2 do
		local row = UIKit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -40, 0, 34),
			Position = UDim2.fromOffset(20, 80 + (i - 1) * 40),
			Parent = body,
		})
		rows[i] = {
			Mark = UIKit.icon(row, "", UDim2.fromOffset(30, 30), UDim2.fromScale(0, 0.5), Vector2.new(0, 0.5)),
			Label = UIKit.text(row, {
				Text = "",
				TextSize = 22,
				Size = UDim2.new(1, -40, 1, 0),
				Position = UDim2.fromOffset(40, 0),
				XAlign = Enum.TextXAlignment.Left,
			}),
		}
	end
	button = UIKit.button(body, {
		Text = Copy.Gate.Button,
		TextSize = 28,
		Size = UDim2.fromOffset(320, 62),
		Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1),
		Swatch = Theme.Swatch.Green,
		OnClick = function()
			local ok, msg = Net.request("UnlockGate", area)
			if ok then
				Panels.close()
			else
				Toasts.error(msg)
			end
		end,
		OnDisabledClick = function()
			Toasts.error("Keep smashing and upgrading to open this gate")
		end,
	})
	panel.OnOpen = function(whichArea)
		area = whichArea or area
		refresh()
	end
	Net.Changed:Connect(function()
		if Panels.isOpen("Gate") then
			refresh()
		end
	end)
end

return Gate
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="52">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[-- Rebirth: five milestones (+25% base Scrap each). Shows exactly what resets and what
-- stays, and needs a second tap to confirm.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Toasts = require(UI.Toasts)
local Net = require(UI.Parent.Net)

local Rebirth = {}

local dots = {}
local reqRows = {}
local bonusLabel: TextLabel
local button
local confirming = false
local confirmToken = 0

local function setConfirm(on: boolean)
	confirming = on
	confirmToken += 1
	if on then
		button:SetText(Copy.Rebirth.Confirm)
		button:SetSwatch(Theme.Swatch.Red)
		local token = confirmToken
		task.delay(3, function()
			if confirmToken == token and confirming then
				setConfirm(false)
				Rebirth.refresh()
			end
		end)
	end
end

local function requirementRow(parent: Instance, order: number)
	local row = UIKit.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order, Parent = parent }
	)
	local mark = UIKit.icon(row, "❌", UDim2.fromOffset(30, 30), UDim2.fromScale(0, 0.5), Vector2.new(0, 0.5))
	local label = UIKit.text(row, {
		Text = "",
		TextSize = 22,
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.fromOffset(40, 0),
		XAlign = Enum.TextXAlignment.Left,
	})
	return { Mark = mark, Label = label }
end

local function listCard(parent: Instance, title: string, items: { string }, swatch: Theme.Swatch, position: UDim2)
	local card = UIKit.surface(parent, {
		Size = UDim2.fromOffset(340, 150),
		Position = position,
		Swatch = swatch,
		Radius = Theme.Radius.M,
		Shine = false,
	})
	UIKit.text(
		card.Face,
		{ Text = title, TextSize = 24, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 8) }
	)
	for i, item in items do
		UIKit.text(card.Face, {
			Text = "• " .. item,
			TextSize = 19,
			Font = Theme.Font.Body,
			Size = UDim2.new(1, -30, 0, 26),
			Position = UDim2.fromOffset(18, 10 + i * 32),
			XAlign = Enum.TextXAlignment.Left,
		})
	end
end

function Rebirth.refresh()
	local s = Net.State
	if not s then
		return
	end
	for i, dot in dots do
		local done = i <= s.Rebirths
		local nextOne = i == s.Rebirths + 1
		UIKit.setSwatch(
			dot.Gradient,
			if done then Theme.Swatch.Purple elseif nextOne then Theme.Swatch.Yellow else Theme.Swatch.Steel
		)
		dot.Label.Text = if done then "✓" else tostring(i)
	end
	local now = Economy.rebirthFactor(s.Rebirths)
	local after = Economy.rebirthFactor(s.Rebirths + 1)
	bonusLabel.Text = string.format("%s: x%.2f  →  x%.2f", Copy.Rebirth.Bonus, now, after)
	local check = Economy.checkRebirth(s.Level, s.CrusherDestroys, s.Scrap, s.Rebirths)
	local function set(row, ok: boolean, text: string)
		row.Mark.Text = if ok then "✅" else "❌"
		row.Label.Text = text
		row.Label.TextColor3 = if ok then Theme.Good else Theme.White
	end
	set(reqRows[1], check.powerOk, Copy.Rebirth.NeedPower .. string.format("  (%s)", Economy.format(s.Power)))
	set(
		reqRows[2],
		check.destroysOk,
		string.format(
			Copy.Rebirth.NeedSmashes,
			math.min(s.CrusherDestroys, Config.Rebirth.RequiredCrusherDestroys),
			Config.Rebirth.RequiredCrusherDestroys
		)
	)
	set(reqRows[3], check.scrapOk, string.format(Copy.Rebirth.NeedFee, Economy.format(check.fee)))
	if check.maxed then
		bonusLabel.Text = string.format("%s: x%.2f", Copy.Rebirth.Bonus, now)
		button:SetText(Copy.Rebirth.Maxed)
		button:SetEnabled(false)
		return
	end
	if not confirming then
		button:SetText(string.format("%s · ⚙️ %s", Copy.Rebirth.Button, Economy.format(check.fee)))
		button:SetSwatch(Theme.Swatch.Purple)
	end
	button:SetEnabled(check.ok)
end

function Rebirth.init()
	local panel = Panels.create({
		Name = "Rebirth",
		Title = Copy.Rebirth.Title,
		Icon = "♻️",
		Swatch = Theme.Swatch.Purple,
		Width = 760,
		Height = 540,
		TabWidth = 270,
	})
	local body = panel.Body

	local track = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 84), Parent = body })
	UIKit.new("Frame", {
		BackgroundColor3 = Theme.Ink,
		Size = UDim2.new(0.8, 0, 0, 8),
		Position = UDim2.fromScale(0.5, 0.36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = track,
	})
	for i = 1, Economy.MaxRebirths do
		local x = 0.1 + (i - 1) * 0.2
		local dot = UIKit.surface(track, {
			Size = UDim2.fromOffset(52, 52),
			Position = UDim2.new(x, 0, 0.36, -2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Swatch = Theme.Swatch.Steel,
			Radius = 999,
			ShadowOffset = 3,
		})
		local label = UIKit.text(dot.Face, { Text = tostring(i), TextSize = 26 })
		UIKit.text(track, {
			Text = string.format("+%d%%", i * 25),
			TextSize = 17,
			Font = Theme.Font.Body,
			Color = Theme.Muted,
			Size = UDim2.fromOffset(80, 22),
			Position = UDim2.new(x, 0, 1, -6),
			AnchorPoint = Vector2.new(0.5, 1),
		})
		dots[i] = { Gradient = dot.Gradient, Label = label }
	end
	bonusLabel = UIKit.text(body, {
		Text = "",
		TextSize = 24,
		Color = Color3.fromHex("#E2C2FF"),
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 90),
	})

	local reqs = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -40, 0, 112),
		Position = UDim2.fromOffset(20, 126),
		Parent = body,
	})
	UIKit.list(reqs, true, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	for i = 1, 3 do
		reqRows[i] = requirementRow(reqs, i)
	end

	listCard(body, Copy.Rebirth.Resets, Copy.Rebirth.ResetList, Theme.Swatch.Red, UDim2.fromOffset(4, 244))
	listCard(body, Copy.Rebirth.Keeps, Copy.Rebirth.KeepList, Theme.Swatch.Green, UDim2.new(1, -344, 0, 244))

	button = UIKit.button(body, {
		Name = "RebirthButton",
		Text = Copy.Rebirth.Button,
		TextSize = 30,
		Size = UDim2.fromOffset(380, 66),
		Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1),
		Swatch = Theme.Swatch.Purple,
		OnClick = function()
			if not confirming then
				setConfirm(true)
				return
			end
			setConfirm(false)
			local ok, msg = Net.request("Rebirth")
			if ok then
				Panels.close()
			else
				Toasts.error(msg)
				Rebirth.refresh()
			end
		end,
		OnDisabledClick = function()
			Toasts.error("Finish the checklist above first")
		end,
	})

	panel.OnOpen = function()
		setConfirm(false)
		Rebirth.refresh()
	end
	Net.Changed:Connect(function()
		if Panels.isOpen("Rebirth") then
			Rebirth.refresh()
		end
	end)
end

return Rebirth
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="53">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[-- Shop: the seven small, exact offers. A featured banner (Double Scrap, x1 -> x2) over
-- a card grid, in the style of popular simulator shops. Each card states the exact
-- benefit; live prices come from the Marketplace when real IDs are configured.

local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Gui = require(UI.Gui)
local Toasts = require(UI.Toasts)
local Net = require(UI.Parent.Net)

local Shop = {}

local cards: { [string]: any } = {}
local prices: { [string]: number } = {}
local pricesFetched = false
local note: TextLabel
local list: ScrollingFrame

local function offer(key: string): Config.Offer?
	for _, o in Config.Offers do
		if o.Key == key then
			return o
		end
	end
	return nil
end

local function priceText(o: Config.Offer): string
	return "R$" .. tostring(prices[o.Key] or o.Price)
end

local function fetchPrices()
	if pricesFetched then
		return
	end
	pricesFetched = true
	for _, o in Config.Offers do
		if o.Id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(
						o.Id,
						if o.Kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
					)
				end)
				if ok and info and info.PriceInRobux then
					prices[o.Key] = info.PriceInRobux
					Shop.refresh()
				end
			end)
		end
	end
end

local function buy(key: string)
	local ok, msg = Net.request("Buy", key)
	if not ok then
		Toasts.error(msg)
	end
end

local function buildFeatured(parent: Instance)
	local o = offer("DoubleScrap") :: Config.Offer
	local banner = UIKit.surface(parent, {
		Name = "Featured",
		Size = UDim2.new(1, -16, 0, 156),
		Swatch = Theme.Swatch.Green,
		Radius = Theme.Radius.L,
		LayoutOrder = 0,
	})
	banner.Face.ClipsDescendants = true
	local iconBox = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(140, 140),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = banner.Face,
	})
	UIKit.sunburst(iconBox, Color3.new(1, 1, 1), 10, 1)
	UIKit.icon(iconBox, o.Icon, UDim2.fromScale(0.78, 0.78), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	UIKit.text(banner.Face, {
		Text = string.upper(o.Name) .. "!",
		TextSize = 44,
		Size = UDim2.fromOffset(420, 52),
		Position = UDim2.fromOffset(170, 14),
		XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 4,
	})
	local arrow = UIKit.text(banner.Face, {
		Text = Copy.Shop.Featured,
		TextSize = 40,
		Size = UDim2.fromOffset(260, 46),
		Position = UDim2.fromOffset(170, 64),
		XAlign = Enum.TextXAlignment.Left,
		Color = Color3.fromHex("#FFE85E"),
		StrokeThickness = 4,
	})
	UIKit.bob(arrow, 3, 1.4)
	UIKit.text(banner.Face, {
		Text = o.Benefit,
		TextSize = 18,
		Font = Theme.Font.Body,
		Size = UDim2.fromOffset(420, 26),
		Position = UDim2.fromOffset(170, 114),
		XAlign = Enum.TextXAlignment.Left,
	})
	local price = UIKit.button(banner.Face, {
		Name = "Price",
		Text = priceText(o),
		TextSize = 32,
		Size = UDim2.fromOffset(170, 72),
		Position = UDim2.new(1, -18, 0.5, -3),
		AnchorPoint = Vector2.new(1, 0.5),
		Swatch = {
			Top = Color3.fromHex("#5BD94A"),
			Bottom = Color3.fromHex("#16872A"),
			Deep = Color3.fromHex("#0C5418"),
		},
		OnClick = function()
			buy(o.Key)
		end,
	})
	cards[o.Key] = { Holder = banner.Holder, Price = price, Offer = o }
end

local function buildCard(parent: Instance, o: Config.Offer, order: number)
	local swatch = Theme.Swatch[o.Color] or Theme.Swatch.Blue
	local card = UIKit.surface(parent, {
		Name = o.Key,
		Size = UDim2.fromOffset(250, 236),
		Swatch = swatch,
		Radius = Theme.Radius.L,
		LayoutOrder = order,
	})
	card.Face.ClipsDescendants = true
	local iconBox = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(84, 84),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card.Face,
	})
	UIKit.sunburst(iconBox, Color3.new(1, 1, 1), 8, 1)
	UIKit.icon(iconBox, o.Icon, UDim2.fromScale(0.85, 0.85), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	UIKit.text(card.Face, {
		Text = string.upper(o.Name),
		TextSize = 24,
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 96),
	})
	local benefit = UIKit.text(card.Face, {
		Text = o.Benefit,
		TextSize = 15,
		Font = Theme.Font.Body,
		Size = UDim2.new(1, -20, 0, 42),
		Position = UDim2.fromOffset(10, 126),
	})
	local price = UIKit.button(card.Face, {
		Name = "Price",
		Text = priceText(o),
		TextSize = 26,
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		Swatch = {
			Top = Color3.fromHex("#5BD94A"),
			Bottom = Color3.fromHex("#16872A"),
			Deep = Color3.fromHex("#0C5418"),
		},
		OnClick = function()
			buy(o.Key)
		end,
	})
	cards[o.Key] = { Holder = card.Holder, Price = price, Offer = o, Benefit = benefit }
end

function Shop.refresh()
	local s = Net.State
	if not s then
		return
	end
	for key, card in cards do
		local o = card.Offer
		local owned = o.Kind == "Pass" and s.Passes[key] == true
		if owned then
			card.Price:SetText("✓ " .. Copy.Shop.Owned)
			card.Price:SetEnabled(false)
		else
			card.Price:SetText(priceText(o))
			card.Price:SetEnabled(true)
		end
		if key == "WorkerStarter" and card.Benefit then
			local hasShell = table.find(s.Finishes, "Worker") ~= nil
			card.Benefit.Text = if hasShell and not owned then Copy.Shop.StarterOwnedShell else o.Benefit
		elseif key == "ScrapBoost" and card.Benefit then
			card.Benefit.Text = o.Benefit
				.. (if s.BoostCharges > 0 then "  " .. string.format(Copy.Shop.BoostHave, s.BoostCharges) else "")
		end
	end
	note.Visible = s.StudioTest == true
end

function Shop.init()
	local panel = Panels.create({
		Name = "Shop",
		Title = Copy.Shop.Title,
		Icon = "🛒",
		Swatch = Theme.Swatch.Green,
		Width = 860,
		Height = 540,
		TabWidth = 220,
	})
	list = UIKit.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Muted,
		Parent = panel.Body,
	})
	UIKit.list(list, true, 18, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	UIKit.padding(list, 6, 8)
	buildFeatured(list)
	local grid = UIKit.new("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = list,
	})
	UIKit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(250, 236),
		CellPadding = UDim2.fromOffset(18, 22),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local order = 0
	for _, o in Config.Offers do
		if o.Key ~= "DoubleScrap" then
			order += 1
			buildCard(grid, o, order)
		end
	end
	note = UIKit.text(list, {
		Text = Copy.Shop.StudioNote,
		TextSize = 15,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.new(1, -20, 0, 24),
		LayoutOrder = 2,
	})

	panel.OnOpen = function(focusKey)
		fetchPrices()
		Shop.refresh()
		local card = focusKey and cards[focusKey]
		if card then
			task.defer(function()
				local y = (card.Holder.AbsolutePosition.Y - list.AbsolutePosition.Y) / Gui.scale + list.CanvasPosition.Y
				list.CanvasPosition = Vector2.new(0, math.max(0, y - 20))
				UIKit.pop(card.Holder, 0.12)
			end)
		end
	end
	Net.Changed:Connect(function()
		if Panels.isOpen("Shop") then
			Shop.refresh()
		end
	end)
end

return Shop
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">ToolPicker</string>
                <string name="Source"><![CDATA[-- First join: "PICK YOUR MECH!" - choose one of three free tool styles. One tap, then
-- straight into smashing. (The choice can be changed any time in the Garage.)

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Toasts = require(UI.Toasts)
local Viewport = require(UI.Viewport)
local Net = require(UI.Parent.Net)

local ToolPicker = {}

local shown = false
local CARD_SWATCH = { Hammer = Theme.Swatch.Orange, Saw = Theme.Swatch.Red, Drill = Theme.Swatch.Blue }

function ToolPicker.init()
	local panel = Panels.create({
		Name = "ToolPicker",
		Title = Copy.Picker.Title,
		Icon = "🤖",
		Swatch = Theme.Swatch.Orange,
		Width = 940,
		Height = 560,
		TabWidth = 420,
	})
	local body = panel.Body
	UIKit.text(body, {
		Text = Copy.Picker.Sub,
		TextSize = 22,
		Font = Theme.Font.Body,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 4),
	})
	local row = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -48),
		Position = UDim2.fromOffset(0, 46),
		Parent = body,
	})
	UIKit.list(row, false, 26, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	local views = {}
	for i, tool in Config.Tools do
		local card = UIKit.surface(row, {
			Size = UDim2.fromOffset(270, 420),
			Swatch = CARD_SWATCH[tool.Id] or Theme.Swatch.Blue,
			Radius = Theme.Radius.L,
			LayoutOrder = i,
		})
		card.Face.ClipsDescendants = true
		UIKit.sunburst(card.Face, Color3.new(1, 1, 1), 10, 2)
		views[tool.Id] = Viewport.create(
			card.Face,
			{ Size = UDim2.new(1, 0, 0, 250), Position = UDim2.fromOffset(0, 6), ZIndex = 3 }
		)
		UIKit.text(card.Face, {
			Text = string.upper(tool.Name),
			TextSize = 40,
			Size = UDim2.new(1, -16, 0, 46),
			Position = UDim2.fromOffset(8, 256),
			ZIndex = 3,
			StrokeThickness = 4,
		})
		UIKit.text(card.Face, {
			Text = tool.Blurb,
			TextSize = 18,
			Font = Theme.Font.Body,
			Size = UDim2.new(1, -16, 0, 26),
			Position = UDim2.fromOffset(8, 302),
			ZIndex = 3,
		})
		UIKit.button(card.Face, {
			Text = Copy.Picker.Button,
			TextSize = 30,
			Size = UDim2.new(1, -50, 0, 62),
			Position = UDim2.new(0.5, 0, 1, -14),
			AnchorPoint = Vector2.new(0.5, 1),
			Swatch = Theme.Swatch.Green,
			ZIndex = 3,
			OnClick = function()
				local ok, msg = Net.request("SelectTool", tool.Id)
				if ok then
					Panels.close()
					Toasts.show("Info", "Nice pick!", "Walk up to the junk in your lane to smash it.")
				else
					Toasts.error(msg)
				end
			end,
		})
	end
	panel.OnClose = function()
		local s = Net.State
		if s and not s.ToolChosen then
			-- Closed without picking: keep the current tool so the intro doesn't get stuck.
			task.spawn(Net.request, "SelectTool", s.Tool)
		end
	end
	panel.OnOpen = function()
		for id, view in views do
			Viewport.showMech(view, 4, id, nil, 150)
		end
	end
	Net.Changed:Connect(function(s)
		if not shown and s and not s.ToolChosen then
			shown = true
			task.delay(0.6, Panels.open, "ToolPicker")
		end
	end)
end

return ToolPicker
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="55">
              <Properties>
                <string name="Name">Upgrade</string>
                <string name="Source"><![CDATA[-- Upgrade panel: live 3D preview of your mech next to the nine Power upgrades,
-- each showing the visible milestone it unlocks (the "one more upgrade" hook).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Theme = require(Shared.Theme)

local UI = script.Parent.Parent
local UIKit = require(UI.UIKit)
local Copy = require(UI.Copy)
local Panels = require(UI.Panels)
local Toasts = require(UI.Toasts)
local Viewport = require(UI.Viewport)
local Net = require(UI.Parent.Net)

local Upgrade = {}

local rows = {}
local preview: ViewportFrame
local formLabel: TextLabel
local powerLabel: TextLabel
local shownKey = ""

local function buildRow(list: ScrollingFrame, index: number)
	local up = Config.Upgrades[index]
	local isForm = up.Milestone:find("form") ~= nil
	local surface = UIKit.surface(list, {
		Name = "Row" .. index,
		Size = UDim2.new(1, -16, 0, 70),
		Swatch = if isForm then Theme.Swatch.Orange else Theme.Swatch.Navy,
		LayoutOrder = index,
		Radius = Theme.Radius.M,
		ShadowOffset = 4,
	})
	local num = UIKit.surface(surface.Face, {
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0, 10, 0.5, -2),
		AnchorPoint = Vector2.new(0, 0.5),
		Swatch = Theme.Swatch.Steel,
		Radius = 999,
		ShadowOffset = 3,
	})
	local numLabel = UIKit.text(num.Face, { Text = tostring(index), TextSize = 24 })
	UIKit.text(surface.Face, {
		Text = "⚡ " .. Economy.format(up.Power) .. " POWER",
		TextSize = 24,
		Size = UDim2.new(0.55, 0, 0, 30),
		Position = UDim2.fromOffset(68, 7),
		XAlign = Enum.TextXAlignment.Left,
	})
	UIKit.text(surface.Face, {
		Text = up.Milestone,
		TextSize = 17,
		Font = Theme.Font.Body,
		Color = if isForm then Theme.White else Theme.Muted,
		Size = UDim2.new(0.55, 0, 0, 22),
		Position = UDim2.fromOffset(68, 38),
		XAlign = Enum.TextXAlignment.Left,
	})
	if isForm then
		UIKit.chip(surface.Face, {
			Text = Copy.Upgrade.NewForm,
			Size = UDim2.fromOffset(104, 24),
			Position = UDim2.new(0.62, 0, 0, 8),
			Swatch = Theme.Swatch.Purple,
			TextSize = 14,
		})
	end
	local buy = UIKit.button(surface.Face, {
		Name = "Buy",
		Text = "⚙️ " .. Economy.format(up.Cost),
		TextSize = 22,
		Size = UDim2.fromOffset(150, 50),
		Position = UDim2.new(1, -12, 0.5, -2),
		AnchorPoint = Vector2.new(1, 0.5),
		Swatch = Theme.Swatch.Green,
		OnClick = function()
			local ok, msg = Net.request("Upgrade")
			if not ok then
				Toasts.error(msg)
			end
		end,
		OnDisabledClick = function()
			local s = Net.State
			if s and s.Level + 1 == index then
				Toasts.error(string.format("Need %s more Scrap", Economy.format(up.Cost - s.Scrap)))
			elseif s and index > s.Level + 1 then
				Toasts.error("Buy the upgrades above first")
			end
		end,
	})
	rows[index] = { Num = num, NumLabel = numLabel, Buy = buy }
end

local function refresh()
	local s = Net.State
	if not s then
		return
	end
	for index, row in rows do
		local up = Config.Upgrades[index]
		if index <= s.Level then
			row.Buy:SetText("✓ " .. Copy.Upgrade.Owned)
			row.Buy:SetSwatch(Theme.Swatch.Blue)
			row.Buy:SetEnabled(false)
			UIKit.setSwatch(row.Num.Gradient, Theme.Swatch.Green)
		elseif index == s.Level + 1 then
			row.Buy:SetText("⚙️ " .. Economy.format(up.Cost))
			row.Buy:SetSwatch(Theme.Swatch.Green)
			row.Buy:SetEnabled(s.Scrap >= up.Cost)
			UIKit.setSwatch(row.Num.Gradient, Theme.Swatch.Yellow)
		else
			row.Buy:SetText("⚙️ " .. Economy.format(up.Cost))
			row.Buy:SetEnabled(false)
			UIKit.setSwatch(row.Num.Gradient, Theme.Swatch.Steel)
		end
	end
	formLabel.Text = string.upper(Economy.formFor(s.Level).Name)
	powerLabel.Text = string.format("⚡ %s POWER · LVL %d/%d", Economy.format(s.Power), s.Level, Economy.MaxLevel)
	local key = string.format("%d:%s:%s", s.Level, s.Tool, s.Finish)
	if key ~= shownKey then
		shownKey = key
		Viewport.showMech(preview, s.Level, s.Tool, s.Finish, 30)
	end
end

function Upgrade.init()
	local panel = Panels.create({
		Name = "Upgrade",
		Title = Copy.Upgrade.Title,
		Icon = "⚡",
		Swatch = Theme.Swatch.Orange,
		Width = 860,
		Height = 520,
		TabWidth = 300,
		Blocking = false,
	})
	local body = panel.Body

	local card = UIKit.surface(
		body,
		{ Size = UDim2.fromOffset(270, 440), Swatch = Theme.Swatch.Navy, Radius = Theme.Radius.L, Shine = false }
	)
	card.Face.ClipsDescendants = true
	UIKit.sunburst(card.Face, Color3.fromHex("#FFB24A"), 10, 2)
	UIKit.text(card.Face, {
		Text = Copy.Upgrade.Current,
		TextSize = 18,
		Font = Theme.Font.Body,
		Color = Theme.Muted,
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 10),
		ZIndex = 3,
	})
	preview =
		Viewport.create(card.Face, { Size = UDim2.new(1, 0, 0, 320), Position = UDim2.fromOffset(0, 30), ZIndex = 3 })
	formLabel = UIKit.text(card.Face, {
		Text = "",
		TextSize = 34,
		Color = Color3.fromHex("#FFB24A"),
		Size = UDim2.new(1, -16, 0, 40),
		Position = UDim2.fromOffset(8, 352),
		ZIndex = 3,
	})
	powerLabel = UIKit.text(card.Face, {
		Text = "",
		TextSize = 18,
		Font = Theme.Font.Body,
		Size = UDim2.new(1, -16, 0, 26),
		Position = UDim2.fromOffset(8, 396),
		ZIndex = 3,
	})

	local list = UIKit.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -290, 1, 0),
		Position = UDim2.fromOffset(290, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Muted,
		Parent = body,
	})
	UIKit.list(list, true, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	UIKit.padding(list, 4, 6)
	for index = 1, #Config.Upgrades do
		buildRow(list, index)
	end

	panel.OnOpen = function()
		refresh()
		local s = Net.State
		if s then
			-- Scroll so the next upgrade is in view.
			list.CanvasPosition = Vector2.new(0, math.max(0, (s.Level - 1) * 82))
		end
	end
	Net.Changed:Connect(function()
		if Panels.isOpen("Upgrade") then
			refresh()
		end
	end)
end

return Upgrade
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[-- Notifications: small stacked toasts for routine events and a big centre banner
-- (with rotating sunburst) for the moments that matter: new form, gate, rebirth.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local UIKit = require(script.Parent.UIKit)
local Gui = require(script.Parent.Gui)
local Sound = require(script.Parent.Parent.Controllers.Sound)

local Toasts = {}

local STYLE = {
	Upgrade = { Theme.Swatch.Orange, "⚡" },
	Form = { Theme.Swatch.Orange, "🤖" },
	Gate = { Theme.Swatch.Blue, "🔓" },
	Rebirth = { Theme.Swatch.Purple, "♻️" },
	Reward = { Theme.Swatch.Yellow, "⚙️" },
	Daily = { Theme.Swatch.Yellow, "📋" },
	Unlock = { Theme.Swatch.Green, "🎨" },
	Purchase = { Theme.Swatch.Green, "🛒" },
	Boost = { Theme.Swatch.Orange, "🚀" },
	Error = { Theme.Swatch.Red, "⚠️" },
	Info = { Theme.Swatch.Blue, "💡" },
}

local stack: Frame? = nil
local order = 0

local function getStack(): Frame
	if stack then
		return stack
	end
	stack = UIKit.new("Frame", {
		Name = "ToastStack",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 300),
		Position = UDim2.new(0.5, 0, 0, 118),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = Gui.Layers.Toasts,
	})
	UIKit.list(stack :: Frame, true, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	return stack :: Frame
end

function Toasts.show(kind: string, title: string, body: string?, duration: number?)
	local style = STYLE[kind] or STYLE.Info
	order += 1
	local holder = UIKit.new("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(400, if body and body ~= "" then 70 else 54),
		LayoutOrder = order,
		Parent = getStack(),
	})
	local surface = UIKit.surface(holder, { Size = UDim2.fromScale(1, 1), Swatch = style[1], Radius = Theme.Radius.M })
	UIKit.icon(surface.Face, style[2], UDim2.fromOffset(44, 44), UDim2.new(0, 10, 0.5, 0), Vector2.new(0, 0.5))
	local hasBody = body and body ~= ""
	UIKit.text(surface.Face, {
		Text = title,
		TextSize = 24,
		Size = UDim2.new(1, -72, if hasBody then 0.52 else 0.8, 0),
		Position = UDim2.new(0, 62, if hasBody then 0.08 else 0.1, 0),
		XAlign = Enum.TextXAlignment.Left,
	})
	if hasBody then
		UIKit.text(surface.Face, {
			Text = body,
			TextSize = 17,
			Font = Theme.Font.Body,
			Size = UDim2.new(1, -72, 0.36, 0),
			Position = UDim2.new(0, 62, 0.56, 0),
			XAlign = Enum.TextXAlignment.Left,
		})
	end
	UIKit.pop(holder, 0.25)
	if kind == "Error" then
		UIKit.shake(holder)
	end
	task.delay(duration or 3, function()
		local scale = UIKit.scaleOf(holder)
		UIKit.tween(scale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.22)
		holder:Destroy()
	end)
end

function Toasts.error(message: string?)
	if message and message ~= "" then
		Toasts.show("Error", message, nil, 2.4)
	end
end

local bannerBusy = false

function Toasts.celebrate(kind: string, title: string, subtitle: string?)
	local style = STYLE[kind] or STYLE.Info
	Sound.play("Upgrade")
	if bannerBusy then
		Toasts.show(kind, title, subtitle)
		return
	end
	bannerBusy = true
	local holder = UIKit.new("Frame", {
		Name = "Celebration",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(640, 220),
		Position = UDim2.fromScale(0.5, 0.36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = Gui.Layers.Toasts,
	})
	local burst = UIKit.sunburst(holder, style[1].Top, 12, 1)
	burst.Size = UDim2.fromScale(1.4, 3)
	UIKit.text(holder, {
		Text = subtitle or "",
		TextSize = 34,
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Theme.White,
		ZIndex = 3,
	})
	local main = UIKit.text(holder, {
		Text = string.upper(title),
		TextSize = 92,
		Size = UDim2.new(1, 0, 0, 110),
		Position = UDim2.new(0.5, 0, 0, 46),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = style[1].Top,
		StrokeThickness = 6,
		ZIndex = 3,
		Rotation = -3,
	})
	UIKit.gradient(main, { Top = Color3.new(1, 1, 1), Bottom = style[1].Top, Deep = style[1].Deep })
	local scale = UIKit.scaleOf(holder)
	scale.Scale = 0.2
	UIKit.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.4, function()
		UIKit.tween(scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.27)
		holder:Destroy()
		bannerBusy = false
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[-- UI kit for the chunky simulator look (docs/DESIGN_SYSTEM.md):
-- vertical gradients, thick ink outlines, glossy shine strip, hard drop shadow,
-- white cartoon type with ink stroke, and springy hover/press animations.

local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Theme = require(Shared.Theme)

local Sound = require(script.Parent.Parent.Controllers.Sound)

local UIKit = {}

UIKit.Theme = Theme

UIKit.reducedMotion = false
pcall(function()
	UIKit.reducedMotion = (GuiService :: any).ReducedMotionEnabled == true
end)

-- Instances --------------------------------------------------------------------

function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	for k, v in props or {} do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if inst:IsA("GuiObject") and (props == nil or props.BorderSizePixel == nil) then
		inst.BorderSizePixel = 0
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UIKit.corner(parent: Instance, radius: number?): UICorner
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius.M), Parent = parent })
end

function UIKit.stroke(parent: Instance, thickness: number?, color: Color3?, border: boolean?): UIStroke
	return UIKit.new("UIStroke", {
		Thickness = thickness or Theme.Stroke.Chunky,
		Color = color or Theme.Ink,
		ApplyStrokeMode = if border then Enum.ApplyStrokeMode.Border else Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function UIKit.gradient(parent: Instance, swatch: Theme.Swatch, rotation: number?): UIGradient
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(swatch.Top, swatch.Bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.setSwatch(gradient: UIGradient, swatch: Theme.Swatch)
	gradient.Color = ColorSequence.new(swatch.Top, swatch.Bottom)
end

function UIKit.padding(parent: Instance, all: number, top: number?): UIPadding
	return UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingBottom = UDim.new(0, all),
		Parent = parent,
	})
end

function UIKit.list(
	parent: Instance,
	vertical: boolean,
	gap: number,
	align: Enum.HorizontalAlignment?,
	valign: Enum.VerticalAlignment?
): UIListLayout
	return UIKit.new("UIListLayout", {
		FillDirection = if vertical then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, gap),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
		VerticalAlignment = valign or Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

-- Text with an ink outline. `TextSize` is the maximum; long text shrinks to fit.
function UIKit.text(parent: Instance?, props: { [string]: any }): TextLabel
	local size = props.TextSize or Theme.Text.Body
	local label = UIKit.new("TextLabel", {
		Name = props.Name or "Text",
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Font = props.Font or Theme.Font.Display,
		Text = props.Text or "",
		TextColor3 = props.Color or Theme.White,
		TextScaled = true,
		TextWrapped = props.Wrap ~= false,
		RichText = props.RichText or false,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Rotation = props.Rotation or 0,
		Parent = parent,
	})
	UIKit.new("UITextSizeConstraint", { MaxTextSize = size, MinTextSize = math.min(10, size), Parent = label })
	if props.Stroke ~= false then
		UIKit.stroke(label, props.StrokeThickness or Theme.strokeFor(size), props.StrokeColor)
	end
	return label
end

-- Emoji icon (no outline; emoji keep their own colors).
function UIKit.icon(parent: Instance?, emoji: string, size: UDim2?, position: UDim2?, anchor: Vector2?): TextLabel
	return UIKit.new("TextLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = size or UDim2.fromScale(1, 1),
		Position = position or UDim2.new(),
		AnchorPoint = anchor or Vector2.zero,
		Font = Theme.Font.Body,
		Text = emoji,
		TextScaled = true,
		TextColor3 = Theme.White,
		Parent = parent,
	})
end

-- Motion ------------------------------------------------------------------------

function UIKit.tween(
	inst: Instance,
	time: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

function UIKit.scaleOf(gui: Instance): UIScale
	local s = gui:FindFirstChildOfClass("UIScale")
	if not s then
		s = UIKit.new("UIScale", { Parent = gui })
	end
	return s :: UIScale
end

-- Quick "boing": shrink then spring back.
function UIKit.pop(gui: GuiObject, amount: number?)
	local s = UIKit.scaleOf(gui)
	if UIKit.reducedMotion then
		return
	end
	s.Scale = 1 + (amount or 0.18)
	UIKit.tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Gentle idle bob for featured buttons.
function UIKit.bob(gui: GuiObject, pixels: number?, period: number?)
	if UIKit.reducedMotion then
		return
	end
	local base = gui.Position
	local offset = pixels or 4
	local t = TweenService:Create(
		gui,
		TweenInfo.new((period or 1.6) / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = base + UDim2.fromOffset(0, -offset) }
	)
	t:Play()
	return t
end

function UIKit.shake(gui: GuiObject)
	local base = gui.Rotation
	task.spawn(function()
		for _, r in { -6, 6, -4, 4, 0 } do
			gui.Rotation = base + r
			task.wait(0.04)
		end
		gui.Rotation = base
	end)
end

-- Chunky surface --------------------------------------------------------------------
-- holder (transparent, sized) > Shadow (ink, offset down) + Face (gradient, outline, shine)

export type Surface = { Holder: Frame, Face: GuiObject, Gradient: UIGradient, Shadow: Frame }

function UIKit.surface(parent: Instance?, props: { [string]: any }): Surface
	local radius = props.Radius or Theme.Radius.M
	local holder = UIKit.new("Frame", {
		Name = props.Name or "Surface",
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromOffset(120, 60),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	local shadow = UIKit.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = Theme.Ink,
		BackgroundTransparency = 0.15,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, props.ShadowOffset or Theme.ShadowOffset),
		ZIndex = holder.ZIndex,
		Parent = holder,
	})
	UIKit.corner(shadow, radius)
	local face = UIKit.new(props.Button and "TextButton" or "Frame", {
		Name = "Face",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = holder.ZIndex,
		Parent = holder,
	})
	if props.Button then
		face.Text = ""
		face.AutoButtonColor = false
	end
	UIKit.corner(face, radius)
	UIKit.stroke(face, props.StrokeThickness or Theme.Stroke.Chunky, Theme.Ink, true)
	local gradient = UIKit.gradient(face, props.Swatch or Theme.Swatch.Navy)
	if props.Shine ~= false then
		local shine = UIKit.new("Frame", {
			Name = "Shine",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.78,
			Size = UDim2.new(1, -10, 0.42, -4),
			Position = UDim2.fromOffset(5, 4),
			ZIndex = holder.ZIndex,
			Parent = face,
		})
		UIKit.corner(shine, math.max(radius - 4, 4))
	end
	return { Holder = holder, Face = face, Gradient = gradient, Shadow = shadow }
end

-- Buttons ---------------------------------------------------------------------------

export type Button = {
	Holder: Frame,
	Face: TextButton,
	Label: TextLabel?,
	Icon: TextLabel?,
	Gradient: UIGradient,
	SetText: (self: Button, text: string) -> (),
	SetSwatch: (self: Button, swatch: Theme.Swatch) -> (),
	SetEnabled: (self: Button, enabled: boolean) -> (),
	Enabled: boolean,
}

local function attachMotion(holder: Frame, face: GuiButton, isEnabled: () -> boolean)
	local scale = UIKit.scaleOf(holder)
	local hovering = false
	local m = Theme.Motion
	face.MouseEnter:Connect(function()
		hovering = true
		if not isEnabled() or UIKit.reducedMotion then
			return
		end
		UIKit.tween(scale, m.Hover, { Scale = m.HoverScale }, Enum.EasingStyle.Back)
		UIKit.tween(holder, m.Hover, { Rotation = m.HoverTilt }, Enum.EasingStyle.Back)
	end)
	face.MouseLeave:Connect(function()
		hovering = false
		UIKit.tween(scale, m.Hover, { Scale = 1 }, Enum.EasingStyle.Back)
		UIKit.tween(holder, m.Hover, { Rotation = 0 })
		UIKit.tween(face, m.Press, { Position = UDim2.new() })
	end)
	face.MouseButton1Down:Connect(function()
		if not isEnabled() then
			return
		end
		UIKit.tween(scale, m.Press, { Scale = m.PressScale })
		UIKit.tween(face, m.Press, { Position = UDim2.fromOffset(0, 3) })
	end)
	face.MouseButton1Up:Connect(function()
		UIKit.tween(
			scale,
			m.Release,
			{ Scale = if hovering and not UIKit.reducedMotion then m.HoverScale else 1 },
			Enum.EasingStyle.Back
		)
		UIKit.tween(face, m.Release, { Position = UDim2.new() }, Enum.EasingStyle.Back)
	end)
end

-- Rectangular button with optional emoji icon on the left.
function UIKit.button(parent: Instance?, props: { [string]: any }): Button
	local surface = UIKit.surface(parent, {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 56),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		Swatch = props.Swatch or Theme.Swatch.Green,
		Radius = props.Radius,
		ZIndex = props.ZIndex,
		Button = true,
	})
	local face = surface.Face :: TextButton
	local textSize = props.TextSize or Theme.Text.H2
	local iconLabel
	if props.Icon then
		iconLabel = UIKit.icon(
			face,
			props.Icon,
			UDim2.new(0, textSize * 1.3, 0.8, 0),
			UDim2.new(0, 8, 0.5, 0),
			Vector2.new(0, 0.5)
		)
	end
	local label
	if props.Text then
		local left = if props.Icon then textSize * 1.3 + 10 else 8
		label = UIKit.text(face, {
			Name = "Label",
			Text = props.Text,
			TextSize = textSize,
			Size = UDim2.new(1, -left - 8, 0.86, 0),
			Position = UDim2.new(0, left, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Font = props.Font or Theme.Font.Display,
			RichText = props.RichText,
		})
	end
	local swatch = props.Swatch or Theme.Swatch.Green
	local button = {
		Holder = surface.Holder,
		Face = face,
		Label = label,
		Icon = iconLabel,
		Gradient = surface.Gradient,
		Enabled = props.Enabled ~= false,
	}
	function button.SetText(_, value: string)
		if label then
			label.Text = value
		end
	end
	function button.SetSwatch(_, value: Theme.Swatch)
		swatch = value
		if button.Enabled then
			UIKit.setSwatch(surface.Gradient, value)
		end
	end
	function button.SetEnabled(_, enabled: boolean)
		button.Enabled = enabled
		UIKit.setSwatch(surface.Gradient, if enabled then swatch else Theme.Swatch.Steel)
	end
	button:SetEnabled(button.Enabled)
	attachMotion(surface.Holder, face, function()
		return button.Enabled
	end)
	face.Activated:Connect(function()
		if not button.Enabled then
			UIKit.shake(surface.Holder)
			if props.OnDisabledClick then
				props.OnDisabledClick()
			end
			return
		end
		if props.Sound ~= false then
			Sound.play("Click")
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return button :: any
end

-- Square menu button: big emoji, label overlapping the bottom edge, optional badge.
function UIKit.iconButton(parent: Instance?, props: { [string]: any })
	local size = props.SizePx or 78
	local surface = UIKit.surface(parent, {
		Name = props.Name or "IconButton",
		Size = UDim2.fromOffset(size, size),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		Swatch = props.Swatch,
		Radius = Theme.Radius.L,
		Button = true,
	})
	local face = surface.Face :: TextButton
	local icon =
		UIKit.icon(face, props.Icon, UDim2.fromScale(0.62, 0.62), UDim2.fromScale(0.5, 0.42), Vector2.new(0.5, 0.5))
	local label = UIKit.text(surface.Holder, {
		Name = "Label",
		Text = props.Text,
		TextSize = 20,
		Size = UDim2.new(1, 24, 0, 24),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
	})
	local badge = UIKit.badge(surface.Holder)
	local enabled = true
	attachMotion(surface.Holder, face, function()
		return enabled
	end)
	face.Activated:Connect(function()
		Sound.play("Click")
		if props.OnClick then
			props.OnClick()
		end
	end)
	return {
		Holder = surface.Holder,
		Face = face,
		Icon = icon,
		Label = label,
		Badge = badge,
		Gradient = surface.Gradient,
	}
end

-- Red "!" notification dot with a pulse.
function UIKit.badge(parent: Instance)
	local dot = UIKit.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -6, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	UIKit.corner(dot, 14)
	UIKit.stroke(dot, 2.5, Theme.Ink, true)
	UIKit.gradient(dot, Theme.Swatch.Red)
	local label = UIKit.text(dot, { Text = "!", TextSize = 20, ZIndex = 6 })
	local scale = UIKit.scaleOf(dot)
	local pulse
	local badge = {}
	function badge.Set(_, visible: boolean, text: string?)
		label.Text = text or "!"
		if visible == dot.Visible then
			return
		end
		dot.Visible = visible
		if pulse then
			pulse:Cancel()
			pulse = nil
		end
		if visible and not UIKit.reducedMotion then
			scale.Scale = 1
			pulse = TweenService:Create(
				scale,
				TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ Scale = 1.18 }
			)
			pulse:Play()
		end
	end
	return badge
end

-- Pill progress bar with centred text.
function UIKit.progress(parent: Instance?, props: { [string]: any })
	local track = UIKit.new("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.fromOffset(240, 26),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Theme.Swatch.Navy.Deep,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = parent,
	})
	UIKit.corner(track, 999)
	UIKit.stroke(track, 2.5, Theme.Ink, true)
	local fill = UIKit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	})
	UIKit.corner(fill, 999)
	local gradient = UIKit.gradient(fill, props.Swatch or Theme.Swatch.Green)
	local label = UIKit.text(track, {
		Text = "",
		TextSize = props.TextSize or 16,
		Size = UDim2.new(1, -12, 1, -4),
		Position = UDim2.fromOffset(6, 2),
		ZIndex = 2,
	})
	local bar = { Frame = track, Label = label }
	function bar.Set(_, ratio: number, text: string?, swatch: Theme.Swatch?)
		ratio = math.clamp(ratio, 0, 1)
		UIKit.tween(fill, 0.25, { Size = UDim2.fromScale(ratio, 1) })
		fill.Visible = ratio > 0.001
		label.Text = text or ""
		if swatch then
			UIKit.setSwatch(gradient, swatch)
		end
	end
	return bar
end

-- Rotating light rays behind featured icons.
function UIKit.sunburst(parent: Instance, color: Color3?, rays: number?, zIndex: number?)
	local holder = UIKit.new("Frame", {
		Name = "Sunburst",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1.6, 1.6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	UIKit.new("UIAspectRatioConstraint", { Parent = holder })
	local count = rays or 8
	for i = 1, count do
		UIKit.new("Frame", {
			Name = "Ray",
			BackgroundColor3 = color or Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			Size = UDim2.fromScale(0.12, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = (i - 1) * (180 / count),
			ZIndex = zIndex or 1,
			Parent = holder,
		})
	end
	if not UIKit.reducedMotion then
		TweenService
			:Create(
				holder,
				TweenInfo.new(14, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
				{ Rotation = 360 }
			)
			:Play()
	end
	return holder
end

-- Small rounded chip ("OWNED", "x2", "NEW FORM").
function UIKit.chip(parent: Instance?, props: { [string]: any })
	local surface = UIKit.surface(parent, {
		Name = props.Name or "Chip",
		Size = props.Size or UDim2.fromOffset(90, 28),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		Swatch = props.Swatch or Theme.Swatch.Green,
		Radius = 999,
		ShadowOffset = 3,
		StrokeThickness = 2.5,
		Shine = false,
		ZIndex = props.ZIndex,
	})
	local label = UIKit.text(surface.Face, {
		Text = props.Text or "",
		TextSize = props.TextSize or 16,
		Size = UDim2.new(1, -10, 1, -4),
		Position = UDim2.fromOffset(5, 2),
		ZIndex = props.ZIndex,
	})
	return { Holder = surface.Holder, Label = label, Gradient = surface.Gradient }
end

return UIKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Viewport</string>
              <string name="Source"><![CDATA[-- 3D previews in the UI (upgrade panel, garage, tool picker) built with the same
-- MechBuilder the server uses, so previews always match the real mech.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MechBuilder = require(Shared.MechBuilder)

local UIKit = require(script.Parent.UIKit)

local Viewport = {}

local spinning: { [ViewportFrame]: { camera: Camera, focus: Vector3, distance: number, height: number, angle: number } } =
	{}

RunService.RenderStepped:Connect(function(dt)
	for frame, spin in spinning do
		if not frame.Parent then
			spinning[frame] = nil
		elseif frame.Visible and frame:FindFirstAncestorWhichIsA("LayerCollector") then
			spin.angle += dt * 0.6
			local offset =
				Vector3.new(math.sin(spin.angle) * spin.distance, spin.height, math.cos(spin.angle) * spin.distance)
			spin.camera.CFrame = CFrame.lookAt(spin.focus + offset, spin.focus)
		end
	end
end)

local function frameModel(frame: ViewportFrame, model: Model, spin: boolean, zoom: number?)
	for _, child in frame:GetChildren() do
		if child:IsA("Model") then
			child:Destroy()
		end
	end
	model.Parent = frame
	local cf, size = model:GetBoundingBox()
	local camera = frame.CurrentCamera or Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = frame
	frame.CurrentCamera = camera
	local radius = size.Magnitude / 2
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * (zoom or 1.05)
	local focus = cf.Position
	local state = { camera = camera, focus = focus, distance = distance, height = radius * 0.25, angle = math.rad(200) }
	camera.CFrame = CFrame.lookAt(
		focus + Vector3.new(math.sin(state.angle) * distance, state.height, math.cos(state.angle) * distance),
		focus
	)
	if spin then
		spinning[frame] = state
	else
		spinning[frame] = nil
	end
end

function Viewport.create(parent: Instance, props: { [string]: any }): ViewportFrame
	local frame = UIKit.new("ViewportFrame", {
		Name = props.Name or "Preview",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 245, 230),
		LightDirection = Vector3.new(-0.6, -1, -0.4),
		ZIndex = props.ZIndex or 2,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = parent,
	})
	return frame
end

function Viewport.showMech(
	frame: ViewportFrame,
	level: number,
	toolId: string,
	finishId: string?,
	pose: number?,
	spin: boolean?
)
	local model = MechBuilder.buildStatue(level, toolId, finishId, 1, CFrame.new(0, MechBuilder.RootHeight, 0), pose)
	frameModel(frame, model, spin ~= false, 0.95)
end

function Viewport.showTool(frame: ViewportFrame, toolId: string, finishId: string?, level: number)
	local model = MechBuilder.buildToolPreview(toolId, finishId, level, CFrame.Angles(0, 0, math.rad(180)))
	frameModel(frame, model, true, 1.1)
end

return Viewport
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="59">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>